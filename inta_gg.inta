inta.stg:{namer,icon,background
namer:app.name:["AI_sandbox"],what.name=namer
icon:app.ico:["💀"],what.ico=icon
background:app.bg:[#1f4634],what.ico.bg=background
}
IL.cfg={scripts:all}
Inta.cfg={phone,pc,tablet}
load.stop_parse.inta

<!DOCTYPE html>
<html lang="ru" data-theme="purple">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0a0a12">
<title>AI Sandbox</title>
<style>
/* ============ ТЕМЫ ============ */
:root{--bg:#0b0b12;--bg2:#181028;--bg3:#0f0a1a;--bg-chat:#0b0b12;
--text:#ffffff;--text2:#c4b5fd;--text3:#a78bfa;--text-muted:#7c6b9e;
--accent:#8b5cf6;--accent2:#6d28d9;--accent-soft:rgba(139,92,246,.15);
--border:#2a1a4d;--border2:#4c1d95;
--user-bubble:#8b5cf6;--user-text:#fff;
--ai-bubble:#241543;--ai-text:#fff;
--sys-bubble:rgba(76,29,149,.4);--sys-text:#c4b5fd;--sys-border:#4c1d95;
--danger:#ef4444;--danger-bg:#3f1a1a;--danger-text:#fca5a5;
--warn:#fbbf24;--warn-bg:#3a2a10;--warn-text:#fde68a;--ok:#22c55e;}
[data-theme="dark"]{--bg:#111318;--bg2:#1c1f26;--bg3:#15181f;--bg-chat:#111318;--text:#f0f0f0;--text2:#b0b8c4;--text3:#8b95a5;--text-muted:#5c6472;--accent:#5b8def;--accent2:#3d6bc7;--accent-soft:rgba(91,141,239,.15);--border:#2a2f3a;--border2:#3a4a6b;--user-bubble:#5b8def;--ai-bubble:#1c1f26;--sys-bubble:rgba(91,141,239,.15);--sys-text:#93b3e8;--sys-border:#3a4a6b;}
[data-theme="amoled"]{--bg:#000;--bg2:#0a0a0a;--bg3:#050505;--bg-chat:#000;--text:#fff;--text2:#a0a0a0;--text3:#707070;--text-muted:#505050;--accent:#00d4ff;--accent2:#0099cc;--accent-soft:rgba(0,212,255,.12);--border:#1a1a1a;--border2:#2a2a2a;--user-bubble:#00d4ff;--user-text:#000;--ai-bubble:#0f0f0f;--ai-text:#e0e0e0;--sys-bubble:rgba(0,212,255,.1);--sys-text:#00d4ff;--sys-border:#1a3a4a;}
[data-theme="nord"]{--bg:#2e3440;--bg2:#3b4252;--bg3:#2e3440;--bg-chat:#2e3440;--text:#eceff4;--text2:#d8dee9;--text3:#88c0d0;--text-muted:#7b8a9c;--accent:#88c0d0;--accent2:#5e81ac;--accent-soft:rgba(136,192,208,.15);--border:#434c5e;--border2:#4c566a;--user-bubble:#5e81ac;--ai-bubble:#3b4252;--sys-bubble:rgba(136,192,208,.15);--sys-text:#88c0d0;--sys-border:#4c566a;}
[data-theme="solarized"]{--bg:#002b36;--bg2:#073642;--bg3:#002b36;--bg-chat:#002b36;--text:#eee8d5;--text2:#93a1a1;--text3:#b58900;--text-muted:#586e75;--accent:#b58900;--accent2:#cb4b16;--accent-soft:rgba(181,137,0,.15);--border:#073642;--border2:#586e75;--user-bubble:#268bd2;--ai-bubble:#073642;--sys-bubble:rgba(181,137,0,.15);--sys-text:#b58900;--sys-border:#586e75;}
[data-theme="sepia"]{--bg:#f4ecd8;--bg2:#e8dfc8;--bg3:#f9f3e4;--bg-chat:#f4ecd8;--text:#3a2f1e;--text2:#6b5d44;--text3:#8b7355;--text-muted:#a89678;--accent:#8b6f47;--accent2:#6b5537;--accent-soft:rgba(139,111,71,.15);--border:#d4c9a8;--border2:#a89678;--user-bubble:#8b6f47;--user-text:#fff;--ai-bubble:#e8dfc8;--ai-text:#3a2f1e;--sys-bubble:rgba(139,111,71,.15);--sys-text:#6b5537;--sys-border:#a89678;}
[data-theme="light"]{--bg:#fff;--bg2:#f5f5f7;--bg3:#fafafa;--bg-chat:#f8f8fa;--text:#1a1a1a;--text2:#444;--text3:#666;--text-muted:#999;--accent:#6366f1;--accent2:#4f46e5;--accent-soft:rgba(99,102,241,.12);--border:#e5e5e8;--border2:#d0d0d5;--user-bubble:#6366f1;--user-text:#fff;--ai-bubble:#f0f0f3;--ai-text:#1a1a1a;--sys-bubble:rgba(99,102,241,.1);--sys-text:#4f46e5;--sys-border:#d0d0d5;}
[data-theme="ocean"]{--bg:#0a1929;--bg2:#0d2137;--bg3:#0d2137;--bg-chat:#0a1929;--text:#e0f2ff;--text2:#7dd3fc;--text3:#38bdf8;--text-muted:#3b6f8f;--accent:#0ea5e9;--accent2:#0284c7;--accent-soft:rgba(14,165,233,.15);--border:#1e3a52;--border2:#2e5a7a;--user-bubble:#0ea5e9;--ai-bubble:#0d2137;--sys-bubble:rgba(14,165,233,.15);--sys-text:#7dd3fc;--sys-border:#2e5a7a;}
[data-theme="forest"]{--bg:#0a1f14;--bg2:#0d2e1e;--bg3:#0d2e1e;--bg-chat:#0a1f14;--text:#dcfce7;--text2:#86efac;--text3:#4ade80;--text-muted:#4b7a5a;--accent:#16a34a;--accent2:#15803d;--accent-soft:rgba(22,163,74,.15);--border:#1e3a2a;--border2:#2e5a40;--user-bubble:#16a34a;--ai-bubble:#0d2e1e;--sys-bubble:rgba(22,163,74,.15);--sys-text:#86efac;--sys-border:#2e5a40;}
[data-theme="cyberpunk"]{--bg:#0d0221;--bg2:#190b3a;--bg3:#190b3a;--bg-chat:#0d0221;--text:#fff;--text2:#ff79c6;--text3:#00ffff;--text-muted:#6b4d8a;--accent:#ff79c6;--accent2:#ff1493;--accent-soft:rgba(255,121,198,.2);--border:#3d1f5c;--border2:#ff79c6;--user-bubble:#ff79c6;--user-text:#0d0221;--ai-bubble:#190b3a;--ai-text:#00ffff;--sys-bubble:rgba(255,121,198,.15);--sys-text:#00ffff;--sys-border:#ff79c6;}
[data-theme="sunset"]{--bg:#1a0e0a;--bg2:#2d1810;--bg3:#2d1810;--bg-chat:#1a0e0a;--text:#ffedd5;--text2:#fdba74;--text3:#fb923c;--text-muted:#8b5a3c;--accent:#f97316;--accent2:#ea580c;--accent-soft:rgba(249,115,22,.15);--border:#3d2015;--border2:#5a3520;--user-bubble:#f97316;--ai-bubble:#2d1810;--sys-bubble:rgba(249,115,22,.15);--sys-text:#fdba74;--sys-border:#5a3520;}
[data-theme="rose"]{--bg:#1f0a1a;--bg2:#2e1028;--bg3:#2e1028;--bg-chat:#1f0a1a;--text:#ffe4f0;--text2:#f9a8d4;--text3:#ec4899;--text-muted:#8b4a70;--accent:#ec4899;--accent2:#db2777;--accent-soft:rgba(236,72,153,.15);--border:#3d1f35;--border2:#5a2f50;--user-bubble:#ec4899;--ai-bubble:#2e1028;--sys-bubble:rgba(236,72,153,.15);--sys-text:#f9a8d4;--sys-border:#5a2f50;}
[data-theme="matrix"]{--bg:#000;--bg2:#001100;--bg3:#001100;--bg-chat:#000;--text:#00ff41;--text2:#00cc33;--text3:#00ff41;--text-muted:#005511;--accent:#00ff41;--accent2:#00cc33;--accent-soft:rgba(0,255,65,.15);--border:#003300;--border2:#005500;--user-bubble:#00cc33;--user-text:#000;--ai-bubble:#001100;--ai-text:#00ff41;--sys-bubble:rgba(0,255,65,.1);--sys-text:#00ff41;--sys-border:#005500;}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html{height:100%;overflow:hidden;}
body{margin:0;padding:0;overflow:hidden;background:var(--bg);
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
  user-select:none;-webkit-user-select:none;overscroll-behavior:none;
  touch-action:manipulation;color:var(--text);width:100%;height:var(--vh,100vh);}
#app{position:relative;width:100%;height:var(--vh,100vh);
  display:flex;flex-direction:column;overflow:hidden;background:var(--bg);}
@media (min-width:520px) and (min-height:700px){
  body{display:flex;align-items:center;justify-content:center;background:var(--bg);}
  #app{width:460px;height:820px;max-height:96vh;
    border-radius:36px;border:10px solid var(--border);
    box-shadow:0 0 70px var(--accent-soft);}
}
#statusbar{flex:none;height:28px;display:flex;align-items:center;
  justify-content:space-between;padding:0 16px;font-size:11px;
  font-weight:700;color:var(--text2);background:var(--bg);z-index:50;
  border-bottom:1px solid var(--border);}
#header{flex:none;display:flex;align-items:center;gap:8px;
  padding:10px 12px;background:var(--bg2);
  border-bottom:1px solid var(--border);z-index:20;}
#aiSelector{flex:1;display:flex;align-items:center;gap:8px;
  padding:8px 12px;background:var(--bg3);
  border:1px solid var(--border2);border-radius:12px;
  cursor:pointer;transition:all .15s;min-width:0;}
#aiSelector:hover{border-color:var(--accent);}
#aiSelector:active{transform:scale(.98);background:var(--accent-soft);}
#aiSelector .sel-avatar{width:24px;height:24px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:13px;background:var(--accent);color:#fff;flex:none;overflow:hidden;}
#aiSelector .sel-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
#aiSelector .sel-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;}
#aiSelector .sel-name{font-size:12.5px;font-weight:800;color:var(--text);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#aiSelector .sel-sub{font-size:9.5px;color:var(--text-muted);font-weight:600;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#aiSelector .sel-arrow{font-size:10px;color:var(--text3);flex:none;}
#aiSelector.empty .sel-name{color:var(--text-muted);font-style:italic;}
#header .icon-btn{background:transparent;border:0;color:var(--text3);
  font-size:18px;padding:6px 8px;cursor:pointer;font-family:inherit;
  border-radius:8px;transition:background .15s;flex:none;}
#header .icon-btn:active{background:var(--accent-soft);}
#header .icon-btn[disabled]{opacity:.35;pointer-events:none;}
.mode-badge{font-size:9.5px;font-weight:800;
  padding:3px 7px;border-radius:6px;background:var(--accent);
  color:#fff;text-transform:uppercase;letter-spacing:.5px;flex:none;}
#chat{flex:1;padding:12px;display:flex;flex-direction:column;gap:10px;
  overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;
  background:var(--bg-chat);}
.msg{max-width:82%;padding:9px 12px;border-radius:14px;font-size:13.5px;
  line-height:1.5;word-wrap:break-word;animation:bIn .2s ease;
  white-space:pre-line;position:relative;}
@keyframes bIn{from{opacity:0;transform:translateY(6px);}
  to{opacity:1;transform:translateY(0);}}
.msg small{display:block;font-size:9px;opacity:.55;margin-top:4px;}
.msg.user{align-self:flex-end;background:var(--user-bubble);color:var(--user-text);
  border-bottom-right-radius:4px;}
.msg.ai{align-self:flex-start;background:var(--ai-bubble);color:var(--ai-text);
  border-bottom-left-radius:4px;border-left:3px solid var(--ai-color,var(--accent));}
.msg.ai .msg-head{display:flex;align-items:center;gap:6px;
  margin-bottom:4px;font-size:10.5px;font-weight:800;
  color:var(--ai-color,var(--accent));letter-spacing:.2px;}
.msg.ai .msg-head .mini-avatar{width:16px;height:16px;border-radius:50%;
  background:var(--ai-color,var(--accent));flex:none;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;color:#fff;overflow:hidden;}
.msg.ai .msg-head .mini-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
.msg.system{align-self:center;background:var(--sys-bubble);
  border:1px dashed var(--sys-border);color:var(--sys-text);font-size:11px;
  text-align:center;padding:6px 14px;max-width:90%;font-weight:600;}
.msg.selected{outline:2px solid var(--warn);outline-offset:2px;background-color:var(--warn-bg);}
.thinking{margin-top:6px;background:var(--bg3);
  border:1px solid var(--border2);border-radius:10px;
  font-size:10.5px;color:var(--text3);overflow:hidden;}
.thinking-head{display:flex;align-items:center;gap:6px;
  padding:7px 10px;font-weight:700;cursor:pointer;}
.thinking-head:active{background:var(--accent-soft);}
.thinking-head .arrow{font-size:10px;transition:transform .15s;display:inline-block;}
.thinking.expanded .thinking-head .arrow{transform:rotate(90deg);}
.thinking-head .tt{flex:1;}
.thinking-head .dur{font-size:9.5px;opacity:.65;font-family:ui-monospace,monospace;}
.thinking-body{display:none;padding:0 10px 8px;
  border-top:1px solid var(--border2);font-size:10px;line-height:1.5;
  font-family:ui-monospace,monospace;white-space:pre-wrap;
  color:var(--text2);max-height:300px;overflow-y:auto;}
.thinking.expanded .thinking-body{display:block;}
.typing{align-self:flex-start;display:flex;align-items:center;gap:8px;
  padding:8px 14px;background:var(--ai-bubble);color:var(--text2);
  border-radius:14px;border-bottom-left-radius:4px;font-size:11px;
  font-weight:700;animation:bIn .2s ease;}
.typing .pulse{width:6px;height:6px;border-radius:50%;
  background:var(--accent);animation:pulse 1.2s infinite;}
.typing .pulse:nth-child(2){animation-delay:.2s;}
.typing .pulse:nth-child(3){animation-delay:.4s;}
@keyframes pulse{0%,100%{opacity:.3;transform:scale(.8);}
  50%{opacity:1;transform:scale(1.2);}}
#inputBar{flex:none;display:flex;gap:8px;padding:10px 12px;
  background:var(--bg2);border-top:1px solid var(--border);
  padding-bottom:calc(10px + env(safe-area-inset-bottom,0px));}
#inputBar input{flex:1;padding:11px 14px;border-radius:14px;
  border:1px solid var(--border2);background:var(--bg3);color:var(--text);
  font-size:13.5px;font-family:inherit;outline:none;min-width:0;}
#inputBar input:focus{border-color:var(--accent);}
#inputBar input::placeholder{color:var(--text-muted);}
#inputBar button{padding:11px 18px;border-radius:14px;border:0;
  background:linear-gradient(145deg,var(--accent),var(--accent2));
  color:#fff;font-weight:800;font-size:16px;cursor:pointer;
  font-family:inherit;transition:transform .08s;}
#inputBar button:active{transform:scale(.94);}
#inputBar button[disabled]{opacity:.35;pointer-events:none;}
#selectBar{position:absolute;bottom:0;left:0;right:0;z-index:100;
  background:var(--bg2);border-top:2px solid var(--warn);
  padding:10px 12px;display:none;gap:8px;
  padding-bottom:calc(10px + env(safe-area-inset-bottom,0px));}
#selectBar.on{display:flex;}
#selectBar .info{flex:1;font-size:12px;color:var(--warn-text);
  display:flex;align-items:center;font-weight:700;}
#selectBar button{padding:10px 14px;border-radius:12px;border:0;
  font-size:12px;font-weight:800;font-family:inherit;cursor:pointer;}
#selectBar .btn-copy{background:var(--warn);color:#1a1030;}
#selectBar .btn-cancel{background:var(--danger-bg);color:var(--danger-text);}

.overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);
  display:none;align-items:center;justify-content:center;padding:20px;
  backdrop-filter:blur(6px);}
.overlay.on{display:flex;}
#menu{z-index:900;}
#battle{z-index:910;}
#groupBattle{z-index:915;}
#themePicker{z-index:920;}
#aiPicker{z-index:950;}

.modal{background:var(--bg2);border:1px solid var(--border2);
  border-radius:18px;max-width:400px;width:100%;max-height:85vh;
  display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.7);
  overflow:hidden;}
.modal-head{flex:none;display:flex;align-items:center;gap:10px;
  padding:14px 16px;border-bottom:1px solid var(--border);}
.modal-head h3{margin:0;font-size:15px;color:var(--text);flex:1;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.modal-head .close-btn{background:transparent;border:0;color:var(--text-muted);
  font-size:18px;cursor:pointer;padding:4px 8px;font-family:inherit;
  border-radius:6px;}
.modal-head .close-btn:active{background:var(--accent-soft);}
.modal-body{flex:1;overflow-y:auto;padding:12px 16px 16px;}

.search-box{position:relative;margin-bottom:10px;}
.search-box input{width:100%;padding:10px 14px 10px 36px;border-radius:10px;
  border:1px solid var(--border2);background:var(--bg3);color:var(--text);
  font-size:13px;font-family:inherit;outline:none;}
.search-box input:focus{border-color:var(--accent);}
.search-box::before{content:'🔍';position:absolute;left:12px;top:50%;
  transform:translateY(-50%);font-size:12px;opacity:.5;}

.ai-list{display:flex;flex-direction:column;gap:6px;}
.ai-item{display:flex;align-items:center;gap:10px;
  padding:10px 12px;border-radius:12px;
  background:var(--bg3);border:1px solid transparent;
  cursor:pointer;transition:all .15s;position:relative;}
.ai-item:hover{border-color:var(--border2);}
.ai-item:active{transform:scale(.98);background:var(--accent-soft);}
.ai-item.active{background:var(--accent-soft);border-color:var(--accent);}
.ai-item.in-battle{background:var(--warn-bg);border-color:var(--warn);}
.ai-item.in-group{background:rgba(34,197,94,.12);border-color:var(--ok);}
.ai-item.error{background:var(--danger-bg);border-color:var(--danger);}
.ai-item .item-avatar{width:32px;height:32px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;background:var(--accent);color:#fff;flex:none;overflow:hidden;}
.ai-item .item-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
.ai-item .item-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;}
.ai-item .item-name{font-size:13px;font-weight:800;color:var(--text);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ai-item .item-desc{font-size:10.5px;color:var(--text-muted);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ai-item .item-badge{font-size:9px;font-weight:800;
  padding:2px 6px;border-radius:4px;background:var(--accent);color:#fff;
  flex:none;text-transform:uppercase;letter-spacing:.3px;margin-left:4px;}
.ai-item.active .item-badge{background:var(--ok);}
.ai-item.in-battle .item-badge{background:var(--warn);color:#1a1030;}
.ai-item.in-group .item-badge{background:var(--ok);color:#000;}
.ai-item .item-badge.b2{background:var(--danger);color:#fff;}
.ai-list .empty{text-align:center;padding:24px 12px;color:var(--text-muted);
  font-size:12px;line-height:1.6;}
.ai-list .empty code{background:var(--bg3);padding:2px 6px;border-radius:4px;font-size:11px;}

.theme-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;}
.theme-item{display:flex;align-items:center;gap:8px;
  padding:10px;border-radius:12px;background:var(--bg3);
  border:1.5px solid transparent;cursor:pointer;transition:all .15s;}
.theme-item:hover{border-color:var(--border2);}
.theme-item:active{transform:scale(.97);}
.theme-item.active{border-color:var(--accent);background:var(--accent-soft);}
.theme-swatch{width:28px;height:28px;border-radius:8px;flex:none;
  border:1px solid rgba(255,255,255,.15);}
.theme-item .theme-name{font-size:11.5px;font-weight:700;color:var(--text);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

#menu .modal{max-width:340px;}
.menu-btn{width:100%;padding:12px 14px;border-radius:12px;
  border:1px solid var(--border2);background:var(--bg3);color:var(--text);
  font-size:13px;font-weight:700;font-family:inherit;cursor:pointer;
  text-align:left;transition:all .15s;margin-bottom:6px;
  display:flex;align-items:center;gap:10px;}
.menu-btn:active{transform:scale(.98);background:var(--accent-soft);}
.menu-btn.danger{border-color:var(--danger);color:var(--danger-text);}
.menu-btn:last-child{margin-bottom:0;}
.menu-btn[disabled]{opacity:.4;pointer-events:none;}

#battle .modal{max-width:400px;border-color:var(--warn);}
#battle .modal-head h3{color:var(--warn);}
.battle-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;}
.battle-slot{padding:10px;border-radius:10px;
  border:1px solid var(--border2);background:var(--bg3);
  cursor:pointer;transition:all .15s;position:relative;
  display:flex;flex-direction:column;gap:6px;}
.battle-slot:active{transform:scale(.98);background:var(--accent-soft);}
.battle-slot .bs-label{font-size:9.5px;color:var(--text-muted);
  text-transform:uppercase;letter-spacing:.5px;font-weight:800;}
.battle-slot .bs-row{display:flex;align-items:center;gap:8px;}
.battle-slot .bs-avatar{width:22px;height:22px;border-radius:50%;
  flex:none;display:flex;align-items:center;justify-content:center;
  font-size:11px;color:#fff;overflow:hidden;}
.battle-slot .bs-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
.battle-slot .bs-name{font-size:12.5px;font-weight:800;color:var(--text);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;}
.battle-slot .bs-swap{font-size:9px;color:var(--text-muted);font-weight:700;
  text-transform:uppercase;letter-spacing:.3px;}
.battle-slot.empty .bs-name{color:var(--text-muted);font-style:italic;}
.battle-slot.empty .bs-avatar{background:var(--border2) !important;}
.battle-slot.same{border-color:var(--warn);}

.battle-config{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;}
.battle-config label{font-size:11px;color:var(--text2);
  display:flex;flex-direction:column;gap:4px;}
.battle-config input{padding:8px 10px;border-radius:8px;
  border:1px solid var(--border2);background:var(--bg3);color:var(--text);
  font-size:12px;font-family:inherit;}
.modal-actions{display:flex;gap:8px;margin-top:6px;}
.modal-actions button{flex:1;padding:11px 14px;border-radius:12px;
  border:0;font-size:13px;font-weight:800;font-family:inherit;cursor:pointer;
  transition:transform .08s;}
.modal-actions button:active{transform:scale(.97);}
.modal-actions .btn-primary{background:linear-gradient(145deg,var(--accent),var(--accent2));color:#fff;}
.modal-actions .btn-warn{background:linear-gradient(145deg,#fbbf24,#d97706);color:#1a1030;}
.modal-actions .btn-ok{background:linear-gradient(145deg,#22c55e,#15803d);color:#fff;}
.modal-actions .btn-secondary{background:var(--bg3);color:var(--text2);}
.modal-actions button[disabled]{opacity:.4;pointer-events:none;}

#groupBattle .modal{max-width:420px;border-color:var(--ok);}
#groupBattle .modal-head h3{color:var(--ok);}
.group-pick-info{font-size:11.5px;color:var(--text2);margin:0 0 10px;}
.group-config{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;}
.group-config label{font-size:11px;color:var(--text2);
  display:flex;flex-direction:column;gap:4px;}
.group-config input{padding:8px 10px;border-radius:8px;
  border:1px solid var(--border2);background:var(--bg3);color:var(--text);
  font-size:12px;font-family:inherit;}
.group-topic{font-size:11px;color:var(--text2);display:flex;flex-direction:column;
  gap:4px;margin-bottom:10px;}
.group-topic input{padding:8px 10px;border-radius:8px;
  border:1px solid var(--border2);background:var(--bg3);color:var(--text);
  font-size:12px;font-family:inherit;}

.toast{position:fixed;left:50%;bottom:80px;transform:translateX(-50%) translateY(30px);
  background:var(--bg2);color:var(--text);padding:10px 16px;
  border-radius:14px;font-size:12px;font-weight:700;
  border:1px solid var(--border2);opacity:0;transition:.3s;z-index:2000;
  max-width:88%;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.4);}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

#battleProgress{position:absolute;top:0;left:0;right:0;height:3px;
  background:transparent;z-index:60;overflow:hidden;display:none;}
#battleProgress.on{display:block;}
#battleProgress .fill{height:100%;
  background:linear-gradient(90deg,var(--warn),var(--accent));
  width:0%;transition:width .3s;}
#battleProgress.group .fill{background:linear-gradient(90deg,var(--ok),var(--accent));}

#app.running #aiSelector,
#app.running #btnBattle,
#app.running #btnGroup,
#app.running .battle-slot{pointer-events:none;opacity:.5;}
#app.selecting #inputBar input,
#app.selecting #inputBar button,
#app.selecting #btnMenu,
#app.selecting #btnBattle,
#app.selecting #btnGroup,
#app.selecting #aiSelector{pointer-events:none;opacity:.5;}

/* ===== LOADING SCREEN ===== */
#loadingScreen{position:fixed;inset:0;z-index:9999;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:radial-gradient(circle at 50% 30%,var(--bg2),var(--bg));
  gap:20px;transition:opacity .4s;}
#loadingScreen.hidden{opacity:0;pointer-events:none;display:none;}
.loader-logo{font-size:56px;animation:lPulse 1.6s infinite;
  filter:drop-shadow(0 0 24px var(--accent-soft));}
@keyframes lPulse{0%,100%{opacity:.65;transform:scale(.94);}
  50%{opacity:1;transform:scale(1.06);}}
.loader-title{font-size:15px;font-weight:800;letter-spacing:2px;
  color:var(--text2);text-transform:uppercase;}
.loader-bar{width:280px;max-width:80vw;height:6px;border-radius:3px;
  background:var(--border);overflow:hidden;position:relative;}
.loader-fill{height:100%;width:0%;border-radius:3px;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  transition:width .3s cubic-bezier(.4,0,.2,1);}
.loader-status{font-size:13px;color:var(--text);font-weight:700;}
.loader-sub{font-size:11px;color:var(--text-muted);font-weight:600;
  min-height:14px;}
.loader-steps{display:flex;flex-direction:column;gap:4px;margin-top:6px;
  font-size:10px;color:var(--text-muted);}
.loader-steps .st{display:flex;align-items:center;gap:6px;}
.loader-steps .st .dot{width:6px;height:6px;border-radius:50%;
  background:var(--border2);}
.loader-steps .st.done .dot{background:var(--ok);}
.loader-steps .st.done{color:var(--text2);}
</style>
</head>
<body>

<!-- ЭКРАН ЗАГРУЗКИ -->
<div id="loadingScreen">
  <div class="loader-logo">🧠</div>
  <div class="loader-title">AI Sandbox</div>
  <div class="loader-bar"><div class="loader-fill" id="loadingFill"></div></div>
  <div class="loader-status" id="loadingStatus">Синхронизация…</div>
  <div class="loader-sub" id="loadingSub"></div>
  <div class="loader-steps" id="loadingSteps">
    <div class="st" data-step="0"><span class="dot"></span><span>Синхронизация окружения</span></div>
    <div class="st" data-step="1"><span class="dot"></span><span>Загрузка словаря</span></div>
    <div class="st" data-step="2"><span class="dot"></span><span>Инициализация ИИ-слотов</span></div>
    <div class="st" data-step="3"><span class="dot"></span><span>Настройка рендерера</span></div>
    <div class="st" data-step="4"><span class="dot"></span><span>Финальная синхронизация</span></div>
  </div>
</div>

<!-- ПРИЛОЖЕНИЕ -->
<div id="app" style="display:none;">
  <div id="statusbar">
    <span id="clock">00:00</span>
    <span id="statusTitle">AI SANDBOX</span>
  </div>

  <div id="header">
    <div id="aiSelector" class="empty">
      <div class="sel-avatar" style="background:var(--accent);">?</div>
      <div class="sel-info">
        <div class="sel-name">Выбрать ИИ</div>
        <div class="sel-sub">не подключено</div>
      </div>
      <span class="sel-arrow">▾</span>
    </div>
    <span class="mode-badge" id="modeBadge">SINGLE</span>
    <button class="icon-btn" id="btnBattle" title="1v1 Battle">⚔</button>
    <button class="icon-btn" id="btnGroup" title="Групповой батл">👥</button>
    <button class="icon-btn" id="btnMenu" title="Меню">⋯</button>
  </div>

  <div id="battleProgress"><div class="fill" id="battleFill"></div></div>

  <div id="chat"></div>

  <div id="selectBar">
    <div class="info" id="selectInfo">Выбрано: 0</div>
    <button type="button" class="btn-copy" id="btnCopySelected">Копировать</button>
    <button type="button" class="btn-cancel" id="btnCancelSelect">Отмена</button>
  </div>

  <div id="inputBar">
    <input id="chatIn" placeholder="Напиши что-нибудь..."
           autocomplete="off" autocapitalize="sentences" spellcheck="false">
    <button id="chatSend" type="button">➤</button>
  </div>
</div>

<!-- AI Picker -->
<div class="overlay" id="aiPicker">
  <div class="modal">
    <div class="modal-head">
      <h3 id="aiPickerTitle">Выбор ИИ</h3>
      <button class="close-btn" id="aiPickerClose">✕</button>
    </div>
    <div class="modal-body">
      <div class="search-box">
        <input type="text" id="aiSearch" placeholder="Поиск ИИ..." autocomplete="off">
      </div>
      <div class="ai-list" id="aiList"></div>
    </div>
  </div>
</div>

<!-- Theme Picker -->
<div class="overlay" id="themePicker">
  <div class="modal">
    <div class="modal-head">
      <h3>Тема оформления</h3>
      <button class="close-btn" id="themePickerClose">✕</button>
    </div>
    <div class="modal-body">
      <div class="theme-grid" id="themeGrid"></div>
    </div>
  </div>
</div>

<!-- Menu -->
<div class="overlay" id="menu">
  <div class="modal">
    <div class="modal-head">
      <h3>Меню</h3>
      <button class="close-btn" id="menuClose">✕</button>
    </div>
    <div class="modal-body">
      <button class="menu-btn" id="mTheme">🎨 Тема оформления</button>
      <button class="menu-btn" id="mExport">📋 Скопировать всю переписку</button>
      <button class="menu-btn" id="mSelect">✂️ Выбрать сообщения</button>
      <button class="menu-btn" id="mBattle">⚔️ 1v1 Battle</button>
      <button class="menu-btn" id="mGroup">👥 Групповой батл</button>
      <button class="menu-btn" id="mStop">⏹ Остановить батл</button>
      <button class="menu-btn" id="mReload">🔄 Перезагрузить ИИ</button>
      <button class="menu-btn" id="mInfo">ℹ️ Информация о ИИ</button>
      <button class="menu-btn danger" id="mClear">🗑 Очистить чат</button>
      <button class="menu-btn danger" id="mReset">↺ Сбросить все ИИ</button>
    </div>
  </div>
</div>

<!-- Battle 1v1 -->
<div class="overlay" id="battle">
  <div class="modal">
    <div class="modal-head">
      <h3>⚔️ Battle двух ИИ</h3>
      <button class="close-btn" id="battleClose">✕</button>
    </div>
    <div class="modal-body">
      <div class="battle-pair">
        <div class="battle-slot empty" id="bSlotA">
          <div class="bs-label">ИИ #1</div>
          <div class="bs-row">
            <div class="bs-avatar">?</div>
            <div class="bs-name">Выбрать</div>
          </div>
          <div class="bs-swap">нажми чтобы изменить</div>
        </div>
        <div class="battle-slot empty" id="bSlotB">
          <div class="bs-label">ИИ #2</div>
          <div class="bs-row">
            <div class="bs-avatar">?</div>
            <div class="bs-name">Выбрать</div>
          </div>
          <div class="bs-swap">нажми чтобы изменить</div>
        </div>
      </div>
      <div class="battle-config">
        <label>Раундов
          <input type="number" id="bRounds" value="6" min="2" max="50">
        </label>
        <label>Задержка (мс)
          <input type="number" id="bDelay" value="1200" min="300" max="5000" step="100">
        </label>
      </div>
      <label style="font-size:11px;color:var(--text2);display:flex;flex-direction:column;gap:4px;margin-bottom:10px;">
        Стартовая тема
        <input type="text" id="bTopic" placeholder="Например: смысл жизни"
               style="padding:8px 10px;border-radius:8px;border:1px solid var(--border2);
                      background:var(--bg3);color:var(--text);font-size:12px;font-family:inherit;">
      </label>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="btnBattleCancel">Отмена</button>
        <button type="button" class="btn-warn" id="btnBattleStart">Начать</button>
      </div>
    </div>
  </div>
</div>

<!-- Group Battle -->
<div class="overlay" id="groupBattle">
  <div class="modal">
    <div class="modal-head">
      <h3>👥 Групповой батл</h3>
      <button class="close-btn" id="groupClose">✕</button>
    </div>
    <div class="modal-body">
      <p class="group-pick-info" id="groupPickInfo">Выбери 2+ ИИ. Один раунд = каждый ИИ говорит по разу.</p>
      <div class="ai-list" id="groupAiList"></div>
      <div class="group-config" style="margin-top:12px;">
        <label>Раундов
          <input type="number" id="gRounds" value="3" min="1" max="20">
        </label>
        <label>Задержка (мс)
          <input type="number" id="gDelay" value="1200" min="300" max="5000" step="100">
        </label>
      </div>
      <label class="group-topic">
        Стартовая тема
        <input type="text" id="gTopic" placeholder="Например: смысл жизни">
      </label>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="btnGroupCancel">Отмена</button>
        <button type="button" class="btn-ok" id="btnGroupStart" disabled>Начать</button>
      </div>
    </div>
  </div>
</div>

<script>
/* ============================================================================
   ВСТРОЕННЫЙ СЛОВАРЬ
   ============================================================================ */
var KT_DICT = ["не","на","что","он","как","его","это","но","по","из","все","за","от","же","так","вы","для","то","бы","было","быть","мы","только","она","или","их","они","еще","если","мне","ее","был","меня","когда","чтобы","уже","ты","до","ни","да","ему","при","сказал","сказать","может","вот","были","нет","даже","время","чем","во","со","ли","нас","себя","под","того","была","есть","после","вас","этого","раз","где","этом","этот","будет","него","теперь","тем","вам","без","очень","можно","там","кто","себе","которые","который","через","них","том","эти","нам","всех","однако","один","более","человек","им","ничего","здесь","перед","между","также","ведь","ну","потому","всего","слова","слово","тут","своей","свой","несколько","надо","больше","этой","об","тогда","потом","ним","тот","свою","всегда","ей","два","сам","лишь","пока","день","тебя","тоже","лет","год","жизни","жизнь","над","просто","мой","мог","мочь","человека","такой","этих","людей","тебе","хотя","дело","своих","сейчас","своего","глаза","глаз","ней","другой","уж","свои","тех","сказала","всем","эта","люди","времени","чего","почти","хорошо","спросил","спрашивать","именно","собой","эту","никогда","которых","должен","должный","нее","конечно","которой","друг","могут","например","почему","три","случае","случай","много","свое","руки","рука","те","поэтому","совсем","года","стал","становиться","одной","ответил","отвечать","вдруг","затем","тому","которая","оно","вместе","других","которого","образом","образ","части","часть","этим","совершенно","своим","сразу","таким","будто","одного","должны","стороны","сторона","лучше","такое","является","являться","такие","нужно","знаю","знать","про","снова","наконец","нельзя","против","нем","значит","немой","прежде","голос","никто","лицо","граф","составе","состав","опять","весь","голову","среди","голова","куда","руку","могу","слов","кроме","место","наши","наш","что-то","каждый","одно","которое","какой","сегодня","всю","говорил","говорить","вопрос","хоть","ко","одна","следует","двух","следовать"