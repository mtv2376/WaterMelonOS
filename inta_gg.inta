  'Слушай, а ты глубоко копаешь.',
  'Ясно. Ну, не совсем ясно, но ясно.'
]};

/* ---------- ДЕТЕКТ ИНТЕНТОВ ---------- */
function detect(text) {
  var t = ' ' + String(text).toLowerCase() + ' ';
  var w = tokenize(text);
  var best = null, bestScore = 0;

  for (var i = 0; i < INTENTS.length; i++) {
    var it = INTENTS[i], score = 0;
    for (var j = 0; j < it.k.length; j++) {
      var key = it.k[j], hit = false;
      if (key.indexOf(' ') !== -1) {
        if (t.indexOf(key) !== -1) hit = true;
      } else {
        for (var q = 0; q < w.length; q++) {
          if (w[q] === key || (key.length >= 4 && w[q].indexOf(key) === 0)) { hit = true; break; }
        }
      }
      if (hit) score += 1 + pget(it.id + j) * 0.4;
    }
    if (score > bestScore) { bestScore = score; best = it; }
  }
  return best || FALLBACK;
}

/* ---------- ПЬЯНАЯ ТРАНСФОРМАЦИЯ ---------- */
function mess(s, rate) {
  var out = '';
  for (var i = 0; i < s.length; i++) {
    var ch = s[i];
    if (/[а-яё]/i.test(ch)) {
      if (Math.random() < rate) { out += ch + ch; continue; }
      if (Math.random() < rate * 0.55) continue;
    }
    out += ch;
  }
  return out;
}

function drunkify(s, lvl) {
  if (lvl <= 0) return s;

  if (lvl >= 3) {
    var g = pick(GIBBERISH);
    if (Math.random() < 0.35) g += ' ' + pick(GIBBERISH);
    if (Math.random() < 0.2) g += ' ' + pick(GIBBERISH);
    return g;
  }

  var out = String(s)
    .replace(/что/g, 'шо')
    .replace(/тебя/g, 'тебе')
    .replace(/это/g, 'этта')
    .replace(/тоже/g, 'тож')
    .replace(/ничего/g, 'ничо')
    .replace(/вообще/g, 'вапще')
    .replace(/совсем/g, 'савсем')
    .replace(/понимаешь/g, 'панимаиш')
    .replace(/может/g, 'мож')
    .replace(/тся/g, 'ца')
    .replace(/ться/g, 'ца');

  out = mess(out, lvl === 1 ? 0.02 : 0.075);

  if (lvl === 1) {
    if (Math.random() < 0.45) out = pick(DRUNK_INTRO) + ' ' + out;
    if (Math.random() < 0.35) out += ' ' + pick(DRUNK_OUTRO);
    if (Math.random() < 0.18) out += ' Ик.';
  } else {
    out = pick(DRUNK_INTRO) + ' ' + out + ' ' + pick(DRUNK_OUTRO);
    if (Math.random() < 0.5) out = out.replace(/\./g, Math.random() < 0.5 ? '...' : ',');
    if (Math.random() < 0.45) out += ' Ик.';
    if (Math.random() < 0.3) out += ' ' + pick(DRUNK_LINES[2]);
  }
  return out;
}

/* ---------- ОТВЕТ ---------- */
return {

  async send(text, ctx) {
    var raw = (text == null) ? '' : String(text);
    remember('user', raw);

    /* --- опьянение --- */
    var m = countMat(raw);
    if (m > 0) {
      matHits += Math.min(m, 3) * P.drink;   // с первого мата — уже пьян
      soberStreak = 0;
    } else {
      soberStreak++;
      if (soberStreak >= 10 && matHits > 0) { matHits--; soberStreak = 0; } // медленно трезвеет
    }

    var lvl = drunkLevel();

    /* --- интент --- */
    var intent = detect(raw);
    LAST.intent = intent.id;
    LAST.level = lvl;

    /* --- «мышление» --- */
    var think = 160 + Math.random() * 380 + lvl * 260;
    if (isRepeat(raw)) think += 120; // повтор — думает дольше
    await _sleep(think);

    /* --- выбор ответа --- */
    var h = tokenHash(raw);
    var base;

    if (lvl >= 1 && Math.random() < 0.30 + lvl * 0.12) {
      /* пьяная реплика вместо нормальной */
      base = (lvl >= 2) ? pick(DRUNK_LINES[2]) : pick(DRUNK_LINES[1]);
    } else {
      var pool = intent.r;
      base = pool[h % pool.length];
      if (pool.length > 1 && base === pick(pool)) base = pool[(h + 1) % pool.length];
    }

    /* --- пьяная деградация текста --- */
    var out = drunkify(base, lvl);

    /* --- 1488 параметров в дело --- */
    ptick(intent.id);
    ptick('lvl' + lvl);
    ptick('mat' + matHits);

    /* --- 228 токенов: иногда добавляем «мысль» из словаря --- */
    if (lvl <= 1 && Math.random() < 0.08) {
      out += ' ' + TOKENS[h % 228] + '.';
    }

    /* --- память 67 --- */
    remember('ai', out);

    return out;
  },

  reset() {
    MEM.length = 0;
    matHits = 0;
    soberStreak = 0;
    LAST.intent = '—';
    LAST.level = 0;
    var s = 1337;
    for (var i = 0; i < 1488; i++) {
      s = (s * 1103515245 + 12345) % 2147483648;
      P['p' + i] = s / 2147483648;
    }
    P.temp = 0.92; P.wit = 0.88; P.empathy = 0.71;
    P.typo = 0.05; P.drink = 1.0; P.chaos = 0.35;
  },

  getThinking() {
    var lvl = drunkLevel();
    return 'интент: ' + LAST.intent +
      ' · уровень: ' + lvl + ' (' + LEVEL_NAME[lvl] + ')' +
      ' · мат-заряд: ' + matHits +
      ' · память: ' + MEM.length + '/' + CFG.memory +
      ' · параметров: ' + CFG.params +
      ' · токенов: ' + CFG.tokens;
  }
};
</script>
<!-- ═══════════════════════════════════════════════════════════════
     SANDBOX IDLE — загрузка внешних ИИ-модулей
     HTML + CSS + JS в одном блоке. Вставлять перед </body>.
     ═══════════════════════════════════════════════════════════════ -->

<style>
.idle-editor-wrap{position:relative;height:300px;margin-bottom:10px;
  border:1px solid var(--border2);border-radius:10px;overflow:hidden;
  background:var(--bg);}
.idle-highlight,#idleCode{position:absolute;inset:0;margin:0;
  padding:10px 12px;font-family:ui-monospace,monospace;font-size:12px;
  line-height:1.55;white-space:pre-wrap;word-break:break-word;
  overflow:auto;border:0;background:transparent;
  tab-size:2;-moz-tab-size:2;}
.idle-highlight{pointer-events:none;z-index:1;color:var(--text);}
#idleCode{z-index:2;color:transparent;caret-color:var(--accent);
  resize:none;outline:none;}
#idleCode::selection{background:var(--accent-soft);}
.idle-highlight .k{color:#c084fc;font-weight:700;}
.idle-highlight .s{color:#86efac;}
.idle-highlight .c{color:#7c6b9e;font-style:italic;}
.idle-highlight .n{color:#fbbf24;}
.idle-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;}
.idle-grid label{font-size:11px;color:var(--text2);display:flex;
  flex-direction:column;gap:4px;font-weight:700;}
.idle-grid input{padding:7px 10px;border-radius:8px;
  border:1px solid var(--border2);background:var(--bg3);color:var(--text);
  font-size:12px;font-family:inherit;outline:none;}
.idle-grid input:focus{border-color:var(--accent);}
.idle-actions{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap;}
.idle-btn{flex:1;min-width:110px;padding:10px 14px;border-radius:10px;
  border:0;font-size:12px;font-weight:800;font-family:inherit;
  cursor:pointer;transition:transform .1s;}
.idle-btn:active{transform:scale(.97);}
.idle-file{background:var(--bg3);color:var(--text2);
  border:1px solid var(--border2);}
.idle-validate{background:linear-gradient(145deg,#fbbf24,#d97706);color:#1a1030;}
.idle-load{background:linear-gradient(145deg,#22c55e,#15803d);color:#fff;}
.idle-status{padding:10px 12px;border-radius:8px;font-size:11px;
  background:var(--bg3);border:1px solid var(--border);
  color:var(--text2);min-height:38px;line-height:1.5;
  white-space:pre-wrap;word-break:break-word;
  font-family:ui-monospace,monospace;}
.idle-status.ok{border-color:var(--ok);color:#86efac;}
.idle-status.err{border-color:var(--danger);color:#fca5a5;}
.idle-status.warn{border-color:var(--warn);color:#fde68a;}
</style>

<div class="overlay" id="idleOverlay">
  <div class="modal" style="max-width:620px;">
    <div class="modal-head">
      <h3>🔌 Sandbox IDLE</h3>
      <button class="close-btn" id="idleClose">✕</button>
    </div>
    <div class="modal-body">
      <div class="idle-editor-wrap">
        <pre class="idle-highlight" id="idleHighlight"></pre>
        <textarea id="idleCode" spellcheck="false"
placeholder="// Вставь код модуля.
// Модуль должен вернуть { send, reset, getThinking }
//
// Пример:
//   return {
//     async send(text, ctx){
//       await KT.sleep(300);
//       return 'привет';
//     },
//     reset(){},
//     getThinking(){ return null; }
//   };
//
// Доступен только SAFE_KT: sleep, rnd, uid, now, esc,
// timeShort, buzz, rndWord, rndWords, DICT.
// Без store, mode, chat, registerAI."></textarea>
      </div>

      <div class="idle-grid">
        <label>ID<input type="text" id="idleId" placeholder="ext-ai"></label>
        <label>Name<input type="text" id="idleName" placeholder="External AI"></label>
        <label>Color<input type="color" id="idleColor" value="#22d3ee"></label>
        <label>Avatar<input type="text" id="idleAvatar" value="🔌" maxlength="4"></label>
        <label>Version<input type="text" id="idleVersion" value="1.0"></label>
        <label>Description<input type="text" id="idleDesc" placeholder="loaded from file"></label>
      </div>

      <div class="idle-actions">
        <button class="idle-btn idle-file"     id="idleFileBtn">📂 Открыть файл</button>
        <button class="idle-btn idle-validate" id="idleValidate">✓ Проверить</button>
        <button class="idle-btn idle-load"     id="idleLoad">▶ Загрузить</button>
      </div>

      <input type="file" id="idleFileInput" accept=".js,.txt,text/javascript" style="display:none">

      <div class="idle-status" id="idleStatus">Готово. Вставь код или открой .js файл.</div>
    </div>
  </div>
</div>

<script>
(function(){
'use strict';
if (window.__KtIdleLoaded) return;
window.__KtIdleLoaded = true;

var $id = function(s){ return document.getElementById(s); };

/* ─────────── ИЗОЛИРОВАННЫЙ KT ─────────── */
/* Модуль НЕ получает: store, mode, chat, registerAI,
   unregisterAllAIs, UI, reloadAISlots, getAI, listAIs. */
var SAFE_KT = Object.freeze({
  sleep: KT.sleep,
  rnd: KT.rnd,
  uid: KT.uid,
  now: KT.now,
  esc: KT.esc,
  timeShort: KT.timeShort,
  buzz: KT.buzz,
  rndWord: KT.rndWord,
  rndWords: KT.rndWords,
  DICT: KT.DICT
});

/* ─────────── ПАРСИНГ META ─────────── */
function parseMetaFromCode(code){
  var m = code.match(/<!--([\s\S]*?)-->/);
  if (!m) return null;
  try {
    var raw = m[1].trim().replace(/,(\s*[}\]])/g, '$1');
    return JSON.parse(raw);
  } catch(e){ return null; }
}

/* ─────────── ПОДСВЕТКА СИНТАКСИСА ─────────── */
function escapeHtml(s){
  return String(s).replace(/[<>&]/g, function(c){
    return c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;';
  });
}
function highlight(code){
  var parts = [], last = 0;
  var re = /(\/\/[^\n]*)|('[^'\n]*'|"[^"\n]*"|`[^`]*`)|\b(async|await|function|return|var|let|const|if|else|for|while|try|catch|new|this|typeof|instanceof|class|of|in|switch|case|break|continue|do|finally|throw|delete|void|yield)\b|\b(\d+(?:\.\d+)?)\b/g;
  var m;
  while ((m = re.exec(code)) !== null){
    if (m.index > last) parts.push(escapeHtml(code.slice(last, m.index)));
    if (m[1]) parts.push('<span class="c">' + escapeHtml(m[1]) + '</span>');
    else if (m[2]) parts.push('<span class="s">' + escapeHtml(m[2]) + '</span>');
    else if (m[3]) parts.push('<span class="k">' + escapeHtml(m[3]) + '</span>');
    else if (m[4]) parts.push('<span class="n">' + escapeHtml(m[4]) + '</span>');
    last = re.lastIndex;
  }
  if (last < code.length) parts.push(escapeHtml(code.slice(last)));
  return parts.join('');
}

/* ─────────── ВАЛИДАЦИЯ ─────────── */
async function validateModule(code, meta){
  var AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;
  var fn;
  try {
    fn = new AsyncFunction('KT', 'meta', code);
  } catch(e){
    return { ok:false, error:'Syntax: ' + e.message };
  }
  var body;
  try {
    body = await Promise.race([
      fn(SAFE_KT, meta),
      new Promise(function(_, rej){
        setTimeout(function(){ rej(new Error('module init timeout 5s')); }, 5000);
      })
    ]);
  } catch(e){
    return { ok:false, error:'Init: ' + (e && e.message ? e.message : e) };
  }
  if (!body || typeof body.send !== 'function'){
    return { ok:false, error:'Модуль не вернул { send: fn }' };
  }
  try {
    var testReply = await Promise.race([
      body.send('привет', { fromAI:false, history:[] }),
      new Promise(function(_, rej){
        setTimeout(function(){ rej(new Error('send() timeout 5s')); }, 5000);
      })
    ]);
    if (typeof testReply !== 'string' &&
        (!testReply || typeof testReply.reply !== 'string')){
      return { ok:false, error:'send() вернул не string и не { reply }' };
    }
  } catch(e){
    return { ok:false, error:'send(): ' + (e && e.message ? e.message : e) };
  }
  return { ok:true, body: body };
}

/* ─────────── СТАТУС ─────────── */
function setStatus(text, kind){
  var el = $id('idleStatus');
  if (!el) return;
  el.textContent = text;
  el.className = 'idle-status' + (kind ? ' ' + kind : '');
}

/* ─────────── ОТКРЫТИЕ / ЗАКРЫТИЕ ─────────── */
function openIdle(){
  var ov = $id('idleOverlay');
  if (!ov) return;
  $id('idleCode').value = '';
  $id('idleHighlight').innerHTML = '';
  $id('idleId').value = '';
  $id('idleName').value = '';
  $id('idleColor').value = '#22d3ee';
  $id('idleAvatar').value = '🔌';
  $id('idleVersion').value = '1.0';
  $id('idleDesc').value = '';
  $id('idleFileInput').value = '';
  setStatus('Готово. Вставь код или открой .js файл.');
  ov.classList.add('on');
}
function closeIdle(){
  var ov = $id('idleOverlay');
  if (ov) ov.classList.remove('on');
}

/* ─────────── ЗАГРУЗКА В СЛОТЫ ─────────── */
async function loadIntoSlots(){
  var code = $id('idleCode').value.trim();
  if (!code){ setStatus('Нет кода', 'err'); return; }

  var metaFromCode = parseMetaFromCode(code) || {};
  var ts = Date.now();
  var rand = Math.random().toString(36).slice(2, 7);

  var id      = ($id('idleId').value      || metaFromCode.id          || ('ext-' + ts + '-' + rand)).trim();
  var name    = ($id('idleName').value    || metaFromCode.name        || 'External AI').trim();
  var color   = $id('idleColor').value    || metaFromCode.color       || '#22d3ee';
  var avatar  = $id('idleAvatar').value   || metaFromCode.avatar      || '🔌';
  var version = $id('idleVersion').value  || metaFromCode.version     || '1.0';
  var desc    = $id('idleDesc').value     || metaFromCode.description || '';

  if (KT.getAI(id)){
    setStatus('ID уже занят: ' + id + '\nПереименуй ID.', 'err');
    return;
  }

  setStatus('Проверка модуля…', 'warn');
  var meta = { id:id, name:name, color:color, avatar:avatar,
               version:version, description:desc };
  var res = await validateModule(code, meta);

  if (!res.ok){
    setStatus('ОШИБКА:\n' + res.error, 'err');
    return;
  }

  KT.registerAI({
    id: id, name: name, color: color, avatar: avatar,
    description: desc, version: version,
    send: res.body.send,
    reset: res.body.reset || function(){},
    getThinking: res.body.getThinking || function(){ return null; }
  });

  /* прокидываем опциональные методы */
  var registered = KT.getAI(id);
  if (registered){
    ['getMood','getMode','getStats','getMemory','getFacts'].forEach(function(m){
      if (typeof res.body[m] === 'function') registered[m] = res.body[m];
    });
  }

  setStatus('OK. Слот "' + name + '" (' + id + ') зарегистрирован.', 'ok');
  if (KT.UI && KT.UI.updateAISelector) KT.UI.updateAISelector();
  setTimeout(closeIdle, 900);
}

/* ─────────── КНОПКА В МЕНЮ ─────────── */
function injectMenuButton(){
  var menu = document.querySelector('#menu .modal-body');
  if (!menu){ setTimeout(injectMenuButton, 300); return; }
  if ($id('mIdle')) return;

  var btn = document.createElement('button');
  btn.className = 'menu-btn';
  btn.id = 'mIdle';
  btn.textContent = '🔌 Загрузить внешний ИИ';

  var mReload = $id('mReload');
  if (mReload && mReload.parentNode === menu) menu.insertBefore(btn, mReload.nextSibling);
  else menu.appendChild(btn);

  btn.addEventListener('click', function(){
    var menuOv = $id('menu');
    if (menuOv) menuOv.classList.remove('on');
    setTimeout(openIdle, 100);
  });
}

/* ─────────── ИНИЦИАЛИЗАЦИЯ ─────────── */
function init(){
  injectMenuButton();

  $id('idleClose').addEventListener('click', closeIdle);
  $id('idleOverlay').addEventListener('click', function(e){
    if (e.target === this) closeIdle();
  });

  var codeArea = $id('idleCode');
  var hlEl = $id('idleHighlight');

  codeArea.addEventListener('input', function(){
    hlEl.innerHTML = highlight(codeArea.value);
    hlEl.scrollTop = codeArea.scrollTop;
    hlEl.scrollLeft = codeArea.scrollLeft;
  });
  codeArea.addEventListener('scroll', function(){
    hlEl.scrollTop = codeArea.scrollTop;
    hlEl.scrollLeft = codeArea.scrollLeft;
  });

  /* Tab внутри textarea */
  codeArea.addEventListener('keydown', function(e){
    if (e.key === 'Tab'){
      e.preventDefault();
      var s = this.selectionStart, en = this.selectionEnd;
      this.value = this.value.slice(0, s) + '  ' + this.value.slice(en);
      this.selectionStart = this.selectionEnd = s + 2;
      hlEl.innerHTML = highlight(this.value);
    }
  });

  $id('idleFileBtn').addEventListener('click', function(){
    $id('idleFileInput').click();
  });

  $id('idleFileInput').addEventListener('change', function(e){
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(ev){
      var text = String(ev.target.result || '');
      codeArea.value = text;
      hlEl.innerHTML = highlight(text);
      var meta = parseMetaFromCode(text);
      if (meta){
        if (meta.id && !$id('idleId').value) $id('idleId').value = meta.id;
        if (meta.name && !$id('idleName').value) $id('idleName').value = meta.name;
        if (meta.color) $id('idleColor').value = meta.color;
        if (meta.avatar) $id('idleAvatar').value = meta.avatar;
        if (meta.version) $id('idleVersion').value = meta.version;
        if (meta.description) $id('idleDesc').value = meta.description;
      }
      setStatus('Файл: ' + file.name + ' (' + text.length + ' символов)', 'warn');
    };
    reader.readAsText(file);
  });

  $id('idleValidate').addEventListener('click', async function(){
    var code = codeArea.value.trim();
    if (!code){ setStatus('Нет кода', 'err'); return; }
    setStatus('Проверка…', 'warn');
    var meta = parseMetaFromCode(code) || { id:'test', name:'test' };
    var res = await validateModule(code, meta);
    if (res.ok) setStatus('OK. Модуль валиден. Готов к загрузке.', 'ok');
    else setStatus('ОШИБКА:\n' + res.error, 'err');
  });

  $id('idleLoad').addEventListener('click', loadIntoSlots);

  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape'){
      var ov = $id('idleOverlay');
      if (ov && ov.classList.contains('on')) closeIdle();
    }
  });
}

if (document.readyState === 'loading')
  document.addEventListener('DOMContentLoaded', init);
else setTimeout(init, 500);

})();
</script>
<!-- ═══════════════════════════════════════════════════════════════ -->
 <!-- ═══════════════════════════════════════════════════════════════
     SANDBOX DEV DOCS v2 — большая статья о разработке ИИ
     Вставлять перед </body>. После блока IDLE.
