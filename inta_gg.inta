// -------------------------------------------------------------
// SECTION 4.32 — Индексы для быстрого поиска тем
// -------------------------------------------------------------

function buildTopicIndexes(){
  const byWord = {};
  const byId = {};
  const byKind = { fact: {}, emotion: {}, context: {}, hybrid: {} };

  for (const id of _keys(TOPICS)){
    const t = TOPICS[id];
    if (!t || !t.id) continue;
    byId[t.id] = t;
    if (t.kind && byKind[t.kind]) byKind[t.kind][t.id] = t;
    if (t.words){
      for (const w of _keys(t.words)){
        if (!byWord[w]) byWord[w] = {};
        byWord[w][t.id] = t.words[w];
      }
    }
  }
  return { byWord: byWord, byId: byId, byKind: byKind };
}

const TOPIC_INDEX = buildTopicIndexes();

