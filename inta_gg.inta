  /* Bootstrap */
  (function bootstrap(){
    var all = [];
    for (var i = 0; i < INTENTS.length; i++) all.push.apply(all, INTENTS[i].examples);
    for (var pass = 0; pass < 6; pass++){
      var lr = pass === 0 ? 0.08 : pass === 1 ? 0.05 : 0.03;
      for (var j = 0; j < all.length; j++) vocab.cooccur(stemsOf(all[j]), 4, lr);
    }
    for (var k = 0; k < INTENTS.length; k++){
      var it = INTENTS[k];
      var c = new Float32Array(vocab.dim);
      for (var m = 0; m < it.examples.length; m++){
        var v = vocab.sentVec(stemsOf(it.examples[m]));
        for (var d = 0; d < vocab.dim; d++) c[d] += v[d];
      }
      for (var d2 = 0; d2 < vocab.dim; d2++) c[d2] /= it.examples.length;
      var n = 0;
      for (var d3 = 0; d3 < vocab.dim; d3++) n += c[d3] * c[d3];
      n = Math.sqrt(n) || 1;
      for (var d4 = 0; d4 < vocab.dim; d4++) c[d4] /= n;
      it.centroid = c;
    }
  })();

  function classifyEmb(stems){
    var v = vocab.sentVec(stems);
    var scores = [];
    for (var i = 0; i < INTENTS.length; i++){
      var it = INTENTS[i];
      var raw = cos(v, it.centroid);
      var overlap = 0;
      for (var j = 0; j < it.examples.length; j++){
        var es = stemsOf(it.examples[j]);
        for (var k = 0; k < es.length; k++) if (stems.indexOf(es[k]) !== -1) overlap++;
      }
      var s = raw * 0.7 + (overlap > 0 ? 0.3 + Math.min(overlap * 0.08, 0.5) : 0);
      scores.push({ name: it.name, score: s });
    }
    scores.sort(function(a, b){ return b.score - a.score; });
    return scores;
  }

