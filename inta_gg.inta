/* ---------------------------------------------------------------------------
   Маркеры интентов-модификаторов (проверяются раньше основных)
   --------------------------------------------------------------------------- */
var KT_MODIFIER_MARKERS = {
  /* "а ты?", "а у тебя?", "а как у тебя?" — запрос о собеседнике */
  ask_back: /^\s*а?\s*(ты|у\s+тебя|тебе|как\s+у\s+тебя|как\s+ты|твоё|твое|твоя)\s*\??\s*$/i,

  /* "и я", "я тоже", "у меня тоже" — присоединение */
  agree_short: /^\s*(и\s+я|я\s+тоже|тоже|у\s+меня\s+тоже)\b/i,

  /* "а я ..." — контраст */
  contrast: /^\s*а\s+я\b/i,

  /* "а что если", "а может" — предложение */
  propose: /^\s*(а\s+что\s+если|а\s+может|может\s+попробуем)/i,

  /* "ну и", "и что" — вызов/провокация */
  provocation: /^\s*(ну\s+и|и\s+что|и\s+чо|и\s+чё)\b/i
};

/* ---------------------------------------------------------------------------
   Маркеры юмора/сарказма (для корректировки sentiment)
   --------------------------------------------------------------------------- */
var KT_SARCASM_MARKERS = [
  /\/s\b/i,
  /сарказм/i,
  /ну\s+да\s+конечно/i,
  /ага\s+конечно/i,
  /разумеется\s*🙄/i,
  /😏/,
  /😒/
];
<!--конец 1 части-->
<!--2 часть-->
/* ============================================================================
   Часть 2/6: Утилиты
     • Нормализация опечаток
     • Токенизация
     • Извлечение сущностей с типизацией
     • Левенштейн + безопасный fuzzy-матч
     • Sentiment (3 уровня + эмодзи + сарказм)
     • Роутинг ключевых слов в тему
     • Ко-референция местоимений
     • Разрешение "а ты?" через контекст
     • Хэш для анти-репита
   ============================================================================ */

/* ---------------------------------------------------------------------------
   Нормализация опечаток (применяется ДО всего остального)
   --------------------------------------------------------------------------- */
function ktNormalizeTypos(word){
  if(!word) return word;
  var lower = word.toLowerCase();
  if(KT_TYPO_MAP[lower]) return KT_TYPO_MAP[lower];
  /* Опечатки с окончаниями: "привте" / "превет" — только точный словарь */
  return word;
}

function ktNormalizeText(text){
  if(!text) return '';
  return String(text)
    /* эмодзи-замена не нужна, оставим как есть */
    .replace(/\s+/g, ' ')
    .trim();
}

/* ---------------------------------------------------------------------------
   Токенизация
   --------------------------------------------------------------------------- */
function ktTokenize(text){
  var raw = ktNormalizeText(text);
  if(!raw) return [];
  var tokens = raw
    .toLowerCase()
    .replace(/[^\wа-яё\s\-]/gi, ' ')
    .replace(/-/g, ' ')
    .split(/\s+/)
    .filter(function(t){ return t.length > 0; });

  /* Нормализация опечаток по одному слову */
  for(var i = 0; i < tokens.length; i++){
    var norm = ktNormalizeTypos(tokens[i]);
    if(norm !== tokens[i]) tokens[i] = norm;
  }
  return tokens;
}

/* ---------------------------------------------------------------------------
   Ключевые слова (без стоп-слов)
   --------------------------------------------------------------------------- */
function ktKeywords(tokens){
  var out = [];
  for(var i = 0; i < tokens.length; i++){
    var t = tokens[i];
    if(t.length < 4) continue;
    if(KT_STOP.has(t)) continue;
    if(KT_QUESTION_WORDS.has(t)) continue;
    if(KT_NEGATIONS.has(t)) continue;
    if(KT_INTENSIFIERS.has(t)) continue;
    out.push(t);
  }
  return out;
}

/* ---------------------------------------------------------------------------
   Расстояние Левенштейна (оптимизированная версия)
   --------------------------------------------------------------------------- */
function ktLevenshtein(a, b){
  if(a === b) return 0;
  var la = a.length, lb = b.length;
  if(la === 0) return lb;
  if(lb === 0) return la;
  if(Math.abs(la - lb) > 4) return Math.max(la, lb);

  var prev = new Array(lb + 1);
  var cur  = new Array(lb + 1);
  for(var j = 0; j <= lb; j++) prev[j] = j;

  for(var i = 1; i <= la; i++){
    cur[0] = i;
    var ca = a.charCodeAt(i - 1);
    for(var k = 1; k <= lb; k++){
      var cost = ca === b.charCodeAt(k - 1) ? 0 : 1;
      var del = cur[k - 1] + 1;
      var ins = prev[k] + 1;
      var sub = prev[k - 1] + cost;
      var min = del < ins ? del : ins;
      if(sub < min) min = sub;
      cur[k] = min;
    }
    var tmp = prev; prev = cur; cur = tmp;
  }
  return prev[lb];
}

function ktSimilarity(a, b){
  if(!a || !b) return 0;
  var m = a.length > b.length ? a.length : b.length;
  if(m === 0) return 1;
  return 1 - ktLevenshtein(a, b) / m;
}

/* ---------------------------------------------------------------------------
   БЕЗОПАСНЫЙ fuzzy-матч (ПОЧИНКА V4 mini)
   Правила:
     • Слова короче FUZZY_MIN_LEN (5) не матчатся вовсе
     • Первые FUZZY_LOCK_PREFIX букв должны совпадать
     • Для слов 6+ букв — первые FUZZY_LOCK_PREFIX_3 букв тоже должны совпадать
     • Порог зависит от длины: 5-6 букв = 1.0, 7+ = 0.90
   --------------------------------------------------------------------------- */
function ktFuzzyThresholdFor(len){
  if(len <= 6) return 1.0;
  return KT.FUZZY_THRESH[Math.min(len, 10)] || 0.90;
}

function ktFuzzyMatch(word, dict){
  if(!word) return null;
  if(word.length < KT.FUZZY_MIN_LEN) return null;
  if(dict.has(word)) return word;

  var lockN = word.length >= 6 ? KT.FUZZY_LOCK_PREFIX_3 : KT.FUZZY_LOCK_PREFIX;
  var prefix = word.substring(0, lockN);
  var threshold = ktFuzzyThresholdFor(word.length);
  var best = null, bestScore = 0;

  dict.forEach(function(w){
    if(Math.abs(w.length - word.length) > 2) return;
    if(w.substring(0, lockN) !== prefix) return;
    var sc = ktSimilarity(word, w);
    if(sc >= threshold && sc > bestScore){
      bestScore = sc;
      best = w;
    }
  });
  return best;
}

/* ---------------------------------------------------------------------------
   Классификация сущности по типу
   --------------------------------------------------------------------------- */
function ktClassifyEntity(word, hint){
  if(!word) return null;
  var entity = {
    word: String(word),
    type: KT_ENTITY_TYPES.THING,
    category: null
  };

  if(hint === 'person'){
    entity.type = KT_ENTITY_TYPES.PERSON;
    return entity;
  }
  if(hint === 'place'){
    entity.type = KT_ENTITY_TYPES.PLACE;
    return entity;
  }
  if(hint === 'emotion'){
    entity.type = KT_ENTITY_TYPES.EMOTION;
    return entity;
  }

  /* Пробуем определить тему */
  var topic = ktRouteTopic([String(word).toLowerCase()]);
  if(topic){
    entity.type = KT_ENTITY_TYPES.TOPIC;
    entity.category = topic;
    return entity;
  }

  if(hint === 'activity'){
    entity.type = KT_ENTITY_TYPES.ACTIVITY;
  }
  return entity;
}

/* ---------------------------------------------------------------------------
   Роутинг ключевых слов в тему (без fuzzy — только префиксы и точное)
   При коллизии побеждает более высокий priority.
   --------------------------------------------------------------------------- */
function ktRouteTopic(keywords){
  if(!keywords || keywords.length === 0) return null;

  var best = null, bestPriority = 0;

  for(var i = 0; i < keywords.length; i++){
    var kw = keywords[i];
    if(!kw || kw.length < 3) continue;

    for(var topic in KT_TOPIC_ROUTES){
      var route = KT_TOPIC_ROUTES[topic];
      var subs = route.subs;
      for(var j = 0; j < subs.length; j++){
        var sub = subs[j];
        /* Точное совпадение или префикс с обеих сторон */
        var match = false;
        if(kw === sub) match = true;
        else if(kw.length >= 4 && sub.length >= 4){
          /* Слово начинается на sub или sub начинается на слово */
          if(kw.indexOf(sub) === 0) match = true;
          else if(sub.indexOf(kw) === 0) match = true;
          /* Существительное с суффиксом: "музыка" vs "музык" — ок */
        }
        if(match && route.priority > bestPriority){
          bestPriority = route.priority;
          best = topic;
        }
      }
    }
  }
  return best;
}

/* ---------------------------------------------------------------------------
   Классификация уровня сентимента для одного токена
   Возвращает: +3/+2/+1 / -1/-2/-3 / 0
   --------------------------------------------------------------------------- */
function ktSentimentLevel(token){
  if(!token) return 0;

  /* Проверка по стемам-префиксам */
  function startsWithAny(stems){
    for(var i = 0; i < stems.length; i++){
      if(token.indexOf(stems[i]) === 0) return true;
    }
    return false;
  }

  if(startsWithAny(KT_POS_STRONG)) return 3;
  if(startsWithAny(KT_NEG_STRONG)) return -3;
  if(startsWithAny(KT_POS_MED))    return 2;
  if(startsWithAny(KT_NEG_MED))    return -2;
  if(startsWithAny(KT_POS_WEAK))   return 1;
  if(startsWithAny(KT_NEG_WEAK))   return -1;

  /* Fuzzy — только для длинных слов */
  if(token.length >= KT.FUZZY_MIN_LEN){
    var m;
    m = ktFuzzyMatch(token, new Set(KT_POS_STRONG));
    if(m) return 3;
    m = ktFuzzyMatch(token, new Set(KT_NEG_STRONG));
    if(m) return -3;
  }
  return 0;
}

/* ---------------------------------------------------------------------------
   Эмодзи-сентимент
   --------------------------------------------------------------------------- */
function ktEmojiSentiment(text){
  if(!text) return 0;
  var score = 0;
  var str = String(text);
  KT_EMOJI_POS.forEach(function(e){ if(str.indexOf(e) >= 0) score += 1; });
  KT_EMOJI_NEG.forEach(function(e){ if(str.indexOf(e) >= 0) score -= 1; });
  /* 💀 в KtalkAI — маркер, не негатив */
  if(str.indexOf('💀') >= 0) score += 0;
  return score;
}

/* ---------------------------------------------------------------------------
   Проверка на сарказм
   --------------------------------------------------------------------------- */
function ktIsSarcasm(text){
  if(!text) return false;
  for(var i = 0; i < KT_SARCASM_MARKERS.length; i++){
    if(KT_SARCASM_MARKERS[i].test(text)) return true;
  }
  return false;
}

/* ---------------------------------------------------------------------------
   Sentiment-агрегатор (3 уровня + эмодзи + сарказм + амплификаторы)
   Возвращает: -3..3
   --------------------------------------------------------------------------- */
function ktSentiment(tokens, text){
  if(!tokens) tokens = [];
  var score = 0;
  var negated = false;
  var intensifier = 1;

  for(var i = 0; i < tokens.length; i++){
    var t = tokens[i];

    if(KT_NEGATIONS.has(t)){ negated = true; continue; }
    if(KT_INTENSIFIERS.has(t)){ intensifier = 2; continue; }

    var lvl = ktSentimentLevel(t);
    if(lvl === 0){
      negated = false;
      intensifier = 1;
      continue;
    }

    var weight = lvl * intensifier;
    if(negated) weight = -weight;
    score += weight;

    negated = false;
    intensifier = 1;
  }

  /* Эмодзи */
  score += ktEmojiSentiment(text);

  /* Сарказм инвертирует и приглушает */
  if(ktIsSarcasm(text)) score = -Math.abs(score) * 0.5;

  /* Капс и восклицания */
  if(typeof text === 'string'){
    if(/!{2,}/.test(text)) score *= 1.5;
    if(/[А-ЯЁA-Z]{4,}/.test(text)) score *= 1.3;
  }

  /* Маппинг в -3..3 */
  if(score >= 5)  return 3;
  if(score >= 3)  return 2;
  if(score >= 1)  return 1;
  if(score <= -5) return -3;
  if(score <= -3) return -2;
  if(score <= -1) return -1;
  return 0;
}

/* ---------------------------------------------------------------------------
   Извлечение сущностей (с типизацией)
   --------------------------------------------------------------------------- */
function ktExtract(text){
  var e = {
    tokens: [],
    keywords: [],
    flags: {}
  };
  if(!text) return e;
  var raw = String(text);

  /* Имя */
  var nm = raw.match(/(?:меня\s+зовут|мо[её]\s+имя|зови\s+меня|можно\s+просто|я\s*[-—]\s*|я\s+)([А-ЯЁA-Z][а-яёa-z]{2,15})/);
  if(nm && !KT_NAME_BLACKLIST.has(nm[1]) && nm[1].length >= 3){
    e.name = nm[1];
    e.nameEntity = ktClassifyEntity(nm[1], 'person');
  }

  /* Возраст */
  var ag = raw.match(/(\d{1,2})\s*(?:лет|года|год|годиков|годика)/);
  if(ag){
    var n = parseInt(ag[1], 10);
    if(n >= 8 && n <= 99) e.age = n;
  }

  /* Город */
  var ct = raw.match(/(?:из|живу\s+в|город[е]?|родился\s+в|родилась\s+в|приехал\s+из|приехала\s+из)\s+([А-ЯЁA-Z][а-яёa-z]{3,15})/);
  if(ct && ct[1].length >= 3){
    e.city = ct[1];
    e.cityEntity = ktClassifyEntity(ct[1], 'place');
  }

  /* Профессия */
  var pr = raw.match(/(?:работаю|тружусь|подрабатываю)\s+(?:как\s+|в\s+)?([а-яё]{4,}(?:щик|ник|тель|олог|ист|ер|ор|ей|ак|ик))/);
  if(pr){
    e.profession = pr[1];
    e.professionEntity = ktClassifyEntity(pr[1], 'activity');
  }

  /* Что любит */
  var lk = raw.match(/(?:люблю|обожаю|нравится|увлекаюсь|кайфую\s+от|фанат|фанатка|тащусь\s+от)\s+([а-яё]{3,20})/);
  if(lk){
    var badL = ['тебя','тебе','себя','когда','очень','всё','всех','это','то','его','её','ее','их','нас','вас','меня','мне'];
    if(badL.indexOf(lk[1]) === -1){
      e.like = lk[1];
      e.likeEntity = ktClassifyEntity(lk[1]);
    }
  }

  /* Что не любит */
  var dl = raw.match(/(?:не\s+люблю|ненавижу|терпеть\s+не\s+могу|бесит|раздражает)\s+([а-яё]{3,20})/);
  if(dl){
    e.dislike = dl[1];
    e.dislikeEntity = ktClassifyEntity(dl[1]);
  }

  /* Хобби */
  var hb = raw.match(/(?:играю\s+в|смотрю|читаю|слушаю|занимаюсь|коллекционирую|рисую|пишу|делаю)\s+([а-яё]{3,20})/);
  if(hb){
    e.hobby = hb[1];
    e.hobbyEntity = ktClassifyEntity(hb[1], 'activity');
  }

  /* Флаги */
  e.flags.question    = /\?/.test(raw);
  e.flags.exclamation = /!/.test(raw);
  e.flags.caps        = /[А-ЯЁA-Z]{4,}/.test(raw);
  e.flags.emoji       = /[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/u.test(raw);
  e.flags.endsWithQ   = /\?\s*$/.test(raw.trim());
  e.flags.multiQ      = (raw.match(/\?/g) || []).length > 1;

  /* Токены и ключевые слова */
  e.tokens = ktTokenize(raw);
  e.keywords = ktKeywords(e.tokens);

  e.flags.isShort = e.tokens.length <= KT.SHORT_REPLY_TOKENS;
  e.flags.isLong  = e.tokens.length >= KT.LONG_REPLY_TOKENS;
  e.flags.isEmpty = e.tokens.length === 0;

  /* Время */
  e.tense = null;
  for(var i = 0; i < e.tokens.length; i++){
    if(KT_TENSE_PAST.has(e.tokens[i]))   { e.tense = 'past';   break; }
    if(KT_TENSE_FUTURE.has(e.tokens[i])) { e.tense = 'future'; break; }
  }

  /* Сарказм */
  e.flags.sarcasm = ktIsSarcasm(raw);

  /* Тип запроса: ask_back, agree_short, etc. — по маркерам */
  e.modifiers = {};
  for(var m in KT_MODIFIER_MARKERS){
    if(KT_MODIFIER_MARKERS[m].test(raw)) e.modifiers[m] = true;
  }

  /* Ссылка на предыдущую тему через местоимение */
  e.pronounRef = ktDetectPronounRef(e.tokens);

  return e;
}

/* ---------------------------------------------------------------------------
   Обнаружение местоимённой ссылки (он/она/это/там/...)
   --------------------------------------------------------------------------- */
function ktDetectPronounRef(tokens){
  if(!tokens) return null;
  for(var i = 0; i < tokens.length; i++){
    var t = tokens[i];
    if(KT_PRONOUN_MAP[t]){
      return {
        pronoun: t,
        allowedTypes: KT_PRONOUN_MAP[t]
      };
    }
  }
  return null;
}

/* ---------------------------------------------------------------------------
   Разрешение местоимённой ссылки через историю сущностей
   state.entities — массив {word, type, category}
   --------------------------------------------------------------------------- */
function ktResolveCoReference(pronounRef, state){
  if(!pronounRef || !state || !state.entities || state.entities.length === 0){
    return null;
  }
  var allowed = pronounRef.allowedTypes;
  for(var i = 0; i < state.entities.length && i < 8; i++){
    var ent = state.entities[i];
    if(!ent || !ent.type) continue;
    for(var j = 0; j < allowed.length; j++){
      if(ent.type === allowed[j]) return ent;
    }
  }
  return null;
}

/* ---------------------------------------------------------------------------
   Разрешение "а ты?", "а у тебя?", "а как ты?"
   Возвращает intent-подобный маркер, если удалось определить тему
   --------------------------------------------------------------------------- */
function ktResolveAskBack(state){
  if(!state || !state.context || state.context.length < 2) return null;
  /* context[0] — текущее сообщение, context[1] — предыдущее */
  var prev = String(state.context[1] || '').toLowerCase();
  if(!prev) return null;

  /* Извлекаем ключевые слова из предыдущего сообщения */
  var prevTokens = ktTokenize(prev);
  var prevKw = ktKeywords(prevTokens);
  if(prevKw.length === 0) return null;

  var topic = ktRouteTopic(prevKw);
  if(topic) return { intent: 'ask_back_topic', topic: topic };

  /* Если предыдущее сообщение содержало сущность — возвращаем её */
  if(state.entities && state.entities.length > 0){
    return { intent: 'ask_back_entity', entity: state.entities[0] };
  }
  return { intent: 'ask_back_generic' };
}

/* ---------------------------------------------------------------------------
   Хэш строки (для анти-репита)
   --------------------------------------------------------------------------- */
function ktHash(str){
  if(str == null) return 0;
  var h = 5381;
  var s = String(str);
  for(var i = 0; i < s.length; i++){
    h = ((h << 5) + h) ^ s.charCodeAt(i);
  }
  return h >>> 0;
}

/* ---------------------------------------------------------------------------
   Применение нормализации текста к произвольной строке (для отладки)
   --------------------------------------------------------------------------- */
function ktNormalizeAll(text){
  var tokens = ktTokenize(text);
  return tokens.join(' ');
}
<!--конец 2 части-->
<!--3 часть-->
/* ============================================================================
   Часть 3/6: Детектор интентов
     • ~55 паттернов с приоритетами
     • Обработка ask_back (а ты?), agree_short (я тоже), contrast (а я)
     • Ко-референция через pronounRef
     • Модификаторы до/после основных паттернов
     • Учёт контекста (state)
   ============================================================================ */

/* ---------------------------------------------------------------------------
   Паттерны интентов с приоритетами
   priority: чем выше, тем раньше проверяется при коллизии
   --------------------------------------------------------------------------- */
var KT_INTENT_PATTERNS = {

  /* ---- ВЫСОКИЙ ПРИОРИТЕТ: спец-запросы ---- */

  about_user: {
