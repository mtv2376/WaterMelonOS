/* ---------------------------------------------------------------------------
   Типы сущностей (для ко-референции)
   --------------------------------------------------------------------------- */
var KT_ENTITY_TYPES = {
  PERSON:   'person',
  PLACE:    'place',
  TOPIC:    'topic',
  THING:    'thing',
  ACTIVITY: 'activity',
  EMOTION:  'emotion'
};

/* Карта: местоимение → тип сущности, к которому оно может отсылать */
var KT_PRONOUN_MAP = {
  'он':    [KT_ENTITY_TYPES.PERSON, KT_ENTITY_TYPES.THING],
  'она':   [KT_ENTITY_TYPES.PERSON, KT_ENTITY_TYPES.THING],
