inta.stg:{namer,icon,background
namer:app.name:["MelonCI"],what.name=namer
icon:app.ico:["⌨️"],what.ico=icon
background:app.bg:[#0a0e14],what.ico.bg=background
}
IL.cfg={scripts:all}
Inta.cfg={pc,tablet,phone}
load.stop_parse.inta

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>MelonCI</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden;font-family:'SF Mono','Consolas','Menlo','Courier New',monospace;background:#0a0e14;color:#c8d1dc;font-size:13.5px;line-height:1.5}
  ::-webkit-scrollbar{width:8px;height:8px}
  ::-webkit-scrollbar-track{background:#0a0e14}
  ::-webkit-scrollbar-thumb{background:#1f2937;border-radius:4px}
  ::-webkit-scrollbar-thumb:hover{background:#374151}
  #term{position:fixed;inset:0;display:flex;flex-direction:column;padding:14px 16px 0;overflow:hidden}
  #out{flex:1;overflow-y:auto;overflow-x:hidden;white-space:pre-wrap;word-break:break-word;padding-bottom:14px;scroll-behavior:smooth}
  #in-row{display:flex;align-items:flex-start;gap:8px;padding:8px 0 14px;border-top:1px solid #16202a;flex-shrink:0;flex-wrap:nowrap}
  #prompt{color:#52b788;font-weight:700;white-space:pre;flex-shrink:0;line-height:1.5;padding-top:0}
  #prompt .path{color:#7cc7ff}
  #prompt .user{color:#ffd166}
  #cmd{flex:1;background:transparent;border:0;outline:0;color:#c8d1dc;font:inherit;caret-color:#52b788;padding:0;min-width:0}
  .line{padding:1px 0}
  .err{color:#ff6b6b}
  .ok{color:#52b788}
  .warn{color:#ffd166}
  .info{color:#7cc7ff}
  .dim{color:#64748b}
  .cmd-echo{color:#c8d1dc}
  .cmd-echo .u{color:#ffd166;font-weight:700}
  .cmd-echo .p{color:#7cc7ff}
  .cmd-echo .c{color:#c8d1dc}
  .dir{color:#7cc7ff;font-weight:700}
  .file{color:#c8d1dc}
  .exec{color:#52b788;font-weight:700}
  .banner{color:#ff8fa3;font-weight:700}
  .hl{background:#1e293b;padding:0 3px;border-radius:3px}
  .table{display:grid;grid-template-columns:auto auto auto auto;gap:4px 16px;margin:2px 0}
  .table .h{color:#7cc7ff;font-weight:700;border-bottom:1px solid #1e293b;padding-bottom:2px}
  .completion{color:#64748b;font-style:italic}
  @media(max-width:640px){
    html,body{font-size:12px}
    #term{padding:10px 12px 0}
    #prompt{font-size:11.5px}
  }
</style>
</head>
<body>
<div id="term">
  <div id="out"></div>
  <div id="in-row">
    <span id="prompt"></span>
    <input id="cmd" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" autofocus>
  </div>
</div>

<script>
(() => {
  "use strict";
  const $ = id => document.getElementById(id);
  const out = $('out');
  const cmd = $('cmd');
  const promptEl = $('prompt');

  /* ==========================================================
     WFS ACCESS
     ========================================================== */
  let WFS = null;
  try {
    if (window.parent && window.parent.WFS) WFS = window.parent.WFS;
    else if (window.WFS) WFS = window.WFS;
  } catch (e) {
    console.error('WFS недоступен', e);
  }

  if (!WFS) {
    out.innerHTML = '<div class="line err">✗ Не удалось подключиться к WFS.</div>' +
                    '<div class="line dim">Файловая система ядра ОС не найдена.</div>';
    return;
  }

  /* ==========================================================
     STATE
     ========================================================== */
  let cwd = '/';
  let history = [];
  let hIdx = -1;
  const HISTORY_KEY = 'wmos:melonci:history';
  try { history = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]') || []; } catch {}
  const saveHistory = () => {
    try { localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-200))); } catch {}
  };

  let username = 'user';
  try { username = WFS.getUser() || 'user'; } catch {}

  /* ==========================================================
     OUTPUT
     ========================================================== */
  function write(text, cls) {
    const div = document.createElement('div');
    div.className = 'line' + (cls ? ' ' + cls : '');
    if (cls === 'cmd-echo') div.innerHTML = text;
    else div.textContent = text;
    out.appendChild(div);
    out.scrollTop = out.scrollHeight;
  }
  function writeHTML(html, cls) {
    const div = document.createElement('div');
    div.className = 'line' + (cls ? ' ' + cls : '');
    div.innerHTML = html;
    out.appendChild(div);
    out.scrollTop = out.scrollHeight;
  }
  function esc(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  function updatePrompt() {
    promptEl.innerHTML = `<span class="user">${esc(username)}</span>@<span class="dim">wmos</span>:<span class="path">${esc(cwd)}</span>$&nbsp;`;
  }

  /* ==========================================================
     BANNER
     ========================================================== */
  writeHTML('', '');
  writeHTML('<span class="banner">  ⌨️  MelonCI v1.0</span>', '');
  writeHTML('<span class="dim">  Terminal for WatermelonOS · WFS ready</span>', '');
  writeHTML('<span class="dim">  Напиши </span><span class="ok">help</span><span class="dim"> для списка команд</span>', '');
  writeHTML('', '');

  /* ==========================================================
     COMMANDS
     ========================================================== */
  const CMDS = {
    async help() {
      writeHTML('<span class="info">Доступные команды:</span>');
      const groups = [
        ['Навигация',   'ls, cd, pwd, tree'],
        ['Файлы',       'touch, cat, head, tail, wc, echo, write'],
        ['Папки',       'mkdir, rmdir, rm'],
        ['Копирование', 'cp, mv'],
        ['Поиск',       'find, grep'],
        ['Информация',  'stat, du, df, whoami, date'],
        ['Система',     'apps, open, clear, history, exit'],
      ];
      for (const [g, c] of groups) {
        writeHTML(`  <span class="warn">${g.padEnd(12)}</span> <span class="dim">${c}</span>`);
      }
      writeHTML('');
      writeHTML('<span class="dim">Совет: используй </span><span class="info">Tab</span><span class="dim"> для автодополнения, ↑/↓ для истории</span>');
    },

    async ls(args) {
      const target = args[0] ? WFS.norm(args[0].startsWith('/') ? args[0] : cwd + '/' + args[0]) : cwd;
      const items = await WFS.ls(target);
      if (!items.length) { write('', 'dim'); return; }
      // сортировка: папки первые
      items.sort((a, b) => {
        if (a.type !== b.type) return a.type === 'dir' ? -1 : 1;
        return a.name.localeCompare(b.name);
      });
      const showAll = args.includes('-l') || args.includes('-la');
      if (showAll) {
        writeHTML('<span class="table" style="display:block"><span class="h">Тип</span> <span class="h">Размер</span> <span class="h">Изменён</span> <span class="h">Имя</span></span>');
        for (const it of items) {
          const d = new Date(it.mtime);
          const dstr = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
          const size = it.type === 'dir' ? '—' : String(it.size || 0);
          const name = it.type === 'dir'
            ? `<span class="dir">${esc(it.name)}/</span>`
            : `<span class="file">${esc(it.name)}</span>`;
          writeHTML(`  <span class="dim">${it.type === 'dir' ? 'DIR ' : 'FILE'}</span>  <span class="dim">${String(size).padStart(7)}</span>  <span class="dim">${dstr}</span>  ${name}`);
        }
      } else {
        const parts = items.map(it =>
          it.type === 'dir'
            ? `<span class="dir">${esc(it.name)}/</span>`
            : `<span class="file">${esc(it.name)}</span>`
        );
        // разбиение по колонкам
        writeHTML('  ' + parts.join('   '));
      }
    },

    async cd(args) {
      let target = args[0] || '/';
      if (target === '~') target = '/home/' + username;
      if (!target.startsWith('/')) target = WFS.norm(cwd + '/' + target);
      else target = WFS.norm(target);
      const st = await WFS.stat(target);
      if (st.type !== 'dir') throw new Error('Не папка: ' + target);
      cwd = target;
      updatePrompt();
    },

    async pwd() { write(cwd); },

    async mkdir(args) {
      if (!args.length) throw new Error('mkdir: нужен аргумент');
      for (const a of args) {
        const p = a.startsWith('/') ? WFS.norm(a) : WFS.norm(cwd + '/' + a);
        await WFS.mkdir(p);
        write('✓ создано: ' + p, 'ok');
      }
    },

    async rmdir(args) {
      if (!args.length) throw new Error('rmdir: нужен аргумент');
      const p = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      await WFS.rmdir(p);
      write('✓ удалено: ' + p, 'ok');
    },

    async touch(args) {
      if (!args.length) throw new Error('touch: нужен аргумент');
      const p = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      await WFS.touch(p);
      write('✓ файл: ' + p, 'ok');
    },

    async cat(args) {
      if (!args.length) throw new Error('cat: нужен файл');
      const p = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      const text = await WFS.readText(p);
      const lines = String(text).split('\n');
      for (const l of lines) write(l);
      if (!lines.length) write('', 'dim');
    },

    async head(args) {
      const n = parseInt(args.find(a => a.startsWith('-n'))) || 10;
      const fileArg = args.find(a => !a.startsWith('-'));
      if (!fileArg) throw new Error('head: нужен файл');
      const p = fileArg.startsWith('/') ? WFS.norm(fileArg) : WFS.norm(cwd + '/' + fileArg);
      const text = await WFS.readText(p);
      const lines = String(text).split('\n').slice(0, n);
      for (const l of lines) write(l);
    },

    async tail(args) {
      const n = parseInt(args.find(a => a.startsWith('-n'))) || 10;
      const fileArg = args.find(a => !a.startsWith('-'));
      if (!fileArg) throw new Error('tail: нужен файл');
      const p = fileArg.startsWith('/') ? WFS.norm(fileArg) : WFS.norm(cwd + '/' + fileArg);
      const text = await WFS.readText(p);
      const lines = String(text).split('\n').slice(-n);
      for (const l of lines) write(l);
    },

    async wc(args) {
      if (!args.length) throw new Error('wc: нужен файл');
      const p = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      const text = await WFS.readText(p);
      const lines = String(text).split('\n').length;
      const words = String(text).split(/\s+/).filter(Boolean).length;
      const bytes = String(text).length;
      write(`${lines} строк  ${words} слов  ${bytes} символов  ${args[0]}`);
    },

    async rm(args) {
      const recursive = args.includes('-r') || args.includes('-rf') || args.includes('-R');
      const targets = args.filter(a => !a.startsWith('-'));
      if (!targets.length) throw new Error('rm: нужен аргумент');
      for (const t of targets) {
        const p = t.startsWith('/') ? WFS.norm(t) : WFS.norm(cwd + '/' + t);
        await WFS.rm(p, recursive);
        write('✓ удалено: ' + p, 'ok');
      }
    },

    async cp(args) {
      if (args.length < 2) throw new Error('cp: нужно откуда и куда');
      const src = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      const dst = args[1].startsWith('/') ? WFS.norm(args[1]) : WFS.norm(cwd + '/' + args[1]);
      await WFS.cp(src, dst);
      write('✓ ' + src + ' → ' + dst, 'ok');
    },

    async mv(args) {
      if (args.length < 2) throw new Error('mv: нужно откуда и куда');
      const src = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      const dst = args[1].startsWith('/') ? WFS.norm(args[1]) : WFS.norm(cwd + '/' + args[1]);
      await WFS.mv(src, dst);
      write('✓ ' + src + ' → ' + dst, 'ok');
    },

    async stat(args) {
      if (!args.length) throw new Error('stat: нужен путь');
      const p = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      const st = await WFS.stat(p);
      write(`  Имя:      ${st.name}`);
      write(`  Тип:      ${st.type === 'dir' ? 'папка' : 'файл'}`);
      write(`  Размер:   ${st.size} байт`);
      write(`  Изменён:  ${new Date(st.mtime).toLocaleString('ru-RU')}`);
      write(`  Создан:   ${new Date(st.created).toLocaleString('ru-RU')}`);
    },

    async tree(args) {
      const root = args[0] ? (args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0])) : cwd;
      const all = await WFS.listAll();
      const map = new Map();
      for (const n of all) {
        const par = n.parent || '/';
        if (!map.has(par)) map.set(par, []);
        map.get(par).push(n);
      }
      function rec(path, prefix, isLast) {
        const name = WFS.basename(path);
        const node = all.find(n => n.path === path);
        const isDir = node && node.type === 'dir';
        writeHTML(prefix + (isLast ? '└── ' : '├── ') +
          (isDir ? `<span class="dir">${esc(name)}/</span>` : `<span class="file">${esc(name)}</span>`));
        if (!isDir) return;
        const kids = (map.get(path) || []).sort((a, b) => (a.type === b.type ? 0 : a.type === 'dir' ? -1 : 1));
        kids.forEach((k, i) => {
          rec(k.path, prefix + (isLast ? '    ' : '│   '), i === kids.length - 1);
        });
      }
      writeHTML(`<span class="dir">${esc(root)}/</span>`);
      const kids = (map.get(root) || []).sort((a, b) => (a.type === b.type ? 0 : a.type === 'dir' ? -1 : 1));
      kids.forEach((k, i) => rec(k.path, '', i === kids.length - 1));
    },

    async find(args) {
      const pattern = args[0];
      if (!pattern) throw new Error('find: нужен шаблон (например *.txt)');
      const results = await WFS.find(pattern, cwd);
      if (!results.length) { write('Ничего не найдено', 'dim'); return; }
      for (const p of results) {
        const st = await WFS.stat(p);
        writeHTML(st.type === 'dir' ? `<span class="dir">${esc(p)}/</span>` : `<span class="file">${esc(p)}</span>`);
      }
    },

    async grep(args) {
      if (args.length < 2) throw new Error('grep: grep <текст> <файл>');
      const needle = args[0];
      const p = args[1].startsWith('/') ? WFS.norm(args[1]) : WFS.norm(cwd + '/' + args[1]);
      const text = await WFS.readText(p);
      const lines = String(text).split('\n');
      let found = 0;
      lines.forEach((l, i) => {
        if (l.includes(needle)) {
          found++;
          const re = new RegExp(needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
          writeHTML(`<span class="dim">${String(i+1).padStart(4)}:</span> ` +
            esc(l).replace(re, `<span class="hl">${esc(needle)}</span>`));
        }
      });
      if (!found) write('Совпадений нет', 'dim');
    },

    async du(args) {
      const p = args[0] ? (args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0])) : cwd;
      const size = await WFS.du(p);
      write(`${(size/1024).toFixed(2)} КБ  ${p}`);
    },

    async df() {
      const { files, dirs, bytes, quota } = await WFS.df();
      write(`  Файлов:      ${files}`);
      write(`  Папок:       ${dirs}`);
      write(`  Занято:      ${(bytes/1024).toFixed(2)} КБ из ${(quota/1024/1024).toFixed(0)} МБ`);
      const pct = (bytes / quota * 100).toFixed(2);
      const bars = Math.round(bytes / quota * 30);
      writeHTML(`  <span class="dim">[${'█'.repeat(bars)}${'░'.repeat(30-bars)}] ${pct}%</span>`);
    },

    async whoami() { write(username); },

    async date() { write(new Date().toLocaleString('ru-RU')); },

    async echo(args) {
      // поддержка > и >>
      const raw = args.join(' ');
      const redirMatch = raw.match(/^(.*?)\s*(>>|>)\s*(\S+)\s*$/);
      if (redirMatch) {
        const [, text, op, file] = redirMatch;
        const p = file.startsWith('/') ? WFS.norm(file) : WFS.norm(cwd + '/' + file);
        if (op === '>') await WFS.write(p, text);
        else await WFS.append(p, text + '\n');
        write(`✓ записано в ${p}`, 'ok');
      } else {
        write(raw);
      }
    },

    async write(args) {
      if (args.length < 2) throw new Error('write: write <файл> <текст>');
      const p = args[0].startsWith('/') ? WFS.norm(args[0]) : WFS.norm(cwd + '/' + args[0]);
      await WFS.write(p, args.slice(1).join(' '));
      write('✓ записано: ' + p, 'ok');
    },

    async apps() {
      try {
        window.parent.postMessage({ type: 'wmos:list-apps-request' }, '*');
      } catch {}
      // Альтернативно читаем иконки на рабочем столе
      try {
        const parentDoc = window.parent.document;
        const icons = parentDoc.querySelectorAll('.wmos-icon');
        if (icons.length) {
          writeHTML('<span class="info">Приложения на рабочем столе:</span>');
          icons.forEach(ic => {
            const name = ic.querySelector('.l')?.textContent || '?';
            const icon = ic.querySelector('.e')?.textContent || '📦';
            const id = ic.dataset.app || ic.dataset.appId || ic.dataset.inta || '';
            writeHTML(`  ${icon}  <span class="exec">${esc(name)}</span> <span class="dim">(${esc(id)})</span>`);
          });
          return;
        }
      } catch {}
      write('Список приложений недоступен', 'warn');
    },

    async open(args) {
      if (!args.length) throw new Error('open: нужен ID приложения');
      const id = args[0];
      try {
        window.parent.postMessage({ type: 'wmos:open', id }, '*');
        write('→ открываю: ' + id, 'ok');
      } catch (e) {
        write('Не удалось открыть: ' + id, 'err');
      }
    },

    async clear() {
      out.innerHTML = '';
    },

    async history() {
      const recent = history.slice(-30).reverse();
      recent.forEach((h, i) => write(`  ${String(i+1).padStart(3)}  ${h}`));
    },

    async exit() {
      try {
        window.parent.postMessage({ type: 'wmos:close-app' }, '*');
      } catch {}
      write('Закрываю…', 'dim');
    }
  };

  /* ==========================================================
     EXECUTION
     ========================================================== */
  function tokenize(input) {
    const tokens = [];
    let cur = '';
    let quote = null;
    for (let i = 0; i < input.length; i++) {
      const c = input[i];
      if (quote) {
        if (c === quote) { quote = null; continue; }
        cur += c;
      } else if (c === '"' || c === "'") {
        quote = c;
      } else if (c === ' ' || c === '\t') {
        if (cur) { tokens.push(cur); cur = ''; }
      } else {
        cur += c;
      }
    }
    if (cur) tokens.push(cur);
    return tokens;
  }

  async function execute(input) {
    input = String(input).trim();
    if (!input) return;
    // эхо команды
    const echoHTML = `<span class="u">${esc(username)}</span>@<span class="dim">wmos</span>:<span class="p">${esc(cwd)}</span>$ <span class="c">${esc(input)}</span>`;
    writeHTML(echoHTML, 'cmd-echo');

    history.push(input);
    if (history.length > 200) history.shift();
    saveHistory();
    hIdx = history.length;

    const tokens = tokenize(input);
    const name = tokens[0];
    const args = tokens.slice(1);

    const fn = CMDS[name];
    if (!fn) {
      write(`Команда не найдена: ${name}`, 'err');
      write('Попробуй help', 'dim');
      return;
    }

    try {
      await fn(args);
    } catch (e) {
      write('✗ ' + (e.message || String(e)), 'err');
    }
  }

  /* ==========================================================
     INPUT
     ========================================================== */
  cmd.addEventListener('keydown', async e => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const val = cmd.value;
      cmd.value = '';
      await execute(val);
      hIdx = history.length;
    }
    else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (!history.length) return;
      hIdx = Math.max(0, hIdx - 1);
      cmd.value = history[hIdx] || '';
      setTimeout(() => cmd.setSelectionRange(cmd.value.length, cmd.value.length), 0);
    }
    else if (e.key === 'ArrowDown') {
      e.preventDefault();
      hIdx = Math.min(history.length, hIdx + 1);
      cmd.value = history[hIdx] || '';
      setTimeout(() => cmd.setSelectionRange(cmd.value.length, cmd.value.length), 0);
    }
    else if (e.key === 'Tab') {
      e.preventDefault();
      await autocomplete();
    }
    else if (e.key === 'l' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      out.innerHTML = '';
    }
    else if (e.key === 'c' && e.ctrlKey) {
      e.preventDefault();
      cmd.value = '';
      write('^C', 'dim');
    }
  });

  async function autocomplete() {
    const val = cmd.value;
    const tokens = tokenize(val);
    // если команд одна — автодополнение команды
    if (tokens.length <= 1 && !val.endsWith(' ')) {
      const partial = tokens[0] || '';
      const matches = Object.keys(CMDS).filter(c => c.startsWith(partial));
      if (matches.length === 1) {
        cmd.value = matches[0] + ' ';
      } else if (matches.length > 1) {
        writeHTML('  ' + matches.map(m => `<span class="exec">${m}</span>`).join('  '));
      }
      return;
    }
    // иначе — по путям
    const partial = tokens[tokens.length - 1] || '';
    const slashIdx = partial.lastIndexOf('/');
    const dirPart = slashIdx >= 0 ? partial.slice(0, slashIdx) : '';
    const filePart = slashIdx >= 0 ? partial.slice(slashIdx + 1) : partial;
    const searchDir = dirPart
      ? (dirPart.startsWith('/') ? WFS.norm(dirPart) : WFS.norm(cwd + '/' + dirPart))
      : cwd;
    try {
      const items = await WFS.ls(searchDir);
      const matches = items
        .filter(it => it.name.startsWith(filePart))
        .map(it => it.name + (it.type === 'dir' ? '/' : ''));
      if (matches.length === 1) {
        const prefix = val.slice(0, val.length - partial.length);
        cmd.value = prefix + (dirPart ? dirPart + '/' : '') + matches[0];
      } else if (matches.length > 1) {
        writeHTML('  ' + matches.map(m =>
          m.endsWith('/') ? `<span class="dir">${esc(m)}</span>` : `<span class="file">${esc(m)}</span>`
        ).join('  '));
      }
    } catch {}
  }

  /* ==========================================================
     INIT
     ========================================================== */
  WFS.ready.then(() => {
    cwd = '/home/' + username;
    updatePrompt();
    cmd.focus();
  }).catch(() => {
    cwd = '/';
    updatePrompt();
    cmd.focus();
  });

  // клик в любом месте фокусирует input
  document.addEventListener('click', e => {
    if (!window.getSelection().toString()) cmd.focus();
  });

  // клик по терминалу = фокус
  window.addEventListener('focus', () => cmd.focus());
})();
</script>
</body>
</html>
