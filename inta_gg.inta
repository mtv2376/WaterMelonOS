      a2:['Но Кталк старается.','И умеет учиться.','Хочешь узнать подробнее?']
    }
  };
  F.about_learning = {
    k:'учишься обучение учиться узнаёшь'.split(' '),
    e:['ты учишься','как ты учишься','ты обучаешься'],
    t:[
      ['{a}','fa,st','all'],
      ['{a}! {a2}','fa,ex','warm+'],
      ['{a}. {a2}','fa,st','all'],
      ['{a}','fa,st','warm+'],
      ['{a}. {a2}','fa,st','warm+']
    ],
    s:{
      a:['Кталк учится на лету','Каждая реплика меняет Кталка','Кталк обновляется после каждого сообщения'],
