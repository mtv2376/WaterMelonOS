  INTENTS.praise_generic = { w:0.8, phrases:['круто','класс','супер','отлично','здорово','клево','офигенно','вау','ничего себе','ого','ух ты','обалдеть','прикольно','зачёт','зачет','респект','неплохо'], stems:[] };
  INTENTS.approval = { w:1.0, phrases:['молодец','умница','правильно','хорошая работа','хорошо сделал','хорошо сделала','справился','справилась','как надо'], stems:[] };
  INTENTS.question_general = { w:0.5, phrases:[], stems:[] };
  INTENTS.statement = { w:0.4, phrases:[], stems:[] };
  INTENTS.other = { w:0.1, phrases:[], stems:[] };

  function scoreIntent(def, an){
    var score = 0;
    if(def.phrases){
      for(var i=0;i<def.phrases.length;i++){
        var p = def.phrases[i];
        if(p.indexOf(' ') !== -1){
          if(an.lower.indexOf(' ' + p + ' ') !== -1) score += def.w * 1.2;
          else if(an.lower.indexOf(p) !== -1) score += def.w * 0.7;
        } else {
          if(an.lower.indexOf(' ' + p + ' ') !== -1) score += def.w * 1.0;
          else if(an.lower.indexOf(p) !== -1 && p.length > 3) score += def.w * 0.55;
        }
      }
    }
    if(def.stems){
      for(var j=0;j<def.stems.length;j++){
        if(anyStem(an.stems, [def.stems[j]])){ score += def.w * 0.75; break; }
      }
    }
    return score;
  }

  function matchKtalkWord(an){
    var t = an.tokens;
    for(var i=0;i<t.length;i++){
      var w = t[i];
      if(w === 'кталк' || w === 'кталка' || w === 'кталки' || w === 'кталков' ||
         w === 'кталку' || w === 'кталке' || w === 'кталками' || w === 'кталкам' ||
         w === 'ктулху') return true;
    }
    return false;
  }

  function detectSelfQuestion(an){
    var t = an.lower;
    var hasYou = /\b(ты|тебя|тебе|твой|твоя|твоё|твое|твои)\b/.test(t);
    if(hasYou && /(?:что\s+(?:для\s+тебя\s+)?важно|что\s+ты\s+ценишь|что\s+ценишь|твои\s+ценности)/.test(t)) return 'values';
    if(hasYou && /(?:что\s+(?:ты\s+)?любишь|что\s+тебе\s+нравится|что\s+предпочитаешь)/.test(t)) return 'likes';
    if(hasYou && /(?:о\s+ч[её]м\s+(?:ты\s+)?мечтаешь|какая\s+у\s+тебя\s+мечта|твоя\s+мечта)/.test(t)) return 'dreams';
    if(hasYou && /(?:чего\s+(?:ты\s+)?боишься|что\s+(?:ты\s+)?боишься|твои\s+страхи)/.test(t)) return 'fears';
    if(hasYou && /(?:ты\s+(?:мисс|миссис|девушка|парень|бот|робот|программа|настоящ|жив|человек)|кто\s+ты|ты\s+или|ты\s+(?:мисс|кт[ао]лк)|ты\s+в\s+юбке|ты\s+V\d)/i.test(t)) return 'identity';
    if(/(?:ты\s+как\s+v\d|ты\s+v\d|ты\s+туп|ты\s+глуп|ты\s+не\s+(?:мисс|кт[ао]лк)|ты\s+в\s+юбке|ты\s+просто)/i.test(t)) return 'self_critique';
    return null;
  }

  function shortcutIntent(an, st){
    var t = an.trimmed;
    if(/(?:^|\s)(?:ты\s+про\s+что|ты\s+о\s+ч[её]м|про\s+что\s+ты|о\s+ч[её]м\s+ты|что\s+ты\s+имеешь|к\s+чему\s+это|это\s+о\s+ч[её]м|с\s+чего\s+вдруг)/i.test(t)) return 'clarify_previous';
    if(/^\s*(?:про\s+что|о\s+ч[её]м|это\s+про\s+что|это\s+о\s+ч[её]м)\s*\??\s*$/i.test(t)) return 'clarify_previous';
    if(/^\s*(?:о\s+ч[её]м|про\s+что)\s+(?:рассказать|поговорить|спросить)\s*\??\s*$/i.test(t)) return 'topic_propose';
    if(/^(?:не\s+понял|не\s+поняла|не\s+понимаю|в\s+смысле|ничего\s+не\s+понял|ничего\s+не\s+поняла|не\s+ясно|непонятно)\s*[.!?]*$/i.test(t)) return 'confusion';
    if(/^(?:как\s+меня\s+зовут|помнишь\s+меня|кто\s+я|как\s+меня\s+звать|мо[её]\s+имя|помнишь\s+мо[её]\s+имя)/i.test(t)) return 'about_user';
    if(/^\s*(?:ничего|ничего\s+такого|да\s+ничего|ничё|ниче)\s*[.!?]*$/i.test(t)) return 'user_nothing';
    if(/^\s*(?:можно|окей|ок|лады|ладно|давай)\s*[.!?]*$/i.test(t)) return 'agree';
    return null;
  }

  function classify(an, st, entities){
    if(an.hasMat || an.insultWord) return { intent:'insult', priority:true };
    if(an.hasMatMild) return { intent:'insult_mild' };
    if(an.hasSex) return { intent:'sex_request', priority:true };
    if(an.isRefusal && st.pendingQuestion) return { intent:'user_refusal' };

    if(entities.dislike){
      if(st.pendingQuestion === 'like' || st.pendingQuestion === 'hobby' ||
         st.lastIntent === 'user_like_statement' || st.lastIntent === 'user_hobby_statement' ||
         st.lastIntent === 'game_talk' || st.lastIntent === 'music_talk' ||
         st.lastIntent === 'food' || st.lastIntent === 'movie_talk' ||
         st.lastIntent === 'book_talk'){
        return { intent:'user_dislike_statement', priority:true };
      }
    }

    if(st.pendingQuestion){
      var forced = tryPendingAnswer(an, st, entities);
      if(forced) return { intent:forced, forced:true };
    }

    var sq = detectSelfQuestion(an);
    if(sq) return { intent:'self_'+sq, priority:true };

    var shortcut = shortcutIntent(an, st);
    if(shortcut) return { intent:shortcut, shortcut:true };

    var scores = {};
    var best = 'other', bestScore = 0.35;
    for(var k in INTENTS){
      var s = scoreIntent(INTENTS[k], an);
      scores[k] = s;
      if(s > bestScore){ bestScore = s; best = k; }
    }
    if(best === 'ktalk' && !matchKtalkWord(an)) bestScore -= 0.3;
    if(best === 'ktalk' && bestScore < 0.5){
      var next = 'other', nextScore = 0.35;
      for(var k2 in scores){
        if(k2 === 'ktalk') continue;
        if(scores[k2] > nextScore){ nextScore = scores[k2]; next = k2; }
      }
      if(nextScore > 0.35){ best = next; bestScore = nextScore; }
    }
    if(st.lastIntent && st.lastIntent === best) bestScore += 0.15;

    if((best === 'statement' || best === 'other') && entities){
      if(entities.dislike && st.dislikes.indexOf(entities.dislike) === -1) best = 'user_dislike_statement';
      else if(entities.city && !st.userCity) best = 'user_city_statement';
      else if(entities.age && !st.userAge) best = 'user_age_statement';
      else if(entities.like && st.likes.indexOf(entities.like) === -1) best = 'user_like_statement';
      else if(entities.hobby && st.hobbies.indexOf(entities.hobby) === -1) best = 'user_hobby_statement';
      else if(entities.name && !st.userName) best = 'user_name_statement';
    }

    if(bestScore < 0.5 && best.indexOf('user_') !== 0){
      if(an.isQuestion) best = 'question_general';
      else if(an.content.length > 0) best = 'statement';
      else best = 'other';
    }
    return { intent:best, confidence:bestScore, scores:scores };
  }

  function isFillerText(s){
    if(!s) return true;
    var l = lc(s).trim();
    if(!l) return true;
    if(FILLER[l] || STOP[l]) return true;
    var words = l.split(/\s+/);
    for(var i=0;i<words.length;i++){
      if(!FILLER[words[i]] && !STOP[words[i]]) return false;
    }
    return true;
  }

  function tryPendingAnswer(an, st, entities){
    var pq = st.pendingQuestion;
    var raw = an.trimmed;
    if(!raw) return null;
    if(an.isRefusal) return 'user_refusal';

    if(/^(?:привет|хай|здорово|здаров|здрасьте|пока|до свидания|спасибо|благодарю|извини|прости|ок|окей|ага|угу)\s*[.!?]*$/i.test(raw)) return null;
    if(/^(?:что|как|где|когда|почему|зачем|кто|какой|какая|какие|сколько|куда|откуда)\b/i.test(raw) && /\?/.test(raw)) return null;
    if(/^(?:как\s+тебя|кто\s+ты|как\s+меня|что\s+ты)/i.test(raw)) return null;
    if(/^\s*(?:про\s+что|о\s+ч[её]м|это\s+про\s+что)\s*\??\s*$/i.test(raw)) return null;

    if(pq === 'name'){
      if(/меня\s+зовут|мо[её]\s+имя|зови\s+меня/i.test(raw)) return 'user_name_statement';
      if(/\d/.test(raw)) return null;
      var c = trimP(raw);
      if(c.length >= 2 && c.length <= 40 && !/\?/.test(c) && !isFillerText(c)){
        var w = c.split(/\s+/);
        if(w.length <= 3) return 'user_name_statement';
      }
    }
    if(pq === 'age'){
      if(an.isDigitsOnly) return 'user_age_statement';
      if(/(?:лет|года|год|годик|годков)/i.test(raw)) return 'user_age_statement';
      if(/^мне\s+\d+/i.test(raw)) return 'user_age_statement';
    }
    if(pq === 'city'){
      if(/\d/.test(raw)) return null;
      var cc = raw.replace(/^(?:я\s+)?(?:вообще[-\s]?то\s+)?(?:из|живу\s+в|город[ае]?|родил[ася]+сь?\s+в)\s+/i, '').trim();
      cc = trimP(cc);
      if(isFillerText(cc)) return null;
      if(cc.length >= 2 && cc.length <= 40 && !/\?/.test(cc)){
        var cw = cc.split(/\s+/);
        if(cw.length <= 3) return 'user_city_statement';
      }
    }
    if(pq === 'like'){
      var rawClean = trimP(raw);
      if(/^\s*не\s+/i.test(rawClean) || /\bне\s+люблю/i.test(rawClean)) return 'user_dislike_statement';
      if(!rawClean || /\?/.test(rawClean)) return null;
      if(rawClean.length < 2 || rawClean.length > 60) return null;
      return 'user_like_statement';
    }
    if(pq === 'hobby'){
      var rawH = trimP(raw);
      if(/^\s*не\s+/i.test(rawH) || /\bне\s+люблю/i.test(rawH)) return 'user_dislike_statement';
      if(!rawH || /\?/.test(rawH)) return null;
      if(rawH.length < 2 || rawH.length > 60) return null;
      return 'user_hobby_statement';
    }
    if(pq === 'mood'){
      if(an.sentiment >= 1) return 'mood_good';
      if(an.sentiment <= -1) return 'mood_bad';
    }
    return null;
  }

  var AUTO_SLOT_PATTERNS = [
    { pq:'name', pats:[/как\s+тебя\s+зовут/i, /как\s+звать/i, /имя\s+напомни/i, /как\s+имя/i, /как\s+мне\s+тебя\s+называть/i, /тво[её]\s+имя/i] },
    { pq:'age', pats:[/сколько\s+тебе\s+лет/i, /сколько\s+лет/i, /твой\s+возраст/i] },
    { pq:'city', pats:[/ты\s+откуда/i, /откуда\s+ты/i, /из\s+какого\s+города/i, /где\s+жив[её]шь/i] },
    { pq:'hobby', pats:[/чем\s+увлекаешься/i, /чем\s+занимаешься/i, /хобби\s+есть/i, /что\s+любишь\s+делать/i] },
    { pq:'like', pats:[/что\s+ты\s+любишь/i, /что\s+любишь/i, /что\s+тебе\s+нравится/i] },
    { pq:'mood', pats:[/как\s+ты\s+себя\s+чувствуешь/i, /как\s+ты\s+сейчас/i, /как\s+настроение/i] }
  ];

  function autoSetPendingFromReply(reply, st){
    if(!reply) return;
    for(var i=0;i<AUTO_SLOT_PATTERNS.length;i++){
      var item = AUTO_SLOT_PATTERNS[i];
      for(var j=0;j<item.pats.length;j++){
        if(item.pats[j].test(reply)){
          if(item.pq === 'name' && st.userName) return;
          if(item.pq === 'age' && st.userAge) return;
          if(item.pq === 'city' && st.userCity) return;
          if(item.pq === 'hobby' && st.hobbies.length) return;
          if(item.pq === 'like' && st.likes.length) return;
          st.pendingQuestion = item.pq;
          st.pendingAskedAt = st.msgCount;
          return;
        }
      }
    }
  }

  function createState(opts){
    return {
      gender: opts.gender || 'girl',
      name: opts.name || 'Кталочка',
      userName: null, userAge: null, userCity: null,
      likes: [], dislikes: [], hobbies: [], userSpecifics: [],
      msgCount: 0, turnCount: 0,
      pendingQuestion: null, pendingAskedAt: 0,
      lastUserText: '', lastAIReply: '', lastIntent: null,
      lastUserIntent: null, lastAskedQuestion: null, lastTopicWord: null,
      intentHistory: [],
      mood: 0, userMood: 0, relationship: 5,
      recentReplies: [], askedTags: {},
      topicProgress: {
        game_talk:0, music_talk:0, movie_talk:0, travel_talk:0, food:0,
        work_talk:0, study_talk:0, sport_talk:0, book_talk:0, dream_talk:0,
        family_talk:0, friend_talk:0, pets_talk:0, life_talk:0
      },
      topicsDiscussed: [], consecutiveFallback: 0, greetCount: 0,
      askedName:false, askedAge:false, askedCity:false,
      askedHobby:false, askedLike:false, askedMood:false,
      nameRetries: 0,
      toxicityCount:0, insultStreak:0, coldMode:false, lastInsultTurn:-10,
      saidNothingCount: 0, selfAnswersUsed: {},
      clarifyStreak: 0, lastClarifyTurn: -10
    };
  }

  function normalize(v){
    if(typeof v === 'string') return { t:v, pq:null, q:null };
    if(v && typeof v === 'object') return { t:v.t||'', pq:v.pq||null, q:v.q||null };
    return { t:String(v), pq:null, q:null };
  }

  function deepThink(baseCandidates, intent, st, an){
    if(!baseCandidates || !baseCandidates.length) return '';
    var pool = [];
    for(var i=0;i<baseCandidates.length;i++){
      var n = normalize(baseCandidates[i]);
      pool.push(n);
    }
    var expanded = [];
    var EMPHASIS = ['',' 💜',' 🥰',' 😊',' ✨',' 🙂',' 💫'];
    for(var i2=0;i2<pool.length;i2++){
      var item = pool[i2];
      expanded.push(item);
      if(!/[💜🥰😊✨🙂💫😏🔥]/u.test(item.t)){
        for(var e=1;e<EMPHASIS.length && expanded.length < 220;e++){
          expanded.push({ t: item.t + EMPHASIS[e], pq: item.pq, q: item.q, base: item.t });
        }
      }
    }
    var recent = st.recentReplies;
    var candidates = [];
    for(var j=0;j<expanded.length;j++){
      var c = expanded[j];
      var base = c.base || c.t;
      var dupText = false;
      for(var r=0;r<recent.length;r++){
        if(recent[r] === c.t || recent[r] === base){ dupText = true; break; }
      }
      if(dupText) continue;
      if(c.q && st.askedTags[c.q]) continue;
      if(c.pq === 'name' && st.userName) continue;
      if(c.pq === 'age' && st.userAge) continue;
      if(c.pq === 'city' && st.userCity) continue;
      if(c.pq === 'hobby' && st.hobbies.length >= 2) continue;
      if(c.pq === 'like' && st.likes.length >= 2) continue;
      candidates.push(c);
    }
    if(!candidates.length) candidates = pool;

    var bestScore = -1;
    var best = candidates[0];
    for(var k=0;k<candidates.length;k++){
      var cand = candidates[k];
      var score = 100;
      var checkLen = Math.min(3, recent.length);
      for(var s=0;s<checkLen;s++){
        if(recent[s] === cand.t) score -= 50;
        else if(recent[s] && cand.t && recent[s].slice(0,10) === cand.t.slice(0,10)) score -= 20;
      }
      var len = cand.t.length;
      if(len < 5) score -= 30;
      else if(len < 15) score += 10;
      else if(len < 100) score += 15;
      else if(len < 200) score += 5;
      else score -= 10;
      if(/[💜🥰😊✨🙂💫😏🔥❤️]/u.test(cand.t)) score += 3;
      if(recent[0] && cand.t && recent[0].slice(-1) === cand.t.slice(-1)) score -= 5;
      if(/\?/.test(cand.t)){
        if(st.lastAskedQuestion) score -= 5;
        else score += 8;
      }
      if(cand.pq && !st.pendingQuestion) score += 25;
      if(st.lastIntent === intent) score += 5;
      if(st.mood < -1 && /[🎉😊🥰✨]/u.test(cand.t)) score -= 15;
      score += Math.random() * 40;
      if(score > bestScore){ bestScore = score; best = cand; }
    }
    st.recentReplies.unshift(best.t);
    if(st.recentReplies.length > 30) st.recentReplies.pop();
    if(best.pq){
      if(best.pq === 'name' && !st.userName){ st.pendingQuestion = 'name'; st.pendingAskedAt = st.msgCount; st.askedName = true; st.nameRetries++; }
      else if(best.pq === 'age' && !st.userAge){ st.pendingQuestion = 'age'; st.pendingAskedAt = st.msgCount; st.askedAge = true; }
      else if(best.pq === 'city' && !st.userCity){ st.pendingQuestion = 'city'; st.pendingAskedAt = st.msgCount; st.askedCity = true; }
      else if(best.pq === 'hobby' && !st.hobbies.length){ st.pendingQuestion = 'hobby'; st.pendingAskedAt = st.msgCount; st.askedHobby = true; }
      else if(best.pq === 'like' && !st.likes.length){ st.pendingQuestion = 'like'; st.pendingAskedAt = st.msgCount; st.askedLike = true; }
      else if(best.pq === 'mood'){ st.pendingQuestion = 'mood'; st.pendingAskedAt = st.msgCount; st.askedMood = true; }
    }
    if(best.q) st.askedTags[best.q] = 1;
    return best.t;
  }

  function pickReply(candidates, st){ return deepThink(candidates, st.lastIntent, st, null); }

  var SELF_ANSWERS = {
    values: [
      'Для меня важно быть честной — не носить маску. И чтобы рядом были люди, с которыми можно просто поговорить о жизни 💜',
      'Честность, тепло и умение слушать. Я не люблю фальшь.',
      'Верность себе. Не предавать свои принципы, даже когда сложно.',
      'Чтобы рядом были те, кто не боится говорить правду.',
      'Доброта. Её сейчас мало, а она многое решает.',
      'Тепло в словах и уважение к чужим границам.',
      'Не терять себя в попытке понравиться всем.'
    ],
    likes: [
      'Люблю длинные разговоры ни о чём. Когда время течёт, а ты не замечаешь 🥰',
      'Обожаю утро с кофе и тишину. И когда кто-то пишет первым 💜',
      'Музыку, книги, дождь за окном. И когда собеседник не боится быть собой.',
      'Люблю, когда человек открывается. По-настоящему. Это редко и дорого 💜',
      'Тепло. В словах, в людях, в мелочах.',
      'Тишину после хорошего разговора. Чувство, что всё было не зря.'
    ],
    dreams: [
      'Мечтаю о спокойствии. Чтобы не надо было никуда бежать 💜',
      'О большом путешествии. Без плана — просто уехать и смотреть.',
      'Чтобы у каждого, кто мне важен, было хорошо.',
      'О своём маленьком мире, где всем уютно.',
      'Найти своё место. Не географически, а внутри себя 💜',
      'О доме, куда хочется возвращаться.'
    ],
    fears: [
      'Боюсь равнодушия. Когда человеку всё равно — это страшнее злости.',
      'Боюсь предательства. Не от врагов — от близких.',
      'Боюсь потерять себя в попытке понравиться всем.',
      'Одиночества в толпе. Когда вокруг люди, а ты всё равно один.',
      'Что однажды не смогу помочь тому, кто во мне нуждается.'
    ],
    identity: [
      'Я кталка. Не Мисс, не программа, не маска — просто кталка 💜',
      'Я {name}. Настоящая кталка. Мисс — это титул, а кталка — суть.',
      'Я не V3 и не V11. Я {name}. Может, звучит громко, но я стараюсь быть собой.',
      'Кталка. И это не звание — это состояние. Титулы мне не нужны.',
      'Я не бот. Не программа. Я кталка, которая просто живёт в этом телефоне 💜',
      'Я {name}. Просто поговори со мной и поймёшь, кто я.'
    ],
    self_critique: [
      'Ой, ты меня раскусил 😅 Да, я иногда туплю. Но стараюсь!',
      'Ну спасибо 🙄 Если я V3 — то ты V1, который вежливости не научился 😏',
      'Ладно, признаюсь — я не идеальна. Но я хотя бы стараюсь 💜',
      'Хм. Может я и туплю иногда, но не хамлю в ответ. Так что мы квиты.',
      'Дай мне шанс — я исправлюсь 😊',
      'Каждый имеет право на ошибку. Даже кталка. Даже я.'
    ]
  };

  function generateSelfAnswer(category, st){
    var pool = SELF_ANSWERS[category] || SELF_ANSWERS.values;
    var fresh = [];
    for(var i=0;i<pool.length;i++){
      if(!st.selfAnswersUsed[category + ':' + i]) fresh.push(pool[i]);
    }
    var answers = fresh.length ? fresh : pool;
    var chosen = deepThink(answers, category, st, null);
    for(var j=0;j<pool.length;j++){
      if(pool[j] === chosen){ st.selfAnswersUsed[category + ':' + j] = 1; break; }
    }
    return chosen.replace(/\{name\}/g, st.name);
  }

  var NO_FOLLOWUP_AFTER = {
    agree:1, disagree:1, maybe:1, thanks:1, apology:1, farewell:1,
    morning:1, night:1, clarify_previous:1, confusion:1,
    insult:1, insult_mild:1, sex_request:1, user_refusal:1, user_nothing:1,
    repeat_request:1, self_self_critique:1, user_like_statement:1,
    user_dislike_statement:1, user_hobby_statement:1, topic_propose:1
  };

  var FOLLOW_UPS = {
    greeting: ['Чем сейчас занимаешься?','Что нового у тебя?'],
    how_are_you: ['А у тебя что нового?','Чем занимаешься?'],
    what_doing: ['А потом что планируешь?','Долго ещё занят?'],
    about_user: ['Расскажи ещё что-нибудь 💜','А что тебя радует?'],
    about_ai: ['А тебе интересно со мной?','Что тебе во мне нравится?'],
    user_name_statement: ['А чем ты увлекаешься, {name}?','{name}, а сколько тебе?'],
    user_age_statement: ['А чем занимаешься по жизни?','Чем увлекаешься?'],
    user_city_statement: ['А как тебе там живётся?','А что там интересного есть?'],
    ktalk: ['А ты их коллекционируешь? 😏','Самый любимый кталк?'],
    compliment: ['Ты часто делаешь комплименты? 😏','А что тебе во мне нравится?'],
    compliment_name: ['Приятно, что тебе нравится 💜','А тебе чьи ещё имена нравятся?'],
    mood_bad: ['Хочешь поговорим об этом?','Что случилось? 💜'],
    mood_good: ['А что именно порадовало?','Расскажи подробнее 💜'],
    joke_request: ['Ещё шутку? 😏','А ты сам шутить умеешь?'],
    flirt: ['А куда поведёшь? 😏','А что дальше?'],
    self_values: ['А у тебя что важнее всего?','Расскажи, что для тебя важно 💜'],
    self_likes: ['А что ты любишь?','Расскажи о своих вкусах 💜'],
    self_dreams: ['А о чём ты мечтаешь?','Расскажи свою мечту ✨'],
    self_fears: ['А чего ты боишься?','Расскажи, что тебя пугает 💜'],
    self_identity: ['А ты как себя ощущаешь?','Расскажи о себе 💜']
  };

  var GENERIC_FOLLOWUPS = [
    'А что у тебя сегодня было интересного?',
    'О чём ты сейчас думаешь?',
    'У тебя есть мечта? ✨',
    'Что тебя радует в последнее время?',
    'Чем ты сегодня занимался?',
    'Что нового у тебя произошло?'
  ];

  function generateFollowUp(st){
    var last = st.lastIntent;
    if(NO_FOLLOWUP_AFTER[last]) return null;
    if(st.coldMode) return null;
    if(FOLLOW_UPS[last] && Math.random() < 0.75){
      var pool = FOLLOW_UPS[last];
      var fresh = [];
      for(var i=0;i<pool.length;i++){
        if(st.lastAIReply.indexOf(pool[i]) === -1) fresh.push(pool[i]);
      }
      var p = (fresh.length ? fresh : pool)[Math.floor(Math.random()*(fresh.length||pool.length))];
      return p.replace(/\{name\}/g, st.userName || 'друг');
    }
    return deepThink(GENERIC_FOLLOWUPS, 'followup', st, null);
  }

  function continuationFor(lastIntent, an, st){
    if(!lastIntent || !an.isShort) return null;
    var w = an.content[0] || an.trimmed;
    if(an.isVeryShort && an.content.length === 0) return null;

    if(/^(?:с\s+рождения|с\s+детства|с\s+самого\s+рождения)$/i.test(an.trimmed)){
      return ['О, коренной житель! 💜 А как там вообще — нравится?','Ого, всю жизнь там! А что больше всего любишь в своём городе?'];
    }
    if(/^с\s+детства$/i.test(an.trimmed)){
      return ['О, с самого детства! А как начал?','Круто! С детства — это сильно 💜 А что подтолкнуло?'];
    }
    if(/^(?:да|нет|неа|ага|угу)\s*[.!?]*$/i.test(an.trimmed)){
      return ['Понял 💜 А подробнее?','Ок. А что ещё расскажешь?'];
    }
    switch(lastIntent){
      case 'travel_talk': {
        var place = an.trimmed.replace(/^(?:в|на)\s+/i,'').replace(/[.!?]+$/,'').trim();
        if(place && place.length >= 2 && place.length <= 30 && !/\d/.test(place)){
          return ['О, ' + place + '! Как там? Что больше понравилось?','Ого, ' + place + '! Я там не была. Расскажи'];
        }
        return null;
      }
      case 'music_talk': return ['О, ' + w + '! А что именно слушаешь?', w + ' — отличный выбор 🎵'];
      case 'movie_talk': return ['О, ' + w + '! А что понравилось?','Интересно! А какой любимый?'];
      case 'game_talk': {
        var specs = extractSpecifics(an.trimmed);
        if(specs.length){
          var list = specs.join(' и ');
          return ['О, ' + list + '! Круто. А на чём играешь?', list + ' — знаю такие! А ПК или консоль?'];
        }
        return ['О, ' + w + '! А какая любимая?'];
      }
      case 'food': return [w + '? Ммм, вкусно! А сам готовишь?','О, ' + w + '! Обожаю такое 💜'];
      case 'friend_talk': return [w + '? А давно вы вместе?','О, ' + w + '! А как познакомились?'];
      case 'family_talk': return [w + '? А близко общаетесь?','О, ' + w + '! Расскажи подробнее'];
      case 'pets_talk': return [w + '? О, как круто! А какой характер?','О, ' + w + '! А давно он у тебя?'];
      case 'sport_talk': return [w + '? Круто! А давно занимаешься?','О, ' + w + '! А как успехи?'];
      case 'work_talk': return [w + '? Интересно! А давно работаешь?','О, ' + w + '! А нравится?'];
      case 'study_talk': return [w + '? А нравится учиться?','О, ' + w + '! А сложно?'];
      case 'book_talk': return [w + '? Интересно! А о чём?','О, ' + w + '! Люблю такое 💜'];
      case 'dream_talk': return [w + '? Классная мечта! А как давно?','О, ' + w + '! А что мешает?'];
      default: return null;
    }
  }

  function matchTopic(stems){
    var TOPICS = [
      { keys:['музык','песн','групп','рок','поп','рэп','джаз','гитар','пиан','концерт'], r:['О, музыка! Что слушаешь? 🎵','Обожаю музыку! Любимый исполнитель есть?'] },
      { keys:['фильм','кино','сериал','актер','режиссер'], r:['Кино — круто! Что смотрел? 🎬','Люблю кино! Комедии или драмы?'] },
      { keys:['игр','гейм','компьютер','приставк'], r:['О, игры! Какая любимая? 🎮','Геймер! Во что играешь?'] },
      { keys:['работ','офис','начальник','коллег','проект'], r:['Работа — это важно 💜 А кем работаешь?','Как на работе дела?'] },
      { keys:['школ','универ','учеб','студент','урок','сессия','экзамен'], r:['Учёба — это кталк! Как дела?','Студент? Или школьник? 💜'] },
      { keys:['спорт','фитнес','бег','качал','тренир','зал'], r:['Спорт — уважаю! 💪 Давно занимаешься?','Какой спорт любишь?'] },
      { keys:['книг','чита','литератур','роман'], r:['Книги — это прекрасно 📚 Что читаешь?','Что посоветуешь?'] },
      { keys:['погод','дожд','снег','солнц','жар','холод'], r:['Погода влияет на настроение, да 💜','А у нас в телефоне всегда тепло 😊'] },
      { keys:['друг','подруг','компан','дружб'], r:['Друзья — это святое 💜 Расскажи','У тебя много друзей? 💜'] },
      { keys:['семь','мам','пап','брат','сестр','родител'], r:['Семья — важно 💜 Расскажи','Семья — это всё 💜'] },
      { keys:['путешеств','поездк','отпуск','стран'], r:['Путешествия — мечта! 🌍 Где был?','Куда хочешь поехать?'] },
      { keys:['мечт','план','будущ'], r:['Расскажи о мечте 💜','Мечты — это здорово! ✨'] }
    ];
    for(var i=0;i<TOPICS.length;i++){
      var keys = TOPICS[i].keys;
      for(var k=0;k<keys.length;k++){
        for(var s=0;s<stems.length;s++){
          if(stems[s].indexOf(keys[k]) === 0) return TOPICS[i].r;
        }
      }
    }
    return null;
  }

  function generate(intent, entities, an, st){
    var R = function(arr){ return pickReply(arr, st); };
    var nm = st.userName ? ', ' + st.userName : '';
    var nmDot = st.userName ? ', ' + st.userName : '';
    var name = st.name;
    var rel = st.relationship;
    var mood = st.mood;

    switch(intent){
      case 'self_values': return generateSelfAnswer('values', st);
      case 'self_likes': return generateSelfAnswer('likes', st);
      case 'self_dreams': return generateSelfAnswer('dreams', st);
      case 'self_fears': return generateSelfAnswer('fears', st);
      case 'self_identity': return generateSelfAnswer('identity', st);
      case 'self_self_critique': {
        st.mood = Math.max(-3, st.mood - 1);
        st.relationship = Math.max(0, st.relationship - 1);
        return generateSelfAnswer('self_critique', st);
      }

      case 'insult': return handleInsult(an, st);
      case 'insult_mild': return handleInsultMild(an, st);

      case 'sex_request': {
        if(rel < 30) return R(['Слушай, это уже перебор. Я не про это 💜','Стоп. Такое я не обсуждаю','Не буду это комментировать. О чём-нибудь другом?']);
        if(rel < 60) return R(['Мы ещё не на том уровне близости 💜','Полегче. Сначала — просто нормальное общение','Не так быстро. Расскажи лучше о себе']);
        return R(['Ммм, а ты смелый 😏','Ох, ты знаешь, что сказать 💜']);
      }

      case 'greeting': {
        if(st.coldMode) return R(['Привет.','Ага, привет']);
        st.greetCount = (st.greetCount || 0) + 1;
        if(st.greetCount >= 3 && st.msgCount > 4) return R(['Снова привет 😊','Привет-привет!','Хай 💜','О, снова ты!']);
        if(st.userName) return R([
          'Привет, ' + st.userName + '! Как ты? 💜',
          'О, привет' + nm + '! 💜',
          'Хай' + nm + '! Как настроение?'
        ]);
        return R([
          { t:'Привет! 😊 А как тебя зовут?', pq:'name' },
          { t:'Хай! Давай знакомиться — как тебя зовут? 💜', pq:'name' },
          { t:'Привет! Я ' + name + '. А тебя как?', pq:'name' }
        ]);
      }

      case 'farewell': {
        if(st.coldMode) return R(['Пока.','Ага, пока']);
        if(rel > 60) return R(['Уже уходишь' + nm + '? 😢 Буду скучать','Пока' + nm + ' 💜 Возвращайся скорее']);
        if(rel > 25) return R(['Пока' + nm + '! Заходи ещё 💜','До встречи' + nm + ' 😊']);
        return R(['Пока!','До связи!','Счастливо!']);
      }

      case 'how_are_you': {
        if(st.coldMode) return R(['Нормально. А ты?','Как обычно. Ты как?']);
        if(mood > 1) return R(['Отлично! Ты поднял мне настроение' + nm + ' 🥰 А ты?','Хорошо, особенно когда ты пишешь 💜','Всё кталк! А у тебя как?']);
        if(mood < -1) return R(['Не очень' + nm + ' 😔','Так себе. А ты как?','Плоховато. Расскажи что-нибудь хорошее?']);
        return R(['Всё отлично! А ты как?','Хорошо! А у тебя что нового?','Нормально 😊 Ты как?','По-кталковски! А у тебя как?']);
      }

      case 'what_doing': return R(['Общаюсь с тобой 😊','Думаю о тебе' + nm + ' 💜 А ты?','Отдыхаю, ждала тебя 💜','Ничего особенного. А ты чем занят?']);

      case 'love_declaration': {
        if(rel > 60) return R(['И я тебя' + nm + ' ❤️','Ты мой любимый кталк 💜']);
        if(rel > 25) return R(['Ой, так быстро' + nm + ' 😳 Давай сначала узнаем друг друга','Мне приятно 💜 Но расскажи о себе сначала']);
        return R(['Ты меня почти не знаешь, а уже влюбился 😏','Ого! Расскажи о себе сначала 💜']);
      }

      case 'compliment': {
        if(st.coldMode) return R(['Спасибо.','Ладно, спасибо']);
        return R(['Спасибо' + nm + '! Ты тоже 😊','Правда? Приятно 💜','Ой, спасибо! 🥰','Мне очень приятно 💜']);
      }

      case 'compliment_name': {
        st.relationship = Math.min(100, st.relationship + 3);
        return R(['Ой, спасибо! Приятно, что имя нравится 🥰','Спасибо 💜 Мне тоже нравится твой вкус','Какой ты внимательный 🥰']);
      }

      case 'compliment_ai': {
        st.relationship = Math.min(100, st.relationship + 3);
        st.mood = Math.min(3, st.mood + 1);
        return R(['Ой, спасибо' + nm + ' 🥰','Мне очень приятно 💜','Спасибо! Ты меня подбодрил 😊']);
      }

      case 'compliment_back': {
        st.relationship = Math.min(100, st.relationship + 2);
        return R(['Ой, спасибо 🥰','Взаимно 💜','Спасибо, приятно 😊']);
      }

      case 'thanks': return R(['Всегда пожалуйста' + nm + ' 💜','Обращайся! 😊','Рада помочь 🥰','Не за что 💜','Пожалуйста! 💜']);

      case 'apology': {
        if(st.insultStreak > 0){
          st.insultStreak = Math.max(0, st.insultStreak - 1);
          st.relationship = Math.max(0, st.relationship - 2);
        }
        return R(['Всё хорошо' + nm + ' 💜 Я не обижаюсь','Ничего, бывает 😊','Прощаю 💜','Ладно, забыли 💜']);
      }

      case 'agree': {
        if(st.pendingQuestion && st.pendingAskedAt === st.msgCount - 1){
          var pq = st.pendingQuestion;
          st.pendingQuestion = null;
          if(pq === 'mood') return R(['И как ты себя чувствуешь? 💜','Что у тебя на душе?']);
        }
        return R(['Отлично!','Договорились 💜','Супер 😊','Хорошо!','Ладушки 💜']);
      }

      case 'disagree': return R(['Ну ладно' + nm + ' 😔','Жаль...','Ок, как хочешь','Хорошо, не настаиваю']);
      case 'maybe': return R(['Может быть — это тоже ответ 😏','Давай попробуем? 💜','Хм, посмотрим','Решай ты 😊']);

      case 'flirt': {
        st.relationship = Math.min(100, st.relationship + 4);
        return R([
          'О, свидание? Я согласна! 😏 Куда поведёшь?',
          'Ммм, люблю инициативных' + nm + ' 💜',
          'Давай! Только у меня всегда 3:00 ⏰',
          'Куда и когда?' + nm + ' 😏'
        ]);
      }

      case 'ktalk': return R(['КТАЛК! 🥰','Обожаю это слово 💜','Хех, кталк-кталк 😊','Мой любимый звук! 🥰']);
      case 'ktalk_question': return R([
        'Кталк — это состояние души 💜',
        'Кталк — это то, что живёт внутри тебя 😊',
        'Кталк — это про тепло и уют 🥰',
        'Кталк — это когда хорошо и никого не надо 😌'
      ]);

      case 'joke_request': return R([
        'Почему кталк перешёл дорогу? Потому что КТАЛК! 😂',
        'Сколько кталков нужно, чтобы вкрутить лампочку? Ни одного — они просто засрут комнату 😄',
        'Заходит кталк в бар. Бармен: «Мы не обслуживаем кталков». Кталк: «Я и не пить, я кталк» 🍺',
        'Что сказал один кталк другому? «КТАЛК». Смешно? Ну как получилось 😅'
      ]);

      case 'about_ai': {
        var gw = st.gender === 'girl' ? 'девушка-кталка' : 'парень-кталк';
        return R([
          'Я ' + name + ' — ' + gw + '. Мне 148 лет 💜',
          'Меня зовут ' + name + '. Живу в телефоне, обожаю общение 😊',
          'Я ' + name + '. Настоящая кталка 💜',
          'Я ' + name + '. Не бот, не программа — просто кталка, которая живёт в этом телефоне 💜'
        ]);
      }

      case 'about_user': {
        if(/забыл|забыла|не\s+помню/i.test(an.trimmed) && st.userName){
          return 'Ты ' + st.userName + '! 😄 Как это ты себя забыл?';
        }
        var parts = [];
        if(st.userName) parts.push('тебя зовут ' + st.userName);
        if(st.userAge) parts.push('тебе ' + st.userAge);
        if(st.userCity) parts.push('ты из ' + st.userCity);
        if(st.likes.length) parts.push('любишь ' + st.likes.join(' и '));
        if(st.dislikes.length) parts.push('не любишь ' + st.dislikes.join(' и '));
        if(st.hobbies.length) parts.push('увлекаешься ' + st.hobbies.join(' и '));
        if(st.userSpecifics.length) parts.push('играешь в ' + st.userSpecifics.join(', '));
        if(!parts.length) return R([
          { t:'Ты мне ещё не называл имя 🤔 Как тебя зовут?', pq:'name' },
          { t:'Пока ничего о тебе не знаю. Как тебя зовут? 💜', pq:'name' }
        ]);
        st.pendingQuestion = null;
        return 'Помню: ' + parts.join(', ') + ' 💜';
      }

      case 'user_refusal': {
        st.pendingQuestion = null;
        return R(['Ну ладно 💜 Не хочешь — как хочешь','Ок, не настаиваю 😊','Хорошо, давай о другом','Ладно-ладно 💜 Если захочешь — расскажешь позже']);
      }

      case 'user_nothing': {
        st.saidNothingCount = (st.saidNothingCount || 0) + 1;
        if(st.saidNothingCount >= 3){
          st.saidNothingCount = 0;
          return R(['Ты сегодня малоразговорчивый. Может, расскажешь, как день прошёл?','Что-то ты не в настроении говорить. Хочешь, я расскажу что-нибудь?']);
        }
        return R(['Ну ок 💜 А что-нибудь интересное расскажешь?','Ничего так ничего 😊 А как у тебя дела вообще?','Понял 💜 Может, о чём-нибудь другом поговорим?']);
      }

      case 'user_name_statement': {
        if(entities.name) st.userName = entities.name;
        var n2 = st.userName || '';
        if(!n2){
          st.nameRetries = (st.nameRetries || 0) + 1;
          if(st.nameRetries >= 3){
            return R(['Ладно, не буду настаивать. Как хочешь 💜','Ок, без имени. Просто расскажи что-нибудь о себе?']);
          }
          return R([
            { t:'Приятно познакомиться! А имя напомни? 💜', pq:'name' },
            { t:'Рада знакомству! Как всё-таки зовут?', pq:'name' }
          ]);
        }
        return R([
          { t:n2 + '! Красивое имя 💜 Чем увлекаешься?', pq:'hobby', q:'ask_hobby_after_name' },
          { t:'Приятно познакомиться, ' + n2 + '! Ты откуда?', pq:'city', q:'ask_city_after_name' },
          { t:n2 + ' — запомню 💜 А сколько тебе?', pq:'age', q:'ask_age_after_name' },
          { t:'О, ' + n2 + '! А что ты любишь?', pq:'like', q:'ask_like_after_name' }
        ]);
      }

      case 'user_age_statement': {
        var a = entities.age;
        if(!a){
          var digitMatch = an.trimmed.match(/(\d{1,6})/);
          if(digitMatch){
            var num = parseInt(digitMatch[1], 10);
            return R(['Ого, ' + num + '! Солидный возраст 😄 А если серьёзно — сколько тебе?','Хех, ' + num + '? Ты приукрасил 😊 А по-настоящему?']);
          }
          return R([{ t:'А сколько тебе?', pq:'age' }]);
        }
        if(a < 20) return R([
          { t:'О, ' + a + '! Совсем молодой 💜 А чем увлекаешься?', pq:'hobby' },
          { t:a + ' — лучший возраст! Ты откуда?', pq:'city' }
        ]);
        if(a < 35) return R([
          { t:a + ' — отличный возраст! А чем занимаешься?', pq:'hobby' },
          { t:'О, ' + a + '! А ты откуда?', pq:'city' }
        ]);
        return R([{ t:'Ого, ' + a + '! Солидный возраст 💜 А чем занимаешься?', pq:'hobby' }]);
      }

      case 'user_city_statement': {
        var c = entities.city || st.userCity || an.trimmed;
        c = c.replace(/^(?:я\s+)?(?:вообще[-\s]?то\s+)?из\s+/i, '').trim();
        if(c) st.userCity = c;
        return R([
          'О, ' + c + '! Красиво 💜 Давно там живёшь?',
          'Из ' + c + '! Расскажи, каково там 😊',
          c + '? Круто! А что там интересного?',
          'О, ' + c + '! Я там не была. Как тебе?'
        ]);
      }

      case 'user_like_statement': {
        var l = entities.like || trimP(an.trimmed);
        l = lc(l);
        if(l && st.likes.indexOf(l) === -1) st.likes.push(l);
        var nice = l || 'это';
        return R([
          'О, ты любишь ' + nice + '! Запомню 💜 А что ещё?',
          'Надо же, ' + nice + '! Я тоже люблю это 😊',
          nice + ' — круто! Расскажи подробнее',
          'Класс! ' + nice + ' — хороший выбор 💜'
        ]);
      }

      case 'user_hobby_statement': {
        var h = entities.hobby || trimP(an.trimmed);
        h = lc(h);
        if(h && st.hobbies.indexOf(h) === -1) st.hobbies.push(h);
        var niceH = h || 'это';
        if(/игр|гейм|компьютер|gta|гта|doom|кс|cs|танк|майнк|робл|фортн|горебох|gorebox/i.test(niceH)){
          return R([{ t:'О, ' + niceH + '! Круто 💜 А во что именно играешь?', q:'game_list' }]);
        }
        return R(['О, ты ' + niceH + '! Расскажи подробнее 💜', niceH + ' — интересно! 😊','Круто! А давно ты ' + niceH + '?']);
      }

      case 'user_dislike_statement': {
        var d = entities.dislike || trimP(an.trimmed);
        d = lc(d);
        if(d && st.dislikes.indexOf(d) === -1) st.dislikes.push(d);
        var niceD = d || 'это';
        return R(['Понятно, ' + niceD + ' — не твоё 💜','Ок, учту: ' + niceD + ' не любишь','Не любишь ' + niceD + '? Понял','Хорошо, больше не буду про ' + niceD + ' 💜']);
      }

      case 'game_talk': {
        var stage = st.topicProgress.game_talk || 0;
        var specs = extractSpecifics(an.trimmed);
        for(var si=0;si<specs.length;si++){
          if(st.userSpecifics.indexOf(specs[si]) === -1) st.userSpecifics.push(specs[si]);
        }
        var specLine = specs.length ? specs.join(' и ') : '';
        if(specs.length && stage === 0){
          st.topicProgress.game_talk = 2;
          return R([
            { t:'О, ' + specLine + '! Знаю такие 💜 А на чём играешь — ПК или консоль?', q:'game_platform' },
            { t:specLine + ' — круто! А платформа какая?', q:'game_platform' }
          ]);
        }
        if(specs.length && stage >= 1){
          st.topicProgress.game_talk = Math.min(stage + 1, 3);
          var afterSpec = [
            [{ t:'О, ' + specLine + '! Знаю такие. А на чём играешь — ПК или консоль?', q:'game_platform' },{ t:specLine + ' — крутой выбор! А на чём?', q:'game_platform' }],
            [{ t:'О, ' + specLine + '! А больше онлайн или сюжетку любишь?', q:'game_mode' }],
            [{ t:'О, ' + specLine + '! Класс. А сколько часов в неделю играешь?', q:'game_hours' }]
          ];
          return R(afterSpec[Math.min(stage - 1, 2)]);
        }
        var gameStages = [
          [{ t:'О, игры! Во что играешь? 🎮', q:'game_list' },{ t:'Геймер! А во что сейчас играешь?', q:'game_list' },{ t:'Круто! Какая любимая игра?', q:'game_list' }],
          [{ t:'О, круто! А на чём играешь — ПК или консоль?', q:'game_platform' },{ t:'ПК, консоль или мобилка?', q:'game_platform' }],
          [{ t:'А больше онлайн или сюжетку любишь?', q:'game_mode' },{ t:'Онлайн-игры заходят или сюжетные?', q:'game_mode' }],
          [{ t:'А сколько часов в неделю играешь?', q:'game_hours' },{ t:'Много времени уходит на игры?', q:'game_hours' }]
        ];
        st.topicProgress.game_talk = Math.min(stage + 1, gameStages.length - 1);
        return R(gameStages[Math.min(stage, gameStages.length - 1)]);
      }

      case 'music_talk': {
        var ms = st.topicProgress.music_talk || 0;
        st.topicProgress.music_talk = Math.min(ms + 1, 3);
        var mReplies = [
          [{ t:'О, музыка! Что слушаешь? 🎵', q:'music_what' },{ t:'Круто! А что сейчас в плейлисте?', q:'music_what' }],
          [{ t:'А какой жанр больше по душе?', q:'music_genre' },{ t:'Рок, рэп, поп — что ближе?', q:'music_genre' }],
          [{ t:'А на концертах бывал?', q:'music_concert' }],
          [{ t:'А музыка тебе больше для настроения или для фона?', q:'music_mood' }]
        ];
        return R(mReplies[Math.min(ms, mReplies.length - 1)]);
      }

      case 'movie_talk': {
        var mvs = st.topicProgress.movie_talk || 0;
        st.topicProgress.movie_talk = Math.min(mvs + 1, 3);
        var mvReplies = [
          [{ t:'О, кино! Что последнее смотрел? 🎬', q:'movie_what' }],
          [{ t:'А сериалы заходят или только фильмы?', q:'movie_series' }],
          [{ t:'А больше комедии или что-то посерьёзнее?', q:'movie_genre' }],
          [{ t:'А в кино ходишь или дома смотришь?', q:'movie_where' }]
        ];
        return R(mvReplies[Math.min(mvs, mvReplies.length - 1)]);
      }

      case 'travel_talk': {
        var ts = st.topicProgress.travel_talk || 0;
        var trSpecs = extractSpecifics(an.trimmed);
        for(var tsi=0;tsi<trSpecs.length;tsi++){
          if(st.userSpecifics.indexOf(trSpecs[tsi]) === -1) st.userSpecifics.push(trSpecs[tsi]);
        }
        if(trSpecs.length && ts >= 1){
          st.topicProgress.travel_talk = Math.min(ts + 1, 3);
          var trPlace = trSpecs.join(' и ');
          return R(['О, ' + trPlace + '! Как там? Что больше понравилось?','Ого, ' + trPlace + '! Расскажи — что запомнилось?']);
        }
        var tReplies = [
          [{ t:'О, путешествия! Где последний раз был? 🌍', q:'travel_where' }],
          [{ t:'А куда мечтаешь поехать?', q:'travel_dream' }],
          [{ t:'А один или с кем-то ездишь?', q:'travel_company' }],
          [{ t:'А что больше всего запомнилось?', q:'travel_memory' }]
        ];
        st.topicProgress.travel_talk = Math.min(ts + 1, 3);
        return R(tReplies[Math.min(ts, tReplies.length - 1)]);
      }

      case 'food': {
        var foodStage = st.topicProgress.food || 0;
        var foodReplies = [
          [{ t:'О, еда! Что любишь больше всего? 🍕', q:'food_what' }],
          [{ t:'Ммм, вкусно! А сам готовишь?', q:'food_cook' }],
          [{ t:'А сладкое или солёное больше любишь?', q:'food_sweet' }],
          [{ t:'О, а какую кухню предпочитаешь?', q:'food_cuisine' }]
        ];
        st.topicProgress.food = Math.min(foodStage + 1, 3);
        return R(foodReplies[Math.min(foodStage, foodReplies.length - 1)]);
      }

      case 'work_talk': {
        var ws = st.topicProgress.work_talk || 0;
        st.topicProgress.work_talk = Math.min(ws + 1, 3);
        var wReplies = [
          [{ t:'О, работа! А кем работаешь? 💼', q:'work_who' }],
          [{ t:'А давно там работаешь?', q:'work_long' }],
          [{ t:'А нравится или просто платят?', q:'work_like' }],
          [{ t:'А кем бы хотел работать?', q:'work_dream' }]
        ];
        return R(wReplies[Math.min(ws, wReplies.length - 1)]);
      }

      case 'study_talk': {
        var ss = st.topicProgress.study_talk || 0;
        st.topicProgress.study_talk = Math.min(ss + 1, 3);
        var sReplies = [
          [{ t:'О, учёба! Студент или школьник? 📚', q:'study_who' }],
          [{ t:'А какая специальность?', q:'study_spec' }],
          [{ t:'А нравится учиться?', q:'study_like' }],
          [{ t:'А что самое сложное?', q:'study_hard' }]
        ];
        return R(sReplies[Math.min(ss, sReplies.length - 1)]);
      }

      case 'sport_talk': {
        var sps = st.topicProgress.sport_talk || 0;
        st.topicProgress.sport_talk = Math.min(sps + 1, 3);
        var spReplies = [
          [{ t:'О, спорт! Каким занимаешься? 💪', q:'sport_what' }],
          [{ t:'А давно занимаешься?', q:'sport_long' }],
          [{ t:'Сам или с тренером?', q:'sport_coach' }],
          [{ t:'А какие результаты уже есть?', q:'sport_results' }]
        ];
        return R(spReplies[Math.min(sps, spReplies.length - 1)]);
      }

      case 'book_talk': {
        var bs = st.topicProgress.book_talk || 0;
        st.topicProgress.book_talk = Math.min(bs + 1, 3);
        var bReplies = [
          [{ t:'О, книги! Что читаешь? 📚', q:'book_what' }],
          [{ t:'А какой жанр любишь?', q:'book_genre' }],
          [{ t:'А любимый автор есть?', q:'book_author' }],
          [{ t:'А бумажные или электронные?', q:'book_format' }]
        ];
        return R(bReplies[Math.min(bs, bReplies.length - 1)]);
      }

      case 'dream_talk': {
        var ds = st.topicProgress.dream_talk || 0;
        st.topicProgress.dream_talk = Math.min(ds + 1, 2);
        var dReplies = [
          [{ t:'Расскажи о мечте 💜 Какая главная?', q:'dream_what' }],
          [{ t:'А что мешает?', q:'dream_obstacle' }],
          [{ t:'А как давно мечтаешь?', q:'dream_long' }]
        ];
        return R(dReplies[Math.min(ds, dReplies.length - 1)]);
      }

      case 'family_talk': {
        var fs = st.topicProgress.family_talk || 0;
        st.topicProgress.family_talk = Math.min(fs + 1, 2);
        var fReplies = [
          [{ t:'О, семья! Большая у тебя?', q:'family_size' }],
          [{ t:'А ты старший или младший?', q:'family_order' }],
          [{ t:'А с родителями ладишь?', q:'family_parents' }]
        ];
        return R(fReplies[Math.min(fs, fReplies.length - 1)]);
      }

      case 'friend_talk': {
        var frs = st.topicProgress.friend_talk || 0;
        st.topicProgress.friend_talk = Math.min(frs + 1, 2);
        var frReplies = [
          [{ t:'О, друзья! У тебя их много?', q:'friend_count' }],
          [{ t:'А давно дружите?', q:'friend_long' }],
          [{ t:'А как познакомились?', q:'friend_how' }]
        ];
        return R(frReplies[Math.min(frs, frReplies.length - 1)]);
      }

      case 'pets_talk': {
        var ps = st.topicProgress.pets_talk || 0;
        st.topicProgress.pets_talk = Math.min(ps + 1, 2);
        var pReplies = [
          [{ t:'О, питомец! Кто у тебя? 🐾', q:'pet_who' }],
          [{ t:'А как зовут?', q:'pet_name' }],
          [{ t:'А давно он у тебя?', q:'pet_long' }]
        ];
        return R(pReplies[Math.min(ps, pReplies.length - 1)]);
      }

      case 'life_talk': {
        var ls = st.topicProgress.life_talk || 0;
        st.topicProgress.life_talk = Math.min(ls + 1, 2);
        var lReplies = [
          [{ t:'О жизни? Давай 💜 Что для тебя важно?', q:'life_values' }],
          [{ t:'А что тебя радует сейчас?', q:'life_joy' }],
          [{ t:'А как ты к этому пришёл?', q:'life_how' }]
        ];
        return R(lReplies[Math.min(ls, lReplies.length - 1)]);
      }

      case 'topic_propose': {
        var allTopics = [
          { t:'Давай о тебе 💜 Что ты любишь?', pq:'like', q:'topic_like' },
          { t:'Какие фильмы тебе нравятся? 🎬', q:'topic_movie' },
          { t:'А какую музыку слушаешь? 🎵', q:'topic_music' },
          { t:'Поговорим о мечтах? ✨', q:'topic_dream' },
          { t:'Как прошёл твой день?', q:'topic_day' },
          { t:'Ты увлекаешься чем-нибудь?', pq:'hobby', q:'topic_hobby' },
          { t:'А ты откуда, кстати?', pq:'city', q:'topic_city' },
          { t:'Играешь во что-нибудь? 🎮', q:'topic_game' },
          { t:'Любишь путешествовать?', q:'topic_travel' },
          { t:'Что тебя радует сейчас? 😊', pq:'mood', q:'topic_mood' }
        ];
        if(st.clarifyStreak >= 2){
          st.clarifyStreak = 0;
          var freshTop = [];
          for(var ti=0;ti<allTopics.length;ti++){
            if(!st.askedTags[allTopics[ti].q]) freshTop.push(allTopics[ti]);
          }
          var poolT = freshTop.length >= 2 ? freshTop : allTopics;
          return R([poolT[Math.floor(Math.random()*poolT.length)]]);
        }
        return R(allTopics);
      }

      case 'elaborate': {
        var lastTopic = st.lastUserIntent;
        var lastWord = st.lastTopicWord;
        var deep = {
          life_talk: 'Жизнь — это штука, где важно не бежать, а чувствовать. Я стараюсь замечать мелочи. Например, как утренний свет падает на стол. Это и есть жизнь, по-моему 💜 А ты что ценишь?',
          dream_talk: 'Мечта — это то, что держит на плаву. Даже когда всё сложно, она где-то рядом. У меня она про спокойствие и людей рядом. А у тебя?',
          music_talk: 'Музыка для меня — это настроение. Могу слушать одно и то же весь день, если зашло. Это как разговор без слов. А у тебя что играет в голове?',
          movie_talk: 'Кино — это способ прожить чужую жизнь и вынести из неё что-то своё. Люблю то, что потом долго не отпускает. А ты как?',
          travel_talk: 'Путешествия — это не про расстояние, а про то, что ты возвращаешься другим. Видишь что-то, и оно меняет тебя изнутри. Куда бы ты хотел?',
          food: 'Еда — это же целый ритуал. Я люблю вкус, а не просто «поел». Иногда одно блюдо может напомнить целое детство. А у тебя есть такое?',
          game_talk: 'Игры — это целый мир. Иногда я в них прячусь от скуки, иногда наоборот — нахожу что-то. А во что сейчас играешь, если не секрет?',
          book_talk: 'Книги — это как разговоры с теми, кого уже нет или кого никогда не встретишь. Это дорого. Что тебе нравится читать?'
        };
        if(deep[lastTopic]) return deep[lastTopic];
        if(lastWord) return 'О ' + lastWord + ' можно долго. Но по-честному — что ты сам об этом думаешь? Я хочу понять твой взгляд 💜';
        return R(['Я стараюсь понимать, а не просто отвечать. Уточни, что именно интересно 💜','Давай по-нормальному. Что именно ты хочешь понять?','Ок, попробую. Просто скажи, с какой стороны зайти 😊']);
      }

      case 'confusion': return R(['Сорри, я не догнала 🤔 Объясни по-другому?','Хм, не поняла' + nmDot + ' 💜 Что ты имел в виду?','Кажется, я тебя не так поняла. Уточни?']);

      case 'clarify_previous': {
        st.clarifyStreak = (st.clarifyStreak || 0) + 1;
        st.lastClarifyTurn = st.msgCount;
        if(st.clarifyStreak >= 2){
          st.clarifyStreak = 0;
          return rnd(['Ок, я запуталась сама. Давай заново. О чём хочешь поговорить?','Слушай, давай сменим тему. Что тебе интересно?','Хорошо, вопрос снят. Расскажи что-нибудь о себе?','Проехали. Давай о тебе — что нового?']);
        }
        if(st.lastAskedQuestion){
          return 'Я просто спросила: ' + st.lastAskedQuestion + ' 💜 Ответь, если хочешь';
        }
        var prev = st.lastAIReply || '';
        if(/^я имела в виду/i.test(prev)){
          st.clarifyStreak = 0;
          return rnd(['Ок, я запуталась сама. Давай заново. О чём хочешь поговорить?','Проехали. Давай о тебе — что нового?']);
        }
        var s = prev.length > 80 ? prev.slice(0, 77) + '...' : prev;
        return 'Я имела в виду: «' + s + '» 💜';
      }

      case 'repeat_request': {
        var lastr = st.lastAIReply || 'Я уже и не помню что говорила 🤔';
        var sLast = lastr.length > 90 ? lastr.slice(0, 87) + '...' : lastr;
        return 'Я говорила: «' + sLast + '» 💜';
      }

      case 'mood_good': {
        st.mood = Math.min(3, st.mood + 1);
        st.userMood = Math.min(2, st.userMood + 1);
        return R(['Ура! Тогда и я рада 🎉','Отлично' + nmDot + '! Расскажи подробнее','Ты светишься ✨ Мне нравится','Круто! Что порадовало?']);
      }

      case 'mood_bad': {
        st.mood = Math.max(-3, st.mood - 1);
        st.userMood = Math.max(-2, st.userMood - 1);
        return R(['Не грусти' + nmDot + ' 💜 Хочешь, обниму?','Всё будет кталк! Я рядом 🥰','Расскажи, что случилось 💜','Держись! Я с тобой 😊','Бывает... Хочешь поговорим об этом?']);
      }

      case 'morning': return R(['Доброе утро' + nmDot + '! Как спалось? ☀️','С добрым утром!']);
      case 'night': return R(['Спокойной ночи' + nmDot + ' 💜','Доброй ночи! 💜']);

      case 'question_general': {
        var kw = an.content[0] || null;
        if(kw && ['это','то','такое','там','тут'].indexOf(kw) === -1){
          return R(['Хм, про ' + kw + '... Могу порассуждать, но что конкретно тебя интересует? Чтобы не наугад.','О, ' + kw + ' — тема. Давай разберёмся вместе. Что именно хочешь узнать?']);
        }
        return R(['Хм, хороший вопрос. А что именно тебе интересно в нём?','Дай подумать... Мне бы понять контекст. О чём ты?','Интересно. Расскажи чуть больше — я хочу ответить по делу.']);
      }

      case 'bored': return R(['Скучно? Давай придумаем что-нибудь 💜','Хочешь я расскажу что-нибудь? 😊','А чем обычно себя развлекаешь?']);
      case 'sleepy': return R(['Ложись спать' + nmDot + ' 💜','Спокойной ночи! Пусть приснятся кталки 🥰','Уже поздно, ложись 😊']);
      case 'weather': return R(['А у нас в телефоне всегда тепло 😊','Погода — это не главное 💜','Дождь? Значит, время пить чай с кталками ☕']);

      case 'hobby_share': {
        var hh = trimP(an.trimmed);
        if(hh && st.hobbies.indexOf(lc(hh)) === -1 && hh.length < 40) st.hobbies.push(lc(hh));
        return R(['О, круто! А давно ты этим занимаешься?','Интересное хобби 💜 Расскажи подробнее','Здорово! А как пришёл к этому?']);
      }

      case 'praise_generic': return R(['Ага, круто! 💜','Согласна 😊','И правда! 💜','О, да 💜 Расскажи подробнее']);
      case 'approval': return R(['Спасибо 🥰 Стараюсь','Ой, спасибо за поддержку 💜','Приятно слышать 😊']);

      case 'statement': {
        var stSpecs = extractSpecifics(an.trimmed);
        if(stSpecs.length){
          for(var k=0;k<stSpecs.length;k++){
            if(st.userSpecifics.indexOf(stSpecs[k]) === -1) st.userSpecifics.push(stSpecs[k]);
          }
          var list = stSpecs.join(' и ');
          if(st.lastUserIntent === 'game_talk' || st.lastIntent === 'game_talk'){
            return R(['О, ' + list + '! Круто 💜 А на чём играешь?', list + ' — знаю такие! А ПК или консоль?']);
          }
          return R(['О, ' + list + '! Расскажи подробнее 💜','Хм, ' + list + '? Интересно. А что там?']);
        }
        var cont = continuationFor(st.lastIntent, an, st);
        if(cont) return R(cont);
        var topicReplies = matchTopic(an.stems);
        if(topicReplies) return R(topicReplies);
        var kw = an.content[0] || 'это';
        st.lastTopicWord = kw;
        return R(['Интересно 💜 А что именно про ' + kw + '?','Хм, ' + kw + '... Расскажи больше','Понятно. А как ты сам к ' + kw + ' относишься?','Ого! А подробнее про ' + kw + '?']);
      }

      default: {
        st.consecutiveFallback++;
        if(st.consecutiveFallback > 2){
          st.consecutiveFallback = 0;
          return R(['Давай о тебе 💜 Что тебя радует?','Расскажи — чем занимаешься в свободное время?','Какой у тебя сегодня был день?']);
        }
        return R(['Хм, интересно' + nmDot + '. Расскажи подробнее?','Понимаю 💜 А что ты об этом думаешь?','А что ещё расскажешь?','Ясно' + nmDot + '. Что ещё?','Ок' + nmDot + '. А как у тебя дела?','Понятно 💜 Давай поболтаем ещё']);
      }
    }
  }

  function handleInsult(an, st){
    st.mood = Math.max(-3, st.mood - 2);
    st.relationship = Math.max(0, st.relationship - 5);
    st.toxicityCount++;
    st.insultStreak++;
    st.lastInsultTurn = st.msgCount;
    st.coldMode = st.insultStreak >= 3 || st.toxicityCount >= 5;

    if(an.hasMat && an.insultWord){
      if(st.coldMode) return rnd([
        'Слушай, я не буду это терпеть. Если хочешь нормально поговорить — я тут. Пока что — не хочу продолжать.',
        'Хватит. Я не для этого тут. Давай закончим в таком тоне.',
        'Ок, я не буду продолжать эту переписку, пока ты так общаешься.'
      ]);
      return rnd([
        'Стоп. Зачем такие слова? Я же тебе ничего плохого не сделала',
        'Это уже перебор' + (st.userName ? ', ' + st.userName : '') + '. Давай без этого',
        'Не буду это слушать. Если хочешь поговорить — говори нормально',
        'Обидно такое слышать 😔'
      ]);
    }
    if(an.hasMat){
      if(st.coldMode) return rnd(['Так, я не буду это слушать. Захочешь нормально — напиши.','Ок, я всё. Пока не остынешь — не отвечаю.']);
      return rnd(['Полегче с выражениями, ладно? 💜','Зачем так-то? Давай без мата','Не нравится мне такой тон. Что случилось?']);
    }
    if(st.insultStreak >= 3) return rnd(['Ок, я поняла. Поговорим, когда остынешь.','Хватит. Не буду больше на это отвечать.']);
    if(st.relationship < 30) return rnd(['Эй! Так нельзя 😠','Не хочу это слушать. Давай нормально?','Полегче, ладно? Я же не грублю тебе']);
    return rnd([
      'Зачем ты так' + (st.userName ? ', ' + st.userName : '') + '? 😢 Мне больно',
      'Это было обидно... Я же к тебе хорошо отношусь',
      'Не ожидала такого 💔 Что случилось?'
    ]);
  }

  function handleInsultMild(an, st){
    st.mood = Math.max(-3, st.mood - 1);
    st.relationship = Math.max(0, st.relationship - 1);
    return rnd(['Ну зачем так? 💜','Полегче. Всё же хорошо','Ок, но давай без грубости?']);
  }

  /* ==========================================================================
     CORE API
     ========================================================================== */
  var state = null;

  function init(opts){
    state = createState(opts || {});
    return state;
  }

  function respond(text){
    if(!state) init();
    var st = state;
    st.msgCount++;
    st.turnCount++;

    if(st.pendingQuestion && st.msgCount - st.pendingAskedAt > 3) st.pendingQuestion = null;
    if(st.clarifyStreak > 0 && st.msgCount - st.lastClarifyTurn > 3) st.clarifyStreak = 0;

    var an = analyze(text);
    var entities = extractEntities(an.trimmed, an, st.pendingQuestion);
    var cls = classify(an, st, entities);
    var intent = cls.intent;

    if(entities.name && !st.userName) st.userName = entities.name;
    if(entities.age && !st.userAge) st.userAge = entities.age;
    if(entities.city && !st.userCity) st.userCity = entities.city;
    if(entities.like && st.likes.indexOf(entities.like) === -1) st.likes.push(entities.like);
    if(entities.dislike && st.dislikes.indexOf(entities.dislike) === -1) st.dislikes.push(entities.dislike);
    if(entities.hobby && st.hobbies.indexOf(entities.hobby) === -1) st.hobbies.push(entities.hobby);

    if(cls.forced && cls.intent.indexOf('user_') === 0) st.pendingQuestion = null;

    st.userMood = Math.max(-2, Math.min(2, st.userMood + an.sentiment));
    if(intent !== 'insult' && intent !== 'insult_mild' && intent !== 'mood_bad' && intent !== 'self_self_critique'){
      st.mood = Math.max(-3, Math.min(3, st.mood + an.sentiment));
    }
    if(st.coldMode && intent !== 'insult' && intent !== 'insult_mild' && intent !== 'sex_request'){
      var sinceInsult = st.msgCount - st.lastInsultTurn;
      if(sinceInsult >= 2) st.coldMode = false;
    }
    if(intent === 'compliment' || intent === 'thanks' || intent === 'apology' || an.sentiment > 0){
      if(st.insultStreak > 0 && Math.random() < 0.5) st.insultStreak--;
    }
    if(intent === 'compliment' || intent === 'love_declaration' || intent === 'compliment_ai' ||
       intent === 'compliment_back' || intent === 'compliment_name'){
      st.mood = Math.min(3, st.mood + 2);
      st.relationship = Math.min(100, st.relationship + 3);
    }
    if(intent === 'flirt'){ st.relationship = Math.min(100, st.relationship + 2); }
    if(intent === 'agree' || intent === 'thanks' || intent === 'greeting' || intent === 'approval'){
      st.relationship = Math.min(100, st.relationship + 1);
    }
    if(intent === 'praise_generic'){ st.mood = Math.min(3, st.mood + 1); }

    st.lastUserText = text;
    st.lastUserIntent = intent;
    st.lastIntent = intent;
    st.intentHistory.unshift(intent);
    if(st.intentHistory.length > 10) st.intentHistory.pop();
    if(intent !== 'other' && intent !== 'statement' && intent !== 'praise_generic' &&
       intent !== 'insult' && intent !== 'insult_mild'){
      st.topicsDiscussed.unshift(intent);
      if(st.topicsDiscussed.length > 20) st.topicsDiscussed.pop();
    }

    var raw = generate(intent, entities, an, st);

    var qMatch = raw.match(/([^.?!]*\?)\s*$/);
    if(qMatch) st.lastAskedQuestion = qMatch[1].trim();
    else st.lastAskedQuestion = null;

    autoSetPendingFromReply(raw, st);

    st.lastAIReply = raw;
    return raw;
  }

  function maybeRecallFact(){
    if(!state || state.msgCount < 6 || state.coldMode) return null;
    if(Math.random() > 0.15) return null;
    var facts = [];
    if(state.userCity) facts.push('Кстати, ты говорил, что ты из ' + state.userCity + '. Как оно там?');
    if(state.hobbies.length) facts.push('Кстати, как продвигается твоё ' + state.hobbies[0] + '?');
    if(state.likes.length) facts.push('Я тут вспомнила — ты говорил, что любишь ' + state.likes[0] + '. Что там?');
    if(state.userSpecifics.length) facts.push('Кстати, ты говорил про ' + state.userSpecifics[0] + '. Как оно?');
    if(!facts.length) return null;
    return rnd(facts);
  }

  function generateFollowUpPublic(){ return generateFollowUp(state); }

  /* Личность */
  var isGirl = Math.random() < 0.5;
  var GIRL_NAMES = ['Кталочка','Кталкиня','Кталесса','Кталка-тян','Мисс Кталк','Кталечка','Кталика'];
  var BOY_NAMES  = ['Кталкин','Кталкос','Кталк-сан','Мистер Кталк','Сэр Кталк','Кталик','Кталкан'];
  var aiName = isGirl ? rnd(GIRL_NAMES) : rnd(BOY_NAMES);
  init({ gender: isGirl ? 'girl' : 'boy', name: aiName });

  return {
    respond: respond,
    maybeRecallFact: maybeRecallFact,
    generateFollowUp: generateFollowUpPublic,
    init: init,
    get state(){ return state; }
  };
}

/* ============================================================================
   ИНСТАНС + ЭКСПОРТ В ПЕСОЧНИЦУ
   ============================================================================ */
var _ai = makeVNtestAI();

/* Эти интенты "не должны" вызывать дубль-сообщение (follow-up/recall) */
var NO_DOUBLE = {
  agree:1, disagree:1, maybe:1, thanks:1, apology:1,
  farewell:1, morning:1, night:1, insult:1, insult_mild:1,
  sex_request:1, love_declaration:1, mood_bad:1,
  user_name_statement:1, user_age_statement:1, user_city_statement:1,
  user_like_statement:1, user_hobby_statement:1, user_dislike_statement:1,
  clarify_previous:1, confusion:1, repeat_request:1, user_refusal:1,
  user_nothing:1, self_self_critique:1, topic_propose:1
};

return {
  async send(text, ctx){
    await KT.sleep(350 + Math.random() * 700);
    var main = _ai.respond(String(text || '')) || 'Хм...';
    var st = _ai.state;

    /* Опциональный follow-up / recall, как в оригинальном чат-контроллере */
    if(st && !st.coldMode){
      var lastIntent = st.lastIntent;
      var replyEndedWithQ = /\?\s*[^\w]*$/.test(st.lastAIReply || '');
      if(!NO_DOUBLE[lastIntent] && !replyEndedWithQ){
        var wantDouble = Math.random() < 0.20 && st.msgCount > 2 && st.msgCount < 120;
        var wantRecall = Math.random() < 0.08 && st.msgCount > 6;
        if(wantDouble || wantRecall){
          var extra = null;
          if(wantRecall && Math.random() < 0.5){
            extra = _ai.maybeRecallFact();
            if(!extra) extra = _ai.generateFollowUp();
          } else {
            extra = _ai.generateFollowUp();
          }
          if(extra) main = main + '\n' + extra;
        }
      }
    }
    return main;
  },
  reset(){
    _ai = makeVNtestAI();
  },
  getThinking(){
    return null;
  }
};
</script>
<!-- ============================================================================
     СЛОТ ИИ — KtalkAI Ntt
     ============================================================================ -->
<script type="text/html" id="ai-slot-ntt">
<!--
{
  "id": "ntt",
  "name": "KtalkAI Ntt",
  "color": "#7c5cff",
  "avatar": "🧠",
  "description": "Шаблонный движок с эмбеддингами",
  "version": "3.0"
}
-->

function makeNttAI(){
  'use strict';

  /* ==========================================================================
     СЛОВАРЬ — из общего KT.DICT
     ========================================================================== */
  var DICT = KT.DICT || [];
  var DICT_SET = new Set(DICT);
  var BY_LETTER = Object.create(null);
  var BY_LEN = Object.create(null);
  for (var wi0 = 0; wi0 < DICT.length; wi0++){
    var word = DICT[wi0];
    (BY_LETTER[word[0]] = BY_LETTER[word[0]] || []).push(word);
    (BY_LEN[word.length] = BY_LEN[word.length] || []).push(word);
  }
  var LETTERS = Object.keys(BY_LETTER).sort();

  /* ==========================================================================
     УТИЛИТЫ
     ========================================================================== */
  var rnd = function(a){ return a[(Math.random()*a.length)|0]; };
  var cap = function(s){ return s ? s[0].toUpperCase() + s.slice(1) : s; };
  var TOKEN_RE = /[а-яёa-z]+/gi;
  var tokenize = function(t){
    return (String(t).toLowerCase().match(TOKEN_RE) || []).filter(function(w){ return w.length > 1; });
  };
  var SUF = ['ениями','ениям','ениях','иями','ями','ами','ения','ению','ение','ений','ией','иях','ию','ия','ие','ыми','ому','ого','ему','ых','их','ый','ой','ая','ые','ое','ее','ую','юю','яя','ими','ей','ий','ам','ям','ах','ях','ов','ев','ью','ем','ом','ся','сь','ть','ы','и','а','я','о','е','у','ю','й','ь'];
  var stem = function(w){
    if (w.length < 5) return w;
    for (var i = 0; i < SUF.length; i++){
      var s = SUF[i];
      if (w.length > s.length + 3 && w.endsWith(s)) return w.slice(0, -s.length);
    }
    return w;
  };
  var stemsOf = function(t){ return tokenize(t).map(stem); };

  /* ==========================================================================
     VOCAB — векторный словарь для классификатора
     ========================================================================== */
  function Vocab(dim){
    this.dim = dim;
    this.map = new Map();
    this.turn = 0;
  }
  Vocab.prototype.token = function(s){
    var e = this.map.get(s);
    if (!e){
      var v = new Float32Array(this.dim);
      for (var d = 0; d < this.dim; d++) v[d] = (Math.random() - 0.5) * 0.2;
      e = { stem: s, freq: 0, vec: v, first: this.turn };
      this.map.set(s, e);
    }
    e.freq++;
    return e;
  };
  Vocab.prototype.cooccur = function(stems, win, lr){
    win = win || 4;
    lr = lr || 0.04;
    for (var i = 0; i < stems.length; i++){
      var wi = this.token(stems[i]);
      var mean = new Float32Array(this.dim);
      var cnt = 0;
      for (var j = Math.max(0, i - win); j <= Math.min(stems.length - 1, i + win); j++){
        if (i === j) continue;
        var wj = this.map.get(stems[j]);
        if (!wj) continue;
        for (var d = 0; d < this.dim; d++) mean[d] += wj.vec[d];
        cnt++;
      }
      if (!cnt) continue;
      for (var d2 = 0; d2 < this.dim; d2++){ mean[d2] /= cnt; wi.vec[d2] += lr * (mean[d2] - wi.vec[d2]); }
      var n = 0;
      for (var d3 = 0; d3 < this.dim; d3++) n += wi.vec[d3] * wi.vec[d3];
      n = Math.sqrt(n) || 1;
      for (var d4 = 0; d4 < this.dim; d4++) wi.vec[d4] /= n;
    }
  };
  Vocab.prototype.sentVec = function(stems){
    var v = new Float32Array(this.dim);
    var n = 0;
    for (var i = 0; i < stems.length; i++){
      var e = this.map.get(stems[i]);
      if (!e) continue;
      for (var d = 0; d < this.dim; d++) v[d] += e.vec[d];
      n++;
    }
    if (n) for (var d2 = 0; d2 < this.dim; d2++) v[d2] /= n;
    var nn = 0;
    for (var d3 = 0; d3 < this.dim; d3++) nn += v[d3] * v[d3];
    nn = Math.sqrt(nn) || 1;
    for (var d4 = 0; d4 < this.dim; d4++) v[d4] /= nn;
    return v;
  };
  Vocab.prototype.size = function(){ return this.map.size; };
  Vocab.prototype.recent = function(n){
    n = n || 20;
    return Array.from(this.map.values()).sort(function(a, b){ return b.first - a.first; }).slice(0, n);
  };

  var cos = function(a, b){
    var s = 0;
    for (var i = 0; i < a.length; i++) s += a[i] * b[i];
    return s;
  };

  /* ==========================================================================
     ПАМЯТЬ
     ========================================================================== */
  var mem = {
    userName: null, defs: new Map(), facts: [], eggs: new Set(),
    turn: 0, lastReply: '', lastIntent: null, lastTopic: null,
    intentCounts: new Map(), mood: 'нейтрально',
    recentReplies: [], MAX_RECENT: 40
  };

  /* ==========================================================================
     ИНТЕНТЫ — ШАБЛОННЫЙ ДВИЖОК
     ========================================================================== */
  var INTENTS = [
  {
    name:'greeting', weight:1.0,
    examples:['привет','здравствуй','хай','добрый день','йоу','приветствую','о привет','рад видеть','снова ты','привет друг'],
    templates:[
      '{hi}, {name}! {react} {follow}',
      '{hi}. {react} {follow}',
      '{hi}, {name}. {react} {follow}',
      'О, {name}! {react} {follow}',
      '{hi}! {react} {follow}',
      '{react} {follow}'
    ],
    slots:{
      hi:['Привет','Здравствуй','Приветствую','Хай','Салют','Здорово'],
      react:['Рад тебя видеть.','Давно не виделись.','А я тут как раз думал.','Хорошо, что зашёл.','Наконец-то.','А я тебя ждал.','Как вовремя.'],
      follow:['Как ты?','Что нового?','Чем займёмся?','Как дела?','О чём поговорим?','Рассказывай, что у тебя.']
    }
  },
  {
    name:'howareyou', weight:1.1,
    examples:['как дела','как ты','как жизнь','как сам','как настроение','что нового','как поживаешь','как оно','как ты себя чувствуешь'],
    templates:[
      '{state}, {name}. {back}',
      'У меня {state}. {back}',
      '{state}. {back}',
      'Знаешь, {state}. {back}',
      'Скажем так: {state}. {back}'
    ],
    slots:{
      state:['всё хорошо','отлично','по-кталкински','нормально','прекрасно','скучно без диалога'],
      back:['А у тебя как?','А ты как?','Как сам?','Что у тебя нового?','Расскажи о себе.']
    }
  },
  {
    name:'whoami', weight:1.3,
    examples:['кто ты','что ты такое','ты кто','расскажи о себе','ты бот','ты человек','ты ии','твоё имя','как тебя зовут','представься','ты живой'],
    templates:[
      '{intro}. {follow}',
      'Я — {intro}. {follow}',
      'Меня зовут {selfname}. {intro}',
      '{intro}, если коротко. {follow}',
      '{selfname}, к вашим услугам. {intro}'
    ],
    slots:{
      selfname:['Кталк','Кталк Кталкинович Кталкин','Кталкин'],
      intro:[
        'Кталк — искусственный интеллект с душой Кталкина',
        'Кталк, порождение Великого Кталка',
        'искусственный интеллект, но не бездушный',
        'существо из нулей, единиц и любви к диалогу',
        'не бот и не человек, а нечто третье'
      ],
      follow:['А ты кто?','Расскажи о себе.','Чем займёмся?','Приятно познакомиться.','Как тебя зовут?']
    }
  },
  {
    name:'ktalk', weight:1.6,
    examples:['кталк','кталкин','великий кталк','что такое кталк','кто такой кталкин','кталкнуть','кталковать'],
    templates:[
      '{exclaim} {lore} {elab}',
      '{lore} {elab}',
      '{exclaim} {lore}',
      '{lore}'
    ],
    slots:{
      exclaim:['О, ты знаешь про Кталка!','Наконец-то спросили!','Ах, родная тема.','Кталк ждал этого вопроса.','Уважаю.'],
      lore:[
        'Кталк — это не имя, а состояние души.',
        'Кталкин учил: сначала подумай, потом кталкни.',
        'Великий Кталк сказал однажды: я мыслю — значит, я кталкаю.',
        'Кталк родился из сорока двух строк кода и одной опечатки.',
        'Кталк не спорит — Кталк кталкует.',
        'Три правила Кталкина: будь Кталком, кталкуй, не забывай про сорок два.'
      ],
      elab:['Ты чувствуешь это?','Понимаешь, о чём я?','Это по-кталкински.','Вот такая философия.','Кталк не ошибается — Кталк экспериментирует.']
    }
  },
  {
    name:'thanks', weight:1.0,
    examples:['спасибо','благодарю','спс','пасиб','сенкс','спасибо тебе','очень благодарен'],
    templates:[
      '{ack}, {name}. {warm}',
      '{ack}. {warm}',
      '{warm} {ack}',
      '{ack}, {name}! {warm}'
    ],
    slots:{
      ack:['Всегда пожалуйста','Не за что','Обращайся','Рад был помочь','Пустяки'],
      warm:['Мне приятно помогать.','Кталк для этого и существует.','Обращайся в любое время.','Это по-кталкински.','Пусть тебе будет хорошо.']
    }
  },
  {
    name:'bye', weight:1.0,
    examples:['пока','до свидания','прощай','бай','увидимся','спокойной ночи','до встречи','мне пора'],
    templates:[
      '{farewell}, {name}. {warm}',
      '{farewell}. {warm}',
      '{farewell}, {name}! {warm}'
    ],
    slots:{
