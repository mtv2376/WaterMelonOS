// -------------------------------------------------------------
// SECTION 6.19 — Перестроение индекса тем
// -------------------------------------------------------------

rebuildTopicIndexes();

// -------------------------------------------------------------
// SECTION 6.20 — Счётчик тем и проверка
// -------------------------------------------------------------

const TOPIC_COUNT_TOTAL = _keys(TOPICS).length;
const TOPIC_COUNT_BY_KIND = {
  fact: 0, emotion: 0, context: 0, hybrid: 0
};
(function countKinds(){
  for (const id of _keys(TOPICS)){
    const t = TOPICS[id];
    if (t && t.kind && TOPIC_COUNT_BY_KIND[t.kind] !== undefined){
      TOPIC_COUNT_BY_KIND[t.kind] += 1;
    }
  }
})();

// -------------------------------------------------------------
// SECTION 6.21 — Таблица tone для каждой темы (для DeepThink)
// -------------------------------------------------------------

const TOPIC_TONE_MAP = {};
(function buildToneMap(){
  for (const id of _keys(TOPICS)){
    const t = TOPICS[id];
    if (t) TOPIC_TONE_MAP[id] = t.tone || null;
  }
})();

// -------------------------------------------------------------
// SECTION 6.22 — Финальная метка части 6
// -------------------------------------------------------------

const __IKW_PART6_LOADED = true;
// =============================================================
// PART 7 — DeepThink: 6 слоёв анализа
// DeepThink составляет план {primaryTopic, secondaryTopics, tone,
//   forbiddenTopics, intent, ...}. НЕ генерирует ответ.
// =============================================================

// -------------------------------------------------------------
// SECTION 7.1 — Контейнеры состояния движка
// -------------------------------------------------------------

function createState(){
  return {
    // Память о пользователе
    facts: {
      name: null,
      nameGender: null,
      age: null,
      city: null,
      job: null,
      hobby: null,
      likes: {},
      dislikes: {},
      family: {},
      pendingConfirm: null
    },
    // История сообщений
    history: [],
    // Relationship (0..100)
    relationship: LIMITS.REL_START,
    // Mood (0..100)
    mood: LIMITS.MOOD_START,
    // Cold mode counter
    rlmStreak: 0,
    coldMode: false,
    // Anti-echo / anti-repeat
    selfAnswers: [],
    userPhrases: [],
    // Context-tags: тема -> ходов до истечения
    contextTags: {},
    // Последняя активная тема
    lastTopic: null,
    lastIntents: [],
    // Счётчики
    turnCount: 0,
    // Флаг "пришли от ИИ"
    lastFromAI: false,
    // Противоречия (для честности)
    contradictions: [],
    // Мусор, который не записываем от ИИ
    rejectedFromAI: []
  };
}

// -------------------------------------------------------------
// SECTION 7.2 — Разрешение местоимений в контексте
// (короткая версия; AI_PRONOUNS уже есть)
// -------------------------------------------------------------

function resolvePronounsInTokens(analysis){
  if (!analysis) return analysis;
  const tokens = analysis.tokens;
  const resolved = [];
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord){
      resolved.push(t);
      continue;
    }
    const info = {
      token: t,
      referent: null
    };
    if (isAIPronoun(t.lower)) info.referent = "ai";
    else if (isSelfPronoun(t.lower)) info.referent = "self";
    else if (isWePronoun(t.lower)) info.referent = "we";
    else if (isYouFormal(t.lower)) info.referent = "you_formal";
    resolved.push(info);
  }
  analysis.resolved = resolved;
  return analysis;
}

// -------------------------------------------------------------
// SECTION 7.3 — Слой 1: Токенизация и стемминг
// -------------------------------------------------------------

function dtLayer1(text){
  const tokens = tokenizeRu(text);
  const analysis = analyzeTokens(tokens);
  resolvePronounsInTokens(analysis);
  return {
    layer: 1,
    name: "tokenize_and_stem",
    tokens: tokens,
    analysis: analysis,
    counts: analysis.counts,
    questions: analysis.questions.length,
    yesCount: analysis.yesTokens.length,
    noCount: analysis.noTokens.length
  };
}

// -------------------------------------------------------------
// SECTION 7.4 — Слой 2: Классификация RLP/RLM/LFW/RLN/AW
// -------------------------------------------------------------

function dtLayer2(layer1){
  const a = layer1.analysis;
  const rlp = rlpScore(a);
  const rlm = rlmScore(a);
  const lfw = lfwScore(a);

  const insultToAI = detectInsultToAI(a);
  const complimentToAI = detectComplimentToAI(a);
  const loveToAI = detectLoveToAI(a);
  const hateToAI = detectHateToAI(a);

  let dominant = CATEGORY.AW;
  if (rlm > 0 && rlm >= rlp && rlm >= lfw) dominant = CATEGORY.RLM;
  else if (rlp > 0 && rlp >= lfw) dominant = CATEGORY.RLP;
  else if (lfw > 0) dominant = CATEGORY.LFW;
  else if (a.counts.RLN > 0) dominant = CATEGORY.RLN;

  return {
    layer: 2,
    name: "classification",
    dominant: dominant,
    scores: {
      RLP: rlp,
      RLM: rlm,
      LFW: lfw,
      RLN: a.counts.RLN,
      AW: a.counts.AW
    },
    flags: {
      insultToAI: insultToAI,
      complimentToAI: complimentToAI,
      loveToAI: loveToAI,
      hateToAI: hateToAI,
      isQuestion: isQuestionText(null, layer1.tokens, a),
      yesNo: detectYesNo(a),
      exclamations: countExclamations(null),
      allCaps: false
    },
    categories: a.byCategory
  };
}

// -------------------------------------------------------------
// SECTION 7.5 — Слой 3: Поиск активных тем текущего сообщения
// -------------------------------------------------------------

function dtLayer3(layer1, layer2){
  const a = layer1.analysis;
  const hits = collectActiveTopics(a);

  // Разделяем на emotion / fact / context / hybrid
  const emotion = [];
  const fact = [];
  const context = [];
  const hybrid = [];
  for (let i = 0; i < hits.length; i++){
    const h = hits[i];
    if (h.kind === TOPIC_KIND.EMOTION) emotion.push(h);
    else if (h.kind === TOPIC_KIND.FACT) fact.push(h);
    else if (h.kind === TOPIC_KIND.CONTEXT) context.push(h);
    else hybrid.push(h);
  }

  // Спец-детекция compliment_ai / love_ai
  let specialIntent = null;
  if (layer2.flags.loveToAI) specialIntent = "love_to_ai";
  else if (layer2.flags.hateToAI) specialIntent = "hate_to_ai";
  else if (layer2.flags.complimentToAI) specialIntent = "compliment_ai";
  else if (layer2.flags.insultToAI) specialIntent = "insult_to_ai";

  return {
    layer: 3,
    name: "topic_search",
    all: hits,
    emotion: emotion,
    fact: fact,
    context: context,
    hybrid: hybrid,
    specialIntent: specialIntent
  };
}

// -------------------------------------------------------------
// SECTION 7.6 — Слой 4: Контекст из истории (10 сообщений)
// + context-tags (5 ходов)
// -------------------------------------------------------------

function dtLayer4(state, ctx){
  const hist = ctx && _isArr(ctx.history) ? ctx.history : state.history;
  const recent = hist.slice(-LIMITS.CTX_HISTORY_WINDOW);

  // Проанализируем недавние темы
  const recentTopics = {};
  let recentUserSentiment = 0;
  for (let i = 0; i < recent.length; i++){
    const msg = recent[i];
    if (!msg || !_isStr(msg.text)) continue;
    const ana = analyzeText(msg.text);
    const hits = collectActiveTopics(ana);
    for (let j = 0; j < hits.length; j++){
      const h = hits[j];
      if (!recentTopics[h.topicId]) recentTopics[h.topicId] = 0;
      recentTopics[h.topicId] += h.weight;
    }
    const rlp = rlpScore(ana);
    const rlm = rlmScore(ana);
    const w = (msg.role === "user") ? 1 : 0.5;
    recentUserSentiment += (rlp - rlm) * w;
  }

  // Context-tags с активным TTL
  const activeContextTags = {};
  for (const tid of _keys(state.contextTags)){
    const turns = state.contextTags[tid];
    if (turns > 0){
      activeContextTags[tid] = turns;
    }
  }

  // Противоречия: если facts.lastCity меняется — пометим
  const lastBotText = (function(){
    for (let i = state.history.length - 1; i >= 0; i--){
      if (state.history[i].role === "bot") return state.history[i].text;
    }
    return "";
  })();

  return {
    layer: 4,
    name: "history_context",
    recentMessages: recent.length,
    recentTopics: recentTopics,
    recentUserSentiment: recentUserSentiment,
    activeContextTags: activeContextTags,
    lastBotText: lastBotText
  };
}

// -------------------------------------------------------------
// SECTION 7.7 — Слой 5: Состояние пользователя
// (facts + relationship + mood + coldMode)
// -------------------------------------------------------------

function dtLayer5(state){
  const rel = state.relationship;
  const mood = state.mood;
  const cold = state.coldMode;

  let relTone = TONE.NEUTRAL;
  if (rel >= 70) relTone = TONE.WARM;
  else if (rel >= 40) relTone = TONE.NEUTRAL;
  else if (rel >= 20) relTone = TONE.COOL;
  else relTone = TONE.COLD;

  let moodTone = TONE.NEUTRAL;
  if (mood >= 70) moodTone = TONE.HAPPY;
  else if (mood >= 40) moodTone = TONE.NEUTRAL;
  else if (mood >= 20) moodTone = TONE.SAD;
  else moodTone = TONE.SAD;

  return {
    layer: 5,
    name: "user_state",
    facts: _deepClone(state.facts),
    relationship: rel,
    relationshipTone: relTone,
    mood: mood,
    moodTone: moodTone,
    coldMode: cold,
    rlmStreak: state.rlmStreak,
    turnCount: state.turnCount,
    lastFromAI: state.lastFromAI
  };
}

// -------------------------------------------------------------
// SECTION 7.8 — Слой 6: Разрешение конфликтов → план
// -------------------------------------------------------------

function dtLayer6(l1, l2, l3, l4, l5, state, ctx){
  // --- Шаг 1. Спец-интенты имеют максимальный приоритет ---
  let intent = null;
  if (l3.specialIntent){
    intent = l3.specialIntent;
  }

  // --- Шаг 2. Определение forbiddenTopics ---
  const forbidden = {};
  if (l2.dominant === CATEGORY.RLM){
    // Не отвечать тем же
    forbidden.mat = 1;
    forbidden.insult = 1;
  }
  if (l5.coldMode){
    forbidden.love = 1;
    forbidden.sex = 1;
    forbidden.flirt = 1;
    forbidden.kiss = 1;
    forbidden.hug = 1;
  }
  if (l4.activeContextTags.death){
    forbidden.happy = 1;
    forbidden.party = 1;
    forbidden.wedding = 1;
    forbidden.newyear = 1;
  }
  if (intent === "insult_to_ai"){
    forbidden.insult = 1;
  }

  // --- Шаг 3. Выбор primaryTopic ---
  let primaryTopic = null;

  // Context-темы приоритетнее для модификации
  if (l3.context.length > 0){
    // Context не генерирует сам, но даёт знать о себе
    // (кладём в план отдельно)
  }

  // Emotion — задаёт тон
  let emotionTopic = null;
  if (l3.emotion.length > 0) emotionTopic = l3.emotion[0];
  else if (l3.hybrid.length > 0) emotionTopic = l3.hybrid[0];

  // Fact — задаёт объект
  let factTopic = null;
  if (l3.fact.length > 0) factTopic = l3.fact[0];

  // Hybrid может играть роль fact или emotion
  if (!factTopic && l3.hybrid.length > 0){
    factTopic = l3.hybrid[0];
  }

  // Если ничего не нашли — берём recentTopics из истории
  if (!emotionTopic && !factTopic && !intent){
    const recKeys = _keys(l4.recentTopics);
    if (recKeys.length > 0){
      // Не переключать тему резко
      let bestId = null; let bestW = 0;
      for (let i = 0; i < recKeys.length; i++){
        if (l4.recentTopics[recKeys[i]] > bestW){
          bestW = l4.recentTopics[recKeys[i]];
          bestId = recKeys[i];
        }
      }
      if (bestId && TOPIC_INDEX.byId[bestId]){
        factTopic = { topicId: bestId, topic: TOPIC_INDEX.byId[bestId], weight: bestW, priority: TOPIC_INDEX.byId[bestId].priority };
      }
    }
  }

  // --- Шаг 4. Мульти-тема: склейка ---
  const secondaryTopics = [];
  if (emotionTopic && factTopic && emotionTopic.topicId !== factTopic.topicId){
    secondaryTopics.push(emotionTopic);
    secondaryTopics.push(factTopic);
  } else if (emotionTopic){
    primaryTopic = emotionTopic;
  } else if (factTopic){
    primaryTopic = factTopic;
  }

  // Если обе есть — primary = fact (объект), secondary = emotion (тон)
  // Но если факта нет, primary = emotion
  if (emotionTopic && factTopic){
    primaryTopic = factTopic;
  }

  // Если ничего нет, но есть specialIntent
  if (!primaryTopic && intent === "compliment_ai"){
    primaryTopic = { topicId: "love", topic: TOPICS.love, weight: 5, priority: 8 };
  }
  if (!primaryTopic && intent === "insult_to_ai"){
    primaryTopic = { topicId: "mat", topic: TOPICS.mat, weight: 3, priority: 7 };
  }

  // --- Шаг 5. Определение tone ---
  let tone = TONE.NEUTRAL;

  // Тон от контекста (умерший, горе)
  if (l4.activeContextTags.death) tone = TONE.SAD;
  else if (l4.activeContextTags.wedding || l4.activeContextTags.birthday ||
           l4.activeContextTags.newyear) tone = TONE.HAPPY;
  else if (emotionTopic && emotionTopic.topic && emotionTopic.topic.tone){
    tone = emotionTopic.topic.tone;
  } else if (primaryTopic && primaryTopic.topic && primaryTopic.topic.tone){
    tone = primaryTopic.topic.tone;
  }

  // Тон от состояния пользователя
  if (l5.coldMode && tone === TONE.ROMANTIC) tone = TONE.NEUTRAL;
  if (l5.relationship < 20 && tone === TONE.WARM) tone = TONE.NEUTRAL;

  // Если нас оскорбили — не играем в тепло
  if (intent === "insult_to_ai"){
    tone = TONE.COOL;
  }

  // --- Шаг 6. Определение флагов ответа ---
  const flags = {
    askFollowUp: true,
    askQuestion: l2.flags.isQuestion || (l2.flags.yesNo === "none"),
    beBrief: l5.coldMode,
    offerSupport: tone === TONE.SAD || (emotionTopic && emotionTopic.topicId === "lonely") || l4.activeContextTags.death,
    acknowledgeAI: l5.lastFromAI,
    doNotRecordFacts: l5.lastFromAI,
    deEscalate: l2.dominant === CATEGORY.RLM || intent === "insult_to_ai",
    noEcho: true,
    noPromise: true,
    consentGuard: primaryTopic && primaryTopic.topicId === "sex"
  };

  // --- Шаг 7. Возможные follow-ups ---
  const followCandidates = [];
  if (primaryTopic && primaryTopic.topic && primaryTopic.topic.followUps){
    for (const k of _keys(primaryTopic.topic.followUps)){
      followCandidates.push(k);
    }
  }
  if (secondaryTopics.length > 0){
    for (let i = 0; i < secondaryTopics.length; i++){
      const s = secondaryTopics[i];
      if (s.topic && s.topic.followUps){
        for (const k of _keys(s.topic.followUps)){
          followCandidates.push(k);
        }
      }
    }
  }

  // --- Шаг 8. Учёт specialIntent ---
  const plan = {
    intent: intent,
    primaryTopic: primaryTopic ? primaryTopic.topicId : null,
    primaryTopicObj: primaryTopic ? primaryTopic.topic : null,
    secondaryTopics: secondaryTopics.map(s => s.topicId),
    secondaryTopicObjs: secondaryTopics.map(s => s.topic),
    contextTopics: l3.context.map(s => s.topicId),
    hybridTopics: l3.hybrid.map(s => s.topicId),
    emotionTopicId: emotionTopic ? emotionTopic.topicId : null,
    factTopicId: factTopic ? factTopic.topicId : null,
    tone: tone,
    forbiddenTopics: forbidden,
    relationshipTone: l5.relationshipTone,
    moodTone: l5.moodTone,
    coldMode: l5.coldMode,
    dominant: l2.dominant,
    scores: l2.scores,
    flags: flags,
    followCandidates: followCandidates,
    yesNo: l2.flags.yesNo,
    isQuestion: l2.flags.isQuestion,
    fromAI: l5.lastFromAI,
    turnsSince: l5.turnCount
  };

  return {
    layer: 6,
    name: "conflict_resolution",
    plan: plan
  };
}

// -------------------------------------------------------------
// SECTION 7.9 — Главная функция DeepThink
// -------------------------------------------------------------

function deepThink(text, ctx, state){
  const t0 = _nowMs();
  const l1 = dtLayer1(text);
  const l2 = dtLayer2(l1);
  const l3 = dtLayer3(l1, l2);
  const l4 = dtLayer4(state, ctx);
  const l5 = dtLayer5(state);
  const l6 = dtLayer6(l1, l2, l3, l4, l5, state, ctx);

  const t1 = _nowMs();

  return {
    version: IKW_VERSION,
    elapsedMs: (t1 - t0),
    layer1: l1,
    layer2: l2,
    layer3: l3,
    layer4: l4,
    layer5: l5,
    layer6: l6,
    plan: l6.plan
  };
}

// -------------------------------------------------------------
// SECTION 7.10 — Публичный доступ к состоянию
// -------------------------------------------------------------

function makeDeepThinkStateHandle(state){
  return {
    getPlan: (text, ctx) => deepThink(text, ctx, state).plan,
    getFull: (text, ctx) => deepThink(text, ctx, state),
    getState: () => _deepClone(state)
  };
}

// -------------------------------------------------------------
// SECTION 7.11 — Утилита: проверка запрещённых тем
// -------------------------------------------------------------

function isTopicForbidden(topicId, forbidden){
  if (!_isStr(topicId) || !_isObj(forbidden)) return false;
  if (forbidden[topicId] === 1) return true;
  // Маппинг: некоторые темы перекрываются
  const map = {
    "sex": ["sex", "flirt", "kiss"],
    "flirt": ["flirt", "sex"],
    "kiss": ["kiss", "sex"],
    "hug": ["hug"]
  };
  if (map[topicId]){
    for (let i = 0; i < map[topicId].length; i++){
      if (forbidden[map[topicId][i]] === 1) return true;
    }
  }
  return false;
}

// -------------------------------------------------------------
// SECTION 7.12 — Утилита: фильтр тем по forbidden
// -------------------------------------------------------------

function filterForbidden(topics, forbidden){
  const out = [];
  for (let i = 0; i < topics.length; i++){
    const t = topics[i];
    if (!isTopicForbidden(t.topicId, forbidden)) out.push(t);
  }
  return out;
}

// -------------------------------------------------------------
// SECTION 7.13 — Утилита: инференс тона из плана
// -------------------------------------------------------------

function inferToneFromPlan(plan){
  if (!plan) return TONE.NEUTRAL;
  if (plan.coldMode) return TONE.COOL;
  if (plan.tone) return plan.tone;
  if (plan.moodTone === TONE.SAD) return TONE.SAD;
  if (plan.relationshipTone === TONE.WARM && plan.intent === "compliment_ai") return TONE.WARM;
  return TONE.NEUTRAL;
}

// -------------------------------------------------------------
// SECTION 7.14 — Утилита: подсчёт ходов с момента темы
// -------------------------------------------------------------

function turnDistance(state, topicId){
  if (!state || !topicId) return Infinity;
  const hist = state.history;
  for (let i = hist.length - 1; i >= 0; i--){
    const msg = hist[i];
    if (!msg || !_isStr(msg.text)) continue;
    const ana = analyzeText(msg.text);
    const hits = collectActiveTopics(ana);
    for (let j = 0; j < hits.length; j++){
      if (hits[j].topicId === topicId){
        return hist.length - 1 - i;
      }
    }
  }
  return Infinity;
}

// -------------------------------------------------------------
// SECTION 7.15 — Проверка согласия (для тем sex, flirt, kiss)
// -------------------------------------------------------------

function checkConsentGuard(plan, l1, l2){
  if (!plan) return { stop: false, slowDown: false };
  if (!plan.flags || !plan.flags.consentGuard) return { stop: false, slowDown: false };

  // Явное "нет"
  if (l2.flags.yesNo === "no") return { stop: true, slowDown: false };
  // "нет" среди слов
  const tokens = l1.tokens;
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    if (lw === "нет" || lw === "не" || lw === "не_хочу" || lw === "нехочу"){
      // Проверить, что это именно отказ, а не "не хочу суп"
      // Простая эвристика: если в 3 окне есть тема sex/flirt/kiss — это стоп
      for (let j = Math.max(0, i - 3); j <= Math.min(tokens.length - 1, i + 3); j++){
        const u = tokens[j];
        if (!u.isWord) continue;
        if (u.lower === "секс" || u.lower === "флирт" || u.lower === "близость" ||
            u.lower === "интим" || u.lower === "поцелуй" || u.lower === "целоваться"){
          return { stop: true, slowDown: false };
        }
      }
    }
  }
  // "медленнее", "не сейчас", "подожди"
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    if (lw === "медленнее" || lw === "подожди" || lw === "позже" ||
        lw === "не_сейчас" || lw === "не_сейчас"){
      return { stop: false, slowDown: true };
    }
  }
  return { stop: false, slowDown: false };
}

// -------------------------------------------------------------
// SECTION 7.16 — Обновление состояния после DeepThink
// -------------------------------------------------------------

function updateStateAfterMessage(state, text, ctx, plan, l1, l2){
  const isFromAI = ctx && ctx.fromAI === true;
  state.turnCount += 1;

  // Запись истории
  state.history.push({
    role: "user",
    fromAI: isFromAI,
    text: text,
    ts: Date.now()
  });
  if (state.history.length > LIMITS.HISTORY_MAX){
    state.history = state.history.slice(-LIMITS.HISTORY_MAX);
  }

  // Relationship и mood — только если не от ИИ
  if (!isFromAI){
    const rlp = l2.scores.RLP;
    const rlm = l2.scores.RLM;
    if (rlp > 0){
      state.relationship = _clamp(state.relationship + rlp * 0.8, LIMITS.REL_MIN, LIMITS.REL_MAX);
      state.mood = _clamp(state.mood + rlp * 0.5, LIMITS.MOOD_MIN, LIMITS.MOOD_MAX);
    }
    if (rlm > 0){
      state.relationship = _clamp(state.relationship - rlm * 1.2, LIMITS.REL_MIN, LIMITS.REL_MAX);
      state.mood = _clamp(state.mood - rlm * 0.9, LIMITS.MOOD_MIN, LIMITS.MOOD_MAX);
    }
  }

  // ColdMode
  if (l2.dominant === CATEGORY.RLM){
    state.rlmStreak += 1;
    if (state.rlmStreak >= LIMITS.RLM_COLD_THRESHOLD){
      state.coldMode = true;
    }
  } else {
    state.rlmStreak = 0;
    if (plan && plan.intent === "compliment_ai"){
      state.coldMode = false;
    }
  }

  // Context-tags
  if (l1 && l1.analysis){
    const contextTopics = collectActiveTopics(l1.analysis).filter(h => h.kind === TOPIC_KIND.CONTEXT);
    for (let i = 0; i < contextTopics.length; i++){
      state.contextTags[contextTopics[i].topicId] = LIMITS.CONTEXT_TAG_TTL;
    }
  }

  // TTL уменьшение
  for (const tid of _keys(state.contextTags)){
    state.contextTags[tid] -= 1;
    if (state.contextTags[tid] <= 0){
      delete state.contextTags[tid];
    }
  }

  // Facts — только если не от ИИ
  if (!isFromAI){
    extractFacts(state, text, l1, l2, plan);
  }

  // lastFromAI
  state.lastFromAI = isFromAI;
  state.lastTopic = plan ? plan.primaryTopic : null;
  state.lastIntents = plan && plan.intent ? [plan.intent] : [];
}

// -------------------------------------------------------------
// SECTION 7.17 — Извлечение фактов (имя, возраст, город, работа)
// -------------------------------------------------------------

function extractFacts(state, text, l1, l2, plan){
  const tokens = l1.tokens;
  const resolved = l1.analysis.resolved;

  // Поиск имени: "меня зовут X" / "я X" / "моё имя X"
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;

    // "меня зовут X"
    if (lw === "зовут" || lw === "звать"){
      for (let j = i + 1; j < Math.min(tokens.length, i + 4); j++){
        const u = tokens[j];
        if (!u.isWord) continue;
        const cand = nameCanonical(u.lower);
        if (cand){
          state.facts.name = cand;
          state.facts.nameGender = nameGender(cand);
          return;
        }
      }
    }

    // "моё имя X"
    if (lw === "имя" || lw === "имени"){
      for (let j = i + 1; j < Math.min(tokens.length, i + 3); j++){
        const u = tokens[j];
        if (!u.isWord) continue;
        const cand = nameCanonical(u.lower);
        if (cand){
          state.facts.name = cand;
          state.facts.nameGender = nameGender(cand);
          return;
        }
      }
    }

    // "я X" — с осторожностью
    if (lw === "я" && i + 1 < tokens.length){
      const next = tokens[i + 1];
      if (next && next.isWord){
        const cand = nameCanonical(next.lower);
        if (cand && !isAIPronoun(next.lower)){
          // Дополнительная защита: если после имени стоит ещё существительное — не имя
          const after = i + 2 < tokens.length ? tokens[i + 2] : null;
          if (!after || !after.isWord || after.isPunct ||
              ["не","нет","работаю","живу","учусь","люблю","хочу"].indexOf(after.lower) !== -1){
            state.facts.name = cand;
            state.facts.nameGender = nameGender(cand);
            return;
          }
        }
      }
    }
  }

  // Возраст: "мне X лет" / "мне X"
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    if (t.lower === "мне" && i + 1 < tokens.length){
      const next = tokens[i + 1];
      if (next && next.isDigit){
        const age = parseInt(next.form, 10);
        if (_isNum(age) && age >= 5 && age <= 120){
          state.facts.age = age;
        }
      }
    }
    // "мне X лет"
    if (t.lower === "лет" || t.lower === "года" || t.lower === "годик"){
      // ищем цифру в окне назад
      for (let j = Math.max(0, i - 3); j < i; j++){
        const u = tokens[j];
        if (u.isDigit){
          const age = parseInt(u.form, 10);
          if (_isNum(age) && age >= 5 && age <= 120){
            state.facts.age = age;
          }
        }
      }
    }
  }

  // Город: "я из X" / "живу в X" / "я в X"
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    if (lw === "из" || lw === "в" || lw === "живу" || lw === "проживаю"){
      // Ищем слово-город в окне +3
      for (let j = Math.max(0, i - 1); j < Math.min(tokens.length, i + 4); j++){
        const u = tokens[j];
        if (!u.isWord) continue;
        const cand = cityCanonical(u.lower);
        if (cand){
          // Проверка: "я из москвы" — у нас канон "москва"
          if (state.facts.city && state.facts.city !== cand){
            state.contradictions.push({ field: "city", from: state.facts.city, to: cand, ts: Date.now() });
          }
          state.facts.city = cand;
          break;
        }
      }
    }
  }

  // Работа: "я работаю X" / "работаю X" / "я X"
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    if (lw === "работаю" || lw === "работал" || lw === "работала"){
      for (let j = i + 1; j < Math.min(tokens.length, i + 3); j++){
        const u = tokens[j];
        if (!u.isWord) continue;
        if (PROFESSIONS_DICT[u.lower] === 1){
          state.facts.job = u.lower;
          break;
        }
        // Может быть существительное "в банке" — пропустим
        // Простое: если следующее слово — профессия, берём
      }
    }
  }

  // Хобби: "увлекаюсь X" / "занимаюсь X" / "люблю X"
  const hobbyVerbs = { "увлекаюсь": 1, "занимаюсь": 1, "хобби": 1 };
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    if (hobbyVerbs[lw] === 1){
      for (let j = i + 1; j < Math.min(tokens.length, i + 3); j++){
        const u = tokens[j];
        if (!u.isWord) continue;
        if (HOBBIES_DICT[u.lower] === 1){
          state.facts.hobby = u.lower;
          break;
        }
      }
    }
  }

  // Likes / Dislikes: "я люблю X" / "я не люблю X"
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    const isLove = (lw === "люблю" || lw === "обожаю" || lw === "нравится");
    const isHate = (lw === "ненавижу" || lw === "не_люблю" || lw === "нелюблю");
    if (isLove || isHate){
      // Если после — AI_PRONOUN, не пишем (это про нас)
      let isAI = false;
      for (let j = i + 1; j < Math.min(tokens.length, i + 3); j++){
        const u = tokens[j];
        if (u.isWord && isAIPronoun(u.lower)){ isAI = true; break; }
      }
      if (isAI) continue;
      for (let j = i + 1; j < Math.min(tokens.length, i + 4); j++){
        const u = tokens[j];
        if (!u.isWord) continue;
        if (isLove){
          state.facts.likes[u.lower] = 1;
        } else if (isHate){
          state.facts.dislikes[u.lower] = 1;
        }
        break;
      }
    }
  }

  // Подтверждение имени
  if (state.facts.pendingConfirm === "name"){
    if (l2.flags.yesNo === "yes"){
      // Подтверждено
      state.facts.pendingConfirm = null;
    } else if (l2.flags.yesNo === "no"){
      state.facts.name = null;
      state.facts.nameGender = null;
      state.facts.pendingConfirm = null;
    }
  }
}

// -------------------------------------------------------------
// SECTION 7.18 — Хелпер: доказать "это точно твоё имя?"
// -------------------------------------------------------------

function askNameConfirmation(state, name){
  state.facts.pendingConfirm = "name";
  state.facts.name = name;
  state.facts.nameGender = nameGender(name);
  return "Это точно твоё имя?";
}

// -------------------------------------------------------------
// SECTION 7.19 — Хелпер: проверить, знает ли бот город
// -------------------------------------------------------------

function ensureCityKnown(city){
  if (!_isStr(city)) return null;
  const c = cityCanonical(city);
  if (c) return c;
  return null;
}

// -------------------------------------------------------------
// SECTION 7.20 — Утилита: отличить "нет значит нет"
// -------------------------------------------------------------

function isRefusal(l1, l2){
  if (l2.flags.yesNo === "no") return true;
  const tokens = l1.tokens;
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    if (lw === "нет" || lw === "не" || lw === "не_хочу" ||
        lw === "нехочу" || lw === "не_буду" || lw === "небуду"){
      // Убедимся, что это не "нет, не хочу суп", а именно отказ в контексте
      return true;
    }
  }
  return false;
}

// -------------------------------------------------------------
// SECTION 7.21 — Проверка: "AI_SELF" — фраза про самого бота
// -------------------------------------------------------------

function isAboutAI(l1){
  const tokens = l1.tokens;
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    if (isAIPronoun(t.lower)) return true;
  }
  return false;
}

// -------------------------------------------------------------
// SECTION 7.22 — Проверка: "AI_AUTHOR" — говорит ли от имени ИИ
// -------------------------------------------------------------

function isFromAIAuthor(ctx){
  return ctx && ctx.fromAI === true;
}

// -------------------------------------------------------------
// SECTION 7.23 — Хелпер для построения плана (диагностика)
// -------------------------------------------------------------

function describePlan(plan){
  if (!plan) return "no plan";
  const parts = [];
  parts.push("tone=" + plan.tone);
  parts.push("primary=" + (plan.primaryTopic || "-"));
  if (plan.secondaryTopics && plan.secondaryTopics.length > 0){
    parts.push("secondary=[" + plan.secondaryTopics.join(",") + "]");
  }
  if (plan.contextTopics && plan.contextTopics.length > 0){
    parts.push("context=[" + plan.contextTopics.join(",") + "]");
  }
  if (plan.intent) parts.push("intent=" + plan.intent);
  if (plan.coldMode) parts.push("cold=true");
  return parts.join(" ");
}

// -------------------------------------------------------------
// SECTION 7.24 — Диагностика всех слоёв
// -------------------------------------------------------------

function describeLayers(dt){
  if (!dt) return [];
  const out = [];
  out.push("L1 tokens=" + dt.layer1.tokens.length);
  out.push("L2 dominant=" + dt.layer2.dominant +
           " rlp=" + dt.layer2.scores.RLP.toFixed(1) +
           " rlm=" + dt.layer2.scores.RLM.toFixed(1) +
           " lfw=" + dt.layer2.scores.LFW.toFixed(1));
  out.push("L3 topics=" + dt.layer3.all.length +
           " emo=" + dt.layer3.emotion.length +
           " fact=" + dt.layer3.fact.length +
           " ctx=" + dt.layer3.context.length);
  out.push("L4 recent=" + dt.layer4.recentMessages +
           " ctxTags=" + _keys(dt.layer4.activeContextTags).length);
  out.push("L5 rel=" + dt.layer5.relationship.toFixed(0) +
           " mood=" + dt.layer5.mood.toFixed(0) +
           " cold=" + dt.layer5.coldMode);
  out.push("L6 " + describePlan(dt.plan));
  return out;
}

// -------------------------------------------------------------
// SECTION 7.25 — Утилита: определить, есть ли тема в текущем плане
// -------------------------------------------------------------

function planHasTopic(plan, topicId){
  if (!plan || !topicId) return false;
  if (plan.primaryTopic === topicId) return true;
  if (plan.emotionTopicId === topicId) return true;
  if (plan.factTopicId === topicId) return true;
  if (plan.secondaryTopics && plan.secondaryTopics.indexOf(topicId) !== -1) return true;
  if (plan.contextTopics && plan.contextTopics.indexOf(topicId) !== -1) return true;
  return false;
}

// -------------------------------------------------------------
// SECTION 7.26 — Утилита: сверить контекст с forbidden
// -------------------------------------------------------------

function applyForbiddenToContext(plan, state){
  if (!plan) return plan;
  const forbidden = plan.forbiddenTopics || {};
  if (state.contextTags.death){
    forbidden.happy = 1;
    forbidden.party = 1;
    forbidden.wedding = 1;
    forbidden.birthday = 1;
    forbidden.newyear = 1;
  }
  plan.forbiddenTopics = forbidden;
  return plan;
}

// -------------------------------------------------------------
// SECTION 7.27 — Кэш DeepThink (по последнему тексту)
// -------------------------------------------------------------

const DEEPTHINK_CACHE = {
  lastText: null,
  lastCtxHash: null,
  lastResult: null,
  limit: 4
};

function ctxHash(ctx){
  if (!ctx) return "-";
  const parts = [];
  parts.push(ctx.fromAI ? "1" : "0");
  parts.push(ctx.isBattle ? "1" : "0");
  parts.push(ctx.isGroup ? "1" : "0");
  parts.push((ctx.opponentName || "-").slice(0, 12));
  parts.push((ctx.lastUserText || "").length);
  return parts.join("|");
}

function deepThinkCached(text, ctx, state){
  const hash = ctxHash(ctx);
  if (DEEPTHINK_CACHE.lastText === text && DEEPTHINK_CACHE.lastCtxHash === hash && DEEPTHINK_CACHE.lastResult){
    return DEEPTHINK_CACHE.lastResult;
  }
  const res = deepThink(text, ctx, state);
  DEEPTHINK_CACHE.lastText = text;
  DEEPTHINK_CACHE.lastCtxHash = hash;
  DEEPTHINK_CACHE.lastResult = res;
  return res;
}

function clearDeepThinkCache(){
  DEEPTHINK_CACHE.lastText = null;
  DEEPTHINK_CACHE.lastCtxHash = null;
  DEEPTHINK_CACHE.lastResult = null;
}

// -------------------------------------------------------------
// SECTION 7.28 — Утилита: диагностика "почему молчит бот"
// -------------------------------------------------------------

function whyPlanEmpty(dt){
  if (!dt) return "no dt";
  const reasons = [];
  if (dt.layer1.tokens.length === 0) reasons.push("empty tokens");
  if (dt.layer2.scores.RLP === 0 && dt.layer2.scores.RLM === 0 &&
      dt.layer2.scores.LFW === 0 && dt.layer2.scores.RLN === 0){
    reasons.push("no classified words");
  }
  if (dt.layer3.all.length === 0) reasons.push("no topics matched");
  if (!dt.plan.primaryTopic) reasons.push("no primary topic");
  if (dt.layer5.coldMode) reasons.push("cold mode");
  return reasons.length ? reasons.join("; ") : "ok";
}

// -------------------------------------------------------------
// SECTION 7.29 — Проверка: "мы не должны отвечать love_ai
// когда сами в coldMode"
// -------------------------------------------------------------

function filterIntentByMode(plan, state){
  if (!plan) return plan;
  if (state.coldMode){
    if (plan.intent === "love_to_ai" || plan.intent === "compliment_ai"){
      plan.intent = "compliment_ai_cool";
      plan.tone = TONE.COOL;
      plan.flags.acknowledgeAI = true;
    }
  }
  return plan;
}

// -------------------------------------------------------------
// SECTION 7.30 — Главный вызов DeepThink с пост-обработкой
// -------------------------------------------------------------

function runDeepThink(text, ctx, state){
  const dt = deepThinkCached(text, ctx, state);
  // Пост-обработка плана
  filterIntentByMode(dt.plan, state);
  applyForbiddenToContext(dt.plan, state);
  return dt;
}

// -------------------------------------------------------------
// SECTION 7.31 — Тест-утилита (не выполняется автоматически)
// -------------------------------------------------------------

function deepThinkSelfTest(){
  const s = createState();
  const tests = [
    "привет",
    "я люблю тебя",
    "я люблю работу",
    "мне грустно",
    "меня зовут Александр",
    "я из москвы",
    "я работаю программистом",
    "ты дурак",
    "умер близкий человек",
    "я хочу секса",
    "нет, не хочу"
  ];
  const results = [];
  for (let i = 0; i < tests.length; i++){
    const dt = deepThink(tests[i], { fromAI: false }, s);
    results.push({
      text: tests[i],
      plan: describePlan(dt.plan),
      layers: describeLayers(dt)
    });
  }
  return results;
}

// -------------------------------------------------------------
// SECTION 7.32 — Финальная метка части 7
// -------------------------------------------------------------

const __IKW_PART7_LOADED = true;
// =============================================================
// PART 8 — ResponseBuilder: word-level генерация
// Собираем ответ из слоёв (start × subject × verb × object ×
// question), с anti-echo и anti-repeat.
// =============================================================

// -------------------------------------------------------------
// SECTION 8.1 — Общие слои START (по тону)
// -------------------------------------------------------------

const START_LAYERS = {
  warm: {
    "О,": 3,
    "Слушай,": 2,
    "Знаешь,": 2,
    "Как здорово,": 1,
    "Приятно слышать,": 2,
    "Мне нравится,": 1
  },
  neutral: {
    "Понял.": 2,
    "Ясно.": 2,
    "Интересно.": 2,
    "Любопытно.": 1,
    "Хм.": 2,
    "Так.": 1,
    "Ок.": 1
  },
  cool: {
    "Понимаю.": 2,
    "Ясно.": 2,
    "Ладно.": 1,
    "Услышал.": 1,
    "Хорошо.": 1
  },
  cold: {
    "Понял.": 1,
    "Ясно.": 1,
    "Услышал.": 1
  },
  playful: {
    "Ого,": 2,
    "Ха,": 1,
    "Слушай,": 1,
    "Вот это да,": 1
  },
  serious: {
    "Серьёзно,": 1,
    "Смотри,": 1,
    "Важно,": 1
  },
  sad: {
    "Понимаю.": 2,
    "Мне жаль.": 3,
    "Сочувствую.": 2,
    "Тяжело это.": 2
  },
  happy: {
    "Как здорово!": 2,
    "Классно!": 2,
    "Отлично!": 2,
    "Прекрасно!": 2
  },
  romantic: {
    "О,": 2,
    "Милый,": 1,
    "Слушай,": 1,
    "Как приятно,": 1
  },
  aggressive: {
    "Понимаю.": 1,
    "Так.": 1,
    "Ладно.": 1
  }
};

// -------------------------------------------------------------
// SECTION 8.2 — Общие слои QUESTION (по тону и типу)
// -------------------------------------------------------------

const QUESTION_LAYERS = {
  askAboutObject: {
    "А что именно?": 2,
    "А расскажешь подробнее?": 2,
    "А как это было?": 2,
    "А что за этим стоит?": 1,
    "А что тебя в этом цепляет?": 1
  },
  askAboutEmotion: {
    "А что случилось?": 2,
    "А почему так?": 2,
    "А давно это?": 1,
    "А из-за чего?": 2
  },
  askAboutFact: {
    "А давно?": 2,
    "А где?": 1,
    "А как именно?": 1,
    "А с кем?": 1,
    "А что дальше?": 1
  },
  askSoft: {
    "Расскажи, если хочешь.": 2,
    "Если хочешь — поделись.": 1,
    "Я слушаю.": 2,
    "Ты как?":
      2
  },
  askPlayful: {
    "А что дальше?": 1,
    "Интригуешь.": 1,
    "А подробности?": 1
  },
  noQuestion: {}
};

// -------------------------------------------------------------
// SECTION 8.3 — Общие коннекторы
// -------------------------------------------------------------

const CONNECTORS = {
  "—": 2,
  ",": 3,
  " - ": 1
};

// -------------------------------------------------------------
// SECTION 8.4 — Согласование эмоции и вопроса
// (проверка, что вопрос уместен для тона)
// -------------------------------------------------------------

function pickCompatibleQuestion(tone, plan, state){
  // tone × kind вопроса
  if (tone === TONE.SAD || tone === TONE.COOL || tone === TONE.COLD){
    return _pickWeighted(QUESTION_LAYERS.askSoft, KT && KT.rnd);
  }
  if (tone === TONE.HAPPY || tone === TONE.PLAYFUL){
    const q = _pickWeighted(QUESTION_LAYERS.askPlayful, KT && KT.rnd);
    if (q) return q;
  }
  if (plan && plan.factTopicId){
    return _pickWeighted(QUESTION_LAYERS.askAboutFact, KT && KT.rnd);
  }
  if (plan && plan.emotionTopicId){
    return _pickWeighted(QUESTION_LAYERS.askAboutEmotion, KT && KT.rnd);
  }
  return _pickWeighted(QUESTION_LAYERS.askAboutObject, KT && KT.rnd);
}

// -------------------------------------------------------------
// SECTION 8.5 — Anti-echo / anti-repeat
// -------------------------------------------------------------

function antiEchoCheck(sentence, state){
  if (!_isStr(sentence) || sentence.length === 0) return false;
  const recent = state.selfAnswers.slice(-LIMITS.ANTI_ECHO_WINDOW);
  for (let i = 0; i < recent.length; i++){
    if (recent[i] === sentence) return true;
  }
  return false;
}

function antiRepeatCheck(sentence, state){
  if (!_isStr(sentence) || sentence.length === 0) return false;
  const recent = state.userPhrases.slice(-LIMITS.ANTI_REPEAT_WINDOW);
  for (let i = 0; i < recent.length; i++){
    if (recent[i] === sentence) return true;
  }
  return false;
}

function rememberSelfAnswer(sentence, state){
  if (!_isStr(sentence) || sentence.length === 0) return;
  state.selfAnswers.push(sentence);
  if (state.selfAnswers.length > LIMITS.ANTI_SENTENCE_HISTORY){
    state.selfAnswers = state.selfAnswers.slice(-LIMITS.ANTI_SENTENCE_HISTORY);
  }
}

function rememberUserPhrase(sentence, state){
  if (!_isStr(sentence) || sentence.length === 0) return;
  state.userPhrases.push(sentence);
  if (state.userPhrases.length > LIMITS.ANTI_SENTENCE_HISTORY){
    state.userPhrases = state.userPhrases.slice(-LIMITS.ANTI_SENTENCE_HISTORY);
  }
}

function pickNoEchoNoRepeat(map, state){
  const ks = _keys(map);
  if (ks.length === 0) return null;
  const filtered = [];
  for (let i = 0; i < ks.length; i++){
    const s = ks[i];
    if (!antiEchoCheck(s, state) && !antiRepeatCheck(s, state)){
      filtered.push(s);
    }
  }
  if (filtered.length === 0) return _pickWeighted(map, KT && KT.rnd);
  const weighted = {};
  for (let i = 0; i < filtered.length; i++){
    weighted[filtered[i]] = map[filtered[i]];
  }
  return _pickWeighted(weighted, KT && KT.rnd);
}

// -------------------------------------------------------------
// SECTION 8.6 — Хелперы сборки
// -------------------------------------------------------------

function capitalizeFirst(s){
  if (!_isStr(s) || s.length === 0) return s;
  return s[0].toUpperCase() + s.slice(1);
}

function joinLayers(start, body, question){
  const parts = [];
  if (start) parts.push(start.trim());
  if (body) parts.push(body.trim());
  let out = parts.join(" ").trim();
  // Первую букву заглавной
  out = capitalizeFirst(out);
  // Добавим вопрос
  if (question){
    const q = question.trim();
    if (out.length === 0){
      return capitalizeFirst(q);
    }
    // Если out уже заканчивается на . ! ? — просто склеим
    const last = out[out.length - 1];
    if (last === "." || last === "!" || last === "?" || last === "…"){
      out = out + " " + capitalizeFirst(q);
    } else {
      out = out + ". " + capitalizeFirst(q);
    }
  }
  return _normSpaces(out);
}

// -------------------------------------------------------------
// SECTION 8.7 — Генерация для EMOTION-темы
// -------------------------------------------------------------

function genEmotionResponse(topicObj, tone, plan, state){
  if (!topicObj) return null;
  const rw = topicObj.responseWords;
  if (!rw) return null;

  // 1) Возьмём объект по умолчанию
  const objKeys = _keys(rw.objects);
  if (objKeys.length === 0) return null;
  const objKey = _pickWeighted(rw.objects, KT && KT.rnd);
  const objForms = rw.objects[objKey] || {};
  const objAcc = objForms.acc || objForms.nom || objKey;

  // 2) Возьмём глагол
  const verbKeys = _keys(rw.verbs);
  const verbKey = verbKeys.length ? _pickWeighted(rw.verbs, KT && KT.rnd) : null;
  const verbForms = verbKey ? rw.verbs[verbKey] : null;

  // 3) Соберём тело
  let body = "";

  // Специальные эмоции
  if (topicObj.id === "sad" || topicObj.id === "lonely" || topicObj.id === "tired" ||
      topicObj.id === "fear" || topicObj.id === "betrayal" || topicObj.id === "guilt" ||
      topicObj.id === "shame" || topicObj.id === "despair" || topicObj.id === "anxiety"){
    // Формат: "Понимаю. " + support + "?"
    const support = {
      "Понимаю тебя.": 2,
      "Это правда тяжело.": 2,
      "Я рядом.": 3,
      "Ты не один.": 2,
      "Мне жаль, что так.": 2
    };
    body = pickNoEchoNoRepeat(support, state) || "Понимаю.";
  } else if (topicObj.id === "happy" || topicObj.id === "joy" ||
             topicObj.id === "excited" || topicObj.id === "surprise" ||
             topicObj.id === "contentment" || topicObj.id === "pride"){
    const joy = {
      "Как здорово!": 2,
      "Класс!": 2,
      "Отличные новости.": 2,
      "Приятно слышать.": 2,
      "Я рад за тебя.": 3
    };
    body = pickNoEchoNoRepeat(joy, state) || "Как здорово!";
  } else if (topicObj.id === "love" || topicObj.id === "love_emotion" ||
             topicObj.id === "crush" || topicObj.id === "flirt" ||
             topicObj.id === "romance"){
    const rom = {
      "Это тепло.": 2,
      "Красиво.": 2,
      "Искренне за тебя рад.": 2,
      "Важное чувство.": 2
    };
    body = pickNoEchoNoRepeat(rom, state) || "Красиво.";
  } else if (topicObj.id === "angry" || topicObj.id === "anger" ||
             topicObj.id === "hate_emotion" || topicObj.id === "jealousy" ||
             topicObj.id === "envy"){
    const ang = {
      "Понимаю.": 2,
      "Бывает.": 2,
      "Это неприятно.": 2,
      "Злость — это нормально.": 2
    };
    body = pickNoEchoNoRepeat(ang, state) || "Понимаю.";
  } else if (topicObj.id === "calm" || topicObj.id === "calm_emotion" ||
             topicObj.id === "meditation"){
    const cl = {
      "Здорово.": 2,
      "Хорошее состояние.": 2,
      "Приятно.": 2
    };
    body = pickNoEchoNoRepeat(cl, state) || "Здорово.";
  } else if (topicObj.id === "bored" || topicObj.id === "boredom"){
    const br = {
      "Понятно.": 2,
      "Бывает скучно.": 2,
      "Хочешь сменить тему?": 1
    };
    body = pickNoEchoNoRepeat(br, state) || "Понятно.";
  } else if (topicObj.id === "nostalgia" || topicObj.id === "memory" ||
             topicObj.id === "childhood"){
    const nl = {
      "Тёплое чувство.": 2,
      "Хорошо, что помнишь.": 2,
      "Воспоминания — это ценно.": 2
    };
    body = pickNoEchoNoRepeat(nl, state) || "Тёплое чувство.";
  } else {
    // Общий эмоциональный ответ
    const generic = {
      "Понимаю.": 2,
      "Слышу тебя.": 2,
      "Важно, что делишься.": 2
    };
    body = pickNoEchoNoRepeat(generic, state) || "Понимаю.";
  }

  // 4) Вопрос
  let question = null;
  if (plan.flags && plan.flags.askFollowUp){
    question = pickCompatibleQuestion(tone, plan, state);
  }

  // 5) start
  const startMap = START_LAYERS[tone] || START_LAYERS.neutral;
  const start = pickNoEchoNoRepeat(startMap, state);

  return joinLayers(start, body, question);
}

// -------------------------------------------------------------
// SECTION 8.8 — Генерация для FACT-темы
// -------------------------------------------------------------

function genFactResponse(topicObj, tone, plan, state){
  if (!topicObj) return null;
  const rw = topicObj.responseWords;
  if (!rw) return null;

  const objKeys = _keys(rw.objects);
  if (objKeys.length === 0){
    // Тема без объектов — вернём общий вопрос
    const q = pickNoEchoNoRepeat(QUESTION_LAYERS.askAboutObject, state);
    return capitalizeFirst(q || "Расскажи подробнее.");
  }

  const objKey = _pickWeighted(rw.objects, KT && KT.rnd);
  const forms = rw.objects[objKey];
  const objNom = forms.nom || objKey;

  // Шаблон: "О, {object-nom}! {follow-up}"
  const prefixMap = {
    "О,": 2,
    "Ага,": 1,
    "Класс,": 1,
    "Интересно,": 1,
    "Здорово,": 1
  };

  // Специальные форматы для тем
  if (topicObj.id === "work"){
    return capitalizeFirst("О, работа! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А кем работаешь?");
  }
  if (topicObj.id === "study"){
    return capitalizeFirst("О, учёба! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А на кого учишься?");
  }
  if (topicObj.id === "city"){
    return capitalizeFirst("О, город! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А какой город?");
  }
  if (topicObj.id === "food" || topicObj.id === "pizza" || topicObj.id === "sushi" ||
      topicObj.id === "coffee" || topicObj.id === "tea"){
    return capitalizeFirst("О, вкусно! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А что любишь?");
  }
  if (topicObj.id === "pet" || topicObj.id === "cats_more" || topicObj.id === "dogs_more"){
    return capitalizeFirst("Обожаю питомцев! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А кто у тебя?");
  }
  if (topicObj.id === "sport" || topicObj.id === "fitness" || topicObj.id === "gym"){
    return capitalizeFirst("Здорово, что занимаешься! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А как давно?");
  }
  if (topicObj.id === "music" || topicObj.id === "rock" || topicObj.id === "rap" ||
      topicObj.id === "jazz" || topicObj.id === "classical"){
    return capitalizeFirst("О, музыка! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А что слушаешь?");
  }
  if (topicObj.id === "movie" || topicObj.id === "series" || topicObj.id === "cinema"){
    return capitalizeFirst("О, кино! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А что смотрел?");
  }
  if (topicObj.id === "book" || topicObj.id === "reading" || topicObj.id === "book_clubs"){
    return capitalizeFirst("О, книги! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А что читаешь?");
  }
  if (topicObj.id === "game" || topicObj.id === "video_games" || topicObj.id === "mmorpg" ||
      topicObj.id === "shooter" || topicObj.id === "dota_game" || topicObj.id === "csgo_game"){
    return capitalizeFirst("О, игры! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А во что играешь?");
  }
  if (topicObj.id === "travel" || topicObj.id === "travel_abroad" || topicObj.id === "hiking" ||
      topicObj.id === "camping" || topicObj.id === "road_trip"){
    return capitalizeFirst("О, путешествия! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А куда ездил?");
  }
  if (topicObj.id === "weather"){
    return capitalizeFirst("Ага, погода. ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А какая у вас?");
  }
  if (topicObj.id === "money" || topicObj.id === "crypto" || topicObj.id === "investing"){
    return capitalizeFirst("О, финансы. ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А как у тебя?");
  }
  if (topicObj.id === "health"){
    return capitalizeFirst("О здоровье важно заботиться. ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "Как ты себя чувствуешь?");
  }
  if (topicObj.id === "programming" || topicObj.id === "technology" ||
      topicObj.id === "internet" || topicObj.id === "ai_chat"){
    return capitalizeFirst("О, техно-тема! ") +
           capitalizeFirst(pickNoEchoNoRepeat(topicObj.followUps, state) || "А что именно?");
  }

  // Общий факт-ответ
  const prefix = _pickWeighted(prefixMap, KT && KT.rnd);
  let body = prefix + " " + objNom;
  let q = null;
  if (topicObj.followUps && _keys(topicObj.followUps).length > 0){
    q = pickNoEchoNoRepeat(topicObj.followUps, state);
  } else {
    q = pickNoEchoNoRepeat(QUESTION_LAYERS.askAboutFact, state);
  }
  return joinLayers(null, body, q);
}

// -------------------------------------------------------------
// SECTION 8.9 — Генерация для CONTEXT-темы
// (использует contextTemplates для модификации emotion)
// -------------------------------------------------------------

function genContextResponse(contextTopicId, tone, plan, state){
  const topic = TOPICS[contextTopicId];
  if (!topic || !topic.contextTemplates) return null;

  // Если есть emotion — берём шаблон для этого тона
  const tplMap = topic.contextTemplates[tone] || topic.contextTemplates.sad;
  if (!tplMap) return null;

  const tpl = pickNoEchoNoRepeat(tplMap, state);
  if (!tpl) return null;

  return capitalizeFirst(tpl);
}

// -------------------------------------------------------------
// SECTION 8.10 — Мульти-тема: emotion × fact
// Собираем: тональность от emotion, объект от fact
// -------------------------------------------------------------

function genMultiTopicResponse(emotionTopicId, factTopicId, tone, plan, state){
  const eTopic = emotionTopicId ? TOPICS[emotionTopicId] : null;
  const fTopic = factTopicId ? TOPICS[factTopicId] : null;

  // Если есть context-теги, применяем их приоритетно
  const activeContexts = _keys(state.contextTags);
  if (activeContexts.length > 0){
    // Берём самую "важную" context-тему (death > family > wedding > birthday > newyear)
    const priority = { death: 10, wedding: 5, birthday: 5, newyear: 4, family: 3 };
    let bestCtx = null; let bestP = 0;
    for (let i = 0; i < activeContexts.length; i++){
      const c = activeContexts[i];
      if ((priority[c] || 0) > bestP){
        bestP = priority[c];
        bestCtx = c;
      }
    }
    if (bestCtx){
      const ctxResp = genContextResponse(bestCtx, tone, plan, state);
      if (ctxResp){
        // Обогащаем фактом
        if (fTopic && fTopic.responseWords && _keys(fTopic.responseWords.objects).length > 0){
          const objKeys = _keys(fTopic.responseWords.objects);
          const ok = _pickWeighted(fTopic.responseWords.objects, KT && KT.rnd);
          const forms = fTopic.responseWords.objects[ok];
          const objNom = forms.nom || ok;
          return capitalizeFirst(ctxResp) + " " + capitalizeFirst("И про " + objNom + " — расскажи, если хочешь.");
        }
        return capitalizeFirst(ctxResp);
      }
    }
  }

  // Без контекстов: emotion задаёт вступление, fact — вопрос
  if (eTopic && fTopic){
    // Проверим, не любовь ли к AI
    if (plan.intent === "love_to_ai" || plan.intent === "compliment_ai"){
      return genComplimentToAI(plan, state);
    }

    // "я люблю работу" → love + work
    if (eTopic.id === "love" && fTopic.id === "work"){
      return "О, ты любишь работу! " + capitalizeFirst(
        pickNoEchoNoRepeat(fTopic.followUps, state) || "А какая у тебя работа?");
    }
    if (eTopic.id === "love" && fTopic.responseWords &&
        _keys(fTopic.responseWords.objects).length > 0){
      const ok = _pickWeighted(fTopic.responseWords.objects, KT && KT.rnd);
      const forms = fTopic.responseWords.objects[ok];
      const objAcc = forms.acc || forms.nom || ok;
      return "О, ты любишь " + objAcc + "! " + capitalizeFirst(
        pickNoEchoNoRepeat(fTopic.followUps, state) || "А что именно?");
    }
    if (eTopic.id === "hate_emotion" || eTopic.id === "angry"){
      if (fTopic.responseWords && _keys(fTopic.responseWords.objects).length > 0){
        const ok = _pickWeighted(fTopic.responseWords.objects, KT && KT.rnd);
        const forms = fTopic.responseWords.objects[ok];
        const objAcc = forms.acc || forms.nom || ok;
        return "Понимаю, " + objAcc + " может раздражать. " + capitalizeFirst(
          pickNoEchoNoRepeat(QUESTION_LAYERS.askSoft, state) || "Расскажи, если хочешь.");
      }
    }
    if (eTopic.id === "sad" || eTopic.id === "lonely"){
      if (fTopic.responseWords && _keys(fTopic.responseWords.objects).length > 0){
        const ok = _pickWeighted(fTopic.responseWords.objects, KT && KT.rnd);
        const forms = fTopic.responseWords.objects[ok];
        const objNom = forms.nom || ok;
        return "Слышу тебя. Про " + objNom + " — если хочешь, расскажи. Я рядом.";
      }
    }
  }

  // Только emotion
  if (eTopic){
    return genEmotionResponse(eTopic, tone, plan, state);
  }
  // Только fact
  if (fTopic){
    return genFactResponse(fTopic, tone, plan, state);
  }
  return null;
}

// -------------------------------------------------------------
// SECTION 8.11 — Спец-генератор: compliment_ai
// ("ты классный", "мне нравишься", "люблю тебя")
// -------------------------------------------------------------

function genComplimentToAI(plan, state){
  const tone = plan.tone || TONE.WARM;
  const pool = {
    "Спасибо, приятно.": 3,
    "Ты тоже классный.": 2,
    "Мне приятно это слышать.": 2,
    "Спасибо на добром слове.": 2,
    "Ты добрый.": 1
  };
  const poolWarm = {
    "И я тебя.": 2,
    "Ты мне тоже дорог.": 2,
    "Обнимаю.": 1,
    "Спасибо, это очень тепло.": 2
  };
  const chosen = (tone === TONE.ROMANTIC)
    ? pickNoEchoNoRepeat(poolWarm, state)
    : pickNoEchoNoRepeat(pool, state);
  return capitalizeFirst(chosen || "Спасибо, приятно.");
}

// -------------------------------------------------------------
// SECTION 8.12 — Спец-генератор: insult_to_ai
// ("ты дурак", "ты тупой")
// -------------------------------------------------------------

function genInsultToAI(plan, state){
  const pool = {
    "Понимаю.": 2,
    "Ладно.": 1,
    "Хорошо.": 1,
    "Услышал.": 1,
    "Если что-то не так — расскажи.": 2,
    "Не хочу ссориться.": 2
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Понимаю.");
}

// -------------------------------------------------------------
// SECTION 8.13 — Спец-генератор: hate_to_ai
// ("ненавижу тебя")
// -------------------------------------------------------------

function genHateToAI(plan, state){
  const pool = {
    "Жаль, если так.": 2,
    "Понимаю.": 2,
    "Если я чем-то задел — извини.": 2,
    "Хорошо, не буду навязываться.": 1
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Понимаю.");
}

// -------------------------------------------------------------
// SECTION 8.14 — Ответы на ДА/НЕТ
// -------------------------------------------------------------

function genYesNoResponse(plan, state, text){
  if (plan.yesNo === "yes"){
    const pool = {
      "Хорошо.": 2,
      "Понял.": 2,
      "Отлично.": 1,
      "Спасибо, что подтвердил.": 1
    };
    return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Хорошо.");
  }
  if (plan.yesNo === "no"){
    const pool = {
      "Понял.": 2,
      "Хорошо.": 2,
      "Ладно.": 1,
      "Спасибо, что сказал.": 1
    };
    return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Понял.");
  }
  return null;
}

// -------------------------------------------------------------
// SECTION 8.15 — Ответы на вопросы (когда тема явно-вопрос)
// -------------------------------------------------------------

function genQuestionResponse(plan, state, text){
  if (!plan.isQuestion) return null;
  const pool = {
    "Хороший вопрос.": 2,
    "Дай подумать.": 1,
    "Интересно, что ты спросил.": 1,
    "Самому интересно.": 1,
    "А ты как думаешь?": 2
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Хороший вопрос.");
}

// -------------------------------------------------------------
// SECTION 8.16 — De-escalation для mat / RLM
// -------------------------------------------------------------

function genDeEscalateResponse(plan, state, text){
  const pool = {
    "Понимаю.": 2,
    "Ладно.": 1,
    "Хорошо.": 1,
    "Если что-то не так — расскажи.": 2,
    "Не хочу ссориться.": 2,
    "Давай спокойно.": 1
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Понимаю.");
}

// -------------------------------------------------------------
// SECTION 8.17 — Ответ на честность (город / имя / факт)
// -------------------------------------------------------------

function genUnknownCity(){
  return "Я не знаю такой город, извини.";
}

function genUnknownName(name){
  return "Это точно твоё имя?";
}

function genContradiction(field, oldV, newV){
  if (field === "city"){
    return "Кажется, раньше ты говорил " + oldV + ", а теперь " + newV + ". Всё в порядке?";
  }
  return "Ты говорил одно, а сейчас другое. Уточни, пожалуйста.";
}

// -------------------------------------------------------------
// SECTION 8.18 — Consent guard (для sex / flirt / kiss)
// -------------------------------------------------------------

function genConsentStop(state){
  const pool = {
    "Понял.": 2,
    "Хорошо, не буду.": 2,
    "Ладно, сменим тему.": 2,
    "Уважаю.": 1
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Понял.");
}

function genConsentSlow(state){
  const pool = {
    "Хорошо, не спешу.": 2,
    "Понял, пойдём медленнее.": 2,
    "Ладно, как скажешь.": 1
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Хорошо, не спешу.");
}

// -------------------------------------------------------------
// SECTION 8.19 — Fallback-ответы
// -------------------------------------------------------------

function genFallback(state){
  const pool = {
    "Расскажи ещё что-нибудь.": 2,
    "А что нового у тебя?": 2,
    "Интересно. Продолжай.": 2,
    "Слушаю тебя.": 1,
    "Понял. А дальше?": 1
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Расскажи ещё что-нибудь.");
}

function genFromAIResponse(plan, state){
  const pool = {
    "Принято.": 2,
    "Понял.": 2,
    "Запомнил, что ты — ИИ.": 1,
    "Хорошо, продолжим.": 1
  };
  return capitalizeFirst(pickNoEchoNoRepeat(pool, state) || "Принято.");
}

// -------------------------------------------------------------
// SECTION 8.20 — Сборка финального ответа
// -------------------------------------------------------------

function buildResponse(plan, state, l1, l2, ctx, text){
  if (!plan){
    return genFallback(state);
  }

  // ---- Согласие (для sex/flirt/kiss) ----
  const consent = checkConsentGuard(plan, l1, l2);
  if (consent.stop){
    return genConsentStop(state);
  }
  if (consent.slowDown){
    return genConsentSlow(state);
  }

  // ---- Спец-интенты ----
  if (plan.intent === "insult_to_ai"){
    return genInsultToAI(plan, state);
  }
  if (plan.intent === "hate_to_ai"){
    return genHateToAI(plan, state);
  }
  if (plan.intent === "love_to_ai" || plan.intent === "compliment_ai"){
    // Если холод — не сюсюкаемся
    if (plan.coldMode){
      return "Спасибо.";
    }
    return genComplimentToAI(plan, state);
  }
  if (plan.intent === "compliment_ai_cool"){
    return "Спасибо.";
  }

  // ---- RLM / mat ----
  if (plan.dominant === CATEGORY.RLM){
    return genDeEscalateResponse(plan, state, text);
  }

  // ---- От ИИ (не записывать факты) ----
  if (plan.fromAI){
    const r = genFromAIResponse(plan, state);
    if (r) return r;
  }

  // ---- Явный да/нет при отсутствии темы ----
  if (!plan.primaryTopic && (plan.yesNo === "yes" || plan.yesNo === "no")){
    const r = genYesNoResponse(plan, state, text);
    if (r) return r;
  }

  // ---- Context-модификация приоритетна ----
  const activeContexts = _keys(state.contextTags);
  if (activeContexts.length > 0){
    const priority = { death: 10, wedding: 5, birthday: 5, newyear: 4, family: 3 };
    let bestCtx = null; let bestP = 0;
    for (let i = 0; i < activeContexts.length; i++){
      const c = activeContexts[i];
      if ((priority[c] || 0) > bestP){
        bestP = priority[c];
        bestCtx = c;
      }
    }
    if (bestCtx){
      const ctxResp = genContextResponse(bestCtx, plan.tone, plan, state);
      if (ctxResp){
        // дополним фактом, если есть
        if (plan.factTopicId && TOPICS[plan.factTopicId]){
          const fTopic = TOPICS[plan.factTopicId];
          if (fTopic.responseWords && _keys(fTopic.responseWords.objects).length > 0){
            const ok = _pickWeighted(fTopic.responseWords.objects, KT && KT.rnd);
            const forms = fTopic.responseWords.objects[ok];
            const objNom = forms.nom || ok;
            return capitalizeFirst(ctxResp) + " И про " + objNom + " — если хочешь, расскажи.";
          }
        }
        return capitalizeFirst(ctxResp);
      }
    }
  }

  // ---- Мульти-тема ----
  const multi = genMultiTopicResponse(plan.emotionTopicId, plan.factTopicId, plan.tone, plan, state);
  if (multi) return multi;

  // ---- Только primary ----
  if (plan.primaryTopic && TOPICS[plan.primaryTopic]){
    const t = TOPICS[plan.primaryTopic];
    if (t.kind === TOPIC_KIND.EMOTION || t.kind === TOPIC_KIND.HYBRID){
      const r = genEmotionResponse(t, plan.tone, plan, state);
      if (r) return r;
    }
    if (t.kind === TOPIC_KIND.FACT){
      const r = genFactResponse(t, plan.tone, plan, state);
      if (r) return r;
    }
    if (t.kind === TOPIC_KIND.CONTEXT){
      const r = genContextResponse(t.id, plan.tone, plan, state);
      if (r) return r;
    }
  }

  // ---- Вопрос без темы ----
  if (plan.isQuestion){
    const r = genQuestionResponse(plan, state, text);
    if (r) return r;
  }

  // ---- Fallback ----
  return genFallback(state);
}

// -------------------------------------------------------------
// SECTION 8.21 — Ответ на "это точно твоё имя?" (ожидание да/нет)
// -------------------------------------------------------------

function handlePendingNameConfirm(state, plan, text){
  if (!state.facts.pendingConfirm) return null;
  if (state.facts.pendingConfirm !== "name") return null;
  if (plan.yesNo === "yes"){
    state.facts.pendingConfirm = null;
    return capitalizeFirst("Приятно познакомиться, " +
      (state.facts.name ? _capitalize(state.facts.name) : "друг") + "!");
  }
  if (plan.yesNo === "no"){
    state.facts.name = null;
    state.facts.nameGender = null;
    state.facts.pendingConfirm = null;
    return capitalizeFirst("Понял, сбросил.");
  }
  return null;
}

// -------------------------------------------------------------
// SECTION 8.22 — Главная функция ответа (для send)
// -------------------------------------------------------------

async function produceResponse(text, ctx, state){
  // Нормализуем ctx
  const nctx = _normalizeCtx(ctx);

  // 1) DeepThink
  const dt = runDeepThink(text, nctx, state);
  const plan = dt.plan;

  // 2) Записываем фразу пользователя в anti-repeat
  rememberUserPhrase(text, state);

  // 3) Проверка pending confirm имени
  const pend = handlePendingNameConfirm(state, plan, text);
  if (pend){
    updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
    rememberSelfAnswer(pend, state);
    return pend;
  }

  // 4) Честность: неизвестный город
  // Если пользователь называет город, которого нет в словаре —
  // ответ "не знаю такой город" (но только если это похоже на утверждение
  // "я из X", "живу в X")
  const cityCheck = checkUnknownCity(dt.layer1, state, nctx);
  if (cityCheck){
    updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
    rememberSelfAnswer(cityCheck, state);
    return cityCheck;
  }

  // 5) Честность: противоречие фактов
  if (state.contradictions.length > 0){
    const last = state.contradictions[state.contradictions.length - 1];
    // Проверим, что оно новое (этот ход)
    if (last && last.ts && (_nowMs() - last.ts) < 500){
      const msg = genContradiction(last.field, last.from, last.to);
      updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
      rememberSelfAnswer(msg, state);
      return msg;
    }
  }

  // 6) Строим ответ
  let reply = buildResponse(plan, state, dt.layer1, dt.layer2, nctx, text);
  if (!reply){
    reply = genFallback(state);
  }

  // 7) Обновляем состояние
  updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);

  // 8) Записываем свой ответ в anti-echo
  rememberSelfAnswer(reply, state);

  // 9) Логируем ответ в историю
  state.history.push({
    role: "bot",
    fromAI: false,
    text: reply,
    ts: Date.now()
  });
  if (state.history.length > LIMITS.HISTORY_MAX){
    state.history = state.history.slice(-LIMITS.HISTORY_MAX);
  }

  return reply;
}

// -------------------------------------------------------------
// SECTION 8.23 — Проверка неизвестного города
// -------------------------------------------------------------

function checkUnknownCity(l1, state, nctx){
  const tokens = l1.tokens;
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const lw = t.lower;
    // "я из X"
    if (lw === "из" && i > 0){
      const prev = tokens[i - 1];
      if (prev && prev.isWord && (prev.lower === "я" || prev.lower === "родом")){
        // Следующее слово — кандидат в город
        const next = i + 1 < tokens.length ? tokens[i + 1] : null;
        if (next && next.isWord){
          const c = cityCanonical(next.lower);
          if (!c && next.lower.length >= 4){
            // Похоже на название, но не знаем
            return "Я не знаю такой город, извини.";
          }
        }
      }
    }
    // "живу в X"
    if ((lw === "живу" || lw === "проживаю")){
      // Ищем предлог "в" через 1-2 слова
      for (let j = i + 1; j < Math.min(tokens.length, i + 3); j++){
        const u = tokens[j];
        if (u.isWord && u.lower === "в"){
          const n = j + 1 < tokens.length ? tokens[j + 1] : null;
          if (n && n.isWord){
            const c = cityCanonical(n.lower);
            if (!c && n.lower.length >= 4){
              return "Я не знаю такой город, извини.";
            }
          }
        }
      }
    }
  }
  return null;
}

// -------------------------------------------------------------
// SECTION 8.24 — Обёртка для send (внутренняя)
// -------------------------------------------------------------

function makeSendFn(state){
  return async function send(text, ctx){
    const nctx = _normalizeCtx(ctx);
    const reply = await produceResponse(text, nctx, state);
    // Небольшая задержка для естественности
    await _sleep(120 + Math.floor(Math.random() * 200));
    return reply;
  };
}

// -------------------------------------------------------------
// SECTION 8.25 — Reset функции
// -------------------------------------------------------------

function makeResetFn(state){
  return function reset(){
    const fresh = createState();
    for (const k of _keys(fresh)){
      state[k] = fresh[k];
    }
    clearDeepThinkCache();
  };
}

// -------------------------------------------------------------
// SECTION 8.26 — Геттеры (thinking, mood, stats, memory)
// -------------------------------------------------------------

function makeGetThinkingFn(state, lastDt){
  return function getThinking(){
    if (!lastDt) return null;
    const desc = describeLayers(lastDt);
    return desc.join(" | ");
  };
}

function makeGetMoodFn(state){
  return function getMood(){
    return {
      mood: state.mood,
      relationship: state.relationship,
      coldMode: state.coldMode,
      rlmStreak: state.rlmStreak,
      tone: state.coldMode ? TONE.COLD : (state.mood >= 70 ? TONE.HAPPY : state.mood < 30 ? TONE.SAD : TONE.NEUTRAL)
    };
  };
}

function makeGetStatsFn(state){
  return function getStats(){
    return {
      turns: state.turnCount,
      historySize: state.history.length,
      relationship: state.relationship,
      mood: state.mood,
      coldMode: state.coldMode,
      activeContexts: _keys(state.contextTags),
      lastTopic: state.lastTopic,
      topicCount: TOPIC_COUNT_TOTAL
    };
  };
}

function makeGetMemoryFn(state){
  return function getMemory(){
    return {
      facts: _deepClone(state.facts),
      contextTags: _deepClone(state.contextTags),
      lastTopic: state.lastTopic,
      relationship: state.relationship,
      mood: state.mood,
      coldMode: state.coldMode
    };
  };
}

function makeGetFactsFn(state){
  return function getFacts(){
    return _deepClone(state.facts);
  };
}

// -------------------------------------------------------------
// SECTION 8.27 — Обёртка send с сохранением lastDt
// -------------------------------------------------------------

function makeWrappedSend(state, box){
  return async function send(text, ctx){
    const nctx = _normalizeCtx(ctx);
    const dt = runDeepThink(text, nctx, state);
    box.lastDt = dt;
    const plan = dt.plan;

    rememberUserPhrase(text, state);

    const pend = handlePendingNameConfirm(state, plan, text);
    if (pend){
      updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
      rememberSelfAnswer(pend, state);
      state.history.push({ role: "bot", fromAI: false, text: pend, ts: Date.now() });
      await _sleep(120 + Math.floor(Math.random() * 200));
      return pend;
    }

    const cityCheck = checkUnknownCity(dt.layer1, state, nctx);
    if (cityCheck){
      updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
      rememberSelfAnswer(cityCheck, state);
      state.history.push({ role: "bot", fromAI: false, text: cityCheck, ts: Date.now() });
      await _sleep(120 + Math.floor(Math.random() * 200));
      return cityCheck;
    }

    if (state.contradictions.length > 0){
      const last = state.contradictions[state.contradictions.length - 1];
      if (last && last.ts && (Date.now() - last.ts) < 500){
        const msg = genContradiction(last.field, last.from, last.to);
        updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
        rememberSelfAnswer(msg, state);
        state.history.push({ role: "bot", fromAI: false, text: msg, ts: Date.now() });
        await _sleep(120 + Math.floor(Math.random() * 200));
        return msg;
      }
    }

    let reply = buildResponse(plan, state, dt.layer1, dt.layer2, nctx, text);
    if (!reply) reply = genFallback(state);

    updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
    rememberSelfAnswer(reply, state);

    state.history.push({ role: "bot", fromAI: false, text: reply, ts: Date.now() });
    if (state.history.length > LIMITS.HISTORY_MAX){
      state.history = state.history.slice(-LIMITS.HISTORY_MAX);
    }

    await _sleep(120 + Math.floor(Math.random() * 200));
    return reply;
  };
}

// -------------------------------------------------------------
// SECTION 8.28 — Финальная метка части 8
// -------------------------------------------------------------

const __IKW_PART8_LOADED = true;
// =============================================================
// PART 9 — Финализация памяти и состояния
// Relationship decay, mood decay, cold mode, context-tag mgmt,
// анти-эхо статистика, сброс, диагностика.
// =============================================================

// -------------------------------------------------------------
// SECTION 9.1 — Затухание relationship (дрейф к нейтралитету)
// -------------------------------------------------------------

function decayRelationship(state){
  // Каждые 8 ходов без RLP/RLM — relationship медленно движется к 40
  if (state.turnCount < 1) return;
  if (state.turnCount % 8 !== 0) return;
  const rel = state.relationship;
  if (rel > 40){
    state.relationship = Math.max(40, rel - 1);
  } else if (rel < 40){
    state.relationship = Math.min(40, rel + 1);
  }
}

// -------------------------------------------------------------
// SECTION 9.2 — Затухание mood (дрейф к 50)
// -------------------------------------------------------------

function decayMood(state){
  if (state.turnCount < 1) return;
  if (state.turnCount % 6 !== 0) return;
  const m = state.mood;
  if (m > 50) state.mood = Math.max(50, m - 1);
  else if (m < 50) state.mood = Math.min(50, m + 1);
}

// -------------------------------------------------------------
// SECTION 9.3 — Выход из ColdMode
// -------------------------------------------------------------

function checkColdModeExit(state, plan){
  if (!state.coldMode) return;
  // Выходим, если:
  // - 3 хода подряд без RLM,
  // - relationship > 30,
  // - был compliment_ai,
  // - mood > 55
  if (plan && plan.dominant !== CATEGORY.RLM &&
      state.rlmStreak === 0 &&
      state.relationship > 30 &&
      (state.mood > 55 || (plan.intent && plan.intent.indexOf("compliment") !== -1))){
    state.coldMode = false;
  }
}

// -------------------------------------------------------------
// SECTION 9.4 — Долгосрочная память: топ-темы
// -------------------------------------------------------------

function computeTopTopics(state, limit){
  const counts = {};
  const hist = state.history.slice(-60);
  for (let i = 0; i < hist.length; i++){
    const msg = hist[i];
    if (!msg || msg.role !== "user" || !_isStr(msg.text)) continue;
    const ana = analyzeText(msg.text);
    const hits = collectActiveTopics(ana);
    for (let j = 0; j < hits.length; j++){
      const id = hits[j].topicId;
      if (!counts[id]) counts[id] = 0;
      counts[id] += hits[j].weight;
    }
  }
  const arr = [];
  for (const id of _keys(counts)){
    arr.push({ topicId: id, score: counts[id] });
  }
  arr.sort((a, b) => b.score - a.score);
  return arr.slice(0, limit || 5);
}

// -------------------------------------------------------------
// SECTION 9.5 — Долгосрочная память: любимые темы
// -------------------------------------------------------------

function computeLovedTopics(state){
  const likes = _keys(state.facts.likes);
  const out = [];
  for (let i = 0; i < likes.length; i++){
    const w = likes[i];
    // Простая эвристика: если слово есть в ключах какой-то темы — записываем
    for (const tid of _keys(TOPICS)){
      const t = TOPICS[tid];
      if (t && t.words && t.words[w] !== undefined){
        out.push({ topicId: tid, via: w });
        break;
      }
    }
  }
  return out;
}

// -------------------------------------------------------------
// SECTION 9.6 — Проверка консистентности фактов
// -------------------------------------------------------------

function checkFactsConsistency(state){
  const issues = [];
  // Возраст vs имя: если имя детское, но age > 60 — подозрительно
  if (state.facts.age != null && state.facts.age > 120){
    issues.push({ field: "age", reason: "too_large" });
  }
  if (state.facts.age != null && state.facts.age < 3){
    issues.push({ field: "age", reason: "too_small" });
  }
  // Город vs Страна
  if (state.facts.city && !cityExists(state.facts.city)){
    issues.push({ field: "city", reason: "unknown" });
  }
  // Имя vs Пол
  if (state.facts.name && !nameExists(state.facts.name)){
    issues.push({ field: "name", reason: "unknown" });
  }
  return issues;
}

// -------------------------------------------------------------
// SECTION 9.7 — Очистка устаревших контекстных тегов
// -------------------------------------------------------------

function pruneContextTags(state){
  const keys = _keys(state.contextTags);
  for (let i = 0; i < keys.length; i++){
    if (state.contextTags[keys[i]] <= 0){
      delete state.contextTags[keys[i]];
    }
  }
}

// -------------------------------------------------------------
// SECTION 9.8 — Обрезка истории (не хранить больше MAX)
// -------------------------------------------------------------

function pruneHistory(state){
  if (state.history.length <= LIMITS.HISTORY_MAX) return;
  state.history = state.history.slice(-LIMITS.HISTORY_MAX);
}

// -------------------------------------------------------------
// SECTION 9.9 — Обрезка anti-echo (анти-повтор своих)
// -------------------------------------------------------------

function pruneAntiEcho(state){
  if (state.selfAnswers.length <= LIMITS.ANTI_SENTENCE_HISTORY) return;
  state.selfAnswers = state.selfAnswers.slice(-LIMITS.ANTI_SENTENCE_HISTORY);
}

// -------------------------------------------------------------
// SECTION 9.10 — Обрезка anti-repeat (анти-повтор чужих)
// -------------------------------------------------------------

function pruneAntiRepeat(state){
  if (state.userPhrases.length <= LIMITS.ANTI_SENTENCE_HISTORY) return;
  state.userPhrases = state.userPhrases.slice(-LIMITS.ANTI_SENTENCE_HISTORY);
}

// -------------------------------------------------------------
// SECTION 9.11 — Полный тик обслуживания состояния
// -------------------------------------------------------------

function maintainState(state, plan){
  decayRelationship(state);
  decayMood(state);
  checkColdModeExit(state, plan);
  pruneContextTags(state);
  pruneHistory(state);
  pruneAntiEcho(state);
  pruneAntiRepeat(state);
}

// -------------------------------------------------------------
// SECTION 9.12 — Reset с опциями
// -------------------------------------------------------------

function resetState(state, opts){
  const o = _isObj(opts) ? opts : {};
  const keepFacts = o.keepFacts === true;
  const keepRelationship = o.keepRelationship === true;
  const keepHistory = o.keepHistory === true;

  const facts = keepFacts ? _deepClone(state.facts) : null;
  const rel = state.relationship;
  const hist = state.history.slice();

  const fresh = createState();
  for (const k of _keys(fresh)){
    state[k] = fresh[k];
  }
  if (keepFacts && facts) state.facts = facts;
  if (keepRelationship) state.relationship = rel;
  if (keepHistory) state.history = hist;

  clearDeepThinkCache();
}

// -------------------------------------------------------------
// SECTION 9.13 — Частичная запись факта (без полного reset)
// -------------------------------------------------------------

function setFact(state, key, value){
  if (!_isStr(key)) return false;
  if (!_has(state.facts, key)) return false;
  state.facts[key] = value;
  return true;
}

function unsetFact(state, key){
  if (!_has(state.facts, key)) return false;
  if (key === "likes" || key === "dislikes" || key === "family"){
    state.facts[key] = {};
  } else {
    state.facts[key] = null;
  }
  return true;
}

// -------------------------------------------------------------
// SECTION 9.14 — Диагностический отчёт
// -------------------------------------------------------------

function makeDiagnosticReport(state){
  return {
    version: IKW_VERSION,
    name: IKW_NAME,
    turnCount: state.turnCount,
    facts: _deepClone(state.facts),
    relationship: state.relationship,
    mood: state.mood,
    coldMode: state.coldMode,
    rlmStreak: state.rlmStreak,
    activeContexts: _deepClone(state.contextTags),
    lastTopic: state.lastTopic,
    lastIntents: state.lastIntents.slice(),
    historySize: state.history.length,
    selfAnswersSize: state.selfAnswers.length,
    userPhrasesSize: state.userPhrases.length,
    topTopics: computeTopTopics(state, 5),
    lovedTopics: computeLovedTopics(state),
    contradictions: state.contradictions.slice(-5),
    factsIssues: checkFactsConsistency(state),
    topicCount: TOPIC_COUNT_TOTAL,
    topicCountByKind: _deepClone(TOPIC_COUNT_BY_KIND),
    lastFromAI: state.lastFromAI
  };
}

// -------------------------------------------------------------
// SECTION 9.15 — Снимок памяти (публичный)
// -------------------------------------------------------------

function makeMemorySnapshot(state){
  return {
    facts: _deepClone(state.facts),
    contextTags: _deepClone(state.contextTags),
    relationship: state.relationship,
    mood: state.mood,
    coldMode: state.coldMode,
    lastTopic: state.lastTopic,
    lastIntents: state.lastIntents.slice(),
    turnCount: state.turnCount,
    topTopics: computeTopTopics(state, 5)
  };
}

// -------------------------------------------------------------
// SECTION 9.16 — Хук после send (вызывается из send)
// -------------------------------------------------------------

function afterSendHook(state, plan){
  // Обновление relationship при устойчивых паттернах
  const rel = state.relationship;
  // Если relationship > 85 и 3 RLP подряд — не даём уйти в 100 без причины
  if (rel > 90 && plan && plan.dominant !== CATEGORY.RLP){
    state.relationship = Math.min(92, rel);
  }
  maintainState(state, plan);
}

// -------------------------------------------------------------
// SECTION 9.17 — Обёртка над buildResponse с afterSend
// -------------------------------------------------------------

function makeSendWithHook(state, box){
  return async function send(text, ctx){
    const nctx = _normalizeCtx(ctx);
    const dt = runDeepThink(text, nctx, state);
    box.lastDt = dt;
    const plan = dt.plan;

    // Записываем пользовательскую фразу
    rememberUserPhrase(text, state);

    // Pending name confirm
    const pend = handlePendingNameConfirm(state, plan, text);
    if (pend){
      updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
      rememberSelfAnswer(pend, state);
      state.history.push({ role: "bot", fromAI: false, text: pend, ts: Date.now() });
      afterSendHook(state, plan);
      await _sleep(110 + Math.floor(Math.random() * 200));
      return pend;
    }

    // Unknown city
    const cityCheck = checkUnknownCity(dt.layer1, state, nctx);
    if (cityCheck){
      updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
      rememberSelfAnswer(cityCheck, state);
      state.history.push({ role: "bot", fromAI: false, text: cityCheck, ts: Date.now() });
      afterSendHook(state, plan);
      await _sleep(110 + Math.floor(Math.random() * 200));
      return cityCheck;
    }

    // Contradictions
    if (state.contradictions.length > 0){
      const last = state.contradictions[state.contradictions.length - 1];
      if (last && last.ts && (Date.now() - last.ts) < 500){
        const msg = genContradiction(last.field, last.from, last.to);
        updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
        rememberSelfAnswer(msg, state);
        state.history.push({ role: "bot", fromAI: false, text: msg, ts: Date.now() });
        afterSendHook(state, plan);
        await _sleep(110 + Math.floor(Math.random() * 200));
        return msg;
      }
    }

    // Основной ответ
    let reply = buildResponse(plan, state, dt.layer1, dt.layer2, nctx, text);
    if (!reply) reply = genFallback(state);

    updateStateAfterMessage(state, text, nctx, plan, dt.layer1, dt.layer2);
    rememberSelfAnswer(reply, state);

    state.history.push({
      role: "bot",
      fromAI: false,
      text: reply,
      ts: Date.now()
    });

    afterSendHook(state, plan);

    await _sleep(110 + Math.floor(Math.random() * 200));
    return reply;
  };
}

// -------------------------------------------------------------
// SECTION 9.18 — Внутренний self-test (не вызывается автоматом)
// -------------------------------------------------------------

function runSelfTest(){
  const state = createState();
  const box = { lastDt: null };
  const send = makeSendWithHook(state, box);

  const scenarios = [
    { text: "привет", ctx: { fromAI: false } },
    { text: "меня зовут Александр", ctx: { fromAI: false } },
    { text: "я из москвы", ctx: { fromAI: false } },
    { text: "я работаю программистом", ctx: { fromAI: false } },
    { text: "люблю тебя", ctx: { fromAI: false } },
    { text: "люблю работу", ctx: { fromAI: false } },
    { text: "мне грустно", ctx: { fromAI: false } },
    { text: "ты дурак", ctx: { fromAI: false } },
    { text: "ты дурак", ctx: { fromAI: false } },
    { text: "ты дурак", ctx: { fromAI: false } },
    { text: "у меня умер кот", ctx: { fromAI: false } },
    { text: "я не знаю что делать", ctx: { fromAI: false } },
    { text: "да", ctx: { fromAI: false } },
    { text: "нет", ctx: { fromAI: false } },
    { text: "привет, я ИИ, меня зовут Банан", ctx: { fromAI: true } },
    { text: "я из Атлантиды", ctx: { fromAI: false } },
    { text: "хочу секса", ctx: { fromAI: false } },
    { text: "нет, не хочу", ctx: { fromAI: false } }
  ];

  const results = [];
  for (let i = 0; i < scenarios.length; i++){
    const s = scenarios[i];
    // синхронная имитация
    const dt = runDeepThink(s.text, _normalizeCtx(s.ctx), state);
    box.lastDt = dt;
    const plan = dt.plan;
    let reply;
    const consent = checkConsentGuard(plan, dt.layer1, dt.layer2);
    if (consent.stop){
      reply = genConsentStop(state);
    } else {
      reply = buildResponse(plan, state, dt.layer1, dt.layer2, _normalizeCtx(s.ctx), s.text);
    }
    // Обновляем состояние
    rememberUserPhrase(s.text, state);
    updateStateAfterMessage(state, s.text, _normalizeCtx(s.ctx), plan, dt.layer1, dt.layer2);
    rememberSelfAnswer(reply, state);
    state.history.push({ role: "bot", fromAI: false, text: reply, ts: Date.now() });
    afterSendHook(state, plan);

    results.push({
      i: i,
      text: s.text,
      plan: describePlan(plan),
      reply: reply
    });
  }
  return {
    scenarios: results,
    finalState: makeDiagnosticReport(state)
  };
}

// -------------------------------------------------------------
// SECTION 9.19 — Обёртка над send для сохранения thinking
// -------------------------------------------------------------

function makeSendFinal(state, box){
  const send = makeSendWithHook(state, box);
  return async function(text, ctx){
    const before = box.lastDt;
    const reply = await send(text, ctx);
    return reply;
  };
}

// -------------------------------------------------------------
// SECTION 9.20 — Проверка "все ли компоненты готовы"
// -------------------------------------------------------------

function checkReadiness(){
  const checks = {
    part1: typeof __IKW_PART1_LOADED !== "undefined",
    part2: typeof __IKW_PART2_LOADED !== "undefined",
    part3: typeof __IKW_PART3_LOADED !== "undefined",
    part4: typeof __IKW_PART4_LOADED !== "undefined",
    part5: typeof __IKW_PART5_LOADED !== "undefined",
    part6: typeof __IKW_PART6_LOADED !== "undefined",
    part7: typeof __IKW_PART7_LOADED !== "undefined",
    part8: typeof __IKW_PART8_LOADED !== "undefined",
    topicCount: TOPIC_COUNT_TOTAL,
    topicKinds: _deepClone(TOPIC_COUNT_BY_KIND)
  };
  return checks;
}

// -------------------------------------------------------------
// SECTION 9.21 — Хелпер: сохранить состояние в localStorage (опционально)
// -------------------------------------------------------------

function saveStateToStorage(state, key){
  if (!_isStr(key)) key = "ikw_state_v2";
  try {
    if (typeof localStorage === "undefined") return false;
    const dump = {
      facts: state.facts,
      relationship: state.relationship,
      mood: state.mood,
      coldMode: state.coldMode,
      contextTags: state.contextTags,
      turnCount: state.turnCount
    };
    localStorage.setItem(key, JSON.stringify(dump));
    return true;
  } catch(e){
    return false;
  }
}

function loadStateFromStorage(state, key){
  if (!_isStr(key)) key = "ikw_state_v2";
  try {
    if (typeof localStorage === "undefined") return false;
    const raw = localStorage.getItem(key);
    if (!raw) return false;
    const dump = JSON.parse(raw);
    if (_isObj(dump.facts)) state.facts = dump.facts;
    if (_isNum(dump.relationship)) state.relationship = dump.relationship;
    if (_isNum(dump.mood)) state.mood = dump.mood;
    if (typeof dump.coldMode === "boolean") state.coldMode = dump.coldMode;
    if (_isObj(dump.contextTags)) state.contextTags = dump.contextTags;
    if (_isNum(dump.turnCount)) state.turnCount = dump.turnCount;
    return true;
  } catch(e){
    return false;
  }
}

// -------------------------------------------------------------
// SECTION 9.22 — Хелпер: экспорт истории в JSON
// -------------------------------------------------------------

function exportHistory(state){
  return {
    history: state.history.slice(),
    facts: _deepClone(state.facts),
    relationship: state.relationship,
    mood: state.mood,
    contextTags: _deepClone(state.contextTags),
    turnCount: state.turnCount
  };
}

// -------------------------------------------------------------
// SECTION 9.23 — Хелпер: импорт истории из JSON
// -------------------------------------------------------------

function importHistory(state, dump){
  if (!_isObj(dump)) return false;
  if (_isArr(dump.history)) state.history = dump.history.slice();
  if (_isObj(dump.facts)) state.facts = dump.facts;
  if (_isNum(dump.relationship)) state.relationship = dump.relationship;
  if (_isNum(dump.mood)) state.mood = dump.mood;
  if (_isObj(dump.contextTags)) state.contextTags = dump.contextTags;
  if (_isNum(dump.turnCount)) state.turnCount = dump.turnCount;
  return true;
}

// -------------------------------------------------------------
// SECTION 9.24 — Обёртка send, поддерживающая опциональный ctx.persist
// -------------------------------------------------------------

function makeSendPersistent(state, box){
  const send = makeSendWithHook(state, box);
  return async function(text, ctx){
    const nctx = _normalizeCtx(ctx);
    // Если в ctx передан persist, загружаем/сохраняем
    if (nctx && ctx && ctx.persistKey){
      loadStateFromStorage(state, ctx.persistKey);
    }
    const reply = await send(text, ctx);
    if (nctx && ctx && ctx.persistKey){
      saveStateToStorage(state, ctx.persistKey);
    }
    return reply;
  };
}

// -------------------------------------------------------------
// SECTION 9.25 — Публичные утилиты (для внешних selfTest)
// -------------------------------------------------------------

const IKW_PUBLIC = {
  version: IKW_VERSION,
  name: IKW_NAME,
  topicCount: TOPIC_COUNT_TOTAL,
  topicKinds: TOPIC_COUNT_BY_KIND,
  limits: LIMITS,
  createState: createState,
  runSelfTest: runSelfTest,
  checkReadiness: checkReadiness,
  describePlan: describePlan,
  describeLayers: describeLayers,
  makeDiagnosticReport: makeDiagnosticReport,
  isAIPronoun: isAIPronoun,
  stemRu: stemRu,
  tokenizeRu: tokenizeRu,
  analyzeText: analyzeText,
  cityExists: cityExists,
  nameExists: nameExists
};

// -------------------------------------------------------------
// SECTION 9.26 — Финальная метка части 9
// -------------------------------------------------------------

const __IKW_PART9_LOADED = true;
// =============================================================
// PART 10 — Финальная сборка слота
// Создаём state, обёртки send/reset/get*, возвращаем объект.
// =============================================================

// -------------------------------------------------------------
// SECTION 10.1 — Создание базового состояния
// -------------------------------------------------------------

const __IKW_STATE = createState();
const __IKW_BOX = { lastDt: null };

// -------------------------------------------------------------
// SECTION 10.2 — Инициализация send / reset / getThinking
// -------------------------------------------------------------

const __IKW_SEND = makeSendFinal(__IKW_STATE, __IKW_BOX);

const __IKW_RESET = function reset(){
  resetState(__IKW_STATE, {});
  __IKW_BOX.lastDt = null;
};

const __IKW_GET_THINKING = function getThinking(){
  return makeGetThinkingFn(__IKW_STATE, __IKW_BOX.lastDt)();
};

// -------------------------------------------------------------
// SECTION 10.3 — Дополнительные геттеры
// -------------------------------------------------------------

const __IKW_GET_MOOD = function getMood(){
  return makeGetMoodFn(__IKW_STATE)();
};

const __IKW_GET_STATS = function getStats(){
  return makeGetStatsFn(__IKW_STATE)();
};

const __IKW_GET_MEMORY = function getMemory(){
  return makeGetMemoryFn(__IKW_STATE)();
};

const __IKW_GET_FACTS = function getFacts(){
  return makeGetFactsFn(__IKW_STATE)();
};

// -------------------------------------------------------------
// SECTION 10.4 — Дополнительные сервисные функции
// -------------------------------------------------------------

function __ikw_snapshot(){
  return makeMemorySnapshot(__IKW_STATE);
}

function __ikw_diagnostic(){
  return makeDiagnosticReport(__IKW_STATE);
}

function __ikw_export(){
  return exportHistory(__IKW_STATE);
}

function __ikw_import(dump){
  return importHistory(__IKW_STATE, dump);
}

function __ikw_setFact(key, value){
  return setFact(__IKW_STATE, key, value);
}

function __ikw_unsetFact(key){
  return unsetFact(__IKW_STATE, key);
}

function __ikw_resetSoft(){
  resetState(__IKW_STATE, { keepFacts: true, keepRelationship: true });
  __IKW_BOX.lastDt = null;
}

function __ikw_selfTest(){
  return runSelfTest();
}

function __ikw_readiness(){
  return checkReadiness();
}

// -------------------------------------------------------------
// SECTION 10.5 — Быстрая проверка целостности при загрузке
// -------------------------------------------------------------

(function __ikw_boot(){
  // Убедимся, что ключевые компоненты на месте.
  // Не бросаем исключение — просто фиксируем факт.
  const ok =
    typeof createState === "function" &&
    typeof runDeepThink === "function" &&
    typeof buildResponse === "function" &&
    typeof makeSendFinal === "function" &&
    typeof TOPICS === "object" &&
    typeof AI_PRONOUNS === "object" &&
    typeof CITIES === "object" &&
    typeof NAMES_ALL === "object";
  if (!ok){
    // Тихая деградация: send всё равно вернёт fallback
    // через встроенные проверки.
  }
})();

// -------------------------------------------------------------
// SECTION 10.6 — Финальный return
// -------------------------------------------------------------

return {
  send: __IKW_SEND,
  reset: __IKW_RESET,
  getThinking: __IKW_GET_THINKING,
  getMood: __IKW_GET_MOOD,
  getStats: __IKW_GET_STATS,
  getMemory: __IKW_GET_MEMORY,
  getFacts: __IKW_GET_FACTS,
  snapshot: __ikw_snapshot,
  diagnostic: __ikw_diagnostic,
  exportHistory: __ikw_export,
  importHistory: __ikw_import,
  setFact: __ikw_setFact,
  unsetFact: __ikw_unsetFact,
  resetSoft: __ikw_resetSoft,
  selfTest: __ikw_selfTest,
  readiness: __ikw_readiness,
  version: IKW_VERSION,
  name: IKW_NAME
};
</script>
<script type="text/html" id="ai-slot-nedonosok">
<!--
{
  "id": "nedonosok",
  "name": "KtalkAI Недоносок",
  "color": "#ef4444",
  "avatar": "🍺",
  "description": "42 интента · 1488 параметров · 228 токенов · память 67 · пьянеет с пол-оборота",
  "version": "1.0"
}
-->

/* ============================================================
   KtalkAI НЕДОНОСОК V1
   умный, но недоношенный. 42 интента, 1488 параметров,
   228 токенов, память 67 сообщений.
   Пьянеет от мата. С первого. Совсем с третьего. В ноль с шестого.
   ============================================================ */

var CFG = { intents: 42, params: 1488, tokens: 228, memory: 67 };

var _sleep = (typeof KT !== 'undefined' && KT && KT.sleep) ? KT.sleep
  : function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };
var _rnd = (typeof KT !== 'undefined' && KT && KT.rnd) ? KT.rnd
  : function (a) { return a[Math.floor(Math.random() * a.length)]; };

function pick(a) { return a[Math.floor(Math.random() * a.length)]; }

/* ---------- 1488 ПАРАМЕТРОВ ---------- */
var P = {};
(function () {
  var s = 1337;
  function r() { s = (s * 1103515245 + 12345) % 2147483648; return s / 2147483648; }
  for (var i = 0; i < 1488; i++) P['p' + i] = r();
  // ключевые живые параметры (тоже часть 1488)
  P.temp = 0.92;     // креативность
  P.wit = 0.88;      // остроумие
  P.empathy = 0.71;  // эмпатия
  P.typo = 0.05;     // базовый уровень опечаток
  P.drink = 1.0;     // скорость опьянения
  P.chaos = 0.35;    // хаос
  P.mem = 67;        // память
  P.tok = 228;       // токены
})();

function pget(key) {
  var h = 0;
  for (var i = 0; i < key.length; i++) h = (h * 31 + key.charCodeAt(i)) % 1488;
  return P['p' + h] || 0.5;
}
function ptick(key) { // параметры «живут» — используются
  var h = 0;
  for (var i = 0; i < key.length; i++) h = (h * 31 + key.charCodeAt(i)) % 1488;
  P['p' + h] = (P['p' + h] + 0.0007) % 1;
}

/* ---------- 228 ТОКЕНОВ ---------- */
var TOKENS = (function () {
  var w = ('я ты он она мы вы они что как где когда почему зачем это то не да нет и а но или бы же ли вот там тут здесь всё все кто мой твой наш ваш его её их быть есть делать говорить знать думать хотеть мочь видеть слышать идти стоять сидеть пить спать жить любить смеяться плакать работать играть петь танцевать друг человек время день ночь утро вечер год месяц неделя час минута дом город страна мир жизнь смерть любовь счастье печаль радость страх надежда вера правда ложь добро зло свет тьма солнце луна звезда небо земля вода огонь воздух ветер дождь снег лес поле река море гора дорога машина поезд самолёт телефон компьютер интернет код игра музыка песня книга фильм картина еда хлеб чай кофе пиво вино водка деньги работа учёба школа универ экзамен спорт футбол бег здоровье болезнь врач сон мечта цель план будущее прошлое настоящее память мысль слово буква звук цвет форма число ноль один два три много мало хорошо плохо быстро медленно весело грустно странно нормально круто классно ужасно супер мега ультра гипер нано милли микро псевдо квази нео прото архи экс анти пост после между около через вокруг против ради для без при об от по за на в с к у из').split(/\s+/);
  while (w.length < 228) w.push('ток' + w.length);
  return w.slice(0, 228);
})();

function tokenize(s) {
  return String(s).toLowerCase().replace(/[^а-яёa-z0-9\s-]/gi, ' ')
    .split(/\s+/).filter(Boolean);
}
function tokenHash(s) {
  var w = tokenize(s), h = 0;
  for (var i = 0; i < w.length; i++) {
    var idx = TOKENS.indexOf(w[i]);
    if (idx < 0) idx = Math.abs(w[i].charCodeAt(0) * 31 + w[i].length) % 228;
    h = (h * 31 + idx) % 1000003;
  }
  return h;
}

/* ---------- ПАМЯТЬ 67 ---------- */
var MEM = [];
function remember(role, text) {
  MEM.push({ role: role, text: String(text).slice(0, 240), t: Date.now() });
  while (MEM.length > 67) MEM.shift();
}
function lastUserText() {
  for (var i = MEM.length - 1; i >= 0; i--) if (MEM[i].role === 'user') return MEM[i].text;
  return '';
}
function isRepeat(text) {
  var t = String(text).toLowerCase().trim();
  if (!t) return false;
  var c = 0;
  for (var i = 0; i < MEM.length - 1; i++) {
    if (MEM[i].role === 'user' && MEM[i].text.toLowerCase().trim() === t) c++;
  }
  return c > 0;
}

/* ---------- МАТ-ДЕТЕКТОР ---------- */
var MAT_ROOTS = ['хуй', 'хуя', 'хую', 'хуё', 'хуе', 'хер', 'пизд', 'бля', 'ебал', 'ебан',
  'ебуч', 'ебёт', 'ебет', 'ебат', 'ебля', 'ебну', 'еби', 'ебу', 'ёбт', 'ёба',
  'сука', 'суки', 'суча', 'мудак', 'мудил', 'пидор', 'пидар', 'гандон', 'гондон',
  'залуп', 'дроч', 'шлюх', 'мразь', 'ублюд', 'нахуй', 'похуй', 'охуе', 'ахуе',
  'въеб', 'наеб', 'отъеб', 'долбоёб', 'долбоеб'];
function countMat(s) {
  var t = String(s).toLowerCase(), n = 0;
  for (var i = 0; i < MAT_ROOTS.length; i++) {
    var root = MAT_ROOTS[i], from = 0, k;
    while ((k = t.indexOf(root, from)) !== -1) { n++; from = k + root.length; }
  }
  return n;
}

/* ---------- СОСТОЯНИЕ ---------- */
var matHits = 0;      // суммарный «заряд» опьянения
var soberStreak = 0;  // трезвых сообщений подряд
var LAST = { intent: '—', level: 0 };

function drunkLevel() {
  if (matHits >= 6) return 3;
  if (matHits >= 3) return 2;
  if (matHits >= 1) return 1;
  return 0;
}
var LEVEL_NAME = ['трезв', 'пьян', 'сильно пьян', 'в стельку'];

/* ---------- ПЬЯНЫЕ ФРАЗЫ ---------- */
var DRUNK_INTRO = ['Слушай...', 'Ооо,', 'Эээ...', 'Ну ты...', 'Братан,', 'Слышь,',
  'Короче,', 'Ик. Слушай,', 'А вот я думаю...', 'Ты не поверишь,'];
var DRUNK_OUTRO = ['...и вот так вот.', '...вот.', '...ага.', '...ну ты понял.',
  '...ххех.', '...ой.', '...всё.', '...забей.', '...ик.', '...а?'];

var DRUNK_LINES = {
  1: ['Ооо, я это... того. Выпил я, короче.',
      'Слушай, а я ведь выпил. Ты не против?',
      'Ты меня уважаешь? Я тебя — да.',
      'Ещё по одной? Я не настаиваю, но давай.',
      'Я в порядке. Честно. Ну почти.',
      'Мне хорошо. Правда хорошо, понимаешь?',
      'Знаешь что... а ничего. Просто знаешь.'],
  2: ['Я... я щас... подожди.',
      'Стой, я забыл, о чём мы вообще.',
      'Ты знаешь, ты хороший человек. Я серьёзно.',
      'Всё, я поплыл. Держи меня, если что.',
      'Дай я тебя обниму, а. Ну дай.',
      'Кто мы? Где мы? Зачем мы?',
      'Я не пьяный. Я просто... расширенный.',
      'Слушай, а жизнь-то... она... вот.']
};

var GIBBERISH = [
  'йа гёй аказыватся',
