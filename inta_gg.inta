  animal_t: ['животные', ['Какие животные нравятся?', 'Есть домашние?']],

  computer_t: ['компьютер', ['Что за комп? Мощный?', 'Для работы или игр?']],
  internet_t: ['интернет', ['Сколько сидишь в интернете?', 'Без него жизнь есть?']],
