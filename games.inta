inta.stg:{namer,icon,background
namer:app.name:["Restaurant Tycoon 2D"],what.name=namer
icon:app.ico:["🍽️"],what.ico=icon
background:app.bg:[#12100e],what.ico.bg=background
}
IL.cfg={scripts:all}
Inta.cfg={pc,tablet,phone}
load.stop_parse.inta

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Restaurant Tycoon 2D</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:#12100e;color:#f5f0e8;user-select:none;-webkit-user-select:none}
#c{display:block;position:fixed;inset:0;touch-action:none}
#hud{position:fixed;top:0;left:0;right:0;padding:8px 10px;display:flex;gap:6px;align-items:center;background:linear-gradient(180deg,rgba(0,0,0,.7),transparent);z-index:10;pointer-events:none;flex-wrap:wrap}
.pill{background:rgba(24,20,16,.9);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:5px 12px;font-size:12.5px;font-weight:700;display:flex;gap:5px;align-items:center;backdrop-filter:blur(6px);pointer-events:auto}
.pill.gold{color:#ffd166}.pill.green{color:#95d5b2}.pill.blue{color:#90e0ef}.pill.pink{color:#ff8fa3}.pill.pur{color:#b8a3ff}
#storage{position:fixed;top:44px;left:8px;right:8px;display:flex;gap:5px;flex-wrap:wrap;z-index:10;pointer-events:none}
.stchip{background:rgba(24,20,16,.92);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:4px 9px;font-size:11.5px;font-weight:700;display:flex;gap:5px;align-items:center;pointer-events:auto}
#btns{position:fixed;bottom:0;left:0;right:0;padding:9px 6px;display:flex;gap:5px;justify-content:center;background:linear-gradient(0deg,rgba(0,0,0,.85),transparent);z-index:10;flex-wrap:wrap}
.btn{background:rgba(24,20,16,.95);border:1px solid rgba(255,255,255,.14);border-radius:11px;padding:9px 13px;color:#f5f0e8;font-size:12px;font-weight:700;cursor:pointer;transition:.15s;display:flex;gap:5px;align-items:center;font-family:inherit}
.btn:hover{background:rgba(60,50,40,.95);border-color:rgba(255,209,102,.4)}
.btn:active{transform:scale(.95)}
.btn.pri{background:linear-gradient(135deg,#e85a3a,#a03a20);border-color:transparent;color:#fff}
.btn.grn{background:linear-gradient(135deg,#52b788,#2d6a4f);border-color:transparent;color:#fff}
.btn.gld{background:linear-gradient(135deg,#f0b040,#a07020);border-color:transparent;color:#fff}
.btn.pur{background:linear-gradient(135deg,#7c5cff,#4a2ecc);border-color:transparent;color:#fff}
.btn.act{background:linear-gradient(135deg,#ff0066,#c90050);border-color:transparent;color:#fff;box-shadow:0 0 12px rgba(255,0,102,.5)}
#panel{position:fixed;top:50px;bottom:64px;left:8px;right:8px;max-width:640px;margin:0 auto;background:rgba(20,16,12,.98);border:1px solid rgba(255,255,255,.14);border-radius:16px;display:none;flex-direction:column;z-index:20;overflow:hidden}
#panel.on{display:flex}
.ph{padding:13px 18px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center}
.ph h2{font-size:16px}
.ph .x{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.08);border:0;color:#fff;font-size:15px;cursor:pointer}
.pb{flex:1;overflow-y:auto;padding:12px}
.pb::-webkit-scrollbar{width:6px}.pb::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:3px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:9px}
.card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:11px;cursor:pointer;transition:.15s;display:flex;flex-direction:column;gap:5px}
.card:hover{background:rgba(255,255,255,.08);border-color:rgba(255,209,102,.4)}
.card.dis{opacity:.4;cursor:not-allowed}
.card .emoji{font-size:26px;line-height:1}
.card .nm{font-size:12.5px;font-weight:700}
.card .cost{font-size:11.5px;color:#ffd166;font-weight:700}
.card .sub{font-size:10.5px;opacity:.55}
#toast{position:fixed;top:80px;left:50%;transform:translateX(-50%);background:rgba(20,16,12,.96);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:10px 16px;font-size:12.5px;font-weight:700;z-index:100;opacity:0;transition:.3s;pointer-events:none;max-width:90%;text-align:center}
#toast.on{opacity:1}
#hint{position:fixed;top:76px;left:50%;transform:translateX(-50%);background:rgba(232,90,58,.95);padding:7px 14px;border-radius:20px;font-size:11.5px;font-weight:700;z-index:15;display:none}
#hint.on{display:block}
#tip{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);font-size:11px;opacity:.4;z-index:5;text-align:center;pointer-events:none}
@media(max-width:520px){.grid{grid-template-columns:repeat(auto-fill,minmax(110px,1fr))}.btn{padding:8px 10px;font-size:11px}.pill{padding:4px 9px;font-size:11px}}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="hud">
  <div class="pill gold" id="pMoney">💰 0</div>
  <div class="pill green" id="pRep">⭐ 100</div>
  <div class="pill blue" id="pCust">👥 0</div>
  <div class="pill pink" id="pDay">📅 День 1</div>
  <div class="pill pur" id="pStaff">👨‍🍳 0 · 🤵 0</div>
</div>
<div id="storage"></div>
<div id="hint">Выбери клетку на полу · тап</div>
<div id="btns">
  <button class="btn pri" id="bShop">🛒 Магазин</button>
  <button class="btn grn" id="bMenu">📖 Меню</button>
  <button class="btn gld" id="bStaff">👨‍🍳 Персонал</button>
  <button class="btn pur" id="bUpg">⬆️ Улучш.</button>
  <button class="btn" id="bFloor">🏢 Этаж 1</button>
  <button class="btn" id="bCreator">🎨</button>
  <button class="btn" id="bHelp">❓</button>
</div>
<div id="panel"><div class="ph"><h2 id="ptit">Панель</h2><button class="x" id="px">✕</button></div><div class="pb" id="pb"></div></div>
<div id="toast"></div>
<div id="tip">Тап по плите/гостю · Драг — камера · Пинч — зум · Двойной тап по мебели — убрать</div>

<script>
(function(){
"use strict";
var $=function(i){return document.getElementById(i)};
function clamp(v,a,b){return Math.max(a,Math.min(b,v))}
function rnd(a,b){return a+Math.random()*(b-a)}

var MEM={};
var St={
  get:function(k){try{return localStorage.getItem(k)}catch(e){return MEM[k]||null}},
  set:function(k,v){try{localStorage.setItem(k,v)}catch(e){MEM[k]=String(v)}}
};
var SAVE_KEY='wmos:rt2d:v3';

var DISHES=[
{id:'coffee',name:'Кофе',emoji:'☕',price:200,time:2.5,cost:30},
{id:'water',name:'Вода',emoji:'💧',price:150,time:1.5,cost:15},
{id:'tea',name:'Чай',emoji:'🍵',price:180,time:2,cost:25},
{id:'burger',name:'Бургер',emoji:'🍔',price:600,time:5,cost:100},
{id:'salad',name:'Салат',emoji:'🥗',price:450,time:3.5,cost:80},
{id:'pizza',name:'Пицца',emoji:'🍕',price:1000,time:7,cost:200},
{id:'pasta',name:'Паста',emoji:'🍝',price:800,time:6,cost:150},
{id:'soup',name:'Суп',emoji:'🍲',price:550,time:5,cost:100},
{id:'steak',name:'Стейк',emoji:'🥩',price:1400,time:9,cost:300},
{id:'fish',name:'Рыба',emoji:'🐟',price:1200,time:8,cost:250},
{id:'sushi',name:'Суши',emoji:'🍣',price:1500,time:7,cost:350},
{id:'taco',name:'Тако',emoji:'🌮',price:700,time:4.5,cost:130},
{id:'sandwich',name:'Сэндвич',emoji:'🥪',price:500,time:3.5,cost:90},
{id:'ice',name:'Мороженое',emoji:'🍦',price:400,time:2.5,cost:70},
{id:'cake',name:'Торт',emoji:'🍰',price:650,time:3.5,cost:120},
{id:'fries',name:'Картофель',emoji:'🍟',price:350,time:2.5,cost:60},
{id:'hotdog',name:'Хот-дог',emoji:'🌭',price:450,time:3.5,cost:80},
{id:'wings',name:'Крылья',emoji:'🍗',price:850,time:5,cost:170},
{id:'ramen',name:'Рамен',emoji:'🍜',price:1100,time:7,cost:220},
{id:'donut',name:'Пончик',emoji:'🍩',price:300,time:2,cost:50},
{id:'boba',name:'Бабл-ти',emoji:'🧋',price:550,time:3.5,cost:110},
{id:'juice',name:'Сок',emoji:'🧃',price:330,time:1.5,cost:60},
{id:'pancake',name:'Панкейки',emoji:'🥞',price:600,time:5,cost:110},
{id:'croissant',name:'Круассан',emoji:'🥐',price:400,time:2.5,cost:70},
{id:'pie',name:'Пирог',emoji:'🥧',price:750,time:5,cost:140}
];
var DM={};DISHES.forEach(function(d){DM[d.id]=d});

var ITEMS={
  table2:{name:'Стол на 2',emoji:'🪑',cost:800,seats:2,color:'#8b5a3a'},
  table4:{name:'Стол на 4',emoji:'🍽️',cost:1600,seats:4,color:'#8b5a3a'},
  table6:{name:'Стол на 6',emoji:'🎉',cost:3000,seats:6,color:'#8b5a3a'},
  stove:{name:'Плита',emoji:'🔥',cost:3000,block:true,color:'#555a63',cooks:3},
  counter:{name:'Раздача',emoji:'🧑‍🍳',cost:1200,block:true,color:'#9aa0a8'},
  register:{name:'Касса',emoji:'💰',cost:2000,block:true,color:'#9aa0a8'},
  plant:{name:'Растение',emoji:'🌿',cost:400,block:true,color:'#2d6a4f'},
  painting:{name:'Картина',emoji:'🖼️',cost:900,block:true,color:'#3a86ff'},
  sofa:{name:'Диван',emoji:'🛋️',cost:1500,block:true,color:'#a03a5a'},
  rug:{name:'Ковёр',emoji:'🟥',cost:700,block:false,color:'#8b1538'},
  fireplace:{name:'Камин',emoji:'🔥',cost:2500,block:true,color:'#6a2a10'},
  fountain:{name:'Фонтан',emoji:'⛲',cost:4000,block:true,color:'#3a86ff'}
};

var UPGRADES=[
{id:'card',name:'Оплата картой',desc:'+50% к выручке',cost:3000,max:1,icon:'💳'},
{id:'delivery',name:'Доставка',desc:'Пассивный доход',cost:5000,max:5,icon:'🚗'},
{id:'fast',name:'Быстрая готовка',desc:'−20% времени',cost:4000,max:3,icon:'⚡'},
{id:'expand_w',name:'Расширить вправо',desc:'+4 клетки',cost:8000,max:3,icon:'➡️'},
{id:'expand_h',name:'Расширить вниз',desc:'+4 клетки',cost:8000,max:3,icon:'⬇️'},
{id:'floor2',name:'Второй этаж',desc:'Новый зал',cost:20000,max:1,icon:'🏢'},
{id:'marketing',name:'Реклама',desc:'+20% клиентов',cost:6000,max:5,icon:'📢'},
{id:'cleaner',name:'Уборщик',desc:'Гости терпеливее',cost:10000,max:3,icon:'🧹'},
{id:'vip',name:'VIP-зона',desc:'+30% чаевых',cost:15000,max:3,icon:'👑'}
];

var state={
  money:8000,rep:100,
  gridW:16,gridH:12,
  floor:0,
  grids:[null,null],
  items:[],
  customers:[],
  chefs:[], waiters:[],
  storage:{},
  upgrades:{},
  placing:null,
  stats:{served:0,earned:0},
  spawnTimer:4,
  deliveryTimer:0,
  time:0,
  unlockedDishes:['coffee','water','tea','burger','salad','fries','hotdog','juice'],
  cam:{x:8,y:6,z:1},
  creator:false,
  floaters:[],
  paused:false
};

function initGrid(){
  var g=[];
  for(var y=0;y<state.gridH;y++)g.push(new Array(state.gridW).fill(null));
  return g;
}
function ensureFloors(){
  if(!state.grids[0])state.grids[0]=initGrid();
  if(!state.grids[1])state.grids[1]=initGrid();
}
function grid(){return state.grids[state.floor]}

var cv=$('c'),ctx=cv.getContext('2d');
var W=0,H=0,DPR=1;
function resize(){
  DPR=Math.min(window.devicePixelRatio||1,2);
  W=window.innerWidth;H=window.innerHeight;
  cv.width=W*DPR;cv.height=H*DPR;
  cv.style.width=W+'px';cv.style.height=H+'px';
  ctx.setTransform(DPR,0,0,DPR,0,0);
}
window.addEventListener('resize',resize);resize();

function save(){
  try{
    var placed=state.items.map(function(it){return {t:it.type,x:it.x,y:it.y,f:it.floor}});
    St.set(SAVE_KEY,JSON.stringify({
      money:state.money,rep:state.rep,
      gridW:state.gridW,gridH:state.gridH,
      unlocked:state.unlockedDishes,
      upgrades:state.upgrades,
      placed:placed,stats:state.stats,
      storage:state.storage,floor:state.floor,
      chefs:state.chefs.length,waiters:state.waiters.length
    }));
  }catch(e){}
}
function load(){
  try{
    var raw=St.get(SAVE_KEY);if(!raw)return false;
    var d=JSON.parse(raw);if(!d)return false;
    state.money=d.money||8000;
    state.rep=d.rep||100;
    state.gridW=d.gridW||16;
    state.gridH=d.gridH||12;
    state.unlockedDishes=d.unlocked||state.unlockedDishes;
    state.upgrades=d.upgrades||{};
    state.stats=d.stats||{served:0,earned:0};
    state.storage=d.storage||{};
    state.floor=d.floor||0;
    state.grids=[null,null];
    ensureFloors();
    (d.placed||[]).forEach(function(p){placeItem(p.t,p.x,p.y,p.f,true)});
    for(var i=0;i<(d.chefs||0);i++)addChef(true);
    for(var j=0;j<(d.waiters||0);j++)addWaiter(true);
    return true;
  }catch(e){return false}
}

function placeItem(type,x,y,f,silent){
  var def=ITEMS[type];if(!def)return null;
  var g=state.grids[f];if(!g)return null;
  if(x<0||x>=state.gridW||y<0||y>=state.gridH)return null;
  if(g[y][x])return null;
  var item={type:type,x:x,y:y,floor:f,seats:[],jobs:[],seatCount:0,reserved:false};
  if(def.seats){
    var so;
    if(def.seats===2)so=[{dx:0,dy:-1},{dx:0,dy:1}];
    else if(def.seats===4)so=[{dx:0,dy:-1},{dx:1,dy:0},{dx:0,dy:1},{dx:-1,dy:0}];
    else if(def.seats===6)so=[{dx:-1,dy:-1},{dx:0,dy:-1},{dx:1,dy:-1},{dx:-1,dy:1},{dx:0,dy:1},{dx:1,dy:1}];
    else so=[{dx:0,dy:-1},{dx:0,dy:1}];
    for(var i=0;i<so.length;i++){
      item.seats.push({x:x+so[i].dx,y:y+so[i].dy,dx:so[i].dx,dy:so[i].dy});
    }
  }
  g[y][x]=item;
  state.items.push(item);
  if(!silent)snd(700,.05,'square',.05);
  return item;
}
function removeItem(it){
  var g=state.grids[it.floor];
  if(g&&g[it.y][it.x]===it)g[it.y][it.x]=null;
  state.items=state.items.filter(function(x){return x!==it});
}

var AC=null;
function snd(f,d,t,v){
  try{
    if(!AC)AC=new (window.AudioContext||window.webkitAudioContext)();
    if(AC.state==='suspended')AC.resume();
    var o=AC.createOscillator(),g=AC.createGain();
    o.type=t||'sine';o.frequency.value=f;
    g.gain.value=v||.03;
    g.gain.exponentialRampToValueAtTime(.0001,AC.currentTime+d);
    o.connect(g);g.connect(AC.destination);
    o.start();o.stop(AC.currentTime+d+.01);
  }catch(e){}
}

function findPath(sx,sy,gx,gy,f){
  var g=state.grids[f];if(!g)return null;
  if(sx===gx&&sy===gy)return [{x:sx,y:sy}];
  var WW=state.gridW,HH=state.gridH;
  var seen={},prev={};
  function key(x,y){return x+','+y}
  var q=[{x:sx,y:sy}];seen[key(sx,sy)]=true;
  var head=0;
  while(head<q.length){
    var c=q[head++];
    var dirs=[[1,0],[-1,0],[0,1],[0,-1]];
    for(var i=0;i<4;i++){
      var nx=c.x+dirs[i][0],ny=c.y+dirs[i][1];
      if(nx<0||nx>=WW||ny<0||ny>=HH)continue;
      var k=key(nx,ny);
      if(seen[k])continue;
      var cell=g[ny][nx];
      var isGoal=(nx===gx&&ny===gy);
      if(cell&&!isGoal)continue;
      seen[k]=true;prev[k]=c;
      if(isGoal){
        var path=[],p={x:nx,y:ny};
        while(p){path.unshift(p);p=prev[key(p.x,p.y)]}
        return path;
      }
      q.push({x:nx,y:ny});
    }
  }
  return null;
}

function addChef(silent){
  var x=Math.floor(state.gridW/2),y=1;
  var c={px:x+.5,py:y+.5,x:x,y:y,phase:Math.random()*6,state:'idle',target:null,stove:null,dish:null,timer:0,total:0,speed:1.8};
  state.chefs.push(c);
  if(!silent){toast('👨‍🍳 Повар нанят!');snd(700,.1,'sine',.05)}
}
function addWaiter(silent){
  var x=Math.floor(state.gridW/2),y=3;
  var w={px:x+.5,py:y+.5,x:x,y:y,phase:Math.random()*6,state:'idle',target:null,customer:null,speed:2.2};
  state.waiters.push(w);
  if(!silent){toast('🤵 Официант нанят!');snd(700,.1,'sine',.05)}
}

function chefTick(c,dt){
  c.phase+=dt*8;
  if(c.state==='idle'){
    var need=null;
    for(var i=0;i<state.customers.length;i++){
      var cust=state.customers[i];
      if(cust.state!=='waiting'||!cust.order)continue;
      if((state.storage[cust.order]||0)>0)continue;
      var busy=state.chefs.some(function(ch){return ch!==c&&ch.dish===cust.order&&ch.state!=='idle'});
      if(busy)continue;
      need=cust.order;break;
    }
    if(!need)return;
    var stove=null;
    for(var j=0;j<state.items.length;j++){
      var it=state.items[j];
      if(it.floor!==state.floor)continue;
      if(it.type!=='stove')continue;
      if(it.reserved)continue;
      if(it.jobs&&it.jobs.length>=3)continue;
      stove=it;break;
    }
    if(!stove)return;
    stove.reserved=true;
    c.stove=stove;c.dish=need;
    c.target={x:stove.x+.5,y:stove.y+1.2};
    c.state='toStove';
  }
  else if(c.state==='toStove'){
    var dx=c.target.x-c.px,dy=c.target.y-c.py;
    var d=Math.sqrt(dx*dx+dy*dy);
    if(d<.1){c.state='cooking';c.timer=DM[c.dish].time*2;c.total=c.timer}
    else{
      var step=Math.min(d,c.speed*dt);
      c.px+=dx/d*step;c.py+=dy/d*step;
    }
  }
  else if(c.state==='cooking'){
    c.timer-=dt;
    if(c.timer<=0){
      state.storage[c.dish]=(state.storage[c.dish]||0)+1;
      updateStorageUI();
      if(c.stove)c.stove.reserved=false;
      state.floaters.push({x:c.px,y:c.py,text:'🍳 '+DM[c.dish].emoji,timer:1.2,color:'#95d5b2'});
      c.stove=null;c.dish=null;c.state='idle';
    }
  }
}

function waiterTick(w,dt){
  w.phase+=dt*8;
  if(w.state==='idle'){
    for(var i=0;i<state.customers.length;i++){
      var cust=state.customers[i];
      if(cust.state!=='waiting'||!cust.order)continue;
      if((state.storage[cust.order]||0)<=0)continue;
      var taken=state.waiters.some(function(ww){return ww!==w&&ww.customer===cust});
      if(taken)continue;
      w.customer=cust;
      w.target={x:cust.px,y:cust.py};
      w.state='toCustomer';
      break;
    }
  }
  else if(w.state==='toCustomer'){
    if(!w.customer||w.customer.state!=='waiting'){w.customer=null;w.state='idle';return}
    w.target={x:w.customer.px,y:w.customer.py};
    var dx=w.target.x-w.px,dy=w.target.y-w.py;
    var d=Math.sqrt(dx*dx+dy*dy);
    if(d<.35){
      if((state.storage[w.customer.order]||0)>0){
        state.storage[w.customer.order]--;
        w.customer.state='eating';
        w.customer.timer=0;
        updateStorageUI();
        snd(880,.08,'sine',.05);
      }
      w.customer=null;w.state='idle';
    }
    else{
      var step=Math.min(d,w.speed*dt);
      w.px+=dx/d*step;w.py+=dy/d*step;
    }
  }
}

function newCustomer(){
  var skinC=['#f0c8a0','#d4a373','#8b5a3a','#4a2a1a'][Math.floor(Math.random()*4)];
  var shirtC=['#e85a3a','#52b788','#3a86ff','#f4a261','#7c5cff','#00b4d8','#ffd166'][Math.floor(Math.random()*7)];
  var patience=45+(state.upgrades.cleaner||0)*8;
  return {
    x:Math.floor(state.gridW/2),y:state.gridH-1,
    px:Math.floor(state.gridW/2)+.5,py:state.gridH-1+.5,
    state:'entering',path:null,pIdx:0,
    seat:null,order:null,
    patience:patience,timer:0,
    skin:skinC,shirt:shirtC,
    phase:Math.random()*6,dir:0
  };
}

function findSeat(){
  var options=[];
  for(var i=0;i<state.items.length;i++){
    var it=state.items[i];
    if(it.floor!==state.floor)continue;
    if(!it.seats||!it.seats.length)continue;
    for(var j=0;j<it.seats.length;j++){
      var s=it.seats[j];
      if(s.x<0||s.x>=state.gridW||s.y<0||s.y>=state.gridH)continue;
      var cell=grid()[s.y]&&grid()[s.y][s.x];
      if(cell)continue;
      var taken=false;
      for(var k=0;k<state.customers.length;k++){
        var cc=state.customers[k];
        if(cc.seat&&cc.seat.item===it&&cc.seat.idx===j){taken=true;break}
      }
      if(taken)continue;
      options.push({item:it,idx:j,pos:s});
    }
  }
  if(!options.length)return null;
  return options[Math.floor(Math.random()*options.length)];
}

function spawnCustomer(){
  if(state.customers.length>=10)return;
  var s=findSeat();
  if(!s)return;
  var c=newCustomer();
  c.seat={item:s.item,idx:s.idx,pos:s.pos};
  s.item.seatCount++;
  state.customers.push(c);
}

function updateCustomer(c,dt){
  c.timer+=dt;
  if(c.state==='entering'){
    var s=c.seat.pos;
    var p=findPath(c.x,c.y,s.x,s.y,c.seat.item.floor);
    if(p){c.path=p;c.pIdx=0;c.state='walking'}
    else{c.state='leaving';c.seat.item.seatCount--}
  }
  else if(c.state==='walking'){
    if(!c.path||c.pIdx>=c.path.length){
      var sp=c.seat.pos;
      c.px=sp.x+.5;
      c.py=sp.y+.5;
      c.state='ordering';c.timer=0;return;
    }
    var tgt=c.path[c.pIdx];
    var dx=tgt.x+.5-c.px,dy=tgt.y+.5-c.py;
    var d=Math.sqrt(dx*dx+dy*dy);
    if(d<.1){c.pIdx++;return}
    var spd=2.0*dt;
    var step=Math.min(d,spd);
    c.px+=dx/d*step;c.py+=dy/d*step;
    c.dir=Math.atan2(dy,dx);
    c.phase+=dt*10;
  }
  else if(c.state==='ordering'){
    if(c.timer>1.5){
      var menu=state.unlockedDishes;
      c.order=menu[Math.floor(Math.random()*menu.length)];
      c.state='waiting';c.timer=0;
    }
  }
  else if(c.state==='waiting'){
    if(c.timer>c.patience){
      c.state='angry';c.timer=0;
      state.rep=Math.max(0,state.rep-3);
      updateHUD();
    }
  }
  else if(c.state==='angry'){
    if(c.timer>1.5){
      c.seat.item.seatCount--;
      c.state='leaving';c.timer=0;
      c.path=findPath(Math.floor(c.px),Math.floor(c.py),Math.floor(state.gridW/2),state.gridH-1,c.seat.item.floor);
      c.pIdx=0;
    }
  }
  else if(c.state==='eating'){
    if(c.timer>5){
      var dish=DM[c.order];
      var mult=state.upgrades.card?1.5:1;
      var vipMult=1+(state.upgrades.vip||0)*0.1;
      var earn=Math.round(dish.price*mult);
      var tip=Math.round(earn*.2*vipMult);
      state.money+=earn+tip;
      state.stats.served++;
      state.stats.earned+=earn+tip;
      state.rep=Math.min(100,state.rep+1);
      state.floaters.push({x:c.px,y:c.py,text:'+💰'+(earn+tip),timer:1.6,color:'#ffd166'});
      snd(1200,.1,'sine',.04);
      c.seat.item.seatCount--;
      c.state='leaving';c.timer=0;
      c.path=findPath(Math.floor(c.px),Math.floor(c.py),Math.floor(state.gridW/2),state.gridH-1,c.seat.item.floor);
      c.pIdx=0;
      updateHUD();
    }
  }
  else if(c.state==='leaving'){
    if(!c.path||c.pIdx>=c.path.length){c.done=true;return}
    var tgt2=c.path[c.pIdx];
    var dx2=tgt2.x+.5-c.px,dy2=tgt2.y+.5-c.py;
    var d2=Math.sqrt(dx2*dx2+dy2*dy2);
    if(d2<.1){c.pIdx++;return}
    var spd2=2.2*dt;
    var step2=Math.min(d2,spd2);
    c.px+=dx2/d2*step2;c.py+=dy2/d2*step2;
    c.phase+=dt*10;
  }
}

function clickCustomer(c){
  if(c.state!=='waiting'){toast('Гость не ждёт заказ');return}
  if(!c.order){toast('Гость ещё не выбрал');return}
  if((state.storage[c.order]||0)<=0){
    toast('Нужно приготовить: '+DM[c.order].emoji+' '+DM[c.order].name);
    return;
  }
  state.storage[c.order]--;
  c.state='eating';c.timer=0;
  updateStorageUI();
  snd(880,.08,'sine',.06);
}

function startCooking(it,dishId){
  var dish=DM[dishId];if(!dish)return;
  if(!it.jobs)it.jobs=[];
  if(it.jobs.length>=3){toast('Плита занята');return}
  if(!state.creator&&state.money<dish.cost){toast('Не хватает на ингредиенты');return}
  if(!state.creator)state.money-=dish.cost;
  var mult=state.upgrades.fast?(1-0.2*state.upgrades.fast):1;
  it.jobs.push({dish:dishId,timer:dish.time*mult,total:dish.time*mult});
  snd(440,.05,'square',.04);
  updateHUD();
}

function updateCooking(dt){
  for(var i=0;i<state.items.length;i++){
    var it=state.items[i];
    if(it.floor!==state.floor||!it.jobs)continue;
    for(var j=it.jobs.length-1;j>=0;j--){
      var job=it.jobs[j];
      job.timer-=dt;
      if(job.timer<=0){
        it.jobs.splice(j,1);
        state.storage[job.dish]=(state.storage[job.dish]||0)+1;
        snd(1000,.1,'sine',.05);
        updateStorageUI();
      }
    }
  }
}

function updateDelivery(dt){
  if(!state.upgrades.delivery)return;
  state.deliveryTimer-=dt;
  if(state.deliveryTimer<=0){
    state.deliveryTimer=20;
    var income=300*state.upgrades.delivery;
    state.money+=income;
    state.stats.earned+=income;
    state.floaters.push({x:state.gridW/2,y:2,text:'🚗 +'+income,timer:1.8,color:'#90e0ef'});
    updateHUD();
  }
}

var lastT=0;
function loop(T){
  var dt=Math.min(.05,(T-lastT)/1000);lastT=T;
  if(state.paused)dt=0;
  state.time+=dt;
  state.spawnTimer-=dt;
  var rate=1+0.2*(state.upgrades.marketing||0);
  if(state.spawnTimer<=0){
    state.spawnTimer=rnd(4,8)/rate;
    if(Math.random()<.9)spawnCustomer();
  }
  for(var i=state.customers.length-1;i>=0;i--){
    var c=state.customers[i];
    updateCustomer(c,dt);
    if(c.done)state.customers.splice(i,1);
  }
  for(var k=0;k<state.chefs.length;k++)chefTick(state.chefs[k],dt);
  for(var m=0;m<state.waiters.length;m++)waiterTick(state.waiters[m],dt);
  updateCooking(dt);
  updateDelivery(dt);
  for(var f=state.floaters.length-1;f>=0;f--){
    var fl=state.floaters[f];
    fl.timer-=dt;fl.y-=dt*.7;
    if(fl.timer<=0)state.floaters.splice(f,1);
  }
  render();
  requestAnimationFrame(loop);
}

function render(){
  ctx.fillStyle='#0e0c08';
  ctx.fillRect(0,0,W,H);
  var TILE=48*state.cam.z;
  var cx=W/2,cy=H/2;
  var camX=state.cam.x,camY=state.cam.y;
  function w2sx(wx){return (wx-camX)*TILE+cx}
  function w2sy(wy){return (wy-camY)*TILE+cy}
  for(var y=0;y<state.gridH;y++){
    for(var x=0;x<state.gridW;x++){
      var px=w2sx(x),py=w2sy(y);
      if(px<-TILE||px>W||py<-TILE||py>H)continue;
      ctx.fillStyle=(x+y)%2===0?'#2e1f14':'#241810';
      ctx.fillRect(px,py,TILE,TILE);
    }
  }
  ctx.strokeStyle='#4a2e1f';
  ctx.lineWidth=Math.max(4,TILE*.2);
  ctx.strokeRect(w2sx(-.1),w2sy(-.1),(state.gridW+.2)*TILE,(state.gridH+.2)*TILE);
  var doorX=w2sx(Math.floor(state.gridW/2)-.5);
  var doorY=w2sy(state.gridH-.05);
  ctx.fillStyle='#7a4a20';
  ctx.fillRect(doorX,doorY-TILE*.15,TILE*2,TILE*.15);
  for(var i=0;i<state.items.length;i++){
    var it=state.items[i];
    if(it.floor!==state.floor)continue;
    drawItem(it,w2sx,w2sy,TILE);
  }
  for(var j=0;j<state.customers.length;j++)drawCustomer(state.customers[j],w2sx,w2sy,TILE);
  for(var k=0;k<state.chefs.length;k++)drawChef(state.chefs[k],w2sx,w2sy,TILE);
  for(var m=0;m<state.waiters.length;m++)drawWaiter(state.waiters[m],w2sx,w2sy,TILE);
  for(var f=0;f<state.floaters.length;f++){
    var fl=state.floaters[f];
    var fx=w2sx(fl.x),fy=w2sy(fl.y);
    ctx.globalAlpha=Math.min(1,fl.timer);
    ctx.fillStyle=fl.color;
    ctx.font='bold '+(TILE*.35)+'px sans-serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(fl.text,fx,fy);
    ctx.globalAlpha=1;
  }
  if(state.creator){
    ctx.strokeStyle='rgba(255,0,102,.4)';
    ctx.lineWidth=4;
    ctx.strokeRect(2,2,W-4,H-4);
  }
}

function drawItem(it,w2sx,w2sy,TILE){
  var px=w2sx(it.x),py=w2sy(it.y);
  var def=ITEMS[it.type];
  var bob=Math.sin(state.time*2+it.x+it.y)*1.5;
  if(it.seats&&it.seats.length){
    it.seats.forEach(function(s){
      if(s.x<0||s.x>=state.gridW||s.y<0||s.y>=state.gridH)return;
      var spx=w2sx(s.x)+TILE/2;
      var spy=w2sy(s.y)+TILE/2;
      var ang=Math.atan2(s.dy,s.dx);
      ctx.save();
      ctx.translate(spx,spy);
      ctx.rotate(ang);
      ctx.fillStyle='#3a1f12';
      ctx.fillRect(-TILE*.15,-TILE*.28,TILE*.3,TILE*.1);
      ctx.fillStyle='#6b3a2a';
      ctx.beginPath();ctx.arc(0,0,TILE*.2,0,Math.PI*2);ctx.fill();
      ctx.restore();
    });
    ctx.fillStyle='#3a2418';
    ctx.beginPath();ctx.arc(px+TILE/2,py+TILE/2,TILE*.42,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#8b5a3a';
    ctx.beginPath();ctx.arc(px+TILE/2,py+TILE/2,TILE*.36,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='rgba(255,255,255,.08)';
    ctx.beginPath();ctx.arc(px+TILE/2,py+TILE/2,TILE*.22,0,Math.PI*2);ctx.fill();
  }
  else if(it.type==='stove'){
    ctx.fillStyle='#3a3a44';
    ctx.fillRect(px+TILE*.08,py+TILE*.08,TILE*.84,TILE*.84);
    ctx.fillStyle='#555a63';
    ctx.fillRect(px+TILE*.15,py+TILE*.15,TILE*.7,TILE*.7);
    if(it.jobs&&it.jobs.length){
      ctx.fillStyle='#ff6b1a';
      ctx.beginPath();ctx.arc(px+TILE*.75,py+TILE*.22,4+Math.random()*2,0,Math.PI*2);ctx.fill();
    }
    if(it.reserved){
      ctx.strokeStyle='#95d5b2';ctx.lineWidth=3;
      ctx.strokeRect(px+TILE*.08,py+TILE*.08,TILE*.84,TILE*.84);
    }
    ctx.fillStyle='#f5f0e8';
    ctx.font='bold '+(TILE*.42)+'px serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(def.emoji,px+TILE/2,py+TILE/2);
    if(it.jobs&&it.jobs.length){
      var prog=1-it.jobs[0].timer/it.jobs[0].total;
      ctx.fillStyle='rgba(0,0,0,.6)';
      ctx.fillRect(px+TILE*.1,py+TILE*.88,TILE*.8,5);
      ctx.fillStyle='#f0b040';
      ctx.fillRect(px+TILE*.1,py+TILE*.88,TILE*.8*prog,5);
    }
  }
  else{
    ctx.fillStyle='rgba(0,0,0,.3)';
    ctx.beginPath();ctx.arc(px+TILE/2,py+TILE/2,TILE*.4,0,Math.PI*2);ctx.fill();
    ctx.fillStyle=def.color||'#666';
    ctx.beginPath();ctx.arc(px+TILE/2,py+TILE/2,TILE*.34,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#fff';
    ctx.font='bold '+(TILE*.5)+'px serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(def.emoji,px+TILE/2,py+TILE/2+bob*.3);
  }
}

function drawCustomer(c,w2sx,w2sy,TILE){
  var px=w2sx(c.px)+TILE/2,py=w2sy(c.py)+TILE/2;
  var sitting=(c.state==='ordering'||c.state==='waiting'||c.state==='eating'||c.state==='angry');
  if(sitting){
    var it=c.seat&&c.seat.item;
    if(it){
      var sp=c.seat.pos;
      var dxs=(it.x-sp.x),dys=(it.y-sp.y);
      var len=Math.hypot(dxs,dys)||1;
      px+=dxs/len*TILE*0.12;
      py+=dys/len*TILE*0.12;
    }
    py+=TILE*0.06;
  } else {
    py+=Math.sin(c.phase)*2;
  }
  ctx.fillStyle='rgba(0,0,0,.35)';
  ctx.beginPath();ctx.ellipse(px,py+TILE*.35,TILE*.28,TILE*.1,0,0,Math.PI*2);ctx.fill();
  var bodyY=sitting?py+TILE*.02:py+TILE*.05;
  ctx.fillStyle=c.shirt;
  ctx.beginPath();ctx.arc(px,bodyY,TILE*(sitting?.24:.26),0,Math.PI*2);ctx.fill();
  var headY=sitting?py-TILE*.22:py-TILE*.24;
  ctx.fillStyle=c.skin;
  ctx.beginPath();ctx.arc(px,headY,TILE*.2,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#2a1a0a';
  ctx.beginPath();ctx.arc(px,headY-TILE*.06,TILE*.2,Math.PI,Math.PI*2);ctx.fill();
  ctx.fillStyle='#111';
  if(sitting&&c.seat){
    var it2=c.seat.item;
    var lookX=(it2.x-c.seat.pos.x)>0?1:(it2.x-c.seat.pos.x)<0?-1:0;
    if(lookX!==0){
      ctx.beginPath();
      ctx.arc(px+lookX*TILE*.03-TILE*.04,headY,1.7,0,Math.PI*2);
      ctx.arc(px+lookX*TILE*.03+TILE*.04,headY,1.7,0,Math.PI*2);
      ctx.fill();
    } else {
      ctx.beginPath();
      ctx.arc(px-TILE*.06,headY,1.7,0,Math.PI*2);
      ctx.arc(px+TILE*.06,headY,1.7,0,Math.PI*2);
      ctx.fill();
    }
  } else {
    ctx.beginPath();
    ctx.arc(px-TILE*.06,headY,1.7,0,Math.PI*2);
    ctx.arc(px+TILE*.06,headY,1.7,0,Math.PI*2);
    ctx.fill();
  }
  if(c.state==='waiting'&&c.order){
    var by=py-TILE*.85+Math.sin(state.time*3)*2;
    ctx.fillStyle='rgba(255,255,255,.95)';
    ctx.beginPath();ctx.arc(px,by,TILE*.32,0,Math.PI*2);ctx.fill();
    ctx.beginPath();
    ctx.moveTo(px-5,by+TILE*.26);ctx.lineTo(px,by+TILE*.46);ctx.lineTo(px+5,by+TILE*.26);
    ctx.fill();
    ctx.fillStyle='#111';
    ctx.font='bold '+(TILE*.45)+'px serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(DM[c.order].emoji,px,by);
    var pp=1-c.timer/c.patience;
    ctx.fillStyle='rgba(0,0,0,.5)';
    ctx.fillRect(px-TILE*.32,by+TILE*.5,TILE*.64,4);
    ctx.fillStyle=pp>.3?'#52b788':'#e85a3a';
    ctx.fillRect(px-TILE*.32,by+TILE*.5,TILE*.64*pp,4);
  }
  if(c.state==='angry'){
    ctx.font='bold '+(TILE*.55)+'px serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText('😠',px,py-TILE*.85);
  }
  if(c.state==='eating'){
    ctx.font='bold '+(TILE*.5)+'px serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText('😋',px,py-TILE*.8);
  }
}

function drawChef(c,w2sx,w2sy,TILE){
  var px=w2sx(c.px)+TILE/2,py=w2sy(c.py)+TILE/2;
  var bob=Math.sin(c.phase)*2;py+=bob;
  ctx.fillStyle='rgba(0,0,0,.3)';
  ctx.beginPath();ctx.ellipse(px,py+TILE*.35,TILE*.3,TILE*.12,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#f5f0e8';
  ctx.beginPath();ctx.arc(px,py+TILE*.05,TILE*.26,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#f0c8a0';
  ctx.beginPath();ctx.arc(px,py-TILE*.24,TILE*.2,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#fff';
  ctx.beginPath();ctx.arc(px,py-TILE*.48,TILE*.16,0,Math.PI*2);ctx.fill();
  ctx.fillRect(px-TILE*.16,py-TILE*.42,TILE*.32,TILE*.1);
  ctx.fillStyle='#111';
  ctx.beginPath();
  ctx.arc(px-TILE*.06,py-TILE*.24,1.7,0,Math.PI*2);
  ctx.arc(px+TILE*.06,py-TILE*.24,1.7,0,Math.PI*2);
  ctx.fill();
  if(c.state==='cooking'){
    ctx.font='bold '+(TILE*.5)+'px serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText('🍳',px,py-TILE*.85);
  }
}

function drawWaiter(w,w2sx,w2sy,TILE){
  var px=w2sx(w.px)+TILE/2,py=w2sy(w.py)+TILE/2;
  var bob=Math.sin(w.phase)*2;py+=bob;
  ctx.fillStyle='rgba(0,0,0,.3)';
  ctx.beginPath();ctx.ellipse(px,py+TILE*.35,TILE*.3,TILE*.12,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#1a1a24';
  ctx.beginPath();ctx.arc(px,py+TILE*.05,TILE*.26,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#f5f0e8';
  ctx.beginPath();ctx.arc(px,py+TILE*.05,TILE*.14,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#f0c8a0';
  ctx.beginPath();ctx.arc(px,py-TILE*.24,TILE*.2,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#3a2a1a';
  ctx.beginPath();ctx.arc(px,py-TILE*.3,TILE*.2,Math.PI,Math.PI*2);ctx.fill();
  ctx.fillStyle='#111';
  ctx.beginPath();
  ctx.arc(px-TILE*.06,py-TILE*.24,1.7,0,Math.PI*2);
  ctx.arc(px+TILE*.06,py-TILE*.24,1.7,0,Math.PI*2);
  ctx.fill();
  if(w.state==='toCustomer'){
    ctx.font='bold '+(TILE*.45)+'px serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText('🍽️',px,py-TILE*.85);
  }
}

var dragStart=null,lastDrag=null;
var pointers={},pinchStartDist=0,pinchStartZ=1;

cv.addEventListener('pointerdown',function(e){
  cv.setPointerCapture(e.pointerId);
  pointers[e.pointerId]={x:e.clientX,y:e.clientY};
  if(Object.keys(pointers).length>=2){pinchStartDist=0;return}
  dragStart={x:e.clientX,y:e.clientY,t:Date.now()};
  lastDrag={x:e.clientX,y:e.clientY};
});
cv.addEventListener('pointermove',function(e){
  if(pointers[e.pointerId]){pointers[e.pointerId].x=e.clientX;pointers[e.pointerId].y=e.clientY}
  var ids=Object.keys(pointers);
  if(ids.length===2){
    var p1=pointers[ids[0]],p2=pointers[ids[1]];
    var d=Math.hypot(p1.x-p2.x,p1.y-p2.y);
    if(!pinchStartDist){pinchStartDist=d;pinchStartZ=state.cam.z}
    else state.cam.z=clamp(pinchStartZ*(d/pinchStartDist),.5,2.5);
    return;
  }
  if(!dragStart)return;
  var dx=e.clientX-lastDrag.x,dy=e.clientY-lastDrag.y;
  state.cam.x-=dx/(48*state.cam.z);
  state.cam.y-=dy/(48*state.cam.z);
  lastDrag={x:e.clientX,y:e.clientY};
});
cv.addEventListener('pointerup',function(e){
  delete pointers[e.pointerId];
  if(pinchStartDist){pinchStartDist=0;dragStart=null;return}
  if(!dragStart)return;
  var dx=e.clientX-dragStart.x,dy=e.clientY-dragStart.y;
  var moved=Math.sqrt(dx*dx+dy*dy);
  var dt=Date.now()-dragStart.t;
  if(moved<8&&dt<450)handleTap(e.clientX,e.clientY);
  dragStart=null;
});
cv.addEventListener('pointercancel',function(){dragStart=null;pinchStartDist=0});
cv.addEventListener('wheel',function(e){
  e.preventDefault();
  state.cam.z=clamp(state.cam.z*(1-e.deltaY*.001),.5,2.5);
},{passive:false});

function handleTap(sx,sy){
  var TILE=48*state.cam.z;
  var wx=(sx-W/2)/TILE+state.cam.x;
  var wy=(sy-H/2)/TILE+state.cam.y;
  var gx=Math.floor(wx),gy=Math.floor(wy);
  if(gx<0||gx>=state.gridW||gy<0||gy>=state.gridH)return;
  if(state.placing){
    var def=ITEMS[state.placing];
    if(!state.creator&&state.money<def.cost){toast('Не хватает');cancelPlacing();return}
    var placed=placeItem(state.placing,gx,gy,state.floor);
    if(placed){
      if(!state.creator)state.money-=def.cost;
      toast((state.creator?'✨ ':'-'+def.cost+' ₽ ')+def.name);
      updateHUD();save();
    } else toast('Клетка занята');
    cancelPlacing();
    return;
  }
  for(var i=0;i<state.customers.length;i++){
    var c=state.customers[i];
    var cx=(c.px-state.cam.x)*TILE+W/2;
    var cy=(c.py-state.cam.y)*TILE+H/2;
    if(Math.abs(sx-cx)<TILE*.5&&Math.abs(sy-cy)<TILE*.6){clickCustomer(c);return}
  }
  var cell=grid()[gy]&&grid()[gy][gx];
  if(cell){
    if(cell.type==='stove'){openCookMenu(cell);return}
    if(cell.type==='register'){toast('💰 Гостей: '+state.stats.served+' · Заработано: '+state.stats.earned.toLocaleString('ru-RU')+' ₽');return}
    if(cell.seats){toast('Мест: '+ITEMS[cell.type].seats+' · Занято: '+cell.seatCount);return}
  }
}

cv.addEventListener('dblclick',function(e){
  var TILE=48*state.cam.z;
  var wx=(e.clientX-W/2)/TILE+state.cam.x;
  var wy=(e.clientY-H/2)/TILE+state.cam.y;
  var gx=Math.floor(wx),gy=Math.floor(wy);
  var cell=grid()[gy]&&grid()[gy][gx];
  if(cell){
    if(confirm('Убрать '+ITEMS[cell.type].name+'?')){
      if(!state.creator)state.money+=Math.floor(ITEMS[cell.type].cost*.5);
      removeItem(cell);updateHUD();save();
    }
  }
});

function updateHUD(){
  $('pMoney').textContent='💰 '+Math.floor(state.money).toLocaleString('ru-RU');
  $('pRep').textContent='⭐ '+Math.round(state.rep);
  $('pCust').textContent='👥 '+state.customers.length;
  $('pDay').textContent='📅 День '+(state.floor+1);
  $('pStaff').textContent='👨‍🍳 '+state.chefs.length+' · 🤵 '+state.waiters.length;
}
function updateStorageUI(){
  var el=$('storage');
  var keys=Object.keys(state.storage).filter(function(k){return state.storage[k]>0});
  if(!keys.length){el.innerHTML='';return}
  el.innerHTML=keys.map(function(k){
    var d=DM[k];if(!d)return '';
    return '<div class="stchip">'+d.emoji+' '+state.storage[k]+'</div>';
  }).join('');
}
var toastTimer=0;
function toast(s){
  var t=$('toast');
  t.textContent=s;t.classList.add('on');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(function(){t.classList.remove('on')},1700);
}

var panel=$('panel'),pb=$('pb'),ptit=$('ptit');
function closePanel(){panel.classList.remove('on')}
$('px').onclick=closePanel;

$('bShop').onclick=openShop;
$('bMenu').onclick=openMenu;
$('bStaff').onclick=openStaff;
$('bUpg').onclick=openUpgrades;
$('bHelp').onclick=openHelp;
$('bFloor').onclick=function(){
  if(!state.upgrades.floor2){toast('Нужен апгрейд «Второй этаж»');return}
  state.floor=state.floor?0:1;
  $('bFloor').textContent='🏢 Этаж '+(state.floor+1);
  state.cam.x=state.gridW/2;state.cam.y=state.gridH/2;
  save();
};
$('bCreator').onclick=function(){
  state.creator=!state.creator;
  $('bCreator').classList.toggle('act',state.creator);
  if(state.creator){
    state.money=9999999;
    DISHES.forEach(function(d){if(state.unlockedDishes.indexOf(d.id)<0)state.unlockedDishes.push(d.id)});
    toast('🎨 Creator Mode ON');
  } else {
    toast('Creator Mode OFF');
  }
  updateHUD();
};

function cancelPlacing(){
  state.placing=null;
  $('hint').classList.remove('on');
}

function openShop(){
  ptit.textContent='🛒 Магазин';
  pb.innerHTML='<div class="grid" id="gr"></div>';
  var g=$('gr');
  Object.keys(ITEMS).forEach(function(k){
    var def=ITEMS[k];
    var canAfford=state.creator||state.money>=def.cost;
    var c=document.createElement('div');
    c.className='card'+(canAfford?'':' dis');
    c.innerHTML='<div class="emoji">'+def.emoji+'</div><div class="nm">'+def.name+'</div><div class="cost">'+(state.creator?'✨ ∞':def.cost.toLocaleString('ru-RU')+' ₽')+'</div>'+
      (def.seats?'<div class="sub">Мест: '+def.seats+'</div>':'')+
      (def.cooks?'<div class="sub">Готовит до '+def.cooks+'</div>':'')+
      (def.block?'<div class="sub">Блокирует проход</div>':'');
    c.onclick=function(){
      if(!state.creator&&state.money<def.cost){toast('Не хватает');return}
      closePanel();
      state.placing=k;
      $('hint').classList.add('on');
      toast('Тапни на пустую клетку');
    };
    g.appendChild(c);
  });
  panel.classList.add('on');
}

function openMenu(){
  ptit.textContent='📖 Меню ресторана';
  pb.innerHTML='<div style="font-size:12px;opacity:.6;margin-bottom:10px">Открытие блюда: <b style="color:#ffd166">3 000 ₽</b> · Всего: '+DISHES.length+'</div>';
  DISHES.forEach(function(d){
    var unlocked=state.unlockedDishes.indexOf(d.id)>=0;
    var row=document.createElement('div');
    row.style.cssText='display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:rgba(255,255,255,.04);border-radius:10px;margin-bottom:5px;font-size:13px'+(unlocked?'':';opacity:.55');
    row.innerHTML='<div style="display:flex;flex-direction:column;gap:2px"><div>'+(unlocked?'✓':'🔒')+' <b>'+d.emoji+' '+d.name+'</b></div><div style="font-size:11px;opacity:.6">Ингр. '+d.cost+' ₽ · '+d.time+' сек</div></div>'+
      '<div style="display:flex;gap:8px;align-items:center"><div style="color:#95d5b2;font-weight:700">'+d.price+' ₽</div>'+
      (unlocked?'':'<button data-id="'+d.id+'" style="padding:6px 12px;border-radius:8px;border:0;cursor:pointer;font-size:11.5px;font-weight:700;font-family:inherit;background:linear-gradient(135deg,#e85a3a,#a03a20);color:#fff">3 000 ₽</button>')+'</div>';
    pb.appendChild(row);
  });
  pb.querySelectorAll('[data-id]').forEach(function(b){
    b.onclick=function(){
      if(!state.creator&&state.money<3000){toast('Не хватает 3 000 ₽');return}
      if(!state.creator)state.money-=3000;
      state.unlockedDishes.push(b.dataset.id);
      updateHUD();save();openMenu();
      toast('🎉 Блюдо открыто!');
    };
  });
  panel.classList.add('on');
}

function openCookMenu(it){
  ptit.textContent='🔥 Плита';
  pb.innerHTML='<div style="font-size:12px;opacity:.6;margin-bottom:10px">Выбери блюдо. Готовое появится в складе сверху.</div>';
  if(!state.unlockedDishes.length){pb.innerHTML='<div style="opacity:.6;padding:20px">Сначала открой блюдо в Меню.</div>';panel.classList.add('on');return}
  state.unlockedDishes.forEach(function(id){
    var d=DM[id];if(!d)return;
    var row=document.createElement('div');
    row.style.cssText='display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:rgba(255,255,255,.04);border-radius:10px;margin-bottom:5px;font-size:13px';
    row.innerHTML='<div style="display:flex;flex-direction:column;gap:2px"><div><b>'+d.emoji+' '+d.name+'</b></div><div style="font-size:11px;opacity:.6">Ингр. '+d.cost+' ₽ · '+d.time+' сек</div></div>'+
      '<div style="display:flex;gap:8px;align-items:center"><div style="color:#95d5b2;font-weight:700">'+d.price+' ₽</div>'+
      '<button data-id="'+id+'" style="padding:6px 12px;border-radius:8px;border:0;cursor:pointer;font-size:11.5px;font-weight:700;font-family:inherit;background:linear-gradient(135deg,#52b788,#2d6a4f);color:#fff">Готовить</button></div>';
    pb.appendChild(row);
  });
  pb.querySelectorAll('[data-id]').forEach(function(b){
    b.onclick=function(){startCooking(it,b.dataset.id);closePanel()};
  });
  panel.classList.add('on');
}

function openStaff(){
  ptit.textContent='👨‍🍳 Персонал';
  var chefCost=6000+state.chefs.length*4000;
  var waiterCost=5000+state.waiters.length*3000;
  var canHireChef=state.chefs.length<4&&(state.creator||state.money>=chefCost);
  var canHireWaiter=state.waiters.length<4&&(state.creator||state.money>=waiterCost);
  pb.innerHTML='<div class="grid">'+
    '<div class="card'+(canHireChef?'':' dis')+'" id="hireChef"><div class="emoji">👨‍🍳</div><div class="nm">Повар</div><div class="sub">Готовит сам, но ×2 медленнее</div><div class="cost">'+(state.creator?'✨ ∞':chefCost.toLocaleString('ru-RU')+' ₽')+'</div><div class="sub">Нанято: '+state.chefs.length+'/4</div></div>'+
    '<div class="card'+(canHireWaiter?'':' dis')+'" id="hireWaiter"><div class="emoji">🤵</div><div class="nm">Официант</div><div class="sub">Носит блюда гостям</div><div class="cost">'+(state.creator?'✨ ∞':waiterCost.toLocaleString('ru-RU')+' ₽')+'</div><div class="sub">Нанято: '+state.waiters.length+'/4</div></div>'+
    '</div>'+
    '<div style="margin-top:16px;font-size:12px;opacity:.6;line-height:1.7">'+
    '<b>👨‍🍳 Повар:</b> видя, что гость ждёт блюдо, готовит его сам.<br>'+
    '<b>🤵 Официант:</b> сам несёт готовое блюдо к гостю.'+
    '</div>';
  if(canHireChef)$('hireChef').onclick=function(){if(!state.creator)state.money-=chefCost;addChef();updateHUD();save();openStaff()};
  if(canHireWaiter)$('hireWaiter').onclick=function(){if(!state.creator)state.money-=waiterCost;addWaiter();updateHUD();save();openStaff()};
  panel.classList.add('on');
}

function openUpgrades(){
  ptit.textContent='⬆️ Улучшения';
  pb.innerHTML='<div class="grid" id="gr"></div>';
  var g=$('gr');
  UPGRADES.forEach(function(u){
    var lvl=state.upgrades[u.id]||0;
    var maxed=lvl>=u.max;
    var cost=u.cost*(lvl+1);
    var canAfford=state.creator||state.money>=cost;
    var c=document.createElement('div');
    c.className='card'+(maxed||!canAfford?' dis':'');
    c.innerHTML='<div class="emoji">'+u.icon+'</div><div class="nm">'+u.name+'</div><div class="sub">'+u.desc+'</div>'+
      '<div class="cost">'+(maxed?'МАКС':(state.creator?'✨ ∞':cost.toLocaleString('ru-RU')+' ₽'))+' · ур.'+(lvl+1)+'/'+u.max+'</div>';
    if(!maxed&&canAfford){
      c.onclick=function(){
        if(!state.creator)state.money-=cost;
        state.upgrades[u.id]=lvl+1;
        applyUpgrade(u.id,lvl+1);
        updateHUD();save();openUpgrades();
        toast('✨ '+u.name+' ур.'+(lvl+1));
      };
    }
    g.appendChild(c);
  });
  panel.classList.add('on');
}

function applyUpgrade(id,lvl){
  if(id==='expand_w'){
    var newW=16+4*lvl;
    for(var f=0;f<2;f++){
      if(!state.grids[f])continue;
      for(var y=0;y<state.gridH;y++)for(var x=state.gridW;x<newW;x++)state.grids[f][y][x]=null;
    }
    state.gridW=newW;
  }
  if(id==='expand_h'){
    var newH=12+4*lvl;
    for(var f2=0;f2<2;f2++){
      if(!state.grids[f2])continue;
      while(state.grids[f2].length<newH){
        var row=[];
        for(var x2=0;x2<state.gridW;x2++)row.push(null);
        state.grids[f2].push(row);
      }
    }
    state.gridH=newH;
  }
  if(id==='floor2'){
    ensureFloors();
    $('bFloor').style.display='flex';
  }
}

function openHelp(){
  ptit.textContent='❓ Как играть';
  pb.innerHTML='<div style="font-size:13px;line-height:1.8">'+
    '<p><b>🎯 Цель:</b> построй прибыльный ресторан.</p>'+
    '<p style="margin-top:10px"><b>🛒 Магазин</b> — столы (со стульями), плиты, касса, декор.</p>'+
    '<p style="margin-top:10px"><b>📖 Меню</b> — 25 блюд, первые 8 открыты, остальные за 3 000 ₽.</p>'+
    '<p style="margin-top:10px"><b>🔥 Плита</b> — тап, выбери блюдо, готовь сам.</p>'+
    '<p style="margin-top:10px"><b>👨‍🍳 Персонал</b> — повара (готовят ×2 дольше) и официанты (носят блюда).</p>'+
    '<p style="margin-top:10px"><b>👥 Гости</b> — приходят, садятся за стол, показывают заказ.</p>'+
    '<p style="margin-top:10px"><b>🎨 Creator Mode</b> — бесконечные деньги, все блюда.</p>'+
    '</div>';
  panel.classList.add('on');
}

function boot(){
  ensureFloors();
  var loaded=load();
  if(!loaded){
    placeItem('stove',4,3,0,true);
    placeItem('counter',6,3,0,true);
    placeItem('register',3,8,0,true);
    placeItem('table4',8,7,0,true);
    placeItem('table4',12,7,0,true);
    placeItem('table2',10,4,0,true);
    placeItem('table2',6,6,0,true);
    placeItem('plant',2,2,0,true);
    placeItem('plant',13,9,0,true);
  }
  state.cam.x=state.gridW/2;
  state.cam.y=state.gridH/2;
  updateHUD();
  updateStorageUI();
  $('bFloor').textContent='🏢 Этаж '+(state.floor+1);
  if(!state.upgrades.floor2)$('bFloor').style.display='none';
  setInterval(save,15000);
  window.addEventListener('beforeunload',save);
  requestAnimationFrame(loop);
}

boot();
})();
</script>
</body>
</html>
