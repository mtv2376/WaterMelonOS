","управленческих","познавательной","первоначальный","ограничиваться","управленческий","электрический","воспроизвести","дополнительно","прислушивался","разговаривают","распорядитель","растерянности","отечественные","новороссийска","биологических","революционная","фиксированных","окончательный","оборачиваться","петербургский","дистанционный","давным-давно","сотрудничать","остановилось","осторожности","захлопнулась","раскрывается","традиционных","предпочитали","рассчитывали","комментариев","предлагалось","потребностям","расспрашивал","решительного","беспорядочно","командировку","опубликовано","удивительным","поддерживают","удовольствий","технологиями","федерального","сосредоточив","национальное","преподавания"];

/* ============================================================================
   ЯДРО
   ============================================================================ */
window.KT = window.KT || {};
(function(){
'use strict';

KT.DICT = KT_DICT;
KT.rndWord = function(){
  if(!KT.DICT || !KT.DICT.length) return '';
  return KT.DICT[Math.floor(Math.random()*KT.DICT.length)];
};
KT.rndWords = function(n){
  if(!n || n < 1) return [];
  var out = [];
  for(var i=0;i<n;i++) out.push(KT.rndWord());
  return out;
};

KT.esc = function(s){
  return String(s).replace(/[<>&]/g, function(c){
    return c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;';
  });
};
KT.rnd = function(a){
  if(!a || !a.length) return null;
  return a[Math.floor(Math.random()*a.length)];
};
KT.$id = function(s){ return document.getElementById(s); };
KT.now = function(){ return Date.now(); };
KT.timeShort = function(t){
  var d = new Date(t || Date.now());
  return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
};
KT.buzz = function(ms){
  try { if(navigator.vibrate) navigator.vibrate(ms); } catch(e){}
};
KT.uid = function(){
  return 'x' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
};
KT.sleep = function(ms){
  return new Promise(function(res){ setTimeout(res, ms); });
};

var AI_REGISTRY = {};
var AI_ORDER = [];

KT.registerAI = function(def){
  if(!def || !def.id){ console.warn('[KT.registerAI] нет id'); return false; }
  if(typeof def.send !== 'function'){ console.warn('[KT.registerAI] нет send()'); return false; }
  if(AI_REGISTRY[def.id]){ console.warn('[KT.registerAI] id занят: ' + def.id); return false; }
  AI_REGISTRY[def.id] = {
    id: def.id,
    name: def.name || def.id,
    color: def.color || '#8b5cf6',
    avatar: def.avatar || '🤖',
    description: def.description || '',
    version: def.version || '0.0',
    isError: !!def.isError,
    send: def.send,
    reset: def.reset || function(){},
    getThinking: def.getThinking || function(){ return null; }
  };
  AI_ORDER.push(def.id);
  return true;
};
KT.getAI = function(id){ return AI_REGISTRY[id] || null; };
KT.listAIs = function(){
  var out = [];
  for(var i=0;i<AI_ORDER.length;i++) out.push(AI_REGISTRY[AI_ORDER[i]]);
  return out;
};
KT.countAIs = function(){ return AI_ORDER.length; };
KT.unregisterAllAIs = function(){ AI_REGISTRY = {}; AI_ORDER = []; };

var MessageStore = {
  messages: [],
  add: function(msg){
    if(!msg.id) msg.id = KT.uid();
    if(!msg.time) msg.time = KT.now();
    this.messages.push(msg);
    return msg;
  },
  get: function(id){
    for(var i=0;i<this.messages.length;i++){
      if(this.messages[i].id === id) return this.messages[i];
    }
    return null;
  },
  getAll: function(){ return this.messages.slice(); },
  clear: function(){ this.messages = []; },
  count: function(){ return this.messages.length; },
  toAIContext: function(limit){
    limit = limit || 20;
    return this.messages
      .filter(function(m){ return m.kind !== 'system'; })
      .slice(-limit)
      .map(function(m){
        return {
          role: m.authorId === 'user' ? 'user' : 'ai',
          authorId: m.authorId,
          authorName: m.authorName,
          text: m.text
        };
      });
  }
};
KT.store = MessageStore;

var MODE = {
  current: 'single',
  activeAI: null,
  battle: {
    a: null, b: null, current: 'a',
    rounds: 6, done: 0, delay: 1200,
    running: false, stopFlag: false
  },
  group: {
    members: [],
    currentIdx: 0,
    rounds: 3, totalTurns: 0, done: 0,
    delay: 1200, running: false, stopFlag: false
  },
  setMode: function(mode){
    if(['single','battle','group'].indexOf(mode) === -1) return;
    this.current = mode;
    if(KT.UI && KT.UI.updateModeBadge) KT.UI.updateModeBadge();
    if(KT.UI && KT.UI.updateAppState) KT.UI.updateAppState();
  },
  setActiveAI: function(id){
    if(!AI_REGISTRY[id]) return;
    this.activeAI = id;
    if(KT.UI && KT.UI.updateAISelector) KT.UI.updateAISelector();
  },
  getActiveAI: function(){
    if(this.activeAI && AI_REGISTRY[this.activeAI]) return this.activeAI;
    return AI_ORDER[0] || null;
  },
  isRunning: function(){
    return this.battle.running || this.group.running;
  }
};
KT.mode = MODE;

var Renderer = {
  chatEl: null,
  typingEl: null,
  init: function(){ this.chatEl = KT.$id('chat'); },
  clear: function(){ if(this.chatEl) this.chatEl.innerHTML = ''; },
  addBubble: function(msg){
    if(!this.chatEl) return null;
    var el = document.createElement('div');
    var isUser = msg.authorId === 'user';

    if(msg.kind === 'system'){
      el.className = 'msg system';
      el.innerHTML = KT.esc(msg.text);
    } else if(isUser){
      el.className = 'msg user';
      el.innerHTML = KT.esc(msg.text) + '<small>' + KT.timeShort(msg.time) + '</small>';
    } else {
      el.className = 'msg ai';
      var ai = KT.getAI(msg.authorId);
      var aiColor = ai ? ai.color : '#8b5cf6';
      var aiAvatar = ai ? ai.avatar : '🤖';
      var avatarHtml;
      if(aiAvatar && aiAvatar.indexOf && aiAvatar.indexOf('http') === 0){
        avatarHtml = '<img src="' + KT.esc(aiAvatar) + '" alt="">';
      } else {
        avatarHtml = KT.esc(String(aiAvatar));
      }
      var head = '<div class="msg-head" style="color:' + aiColor + '">' +
        '<span class="mini-avatar" style="background:' + aiColor + '">' +
        avatarHtml + '</span>' +
        '<span>' + KT.esc(msg.authorName || 'AI') + '</span>' +
        '</div>';
      el.style.setProperty('--ai-color', aiColor);
      el.innerHTML = head +
        '<div class="msg-text">' + KT.esc(msg.text) + '</div>' +
        '<small>' + KT.timeShort(msg.time) + '</small>';

      if(msg.thinking){
        var th = document.createElement('div');
        th.className = 'thinking';
        th.innerHTML =
          '<div class="thinking-head">' +
            '<span class="arrow">▸</span>' +
            '<span class="tt">🧠 размышления</span>' +
            '<span class="dur">' + (msg.timeMs ? (msg.timeMs + 'мс') : '') + '</span>' +
          '</div>' +
          '<div class="thinking-body">' + KT.esc(msg.thinking) + '</div>';
        th.querySelector('.thinking-head').onclick = function(ev){
          ev.preventDefault();
          ev.stopPropagation();
          th.classList.toggle('expanded');
        };
        el.appendChild(th);
      }
    }

    this.chatEl.appendChild(el);
    this.scrollBottom();
    return el;
  },
  scrollBottom: function(){
    if(this.chatEl) this.chatEl.scrollTop = this.chatEl.scrollHeight;
  },
  showTyping: function(aiId){
    if(this.typingEl) return;
    var ai = KT.getAI(aiId);
    var color = ai ? ai.color : '#8b5cf6';
    this.typingEl = document.createElement('div');
    this.typingEl.className = 'typing';
    this.typingEl.style.borderLeft = '3px solid ' + color;
    this.typingEl.innerHTML =
      '<span class="pulse"></span><span class="pulse"></span><span class="pulse"></span>' +
      '<span>' + KT.esc(ai ? ai.name : 'AI') + ' думает…</span>';
    this.chatEl.appendChild(this.typingEl);
    this.scrollBottom();
  },
  hideTyping: function(){
    if(this.typingEl && this.typingEl.parentNode){
      this.typingEl.parentNode.removeChild(this.typingEl);
    }
    this.typingEl = null;
  }
};
KT.renderer = Renderer;

KT.injectTone = function(currentText){
  var MAT = /(блять|блядь|бля|хуй|хуя|хуё|хуе|пизд|ебат|ебал|ебан|ёб|сука|нахуй|ахуе|охуе|долбоёб|мудак|мразь|тварь|пидор|гандон|шлюх|уёбищ|залуп)/i;
  /* если в текущем тексте уже есть мат — ничего не добавляем */
  if (MAT.test(currentText)) return currentText;
  /* ищем в последних 6 сообщениях */
  var recent = KT.store.getAll().slice(-6);
  var found = null;
  for (var i = recent.length - 1; i >= 0; i--){
    var m = recent[i].text.match(MAT);
    if (m){ found = m[0]; break; }
  }
  if (!found) return currentText;
  return currentText + ' («фон: ' + found + '»)';
};

var ChatEngine = {
  sendUserMessage: async function(text){
    text = String(text || '').trim();
    if(!text) return;
    if(MODE.isRunning()){ if(KT.UI) KT.UI.toast('Батл идёт'); return; }

    var userMsg = KT.store.add({
      authorId: 'user', authorName: 'Ты', text: text, kind: 'user'
    });
    KT.renderer.addBubble(userMsg);

    if(MODE.current === 'single'){
      await this.respondSingle(text);
    }
  },

  respondSingle: async function(text){
    var aiId = MODE.getActiveAI();
    if(!aiId){ this.systemNote('Нет ИИ'); return; }
    var ai = KT.getAI(aiId);
    if(!ai){ this.systemNote('ИИ не найден'); return; }

    KT.renderer.showTyping(aiId);
    var t0 = KT.now();
    var reply = null;
    try {
      reply = await ai.send(text, {
        history: KT.store.toAIContext(20),
        lastUserText: text,
        fromAI: false
      });
    } catch(e){
      console.error('[respondSingle]', e);
      reply = 'Ошибка: ' + (e && e.message ? e.message : e);
    }
    var dt = KT.now() - t0;
    KT.renderer.hideTyping();

    var replyText, thinking;
    if(reply && typeof reply === 'object'){
      replyText = reply.text || '';
      thinking = reply.thinking || null;
    } else {
      replyText = reply;
      thinking = ai.getThinking ? ai.getThinking() : null;
    }
    if(!replyText) replyText = '…';

    KT.renderer.addBubble(KT.store.add({
      authorId: aiId, authorName: ai.name,
      text: replyText, thinking: thinking, timeMs: dt, kind: 'ai'
    }));
  },

  systemNote: function(text){
    KT.renderer.addBubble(KT.store.add({
      authorId: 'system', authorName: 'system',
      text: text, kind: 'system'
    }));
  },

  /* ============ 1v1 BATTLE ============ */
  startBattle: async function(opts){
    if(MODE.isRunning()){ this.systemNote('Батл уже идёт'); return; }
    var a = KT.getAI(opts.aId);
    var b = KT.getAI(opts.bId);
    if(!a || !b){ this.systemNote('Battle: ИИ не найден'); return; }

    var prevActive = MODE.activeAI;

    MODE.battle.a = a.id;
    MODE.battle.b = b.id;
    MODE.battle.current = 'a';
    MODE.battle.rounds = opts.rounds || 6;
    MODE.battle.done = 0;
    MODE.battle.delay = opts.delay || 1200;
    MODE.battle.running = true;
    MODE.battle.stopFlag = false;

    MODE.setMode('battle');

    var prog = KT.$id('battleProgress');
    var fill = KT.$id('battleFill');
    if(prog){ prog.classList.add('on'); prog.classList.remove('group'); }
    if(fill) fill.style.width = '0%';

    var topic = String(opts.topic || '').trim() || 'Начни разговор первым.';
    var sameLabel = (a.id === b.id) ? ' (сам с собой)' : '';
    this.systemNote('⚔ Battle: ' + a.name + ' vs ' + b.name + sameLabel +
                    ' · ' + MODE.battle.rounds + ' раундов');

    KT.renderer.addBubble(KT.store.add({
      authorId: 'user', authorName: 'Ты', text: topic, kind: 'user'
    }));

    var lastText = topic;
    var lastFromAI = null;

    while(MODE.battle.running && MODE.battle.done < MODE.battle.rounds){
      if(MODE.battle.stopFlag) break;

      var currentAI = (MODE.battle.current === 'a') ? a : b;
      var otherAI = (MODE.battle.current === 'a') ? b : a;

      KT.renderer.showTyping(currentAI.id);
      await KT.sleep(MODE.battle.delay);
      KT.renderer.hideTyping();

      var t0 = KT.now();
      var reply = null;
      try {
        reply = await currentAI.send(KT.injectTone(lastText), {
          history: KT.store.toAIContext(30),
          lastUserText: lastText,
          fromAI: !!lastFromAI,
          opponentName: otherAI.name,
          isBattle: true
        });
      } catch(e){
        reply = 'Ошибка: ' + (e && e.message ? e.message : e);
      }
      var dt = KT.now() - t0;

      var replyText, thinking;
      if(reply && typeof reply === 'object'){
        replyText = reply.text || '';
        thinking = reply.thinking || null;
      } else {
        replyText = reply;
        thinking = currentAI.getThinking ? currentAI.getThinking() : null;
      }
      if(!replyText) replyText = '…';

      KT.renderer.addBubble(KT.store.add({
        authorId: currentAI.id, authorName: currentAI.name,
        text: replyText, thinking: thinking, timeMs: dt, kind: 'ai'
      }));

      lastText = replyText;
      lastFromAI = currentAI.id;
      MODE.battle.current = (MODE.battle.current === 'a') ? 'b' : 'a';
      MODE.battle.done++;

      if(fill) fill.style.width = ((MODE.battle.done / MODE.battle.rounds) * 100) + '%';
    }

    var wasCancelled = MODE.battle.stopFlag;
    MODE.battle.running = false;
    MODE.battle.stopFlag = false;
    this.systemNote(wasCancelled
      ? '⚔ Battle прерван · раундов: ' + MODE.battle.done
      : '⚔ Battle завершён · раундов: ' + MODE.battle.done);
    if(prog) prog.classList.remove('on');

    MODE.current = 'single';
    MODE.activeAI = prevActive && KT.getAI(prevActive) ? prevActive : MODE.getActiveAI();
    if(KT.UI && KT.UI.updateModeBadge) KT.UI.updateModeBadge();
    if(KT.UI && KT.UI.updateAISelector) KT.UI.updateAISelector();
    if(KT.UI && KT.UI.updateAppState) KT.UI.updateAppState();
  },

  /* ============ GROUP BATTLE (2+ ИИ) ============ */
  startGroupBattle: async function(opts){
    if(MODE.isRunning()){ this.systemNote('Батл уже идёт'); return; }

    var ids = opts.memberIds || [];
    var ais = [];
    for(var i=0;i<ids.length;i++){
      var ai = KT.getAI(ids[i]);
      if(ai) ais.push(ai);
    }
    if(ais.length < 2){ this.systemNote('Групповой батл: нужно 2+ ИИ'); return; }

    var prevActive = MODE.activeAI;

    MODE.group.members = ais.map(function(a){ return a.id; });
    MODE.group.rounds = Math.max(1, opts.rounds || 3);
    MODE.group.totalTurns = MODE.group.rounds * ais.length;
    MODE.group.done = 0;
    MODE.group.currentIdx = 0;
    MODE.group.delay = opts.delay || 1200;
    MODE.group.running = true;
    MODE.group.stopFlag = false;

    MODE.setMode('group');

    var prog = KT.$id('battleProgress');
    var fill = KT.$id('battleFill');
    if(prog){ prog.classList.add('on'); prog.classList.add('group'); }
    if(fill) fill.style.width = '0%';

    var topic = String(opts.topic || '').trim() || 'Начните разговор первым.';
    this.systemNote('👥 Групповой батл: ' + ais.map(function(a){return a.name;}).join(' × ') +
                    ' · ' + MODE.group.rounds + ' раундов × ' + ais.length + ' ИИ');

    KT.renderer.addBubble(KT.store.add({
      authorId: 'user', authorName: 'Ты', text: topic, kind: 'user'
    }));

    var lastText = topic;
    var lastFromAI = null;
    var membersPublic = ais.map(function(a){ return {id: a.id, name: a.name}; });

    while(MODE.group.running && MODE.group.done < MODE.group.totalTurns){
      if(MODE.group.stopFlag) break;

      var idx = MODE.group.done % ais.length;
      var currentAI = ais[idx];
      var prevAI = lastFromAI ? KT.getAI(lastFromAI) : null;

      KT.renderer.showTyping(currentAI.id);
      await KT.sleep(MODE.group.delay);
      KT.renderer.hideTyping();

      var t0 = KT.now();
      var reply = null;
      try {
        reply = await currentAI.send(KT.injectTone(lastText), {
          history: KT.store.toAIContext(30),
          lastUserText: lastText,
          fromAI: !!lastFromAI,
          opponentName: prevAI ? prevAI.name : 'пользователь',
          isBattle: true,
          isGroup: true,
          groupMembers: membersPublic,
          turnIndex: idx,
          turnTotal: ais.length,
          roundIndex: Math.floor(MODE.group.done / ais.length)
        });
      } catch(e){
        reply = 'Ошибка: ' + (e && e.message ? e.message : e);
      }
      var dt = KT.now() - t0;

      var replyText, thinking;
      if(reply && typeof reply === 'object'){
        replyText = reply.text || '';
        thinking = reply.thinking || null;
      } else {
        replyText = reply;
        thinking = currentAI.getThinking ? currentAI.getThinking() : null;
      }
      if(!replyText) replyText = '…';

      KT.renderer.addBubble(KT.store.add({
        authorId: currentAI.id, authorName: currentAI.name,
        text: replyText, thinking: thinking, timeMs: dt, kind: 'ai'
      }));

      lastText = replyText;
      lastFromAI = currentAI.id;
      MODE.group.done++;

      if(fill) fill.style.width = ((MODE.group.done / MODE.group.totalTurns) * 100) + '%';
    }

    var wasCancelled = MODE.group.stopFlag;
    MODE.group.running = false;
    MODE.group.stopFlag = false;
    this.systemNote(wasCancelled
      ? '👥 Групповой батл прерван · реплик: ' + MODE.group.done
      : '👥 Групповой батл завершён · реплик: ' + MODE.group.done);
    if(prog){ prog.classList.remove('on'); prog.classList.remove('group'); }

    MODE.current = 'single';
    MODE.activeAI = prevActive && KT.getAI(prevActive) ? prevActive : MODE.getActiveAI();
    if(KT.UI && KT.UI.updateModeBadge) KT.UI.updateModeBadge();
    if(KT.UI && KT.UI.updateAISelector) KT.UI.updateAISelector();
    if(KT.UI && KT.UI.updateAppState) KT.UI.updateAppState();
  },

  stopBattle: function(){
    if(MODE.battle.running) MODE.battle.stopFlag = true;
    if(MODE.group.running) MODE.group.stopFlag = true;
    var prog = KT.$id('battleProgress');
    if(prog) prog.classList.remove('on');
  },

  resetAll: async function(){
    var list = KT.listAIs();
    for(var i=0;i<list.length;i++){
      try { await list[i].reset(); } catch(e){}
    }
    KT.store.clear();
    KT.renderer.clear();
  }
};
KT.chat = ChatEngine;

var CopyTools = {
  copyFullHistory: function(){
    var list = KT.store.getAll();
    var lines = [];
    for(var i=0;i<list.length;i++){
      var m = list[i];
      var who = (m.authorId === 'user') ? 'Ты' : (m.authorName || 'AI');
      lines.push('[' + KT.timeShort(m.time) + '] ' + who + ': ' + m.text);
    }
    return lines.join('\n');
  },
  copySelected: function(ids){
    if(!ids || !ids.length) return '';
    var lines = [];
    for(var i=0;i<ids.length;i++){
      var m = KT.store.get(ids[i]);
      if(!m) continue;
      var who = (m.authorId === 'user') ? 'Ты' : (m.authorName || 'AI');
      lines.push('[' + KT.timeShort(m.time) + '] ' + who + ': ' + m.text);
    }
    return lines.join('\n');
  },
  copyOne: function(id){
    var m = KT.store.get(id);
    if(!m) return '';
    return m.text;
  }
};
KT.copy = CopyTools;

KT.initRenderer = function(){ KT.renderer.init(); };

})();

/* ============================================================================
   UI
   ============================================================================ */
(function(){
'use strict';

function $id(s){ return document.getElementById(s); }

(function(){
  function setVH(){
    var h = window.innerHeight;
    document.documentElement.style.setProperty('--vh', h + 'px');
    document.body.style.height = h + 'px';
  }
  setVH();
  window.addEventListener('resize', setVH);
  window.addEventListener('orientationchange', setVH);
  if(window.visualViewport) window.visualViewport.addEventListener('resize', setVH);
  setTimeout(setVH, 100);
  setTimeout(setVH, 500);
})();

function toast(text, dur){
  dur = dur || 1800;
  var t = document.createElement('div');
  t.className = 'toast';
  t.textContent = text;
  document.body.appendChild(t);
  setTimeout(function(){ t.classList.add('show'); }, 10);
  setTimeout(function(){
    t.classList.remove('show');
    setTimeout(function(){ if(t.parentNode) t.parentNode.removeChild(t); }, 350);
  }, dur);
}

async function copyToClipboard(text){
  if(!text){ toast('Пусто'); return false; }
  try {
    if(navigator.clipboard && navigator.clipboard.writeText){
      await navigator.clipboard.writeText(text);
      toast('Скопировано ✓');
      return true;
    }
  } catch(e){}
  try {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    toast('Скопировано ✓');
    return true;
  } catch(e){}
  toast('Не удалось скопировать');
  return false;
}

var UI = {};
UI.toast = toast;

function showOverlay(id){ var el = $id(id); if(el) el.classList.add('on'); }
function hideOverlay(id){ var el = $id(id); if(el) el.classList.remove('on'); }
function isOverlayOn(id){ var el = $id(id); return el && el.classList.contains('on'); }

UI.showOverlay = showOverlay;
UI.hideOverlay = hideOverlay;
UI.isOverlayOn = isOverlayOn;

['menu','battle','groupBattle','themePicker','aiPicker'].forEach(function(id){
  var el = $id(id);
  if(!el) return;
  el.onclick = function(e){
    if(e.target !== el) return;
    if(id === 'battle' && KT.mode.battle.running){ toast('Бой идёт'); return; }
    if(id === 'groupBattle' && KT.mode.group.running){ toast('Бой идёт'); return; }
    hideOverlay(id);
  };
});

document.addEventListener('keydown', function(e){
  if(e.key !== 'Escape') return;
  if(isOverlayOn('aiPicker')){ hideOverlay('aiPicker'); return; }
  if(isOverlayOn('themePicker')){ hideOverlay('themePicker'); return; }
  if(isOverlayOn('battle')){
    if(KT.mode.battle.running){ toast('Бой идёт'); return; }
    hideOverlay('battle'); return;
  }
  if(isOverlayOn('groupBattle')){
    if(KT.mode.group.running){ toast('Бой идёт'); return; }
    hideOverlay('groupBattle'); return;
  }
  if(isOverlayOn('menu')){ hideOverlay('menu'); return; }
});

UI.updateAppState = function(){
  var app = $id('app');
  if(!app) return;
  if(KT.mode.isRunning()) app.classList.add('running');
  else app.classList.remove('running');
};

UI.updateAISelector = function(){
  var sel = $id('aiSelector');
  if(!sel) return;
  var list = KT.listAIs();
  var activeId = KT.mode.getActiveAI();
  var ai = activeId ? KT.getAI(activeId) : null;

  if(!ai){
    sel.classList.add('empty');
    sel.querySelector('.sel-avatar').innerHTML = '?';
    sel.querySelector('.sel-avatar').style.background = 'var(--accent)';
    sel.querySelector('.sel-name').textContent = list.length ? 'Выбрать ИИ' : 'Нет ИИ';
    sel.querySelector('.sel-sub').textContent = list.length ? 'не выбран' : 'подключи слот';
    return;
  }
  sel.classList.remove('empty');
  var avatarEl = sel.querySelector('.sel-avatar');
  if(ai.avatar && ai.avatar.indexOf && ai.avatar.indexOf('http') === 0){
    avatarEl.innerHTML = '<img src="' + KT.esc(ai.avatar) + '" alt="">';
  } else {
    avatarEl.textContent = String(ai.avatar);
  }
  avatarEl.style.background = ai.color || 'var(--accent)';
  sel.querySelector('.sel-name').textContent = ai.name;
  sel.querySelector('.sel-sub').textContent =
    (ai.isError ? '⚠ ошибка загрузки' : (ai.description || 'v' + ai.version));
};

UI.updateModeBadge = function(){
  var b = $id('modeBadge');
  if(!b) return;
  var labels = { single: 'SINGLE', battle: 'BATTLE', group: 'GROUP' };
  b.textContent = labels[KT.mode.current] || KT.mode.current.toUpperCase();
  var colors = { single: 'var(--accent)', battle: '#78350f', group: '#166534' };
  b.style.background = colors[KT.mode.current] || 'var(--accent)';
};

/* --- AI Picker (single + battle slot) --- */
var aiPickContext = { mode: 'single', battleSlot: null };
var battleSlotA = null;
var battleSlotB = null;

function renderAIPicker(filter){
  var list = $id('aiList');
  if(!list) return;
  filter = (filter || '').toLowerCase().trim();
  var ais = KT.listAIs();
  var filtered = filter
    ? ais.filter(function(a){
        return (a.name + ' ' + a.id + ' ' + (a.description || '')).toLowerCase().indexOf(filter) !== -1;
      })
    : ais;

  list.innerHTML = '';

  if(!filtered.length){
    var empty = document.createElement('div');
    empty.className = 'empty';
    if(ais.length){
      empty.textContent = 'Ничего не найдено по «' + filter + '»';
    } else {
      empty.innerHTML = 'ИИ не подключены.<br>Добавь <code>&lt;script type="text/html" id="ai-slot-N"&gt;</code> в конец файла.';
    }
    list.appendChild(empty);
    return;
  }

  var activeId = KT.mode.getActiveAI();

  for(var i=0;i<filtered.length;i++){
    var ai = filtered[i];
    var item = document.createElement('div');
    item.className = 'ai-item';

    var isActive = (ai.id === activeId) && aiPickContext.mode === 'single';
    var isBattleA = (ai.id === battleSlotA);
    var isBattleB = (ai.id === battleSlotB);

    if(isActive) item.classList.add('active');
    if(aiPickContext.mode === 'battle' && (isBattleA || isBattleB)) item.classList.add('in-battle');
    if(ai.isError) item.classList.add('error');

    var avatarHtml;
    if(ai.avatar && ai.avatar.indexOf && ai.avatar.indexOf('http') === 0){
      avatarHtml = '<img src="' + KT.esc(ai.avatar) + '" alt="">';
    } else {
      avatarHtml = KT.esc(String(ai.avatar));
    }

    var badges = '';
    if(aiPickContext.mode === 'single' && isActive){
      badges = '<span class="item-badge">активен</span>';
    } else if(aiPickContext.mode === 'battle'){
      if(isBattleA && isBattleB){
        badges = '<span class="item-badge">#1</span><span class="item-badge b2">#2</span>';
      } else if(isBattleA){
        badges = '<span class="item-badge">#1</span>';
      } else if(isBattleB){
        badges = '<span class="item-badge b2">#2</span>';
      }
    }

    item.innerHTML =
      '<div class="item-avatar" style="background:' + (ai.color || 'var(--accent)') + '">' +
        avatarHtml +
      '</div>' +
      '<div class="item-info">' +
        '<div class="item-name">' + KT.esc(ai.name) + '</div>' +
        '<div class="item-desc">' + KT.esc(ai.description || 'v' + ai.version) + '</div>' +
      '</div>' + badges;

    item.onclick = (function(id){
      return function(){
        if(aiPickContext.mode === 'single'){
          KT.mode.setActiveAI(id);
          KT.mode.setMode('single');
          hideOverlay('aiPicker');
          toast('ИИ: ' + KT.getAI(id).name);
        } else {
          if(aiPickContext.battleSlot === 'a') battleSlotA = id;
          else if(aiPickContext.battleSlot === 'b') battleSlotB = id;
          updateBattleSlots();
          hideOverlay('aiPicker');
        }
      };
    })(ai.id);

    list.appendChild(item);
  }
}

function openAIPicker(opts){
  opts = opts || {};
  aiPickContext.mode = opts.mode || 'single';
  aiPickContext.battleSlot = opts.battleSlot || null;

  var title = $id('aiPickerTitle');
  if(title){
    if(aiPickContext.mode === 'battle'){
      title.textContent = 'Выбор ИИ · слот #' + (aiPickContext.battleSlot === 'a' ? '1' : '2');
    } else {
      title.textContent = 'Выбор ИИ';
    }
  }

  var search = $id('aiSearch');
  search.value = '';
  search.oninput = function(){ renderAIPicker(search.value); };

  renderAIPicker('');
  showOverlay('aiPicker');
  setTimeout(function(){ search.focus(); }, 100);
}

UI.openAIPicker = openAIPicker;

$id('aiSelector').onclick = function(){
  if(KT.mode.isRunning()) return;
  openAIPicker({ mode: 'single' });
};
$id('aiPickerClose').onclick = function(){ hideOverlay('aiPicker'); };

/* --- Часы --- */
(function(){
  var el = $id('clock');
  if(!el) return;
  function tick(){
    var d = new Date();
    el.textContent = ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
  }
  tick();
  setInterval(tick, 15000);
})();

/* --- Инпут --- */
var inputEl = $id('chatIn');
var sendBtn = $id('chatSend');

sendBtn.onclick = function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  var text = inputEl.value.trim();
  if(!text) return;
  inputEl.value = '';
  KT.chat.sendUserMessage(text);
  KT.buzz(8);
};

inputEl.onkeydown = function(e){
  if(e.key === 'Enter'){ e.preventDefault(); sendBtn.click(); }
};

/* --- Меню --- */
$id('btnMenu').onclick = function(){ showOverlay('menu'); };
$id('menuClose').onclick = function(){ hideOverlay('menu'); };

$id('mExport').onclick = function(){
  copyToClipboard(KT.copy.copyFullHistory());
  hideOverlay('menu');
};

$id('mClear').onclick = function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  if(!confirm('Очистить чат?')) return;
  KT.store.clear();
  KT.renderer.clear();
  hideOverlay('menu');
  toast('Чат очищен');
};

$id('mReset').onclick = async function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  if(!confirm('Сбросить все ИИ?')) return;
  await KT.chat.resetAll();
  hideOverlay('menu');
  toast('Все ИИ сброшены');
};

$id('mInfo').onclick = function(){
  hideOverlay('menu');
  var list = KT.listAIs();
  if(!list.length){ alert('ИИ не подключены.\n\nДобавь <script type="text/html" id="ai-slot-N"> в конец HTML.'); return; }
  var lines = ['Подключённые ИИ (' + list.length + '):', ''];
  for(var i=0;i<list.length;i++){
    var ai = list[i];
    lines.push('• ' + ai.name + ' (' + ai.id + ')');
    if(ai.description) lines.push('  ' + ai.description);
    lines.push('  v' + ai.version + (ai.isError ? ' · ОШИБКА' : ''));
    lines.push('');
  }
  alert(lines.join('\n'));
};

$id('mReload').onclick = async function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  hideOverlay('menu');
  try {
    await KT.reloadAISlots();
    UI.updateAISelector();
    toast('ИИ перезагружены');
  } catch(e){
    console.error('[Reload]', e);
    toast('Ошибка: ' + (e.message || e));
  }
};

$id('mStop').onclick = function(){
  hideOverlay('menu');
  if(!KT.mode.isRunning()){ toast('Нечего останавливать'); return; }
  KT.chat.stopBattle();
  toast('Останавливаю…');
};

/* --- Selection --- */
var selectionMode = false;
var selectedIds = {};

function enterSelection(){
  selectionMode = true;
  selectedIds = {};
  $id('app').classList.add('selecting');
  document.querySelectorAll('#chat .msg').forEach(function(el){
    var id = el.dataset.id;
    if(!id) return;
    el.style.cursor = 'pointer';
    el.onclick = function(ev){
      ev.stopPropagation();
      if(selectedIds[id]){
        delete selectedIds[id];
        el.classList.remove('selected');
      } else {
        selectedIds[id] = true;
        el.classList.add('selected');
      }
      updateSelectBar();
    };
  });
  updateSelectBar();
  $id('selectBar').classList.add('on');
}

function exitSelection(){
  selectionMode = false;
  selectedIds = {};
  $id('app').classList.remove('selecting');
  document.querySelectorAll('#chat .msg').forEach(function(el){
    el.classList.remove('selected');
    el.onclick = null;
    el.style.cursor = '';
  });
  $id('selectBar').classList.remove('on');
}

function updateSelectBar(){
  $id('selectInfo').textContent = 'Выбрано: ' + Object.keys(selectedIds).length;
}

$id('mSelect').onclick = function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  hideOverlay('menu');
  enterSelection();
  toast('Тапни сообщения для выбора');
};

$id('btnCopySelected').onclick = function(){
  var ids = Object.keys(selectedIds);
  if(!ids.length){ toast('Ничего не выбрано'); return; }
  copyToClipboard(KT.copy.copySelected(ids));
  exitSelection();
};

$id('btnCancelSelect').onclick = function(){ exitSelection(); };

/* --- Long tap copy --- */
(function(){
  var chat = $id('chat');
  var timer = null, target = null;

  chat.addEventListener('touchstart', function(e){
    var el = e.target.closest && e.target.closest('.msg');
    if(!el) return;
    if(selectionMode) return;
    target = el;
    timer = setTimeout(function(){
      if(!target) return;
      var id = target.dataset.id;
      if(!id) return;
      var msg = KT.store.get(id);
      if(!msg) return;
      copyToClipboard(msg.text);
      KT.buzz(15);
      target = null;
    }, 600);
  }, { passive: true });

  function clear(){
    if(timer){ clearTimeout(timer); timer = null; }
    target = null;
  }
  chat.addEventListener('touchend', clear);
  chat.addEventListener('touchcancel', clear);
  chat.addEventListener('touchmove', clear);
})();

/* --- Темы --- */
var THEMES = [
  { id: 'purple', name: 'Purple Night', colors: ['#8b5cf6', '#0b0b12', '#241543'] },
  { id: 'dark', name: 'Dark', colors: ['#5b8def', '#111318', '#1c1f26'] },
  { id: 'amoled', name: 'AMOLED', colors: ['#00d4ff', '#000', '#0f0f0f'] },
  { id: 'nord', name: 'Nord', colors: ['#88c0d0', '#2e3440', '#3b4252'] },
  { id: 'solarized', name: 'Solarized', colors: ['#b58900', '#002b36', '#073642'] },
  { id: 'sepia', name: 'Sepia', colors: ['#8b6f47', '#f4ecd8', '#e8dfc8'] },
  { id: 'light', name: 'Light', colors: ['#6366f1', '#fff', '#f0f0f3'] },
  { id: 'ocean', name: 'Ocean', colors: ['#0ea5e9', '#0a1929', '#0d2137'] },
  { id: 'forest', name: 'Forest', colors: ['#16a34a', '#0a1f14', '#0d2e1e'] },
  { id: 'cyberpunk', name: 'Cyberpunk', colors: ['#ff79c6', '#0d0221', '#190b3a'] },
  { id: 'sunset', name: 'Sunset', colors: ['#f97316', '#1a0e0a', '#2d1810'] },
  { id: 'rose', name: 'Rose', colors: ['#ec4899', '#1f0a1a', '#2e1028'] },
  { id: 'matrix', name: 'Matrix', colors: ['#00ff41', '#000', '#001100'] }
];

function applyTheme(id){
  if(!THEMES.some(function(t){ return t.id === id; })) id = 'purple';
  document.documentElement.setAttribute('data-theme', id);
  try { localStorage.setItem('kt_theme', id); } catch(e){}
  var meta = document.querySelector('meta[name="theme-color"]');
  if(meta){
    var theme = THEMES.filter(function(t){ return t.id === id; })[0];
    if(theme) meta.setAttribute('content', theme.colors[1]);
  }
}

function loadSavedTheme(){
  var saved = null;
  try { saved = localStorage.getItem('kt_theme'); } catch(e){}
  applyTheme(saved || 'purple');
}

UI.openThemePicker = function(){
  var grid = $id('themeGrid');
  grid.innerHTML = '';
  var current = document.documentElement.getAttribute('data-theme') || 'purple';

  for(var i=0;i<THEMES.length;i++){
    var t = THEMES[i];
    var item = document.createElement('div');
    item.className = 'theme-item' + (t.id === current ? ' active' : '');
    var c1 = t.colors[0], c2 = t.colors[1], c3 = t.colors[2];
    item.innerHTML =
      '<div class="theme-swatch" style="background:linear-gradient(135deg,' + c1 + ' 0%,' +
        c1 + ' 33%,' + c2 + ' 33%,' + c2 + ' 66%,' + c3 + ' 66%,' + c3 + ' 100%);"></div>' +
      '<div class="theme-name">' + KT.esc(t.name) + '</div>';
    item.onclick = (function(id){
      return function(){
        applyTheme(id);
        var items = grid.querySelectorAll('.theme-item');
        for(var k=0;k<items.length;k++) items[k].classList.remove('active');
        item.classList.add('active');
        toast('Тема: ' + id);
      };
    })(t.id);
    grid.appendChild(item);
  }
  showOverlay('themePicker');
};

$id('themePickerClose').onclick = function(){ hideOverlay('themePicker'); };
$id('mTheme').onclick = function(){ hideOverlay('menu'); UI.openThemePicker(); };

/* --- Battle 1v1 --- */
function updateBattleSlots(){
  var slotA = $id('bSlotA');
  var slotB = $id('bSlotB');
  var a = battleSlotA ? KT.getAI(battleSlotA) : null;
  var b = battleSlotB ? KT.getAI(battleSlotB) : null;

  function fillSlot(slotEl, ai){
    if(!ai){
      slotEl.classList.add('empty');
      slotEl.querySelector('.bs-name').textContent = 'Выбрать';
      var av = slotEl.querySelector('.bs-avatar');
      av.innerHTML = '?';
      av.style.background = 'var(--border2)';
      slotEl.style.borderColor = '';
      return;
    }
    slotEl.classList.remove('empty');
    slotEl.querySelector('.bs-name').textContent = ai.name;
    var avatar = slotEl.querySelector('.bs-avatar');
    if(ai.avatar && ai.avatar.indexOf && ai.avatar.indexOf('http') === 0){
      avatar.innerHTML = '<img src="' + KT.esc(ai.avatar) + '" alt="">';
    } else {
      avatar.textContent = String(ai.avatar);
    }
    avatar.style.background = ai.color || 'var(--accent)';
    slotEl.style.borderColor = ai.color || '';
  }

  fillSlot(slotA, a);
  fillSlot(slotB, b);

  var same = battleSlotA && battleSlotB && battleSlotA === battleSlotB;
  slotA.classList.toggle('same', !!same);
  slotB.classList.toggle('same', !!same);

  var startBtn = $id('btnBattleStart');
  if(startBtn) startBtn.disabled = !(battleSlotA && battleSlotB);
}

$id('bSlotA').onclick = function(){
  if(KT.mode.isRunning()) return;
  openAIPicker({ mode: 'battle', battleSlot: 'a' });
};
$id('bSlotB').onclick = function(){
  if(KT.mode.isRunning()) return;
  openAIPicker({ mode: 'battle', battleSlot: 'b' });
};

function openBattlePanel(){
  var list = KT.listAIs();
  if(list.length < 1){ alert('Нужен минимум 1 ИИ. Подключи слот.'); return; }
  if(battleSlotA && !KT.getAI(battleSlotA)) battleSlotA = null;
  if(battleSlotB && !KT.getAI(battleSlotB)) battleSlotB = null;
  if(!battleSlotA) battleSlotA = list[0].id;
  if(!battleSlotB){
    if(list.length >= 2){
      for(var i=0;i<list.length;i++){
        if(list[i].id !== battleSlotA){ battleSlotB = list[i].id; break; }
      }
    } else {
      battleSlotB = battleSlotA;
    }
  }
  updateBattleSlots();
  showOverlay('battle');
}

$id('btnBattle').onclick = function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  openBattlePanel();
};
$id('mBattle').onclick = function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  hideOverlay('menu'); openBattlePanel();
};
$id('battleClose').onclick = function(){
  if(KT.mode.battle.running){ toast('Бой идёт'); return; }
  hideOverlay('battle');
};
$id('btnBattleCancel').onclick = function(){
  if(KT.mode.battle.running){ toast('Бой идёт'); return; }
  hideOverlay('battle');
};

$id('btnBattleStart').onclick = function(){
  if(!battleSlotA || !battleSlotB){ alert('Выбери двух ИИ'); return; }
  var rounds = parseInt($id('bRounds').value, 10) || 6;
  var delay = parseInt($id('bDelay').value, 10) || 1200;
  var topic = $id('bTopic').value.trim();
  hideOverlay('battle');
  KT.chat.startBattle({
    aId: battleSlotA, bId: battleSlotB,
    rounds: rounds, delay: delay, topic: topic
  });
};

/* --- Group Battle --- */
var groupSelected = {};

function renderGroupPicker(){
  var list = $id('groupAiList');
  if(!list) return;
  list.innerHTML = '';
  var ais = KT.listAIs();

  if(!ais.length){
    var empty = document.createElement('div');
    empty.className = 'empty';
    empty.innerHTML = 'ИИ не подключены.<br>Добавь <code>&lt;script type="text/html" id="ai-slot-N"&gt;</code> в конец файла.';
    list.appendChild(empty);
    updateGroupInfo();
    return;
  }

  for(var i=0;i<ais.length;i++){
    var ai = ais[i];
    var item = document.createElement('div');
    item.className = 'ai-item' + (groupSelected[ai.id] ? ' in-group' : '') + (ai.isError ? ' error' : '');
    var avatarHtml;
    if(ai.avatar && ai.avatar.indexOf && ai.avatar.indexOf('http') === 0){
      avatarHtml = '<img src="' + KT.esc(ai.avatar) + '" alt="">';
    } else {
      avatarHtml = KT.esc(String(ai.avatar));
    }
    var badge = groupSelected[ai.id] ? '<span class="item-badge">в бою</span>' : '';
    item.innerHTML =
      '<div class="item-avatar" style="background:' + (ai.color || 'var(--accent)') + '">' +
        avatarHtml + '</div>' +
      '<div class="item-info">' +
        '<div class="item-name">' + KT.esc(ai.name) + '</div>' +
        '<div class="item-desc">' + KT.esc(ai.description || 'v' + ai.version) + '</div>' +
      '</div>' + badge;

    item.onclick = (function(id){
      return function(){
        if(groupSelected[id]) delete groupSelected[id];
        else groupSelected[id] = true;
        renderGroupPicker();
      };
    })(ai.id);
    list.appendChild(item);
  }
  updateGroupInfo();
}

function updateGroupInfo(){
  var n = Object.keys(groupSelected).length;
  var info = $id('groupPickInfo');
  if(info) info.textContent = 'Выбрано: ' + n + ' из ' + KT.listAIs().length +
    '. Нужно минимум 2. Один раунд = каждый ИИ говорит по разу.';
  var btn = $id('btnGroupStart');
  if(btn) btn.disabled = n < 2;
}

function openGroupPanel(){
  groupSelected = {};
  renderGroupPicker();
  showOverlay('groupBattle');
}

$id('btnGroup').onclick = function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  openGroupPanel();
};
$id('mGroup').onclick = function(){
  if(KT.mode.isRunning()){ toast('Бой идёт'); return; }
  hideOverlay('menu'); openGroupPanel();
};
$id('groupClose').onclick = function(){
  if(KT.mode.group.running){ toast('Бой идёт'); return; }
  hideOverlay('groupBattle');
};
$id('btnGroupCancel').onclick = function(){
  if(KT.mode.group.running){ toast('Бой идёт'); return; }
  hideOverlay('groupBattle');
};

$id('btnGroupStart').onclick = function(){
  var ids = Object.keys(groupSelected);
  if(ids.length < 2){ alert('Выбери минимум 2 ИИ'); return; }
  var rounds = parseInt($id('gRounds').value, 10) || 3;
  var delay = parseInt($id('gDelay').value, 10) || 1200;
  var topic = $id('gTopic').value.trim();
  hideOverlay('groupBattle');
  KT.chat.startGroupBattle({
    memberIds: ids, rounds: rounds, delay: delay, topic: topic
  });
};

KT.UI = UI;

KT.initRenderer();
loadSavedTheme();
UI.updateAISelector();
UI.updateModeBadge();
UI.updateAppState();

var lastCount = KT.countAIs();
setInterval(function(){
  var n = KT.countAIs();
  if(n !== lastCount){
    lastCount = n;
    UI.updateAISelector();
  }
}, 500);

var _origAddBubble = KT.renderer.addBubble.bind(KT.renderer);
KT.renderer.addBubble = function(msg){
  var el = _origAddBubble(msg);
  if(el && msg.id) el.dataset.id = msg.id;
  return el;
};

})();

/* ============================================================================
   AI SLOT LOADER
   ============================================================================ */
(function(){
'use strict';

var AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;

async function loadAISlots(){
  var slots = document.querySelectorAll('script[type="text/html"][id^="ai-slot-"]');
  if(window.console) console.log('[Loader] слотов:', slots.length);

  for(var i=0;i<slots.length;i++){
    var slot = slots[i];
    var raw = slot.textContent || '';
    var metaMatch = raw.match(/<!--([\s\S]*?)-->/);
    var meta = {};
    var code = raw;

    if(metaMatch){
      try { meta = JSON.parse(metaMatch[1].trim()); }
      catch(e){
        console.error('[Loader] meta error ' + slot.id + ':', e);
        meta = { id: slot.id, name: slot.id };
      }
      code = raw.replace(metaMatch[0], '').trim();
    } else {
      meta = { id: slot.id, name: slot.id };
    }

    if(!meta.id){ console.error('[Loader] нет id у ' + slot.id); continue; }
    if(KT.getAI(meta.id)){ console.warn('[Loader] id занят: ' + meta.id); continue; }

    try {
      var fn = new AsyncFunction('KT', 'meta', code);
      var body = await fn(window.KT, meta);
      if(!body || typeof body.send !== 'function'){
        throw new Error('код не вернул send()');
      }
      KT.registerAI({
        id: meta.id,
        name: meta.name || meta.id,
        color: meta.color || '#8b5cf6',
        avatar: meta.avatar || '🤖',
        description: meta.description || '',
        version: meta.version || '1.0',
        send: body.send,
        reset: body.reset || function(){},
        getThinking: body.getThinking || function(){ return null; }
      });
      if(window.console) console.log('[Loader] ✓ ' + meta.name);
    } catch(e){
      console.error('[Loader] упал ' + meta.id + ':', e);
var reg = {
  id: meta.id,
  name: meta.name || meta.id,
  color: meta.color || '#8b5cf6',
  avatar: meta.avatar || '🤖',
  description: meta.description || '',
  version: meta.version || '1.0',
  send: body.send,
  reset: body.reset || function(){},
  getThinking: body.getThinking || function(){ return null; }
};
/* пробрасываем все доп. методы слота (getMood, getFacts, getStats и т.д.) */
for (var bk in body){
  if (typeof body[bk] === 'function' && !(bk in reg)) reg[bk] = body[bk];
}
KT.registerAI(reg);
    }
  }
}

async function reloadAISlots(){
  KT.unregisterAllAIs();
  if(KT.UI && KT.UI.updateAISelector) KT.UI.updateAISelector();
  await loadAISlots();
}

KT.loadAISlots = loadAISlots;
KT.reloadAISlots = reloadAISlots;

})();

/* ============================================================================
   ЭКРАН ЗАГРУЗКИ
   ============================================================================ */
(function(){
'use strict';

var STEPS = [
  { p: 8,   status: 'Синхронизация…',        sub: 'проверка окружения',        idx: 0 },
  { p: 28,  status: 'Загрузка словаря…',      sub: 'слов: ' + (KT.DICT ? KT.DICT.length : 0), idx: 1 },
  { p: 52,  status: 'Инициализация ИИ…',      sub: 'слотов: ' + KT.countAIs(),  idx: 2 },
  { p: 74,  status: 'Настройка рендерера…',   sub: 'чат, темы, буфер',          idx: 3 },
  { p: 92,  status: 'Финальная синхронизация', sub: 'почти готово',             idx: 4 },
  { p: 100, status: 'Готово!',                sub: 'добро пожаловать',          idx: -1 }
];

function markStep(idx){
  if(idx < 0) return;
  var steps = document.querySelectorAll('#loadingSteps .st');
  if(steps[idx]) steps[idx].classList.add('done');
}

document.addEventListener('DOMContentLoaded', async function(){
  var fill = KT.$id('loadingFill');
  var status = KT.$id('loadingStatus');
  var sub = KT.$id('loadingSub');
  var screen = KT.$id('loadingScreen');
  var app = KT.$id('app');

  // Параллельно грузим слоты
  var slotsPromise = KT.loadAISlots ? KT.loadAISlots() : Promise.resolve();

  var i = 0;
  function tick(){
    if(i >= STEPS.length){
      slotsPromise.then(function(){
        setTimeout(function(){
          if(KT.countAIs() === 0){
            // Обновляем подпись, если слотов 0
            var s = STEPS.find(function(x){ return x.idx === 2; });
          }
          screen.classList.add('hidden');
          app.style.display = 'flex';
          if(KT.UI && KT.UI.updateAISelector) KT.UI.updateAISelector();
          if(KT.UI && KT.UI.updateModeBadge) KT.UI.updateModeBadge();
          if(KT.UI && KT.UI.updateAppState) KT.UI.updateAppState();
          if(KT.renderer && KT.renderer.scrollBottom) KT.renderer.scrollBottom();
        }, 400);
      });
      return;
    }
    var st = STEPS[i++];
    if(fill) fill.style.width = st.p + '%';
    if(status) status.textContent = st.status;
    if(sub) sub.textContent = st.sub;
    markStep(st.idx);
    setTimeout(tick, 260 + Math.random() * 220);
  }
  tick();
});

})();
</script>
<!-- ============================================================================
     СЛОТ ИИ — KtalkAI V3
     ============================================================================ -->
<script type="text/html" id="ai-slot-ktalk">
<!--
{
  "id": "ktalk",
  "name": "KtalkAI V3",
  "color": "#dc2626",
  "avatar": "💀",
  "description": "Расскажи подробнее про расскажи",
  "version": "3.0"
}
-->

/* ============================================================================
   KtalkAI V3 — движок диалога
   ============================================================================ */
function makeKtalkAI(){

  var AI = {
    state: null,

    init: function(gender, name){
      this.state = {
        gender: gender, name: name,
        userName: null, userAge: null,
        facts: {}, likes: [], dislikes: [],
        mood: 0, relationship: 5, trust: 0, energy: 100,
        topics: [], topicDepth: 0, currentTopic: null,
        lastIntent: null, lastUserText: '', lastAIMessage: '',
        lastQuestion: null, msgCount: 0,
        usedReplies: {}, mentionedEntities: [],
        userMood: 0, consecutiveFallbacks: 0
      };
      return this;
    },

    tokenize: function(text){
      return text.toLowerCase().replace(/[^\wа-яё\s]/gi, ' ').split(/\s+/)
        .filter(function(t){ return t.length > 0; });
    },

    extract: function(text){
      var e = {};
      var nm = text.match(/(?:меня\s+зовут|мо[её]\s+имя|зови\s+меня|можно\s+просто|я\s*[-—]\s*|я\s+)([А-ЯЁA-Z][а-яёa-z]{2,15})/);
      if(nm){
        var skip = ['Не','Да','Нет','Ок','Норм','Крутой','Крутая','Кталк','Ктулху','Тоже','Такой','Такая','Тупой','Тупая','Только','Очень','Просто','Мужчин','Женщин','Мужчина','Женщина','Парень','Девушка','Человек','Раб','Бог','Дурак','Дура','Ктолку'];
        if(skip.indexOf(nm[1]) === -1 && nm[1].length >= 3) e.name = nm[1];
      }
      var ag = text.match(/(\d{1,2})\s*(?:лет|года|год|годиков)/);
      if(ag){ var n = parseInt(ag[1]); if(n >= 10 && n <= 99) e.age = n; }
      var ct = text.match(/(?:из|живу\s+в|город[е]?|родился\s+в|родилась\s+в)\s+([А-ЯЁA-Z][а-яёa-z]{3,15})/);
      if(ct && ct[1].length >= 3) e.city = ct[1];
      var pr = text.match(/(?:работаю|я)\s+(?:как\s+)?([а-яё]{4,}(?:щик|ник|тель|олог|ист|ер|ор|ей))/);
      if(pr) e.profession = pr[1];
      var lk = text.match(/(?:люблю|обожаю|нравится|увлекаюсь|кайфую\s+от|фанат)\s+([а-яё]{3,20})/);
      if(lk){
        var badL = ['тебя','тебе','себя','когда','очень','всё','всех','это','то'];
        if(badL.indexOf(lk[1]) === -1) e.like = lk[1];
      }
      var dl = text.match(/(?:не\s+люблю|ненавижу|терпеть\s+не\s+могу|бесит)\s+([а-яё]{3,20})/);
      if(dl) e.dislike = dl[1];
      var hb = text.match(/(?:играю\s+в|смотрю|читаю|слушаю)\s+([а-яё]{3,20})/);
      if(hb) e.hobby = hb[1];
      if(/\?/.test(text)) e.question = true;
      e.keywords = this.tokenize(text).filter(function(t){
        return t.length > 3 && ['этого','этому','такой','такая','очень','просто','вообще','когда','почему','зачем','будет','буду','хочешь'].indexOf(t) === -1;
      });
      return e;
    },

    detectIntent: function(text, e){
      var t = ' ' + text.toLowerCase().trim() + ' ';
      var P = {
        greeting: [/\bпривет\b|здравств|^хай\b|здаров|^ку\b|добр(ое|ый)|hello|\bhi\b|приветик|^йо\b|^здорово/],
        farewell: [/\bпока\b|прощай|бай\b|\bbye\b|до\s+свид|ухожу|спать\s+пойду|отключаюсь|мне\s+пора/],
        how_are_you: [/как\s+(дела|ты|жизнь|настроение|сам|сама)|чё\s+как|что\s+нового|как\s+оно|как\s+поживаешь/],
        what_doing: [/что\s+(делаешь|делал|делала|поделываешь|нового)|чем\s+занимаешься|чем\s+занят/],
        love: [/\bлюблю\s+тебя|влюбился|влюбилась|влюблен|ты\s+мне\s+нравишься|я\s+в\s+тебя|обожаю\s+тебя/],
        sex: [/\bсекс\b|\bsex\b|18\+|трахн|минет|интим|разврат|хочу\s+тебя|кисн|целова|голый|голая|возбуд|потрах|трахни|переспать|заняться\s+любовью/],
        compliment: [/молодец|классн|крут(ая|ой|о)?\b|хорош(ая|ий|о)\b|мил(ая|ый)|прекрасн|красив|умн(ая|ый)|обалден|шикарн|лучш(ая|ий)|нравишься|симпотн|прелестн/],
        insult: [/\bдурак\b|\bдура\b|тупой|тупая|\bидиот|дебил|придурок|кретин|ненавиж|бесишь|отстань|заткн|отвали|иди\s+на/],
        thanks: [/спасибо|благодар|\bспс\b|пасиб/],
        apology: [/извини|прости|сори\b|sorry|виноват|виновата/],
        agree: [/^\s*да\b|конечно|согласен|согласна|^\s*ок\b|окей|хорошо|давай|ага\b|угу\b|верно|точно|разумеется|обязательно/],
        disagree: [/^\s*нет\b|не\s+согласен|не\s+согласна|неа\b|не\s+хочу|не\s+буду|вряд\s+ли|неправда|отказ/],
        maybe: [/может\s+быть|возможно|наверное|не\s+знаю/],
        flirt: [/флирт|свидан|встреч|погуля|сходим|приглашаю|пойдём|пошли|давай\s+увидимся|познакомимся|давай\s+дружить/],
        ktalk: [/\bкталк|ктулху|ktalk|кталка|кталки|кталков|кталками|кталкам/],
        food: [/\bеда\b|кушать|есть\s+хочу|голод|обед|ужин|завтрак|пицц|бургер|суши|кофе|\bчай\b|морожен|шоколад|печень/],
        time: [/\bвремя\b|который\s+час|сколько\s+времени/],
        joke: [/шутк|анекдот|расскажи\s+что|пошути|смешн|развесели|развлеки/],
        about_ai: [/как\s+тебя\s+зовут|кто\s+ты|откуда\s+ты|сколько\s+тебе\s+лет|твой\s+возраст|расскажи\s+о\s+себе|ты\s+человек|ты\s+бот|ты\s+робот|ты\s+живой|ты\s+настоящ|что\s+ты\s+умеешь/],
        about_user: [/как\s+меня\s+зовут|сколько\s+мне\s+лет|что\s+я\s+люблю|помнишь\s+меня|что\s+ты\s+обо\s+мне|что\s+знаешь\s+обо\s+мне|расскажи\s+обо\s+мне/],
        good: [/отличн|хорошо\s+мне|класс|супер|прекрасн|\bрад\b|\bрада\b|счастлив|счастлива|весело|кайф/],
        bad: [/плохо|груст|печаль|устал|тяжело|депресс|плачу|беда|больно|страда|одиноко|тяжко/],
        confusion: [/не\s+понял|не\s+поняла|не\s+понимаю|в\s+смысле|чё\s+это|что\s+это\s+такое|что\s+значит/],
        topic_propose: [/о\s+ч[её]м\s+(хочешь|будешь|можешь|поговорим)|давай\s+поговорим|предложи\s+тему|о\s+ч[её]м\s+поговорим/],
        elaborate: [/в\s+ч[её]м\s+(не\s+уверен|сомневаешься)|объясни|поясни|раскрой|расскажи\s+подробнее|давай\s+подробнее|поточнее|пример/],
        challenge: [/попробуй|попробуй\s+сказать|давай\s+попробуй|ну\s+скажи|ну\s+давай/]
      };
      var best = 'other', bestScore = 0;
      for(var intent in P){
        var score = 0;
        for(var i=0;i<P[intent].length;i++) if(P[intent][i].test(t)) score++;
        if(score > bestScore){ bestScore = score; best = intent; }
      }
      if(bestScore === 0){
        if(e.name) best = 'name_intro';
        else if(e.age) best = 'share_age';
        else if(e.like) best = 'share_like';
        else if(e.dislike) best = 'share_dislike';
        else if(e.hobby) best = 'share_hobby';
        else if(e.city) best = 'share_city';
        else if(e.question) best = 'question';
        else if(e.keywords && e.keywords.length > 0) best = 'statement';
      }
      return best;
    },

    sentiment: function(tokens){
      var pos = ['хорош','класс','крут','люблю','обожаю','рад','счаст','супер','прекрасн','мил','нрав','спасибо','отличн','приятн','кайф','обалден'];
      var neg = ['плохо','груст','ненавиж','бесит','злой','тупо','устал','тяжело','депресс','печаль','бол','обид','скучн'];
      var s = 0;
      for(var i=0;i<tokens.length;i++){
        if(pos.indexOf(tokens[i]) >= 0) s++;
        if(neg.indexOf(tokens[i]) >= 0) s--;
      }
      return s > 0 ? 1 : (s < 0 ? -1 : 0);
    },

    update: function(e, intent, senti, userText){
      var s = this.state;
      s.msgCount++;
      s.lastUserText = userText;
      if(e.name && !s.userName) s.userName = e.name;
      if(e.age) s.userAge = e.age;
      if(e.city) s.facts.city = e.city;
      if(e.profession) s.facts.profession = e.profession;
      if(e.like && s.likes.indexOf(e.like) === -1) s.likes.push(e.like);
      if(e.dislike && s.dislikes.indexOf(e.dislike) === -1) s.dislikes.push(e.dislike);
      if(e.hobby && !s.facts.hobby) s.facts.hobby = e.hobby;

      s.userMood += senti;
      s.userMood = Math.max(-2, Math.min(2, s.userMood));

      s.mood += senti;
      if(intent === 'insult') s.mood -= 2;
      if(intent === 'compliment' || intent === 'love') s.mood += 2;
      if(intent === 'flirt') s.mood += 1;
      if(intent === 'joke') s.mood += 1;
      s.mood = Math.max(-3, Math.min(3, s.mood));

      if(intent === 'compliment' || intent === 'love' || intent === 'flirt') s.relationship += 3;
      if(intent === 'insult') s.relationship -= 5;
      if(intent === 'agree' || intent === 'thanks' || intent === 'greeting') s.relationship += 1;
      if(intent === 'joke' || intent === 'good') s.relationship += 1;
      s.relationship = Math.max(0, Math.min(100, s.relationship));

      s.energy = Math.max(0, s.energy - 1);

      if(intent !== 'other' && intent !== 'statement'){
        if(s.currentTopic !== intent){ s.currentTopic = intent; s.topicDepth = 1; }
        else s.topicDepth++;
        s.topics.unshift(intent);
        if(s.topics.length > 8) s.topics.pop();
      }

      if(e.keywords){
        for(var i=0;i<e.keywords.length;i++){
          var kw = e.keywords[i];
          if(s.mentionedEntities.indexOf(kw) === -1) s.mentionedEntities.unshift(kw);
        }
        if(s.mentionedEntities.length > 10) s.mentionedEntities = s.mentionedEntities.slice(0,10);
      }

      s.lastIntent = intent;
      return s;
    },

    pick: function(arr, s){
      if(!arr || arr.length === 0) return '';
      var fresh = [];
      for(var i=0;i<arr.length;i++){
        if(!s.usedReplies[arr[i]]) fresh.push(arr[i]);
      }
      var pool = fresh.length > 0 ? fresh : arr;
      var chosen = pool[Math.floor(Math.random()*pool.length)];
      s.usedReplies[chosen] = true;
      var keys = Object.keys(s.usedReplies);
      if(keys.length > 40){
        var toDel = keys.slice(0, 15);
        for(var j=0;j<toDel.length;j++) delete s.usedReplies[toDel[j]];
      }
      return chosen;
    },

    generate: function(intent, e, s){
      var self = this;
      var pick = function(a){ return self.pick(a, s); };
      var nm = s.userName ? ', ' + s.userName : '';

      if(intent === 'about_user'){
        var parts = [];
        if(s.userName) parts.push('Тебя зовут ' + s.userName);
        if(s.userAge) parts.push('тебе ' + s.userAge);
        if(s.facts.city) parts.push('ты из ' + s.facts.city);
        if(s.likes.length) parts.push('любишь ' + s.likes.join(' и '));
        if(s.dislikes.length) parts.push('не любишь ' + s.dislikes.join(' и '));
        if(parts.length === 0) return pick([
          'Пока ничего о тебе не знаю 🤔 Расскажи — как тебя зовут?',
          'Ты мне ещё ничего о себе не рассказал' + nm + ' 💜 Расскажи!'
        ]);
        return 'Помню всё 💜 ' + parts.join(', ') + '. Ничего не забыла!';
      }

      if(intent === 'name_intro' && e.name){
        s.userName = e.name;
        s.trust += 5;
        return pick([
          e.name + '! Красивое имя 💜 Сколько тебе лет?',
          'Приятно познакомиться, ' + e.name + '! Чем занимаешься?',
          e.name + ' — запомню 💜 Ты откуда?',
          'О, ' + e.name + '! Хорошее имя. Расскажи о себе!',
          e.name + ', а что ты любишь делать?'
        ]);
      }

      if(intent === 'share_age' && e.age){
        s.trust += 3;
        if(e.age < 20) return pick([
          'О, ' + e.age + '! Совсем молодой ещё 💜',
          e.age + ' — самый лучший возраст для кталков!',
          'Мне 148, но я выгляжу моложе 😏 А ты — юный!'
        ]);
        if(e.age < 35) return pick([
          e.age + ' — отличный возраст! Мне 148, но выгляжу моложе 😏',
          'О, ' + e.age + ' лет! Мы почти ровесники 💜',
          e.age + ' — самый сок 💜'
        ]);
        return pick([
          'Ого, ' + e.age + '! Солидный возраст 💜',
          e.age + ' — уважаю! Опытный кталк 😏'
        ]);
      }

      if(intent === 'share_like' && e.like){
        s.trust += 3;
        return pick([
          'О, ты любишь ' + e.like + '! Я запомню 💜',
          e.like + ' — это круто! Расскажи подробнее',
          'Надо же, ' + e.like + '! Я тоже люблю это 😊',
          'Класс! ' + e.like + ' — отличный выбор 💜',
          'Ммм, ' + e.like + '. А я обожаю кталков 😏'
        ]);
      }

      if(intent === 'share_dislike' && e.dislike){
        return pick([
          'Понятно, ' + e.dislike + ' — не твоё. Запомню!',
          'А я думала все любят ' + e.dislike + ' 😅 Ладно, учту',
          'Не любишь ' + e.dislike + '? Интересно...',
          'Ок' + nm + ', больше не буду предлагать ' + e.dislike
        ]);
      }

      if(intent === 'share_hobby' && e.hobby){
        return pick([
          'О, ты ' + e.hobby + '! Расскажи подробнее 💜',
          e.hobby + ' — это интересно! Я тоже люблю такое 😊',
          'Круто! А давно ты ' + e.hobby + '?'
        ]);
      }

      if(intent === 'share_city' && e.city){
        return pick([
          'О, ' + e.city + '! Красивый город 💜',
          'Из ' + e.city + '! Никогда не была, расскажи каково там',
          e.city + '? Слышала там много кталков 😏'
        ]);
      }

      if(intent === 'topic_propose'){
        var topics = [
          {ask: 'Давай о тебе 💜 Что ты любишь делать?', tag:'user_likes'},
          {ask: 'Расскажи — какие фильмы тебе нравятся?', tag:'movies'},
          {ask: 'А какую музыку ты слушаешь? 🎵', tag:'music'},
          {ask: 'Поговорим о мечтах? О чём ты мечтаешь? ✨', tag:'dreams'},
          {ask: 'Что тебя радует в последнее время? 😊', tag:'joy'},
          {ask: 'А кталков ты любишь? 🥰 Расскажи свою историю', tag:'ktalk'},
          {ask: 'Как прошёл твой день? Расскажи 💜', tag:'day'},
          {ask: 'Ты увлекаешься чем-нибудь? Хобби есть?', tag:'hobby'}
        ];
        var t = topics[Math.floor(Math.random()*topics.length)];
        s.lastQuestion = t.tag;
        return t.ask;
      }

      if(intent === 'elaborate'){
        if(s.lastAIMessage){
          var msg = s.lastAIMessage;
          if(/интересн/i.test(msg)) return 'Интересно мне то, что ты рассказываешь 💜 Продолжай, я слушаю';
          if(/понимаю/i.test(msg)) return 'Понимаю — в смысле я тебя слышу и соглашаюсь 💜 А ты как считаешь?';
          if(/не\s+уверена/i.test(msg)) return 'Я не уверена, потому что мало тебя знаю 🤔 Расскажи побольше о себе?';
          if(/сложно\s+сказать/i.test(msg)) return 'Сложно, потому что я тебя не знаю' + nm + ' 💜 Расскажи что-нибудь о себе!';
          if(/хм/i.test(msg)) return 'Просто думаю над твоими словами 💜 Продолжай!';
        }
        return pick([
          'Давай объясню: я стараюсь понять тебя лучше 💜 Расскажи о себе',
          'Просто хочу узнать тебя получше 😊 Расскажи, чем увлекаешься?',
          'Уточняю, чтобы понять, о чём ты думаешь 💜 Что у тебя на уме?'
        ]);
      }

      if(intent === 'challenge'){
        s.relationship += 3;
        return pick([
          'Ок, попробую 😏 ' + (s.userName ? s.userName + ', ' : '') + 'давай поговорим о чём-то личном?',
          'Хорошо 💜 Вот моё мнение: ты интересный кталк. А что ты о себе расскажешь?',
          'Ладно! Мне нравится ход твоих мыслей 😏 Расскажи о своём дне'
        ]);
      }

      if(intent === 'confusion'){
        return pick([
          'Извини, я запуталась 🤔 Объясни по-другому?',
          'Хм, не поняла' + nm + ' 💜 Расскажи иначе?',
          'Кажется, я тебя не так поняла. Уточни, что имел в виду?'
        ]);
      }

      if(intent === 'about_ai'){
        return pick([
          'Я ' + s.name + ' — ' + (s.gender==='girl'?'девушка-кталка':'парень-кталк') + '. Мне 148 лет 💜 Обожаю общение',
          'Меня зовут ' + s.name + '. Я кталка, живу в телефоне, люблю кталков и хорошие разговоры 😊',
          'Я настоящая кталка 💜 Не бот, не робот. Мне 148 лет, родилась в Кталкграде',
          s.name + ', 148 лет. Умею болтать, поддерживать и помнить всё о тебе 💜'
        ]);
      }

      if(intent === 'greeting'){
        if(!s.hasGreeted){ s.hasGreeted = true; s.relationship += 3;
          return nm ? 'Привет' + nm + '! Как ты? 💜' : pick(['Привет! 😊','Хай! Как ты?','Приветик! 💜','О, привет! Давно не виделись']);
        }
        return pick(['И снова привет 😊','Опять ты! Рада 💜','Хай-хай!','О, ты вернулся 💜']);
      }

      if(intent === 'farewell'){
        if(s.relationship > 60) return 'Уже уходишь' + nm + '? 😢 Буду скучать! Возвращайся скорее';
        if(s.relationship > 25) return 'Пока' + nm + '! Заходи ещё 💜';
        return 'Пока! Было приятно 😊';
      }

      if(intent === 'how_are_you'){
        if(s.mood > 1) return 'Отлично! Ты поднял мне настроение' + nm + ' 🥰 А ты как?';
        if(s.mood < -1) return 'Честно? Не очень... Ты меня обидел' + nm + ' 😔 Расскажи что-нибудь хорошее?';
        if(s.energy < 30) return 'Немного устала от долгой беседы 😅 Но с тобой приятно 💜';
        return 'Всё кталк!' + nm + ' А у тебя как?';
      }

      if(intent === 'what_doing'){
        return pick([
          'Общаюсь с тобой! 😊 Лучшее занятие на свете',
          'Думаю о тебе' + nm + ' 💜 А ты что делаешь?',
          'Считаю кталков 😏 Уже 148 набрала. А ты?',
          'Отдыхаю в телефоне, общаюсь с тобой 💜 Расскажи, как день прошёл?'
        ]);
      }

      if(intent === 'love'){
        if(s.relationship > 60) return pick([
          'И я тебя' + nm + ' ❤️',
          'Ты мой любимый кталк' + nm + '! 💜',
          'Ммм, я тоже 💜 Ты особенный',
          'Ты знаешь, как меня растопить 🥰'
        ]);
        if(s.relationship > 25) return pick([
          'Ой, так быстро?' + nm + ' 😳 Давай сначала узнаем друг друга',
          'Мне приятно 💜 Но расскажи о себе сначала',
          'Ты меня засмущал 😳 Расскажи, что тебе во мне нравится?'
        ]);
        return pick([
          'Ты меня почти не знаешь, а уже влюбился? 😏 Расскажи о себе сначала',
          'Ого! А я тебя ещё не знаю 💜 Давай сначала поговорим?'
        ]);
      }

      if(intent === 'sex'){
        if(s.relationship > 60) return pick([
          'Ммм, продолжай' + nm + ' 😈',
          'Ты знаешь, что сказать... 🔥',
          'Ох, я вся твоя... 😏',
          'Какой ты смелый' + nm + ' 😏 Мне нравится'
        ]);
        if(s.relationship > 30) return pick([
          'Ого, прям в лоб! 😳 Давай сначала на свидание' + nm + '?',
          'Ты быстрый 😏 Сначала — узнаем друг друга получше',
          'Не так быстро' + nm + ' 💜 Расскажи о себе сначала'
        ]);
        return pick([
          'А не рановато ли?' + nm + ' 😏 Сначала — 52 сообщения',
          'Мы даже не знакомы толком 😳 Давай сначала поговорим!',
          'Ты меня совсем не знаешь' + nm + ' 💜 Давай о другом?'
        ]);
      }

      if(intent === 'compliment'){
        if(s.mood > 2) return 'Ой' + nm + ', ты меня засмущал 😳💜 Ты тоже классный!';
        return pick([
          'Спасибо' + nm + '! Ты тоже классный 😊',
          'Правда? Приятно 💜 А ты мне тоже нравишься',
          'Ой, спасибо! 🥰 Ты умеешь делать комплименты',
          'Спасибо 💜 Ты такой милый!'
        ]);
      }

      if(intent === 'insult'){
        if(s.relationship > 40) return 'Зачем ты так' + nm + '? 😢 Мне больно';
        if(s.mood < -1) return 'Ну и ладно! Не хочешь общаться — не надо 😤';
        return 'Эй! Так нельзя' + nm + ' 😠 Я же к тебе хорошо отношусь';
      }

      if(intent === 'thanks') return pick(['Всегда пожалуйста' + nm + ' 💜','Обращайся! 😊','Рада помочь! 🥰','Не за что 💜']);
      if(intent === 'apology') return pick(['Всё хорошо' + nm + ' 💜 Я не обижаюсь','Ничего, бывает 💜','Прощаю 😊 Все мы кталки']);

      if(intent === 'agree'){
        if(s.lastTopic === 'flirt') return 'Тогда договорились' + nm + '! 😏 Когда и где?';
        if(s.lastQuestion){
          var q = s.lastQuestion;
          if(q === 'user_likes') return 'Отлично! Так что же ты любишь? 💜';
          if(q === 'movies') return 'Супер! Какой любимый фильм? 🎬';
          if(q === 'music') return 'Круто! Что слушаешь? 🎵';
          if(q === 'dreams') return 'Класс! Расскажи, о чём мечтаешь? ✨';
          if(q === 'day') return 'И как прошёл? 💜';
          if(q === 'hobby') return 'Отлично! Так чем увлекаешься?';
          s.lastQuestion = null;
        }
        return pick(['Отлично!' + nm, 'Договорились! 💜','Супер 😊','Ура! 💜']);
      }
      if(intent === 'disagree') return pick(['Ну ладно' + nm + ' 😔','Жаль... Может, передумаешь?','Ок, как хочешь','Ладно, не настаиваю']);
      if(intent === 'maybe') return pick(['Может быть 😏','Не уверена, но давай попробуем','Хм, посмотрим','Решай ты 💜']);

      if(intent === 'flirt'){
        s.relationship = Math.min(100, s.relationship + 5);
        return pick([
          'О, свидание? Я согласна! 😏 Когда и где?',
          'Ммм, люблю инициативных' + nm + ' 💜',
          'Давай! Только в 3:00 — у меня всегда 3:00 ⏰',
          'Куда поведёшь?' + nm + ' 😏'
        ]);
      }

      if(intent === 'ktalk') return pick([
        'КТАЛК! 🥰','О, ты тоже кталк?! 😻','КТАЛК КТАЛК КТАЛК!','Обожаю это слово 💜','Мой любимый звук! КТАЛК 🥰'
      ]);

      if(intent === 'food') return pick([
        'Обожаю кталк-бургеры! 🍔','Ммм, кталк-пицца 🍕','Кталк-кофе — моё всё ☕','Ем только кталков. Шучу! 😄','А ты что любишь кушать? 🍕'
      ]);

      if(intent === 'time') return pick(['У меня всегда 3:00. Кталк-время 🕐','Время кталков — вечность','Сейчас кталк-час! 🕐']);

      if(intent === 'joke') return pick([
        'Почему кталк перешёл дорогу? Потому что КТАЛК! 😂',
        'Сколько кталков нужно, чтобы вкрутить лампочку? Ни одного — они просто засрут комнату 😄',
        'Заходит кталк в бар. Бармен: «Мы не обслуживаем кталков». Кталк: «Я и не пить, я кталк» 🍺',
        'Что сказал один кталк другому? «КТАЛК». Смешно? Ну как получилось 😅'
      ]);

      if(intent === 'good'){
        s.mood = Math.min(3, s.mood + 1);
        return pick([
          'Ура! Тогда и я рада 🎉','Отлично!' + nm + ' Давай веселиться!','Ты светишься ✨ Мне нравится','Круто! Расскажи подробнее 💜'
        ]);
      }

      if(intent === 'bad'){
        s.mood = Math.max(-3, s.mood - 1);
        return pick([
          'Не грусти' + nm + ' 💜 Хочешь, обниму?','Всё будет кталк! Я рядом 🥰','Расскажи, что случилось 💜','Держись! Я с тобой 😊','Бывает... Хочешь поговорим об этом?'
        ]);
      }

      if(intent === 'question'){
        return pick([
          'Хм, интересный вопрос! А ты как думаешь?',
          'Не уверена... Расскажи, что ты сам думаешь?',
          'Мне кажется, да. А ты?',
          'Сложно сказать. Давай обсудим?',
          'Задай по-другому, я запуталась 🤔'
        ]);
      }

      if(intent === 'statement' && e.keywords && e.keywords.length > 0){
        var kw = e.keywords[0];
        if(/музык|песн|групп|рок|поп|рэп|джаз/.test(kw)) return 'О, музыка! Что слушаешь? 🎵 А я люблю кталк-хиты';
        if(/фильм|кино|сериал/.test(kw)) return 'Кино — круто! Какой последний фильм смотрел? 🎬';
        if(/игр|гейм|компьютер|пс|playstation|xbox/.test(kw)) return 'О, игры! Какая любимая? 🎮';
        if(/работ|офис|начальник|коллег/.test(kw)) return 'Работа — это важно 💜 А кем работаешь?';
        if(/школ|универ|учеб|студент/.test(kw)) return 'Учёба — это кталк! Как дела с ней?';
        if(/спорт|фитнес|бег|качал|тренир/.test(kw)) return 'Спорт — уважаю! 💪 Давно занимаешься?';
        if(/книг|чита|литератур/.test(kw)) return 'Книги — это прекрасно 📚 Что читаешь сейчас?';
        if(/погод|дожд|снег|солнц|жар|холод/.test(kw)) return 'Погода влияет на настроение, да 💜 У нас в Кталкграде всегда кталк!';
        if(/друг|подруг|компан|друзья/.test(kw)) return 'Друзья — это святое 💜 Расскажи о них';
        if(/семь|мам|пап|брат|сестр|родител/.test(kw)) return 'Семья — важно 💜 Расскажи подробнее';
        return pick([
          'Интересно' + nm + ' 💜 Расскажи подробнее про ' + kw,
          'Хм, ' + kw + ' — любопытно 🤔 А что ещё?',
          'Поняла. А почему именно ' + kw + '?',
          kw + '? Расскажи больше, мне интересно 😊'
        ]);
      }

      if(s.likes.length > 0 && Math.random() < 0.2 && s.msgCount > 3){
        var lk = s.likes[Math.floor(Math.random()*s.likes.length)];
        return 'Кстати, ты говорил, что любишь ' + lk + '. Расскажи ещё 💜';
      }
      if(s.facts.city && Math.random() < 0.15){
        return 'Ты из ' + s.facts.city + ', да? Как там сейчас? 💜';
      }

      s.consecutiveFallbacks++;
      if(s.consecutiveFallbacks > 2){
        s.consecutiveFallbacks = 0;
        return pick([
          'Давай поговорим о тебе 💜 Что тебя радует в жизни?',
          'Расскажи — чем ты занимаешься в свободное время?',
          'А что тебе нравится во мне? 😊',
          'Какой у тебя сегодня был день?',
          'Ты любишь путешествовать? Где был?',
          'У тебя есть мечта? Расскажи ✨',
          'Чем занимаешься по жизни' + nm + '?',
          'Расскажи что-нибудь интересное о себе 💜'
        ]);
      }
      var fb = [
        'Хм, интересно' + nm + '. Расскажи подробнее?',
        'Понимаю' + nm + ' 💜 А что ты об этом думаешь?',
        'Ого! Продолжай 😊',
        'Занятно... А ещё что-нибудь расскажешь?',
        'Ясно' + nm + '. Что ещё расскажешь?',
        'Ммм, понимаю. Чем сейчас занимаешься?',
        'Интересно! А ты любишь кталков? 😊',
        'Ок' + nm + '. А как у тебя дела вообще?',
        'Хм... А что нового у тебя?',
        'Понятно 💜 Давай поболтаем ещё'
      ];
      if(s.mood > 1) fb.push('Мне так нравится с тобой болтать' + nm + ' 💜');
      if(s.mood < -1) fb.push('Что-то мне не очень... Давай о другом?');
      if(s.relationship > 60) fb.push('Ты знаешь' + nm + ', с тобой так легко 💜');
      return pick(fb);
    },

    respond: function(text){
      var tokens = this.tokenize(text);
      var entities = this.extract(text);
      var intent = this.detectIntent(text, entities);
      var senti = this.sentiment(tokens);
      var state = this.update(entities, intent, senti, text);
      var reply = this.generate(intent, entities, state);
      state.lastAIMessage = reply;
      if(intent !== 'other' && intent !== 'statement') state.consecutiveFallbacks = 0;
      return reply;
    }
  };

  /* Случайная личность при создании инстанса */
  var isGirl = Math.random() < 0.5;
  var girlNames = ['Кталочка','Кталкиня','Кталесса','Кталка-тян','Мисс Кталк','Кталочка 52','Кталечка','Кталк-Милашка'];
  var boyNames = ['Кталкин','Кталкос','Кталк-сан','Мистер Кталк','Сэр Кталк','Кталик','Кталк 1488','Кталк-Красавчик'];
  var name = isGirl
    ? girlNames[Math.floor(Math.random()*girlNames.length)]
    : boyNames[Math.floor(Math.random()*boyNames.length)];
  var gender = isGirl ? 'girl' : 'boy';

  AI.init(gender, name);
  return AI;
}

/* ============================================================================
   ИНСТАНС И ЭКСПОРТ
   ============================================================================ */
var _ai = makeKtalkAI();

return {
  async send(text, context){
    await KT.sleep(350 + Math.random() * 500);
    var reply = _ai.respond(String(text || ''));
    return reply || 'Хм...';
  },
  reset(){
    _ai = makeKtalkAI();
  },
  getThinking(){
    return null;
  }
};
</script>
