    ],
    s:{
      m:['Может','Наверное','Всё возможно'],
      m2:['Поживём — увидим.','Кталк тоже не знает.','Разберёмся.']
    }
  };
  F.ok = {
    k:'ок окей хорошо ладно понятно ясно'.split(' '),
    e:['ок','окей','хорошо','ладно','понятно','ясно'],
    t:[
