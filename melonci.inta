inta.stg:{namer,icon,background
namer:app.name:["MelonCI"],what.name=namer
icon:app.ico:["⌨️"],what.ico=icon
background:app.bg:[#0a0e14],what.ico.bg=background
}
IL.cfg={scripts:all}
Inta.cfg={pc,tablet,phone}
load.stop_parse.inta

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>MelonCI</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden;font-family:'SF Mono','Consolas','Menlo','Courier New',monospace;background:#0a0e14;color:#c8d1dc;font-size:13.5px;line-height:1.5}
  ::-webkit-scrollbar{width:8px;height:8px}
  ::-webkit-scrollbar-track{background:#0a0e14}
  ::-webkit-scrollbar-thumb{background:#1f2937;border-radius:4px}
  ::-webkit-scrollbar-thumb:hover{background:#374151}
  #term{position:fixed;inset:0;display:flex;flex-direction:column;padding:14px 16px 0;overflow:hidden}
  #out{flex:1;overflow-y:auto;overflow-x:hidden;white-space:pre-wrap;word-break:break-word;padding-bottom:14px;scroll-behavior:smooth}
  #in-row{display:flex;align-items:flex-start;gap:8px;padding:8px 0 14px;border-top:1px solid #16202a;flex-shrink:0}
  #prompt{color:#52b788;font-weight:700;white-space:pre;flex-shrink:0;line-height:1.5}
  #prompt .path{color:#7cc7ff}
  #prompt .user{color:#ffd166}
  #cmd{flex:1;background:transparent;border:0;outline:0;color:#c8d1dc;font:inherit;caret-color:#52b788;padding:0;min-width:0}
  .line{padding:1px 0}
  .err{color:#ff6b6b}
  .ok{color:#52b788}
  .warn{color:#ffd166}
  .info{color:#7cc7ff}
  .dim{color:#64748b}
  .cmd-echo .u{color:#ffd166;font-weight:700}
  .cmd-echo .p{color:#7cc7ff}
  .dir{color:#7cc7ff;font-weight:700}
  .file{color:#c8d1dc}
  .exec{color:#52b788;font-weight:700}
  .banner{color:#ff8fa3;font-weight:700}
  .hl{background:#1e293b;padding:0 3px;border-radius:3px}
  @media(max-width:640px){html,body{font-size:12px}#term{padding:10px 12px 0}}
</style>
</head>
<body>
<div id="term">
  <div id="out"></div>
  <div id="in-row">
    <span id="prompt"></span>
    <input id="cmd" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" autofocus>
  </div>
</div>

<script>
(() => {
  "use strict";
  const $ = id => document.getElementById(id);
  const out = $('out');
  const cmd = $('cmd');
  const promptEl = $('prompt');

  /* ============================================================
     WFS через postMessage (работает на file://)
     ============================================================ */
  const WFS = (() => {
    const pending = new Map();
    let reqId = 0;
    const TIMEOUT = 8000;

    window.addEventListener('message', e => {
      const d = e.data;
      if (!d || d.type !== 'wfs:res') return;
      const p = pending.get(d.id);
      if (!p) return;
      pending.delete(d.id);
      clearTimeout(p.timer);
      if (d.ok) p.resolve(d.data);
      else p.reject(new Error(d.error || 'Ошибка WFS'));
    });

    function call(cmd, ...args) {
      return new Promise((resolve, reject) => {
        const id = ++reqId;
        const timer = setTimeout(() => {
          if (pending.has(id)) {
            pending.delete(id);
            reject(new Error('Таймаут: WFS не отвечает'));
          }
        }, TIMEOUT);
        pending.set(id, { resolve, reject, timer });
        try {
          window.parent.postMessage({ type: 'wfs:req', id, cmd, args }, '*');
        } catch (err) {
          pending.delete(id);
          clearTimeout(timer);
          reject(new Error('postMessage недоступен: ' + err.message));
        }
      });
    }

    const api = {
      getUser() { return localStorage.getItem('wmos:melonci:user') || 'user'; }
    };
    ['ls','stat','exists','mkdir','mkdirp','write','append','read','readText','touch',
     'rm','rmdir','mv','cp','du','df','find','listAll','norm','parentOf','basename']
      .forEach(m => { api[m] = (...args) => call(m, ...args); });

    api.init = async () => {
      try { const u = await call('getUser'); if (u) localStorage.setItem('wmos:melonci:user', u); } catch {}
      return true;
    };
    api.ready = api.init();

    return api;
  })();

  /* ============================================================
     STATE
     ============================================================ */
  let cwd = '/';
  let username = WFS.getUser();
  let history = [];
  let hIdx = -1;
  try { history = JSON.parse(localStorage.getItem('wmos:melonci:hist') || '[]') || []; } catch {}
  const saveHist = () => { try { localStorage.setItem('wmos:melonci:hist', JSON.stringify(history.slice(-200))); } catch {} };

  /* ============================================================
     OUTPUT
     ============================================================ */
  function write(text, cls) {
    const d = document.createElement('div');
    d.className = 'line' + (cls ? ' ' + cls : '');
    d.textContent = text;
    out.appendChild(d);
    out.scrollTop = out.scrollHeight;
  }
  function writeHTML(html, cls) {
    const d = document.createElement('div');
    d.className = 'line' + (cls ? ' ' + cls : '');
    d.innerHTML = html;
    out.appendChild(d);
    out.scrollTop = out.scrollHeight;
  }
  const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  function updatePrompt() {
    promptEl.innerHTML = `<span class="user">${esc(username)}</span>@<span class="dim">wmos</span>:<span class="path">${esc(cwd)}</span>$&nbsp;`;
  }

  /* ============================================================
     BANNER
     ============================================================ */
  write('');
  writeHTML('<span class="banner">  ⌨️  MelonCI v1.0</span>');
  writeHTML('<span class="dim">  Terminal for WatermelonOS · WFS via bridge</span>');
  writeHTML('<span class="dim">  Напиши </span><span class="ok">help</span><span class="dim"> для списка команд</span>');
  write('');

  /* ============================================================
     COMMANDS
     ============================================================ */
  const resolve = p => p ? (p.startsWith('/') ? WFS.norm(p) : WFS.norm(cwd + '/' + p)) : cwd;

  const CMDS = {
    async help() {
      writeHTML('<span class="info">Команды:</span>');
      const g = [
        ['Навигация','ls, cd, pwd, tree'],
        ['Файлы','touch, cat, head, tail, wc, echo, write'],
        ['Папки','mkdir, rm'],
        ['Копир.','cp, mv'],
        ['Поиск','find, grep'],
        ['Инфо','stat, du, df, whoami, date'],
        ['Система','apps, open, clear, history'],
      ];
      g.forEach(([a,b]) => writeHTML(`  <span class="warn">${a.padEnd(10)}</span> <span class="dim">${b}</span>`));
      writeHTML('');
      writeHTML('<span class="dim">Tab — автодополнение · ↑/↓ — история · Ctrl+L — очистка</span>');
    },

    async ls(args) {
      const path = resolve(args.find(a => !a.startsWith('-')));
      const items = await WFS.ls(path);
      if (!items.length) { write('пусто', 'dim'); return; }
      items.sort((a,b) => a.type !== b.type ? (a.type === 'dir' ? -1 : 1) : a.name.localeCompare(b.name));
      const long = args.includes('-l') || args.includes('-la');
      if (long) {
        for (const it of items) {
          const d = new Date(it.mtime);
          const dstr = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
          const size = it.type === 'dir' ? '—' : String(it.size || 0);
          const name = it.type === 'dir'
            ? `<span class="dir">${esc(it.name)}/</span>`
            : `<span class="file">${esc(it.name)}</span>`;
          writeHTML(`  <span class="dim">${it.type === 'dir' ? 'DIR ' : 'FILE'}</span>  <span class="dim">${String(size).padStart(7)}</span>  <span class="dim">${dstr}</span>  ${name}`);
        }
      } else {
        writeHTML('  ' + items.map(it => it.type === 'dir'
          ? `<span class="dir">${esc(it.name)}/</span>`
          : `<span class="file">${esc(it.name)}</span>`).join('   '));
      }
    },

    async cd(args) {
      let t = args[0] || '/';
      if (t === '~') t = '/home/' + username;
      t = resolve(t);
      const st = await WFS.stat(t);
      if (st.type !== 'dir') throw new Error('Не папка: ' + t);
      cwd = t;
      updatePrompt();
    },

    async pwd() { write(cwd); },

    async mkdir(args) {
      if (!args.length) throw new Error('mkdir: нужен аргумент');
      for (const a of args) {
        const p = resolve(a);
        await WFS.mkdir(p);
        write('✓ ' + p, 'ok');
      }
    },

    async touch(args) {
      if (!args.length) throw new Error('touch: нужен аргумент');
      const p = resolve(args[0]);
      await WFS.touch(p);
      write('✓ ' + p, 'ok');
    },

    async cat(args) {
      if (!args.length) throw new Error('cat: нужен файл');
      const p = resolve(args[0]);
      const t = await WFS.readText(p);
      String(t).split('\n').forEach(l => write(l));
    },

    async head(args) {
      const n = parseInt((args.find(a => a.startsWith('-n')) || '').slice(2)) || 10;
      const file = args.find(a => !a.startsWith('-'));
      if (!file) throw new Error('head: нужен файл');
      const t = await WFS.readText(resolve(file));
      String(t).split('\n').slice(0, n).forEach(l => write(l));
    },

    async tail(args) {
      const n = parseInt((args.find(a => a.startsWith('-n')) || '').slice(2)) || 10;
      const file = args.find(a => !a.startsWith('-'));
      if (!file) throw new Error('tail: нужен файл');
      const t = await WFS.readText(resolve(file));
      String(t).split('\n').slice(-n).forEach(l => write(l));
    },

    async wc(args) {
      if (!args.length) throw new Error('wc: нужен файл');
      const t = await WFS.readText(resolve(args[0]));
      const l = String(t).split('\n').length;
      const w = String(t).split(/\s+/).filter(Boolean).length;
      write(`${l} строк  ${w} слов  ${String(t).length} символов  ${args[0]}`);
    },

    async echo(args) {
      const raw = args.join(' ');
      const m = raw.match(/^(.*?)\s*(>>|>)\s*(\S+)\s*$/);
      if (m) {
        const [, text, op, file] = m;
        const p = resolve(file);
        if (op === '>') await WFS.write(p, text);
        else await WFS.append(p, text + '\n');
        write('✓ ' + p, 'ok');
      } else write(raw);
    },

    async write(args) {
      if (args.length < 2) throw new Error('write: <файл> <текст>');
      const p = resolve(args[0]);
      await WFS.write(p, args.slice(1).join(' '));
      write('✓ ' + p, 'ok');
    },

    async rm(args) {
      const rec = args.includes('-r') || args.includes('-rf');
      const files = args.filter(a => !a.startsWith('-'));
      if (!files.length) throw new Error('rm: нужен аргумент');
      for (const f of files) {
        const p = resolve(f);
        await WFS.rm(p, rec);
        write('✓ ' + p, 'ok');
      }
    },

    async cp(args) {
      if (args.length < 2) throw new Error('cp: <откуда> <куда>');
      await WFS.cp(resolve(args[0]), resolve(args[1]));
      write('✓ скопировано', 'ok');
    },

    async mv(args) {
      if (args.length < 2) throw new Error('mv: <откуда> <куда>');
      await WFS.mv(resolve(args[0]), resolve(args[1]));
      write('✓ перемещено', 'ok');
    },

    async stat(args) {
      if (!args.length) throw new Error('stat: нужен путь');
      const st = await WFS.stat(resolve(args[0]));
      write(`  Имя:     ${st.name}`);
      write(`  Тип:     ${st.type === 'dir' ? 'папка' : 'файл'}`);
      write(`  Размер:  ${st.size} байт`);
      write(`  Изменён: ${new Date(st.mtime).toLocaleString('ru-RU')}`);
      write(`  Создан:  ${new Date(st.created).toLocaleString('ru-RU')}`);
    },

    async tree(args) {
      const root = resolve(args[0]);
      const all = await WFS.listAll();
      const map = new Map();
      for (const n of all) {
        const par = n.parent || '/';
        if (!map.has(par)) map.set(par, []);
        map.get(par).push(n);
      }
      writeHTML(`<span class="dir">${esc(root)}/</span>`);
      function rec(path, prefix, isLast) {
        const name = WFS.basename(path);
        const node = all.find(n => n.path === path);
        const isDir = node && node.type === 'dir';
        writeHTML(prefix + (isLast ? '└── ' : '├── ') +
          (isDir ? `<span class="dir">${esc(name)}/</span>` : `<span class="file">${esc(name)}</span>`));
        if (!isDir) return;
        const kids = (map.get(path) || []).sort((a,b) => a.type !== b.type ? (a.type === 'dir' ? -1 : 1) : a.name.localeCompare(b.name));
        kids.forEach((k, i) => rec(k.path, prefix + (isLast ? '    ' : '│   '), i === kids.length - 1));
      }
      const kids = (map.get(root) || []).sort((a,b) => a.type !== b.type ? (a.type === 'dir' ? -1 : 1) : a.name.localeCompare(b.name));
      kids.forEach((k, i) => rec(k.path, '', i === kids.length - 1));
    },

    async find(args) {
      if (!args[0]) throw new Error('find: нужен шаблон (например *.txt)');
      const results = await WFS.find(args[0], cwd);
      if (!results.length) { write('Ничего не найдено', 'dim'); return; }
      for (const p of results) {
        const st = await WFS.stat(p);
        writeHTML(st.type === 'dir' ? `<span class="dir">${esc(p)}/</span>` : `<span class="file">${esc(p)}</span>`);
      }
    },

    async grep(args) {
      if (args.length < 2) throw new Error('grep: <текст> <файл>');
      const [needle, file] = args;
      const text = await WFS.readText(resolve(file));
      let found = 0;
      String(text).split('\n').forEach((l, i) => {
        if (l.includes(needle)) {
          found++;
          const re = new RegExp(needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
          writeHTML(`<span class="dim">${String(i+1).padStart(4)}:</span> ` + esc(l).replace(re, `<span class="hl">${esc(needle)}</span>`));
        }
      });
      if (!found) write('Совпадений нет', 'dim');
    },

    async du(args) {
      const p = resolve(args[0]);
      const size = await WFS.du(p);
      write(`${(size/1024).toFixed(2)} КБ  ${p}`);
    },

    async df() {
      const { files, dirs, bytes, quota } = await WFS.df();
      write(`  Файлов:  ${files}`);
      write(`  Папок:   ${dirs}`);
      write(`  Занято:  ${(bytes/1024).toFixed(2)} КБ из ${(quota/1024/1024).toFixed(0)} МБ`);
      const pct = (bytes / quota * 100).toFixed(2);
      const bars = Math.round(bytes / quota * 30);
      writeHTML(`  <span class="dim">[${'█'.repeat(bars)}${'░'.repeat(Math.max(0,30-bars))}] ${pct}%</span>`);
    },

    async whoami() { write(username); },

    async date() { write(new Date().toLocaleString('ru-RU')); },

    async apps() {
      try {
        const pdoc = window.parent.document;
        const icons = pdoc.querySelectorAll('.wmos-icon');
        if (icons.length) {
          writeHTML('<span class="info">Приложения на рабочем столе:</span>');
          icons.forEach(ic => {
            const name = ic.querySelector('.l')?.textContent || '?';
            const icon = ic.querySelector('.e')?.textContent || '📦';
            const id = ic.dataset.app || ic.dataset.appId || ic.dataset.inta || '';
            writeHTML(`  ${icon}  <span class="exec">${esc(name)}</span> <span class="dim">(${esc(id)})</span>`);
          });
          return;
        }
      } catch {}
      write('Список приложений недоступен', 'warn');
    },

    async open(args) {
      if (!args.length) throw new Error('open: нужен ID');
      try {
        window.parent.postMessage({ type: 'wmos:open', id: args[0] }, '*');
        write('→ открываю: ' + args[0], 'ok');
      } catch { write('Ошибка', 'err'); }
    },

    async clear() { out.innerHTML = ''; },
    async history() { history.slice(-30).reverse().forEach((h,i) => write(`  ${String(i+1).padStart(3)}  ${h}`)); },
    async exit() {
      try { window.parent.postMessage({ type: 'wmos:close-app' }, '*'); } catch {}
      write('Закрываю…', 'dim');
    }
  };

  /* ============================================================
     EXECUTION
     ============================================================ */
  function tokenize(s) {
    const t = []; let cur = ''; let q = null;
    for (const c of s) {
      if (q) { if (c === q) q = null; else cur += c; }
      else if (c === '"' || c === "'") q = c;
      else if (c === ' ' || c === '\t') { if (cur) { t.push(cur); cur = ''; } }
      else cur += c;
    }
    if (cur) t.push(cur);
    return t;
  }

  async function execute(input) {
    input = String(input).trim();
    if (!input) return;
    writeHTML(`<span class="u">${esc(username)}</span>@<span class="dim">wmos</span>:<span class="p">${esc(cwd)}</span>$ <span>${esc(input)}</span>`, 'cmd-echo');
    history.push(input);
    if (history.length > 200) history.shift();
    saveHist();
    hIdx = history.length;

    const tok = tokenize(input);
    const name = tok[0];
    const args = tok.slice(1);
    const fn = CMDS[name];
    if (!fn) {
      write('Команда не найдена: ' + name, 'err');
      write('Попробуй help', 'dim');
      return;
    }
    try { await fn(args); }
    catch (e) { write('✗ ' + (e.message || String(e)), 'err'); }
  }

  /* ============================================================
     INPUT
     ============================================================ */
  cmd.addEventListener('keydown', async e => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const v = cmd.value; cmd.value = '';
      await execute(v);
      hIdx = history.length;
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (!history.length) return;
      hIdx = Math.max(0, hIdx - 1);
      cmd.value = history[hIdx] || '';
      setTimeout(() => cmd.setSelectionRange(cmd.value.length, cmd.value.length), 0);
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      hIdx = Math.min(history.length, hIdx + 1);
      cmd.value = history[hIdx] || '';
      setTimeout(() => cmd.setSelectionRange(cmd.value.length, cmd.value.length), 0);
    } else if (e.key === 'Tab') {
      e.preventDefault(); await autocomplete();
    } else if (e.key === 'l' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault(); out.innerHTML = '';
    } else if (e.key === 'c' && e.ctrlKey) {
      e.preventDefault(); cmd.value = ''; write('^C', 'dim');
    }
  });

  async function autocomplete() {
    const val = cmd.value;
    const tok = tokenize(val);
    if (tok.length <= 1 && !val.endsWith(' ')) {
      const p = tok[0] || '';
      const m = Object.keys(CMDS).filter(c => c.startsWith(p));
      if (m.length === 1) cmd.value = m[0] + ' ';
      else if (m.length > 1) writeHTML('  ' + m.map(x => `<span class="exec">${x}</span>`).join('  '));
      return;
    }
    const partial = tok[tok.length - 1] || '';
    const si = partial.lastIndexOf('/');
    const dirPart = si >= 0 ? partial.slice(0, si) : '';
    const filePart = si >= 0 ? partial.slice(si + 1) : partial;
    const searchDir = dirPart ? resolve(dirPart) : cwd;
    try {
      const items = await WFS.ls(searchDir);
      const m = items.filter(it => it.name.startsWith(filePart))
        .map(it => it.name + (it.type === 'dir' ? '/' : ''));
      if (m.length === 1) {
        cmd.value = val.slice(0, val.length - partial.length) + (dirPart ? dirPart + '/' : '') + m[0];
      } else if (m.length > 1) {
        writeHTML('  ' + m.map(x => x.endsWith('/')
          ? `<span class="dir">${esc(x)}</span>`
          : `<span class="file">${esc(x)}</span>`).join('  '));
      }
    } catch {}
  }

  /* ============================================================
     INIT
     ============================================================ */
  WFS.ready.then(async () => {
    try {
      const u = await WFS.getUser();
      if (u) username = u;
    } catch {}
    cwd = '/home/' + username;
    try {
      const st = await WFS.stat(cwd);
      if (st.type !== 'dir') cwd = '/';
    } catch { cwd = '/'; }
    updatePrompt();
    cmd.focus();
  }).catch(err => {
    write('✗ Ошибка инициализации WFS: ' + err.message, 'err');
    write('Проверь, что мост WFS-Bridge вставлен в index.html', 'dim');
    cwd = '/';
    updatePrompt();
  });

  document.addEventListener('click', () => {
    if (!window.getSelection().toString()) cmd.focus();
  });
  window.addEventListener('focus', () => cmd.focus());
})();
</script>
</body>
</html>
