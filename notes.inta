inta.stg:{namer,icon,background
namer:app.name:["Заметки"],what.name=namer
icon:app.ico:["📝"],what.ico=icon
background:app.bg:[#0a1710],what.ico.bg=background
}
IL.cfg={scripts:all}
Inta.cfg={pc,tablet,phone}
load.stop_parse.inta

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Заметки</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,system-ui,sans-serif;background:#0a1710;color:#fff0f3;overflow:hidden}
  ::-webkit-scrollbar{display:none;width:0;height:0}
  *{scrollbar-width:none}

  .app{display:flex;height:100%}
  .list{
    width:280px;
    flex-shrink:0;
    display:flex;
    flex-direction:column;
    background:rgba(0,0,0,.28);
    border-right:1px solid rgba(255,255,255,.08);
    min-width:0;
  }
  .list-head{padding:12px 12px 10px;border-bottom:1px solid rgba(255,255,255,.08);flex-shrink:0}
  .list-head-row{display:flex;gap:6px;margin-bottom:8px}
  .search{
    flex:1;
    padding:8px 12px;
    border-radius:9px;
    background:rgba(0,0,0,.35);
    border:1px solid rgba(255,255,255,.12);
    color:#fff0f3;
    outline:none;
    font-family:inherit;
    font-size:12.5px;
  }
  .search:focus{border-color:#ff4d6d}
  .new-btn{
    width:34px;height:34px;
    border-radius:9px;border:0;cursor:pointer;
    background:linear-gradient(135deg,#ff4d6d,#c9184a);
    color:#fff;font-size:18px;font-weight:600;line-height:1;
    display:grid;place-items:center;flex-shrink:0;
    transition:.15s;
  }
  .new-btn:hover{filter:brightness(1.1)}
  .new-btn:active{transform:scale(.94)}

  .list-count{
    font-size:11px;opacity:.5;padding:0 2px;
  }

  .list-items{
    flex:1;overflow-y:auto;padding:6px;
  }
  .item{
    padding:10px 11px;
    border-radius:10px;
    cursor:pointer;
    margin-bottom:3px;
    transition:.12s;
    border:1px solid transparent;
  }
  .item:hover{background:rgba(255,255,255,.05)}
  .item.on{background:rgba(255,77,109,.15);border-color:rgba(255,77,109,.4)}
  .item .it{
    font-size:13px;font-weight:600;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    margin-bottom:3px;
  }
  .item .ip{
    font-size:11px;opacity:.5;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    line-height:1.35;
  }
  .item .id2{
    font-size:10px;opacity:.35;margin-top:3px;
  }

  .empty-list{
    padding:30px 16px;text-align:center;opacity:.4;font-size:12px;line-height:1.6;
  }

  .editor{
    flex:1;
    display:flex;
    flex-direction:column;
    min-width:0;
    min-height:0;
  }

  .empty-editor{
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:14px;
    opacity:.35;
    text-align:center;
    padding:30px;
  }
  .empty-editor .e{font-size:52px;line-height:1}
  .empty-editor .t{font-size:15px;font-weight:600}
  .empty-editor .s{font-size:12.5px;opacity:.8}

  .ed-head{
    display:flex;
    gap:6px;
    padding:10px 14px;
    border-bottom:1px solid rgba(255,255,255,.08);
    align-items:center;
    flex-shrink:0;
    background:rgba(0,0,0,.15);
  }
  .ed-head .back{
    display:none;
    width:34px;height:34px;
    border-radius:9px;border:0;cursor:pointer;
    background:rgba(255,255,255,.08);
    color:#fff0f3;font-size:15px;
    align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .ed-head .back:hover{background:rgba(255,255,255,.15)}
  .ed-title{
    flex:1;
    background:transparent;border:0;
    color:#fff0f3;
    font-size:17px;font-weight:600;
    font-family:inherit;
    outline:none;
    padding:6px 4px;
    min-width:0;
  }
  .ed-title::placeholder{opacity:.35}
  .ed-action{
    width:34px;height:34px;
    border-radius:9px;border:0;cursor:pointer;
    background:rgba(255,255,255,.06);
    color:#fff0f3;font-size:15px;line-height:1;
    display:grid;place-items:center;flex-shrink:0;
    transition:.15s;
  }
  .ed-action:hover{background:rgba(255,255,255,.15)}
  .ed-action.danger:hover{background:rgba(201,24,74,.4)}

  .ed-body{
    flex:1;
    padding:14px 20px 18px;
    overflow-y:auto;
    display:flex;
    flex-direction:column;
    min-height:0;
  }
  .ed-text{
    width:100%;
    flex:1;
    min-height:200px;
    background:transparent;
    border:0;
    outline:none;
    resize:none;
    color:#fff0f3;
    font-family:inherit;
    font-size:14px;
    line-height:1.65;
    padding:0;
  }
  .ed-text::placeholder{opacity:.3}

  .ed-foot{
    display:flex;
    gap:12px;
    padding:8px 20px;
    border-top:1px solid rgba(255,255,255,.06);
    font-size:11px;
    opacity:.5;
    flex-shrink:0;
    justify-content:space-between;
    background:rgba(0,0,0,.15);
  }
  .ed-foot .stat{font-variant-numeric:tabular-nums}
  .ed-foot .saved{color:#95d5b2;transition:.2s;opacity:0}
  .ed-foot .saved.on{opacity:1}

  .modal{
    position:fixed;inset:0;z-index:100;
    background:rgba(0,0,0,.6);backdrop-filter:blur(4px);
    display:none;align-items:center;justify-content:center;padding:20px;
  }
  .modal.on{display:flex}
  .modal-box{
    width:100%;max-width:380px;
    background:#12291f;
    border:1px solid rgba(255,255,255,.12);
    border-radius:14px;
    padding:22px;
    box-shadow:0 30px 80px rgba(0,0,0,.7);
  }
  .modal-box h3{font-size:16px;margin-bottom:10px}
  .modal-box p{font-size:13px;opacity:.75;line-height:1.5;margin-bottom:18px}
  .modal-acts{display:flex;gap:8px}
  .modal-acts button{
    flex:1;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.16);
    background:rgba(255,255,255,.06);color:#fff0f3;
    font-family:inherit;font-size:13px;cursor:pointer;transition:.15s;
  }
  .modal-acts button:hover{background:rgba(255,255,255,.14)}
  .modal-acts button.danger{
    background:rgba(201,24,74,.2);border-color:rgba(255,77,109,.45);color:#ffb3c1;
  }
  .modal-acts button.danger:hover{background:rgba(201,24,74,.35)}

  /* мобильный */
  body.mobile .list{width:100%;border-right:0}
  body.mobile .editor{display:none}
  body.mobile.editing .list{display:none}
  body.mobile.editing .editor{display:flex}
  body.mobile .ed-head .back{display:grid}

  @media (max-width:600px){
    .list{width:100%;border-right:0}
    .editor{display:none}
    body.editing .list{display:none}
    body.editing .editor{display:flex}
    .ed-head .back{display:grid}
  }
</style>
</head>
<body>
<div class="app">

  <div class="list">
    <div class="list-head">
      <div class="list-head-row">
        <input class="search" id="search" placeholder="Поиск…" autocomplete="off">
        <button class="new-btn" id="newNote" title="Новая заметка">+</button>
      </div>
      <div class="list-count" id="count">— заметок</div>
    </div>
    <div class="list-items" id="items"></div>
  </div>

  <div class="editor">
    <div class="empty-editor" id="emptyEd">
      <div class="e">📝</div>
      <div class="t">Ничего не выбрано</div>
      <div class="s">Выбери заметку слева или создай новую</div>
    </div>

    <div class="ed-head" id="edHead" style="display:none">
      <button class="back" id="backBtn" title="Назад">←</button>
      <input class="ed-title" id="edTitle" placeholder="Заголовок…" maxlength="120">
      <button class="ed-action" id="exportOne" title="Скопировать">📋</button>
      <button class="ed-action danger" id="delBtn" title="Удалить">🗑</button>
    </div>

    <div class="ed-body" id="edBody" style="display:none">
      <textarea class="ed-text" id="edText" placeholder="Текст заметки…" spellcheck="false"></textarea>
    </div>

    <div class="ed-foot" id="edFoot" style="display:none">
      <span class="stat" id="statChars">0 символов</span>
      <span class="saved" id="savedTag">сохранено ✓</span>
    </div>
  </div>
</div>

<div class="modal" id="modal">
  <div class="modal-box">
    <h3 id="mTitle">Удалить заметку?</h3>
    <p id="mText">Это действие нельзя отменить.</p>
    <div class="modal-acts">
      <button id="mCancel">Отмена</button>
      <button class="danger" id="mOk">Удалить</button>
    </div>
  </div>
</div>

<script>
(() => {
  "use strict";
  const $ = id => document.getElementById(id);

  /* === Безопасное хранилище (file:// friendly) === */
  const memStore = {};
  const Store = {
    get(k) {
      try { return localStorage.getItem(k); }
      catch { return Object.prototype.hasOwnProperty.call(memStore, k) ? memStore[k] : null; }
    },
    set(k, v) {
      try { localStorage.setItem(k, v); }
      catch { memStore[k] = String(v); }
    }
  };

  const KEY = 'wmos:notes:list';

  let notes = [];
  try { notes = JSON.parse(Store.get(KEY) || '[]') || []; } catch { notes = []; }
  let activeId = null;
  let query = '';
  let saveTimer = null;

  const esc = s => String(s).replace(/[&<>"']/g, c =>
    ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2,6); }
  function persist() { Store.set(KEY, JSON.stringify(notes)); }
  function byId(id) { return notes.find(n => n.id === id); }

  function fmtDate(ts) {
    const d = new Date(ts);
    const now = Date.now();
    const diff = (now - ts) / 1000;
    if (diff < 60) return 'только что';
    if (diff < 3600) return Math.floor(diff/60) + ' мин назад';
    if (diff < 86400) return Math.floor(diff/3600) + ' ч назад';
    if (diff < 604800) return Math.floor(diff/86400) + ' дн назад';
    return d.toLocaleDateString('ru-RU', { day:'numeric', month:'short' });
  }

  function getPreview(n) {
    if (!n.body) return 'пусто';
    return n.body.replace(/\s+/g, ' ').trim().slice(0, 80) || 'пусто';
  }

  /* === Список === */
  function filtered() {
    if (!query) return notes;
    const q = query.toLowerCase();
    return notes.filter(n =>
      (n.title || '').toLowerCase().includes(q) ||
      (n.body || '').toLowerCase().includes(q));
  }

  function renderList() {
    const list = filtered();
    $('count').textContent = notes.length === 1 ? '1 заметка'
      : `${notes.length} заметок`;

    const el = $('items');
    if (!list.length) {
      el.innerHTML = `<div class="empty-list">${
        query ? 'Ничего не найдено' : 'Пока пусто<br>нажми + чтобы создать'
      }</div>`;
      return;
    }

    el.innerHTML = list.map(n => `
      <div class="item ${n.id === activeId ? 'on' : ''}" data-id="${esc(n.id)}">
        <div class="it">${esc(n.title || 'Без названия')}</div>
        <div class="ip">${esc(getPreview(n))}</div>
        <div class="id2">${fmtDate(n.updatedAt)}</div>
      </div>
    `).join('');
  }

  function refreshItem(id) {
    const node = document.querySelector(`.item[data-id="${id}"]`);
    const n = byId(id);
    if (!node || !n) { renderList(); return; }
    node.querySelector('.it').textContent = n.title || 'Без названия';
    node.querySelector('.ip').textContent = getPreview(n);
    node.querySelector('.id2').textContent = fmtDate(n.updatedAt);
  }

  /* === Редактор === */
  function openNote(id) {
    const n = byId(id); if (!n) return;
    activeId = id;
    $('emptyEd').style.display = 'none';
    $('edHead').style.display = 'flex';
    $('edBody').style.display = 'flex';
    $('edFoot').style.display = 'flex';
    $('edTitle').value = n.title || '';
    $('edText').value = n.body || '';
    updateStat();
    document.body.classList.add('editing');
    renderList();
    setTimeout(() => $('edTitle').focus(), 30);
  }

  function closeEditor() {
    activeId = null;
    $('emptyEd').style.display = 'flex';
    $('edHead').style.display = 'none';
    $('edBody').style.display = 'none';
    $('edFoot').style.display = 'none';
    document.body.classList.remove('editing');
    renderList();
  }

  function updateStat() {
    const chars = $('edText').value.length;
    $('statChars').textContent = chars + ' символов';
  }

  function scheduleSave() {
    const n = byId(activeId); if (!n) return;
    n.title = $('edTitle').value;
    n.body = $('edText').value;
    n.updatedAt = Date.now();
    persist();
    refreshItem(activeId);
    updateStat();

    const tag = $('savedTag');
    tag.classList.remove('on');
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      tag.classList.add('on');
      setTimeout(() => tag.classList.remove('on'), 900);
    }, 250);
  }

  /* === Действия === */
  function newNote() {
    const n = { id: uid(), title: '', body: '', updatedAt: Date.now() };
    notes.unshift(n);
    persist();
    openNote(n.id);
  }

  function deleteNote(id) {
    notes = notes.filter(n => n.id !== id);
    persist();
    if (activeId === id) closeEditor();
    else renderList();
  }

  let confirmCb = null;
  function confirmDialog(title, text, cb) {
    $('mTitle').textContent = title;
    $('mText').textContent = text;
    confirmCb = cb;
    $('modal').classList.add('on');
  }
  $('mCancel').addEventListener('click', () => { $('modal').classList.remove('on'); confirmCb = null; });
  $('mOk').addEventListener('click', () => {
    if (confirmCb) confirmCb();
    $('modal').classList.remove('on');
    confirmCb = null;
  });
  $('modal').addEventListener('click', e => {
    if (e.target === $('modal')) { $('modal').classList.remove('on'); confirmCb = null; }
  });

  async function copyToClipboard(text) {
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {}
    try {
      const ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); ta.remove();
      return true;
    } catch { return false; }
  }

  /* === События === */
  $('newNote').addEventListener('click', newNote);
  $('search').addEventListener('input', e => { query = e.target.value.trim(); renderList(); });
  $('items').addEventListener('click', e => {
    const it = e.target.closest('.item'); if (!it) return;
    openNote(it.dataset.id);
  });
  $('backBtn').addEventListener('click', closeEditor);
  $('delBtn').addEventListener('click', () => {
    if (!activeId) return;
    const n = byId(activeId); if (!n) return;
    confirmDialog('Удалить заметку?', `«${n.title || 'Без названия'}» будет удалена безвозвратно.`, () => deleteNote(activeId));
  });
  $('exportOne').addEventListener('click', async () => {
    if (!activeId) return;
    const n = byId(activeId); if (!n) return;
    const text = (n.title ? n.title + '\n\n' : '') + (n.body || '');
    const ok = await copyToClipboard(text);
    const tag = $('savedTag');
    tag.textContent = ok ? 'скопировано ✓' : 'не удалось';
    tag.classList.add('on');
    setTimeout(() => {
      tag.classList.remove('on');
      setTimeout(() => { tag.textContent = 'сохранено ✓'; }, 200);
    }, 1200);
  });

  $('edTitle').addEventListener('input', scheduleSave);
  $('edText').addEventListener('input', scheduleSave);

  /* === Клавиатура === */
  document.addEventListener('keydown', e => {
    const mod = e.ctrlKey || e.metaKey;
    if (mod && e.key === 'n') { e.preventDefault(); newNote(); }
    if (mod && e.key === 'f') { e.preventDefault(); $('search').focus(); }
    if (e.key === 'Escape') {
      if ($('modal').classList.contains('on')) { $('modal').classList.remove('on'); confirmCb = null; }
      else if (document.body.classList.contains('editing')) closeEditor();
    }
  });

  /* === Авто-режим mobile === */
  function setMobile() {
    document.body.classList.toggle('mobile', window.innerWidth < 600);
  }
  setMobile();
  window.addEventListener('resize', setMobile);

  /* === Init === */
  if (!notes.length) {
    notes.push({
      id: uid(),
      title: 'Добро пожаловать',
      body: 'Это Заметки WatermelonOS.\n\n• + — создать заметку\n• Клик по заметке — открыть\n• Всё сохраняется автоматически\n• 📋 — скопировать текст\n• 🗑 — удалить\n\nCtrl+N — новая\nCtrl+F — поиск',
      updatedAt: Date.now()
    });
    persist();
  }
  renderList();
})();
</script>
</body>
</html>
