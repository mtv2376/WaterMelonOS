    e:['скажи комплимент','сделай комплимент','приятное слово'],
    t:[
      ['{c}, {name}','co,st','all'],
      ['{c}! {c2}','co,ex','warm+'],
      ['{c}. {c2}','co,st','all'],
      ['{c}, {name}. {c2}','co,st','warm+'],
      ['{c}!','co,ex','hot+']
    ],
