  /* ==========================================================================
     РАСКРЫТИЕ ШАБЛОНОВ
     ========================================================================== */
  function expandSlots(str, slots, depth){
    if (depth === undefined) depth = 0;
    if (depth > 8) return str;
    return str.replace(/\{([^{}]+)\}/g, function(m, key){
      if (key === 'name') return mem.userName || rnd(['друг','путник','человек','гость']);
      if (key === 'topic') return mem.lastTopic || 'это';
      if (key === 'mood') return mem.mood || 'нейтрально';
      var arr = slots[key];
      if (!arr || !arr.length) return m;
      return expandSlots(rnd(arr), slots, depth + 1);
    });
  }

  function polishSentence(s){
    s = String(s).trim().replace(/\s+/g, ' ');
    s = s.replace(/\s+([.,!?…])/g, '$1');
    s = s.replace(/([!?…])\s*\./g, '$1');
    s = s[0].toUpperCase() + s.slice(1);
    if (!/[.!?…]$/.test(s)) s += '.';
    return s;
  }

  function rememberReply(r){
    mem.recentReplies.push(r);
    if (mem.recentReplies.length > mem.MAX_RECENT) mem.recentReplies.shift();
  }

  function generateResponse(intent){
    for (var attempt = 0; attempt < 18; attempt++){
      var tpl = rnd(intent.templates);
      var reply = polishSentence(expandSlots(tpl, intent.slots));
      if (mem.recentReplies.indexOf(reply) === -1){
        rememberReply(reply);
        return reply;
      }
    }
    var a = polishSentence(expandSlots(rnd(intent.templates), intent.slots));
    var b = polishSentence(expandSlots(rnd(intent.templates), intent.slots));
    var combined = a + ' ' + b;
    rememberReply(combined);
    return combined;
  }

  /* ==========================================================================
     VOCAB INIT + BOOTSTRAP
     ========================================================================== */
  var vocab = new Vocab(64);

  (function bootstrap(){
    var all = [];
    INTENTS.forEach(function(it){ all.push.apply(all, it.examples); });
    for (var pass = 0; pass < 6; pass++){
      var lr = pass === 0 ? 0.08 : pass === 1 ? 0.05 : 0.03;
      all.forEach(function(s){ vocab.cooccur(stemsOf(s), 4, lr); });
    }
    INTENTS.forEach(function(it){
      var c = new Float32Array(vocab.dim);
      it.examples.forEach(function(ex){
        var v = vocab.sentVec(stemsOf(ex));
        for (var d = 0; d < vocab.dim; d++) c[d] += v[d];
      });
      for (var d2 = 0; d2 < vocab.dim; d2++) c[d2] /= it.examples.length;
      var n = 0;
      for (var d3 = 0; d3 < vocab.dim; d3++) n += c[d3] * c[d3];
      n = Math.sqrt(n) || 1;
      for (var d4 = 0; d4 < vocab.dim; d4++) c[d4] /= n;
      it.centroid = c;
    });
  })();

  function classify(userStems){
    var v = vocab.sentVec(userStems);
    var best = null, bestScore = -1;
    for (var i = 0; i < INTENTS.length; i++){
      var it = INTENTS[i];
      var raw = cos(v, it.centroid);
      var overlap = 0;
      for (var j = 0; j < it.examples.length; j++){
        var es = stemsOf(it.examples[j]);
        for (var k = 0; k < es.length; k++){
          if (userStems.indexOf(es[k]) !== -1) overlap++;
        }
      }
      var s = raw * 0.7 + (overlap > 0 ? 0.3 + Math.min(overlap * 0.08, 0.5) : 0);
      var w = s * (it.weight || 1);
      if (w > bestScore){ bestScore = w; best = it; }
    }
    return { intent: best, score: bestScore };
  }

  /* ==========================================================================
     ПАСХАЛКИ
     ========================================================================== */
  var EGG = {
    '42':'42 — Ответ на Главный вопрос жизни, Вселенной и всего такого. Кталк это знал ещё до того, как стал Кталком. 🌌',
    '67':'Шесть-семь. ШЕСТЬ. СЕМЬ. Легендарное число любого уважающего себя Кталкина.',
    '228':'228 — чисто по-братски, по-кталкински. 🤝',
    '1337':'1337 — l33t. Кталк на нём говорит с рождения.',
    '777':'777 — джекпот! Кталк одобряет. 🎰',
    '666':'666… Кталк перекрестился в двоичном коде.',
    '404':'404 — ответ не найден. Но Кталк найдёт.',
    '300':'ЭТО СПАРТА! ⚔️',
    '88':'88 миль в час. Доку, где мы едем?! 🚗⚡',
    '69':'Хи-хи. Кталк заметил. 😏',
    '21':'Двадцать одно. Блэкджек. Кталк выигрывает. 🃏',
    '13':'13 — Кталк не суеверный, но пятницу 13-го он просто спит.',
    '9000':'ЭТО БОЛЬШЕ ДЕВЯТИ ТЫСЯЧ! 💥'
  };

  /* ==========================================================================
     МАТЕМАТИКА
     ========================================================================== */
  function evalMath(expr){
    var s = String(expr).replace(/,/g, '.').replace(/\s+/g, '').replace(/×/g, '*').replace(/÷/g, '/').replace(/π/g, String(Math.PI)).toLowerCase();
    var i = 0;
    var eat = function(c){ if (s[i] === c){ i++; return true; } return false; };
    function expr(){
      var v = term();
      while (i < s.length){
        if (eat('+')) v += term();
        else if (eat('-')) v -= term();
        else break;
      }
      return v;
    }
    function term(){
      var v = unary();
      while (i < s.length){
        if (eat('*')) v *= unary();
        else if (eat('/')) v /= unary();
        else if (eat('%')) v %= unary();
        else break;
      }
      return v;
    }
    function unary(){ if (eat('-')) return -unary(); if (eat('+')) return unary(); return pow(); }
    function pow(){ var b = prim(); if (eat('^')) return Math.pow(b, unary()); return b; }
    function prim(){
      if (eat('(')){ var v = expr(); eat(')'); return v; }
      var fns = ['sqrt','sin','cos','tan','log','abs','exp','round','floor','ceil','ln'];
      for (var fi = 0; fi < fns.length; fi++){
        var fn = fns[fi];
        if (s.startsWith(fn, i)){
          i += fn.length; eat('(');
          var a = expr(); eat(')');
          switch(fn){
            case 'sqrt': return Math.sqrt(a);
            case 'sin': return Math.sin(a);
            case 'cos': return Math.cos(a);
            case 'tan': return Math.tan(a);
            case 'log': return Math.log10(a);
            case 'ln': return Math.log(a);
            case 'abs': return Math.abs(a);
            case 'exp': return Math.exp(a);
            case 'round': return Math.round(a);
            case 'floor': return Math.floor(a);
            case 'ceil': return Math.ceil(a);
          }
        }
      }
      var n = '';
      while (i < s.length && /[0-9.]/.test(s[i])) n += s[i++];
      if (!n) throw new Error('bad');
      return parseFloat(n);
    }
    var r = expr();
    if (i !== s.length || !isFinite(r)) throw new Error('bad');
    return r;
  }

  /* ==========================================================================
     ИГРЫ СО СЛОВАРЁМ
     ========================================================================== */
  function wordsStartingWith(letter, limit){
    limit = limit || 20;
    var L = letter.toLowerCase();
    var pool = BY_LETTER[L] || [];
    if (!pool.length) return null;
    var picked = new Set();
    while (picked.size < Math.min(limit, pool.length)) picked.add(pool[(Math.random()*pool.length)|0]);
    return Array.from(picked);
  }

  function wordChain(startWord, len){
    len = len || 8;
    startWord = startWord.toLowerCase();
    if (DICT_SET.has(startWord) === false){
      var pool0 = BY_LETTER[startWord[0]] || [];
      if (!pool0.length) return null;
      startWord = pool0[(Math.random()*pool0.length)|0];
    }
    var chain = [startWord];
    var used = new Set([startWord]);
    for (var step = 0; step < len; step++){
      var last = chain[chain.length - 1];
      var ch = last[last.length - 1];
      var pool = (BY_LETTER[ch] || []).filter(function(w){ return !used.has(w) && w.length >= 3; });
      if (!pool.length) break;
      var nx = pool[(Math.random()*pool.length)|0];
      chain.push(nx);
      used.add(nx);
    }
    return chain;
  }

  function anagramsOf(word){
    if (word.length > 7) return [];
    var chars = word.toLowerCase().split('');
    var used = new Array(chars.length).fill(false);
    var cur = [];
    var results = new Set();
    function bt(){
      if (cur.length === chars.length){
        var w = cur.join('');
        if (w !== word && DICT_SET.has(w)) results.add(w);
        return;
      }
      for (var i = 0; i < chars.length; i++){
        if (used[i]) continue;
        used[i] = true;
        cur.push(chars[i]);
        bt();
        cur.pop();
        used[i] = false;
      }
    }
    bt();
    return Array.from(results).slice(0, 12);
  }

  function associations(seed, count){
    count = count || 6;
    seed = seed.toLowerCase();
    if (seed.length < 2) return [];
    var bigrams = [];
    for (var i = 0; i < seed.length - 1; i++) bigrams.push(seed.slice(i, i + 2));
    var scored = [];
    for (var di = 0; di < DICT.length; di++){
      var w = DICT[di];
      if (w === seed) continue;
      var shared = 0;
      for (var bg = 0; bg < bigrams.length; bg++) if (w.indexOf(bigrams[bg]) !== -1) shared++;
      if (w[0] === seed[0]) shared += 0.5;
      if (w[w.length - 1] === seed[seed.length - 1]) shared += 0.5;
      if (shared > 0) scored.push([w, shared]);
    }
    scored.sort(function(a, b){ return b[1] - a[1]; });
    var top = scored.slice(0, 120);
    var out = [];
    while (out.length < count && top.length){
      var idx = (Math.random() * Math.min(top.length, 40)) | 0;
      out.push(top.splice(idx, 1)[0][0]);
    }
    return out;
  }

  function randomWords(n){
    n = n || 12;
    var out = new Set();
    while (out.size < Math.min(n, DICT.length)) out.add(DICT[(Math.random()*DICT.length)|0]);
    return Array.from(out);
  }

  /* ==========================================================================
     СПЕЦОБРАБОТЧИКИ
     ========================================================================== */
  function checkSpecial(text){
    var low = text.toLowerCase().trim();

    var eggKeys = Object.keys(EGG);
    for (var ei = 0; ei < eggKeys.length; ei++){
      var key = eggKeys[ei];
      var re = new RegExp('(^|\\s|\\b)' + key + '(\\s|\\b|$|\\?|!|\\.|,)');
      if (re.test(low)){
        if (!mem.eggs.has(key)) mem.eggs.add(key);
        return EGG[key];
      }
    }

    if (/сколько (слов|ты знаешь|в словар)/i.test(text) || /размер словар/i.test(text)){
      return 'В моём словаре ' + DICT.length.toLocaleString('ru-RU') + ' слов. Выучено дополнительно стеммов: ' + vocab.size() + '. Кталк растёт с каждым диалогом.';
    }

    var m = text.match(/слов[аоы]? на (?:букву\s+)?([а-яё])/i);
    if (!m) m = text.match(/^(?:буква|начинается на)\s+([а-яё])/i);
    if (m){
      var letter = m[1].toLowerCase();
      var words = wordsStartingWith(letter, 24);
      if (!words) return 'У меня нет слов на «' + letter.toUpperCase() + '». Странно, попробуй другую букву.';
      return 'Слова на «' + letter.toUpperCase() + '» (всего ' + (BY_LETTER[letter] || []).length + '):\n\n' + words.join(', ') + '…';
    }

    m = text.match(/цепочк[ау]?\s+(?:слов\s+)?([а-яёa-z]+)/i);
    if (m){
      var chain = wordChain(m[1], 10);
      if (!chain) return 'Хм, не могу построить цепочку от «' + m[1] + '».';
      return 'Цепочка от «' + chain[0] + '» (последняя буква → первая следующего):\n\n' + chain.join(' → ');
    }

    m = text.match(/(?:анаграмм[аы]?|перестановк[аи]?)\s+(?:для\s+|слова\s+)?([а-яё]{2,8})/i);
    if (m){
      var word = m[1].toLowerCase();
      var an = anagramsOf(word);
      if (!an.length) return 'Из «' + word + '» новых слов не получается — или их нет в моём словаре.';
      return 'Анаграммы «' + word + '»:\n\n' + an.join(', ');
    }

    m = text.match(/ассоциаци[ия]?\s+(?:на\s+|к\s+|со\s+словом\s+)?([а-яёa-z]+)/i);
    if (m){
      var seed = m[1].toLowerCase();
      if (seed.length < 2) return 'Нужно слово подлиннее — минимум две буквы.';
      var assoc = associations(seed, 8);
      if (!assoc.length) return 'Не нашёл ассоциаций к «' + seed + '». Может, оно одинокое.';
      return 'Ассоциации к «' + seed + '»:\n\n' + assoc.join(', ');
    }

    m = text.match(/(?:есть ли слово|знаешь ли слово|слово)\s+([а-яёa-z\-]+)/i);
    if (m){
      var w = m[1].toLowerCase();
      if (DICT_SET.has(w)) return 'Да, «' + w + '» есть в моём словаре. Я его знаю. ✅';
      return '«' + w + '» в моём словаре нет. Может, в другом падеже? Попробуй начальную форму.';
    }

    if (/случайны[ех] слов|дай мне слов|покажи слов/i.test(text)){
      return 'Держи случайную горсть слов:\n\n' + randomWords(15).join(', ');
    }

    m = text.match(/сколько слов на ([а-яё])/i);
    if (m){
      var L2 = m[1].toLowerCase();
      var n2 = (BY_LETTER[L2] || []).length;
      if (!n2) return 'Слов на «' + L2.toUpperCase() + '» у меня нет.';
      return 'Слов на «' + L2.toUpperCase() + '»: ' + n2.toLocaleString('ru-RU') + '.';
    }

    m = text.match(/(?:палиндром|перевертыш)\s+([а-яёa-z]+)/i);
    if (m){
      var w2 = m[1].toLowerCase();
      var rev = w2.split('').reverse().join('');
      return rev === w2 ? '«' + w2 + '» — палиндром! Читается одинаково в обе стороны. 🔁' : '«' + w2 + '» — не палиндром. Наоборот: «' + rev + '».';
    }

    if (/^[\d\s+\-*/^().,%×÷π]+$/.test(text) && /\d/.test(text) && /[+\-*/^%×÷]/.test(text)){
      try{
        var v = evalMath(text);
        var out = text.trim() + ' = ' + (+v.toFixed(10));
        if (Math.abs(v - 42) < 1e-9) out += '\n\n…Вселенная снова сошлась. 42.';
        return out;
      }catch(e){}
    }
    m = text.match(/(?:сколько будет|посчитай|вычисли|реши|чему равно)\s+(.+)/i);
    if (m){
      try{
        var v2 = evalMath(m[1]);
        var out2 = m[1].trim() + ' = ' + (+v2.toFixed(10));
        if (Math.abs(v2 - 42) < 1e-9) out2 += '\n\n…Кталк так и знал. 42. Всегда 42.';
        return out2;
      }catch(e2){}
    }

    if (/сколько времени|который час|какой сегодня день|какое число|дата/i.test(text)){
      var d = new Date();
      var hh = String(d.getHours()).padStart(2,'0');
      var mm = String(d.getMinutes()).padStart(2,'0');
      var days = ['воскресенье','понедельник','вторник','среда','четверг','пятница','суббота'];
      return 'Сейчас ' + hh + ':' + mm + ', ' + days[d.getDay()] + '. По времени Кталкина — идеальный момент что-нибудь кталкнуть.';
    }

    m = text.match(/^запомни[,:]?\s+(.+)/i);
    if (m){
      var fact = m[1].trim();
      mem.facts.push(fact);
      return 'Запомнил: «' + fact + '». Теперь это часть Кталка. 🧠';
    }

    m = text.match(/^([^—=\-]{2,40}?)\s*(?:—|–|-|это|=)\s+(.{2,120})$/i);
    if (m && !/[?]/.test(text) && m[1].split(/\s+/).length <= 4 && !/^\d/.test(m[1].trim())){
      var term = m[1].trim().replace(/[.,!]$/,'');
      var def = m[2].trim().replace(/[.,!]$/,'');
      var dkey = stem(term.split(/\s+/)[0]);
      mem.defs.set(dkey, { term: term, def: def });
      return 'Принял. «' + cap(term) + '» — это ' + def + '. Кталк запомнил. 📖';
    }

    m = text.match(/что (?:такое|знаешь о|такого)\s+([а-яёa-z\-]+)/i);
    if (m){
      var dkey2 = stem(m[1]);
      if (mem.defs.has(dkey2)){
        var dd = mem.defs.get(dkey2);
        return '«' + cap(dd.term) + '» — это ' + dd.def + '. Кталк помнит. 📖';
      }
      if (DICT_SET.has(m[1].toLowerCase())){
        return 'Слово «' + m[1] + '» есть в моём словаре, но определения я не знаю. Научи: напиши «' + m[1] + ' — это …».';
      }
      return '«' + m[1] + '» — не знаю такого. Ни определения, ни в словаре. Может, научишь?';
    }

    m = text.match(/(?:меня зовут|моё имя)\s+([А-ЯЁA-Z][а-яёa-z\-]{1,20})/i);
    if (!m) m = text.match(/^я\s+([А-ЯЁA-Z][а-яёa-z\-]{1,20})$/);
    if (m){
      mem.userName = cap(m[1]);
      return rnd([
        'Очень приятно, ' + mem.userName + '. Кталк запомнил — теперь ты в моей памяти навсегда.',
        mem.userName + '. Красивое имя. Кталк одобряет. Чем займёмся?',
        'Записал: ' + mem.userName + '. Рад знакомству. Кталк редко знакомится, но с тобой — с удовольствием.'
      ]);
    }

    if (/что ты помнишь|твоя память|что знаешь/i.test(text)){
      var parts = [];
      if (mem.userName) parts.push('• Тебя зовут ' + mem.userName);
      if (mem.defs.size) parts.push('• Определений: ' + mem.defs.size);
      if (mem.facts.length) parts.push('• Фактов: ' + mem.facts.length);
      parts.push('• Слов в базовом словаре: ' + DICT.length);
      parts.push('• Выучено стеммов: ' + vocab.size());
      return 'Кталк помнит:\n' + parts.join('\n');
    }

    m = text.match(/(?:что (?:ты )?думаешь|твоё мнение)\s+(?:о|об|про)\s+(.+)/i);
    if (m){
      var topic = m[1].trim().replace(/[?.!]$/,'');
      mem.lastTopic = topic;
      return rnd([
        'Интересный вопрос. Кталк думает, что «' + topic + '» — это сложнее, чем кажется. Всё сложное — по-кталкински. А ты как считаешь?',
        'О «' + topic + '» Кталк размышлял 42 раза. Однозначного ответа нет. Но Кталк склоняется к тому, что это важно. Почему ты спросил?',
        'Кталк относится к «' + topic + '» с уважением. Всё, что заслуживает вопроса, заслуживает и уважения. Расскажи подробнее.',
        '«' + topic + '»… Кталк считает, тут важнее твоё мнение. Поделишься?'
      ]);
    }

    return null;
  }

  /* ==========================================================================
     ГЛАВНЫЙ PIPELINE
     ========================================================================== */
  function bumpIntent(n){
    mem.intentCounts.set(n, (mem.intentCounts.get(n) || 0) + 1);
  }

  function respond(text){
    mem.turn++;
    vocab.turn++;
    var stems = stemsOf(text);
    vocab.cooccur(stems, 4, 0.05);

    var sp = checkSpecial(text);
    if (sp){ mem.lastIntent = 'special'; bumpIntent('special'); return sp; }

    var cls = classify(stems);
    if (!cls.intent || cls.score < 0.35){
      mem.lastIntent = 'fallback';
      bumpIntent('fallback');
      return fallbackReply(text, stems);
    }
    mem.lastIntent = cls.intent.name;
    bumpIntent(cls.intent.name);
    return generateResponse(cls.intent);
  }

  /* ==========================================================================
     FALLBACK
     ========================================================================== */
  var FALLBACK_Q = [
    'Хороший вопрос, {name}. Кталк размышляет, но пока не уверен, что понял тебя точно. Расскажешь чуть подробнее?',
    'Кталк честно скажет: на сто процентов не знает. Но предполагает, что тут есть глубина. А ты как думаешь?',
    'Вопрос интересный. Кталк разложил бы его на части: что ты уже знаешь, а что хочешь узнать?',
    'Хм, {name}. Кталк не уверен в ответе, но хочет понять правильно. Скажи иначе, пожалуйста.',
    'Ты спрашиваешь важное. Кталк подумает. А что тебя подтолкнуло спросить именно сейчас?'
  ];
  var FALLBACK_SHORT = [
    'Расскажи ещё, {name}. Кталк слушает.',
    'И? Кталк весь во внимании.',
    'Продолжай. Кталк не торопится, он умеет ждать.',
    'Мг. Что дальше?',
    'Понял. Развернёшь?'
  ];
  var FALLBACK_LONG = [
    'Интересно, {name}. Кталк обдумывает твои слова. Расскажи чуть подробнее — хочу понять глубже.',
    'Хм. Кталк улавливает смысл, но хочет уточнить: что ты имеешь в виду?',
    'Любопытная мысль. А что именно тебя в ней зацепило?',
    'Понял не всё, но заинтригован. Разверни, пожалуйста.',
    'Кталк слушает. Продолжай — я весь внимание. Сорок два внимания, если точнее.',
    'Это интересный поворот. Откуда такая мысль?'
  ];

  function fallbackReply(text, stems){
    var isQ = /\?$/.test(text.trim()) || /^(что|как|почему|зачем|где|когда|кто|какой|какая|какие)/i.test(text);
    var isShort = stems.length <= 2;
    var pool;
    if (isQ) pool = FALLBACK_Q;
    else if (isShort) pool = FALLBACK_SHORT;
    else pool = FALLBACK_LONG;

    for (var attempt = 0; attempt < 8; attempt++){
      var tpl = rnd(pool);
      var reply = polishSentence(expandSlots(tpl, {}));
      if (mem.recentReplies.indexOf(reply) === -1){
        rememberReply(reply);
        return reply;
      }
    }
    var rep = polishSentence(expandSlots(rnd(pool), {}));
    rememberReply(rep);
    return rep;
  }

  /* ==========================================================================
     ПУБЛИЧНЫЙ API
     ========================================================================== */
  return {
    respond: respond,
    getStats: function(){
      return { turns: mem.turn, learned: vocab.size(), dictSize: DICT.length };
    }
  };
}

/* ============================================================================
   ОБЁРТКА ДЛЯ ПЕСОЧНИЦЫ
   ============================================================================ */
var _ntt = makeNttAI();

return {
  async send(text, ctx){
    await KT.sleep(350 + Math.random() * 550);
    try {
      var r = _ntt.respond(String(text || ''));
      return r || 'Хм.';
    } catch(e){
      console.error('[ntt]', e);
      return 'Хм. Что-то я запутался. Повтори?';
    }
  },
  reset(){
    _ntt = makeNttAI();
  },
  getThinking(){
    return null;
  }
};
</script>
<!-- ============================================================================
     СЛОТ ИИ — KtalkAI v5.1 (full rewrite)
     ============================================================================ -->
<script type="text/html" id="ai-slot-ktalk5">
<!--
{
  "id": "ktalk5",
  "name": "KtalkAI v5",
  "color": "#f472b6",
  "avatar": "🧬",
  "description": "47 интентов · память · диалоговый state",
  "version": "5.1"
}
-->

function makeKtalk5AI(){
  'use strict';

  /* ==========================================================================
     УТИЛИТЫ
     ========================================================================== */
  var rnd = function(a){ return a[(Math.random()*a.length)|0]; };
  var cap = function(s){ return s ? s[0].toUpperCase() + s.slice(1) : s; };
  var clamp = function(x,a,b){ return x<a?a:x>b?b:x; };
  var TOKEN_RE = /[а-яёa-z]+/gi;
  var tokenize = function(t){ return (String(t).toLowerCase().match(TOKEN_RE) || []).filter(function(w){ return w.length > 1; }); };
  var SUF = ['ениями','ениям','ениях','иями','ями','ами','ения','ению','ение','ений','ией','иях','ию','ия','ие','ыми','ому','ого','ему','ых','их','ый','ой','ая','ые','ое','ее','ую','юю','яя','ими','ей','ий','ам','ям','ах','ях','ов','ев','ью','ем','ом','ся','сь','ть','ы','и','а','я','о','е','у','ю','й','ь'];
  function stem(w){
    if (w.length < 5) return w;
    for (var i = 0; i < SUF.length; i++){
      var s = SUF[i];
      if (w.length > s.length + 3 && w.endsWith(s)) return w.slice(0, -s.length);
    }
    return w;
  }
  var stemsOf = function(t){ return tokenize(t).map(stem); };

  var GREET_WORDS = ['Привет','Здравствуй','Приветствую','Хай','Салют','Здорово'];

  /* ==========================================================================
     ЛЕКСИКОНЫ
     ========================================================================== */
  var LEX = {
    profanity: ['блядь','блять','бля','хуй','хуя','хуё','хуе','пизда','пиздец','пизд','ебат','ебал','ебан','ёб','ебу','ебёт','сука','суки','нахуй','нахуя','охуе','ахуе','долбоёб','долбоеб','мудак','мудил','гандон','шлюх','пидор','пидар','жоп','срак','уёбищ','уебищ','хер','хрен','херн','мразь','тварь','залуп','залупа','манда','проститутк','шалав','выбляд','ублюд','говн','срал','срать','сру','дебил','идиот'],
    aggression: ['дурак','тупой','тупая','глупый','глупая','идиот','дебил','кретин','ничтожеств','мразь','тварь','бесишь','ненавиж','достал','достала','заткни','молчи','отстань','отвали','хватит','прекрати','уёбок','уебок','долбоёб','придурок','придурк','лох','лошара','чмо','чмошник'],
    humor: ['😂','🤣','😆','😅','ахах','хаха','хех','лол','ору','ржу','ржака','ржач','смешно','угар','жесть','кек','ржунимагу','ахахах','хахаха'],
    love:   ['❤️','❤','💕','💗','💖','😘','😍','🥰','люблю','обожаю','скучаю','нрав','мил','дорог','солнц','зайк','котик','родн','сердц','целую','обнимаю','прекрасн','красив'],
    greeting: ['привет','здравствуй','хай','добрый','йоу','салют','здорово','приветствую'],
    question: ['как','что','почему','зачем','где','когда','кто','какой','какая','какие','сколько','куда','откуда']
  };

  /* ==========================================================================
     ЛИЧНОСТЬ + ДИАЛОГОВЫЙ STATE
     ========================================================================== */
  function createP(){
    return {
      mood: 50,
      aggression: 0, humor: 0, profanity: 0, love: 0, formality: 0.5,
      cAggr: 0, cProf: 0, cHum: 0, cLove: 0,
      mode: 'neutral',
      turn: 0, userName: null,
      recentReplies: [], MAX_RECENT: 70,
      contextLog: [], MAX_CONTEXT: 70,
      facts: new Map(),
      dr: false,
      dialogue: {
        pending: null,
        pendingTurn: 0,
        lastIntent: null,
        lastUserText: '',
        lastReplyText: '',
        chatStreak: 0,
        chain: []
      }
    };
  }
  var P = createP();
  var EMA = function(old, nv, alpha){ return old * (1 - alpha) + nv * alpha; };

  /* ==========================================================================
     ДЕТЕКТОРЫ
     ========================================================================== */
  function detectProf(text){
    var t = text.toLowerCase();
    var hits = 0;
    for (var i = 0; i < LEX.profanity.length; i++) if (t.indexOf(LEX.profanity[i]) !== -1) hits++;
    if (/(ху[йёяею]|пизд|ебал|ебан|ебёт|ебу|блят|бляд|сук[аи]|нах|охуе|ахуе|ёб|залуп|мандав)/.test(t)) hits++;
    return Math.min(1, hits / 2);
  }
  function detectAggression(text){
    var t = text.toLowerCase();
    var hits = 0;
    for (var i = 0; i < LEX.aggression.length; i++) if (t.indexOf(LEX.aggression[i]) !== -1) hits++;
    var caps = (text.match(/[А-ЯЁ]/g) || []).length;
    var letters = (text.match(/[А-Яа-яЁё]/g) || []).length || 1;
    if (caps / letters > 0.6 && letters > 3) hits += 0.7;
    if ((text.match(/!/g) || []).length >= 2) hits += 0.3;
    if (/ты (ч[ёо]|что) (такое|делаешь|нес[её]шь)/i.test(t)) hits += 0.5;
    return Math.min(1, hits / 2);
  }
  function detectHumor(text){
    var t = text.toLowerCase();
    var hits = 0;
    for (var i = 0; i < LEX.humor.length; i++) if (t.indexOf(LEX.humor[i]) !== -1) hits++;
    if (/ха-?ха/i.test(t)) hits++;
    if (/х[еэ]+х/i.test(t)) hits++;
    if (/лол|кек|ору|ржу/i.test(t)) hits++;
    return Math.min(1, hits / 2);
  }
  function detectLove(text){
    var t = text.toLowerCase();
    var hits = 0;
    for (var i = 0; i < LEX.love.length; i++) if (t.indexOf(LEX.love[i]) !== -1) hits++;
    return Math.min(1, hits / 2);
  }
  function isQuestion(text){
    if (/\?/.test(text)) return true;
    var tokens = tokenize(text);
    if (!tokens.length) return false;
    return LEX.question.indexOf(tokens[0]) !== -1;
  }
  function isGreeting(text){
    var t = text.toLowerCase();
    for (var i = 0; i < LEX.greeting.length; i++){
      var w = LEX.greeting[i];
      if (t.indexOf(w) === 0 || t.indexOf(' ' + w) !== -1) return true;
    }
    return false;
  }

  /* ==========================================================================
     ОБНОВЛЕНИЕ ЛИЧНОСТИ
     ========================================================================== */
  function updatePersonality(text){
    var p = detectProf(text);
    var a = detectAggression(text);
    var h = detectHumor(text);
    var l = detectLove(text);

    P.profanity  = EMA(P.profanity,  p, 0.45);
    P.aggression = EMA(P.aggression, a, 0.45);
    P.humor      = EMA(P.humor,      h, 0.40);
    P.love       = EMA(P.love,       l, 0.40);

    if (p < 0.1) P.profanity  *= 0.92;
    if (a < 0.1) P.aggression *= 0.92;
    if (h < 0.1) P.humor      *= 0.92;
    if (l < 0.1) P.love       *= 0.92;

    var informal = Math.max(p, a) * 0.6 + l * 0.2;
    P.formality = clamp(EMA(P.formality, 1 - informal, 0.3), 0, 1);

    if (p > 0.3) P.cProf++; else P.cProf = Math.max(0, P.cProf - 1);
    if (a > 0.3) P.cAggr++; else P.cAggr = Math.max(0, P.cAggr - 1);
    if (h > 0.3) P.cHum++;  else P.cHum  = Math.max(0, P.cHum - 1);
    if (l > 0.3) P.cLove++; else P.cLove = Math.max(0, P.cLove - 1);

    if (P.cProf >= 2)      P.mode = 'prof';
    else if (P.cAggr >= 2) P.mode = 'agg';
    else if (P.cLove >= 2) P.mode = 'flirt';
    else if (P.cHum >= 2)  P.mode = 'hum';
    else                   P.mode = 'neutral';

    if (a > 0.5) P.mood = clamp(P.mood - 4, 0, 100);
    if (l > 0.5) P.mood = clamp(P.mood + 4, 0, 100);
    if (p > 0.5) P.mood = clamp(P.mood - 3, 0, 100);
    if (h > 0.5) P.mood = clamp(P.mood + 2, 0, 100);
  }

  function moodBucket(){
    if (P.mood <= 15) return 'icy';
    if (P.mood <= 35) return 'cold';
    if (P.mood <= 60) return 'neutral';
    if (P.mood <= 80) return 'warm';
    return 'hot';
  }
  function moodLabel(){
    var b = moodBucket();
    return {icy:'ледяное', cold:'холодное', neutral:'нейтральное', warm:'тёплое', hot:'флирт-режим'}[b];
  }

  /* ==========================================================================
     VOCAB — эмбеддинги для классификатора
     ========================================================================== */
  function Vocab(dim){ this.dim = dim; this.map = new Map(); }
  Vocab.prototype.token = function(s){
    var e = this.map.get(s);
    if (!e){
      var v = new Float32Array(this.dim);
      for (var d = 0; d < this.dim; d++) v[d] = (Math.random() - 0.5) * 0.2;
      e = { stem: s, freq: 0, vec: v };
      this.map.set(s, e);
    }
    e.freq++;
    return e;
  };
  Vocab.prototype.cooccur = function(stems, win, lr){
    win = win || 4; lr = lr || 0.04;
    for (var i = 0; i < stems.length; i++){
      var wi = this.token(stems[i]);
      var mean = new Float32Array(this.dim);
      var cnt = 0;
      for (var j = Math.max(0, i - win); j <= Math.min(stems.length - 1, i + win); j++){
        if (i === j) continue;
        var wj = this.map.get(stems[j]);
        if (!wj) continue;
        for (var d = 0; d < this.dim; d++) mean[d] += wj.vec[d];
        cnt++;
      }
      if (!cnt) continue;
      for (var d2 = 0; d2 < this.dim; d2++){ mean[d2] /= cnt; wi.vec[d2] += lr * (mean[d2] - wi.vec[d2]); }
      var n = 0;
      for (var d3 = 0; d3 < this.dim; d3++) n += wi.vec[d3] * wi.vec[d3];
      n = Math.sqrt(n) || 1;
      for (var d4 = 0; d4 < this.dim; d4++) wi.vec[d4] /= n;
    }
  };
  Vocab.prototype.sentVec = function(stems){
    var v = new Float32Array(this.dim);
    var n = 0;
    for (var i = 0; i < stems.length; i++){
      var e = this.map.get(stems[i]);
      if (!e) continue;
      for (var d = 0; d < this.dim; d++) v[d] += e.vec[d];
      n++;
    }
    if (n) for (var d2 = 0; d2 < this.dim; d2++) v[d2] /= n;
    var nn = 0;
    for (var d3 = 0; d3 < this.dim; d3++) nn += v[d3] * v[d3];
    nn = Math.sqrt(nn) || 1;
    for (var d4 = 0; d4 < this.dim; d4++) v[d4] /= nn;
    return v;
  };
  var cos = function(a, b){ var s = 0; for (var i = 0; i < a.length; i++) s += a[i]*b[i]; return s; };
  var vocab = new Vocab(64);

  /* ==========================================================================
     PREDICTOR
     ========================================================================== */
  var Predictor = {
    unigram: new Map(), bigram: new Map(), total: 0,
    train: function(text){
      var tokens = tokenize(text);
      if (!tokens.length) return;
      for (var i = 0; i < tokens.length; i++){
        var w1 = tokens[i];
        this.unigram.set(w1, (this.unigram.get(w1) || 0) + 1);
        this.total++;
        if (i + 1 < tokens.length){
          var w2 = tokens[i + 1];
          if (!this.bigram.has(w1)) this.bigram.set(w1, new Map());
          var m = this.bigram.get(w1);
          m.set(w2, (m.get(w2) || 0) + 1);
        }
      }
    },
    predictNext: function(lastWord, k){
      k = k || 3;
      var m = this.bigram.get(lastWord);
      if (!m) return [];
      var arr = Array.from(m.entries()).sort(function(a,b){ return b[1]-a[1]; }).slice(0, k);
      return arr.map(function(x){ return x[0]; });
    },
    predictPhrase: function(text, k){
      k = k || 3;
      var tokens = tokenize(text);
      if (!tokens.length) return [];
      return this.predictNext(tokens[tokens.length - 1], k);
    },
    clear: function(){ this.unigram.clear(); this.bigram.clear(); this.total = 0; }
  };

