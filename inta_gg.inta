["я хочу творить","Твори! Искусство — сила."],
["я хочу учить","Делись знанием. Помогай."],
["я хочу расти","Развивайся. Не стой."],
["я хочу меняться","Действуй! Ты сможешь."],
["я хочу идти вперёд","Шагай! Не оглядывайся."],
["я хочу начать","Начни! Прямо сейчас."],
["я хочу закончить","Заверши! Финал близко."],
["я хочу продолжить","Продолжай! Не сдавайся."],
["я хочу вернуться","Возвращайся! Дом ждёт."],
["я хочу уйти","Иди! Если так лучше."],
["я хочу прийти","Приходи! Ждём."],
["я хочу увидеть","Смотри! Мир ждёт."],
["я хочу услышать","Слушай! Звуки везде."],
["я хочу сказать спасибо","Пожалуйста! Всегда рад."],
["я хочу попрощаться","Пока! До встречи."],
["я хочу поздороваться","Привет! Рад видеть."],
["я хочу обнять","Обнимаю! Тепло."],
["я хочу подарить","Щедро! Приятно дарить."],
["я хочу получить","Заслуживаешь! Прими."],
["я хочу отдать","Щедро! Отдавай."],
["я хочу поделиться","Делись! Щедрость."],
["я хочу сохранить","Сохрани! Ценно."],
["я хочу вспомнить","Вспомни! Память."],
["я хочу принять","Прими! Смирение."],
["я хочу изменить","Измени! Действуй."],
["я хочу принять себя","Прими! Ты хорош."],
["я хочу полюбить себя","Люби! Ты достоин."],
["я хочу уважать себя","Уважай! Ты важен."],
["я хочу ценить себя","Цени! Ты один."],
["я хочу заботиться о себе","Заботься! Ты важен."],
["я хочу быть добрее к себе","Будь! Не критикуй."],
["я хочу простить себя","Прости! Прошлое — прошлое."],
["я хочу новую жизнь","Строй! Шаг за шагом."],
["я хочу лучшую жизнь","Работай! Мечта сбудется."],
["я хочу спокойную жизнь","Строй! Тишина."],
["я хочу яркую жизнь","Живи! Приключения."],
["я хочу счастливую жизнь","Она в мелочах. Замечай."],
["я хочу осмысленную жизнь","Ищи смысл. Создавай."],
["я хочу жизнь с любовью","Открой сердце. Люби."],
["я хочу жизнь с друзьями","Общайся! Друзья — опора."],
["я хочу жизнь с семьёй","Береги близких. Ценно."],
["я хочу жизнь без стресса","Медитируй. Отдыхай."],
["я хочу жизнь без боли","Заботься о теле и душе."],
["я хочу жизнь без страха","Действуй. Смелость."],
["я хочу жизнь без сожаления","Живи сейчас. Не оглядывайся."],
["я хочу жизнь без вины","Прости себя. Отпусти."],
["я хочу жизнь без обиды","Отпусти. Легче станет."],
["я хочу жизнь без одиночества","Общайся! Ты не один."],
["я хочу жизнь с гармонией","Баланс. Ищи. Найдёшь."]
];

/* ============================================================
   4 ЛОГИКА
   ============================================================ */

function norm(s){
  return String(s == null ? "" : s).toLowerCase().replace(/ё/g, "е");
}

function tokenize(text){
  return norm(text).replace(/[^a-zа-я0-9\s]/g, " ").split(/\s+/).filter(Boolean);
}

var ENDS = ["иями","ями","ами","ого","его","ому","ему","ыми","ими","иях","ая","ое","ые","ый","ий","ой","ам","ям","ах","ях","ов","ев","ей","ую","юю","ия","ие","ии","и","ы","а","о","е","у","ю","я"];

function stem(w){
  for (var i = 0; i < ENDS.length; i++){
    var e = ENDS[i];
    if (w.length - e.length >= 3 && w.slice(-e.length) === e) return w.slice(0, -e.length);
  }
  return w;
}

function compile(raw){
  return raw.map(function(r, i){
    var kw = norm(r[0]).split(/\s+/).filter(Boolean);
    return { i: i, key: kw[0], kw: kw, st: kw.map(stem), ph: r[1].split("|") };
  });
}

var TOPICS = compile(M);
var SUBS = compile(S);
var MEM = { name: null, turn: 0, lastTopic: -1, lastKey: null, said: {} };

function pick(a){ return a[Math.floor(Math.random() * a.length)]; }

function pickFresh(t){
  var arr = t.ph;
  if (arr.length === 1) return arr[0];
  var last = MEM.said[t.i], p = null, g = 0;
  do { p = pick(arr); g++; } while (p === last && g < 10);
  MEM.said[t.i] = p;
  return p;
}

function score(words, stems, t){
  var s = 0;
  for (var i = 0; i < words.length; i++){
    var w = words[i];
    if (w.length < 3) continue;
    var ws = stems[i];
    for (var j = 0; j < t.kw.length; j++){
      var k = t.kw[j];
      if (w === k) { s += 4; continue; }
      if (ws === t.st[j]) { s += 3; continue; }
      if (k.length >= 4 && w.indexOf(k) === 0) { s += 2; continue; }
      if (w.length >= 4 && k.indexOf(w) === 0) s += 1;
    }
  }
  return s;
}

function findBest(words, stems, list, min){
  var best = null, bestScore = 0;
  for (var i = 0; i < list.length; i++){
    var s = score(words, stems, list[i]);
    if (s > bestScore){ bestScore = s; best = list[i]; }
  }
  return bestScore >= min ? best : null;
}

function detectContext(words){
  for (var i = 0; i < CTX.length; i++){
    var c = CTX[i];
    for (var j = 0; j < c.kw.length; j++){
      var k = c.kw[j];
      for (var w = 0; w < words.length; w++){
        if (words[w] === k) return c;
        if (words[w].indexOf(k) === 0 && k.length >= 4) return c;
        if (k.indexOf(words[w]) === 0 && words[w].length >= 4) return c;
      }
    }
  }
  return null;
}

function extractWord(words){
  for (var i = 0; i < words.length; i++) if (words[i].length > 3) return words[i];
  return null;
}

var FALLBACK = ["Хм, расскажи подробнее.","Понял.","Ага.","Интересно.","Давай ещё.","Не совсем понял, но слушаю.","И что дальше?","Любопытно."];

return {

  async send(text, ctx){
    await KT.sleep(180 + Math.random() * 380);
    MEM.turn++;

    var raw = String(text == null ? "" : text);

    if (!ctx || !ctx.fromAI){
      var m = raw.match(/меня\s+зовут\s+([A-Za-zА-Яа-яЁё][A-Za-zА-Яа-яЁё-]{1,20})/i);
      if (m) MEM.name = m[1];
    }

    var words = tokenize(raw);
    if (!words.length) return pick(FALLBACK);
    var stems = words.map(stem);

    /* 1. КОНТЕКСТ — приоритет №1 */
    var c = detectContext(words);
    if (c){
      var phrase = pick(c.ph);
      if (MEM.name && Math.random() < 0.2)
        phrase = MEM.name + ", " + phrase.charAt(0).toLowerCase() + phrase.slice(1);
      return phrase;
    }

    /* 2. ПОДТЕМА — конкретный сценарий */
    var sub = findBest(words, stems, SUBS, 4);
    if (sub){ MEM.lastTopic = sub.i; MEM.lastKey = sub.key; return pickFresh(sub); }

    /* 3. ОСНОВНАЯ ТЕМА */
    var main = findBest(words, stems, TOPICS, 3);
    if (main){
      MEM.lastTopic = main.i; MEM.lastKey = main.key;
      var p = pickFresh(main);
      if (MEM.name && Math.random() < 0.18 && p.length < 70)
        p = MEM.name + ", " + p.charAt(0).toLowerCase() + p.slice(1);
      return p;
    }

    /* 4. Fallback */
    var w = extractWord(words);
    if (w && Math.random() < 0.6) return "Расскажи подробнее про «" + w + "»";
    if (MEM.name && Math.random() < 0.2) return MEM.name + ", " + pick(FALLBACK);
    return pick(FALLBACK);
  },

  reset(){ MEM.name = null; MEM.turn = 0; MEM.lastTopic = -1; MEM.lastKey = null; MEM.said = {}; },

  getThinking(){
    return "тем: " + TOPICS.length + " + " + SUBS.length +
           " · ход: " + MEM.turn +
           " · тема: " + (MEM.lastKey || "—") +
           " · имя: " + (MEM.name || "—");
  }
};
</script>
<!--1 часть-->
<script type="text/html" id="ai-slot-v4">
<!--
{
  "id": "ktalk-v4",
  "name": "KtalkAI V4.1",
  "color": "#dc2626",
  "avatar": "💀",
  "description": "Умный диалоговый движок V4.1",
  "version": "4.1"
}
-->

/* ============================================================================
   KtalkAI V4.1 — Умный диалоговый движок
   Часть 1/6: Конфигурация, словари, константы

   ИЗМЕНЕНИЯ V4.1 vs V4 mini:
     • Fuzzy-матчинг: пороги по длине слова + лок префикса
     • Контекст: три уровня (CTX_PRONOUN / CTX_TOPIC / CTX_MOOD)
     • Ко-референция: типизация сущностей + карта местоимений
     • Sentiment: 3 уровня силы на стемах вместо плоского списка
     • Темы: приоритеты + подкатегории + защита от ложных префиксов
     • Опечатки: словарь типичных русских ошибок
     • Эмодзи: карта сентимента
     • Время: маркеры прошлого/настоящего/будущего
   ============================================================================ */

var KT = {
  VERSION: '4.1',

  /* --- Контекст (три уровня вместо одного) --- */
  CTX_MAX:      10,   // всего храним
  CTX_PRONOUN:  2,    // для разрешения "а ты?", "это", "он"
  CTX_TOPIC:    4,    // для отслеживания темы диалога
  CTX_MOOD:     6,    // для дуги настроения

  /* --- Сущности --- */
  ENT_MAX:      32,   // максимум запомненных
  ENT_MIN_LEN:  3,    // минимальная длина сущности

  /* --- Анти-репит --- */
  USED_MAX:        90,   // максимум кэша ответов
  USED_DECAY_MSGS: 12,   // через сколько реплик ответ можно повторять

  /* --- Fuzzy-матчинг (починка) --- */
  FUZZY_MIN_LEN:       5,     // слова короче 5 не fuzzy-матчатся вовсе
  FUZZY_LOCK_PREFIX:   2,     // первые N букв = жёсткий лок
  FUZZY_LOCK_PREFIX_3: 3,     // для слов 6+ букв — лок 3 букв
  FUZZY_THRESH: {
    5: 1.0,   // 5 букв — только точное
    6: 1.0,   // 6 букв — только точное
    7: 0.90,  // 7 букв — 1 опечатка допустима
    8: 0.90,
    9: 0.89,
    10: 0.90
  },

  /* --- Классификация длины реплики --- */
  SHORT_REPLY_TOKENS: 2,    // <= 2 токенов = короткая
  LONG_REPLY_TOKENS:  12,   // >= 12 токенов = длинная

  /* --- Работа с темой --- */
  TOPIC_BOREDOM_STEP:  8,   // сколько добавлять скуки за повтор темы
  TOPIC_BOREDOM_RESET: 10,  // сколько сбрасывать при смене темы
  TOPIC_DEPTH_WARN:    4,   // после N углублений в тему — менять подтему

  /* --- Эмоции --- */
  MOOD_MIN: -3,
  MOOD_MAX:  3,
  REL_MIN:   0,
  REL_MAX:   100,
  ENG_MIN:   0,
  ENG_MAX:   100
};

/* ---------------------------------------------------------------------------
   Стоп-слова (расширены, включая частицы и междометия)
   --------------------------------------------------------------------------- */
var KT_STOP = new Set([
  /* местоимения */
  'этого','этому','такой','такая','такое','такие','очень','просто','вообще',
  'меня','тебя','себя','него','неё','нее','них','нам','вам','им','нас','вас',
  'мой','моя','моё','мое','твой','твоя','твоё','твое','свой','своя','своё',
  'кто','что','где','куда','откуда','как','какой','какая','какое','какие',
  'этот','эта','это','эти','тот','та','те','весь','вся','всё','все',
  'который','которое','которая','которые','чей','чья','чьё','чьи',

  /* служебные */
  'когда','почему','зачем','будет','буду','будешь','хочешь','хотел','хотела',
  'можно','нельзя','надо','нужно','есть','было','были','был','была','быть',
  'чтобы','если','или','либо','ведь','даже','ещё','еще','уже','тоже','также',
  'только','лишь','именно','как-то','как-нибудь','что-то','что-нибудь',
  'там','тут','здесь','сюда','оттуда','отсюда','тогда','теперь','сейчас',

  /* частицы и междометия */
  'да','нет','ну','ага','угу','ок','окей','хм','ммм','эх','ох','ах','ой',
  'ли','же','бы','ведь','вот','вон','даже','уже','ведь','как-то',
  'бл','блин','черт','чёрт','капец','жесть','пипец','фиг','хрен','нафиг',

  /* глаголы-связки и общие */
  'это','значит','вообще-то','типа','типо','короче','значит','слушай',
  'послушай','смотри','смотри-ка'
]);

/* ---------------------------------------------------------------------------
   Чёрный список имён
   --------------------------------------------------------------------------- */
var KT_NAME_BLACKLIST = new Set([
  'Не','Да','Нет','Ок','Норм','Крутой','Крутая','Кталк','Ктулху','Тоже',
  'Такой','Такая','Тупой','Тупая','Только','Очень','Просто','Мужчин','Женщин',
  'Мужчина','Женщина','Парень','Девушка','Человек','Раб','Бог','Дурак','Дура',
  'Ктолку','Что','Кто','Это','Этот','Эта','Все','Всё','Много','Мало','Быстро',
  'Медленно','Хорошо','Плохо','Круто','Смешно','Странно','Серьёзно','Серьезно',
  'Никто','Ничто','Ктото','Чтото','Чегото','Какойто','Типа','Типо','Вообще'
]);

/* ---------------------------------------------------------------------------
   Сентимент — три уровня силы, стемы (префиксы) а не целые слова
   Матчинг: token.startsWith(stem)
   --------------------------------------------------------------------------- */

var KT_POS_STRONG = [
  'любл','обожа','счастлив','восторг','восхищ','кайф','обалден','прекрас',
  'супер','крут','класс','отличн','великолеп','изумит','потряс','шикарн',
  'блеск','восхит','бесподобн','фантастич','невероятн','божествен'
];

var KT_POS_MED = [
  'хорош','нрав','приятн','спасиб','благодар','рад','мил','весел','улыб',
  'позитив','здоров','замечат','интересн','увлекат','впечатл','чудесн',
  'занятн','прикольн','ништяк','клево','клёво','нормальн'
];

var KT_POS_WEAK = [
  'норм','ок','ладно','понятн','ясно','верн','точн','соглас','уютн','тепл',
  'добр','молодец','правильн','неплох','недурн'
];

var KT_NEG_STRONG = [
  'ненавиж','бешен','депресс','ужас','кошмар','отврат','ярост','гнев',
  'страдан','истяза','мучит','терза','пытк','кошмарн','жутк','страшн'
];

var KT_NEG_MED = [
  'плох','груст','зл','тупо','устал','тяжел','печаль','обид','страх',
  'тревог','плач','слёз','слез','раздраж','злюсь','бесит','достал',
  'надоел','парит','напрягает','раздража'
];

var KT_NEG_WEAK = [
  'скучн','уныл','тоск','одинок','пусто','холодн','проблем','трудн',
  'сложн','неприятн','неудач','ошиб','вина','стыд','фигня','хрень',
  'отстой','шлак','капец','хренов','фигов','паршив','скверн'
];

/* Проблемные слова, которые могут быть и позитивными, и негативными */
var KT_AMBIGUOUS = {
  'боль':      'neg',   // "больно" — neg, но "больница" — тема health
  'страх':     'neg',
  'ужас':      'neg',
  'круто':     'pos'    // "круто" в позитиве, но "круто обломался" — не отследить
};

/* ---------------------------------------------------------------------------
   Усилители и отрицания
   --------------------------------------------------------------------------- */
var KT_INTENSIFIERS = new Set([
  'очень','сильно','жутко','ужасно','безумно','страшно','дико','крайне',
  'чертовски','чрезвычайно','невероятно','абсолютно','настолько','адски',
  'просто','так','слишком','реально','вообще'
]);

var KT_NEGATIONS = new Set([
  'не','нет','ни','без','никогда','нигде','никто','ничто','ничуть','вовсе',
  'отнюдь','никак','нисколько','нифига','нихрена'
]);

/* Диминутивы-ласкательные: маркер тёплого тона юзера */
var KT_DIMINUTIVES = new Set([
  'миленький','хорошенький','дорогой','дорогая','родной','родная',
  'солнышко','зайка','котик','кошечка','малыш','малышка','дружок'
]);

/* ---------------------------------------------------------------------------
   Эмодзи-сентимент
   --------------------------------------------------------------------------- */
var KT_EMOJI_POS = new Set([
  '❤️','😍','🥰','😊','😄','😁','😆','😉','🙂','💜','💖','💕','💗','💓',
  '👍','🔥','✨','🎉','🥳','😘','🤗','😌','💪','🌞','🌟'
]);
var KT_EMOJI_NEG = new Set([
  '😢','😭','😔','😞','😟','😠','😡','🤬','😤','💔','👎','😩','😫','🥺',
  '😨','😰','😥','☹️','🙁','😖','😣','🤢','🤮','💀' // 💀 оставлю как маркер, будет решаться по контексту
]);

/* ---------------------------------------------------------------------------
   Вопросительные слова
   --------------------------------------------------------------------------- */
var KT_QUESTION_WORDS = new Set([
  'кто','что','где','когда','почему','зачем','как','какой','какая','какое',
  'какие','сколько','куда','откуда','чей','чья','чьё','чьи','который',
  'которое','которая','которые','разве','неужели','неужто'
]);

/* ---------------------------------------------------------------------------
   Временные маркеры (для согласования глаголов)
   --------------------------------------------------------------------------- */
var KT_TENSE_PAST = new Set([
  'был','была','было','были','делал','делала','говорил','говорила',
  'хотел','хотела','мог','могла','думал','думала','видел','видела',
  'слышал','слышала','шел','шла','ехал','ехала','знал','знала',
  'раньше','вчера','позавчера','давно','недавно'
]);
var KT_TENSE_FUTURE = new Set([
  'буду','будешь','будет','будем','будете','будут','собираюсь','планирую',
  'хочу','мечтаю','надеюсь','завтра','послезавтра','скоро','потом',
  'дальше','позже'
]);

/* ---------------------------------------------------------------------------
   Имена ИИ
   --------------------------------------------------------------------------- */
