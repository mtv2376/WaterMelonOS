  math_t: ['математика пример', ['Пиши пример — решу.', 'Считаю быстро. Давай.']],
  misc_opinion: ['думаешь мнение', ['Что именно? Расскажи.', 'Интересно. Твоё мнение?']],
  misc_ack: ['окей ладно', ['Ок.', 'Ладно.', 'Договорились.']],
  misc_unknown: ['хм', ['Хм. Расскажи подробнее.']]
};

var TOPIC_KEYS = Object.keys(T);

/* ─────────── ФИКС #5: стоп-слова имён ─────────── */
var COMMON_NAMES = /^(думаю|знаю|хочу|могу|буду|люблю|вижу|слышу|говорю|делаю|живу|работаю|учусь|играю|читаю|пишу|ем|сплю|сплю)/i;
var COMMON_SURNAMES = /(пупкин|иванов|петров|сидоров|кузнецов|смирнов|попов|васильев|михайлов|новиков|фёдоров|морозов|волков|алексеев|лебедев|семёнов|егоров|павлов|козлов|степанов)/i;

/* ─────────── ФАКТЫ ─────────── */
var FACT_RULES = [
  { key:'name', re:/(?:меня зовут|моё имя|моя имя)\s+([А-ЯЁA-Z][а-яёa-z\-]{2,25})/i, post:function(s){ return cap(s); } },
  { key:'name', re:/^я\s+([А-ЯЁ][а-яё]{2,20})(?:\s|$)/i, post:function(s){ return cap(s); } },
  { key:'age', re:/мне\s+(\d{1,3})\s*(?:лет|года|год)?/i, post:function(s){ return parseInt(s, 10); } },
  { key:'city', re:/(?:я из|я живу в|живу в)\s+([А-ЯЁ][а-яё\-]{2,30})/i, post:function(s){ return cap(s); } },
  { key:'job', re:/(?:я работаю|работаю)\s+([а-яёa-z\-]{3,30})/i, post:function(s){ return s; } },
  { key:'hobby', re:/(?:я увлекаюсь|увлекаюсь|моё хобби|хобби)\s*[—\-:]?\s*([а-яёa-z\-]{3,30})/i, post:function(s){ return s; } },
  { key:'likes', re:/я люблю\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'likes', re:/мне нравится\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'dislikes', re:/я не люблю\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'dislikes', re:/ненавижу\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'has', re:/у меня есть\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true }
];

/* ─────────── МАТЕМАТИКА ─────────── */
function solveMath(text){
  var s = String(text).replace(/×|х/gi, '*').replace(/÷/g, '/').replace(/,/g, '.');
  var m = s.match(/[-+]?[\d.+\-*/^()% ]{3,}/);
  if (!m) return null;
  var expr = m[0].replace(/[+\-*/^.]*$/, '');
  if (!/[+\-*/^%]/.test(expr) || !/\d/.test(expr)) return null;
  expr = expr.replace(/\^/g, '**');
  try {
    /* eslint-disable no-new-func */
    var v = Function('"use strict";return(' + expr + ')')();
    if (typeof v !== 'number' || !isFinite(v)) return null;
    var rounded = Math.abs(v - Math.round(v)) < 1e-9 ? Math.round(v) : +v.toFixed(6);
    return { expr: m[0].trim(), value: rounded };
  } catch (e){ return null; }
}

/* ─────────── ПАМЯТЬ ─────────── */
function createMEM(){
  return {
    user: { name:null, age:null, city:null, job:null, hobby:null, likes:[], dislikes:[], has:[] },
    history: [],
    learned: new Map(),
    unknownAsked: null,
    recentReplies: [],
    skeletons: [],
    turn: 0,
    mood: 60,
    lastTopic: null
  };
}
var MEM = createMEM();

function pushHistory(role, text){
  MEM.history.push({ role: role, text: text, ts: Date.now() });
  if (MEM.history.length > 500) MEM.history.shift();
}

/* ─────────── ПАРСЕР ─────────── */
function parseMessage(text){
  var sentences = splitSentences(text);
  var clauses = [];
  for (var si = 0; si < sentences.length; si++){
    var s = sentences[si];
    var isQ = /\?$/.test(s) || /^(?:что|кто|где|когда|почему|зачем|как|сколько|какой|какая|какое|какие|куда|откуда)\b/i.test(s.trim());
    var parts = splitClauses(s);
    for (var pi = 0; pi < parts.length; pi++){
      var p = parts[pi];
      if (p.length < 1) continue;
      var partIsQ = isQ && (parts.length === 1 || /^(?:и\s+)?(?:как|что|кто|где|когда|почему|зачем|сколько|какой|какая|какое|какие|куда|откуда)\b/i.test(p) || /\?$/.test(s));
      clauses.push({ text: p.trim(), isQuestion: partIsQ });
    }
  }
  return clauses.length ? clauses : [{ text: text.trim(), isQuestion: false }];
}

/* ─────────── ИЗВЛЕЧЕНИЕ ФАКТОВ ─────────── */
function extractFacts(text){
  var found = [];
  for (var i = 0; i < FACT_RULES.length; i++){
    var r = FACT_RULES[i];
    var m = text.match(r.re);
    if (!m || !m[1]) continue;
    var v = r.post ? r.post(m[1]) : m[1];
    if (!v) continue;
    /* ФИКС: проверки на «не имя» */
    if (r.key === 'name'){
      if (COMMON_NAMES.test(v)) continue;
      if (COMMON_SURNAMES.test(v)) continue;
      if (v.length < 3) continue;
    }
    if (r.append){
      if (MEM.user[r.key].indexOf(v) === -1) MEM.user[r.key].push(v);
    } else {
      MEM.user[r.key] = v;
      if (r.key === 'name') MEM.user.name = v;
    }
    found.push({ key: r.key, value: v });
  }
  return found;
}

/* ─────────── ФИКС #2: классификация с приоритетом специфичности ─────────── */
function classifyClause(clause){
  var text = clause.text.toLowerCase();
  var stems = contentStems(text);
  var wordTokens = tokens(text);

  var candidates = [];

  /* самоидентификация ИИ — высший приоритет */
  if (/\b(?:как тебя зовут|твоё имя|как звать|представься|назови себя)\b/i.test(text))
    candidates.push({ type:'self_name', hits:3, spec:100 });
  if (/\b(?:сколько тебе лет|твой возраст|сколько тебе)\b/i.test(text))
    candidates.push({ type:'self_age', hits:3, spec:100 });
  if (/\b(?:где ты живёшь|твой город|где обитаешь|ты откуда)\b/i.test(text))
    candidates.push({ type:'self_city', hits:3, spec:100 });
  if (/\b(?:что ты умеешь|твои возможности)\b/i.test(text))
    candidates.push({ type:'self_abilities', hits:3, spec:100 });
  if (/\b(?:что ты любишь|что тебе нравится)\b/i.test(text))
    candidates.push({ type:'self_like', hits:3, spec:100 });
  if (/\b(?:кто ты|ты человек|ты бот|ты ии)\b/i.test(text))
    candidates.push({ type:'self_who', hits:3, spec:100 });

  /* математика */
  var math = solveMath(text);
  if (math && /\d/.test(text) && /[+\-*/×÷^]/.test(text))
    candidates.push({ type:'math', hits:3, spec:100, data:math });

  /* темы — считаем совпадения */
  var bestTopic = null, bestHits = 0;
  for (var tk = 0; tk < TOPIC_KEYS.length; tk++){
    var key = TOPIC_KEYS[tk];
    var entry = T[key];
    var kws = entry[0].split(' ');
    var hits = 0;
    for (var ki = 0; ki < kws.length; ki++){
      var k = kws[ki];
      if (wordTokens.indexOf(k) !== -1 || stems.indexOf(stem(k)) !== -1) hits++;
    }
    if (hits > bestHits){ bestHits = hits; bestTopic = key; }
  }
  if (bestTopic && bestHits > 0){
    /* специфичность: чем больше hits, тем выше приоритет */
    var spec = 10 + bestHits * 5;
    /* темы про ИИ специфичнее */
    if (bestTopic.indexOf('self_') === 0) spec += 40;
    /* howareyou специфичнее greet */
    if (bestTopic === 'howareyou') spec += 20;
    candidates.push({ type:'topic:' + bestTopic, hits:bestHits, spec:spec });
  }

  /* этикет — низкая специфичность */
  if (KW_FLAT.greet.some(function(w){ return wordTokens[0] === w || text.indexOf(w) === 0; }))
    candidates.push({ type:'greet', hits:2, spec:5 });
  if (KW_FLAT.bye.some(function(w){ return wordTokens[0] === w; }))
    candidates.push({ type:'bye', hits:2, spec:5 });
  if (KW_FLAT.thanks.some(function(w){ return text.indexOf(w) !== -1; }))
    candidates.push({ type:'thanks', hits:2, spec:5 });
  if (KW_FLAT.sorry.some(function(w){ return text.indexOf(w) !== -1; }))
    candidates.push({ type:'sorry', hits:2, spec:5 });

  /* общие */
  var kwHits = 0;
  for (var wi = 0; wi < wordTokens.length; wi++) if (KW_LOOKUP.has(wordTokens[wi])) kwHits++;
  if (clause.isQuestion) candidates.push({ type:'generic_question', hits:kwHits, spec:1 });
  else candidates.push({ type:'generic_statement', hits:kwHits, spec:1 });

  /* сортируем по специфичности, берём лучший */
  candidates.sort(function(a, b){ return b.spec - a.spec; });
  return candidates[0];
}

/* ─────────── ФИКС #3: расширенный пул общих ответов ─────────── */
var GENERIC_Q = [
  'Хм, интересный вопрос. Дай подумать.',
  'Не уверен, что понял. Переформулируешь?',
  'Спроси иначе, а? Так будет точнее.',
  'Могу ответить неточно. Уточни, что именно интересует.',
  'Тут вариантов много. Расскажи подробнее.',
  'Интересно. А ты сам что думаешь?',
  'Хороший вопрос. Только я не уверен, что понимаю его правильно.',
  'Дай подумать секунду.',
  'Странно, но я не знаю ответа. А ты?',
  'Может, пояснишь, что имеешь в виду?',
  'Хм. Давай разберём по частям.',
  'Интересная тема. С какой стороны к ней подойти?',
  'Не всё понял. О чём именно речь?',
  'Хорошо спросил. Но у меня нет точного ответа.',
  'Слушаю. Расскажи подробнее.'
];
var GENERIC_S = [
  'Понял.', 'Ага, ясно.', 'Интересно. Продолжай.',
  'Мг. Что дальше?', 'Ясно.', 'Хм.',
  'Понимаю.', 'Занятно.', 'И что потом?',
  'Расскажи ещё.', 'Дальше.', 'Так.',
  'Угу.', 'Любопытно.'
];

/* ─────────── ГЕНЕРАЦИЯ ─────────── */
function normalize(s){ return String(s || '').toLowerCase().replace(/[^а-яёa-z0-9]/g, ''); }
function similarity(a, b){
  if (!a || !b) return 0;
  var n = Math.min(a.length, b.length, 40);
  var m = 0;
  for (var i = 0; i < n; i++) if (a[i] === b[i]) m++;
  return m / Math.max(a.length, b.length);
}
function isEchoOrRepeat(reply, userText){
  var r = normalize(reply);
  var u = normalize(userText);
  if (r && u && r === u) return true;
  for (var i = 0; i < MEM.recentReplies.length; i++) if (normalize(MEM.recentReplies[i]) === r) return true;
  var sk = r.slice(0, 32);
  for (var j = 0; j < MEM.skeletons.length; j++) if (similarity(sk, MEM.skeletons[j]) > 0.75) return true;
  return false;
}
function rememberReply(r){
  MEM.recentReplies.push(r);
  if (MEM.recentReplies.length > 30) MEM.recentReplies.shift();
  MEM.skeletons.push(normalize(r).slice(0, 32));
  if (MEM.skeletons.length > 40) MEM.skeletons.shift();
}

function fill(tpl){
  return tpl.replace(/\{(\w+)\}/g, function(_, key){
    if (key === 'userName') return MEM.user.name || 'ты';
    if (key === 'userAge') return MEM.user.age != null ? String(MEM.user.age) : '—';
    if (key === 'userCity') return MEM.user.city || '—';
    if (key === 'mood') return MEM.mood >= 70 ? 'хорошее' : MEM.mood >= 40 ? 'нейтральное' : 'не очень';
    if (key === 'topic') return MEM.lastTopic || 'это';
    return '';
  });
}
function polish(s){
  if (!s) return '';
  s = s.replace(/\s+([.,!?…])/g, '$1').replace(/([!?…])\s*\./g, '$1');
  s = s[0].toUpperCase() + s.slice(1);
  if (!/[.!?…]$/.test(s)) s += '.';
  return s;
}

function candidatePool(cls){
  var pool = [];
  if (cls.type.indexOf('topic:') === 0){
    var key = cls.type.slice(6);
    var entry = T[key];
    if (entry){
      for (var i = 0; i < entry[1].length; i++) pool.push({ text: entry[1][i], weight: 3, source: key });
    }
  } else if (cls.type === 'self_name'){
    for (var a = 0; a < SELF.answers.name.length; a++) pool.push({ text: SELF.answers.name[a], weight: 10, source:'self_name' });
  } else if (cls.type === 'self_age'){
    for (var b = 0; b < SELF.answers.age.length; b++) pool.push({ text: SELF.answers.age[b], weight: 10, source:'self_age' });
  } else if (cls.type === 'self_city'){
    for (var c = 0; c < SELF.answers.city.length; c++) pool.push({ text: SELF.answers.city[c], weight: 10, source:'self_city' });
  } else if (cls.type === 'self_abilities'){
    for (var d = 0; d < SELF.answers.abilities.length; d++) pool.push({ text: SELF.answers.abilities[d], weight: 10, source:'self_ab' });
  } else if (cls.type === 'self_like'){
    for (var e = 0; e < SELF.answers.like.length; e++) pool.push({ text: SELF.answers.like[e], weight: 10, source:'self_like' });
  } else if (cls.type === 'self_who'){
    for (var f = 0; f < SELF.answers.whoami.length; f++) pool.push({ text: SELF.answers.whoami[f], weight: 10, source:'self_who' });
  } else if (cls.type === 'math'){
    var m = cls.data;
    pool.push({ text: m.expr + ' = ' + m.value, weight: 100, source:'math' });
  } else if (cls.type === 'greet'){
    for (var g = 0; g < T.greet[1].length; g++) pool.push({ text: T.greet[1][g], weight: 5, source:'greet' });
  } else if (cls.type === 'bye'){
    for (var h = 0; h < T.bye[1].length; h++) pool.push({ text: T.bye[1][h], weight: 5, source:'bye' });
  } else if (cls.type === 'thanks'){
    for (var k = 0; k < T.thanks[1].length; k++) pool.push({ text: T.thanks[1][k], weight: 5, source:'thanks' });
  } else if (cls.type === 'sorry'){
    for (var l = 0; l < T.sorry[1].length; l++) pool.push({ text: T.sorry[1][l], weight: 5, source:'sorry' });
  } else if (cls.type === 'generic_question'){
    for (var q = 0; q < GENERIC_Q.length; q++) pool.push({ text: GENERIC_Q[q], weight: 1, source:'gq' });
  } else if (cls.type === 'generic_statement'){
    for (var s = 0; s < GENERIC_S.length; s++) pool.push({ text: GENERIC_S[s], weight: 1, source:'gs' });
  }
  if (!pool.length) pool.push({ text:'Расскажи подробнее.', weight:1, source:'fb' });
  return pool;
}

function scoreCandidate(cand, cls, userText){
  var score = cand.weight || 1;
  if (isEchoOrRepeat(cand.text, userText)) score -= 50;
  if (/не знаю|не уверен|не понял|переформулируй|поясни/i.test(cand.text)) score -= 5;
  if (MEM.mood < 40 && /\?|!/.test(cand.text)) score -= 1;
  var userLen = userText.length, candLen = cand.text.length;
  if (userLen > 60 && candLen > 60) score += 1;
  if (userLen < 20 && candLen < 40) score += 1;
  if (MEM.user.name && cand.text.indexOf('{userName}') !== -1) score += 2;
  if (/^(Понял|Ясно|Ладно|Ага)\.?$/i.test(cand.text.trim())) score -= 2;
  score += Math.random() * 1.2;
  return score;
}

function reason(cls, userText){
  var pool = candidatePool(cls);
  if (!pool.length) return null;
  var best = null, bestScore = -Infinity;
  var tried = {};
  var iters = Math.min(40, Math.max(8, pool.length * 4));
  for (var iter = 0; iter < iters; iter++){
    var cand = pool[(Math.random() * pool.length) | 0];
    var key = cand.source + '::' + cand.text.slice(0, 24);
    if (tried[key] && pool.length > 3) continue;
    tried[key] = true;
    var s = scoreCandidate(cand, cls, userText);
    if (s > bestScore){ bestScore = s; best = cand; }
  }
  if (best && /не знаю|не уверен|не понял/i.test(best.text)){
    for (var i = 0; i < pool.length; i++){
      if (!/не знаю|не уверен|не понял/i.test(pool[i].text)) return pool[i];
    }
  }
  return best;
}

/* ─────────── ОБУЧЕНИЕ СЛОВАМ ─────────── */
function findUnknownWords(text){
  var words = tokens(text);
  var unknown = [];
  for (var i = 0; i < words.length; i++){
    var w = words[i];
    /* Фикс: длина от 6 символов, а не от 4 */
    if (w.length < 6) continue;
    if (STOP.has(w)) continue;
    if (/^\d+$/.test(w)) continue;
    if (KW_LOOKUP.has(w)) continue;
    if (COMMON_SURNAMES.test(w)) continue;
    if (/^[А-ЯЁ]/.test(w)) continue;
    /* Фикс: не искать слова с типичными глагольными окончаниями */
    if (/(ать|ять|еть|ить|ыть|оть|уть|ти)$/.test(w)) continue;
    if (/(ем|им|ешь|ишь|ет|ит|ут|ют|ат|ят|ал|ил|ла|ло|ли)$/.test(w)) continue;
    /* Фикс: не искать наречия с -о/-е в конце */
    if (/(но|то|ко|во|ло|мо|но|шо|е|о)$/.test(w)) continue;
    var s = stem(w);
    var known = false;
    KW_LOOKUP.forEach(function(_v, k){
      if (stem(k) === s) { known = true; }
    });
    if (known) continue;
    unknown.push(w);
  }
  return uniq(unknown);
}

function learnDefinition(word, text){
  var m = text.match(/(?:это|значит|означает|—|-)\s*(.+)$/i);
  var definition = m ? m[1].trim() : text.trim();
  MEM.learned.set(word.toLowerCase(), definition);
  return definition;
}

/* ─────────── ФИКС #4: тематический follow-up для second ─────────── */
var FOLLOW_UPS = {
  'work_t': ['А что за работа?', 'Нравится там?'],
  'study_t': ['А что учишь?', 'Сложно?'],
  'movie_t': ['А что смотрел последнее?', 'Какой любимый жанр?'],
  'music_t': ['Что сейчас в плеере?', 'Кого любишь слушать?'],
  'book_t': ['Что читаешь?', 'Какую книгу посоветуешь?'],
  'game_t': ['Во что играешь?', 'На чём? ПК или консоль?'],
  'food_t': ['Что любишь готовить?', 'Какое блюдо любимое?'],
  'pizza_t': ['С чем пиццу любишь?', 'Тонкая или пышная?'],
  'sport_t': ['Каким спортом занимаешься?', 'Давно?'],
  'travel_t': ['Куда хочешь поехать?', 'Где уже был?'],
  'family_t': ['Большая у тебя семья?', 'Как у них дела?'],
  'friend_t': ['Много у тебя друзей?', 'Давно дружите?'],
  'cat_t': ['Как зовут кота?', 'Сколько ему?'],
  'dog_t': ['Какая порода?', 'Как его зовут?'],
  'weather_t': ['У вас что на улице?', 'Любишь такую погоду?'],
  'happiness_t': ['А что для тебя счастье?', 'Простое или большое?'],
  'dream_t': ['О чём мечтаешь?', 'Давно?'],
  'plan_t': ['Какие планы?', 'Что на завтра?'],
  'day_t': ['Как день прошёл?', 'Что делал?']
};

function makeFollowUp(lastTopic){
  if (!lastTopic) return null;
  var arr = FOLLOW_UPS[lastTopic];
  if (!arr || !arr.length) return null;
  return rnd(arr);
}

/* ─────────── ГЛАВНЫЙ PIPELINE ─────────── */
function respond(text){
  MEM.turn++;
  var t0 = nowMs();

  /* ждём определение неизвестного слова */
  if (MEM.unknownAsked){
    var word = MEM.unknownAsked;
    MEM.unknownAsked = null;
    var def = learnDefinition(word, text);
    var reply0 = 'Понял: «' + word + '» — это ' + def + '. Запомнил.';
    pushHistory('user', text); pushHistory('ai', reply0);
    rememberReply(reply0);
    return { reply: reply0, second: null, meta: { learned: { word: word, definition: def }, latencyMs: +(nowMs() - t0).toFixed(2) } };
  }

  pushHistory('user', text);

  var clauses = parseMessage(text);
  var factsFound = [];
  for (var ci = 0; ci < clauses.length; ci++){
    var fs = extractFacts(clauses[ci].text);
    for (var fi = 0; fi < fs.length; fi++) factsFound.push(fs[fi]);
  }

  var answers = [];
  for (var ai = 0; ai < clauses.length; ai++){
    var c = clauses[ai];
    var cls = classifyClause(c);
    var best = reason(cls, c.text);
    if (best){
      answers.push({ clause: c, cls: cls, answer: fill(best.text) });
    }
  }

  var reply = '';
  var second = null;

  if (answers.length === 0){
    reply = 'Хм. Расскажи подробнее.';
  } else if (answers.length === 1){
    reply = polish(answers[0].answer);
  } else {
    var qs = answers.filter(function(a){ return a.clause.isQuestion; });
    var sts = answers.filter(function(a){ return !a.clause.isQuestion; });
    var parts = [];
    if (factsFound.length){
      var fSummary = factsFound.map(function(f){
        if (f.key === 'name') return 'тебя зовут ' + f.value;
        if (f.key === 'age') return 'тебе ' + f.value;
        if (f.key === 'city') return 'ты из ' + f.value;
        if (f.key === 'job') return 'ты работаешь ' + f.value;
        if (f.key === 'likes') return 'ты любишь ' + f.value;
        if (f.key === 'dislikes') return 'ты не любишь ' + f.value;
        if (f.key === 'hobby') return 'ты увлекаешься ' + f.value;
        if (f.key === 'has') return 'у тебя есть ' + f.value;
        return f.key + ': ' + f.value;
      });
      parts.push('Запомнил: ' + fSummary.join(', ') + '.');
    }
    for (var qi = 0; qi < qs.length; qi++) parts.push(polish(qs[qi].answer));
    if (!qs.length) for (var si = 0; si < sts.length; si++) parts.push(polish(sts[si].answer));
    reply = parts.join(' ');
  }

  /* обучение неизвестным словам */
/* обучение неизвестным словам — только если совсем ничего не понял */
var reallyLowScore = answers.length === 0 ||
  answers.every(function(a){
    return a.cls.spec < 2 || a.cls.type === 'generic_question' || a.cls.type === 'generic_statement';
  });
if (reallyLowScore){
  var unknown = findUnknownWords(text);
  if (unknown.length){
    var uw = unknown[0];
    reply = 'Я не знаю, что такое «' + uw + '». Объяснишь?';
    MEM.unknownAsked = uw;
  }
}

  if (answers[0]) MEM.lastTopic = answers[0].cls.type.replace(/^topic:/, '');

  /* настроение */
  var m = text.match(/\bmood\s*[:=]\s*(\d+)/i);
  if (m) MEM.mood = clamp(parseInt(m[1], 10), 0, 100);
  else {
    var lower = text.toLowerCase();
    if (/спасибо|люблю|обожаю|привет|рад|круто|супер/.test(lower)) MEM.mood = clamp(MEM.mood + 3, 0, 100);
    if (/дурак|тупой|ненавижу|бесишь|блять|хуй/.test(lower)) MEM.mood = clamp(MEM.mood - 4, 0, 100);
    MEM.mood = clamp(MEM.mood + (60 - MEM.mood) * 0.02, 0, 100);
  }

  /* ФИКС #4: тематический second */
  if (MEM.mood > 55 && MEM.turn % 4 === 0 && Math.random() < 0.4 && answers[0]){
    var lastTopic = answers[0].cls.type.replace(/^topic:/, '');
    second = makeFollowUp(lastTopic);
    if (!second) second = rnd(['Расскажи что-нибудь ещё.', 'Что нового у тебя?', 'А сам как думаешь?']);
  }

  rememberReply(reply);
  pushHistory('ai', reply);
  if (second){ rememberReply(second); pushHistory('ai', second); }

  return {
    reply: reply,
    second: second,
    meta: {
      turn: MEM.turn,
      clauses: clauses.length,
      answers: answers.map(function(a){ return a.cls.type; }),
      factsFound: factsFound.map(function(f){ return f.key; }),
      mood: MEM.mood,
      latencyMs: +(nowMs() - t0).toFixed(2)
    }
  };
}

/* ─────────── КОМАНДЫ ─────────── */
function handleCommand(text){
  var m = text.match(/^\/mood\s*[:=]?\s*(\d+)/i);
  if (m){
    MEM.mood = clamp(parseInt(m[1], 10), 0, 100);
    return 'Настроение: ' + MEM.mood + '.';
  }
  if (/^\/facts\b/i.test(text)){
    if (!MEM.user.name && !MEM.user.age && !MEM.user.likes.length) return 'Пока ничего не помню о тебе.';
    var lines = [];
    if (MEM.user.name) lines.push('• имя: ' + MEM.user.name);
    if (MEM.user.age != null) lines.push('• возраст: ' + MEM.user.age);
    if (MEM.user.city) lines.push('• город: ' + MEM.user.city);
    if (MEM.user.job) lines.push('• работа: ' + MEM.user.job);
    if (MEM.user.hobby) lines.push('• хобби: ' + MEM.user.hobby);
    if (MEM.user.likes.length) lines.push('• любит: ' + MEM.user.likes.join(', '));
    if (MEM.user.dislikes.length) lines.push('• не любит: ' + MEM.user.dislikes.join(', '));
    if (MEM.user.has.length) lines.push('• имеет: ' + MEM.user.has.join(', '));
    return 'Помню:\n' + lines.join('\n');
  }
  if (/^\/learned\b/i.test(text)){
    if (!MEM.learned.size) return 'Пока ничего нового не выучил.';
    var lines2 = [];
    MEM.learned.forEach(function(v, k){ lines2.push('• ' + k + ' — ' + v); });
    return 'Выучил:\n' + lines2.join('\n');
  }
  if (/^\/stats\b/i.test(text)){
    return 'nTR · v1.0 · тем: ' + TOPIC_KEYS.length + ' · слов: ' + KW_TOTAL + ' · ход: ' + MEM.turn;
  }
  if (/^\/reset\b/i.test(text)){
    reset();
    return 'Сброшено.';
  }
  return null;
}

function reset(){
  MEM = createMEM();
}

return {
  respond: respond,
  handleCommand: handleCommand,
  reset: reset,
  getMemory: function(){ return MEM; },
  getStats: function(){
    return {
      version: '1.0',
      topics: TOPIC_KEYS.length,
      keywords: KW_TOTAL,
      templates: Object.keys(T).reduce(function(s, k){ return s + T[k][1].length; }, 0),
      mood: MEM.mood,
      turn: MEM.turn
    };
  }
};
}

/* ─────────── ОБЁРТКА ДЛЯ ПЕСОЧНИЦЫ ─────────── */
var _ntr = makeNTRAI();

return {
  async send(text, ctx){
    await KT.sleep(250 + Math.random() * 350);
    try {
      var txt = String(text || '');

      /* команды */
      var cmd = _ntr.handleCommand(txt);
      if (cmd) return cmd;

      var r = _ntr.respond(txt);
      var out = r.reply || '…';
      if (r.second) out = out + '\n' + r.second;
      return out;
    } catch(e){
      console.error('[ntr]', e);
      return '…';
    }
  },
  reset(){
    _ntr = makeNTRAI();
  },
  getThinking(){
    return null;
  }
};
</script>
<!-- ============================================================================
     AI STATUS PANEL — живые статусы всех ИИ
     ============================================================================ -->
<script>
(function(){
'use strict';
if (window.__KtAiStatusLoaded) return;
window.__KtAiStatusLoaded = true;

/* ── стили ── */
var st = document.createElement('style');
st.textContent = `
#asOverlay{position:fixed;inset:0;background:rgba(0,0,0,.78);
  display:none;align-items:center;justify-content:center;padding:16px;
  backdrop-filter:blur(6px);z-index:970;}
#asOverlay.on{display:flex;}
.as-modal{background:var(--bg2);border:1px solid var(--border2);
  border-radius:20px;max-width:480px;width:100%;max-height:88vh;
  display:flex;flex-direction:column;overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.7);}
.as-head{flex:none;display:flex;align-items:center;gap:10px;
  padding:14px 16px;border-bottom:1px solid var(--border);}
.as-head h3{margin:0;font-size:15px;flex:1;color:var(--text);}
.as-head .as-live{font-size:9.5px;font-weight:800;color:var(--ok);
  padding:2px 7px;border-radius:6px;background:rgba(34,197,94,.15);
  text-transform:uppercase;letter-spacing:.5px;}
.as-close{background:transparent;border:0;color:var(--text-muted);
  font-size:18px;cursor:pointer;padding:4px 8px;border-radius:6px;font-family:inherit;}
.as-close:active{background:var(--accent-soft);}
.as-body{flex:1;overflow-y:auto;padding:14px 16px 20px;
  -webkit-overflow-scrolling:touch;}
.as-card{background:var(--bg3);border:1px solid var(--border2);
  border-radius:14px;padding:12px 14px;margin-bottom:10px;}
.as-card-top{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.as-ava{width:36px;height:36px;border-radius:10px;flex:none;
  display:flex;align-items:center;justify-content:center;
  font-size:17px;color:#fff;font-weight:800;}
.as-name{flex:1;min-width:0;font-size:13px;font-weight:900;
  color:var(--text);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap;}
.as-name small{font-size:10px;color:var(--text-muted);
  font-weight:600;margin-left:4px;}
.as-ver{font-size:9.5px;font-weight:800;padding:2px 6px;
  border-radius:5px;background:var(--accent-soft);color:var(--accent);
  border:1px solid var(--border2);flex:none;}
.as-rows{display:flex;flex-direction:column;gap:6px;}
.as-row{display:flex;align-items:center;gap:8px;font-size:11.5px;}
.as-row .k{color:var(--text-muted);font-weight:700;min-width:95px;
  text-transform:uppercase;font-size:9.5px;letter-spacing:.3px;}
.as-row .v{color:var(--text);font-weight:700;flex:1;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.as-row .v.mono{font-family:ui-monospace,monospace;font-size:11px;}
.as-bar{height:6px;background:var(--bg);border-radius:99px;
  overflow:hidden;border:1px solid var(--border);flex:1;max-width:180px;}
.as-bar i{display:block;height:100%;border-radius:99px;
  transition:width .3s;}
.as-empty{font-size:11px;color:var(--text-muted);
  font-style:italic;padding:4px 0;}
.as-foot{font-size:9.5px;color:var(--text-muted);text-align:center;
  padding:10px 0 0;border-top:1px dashed var(--border);margin-top:10px;}
`;
document.head.appendChild(st);

/* ── утилиты ── */
function esc(s){
  return String(s).replace(/[<>&]/g, function(c){
    return c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;';
  });
}
function hasMethod(obj, name){
  return obj && typeof obj[name] === 'function';
}
function safeCall(obj, name, fallback){
  try {
    if (hasMethod(obj, name)) return obj[name]();
  } catch(e){}
  return fallback;
}

/* ── mood → цвет ── */
function moodColor(score){
  if (score == null) return 'var(--text-muted)';
  if (score <= 15) return '#4a5568';
  if (score <= 35) return '#3b82f6';
  if (score <= 60) return '#22d3ee';
  if (score <= 80) return '#a855f7';
  return '#ec4899';
}
function moodLabel(score){
  if (score == null) return '—';
  if (score <= 15) return 'ледяное';
  if (score <= 35) return 'холодное';
  if (score <= 60) return 'нейтральное';
  if (score <= 80) return 'тёплое';
  return 'горячее';
}

/* ── рендер карточки ── */
function renderCard(ai){
  var id = ai.id;
  var name = ai.name || id;
  var color = ai.color || 'var(--accent)';
  var avatar = ai.avatar || '🤖';
  var version = ai.version || '—';
  var desc = ai.description || '';

  /* собираем все доступные данные */
  var mood = null, moodName = null, mode = null, facts = null, stats = null;
  var memory = null, learned = null, params = null, turn = null;

  /* mood */
  var m = safeCall(ai, 'getMood', null);
  if (m && typeof m === 'object'){
    mood = (typeof m.score === 'number') ? m.score : (typeof m.mood === 'number' ? m.mood : null);
    moodName = m.name || m.mode || null;
  } else if (typeof m === 'number'){
    mood = m;
  }

  /* mode */
  var md = safeCall(ai, 'getMode', null);
  if (md) mode = String(md);

  /* facts */
  var f = safeCall(ai, 'getFacts', null);
  if (f && typeof f === 'object'){
    if (f instanceof Map) facts = f.size;
    else if (Array.isArray(f)) facts = f.length;
    else facts = Object.keys(f).length;
  }

  /* memory */
  var mem = safeCall(ai, 'getMemory', null);
  if (mem && typeof mem === 'object'){
    if (mem.facts instanceof Map) facts = mem.facts.size;
    else if (mem.facts && typeof mem.facts === 'object') facts = Object.keys(mem.facts).length;
    if (typeof mem.historySize === 'number') turn = mem.historySize;
    else if (typeof mem.turn === 'number') turn = mem.turn;
    if (mem.turn != null && turn == null) turn = mem.turn;
    if (typeof mem.mood === 'number') mood = mem.mood;
    if (mem.learned && typeof mem.learned === 'object'){
      learned = (mem.learned instanceof Map) ? mem.learned.size : Object.keys(mem.learned).length;
    }
  }

  /* stats */
  var s = safeCall(ai, 'getStats', null);
  if (s && typeof s === 'object'){
    stats = s;
    if (typeof s.mood === 'number' && mood == null) mood = s.mood;
    if (typeof s.turn === 'number' && turn == null) turn = s.turn;
    if (typeof s.parametersUsed === 'number') params = s.parametersUsed;
    else if (typeof s.parameters === 'number') params = s.parameters;
  }

  /* ─── формируем строки ─── */
  var rows = [];

  /* mood */
  if (mood != null){
    var col = moodColor(mood);
    var pct = Math.max(0, Math.min(100, mood));
    rows.push(
      '<div class="as-row">' +
        '<span class="k">настроение</span>' +
        '<span class="as-bar"><i style="width:' + pct + '%;background:' + col + '"></i></span>' +
        '<span class="v" style="min-width:70px;text-align:right">' +
          mood + ' · ' + esc(moodLabel(mood)) +
        '</span>' +
      '</div>'
    );
  }

  /* mood name */
  if (moodName){
    rows.push(
      '<div class="as-row"><span class="k">mood-name</span>' +
      '<span class="v mono">' + esc(moodName) + '</span></div>'
    );
  }

  /* mode */
  if (mode && mode !== 'null'){
    rows.push(
      '<div class="as-row"><span class="k">режим</span>' +
      '<span class="v mono">' + esc(mode) + '</span></div>'
    );
  }

  /* turn */
  if (turn != null){
    rows.push(
      '<div class="as-row"><span class="k">ходов</span>' +
      '<span class="v">' + turn + '</span></div>'
    );
  }

  /* facts */
  if (facts != null){
    rows.push(
      '<div class="as-row"><span class="k">фактов</span>' +
      '<span class="v">' + facts + '</span></div>'
    );
  }

  /* learned */
  if (learned != null){
    rows.push(
      '<div class="as-row"><span class="k">выучено</span>' +
      '<span class="v">' + learned + ' слов</span></div>'
    );
  }

  /* params */
  if (params != null){
    rows.push(
      '<div class="as-row"><span class="k">параметров</span>' +
      '<span class="v mono">' + params.toLocaleString('en-US') + '</span></div>'
    );
  }

  /* intents/topics */
  if (stats){
    if (typeof stats.intents === 'number'){
      rows.push(
        '<div class="as-row"><span class="k">интентов</span>' +
        '<span class="v">' + stats.intents + '</span></div>'
      );
    } else if (typeof stats.topics === 'number'){
      rows.push(
        '<div class="as-row"><span class="k">тем</span>' +
        '<span class="v">' + stats.topics + '</span></div>'
      );
    }
    if (typeof stats.templates === 'number'){
      rows.push(
        '<div class="as-row"><span class="k">шаблонов</span>' +
        '<span class="v">' + stats.templates + '</span></div>'
      );
    }
  }

  var rowsHtml = rows.length ? rows.join('') :
    '<div class="as-empty">Нет данных — слот не отдаёт состояние</div>';

  return (
    '<div class="as-card" style="border-left:3px solid ' + esc(color) + '">' +
      '<div class="as-card-top">' +
        '<div class="as-ava" style="background:' + esc(color) + '">' + esc(avatar) + '</div>' +
        '<div class="as-name">' + esc(name) +
          (desc ? '<small>· ' + esc(desc) + '</small>' : '') +
        '</div>' +
        '<span class="as-ver">' + esc(version) + '</span>' +
      '</div>' +
      '<div class="as-rows">' + rowsHtml + '</div>' +
    '</div>'
  );
}

/* ── рендер всех ── */
function renderAll(){
  if (!window.KT || !window.KT.listAIs) return '<div class="as-empty">Слоты не загружены.</div>';
  var list = window.KT.listAIs();
  if (!list.length) return '<div class="as-empty">Нет подключённых ИИ.</div>';
  var html = '';
  for (var i = 0; i < list.length; i++){
    html += renderCard(list[i]);
  }
  html += '<div class="as-foot">Панель обновляется автоматически · данные из живого состояния слотов</div>';
  return html;
}

/* ── живое обновление ── */
var refreshTimer = null;
function startRefresh(){
  stopRefresh();
  refreshTimer = setInterval(function(){
    var ov = document.getElementById('asOverlay');
    if (!ov || !ov.classList.contains('on')){
      stopRefresh();
      return;
    }
    var body = ov.querySelector('.as-body');
    if (body) body.innerHTML = renderAll();
  }, 2000);
}
function stopRefresh(){
  if (refreshTimer){ clearInterval(refreshTimer); refreshTimer = null; }
}

function openPanel(){
  var ov = document.getElementById('asOverlay');
  if (!ov) return;
  ov.querySelector('.as-body').innerHTML = renderAll();
  ov.classList.add('on');
  startRefresh();
}
function closePanel(){
  var ov = document.getElementById('asOverlay');
  if (ov) ov.classList.remove('on');
  stopRefresh();
}

/* ── модалка ── */
function injectModal(){
  if (document.getElementById('asOverlay')) return;
  var ov = document.createElement('div');
  ov.id = 'asOverlay';
  ov.innerHTML =
    '<div class="as-modal">' +
      '<div class="as-head">' +
        '<h3>📈 Статусы ИИ</h3>' +
        '<span class="as-live">live</span>' +
        '<button class="as-close" type="button">✕</button>' +
      '</div>' +
      '<div class="as-body"></div>' +
    '</div>';
  ov.addEventListener('click', function(e){ if (e.target === ov) closePanel(); });
  ov.querySelector('.as-close').addEventListener('click', closePanel);
  document.body.appendChild(ov);
}

/* ── кнопка в меню ── */
function injectMenuButton(){
  var menu = document.querySelector('#menu .modal-body');
  if (!menu){ setTimeout(injectMenuButton, 300); return; }
  if (document.getElementById('mAiStatus')) return;

  var btn = document.createElement('button');
  btn.className = 'menu-btn';
  btn.id = 'mAiStatus';
  btn.textContent = '📈 Статусы ИИ';

  /* вставляем после пункта «Информация о ИИ» (mInfo) */
  var mInfo = document.getElementById('mInfo');
  if (mInfo && mInfo.parentNode === menu) menu.insertBefore(btn, mInfo.nextSibling);
  else menu.appendChild(btn);

  btn.addEventListener('click', function(){
    /* закрываем меню */
    var menuOv = document.getElementById('menu');
    if (menuOv) menuOv.classList.remove('on');
    /* открываем панель чуть позже, чтобы переход был плавным */
    setTimeout(openPanel, 100);
  });
}

/* ── инициализация ── */
function init(){
  injectModal();
  injectMenuButton();
}

if (document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', init);
} else {
  setTimeout(init, 500);
}

/* Escape закрывает */
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape' && document.getElementById('asOverlay') &&
      document.getElementById('asOverlay').classList.contains('on')){
    closePanel();
  }
});

/* экспорт для консоли */
window.openAiStatus = openPanel;
window.closeAiStatus = closePanel;

})();
</script>
