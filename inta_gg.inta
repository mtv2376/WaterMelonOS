#airOverlay{position:fixed;inset:0;background:rgba(0,0,0,.78);
  display:none;align-items:center;justify-content:center;padding:16px;
  backdrop-filter:blur(6px);z-index:960;}
#airOverlay.on{display:flex;}
.air-modal{background:var(--bg2);border:1px solid var(--border2);
  border-radius:20px;max-width:520px;width:100%;max-height:88vh;
  display:flex;flex-direction:column;overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.7);}
.air-head{flex:none;display:flex;align-items:center;gap:10px;
  padding:14px 16px;border-bottom:1px solid var(--border);}
.air-head h3{margin:0;font-size:15px;flex:1;color:var(--text);}
.air-close{background:transparent;border:0;color:var(--text-muted);
  font-size:18px;cursor:pointer;padding:4px 8px;border-radius:6px;font-family:inherit;}
.air-close:active{background:var(--accent-soft);}
.air-body{flex:1;overflow-y:auto;padding:14px 16px 20px;
  -webkit-overflow-scrolling:touch;}
.air-dev{display:flex;align-items:center;gap:12px;padding:12px 14px;
  background:linear-gradient(135deg,var(--accent-soft),transparent);
  border:1px solid var(--border2);border-radius:14px;margin-bottom:14px;}
.air-dev-ava{width:44px;height:44px;border-radius:50%;flex:none;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:20px;font-weight:900;color:#fff;}
.air-dev-info{flex:1;min-width:0;}
.air-dev-name{font-size:14px;font-weight:900;color:var(--text);}
.air-dev-role{font-size:11px;color:var(--accent);font-weight:700;margin-top:1px;}
.air-dev-bio{font-size:10.5px;color:var(--text-muted);margin-top:4px;line-height:1.4;}
.air-series{margin:18px 0 8px;display:flex;align-items:center;gap:8px;}
.air-series-badge{font-size:10px;font-weight:900;letter-spacing:1px;
  padding:3px 8px;border-radius:6px;text-transform:uppercase;color:#fff;}
.air-series-ntt{background:linear-gradient(135deg,#22d3ee,#0891b2);}
.air-series-VSP{background:linear-gradient(135deg,#3b82f6,#1d4ed8);}
.air-series-V{background:linear-gradient(135deg,#a855f7,#6d28d9);}
.air-series-rofl{background:linear-gradient(135deg,#a16207,#78350f);}
.air-series-sep{flex:1;height:1px;background:var(--border);}
.air-card{background:var(--bg3);border:1px solid var(--border2);
  border-radius:14px;padding:12px 14px;margin-bottom:10px;
  transition:transform .12s, border-color .12s;cursor:default;}
.air-card:active{transform:scale(.99);}
.air-card:hover{border-color:var(--accent);}
.air-card-top{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;}
.air-card-ava{width:38px;height:38px;border-radius:10px;flex:none;
  display:flex;align-items:center;justify-content:center;font-size:18px;
  color:#fff;font-weight:800;box-shadow:0 4px 12px rgba(0,0,0,.3);}
.air-card-head{flex:1;min-width:0;}
.air-card-name{font-size:13.5px;font-weight:900;color:var(--text);
  display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.air-card-ver{font-size:9.5px;font-weight:800;padding:2px 6px;
  border-radius:5px;background:var(--accent-soft);color:var(--accent);
  border:1px solid var(--border2);}
.air-card-alias{font-size:10px;color:var(--text-muted);font-weight:600;
  margin-top:1px;}
.air-card-score{text-align:right;flex:none;}
.air-score-num{font-size:18px;font-weight:900;color:var(--accent);
  font-variant-numeric:tabular-nums;line-height:1;}
.air-score-lbl{font-size:8px;font-weight:800;color:var(--text-muted);
  text-transform:uppercase;letter-spacing:.5px;margin-top:2px;}
.air-desc{font-size:11.5px;color:var(--text2);line-height:1.5;
  margin-bottom:8px;}
.air-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:5px;
  margin-bottom:8px;}
.air-cell{background:var(--bg2);border:1px solid var(--border);
  border-radius:7px;padding:5px 8px;}
.air-cell-k{font-size:8.5px;color:var(--text-muted);font-weight:800;
  text-transform:uppercase;letter-spacing:.4px;}
.air-cell-v{font-size:11px;font-weight:800;color:var(--text);
  margin-top:1px;word-break:break-word;}
.air-cell-note{font-size:9px;color:var(--text-muted);
  margin-top:2px;font-weight:600;line-height:1.3;}
.air-feat{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px;}
.air-tag{font-size:9.5px;font-weight:700;padding:3px 7px;
  border-radius:99px;background:var(--accent-soft);
  border:1px solid var(--border2);color:var(--text2);}
.air-best{font-size:10px;color:var(--text-muted);font-style:italic;
  border-top:1px dashed var(--border);padding-top:6px;margin-top:6px;}
.air-best b{color:var(--accent);font-style:normal;font-weight:800;}
.air-foot{font-size:9.5px;color:var(--text-muted);text-align:center;
  padding:10px 0 0;border-top:1px dashed var(--border);margin-top:14px;}
`;
document.head.appendChild(style);

/* ─────────────────────────────────────────────────────────────────────────
   4. КНОПКА
   ───────────────────────────────────────────────────────────────────────── */
function injectButton(){
  var header = document.getElementById('header');
  if (!header){ setTimeout(injectButton, 300); return; }
  var btnMenu = document.getElementById('btnMenu');
  var btn = document.createElement('button');
  btn.className = 'air-btn';
  btn.id = 'btnAiRating';
  btn.title = 'Рейтинг ИИ';
  btn.textContent = '📊';
  btn.onclick = openPanel;
  if (btnMenu && btnMenu.parentNode === header) header.insertBefore(btn, btnMenu);
  else header.appendChild(btn);
}

/* ─────────────────────────────────────────────────────────────────────────
   5. МОДАЛКА
   ───────────────────────────────────────────────────────────────────────── */
function esc(s){
  return String(s).replace(/[<>&]/g, function(c){
    return c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;';
  });
}
function seriesLabel(s){
  if (s === 'ntt') return 'ntt';
  return 'V';
}
function seriesClass(s){
  return s === 'ntt' ? 'air-series-ntt' : 'air-series-V';
}

function renderCard(ai){
  var featureTags = (ai.features || []).map(f => '<span class="air-tag">' + esc(f) + '</span>').join('');
  var paramNote = ai.paramsNote ? '<div class="air-cell-note">' + esc(ai.paramsNote) + '</div>' : '';
  return (
    '<div class="air-card" style="border-left:3px solid ' + esc(ai.color) + '">' +
      '<div class="air-card-top">' +
        '<div class="air-card-ava" style="background:' + esc(ai.color) + '">' +
          esc(ai.avatar) + '</div>' +
        '<div class="air-card-head">' +
          '<div class="air-card-name">' + esc(ai.name) +
            '<span class="air-card-ver">' + esc(ai.version) + '</span>' +
          '</div>' +
          (ai.alias ? '<div class="air-card-alias">' + esc(ai.alias) + '</div>' : '') +
        '</div>' +
        '<div class="air-card-score">' +
          '<div class="air-score-num">' + ai.score.toFixed(1) + '</div>' +
          '<div class="air-score-lbl">score</div>' +
        '</div>' +
      '</div>' +
      '<div class="air-desc">' + esc(ai.description) + '</div>' +
      '<div class="air-grid">' +
        '<div class="air-cell">' +
          '<div class="air-cell-k">Тип</div>' +
          '<div class="air-cell-v">' + esc(ai.type) + '</div>' +
        '</div>' +
        '<div class="air-cell">' +
          '<div class="air-cell-k">Параметры</div>' +
          '<div class="air-cell-v">' + esc(ai.params) + '</div>' +
          paramNote +
        '</div>' +
        '<div class="air-cell">' +
          '<div class="air-cell-k">Интентов</div>' +
          '<div class="air-cell-v">' + esc(String(ai.intents)) + '</div>' +
        '</div>' +
        '<div class="air-cell">' +
          '<div class="air-cell-k">Токены</div>' +
          '<div class="air-cell-v">' + esc(ai.tokens) + '</div>' +
        '</div>' +
      '</div>' +
      '<div class="air-cell" style="margin-bottom:8px">' +
        '<div class="air-cell-k">Память</div>' +
        '<div class="air-cell-v" style="font-size:10.5px">' + esc(ai.memory) + '</div>' +
      '</div>' +
      (featureTags ? '<div class="air-feat">' + featureTags + '</div>' : '') +
      (ai.bestFor ? '<div class="air-best">Лучше всего: <b>' + esc(ai.bestFor) + '</b></div>' : '') +
    '</div>'
  );
}

function renderAll(){
  var ntt = AI_DATA.filter(a => a.series === 'ntt');
  var vs  = AI_DATA.filter(a => a.series === 'V');

  var html = '';

  /* серия ntt */
  if (ntt.length){
    html += '<div class="air-series">' +
      '<span class="air-series-badge ' + seriesClass('ntt') + '">серия ntt</span>' +
      '<span class="air-series-sep"></span>' +
      '<span style="font-size:10px;color:var(--text-muted);font-weight:700">' +
        ntt.length + ' ИИ</span>' +
    '</div>';
    ntt.forEach(function(ai){ html += renderCard(ai); });
  }
  
  var vsp = AI_DATA.filter(function(a){ return a.series === 'VSP'; });
if (vsp.length){
  html += '<div class="air-series">' +
    '<span class="air-series-badge air-series-VSP">серия VSP</span>' +
    '<span class="air-series-sep"></span>' +
    '<span style="font-size:10px;color:var(--text-muted);font-weight:700">' +
      vsp.length + ' ИИ</span>' +
  '</div>';
  vsp.sort(function(a,b){ return b.score - a.score; });
  vsp.forEach(function(ai){ html += renderCard(ai); });
}

  /* серия V */
  if (vs.length){
    html += '<div class="air-series">' +
      '<span class="air-series-badge ' + seriesClass('V') + '">серия V</span>' +
      '<span class="air-series-sep"></span>' +
      '<span style="font-size:10px;color:var(--text-muted);font-weight:700">' +
        vs.length + ' ИИ</span>' +
    '</div>';
    vs.sort(function(a,b){ return b.score - a.score; });
    vs.forEach(function(ai){ html += renderCard(ai); });
  }

  /* серия rofl */
  var rofl = AI_DATA.filter(function(a){ return a.series === 'rofl'; });
  if (rofl.length){
    html += '<div class="air-series">' +
      '<span class="air-series-badge air-series-rofl">серия rofl</span>' +
      '<span class="air-series-sep"></span>' +
      '<span style="font-size:10px;color:var(--text-muted);font-weight:700">' +
        rofl.length + ' ИИ</span>' +
    '</div>';
    rofl.sort(function(a,b){ return b.score - a.score; });
    rofl.forEach(function(ai){ html += renderCard(ai); });
  }

  html += '<div class="air-foot">KtalkAI Sandbox · рейтинг составлен по честности архитектуры, обучаемости и качеству диалога</div>';

  return html;
}

function openPanel(){
  var ov = document.getElementById('airOverlay');
  if (!ov) return;
  var body = ov.querySelector('.air-body');
  body.innerHTML = renderAll();
  ov.classList.add('on');
}
function closePanel(){
  var ov = document.getElementById('airOverlay');
  if (ov) ov.classList.remove('on');
}

function injectModal(){
  if (document.getElementById('airOverlay')) return;
  var ov = document.createElement('div');
  ov.id = 'airOverlay';
  ov.innerHTML =
    '<div class="air-modal">' +
      '<div class="air-head">' +
        '<h3>📊 Рейтинг ИИ · Sandbox</h3>' +
        '<button class="air-close" type="button">✕</button>' +
      '</div>' +
      '<div class="air-body"></div>' +
    '</div>';
  ov.addEventListener('click', function(e){ if (e.target === ov) closePanel(); });
  ov.querySelector('.air-close').addEventListener('click', closePanel);
  document.body.appendChild(ov);
}

/* ─────────────────────────────────────────────────────────────────────────
   6. ИНИЦИАЛИЗАЦИЯ
   ───────────────────────────────────────────────────────────────────────── */
function init(){
  injectModal();
  injectButton();
}

if (document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', init);
} else {
  setTimeout(init, 400);
}

/* Escape закрывает модалку */
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape' && document.getElementById('airOverlay') &&
      document.getElementById('airOverlay').classList.contains('on')){
    closePanel();
  }
});

})();
</script>
<!-- ============================================================================
     СЛОТ ИИ — KtalkAI v7 (honest architecture + патчи)
     ============================================================================ -->
<script type="text/html" id="ai-slot-ktalk7">
<!--
{
  "id": "ktalk7",
  "name": "KtalkAI v7",
  "color": "#a855f7",
  "avatar": "🧪",
  "description": "1.5M честных параметров · 62 интента · онлайн-обучение",
  "version": "7.0"
}
-->

function makeKtalk7AI(){
  'use strict';

  /* ==========================================================================
     ФИКС #1: конфиг + параметры (без изменений по структуре)
     ========================================================================== */
  const CFG = Object.freeze({
    VOCAB_SIZE: 10000,
    EMBED_DIM: 96,
    L1_OUT: 512, L2_OUT: 640, L3_OUT: 256,
    MOODS: 20, RTYPES: 16,
    MAX_CONTEXT: 70, MAX_OUTPUT: 2048,
    ANTI_REPEAT_N: 30, SKELETON_N: 40,
    LR_BACKPROP: 0.010, LR_COOCCUR: 0.005,
    MOMENTUM: 0.90, DECAY: 0.0001,
    BACKPROP_EVERY: 2   /* ФИКС #5: backprop не на каждой реплике */
  });

  /* ── утилиты ── */
  const clamp = (x,a,b) => x < a ? a : x > b ? b : x;
  const rnd = a => a[(Math.random()*a.length)|0];
  const cap = s => s ? s[0].toUpperCase() + s.slice(1) : s;
  const nowMs = () => (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();

  const TOKEN_RE = /[а-яёa-z0-9]+/g;
  const tokenize = t => (typeof t === 'string' ? (t.toLowerCase().match(TOKEN_RE) || []) : []).filter(w => w.length > 0);
  const STOP = new Set(('и в во не что он на я с со как а то все она так его но да ты к у же вы за бы по только ее мне было вот от меня еще нет о из ему теперь когда даже ну вдруг ли если уже или ни быть был него до вас нибудь опять уж вам ведь там потом себя ничего ей может они тут где есть надо ней для мы тебя их чем была сам чтоб без будто чего раз тоже себе под будет ж тогда кто этот того потому этого какой совсем ним здесь этом один почти мой тем чтобы нее сейчас были куда зачем всех никогда можно при наконец два об другой хоть после над больше тот через эти нас про всего них какая много разве три эту моя впрочем хорошо свою этой перед иногда лучше чуть том нельзя такой им более всегда конечно всю между').split(' '));
  const contentTokens = t => tokenize(t).filter(w => !STOP.has(w));

  const SUF = ['ениями','ениям','ениях','иями','ями','ами','ения','ению','ение','ений','ией','иях','ию','ия','ие','ыми','ому','ого','ему','ых','их','ый','ой','ая','ые','ое','ее','ую','юю','яя','ими','ей','ий','ам','ям','ах','ях','ов','ев','ью','ем','ом','ся','сь','ть','ы','и','а','я','о','е','у','ю','й','ь'];
  function stem(w){
    if (w.length < 5) return w;
    for (const s of SUF) if (w.length > s.length + 3 && w.endsWith(s)) return w.slice(0,-s.length);
    return w;
  }

  /* ── настроения ── */
  const MOODS = [
    {id:0,n:'icy',r:[0,4],e:'',tone:'cold',style:'minimal'},
    {id:1,n:'cold',r:[5,9],e:'',tone:'cold',style:'minimal'},
    {id:2,n:'distant',r:[10,14],e:'',tone:'cold',style:'short'},
    {id:3,n:'reserved',r:[15,19],e:'',tone:'cool',style:'short'},
    {id:4,n:'neutral',r:[20,24],e:'',tone:'cool',style:'normal'},
    {id:5,n:'calm',r:[25,29],e:'',tone:'cool',style:'normal'},
    {id:6,n:'friendly',r:[30,34],e:'',tone:'warm',style:'normal'},
    {id:7,n:'warm',r:[35,39],e:'😊',tone:'warm',style:'normal'},
    {id:8,n:'kind',r:[40,44],e:'🙂',tone:'warm',style:'normal'},
    {id:9,n:'caring',r:[45,49],e:'🤗',tone:'warm',style:'expanded'},
    {id:10,n:'playful',r:[50,54],e:'😏',tone:'warm',style:'expanded'},
    {id:11,n:'cheerful',r:[55,59],e:'😄',tone:'warm',style:'expanded'},
    {id:12,n:'excited',r:[60,64],e:'✨',tone:'hot',style:'expanded'},
    {id:13,n:'affectionate',r:[65,69],e:'💗',tone:'hot',style:'expanded'},
    {id:14,n:'tender',r:[70,74],e:'💕',tone:'hot',style:'expanded'},
    {id:15,n:'flirty',r:[75,79],e:'😘',tone:'hot',style:'expanded'},
    {id:16,n:'passionate',r:[80,84],e:'🔥',tone:'hot',style:'double'},
    {id:17,n:'enamored',r:[85,89],e:'💖',tone:'hot',style:'double'},
    {id:18,n:'devoted',r:[90,94],e:'💞',tone:'hot',style:'double'},
    {id:19,n:'obsessive',r:[95,100],e:'💘',tone:'hot',style:'double'}
  ];
  const moodOf = score => {
    score = clamp(score|0, 0, 100);
    for (const m of MOODS) if (score >= m.r[0] && score <= m.r[1]) return m;
    return MOODS[4];
  };

  /* ── типы ответов ── */
  const RTYPES = [
    {id:0,code:'st',n:'statement',punc:'.'},
    {id:1,code:'q',n:'question',punc:'?'},
    {id:2,code:'ex',n:'exclamation',punc:'!'},
    {id:3,code:'em',n:'empathy',punc:'…'},
    {id:4,code:'hu',n:'humor',punc:'!'},
    {id:5,code:'sa',n:'sarcasm',punc:'…'},
    {id:6,code:'fl',n:'flirt',punc:'…'},
    {id:7,code:'co',n:'compliment',punc:'.'},
    {id:8,code:'in',n:'insult',punc:'.'},
    {id:9,code:'pr',n:'profanity',punc:'.'},
    {id:10,code:'ad',n:'advice',punc:'.'},
    {id:11,code:'fa',n:'fact',punc:'.'},
    {id:12,code:'op',n:'opinion',punc:'.'},
    {id:13,code:'pm',n:'promise',punc:'.'},
    {id:14,code:'ag',n:'agreement',punc:'.'},
    {id:15,code:'me',n:'memory',punc:'.'}
  ];
  const RT_BY_CODE = Object.fromEntries(RTYPES.map(r => [r.code, r.id]));
  const RT_BY_ID = Object.fromEntries(RTYPES.map(r => [r.id, r]));

  /* ==========================================================================
     СЕМЕЙСТВА ИНТЕНТОВ — 62 (как в v7, оставлены полностью)
     ========================================================================== */
  const F = {};
  /* --- социальные --- */
  F.greet = {
    k:'привет здравствуй хай салют йоу добрый приветств здорово'.split(' '),
    e:['привет','здравствуй','хай','добрый день','салют','йоу','приветствую тебя','здравствуй снова','о привет','рад видеть'],
    t:[
      ['{hi}, {name}. {fw}','st,q','all'],
      ['{hi}! {react} {fw}','ex','warm+'],
      ['{react}. {fw}','st','all'],
      ['{hi}. Что нового?','q','all'],
      ['{hi}, {name}! {fw}','ex,q','warm+']
    ],
    s:{
      hi:['Привет','Здравствуй','Хай','Салют','Приветствую','О, привет','Здорово'],
      react:['Рад видеть','Наконец-то','Хорошо, что зашёл','А я тебя ждал','Давно не виделись'],
      fw:['Как ты?','Что нового?','Чем займёмся?','Как дела?','О чём поговорим?','Рассказывай.']
    }
  };
  F.howareyou = {
    k:'дела как жизнь сам поживаешь настроение нового оно'.split(' '),
    e:['как дела','как ты','как жизнь','как сам','как настроение','что нового','как поживаешь','как оно'],
    t:[
      ['{st}, {name}. {bk}','st,q','all'],
      ['У меня {st}. {bk}','st','all'],
      ['{st}. {bk}','st,q','cold+'],
      ['Знаешь, {st}. {bk}','st,q','warm+'],
      ['{st}! {bk}','ex','warm+']
    ],
    s:{
      st:['всё хорошо','отлично','по-кталкински','нормально','прекрасно','скучно без диалога'],
      bk:['А у тебя как?','А ты как?','Как сам?','Что у тебя нового?','Расскажи о себе.']
    }
  };
  F.whoami = {
    k:'кто ты такое бот человек имя зовут представься'.split(' '),
    e:['кто ты','что ты такое','ты кто','расскажи о себе','ты бот','ты человек','ты ии','твоё имя','как тебя зовут','представься'],
    t:[
      ['Я — {intro}. {fw}','st,q','all'],
      ['{intro}. {fw}','st','all'],
      ['Меня зовут {sn}. {intro}','st','all'],
      ['{sn}, к вашим услугам. {intro}','st','warm+'],
      ['{intro} — вот кто я. {fw}','ex,st','warm+']
    ],
