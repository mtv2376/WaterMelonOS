// SECTION 1.8 — Быстрый доступ к словарю городов
// -------------------------------------------------------------

const CITY_SET = new Set(_keys(CITIES));

function cityExists(word){
  if (!_isStr(word)) return false;
  const w = word.toLowerCase().replace(/ё/g, "е");
  if (CITY_SET.has(word)) return true;
  if (CITY_SET.has(w)) return true;
  for (const c of CITY_SET){
    if (c.replace(/ё/g, "е") === w) return true;
  }
  return false;
}

function cityCanonical(word){
  if (!_isStr(word)) return null;
  if (CITY_SET.has(word)) return word;
  const w = word.toLowerCase().replace(/ё/g, "е");
  for (const c of CITY_SET){
    if (c.replace(/ё/g, "е") === w) return c;
  }
  return null;
}

