   'вам вас вами ним ним нею ими кем чем чему кому кого чего'
  ).split(' ').forEach(function(w){ STOP[w]=1; });

  var FILLER = {};
  ('вообще-то вообще короче типа просто как-то что-то по-моему по-твоему впрочем ' +
   'наверное возможно кстати честно нибудь какой-то какая-то какое-то какие-то ' +
