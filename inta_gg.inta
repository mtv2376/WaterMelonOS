    ['Родной, расскажи — и разберём.','Милый, а что сердце говорит?']
  ],[],['как поступить','что делать с']);

  I('ack',['ок','окей','понял','понятно','ясно','угу','ага','ясненько','океюшки'],[
    ['Понял.','Ясно.','Ок.','Угу.','Так.','Принято.'],
    ['Хорошо.','Понял тебя.','Принято.','Запомнил.'],
    ['Хорошо, {name}.','Принято, родной.','Поняла тебя.']
  ],[],['ок','понял','ага']);

  I('misc',[],[
    ['Понял.','Ясно.','Ок.','Хм.','Ага.','Принято.','Так.','Угу.','Дальше.','Ладно.','Мг.','Ну.','Слушаю.','Понимаю.','Интересно.','Понятно.','Ого.','Хорошо.','Ух.','Да ну.'],
    ['Расскажи подробнее.','Что дальше?','Интересно.','Продолжай.','И что было потом?','Как это было?','Что ещё?','Хм, любопытно.','Поясни.','Развей мысль.','Слушаю.','Понял тебя.','Ок, и что?','Может расскажешь больше?','Это интересно. Продолжай.','Как ты к этому пришёл?','О чём думаешь?','Что новенького?','И?','Хм-м-м.','Говори дальше.','Не останавливайся.'],
    ['Расскажи, мне интересно.','Продолжай, я слушаю.','И что дальше?','Хочу знать больше.','Что за этим?','Дальше-дальше.','Ты меня заинтриговал.','Не останавливайся.','Говори ещё.','Расскажи всё.','Мне важно это слышать.','Как это на тебя повлияло?','Что ты об этом думаешь?','Я вся внимание.','Делись мыслями.']
  ],['Расскажи ещё.'],[]);

  var N_INTENTS = INTENTS.length;

  var intentEmb = new Float32Array(N_INTENTS * DIM);
  var exEmb     = new Float32Array(N_INTENTS * DIM);

  function buildKStems(kwList){
    var out = [];
    for (var i=0;i<kwList.length;i++){
      var toks = tokenizeRaw(kwList[i]);
      if (toks.length > 0) out.push(toks);
    }
    return out;
  }
  for (var ki=0; ki<N_INTENTS; ki++){
    INTENTS[ki].kStems = buildKStems(INTENTS[ki].k);
  }

  (function bootstrapIntents(){
    for (var ii=0; ii<N_INTENTS; ii++){
      var kwText = INTENTS[ii].k.join(' ');
      var exText = INTENTS[ii].e.join(' ');
      var kwToks = tokenizeRaw(kwText);
      var exToks = tokenizeRaw(exText);
      var allToks = kwToks.concat(exToks);
      for (var t1=0; t1<allToks.length; t1++) wid(allToks[t1]);
      var vAll = embed(allToks);
      var vEx  = exToks.length ? embed(exToks) : vAll;
      var off = ii * DIM;
      for (var d=0; d<DIM; d++){
        intentEmb[off+d] = vAll[d];
        exEmb[off+d]     = vEx[d];
      }
    }
  })();

  var POS_WORDS = new Set(('хорошо отлично класс супер рад счастлив люблю нравится спасибо приятно тепло ' +
    'круто прекрасно чудесно замечательно восторг кайф свет милый родной солнце счастье улыбка смех').split(' '));
  var NEG_WORDS = new Set(('плохо ужасно грустно печаль больно ненавижу злость гнев страх тревога ' +
    'устал вымотан бесит раздражает отстой скучно тоска').split(' '));
  var NEG_FEEDBACK = new Set(['нет','не так','неправильно','не понял','не то','ошибка','мимо']);

  var PROFANITY_ROOTS = ['бля','хуй','хуя','хуе','хуё','пизд','ебат','ебал','ебет','ебуч','ебу','ёба','ёбу',
    'нахуй','нихуя','ахуе','охуе','сука','суки','мудак','мудил','пидор','пидар','гандон','долбоеб','манда'];

  function detectProfanity(input){
    var lc = String(input).toLowerCase();
    for (var i=0;i<PROFANITY_ROOTS.length;i++) if (lc.indexOf(PROFANITY_ROOTS[i]) >= 0) return true;
    return false;
  }

  function isWhatX(input){
    return /^\s*(что|чё)\s+[а-яёa-z\-]+\s*\??\s*$/i.test(input) ||
           /^\s*(что|чё)\s+это\s+[а-яёa-z\-]+\s*\??\s*$/i.test(input) ||
           /^\s*(что|чё)\s+за\s+[а-яёa-z\-]+\s*\??\s*$/i.test(input);
  }

  var WHATX_EXCLUDE = new Set(['greeting','farewell','thanks','sorry','yes','no','small_talk','celebrate','welcome_back','greet_long','profanity','ack']);

  var EMOJI_CATS = {
    '👍':'positive','✅':'positive','🔥':'positive','😊':'positive','😀':'positive','😃':'positive','😄':'positive','🙂':'positive','💪':'positive',
    '😂':'laugh','🤣':'laugh','😆':'laugh',
    '❤':'love','💕':'love','💜':'love','💖':'love','😍':'love','😘':'love','💗':'love',
    '😡':'angry','🤬':'angry','😠':'angry',
    '💀':'shock','😱':'shock','😨':'shock','😮':'shock',
    '😢':'sad','😭':'sad','😔':'sad','😞':'sad',
    '🙏':'thanks','👋':'greet','🎉':'celebrate','🎊':'celebrate','🤔':'thoughtful'
  };
  var EMOJI_REPLIES = {
    positive:['Рад!','Здорово!','😊','Класс.','Отлично.'],
    laugh:['Ха-ха.','😄','Смешно.','Улыбнулась.'],
    love:['И я тебя 💜','Взаимно.','💕','Спасибо.'],
    angry:['Остынь.','Что случилось?','Понимаю.','Дыши.'],
    sad:['Жаль.','Расскажи.','Сочувствую.','Обнимаю.'],
    thanks:['Пожалуйста.','Обращайся.','Всегда рада.'],
    greet:['Привет!','Здравствуй.','Привет-привет.'],
    shock:['Ого.','Правда?','Ничего себе.'],
    celebrate:['🎉','Ура!','Поздравляю!'],
    thoughtful:['Хм.','Думаешь?','Понимаю.']
  };

  function detectEmojiCats(text){
    var s = String(text||'');
    var cats = [];
    var i = 0;
    while (i < s.length){
      var cp = s.codePointAt(i);
      var ch = String.fromCodePoint(cp);
      var inRange = (cp >= 0x1F300 && cp <= 0x1FAFF) || (cp >= 0x2600 && cp <= 0x27BF);
      if (inRange){
        var c = EMOJI_CATS[ch];
        if (c) cats.push(c);
      }
      i += ch.length;
    }
    return cats;
  }

  function sentimentBump(lc){
    var m = 0, r = 0;
    var toks = lc.split(/[^а-яёa-z]+/);
    for (var i=0;i<toks.length;i++){
      var t = stem(toks[i]);
      if (POS_WORDS.has(t) || POS_WORDS.has(toks[i])){ m += 1.2; r += 0.4; }
      else if (NEG_WORDS.has(t) || NEG_WORDS.has(toks[i])){ m -= 1.2; r -= 0.2; }
    }
    return { mood: Math.tanh(m/3)*3, rel: Math.tanh(r/3)*0.8 };
  }

  var MEM;
  function freshMem(){
    return {
      user: new Map(),
      learned: new Map(),
      history: [],
      recentReplies: [],
      recentSkeletons: new Set(),
      recentSkeletonsQueue: [],
      recentSeconds: new Set(),
      recentSecondsQueue: [],
      lastReply: '',
      intentHistory: [],
      intentPenalty: new Map(),
      batchBuf: [],
      mood: 60,
      relationship: 20,
      turn: 0,
      latencyMs: 0,
      saveMs: 0,
      lastUserSkeleton: ''
    };
  }
  MEM = freshMem();

  function saveNow(){
    try {
      if (typeof localStorage === 'undefined') return;
      var s0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
      var snap = {
        user: Array.from(MEM.user.entries()),
        learned: Array.from(MEM.learned.entries()),
        mood: MEM.mood,
        relationship: MEM.relationship,
        turn: MEM.turn
      };
      localStorage.setItem(MEM_KEY, JSON.stringify(snap));
      var s1 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
      MEM.saveMs = s1 - s0;
    } catch(e){}
  }

  function load(){
    try {
      if (typeof localStorage === 'undefined') return;
      var raw = localStorage.getItem(MEM_KEY);
      if (!raw) return;
      var snap = JSON.parse(raw);
      if (snap && snap.user) MEM.user = new Map(snap.user);
      if (snap && snap.learned) MEM.learned = new Map(snap.learned);
      if (snap && typeof snap.mood === 'number') MEM.mood = snap.mood;
      if (snap && typeof snap.relationship === 'number') MEM.relationship = snap.relationship;
      if (snap && typeof snap.turn === 'number') MEM.turn = snap.turn;
    } catch(e){}
  }
  load();

  function clamp(v, lo, hi){ return v < lo ? lo : (v > hi ? hi : v); }

  function normalizeSkeleton(s){
    return String(s||'').toLowerCase().replace(/[^а-яёa-z0-9]/g,'').slice(0, 32);
  }

  function tokenOverlap(a, b){
    var t1 = overlapTokens(a);
    var t2 = overlapTokens(b);
    if (!t1.length || !t2.length) return 0;
    var set = new Set(t1);
    var inter = 0;
    for (var i=0;i<t2.length;i++) if (set.has(t2[i])) inter++;
    return inter / Math.max(t1.length, t2.length);
  }

  function extractFacts(text){
    var t = String(text);
    var m;
    m = t.match(/меня\s+зовут\s+([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m) MEM.user.set('name', m[1]);
    m = t.match(/мо[её]\s+имя\s+[—-]?\s*([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m) MEM.user.set('name', m[1]);
    m = t.match(/зови\s+меня\s+([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m) MEM.user.set('name', m[1]);
    m = t.match(/мне\s+(\d{1,3})\s*(?:лет|год|года)/i);
    if (m) MEM.user.set('age', m[1]);
    m = t.match(/(?:я\s+живу\s+в|я\s+из)\s+([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m) MEM.user.set('city', m[1]);
    m = t.match(/мой\s+город\s+[—-]?\s*([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m) MEM.user.set('city', m[1]);
    m = t.match(/я\s+(?:очень\s+)?люблю\s+([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m){ var L = MEM.user.get('likes') || []; L.push(m[1]); MEM.user.set('likes', L.slice(-10)); }
    m = t.match(/я\s+не\s+люблю\s+([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m){ var D = MEM.user.get('dislikes') || []; D.push(m[1]); MEM.user.set('dislikes', D.slice(-10)); }
    m = t.match(/мне\s+нравится\s+([А-ЯЁA-Zа-яёa-z][а-яёa-z\-]+)/i);
    if (m){ var L2 = MEM.user.get('likes') || []; L2.push(m[1]); MEM.user.set('likes', L2.slice(-10)); }
  }

  function tokenMatch(kwStem, tokensArr){
    if (!kwStem) return false;
    var stemLen = kwStem.length;
    if (stemLen <= 3){
      for (var i=0;i<tokensArr.length;i++) if (tokensArr[i] === kwStem) return true;
      return false;
    }
    var pref = kwStem.slice(0, 4);
    for (var j=0;j<tokensArr.length;j++){
      var t = tokensArr[j];
      if (t === kwStem) return true;
      if (t.length >= 4 && t.slice(0,4) === pref) return true;
    }
    return false;
  }

  function countKwHits(kStems, tokensArr){
    var hits = 0;
    for (var i=0;i<kStems.length;i++){
      var phrase = kStems[i];
      var allIn = true;
      for (var j=0;j<phrase.length;j++){
        if (!tokenMatch(phrase[j], tokensArr)){ allIn = false; break; }
      }
      if (allIn) hits++;
    }
    return hits;
  }

  // ---------- SECOND POOLS ----------
  var SHORT_SECONDS = ['Что у тебя?','Расскажи.','Дальше?','И?','Что ещё?','Как сам?','Ну?','Что нового?','А ты?'];
  var LONG_SECONDS = ['Расскажи подробнее, мне интересно.','Хочу знать больше. Продолжай.','Что было дальше? Поделись.','Мне важно это слышать. Расскажи ещё.'];
  var SECOND_POOL = [
    'А ты как думаешь?','Что скажешь?','Как тебе?','Поделишься?',
    'Что нового у тебя?','Расскажи что-нибудь.','А сам как?',
    'Как твои дела?','Что у тебя произошло?','О чём думаешь?',
    'Может расскажешь больше?','Продолжай.','И что было потом?',
    'Что было дальше?','Это интересно. И?','Хм. Расскажи ещё.',
    'Как ты к этому пришёл?','А что было до этого?','Что ещё?',
    'Дай подумать. Что у тебя?','И как ты себя чувствуешь?'
  ];

  // ---------- TONE-SPECIFIC SECONDS ----------
  var TONE_SECONDS = {
    cold:    ['И?','Что дальше?','Не отвлекай.','','Не продолжай.'],
    warm:    ['Расскажи ещё.','Что у тебя?','Как сам?','Обнимаю.'],
    neutral: ['Продолжай.','И?','Что дальше?','Расскажи.','А ты?','Хм.'],
    factual: ['','Хочешь ещё факт?','Интересно?','','Ещё?'],
    greeting_tone: ['','','Как ты?','Что нового?'],
    ack_tone: ['','','','Угу.','Мг.']
  };

  function pickToneSecond(tone){
    var pool = TONE_SECONDS[tone] || TONE_SECONDS.neutral;
    if (!pool.length) return '';
    // allow empty strings in pool
    for (var attempt = 0; attempt < 12; attempt++){
      var idx = Math.floor(Math.random() * pool.length);
      var cand = pool[idx];
      if (cand === '') return '';
      var skel = normalizeSkeleton(cand);
      if (MEM.recentSeconds.has(skel)) continue;
      MEM.recentSeconds.add(skel);
      MEM.recentSecondsQueue.push(skel);
      if (MEM.recentSecondsQueue.length > 10){
        var old = MEM.recentSecondsQueue.shift();
        MEM.recentSeconds.delete(old);
      }
      return cand;
    }
    MEM.recentSeconds.clear();
    MEM.recentSecondsQueue.length = 0;
    return pool[Math.floor(Math.random() * pool.length)];
  }

  // ---------- INTENT CATEGORIES ----------
  var NO_SECOND_INTENTS = new Set([
    'ack','yes','no','farewell','thanks','sorry','greeting',
    'insult','profanity','math','human_ask','robot_ask','real_ask','ai_ask',
    'fact','joke','story','philosophy','metaphor','poetry'
  ]);

  var COLD_INTENTS = new Set(['insult','profanity','angry','dumb','insult_self']);
  var WARM_INTENTS = new Set(['love_you','flirt','romantic','miss_you','happy','compliment','good_night','good_morning','celebrate','thanks','sorry']);
  var FACTUAL_INTENTS = new Set(['fact','joke','story','philosophy','metaphor','poetry','time','date','weather','math']);
  var ACK_INTENTS = new Set(['ack','yes','no']);

  function toneOf(intentName){
    if (COLD_INTENTS.has(intentName)) return 'cold';
    if (WARM_INTENTS.has(intentName)) return 'warm';
    if (FACTUAL_INTENTS.has(intentName)) return 'factual';
    if (ACK_INTENTS.has(intentName)) return 'ack_tone';
    if (intentName === 'greeting' || intentName === 'good_morning') return 'greeting_tone';
    return 'neutral';
  }

  function pickFromPool(pool, recentSet, recentQueue, maxSize){
    if (!pool || !pool.length) return '';
    for (var attempt = 0; attempt < 20; attempt++){
      var idx = Math.floor(Math.random() * pool.length);
      var cand = pool[idx];
      var skel = normalizeSkeleton(cand);
      if (recentSet.has(skel)) continue;
      recentSet.add(skel);
      recentQueue.push(skel);
      if (recentQueue.length > maxSize){
        var old = recentQueue.shift();
        recentSet.delete(old);
      }
      return cand;
    }
    recentSet.clear();
    recentQueue.length = 0;
    var fb = pool[Math.floor(Math.random() * pool.length)];
    recentSet.add(normalizeSkeleton(fb));
    recentQueue.push(normalizeSkeleton(fb));
    return fb;
  }

  function pickSecond(replyLen){
    var pool;
    if (replyLen < 20) pool = SHORT_SECONDS;
    else if (replyLen > 40) pool = LONG_SECONDS;
    else pool = SECOND_POOL;
    return pickFromPool(pool, MEM.recentSeconds, MEM.recentSecondsQueue, 10);
  }

  function pickTemplate(intent, level, x, input){
    var pool = intent.T[level] || intent.T[1] || intent.T[0];
    if (!pool || !pool.length) pool = ['Понятно.'];
    var userSkel = MEM.lastUserSkeleton || '';
    var lastReply = MEM.lastReply || '';
    for (var attempt = 0; attempt < 15; attempt++){
      var idx = Math.floor(Math.random() * pool.length);
      var cand = pool[idx];
      var skel = normalizeSkeleton(cand);
      if (skel === userSkel) continue;
      if (MEM.recentSkeletons.has(skel)) continue;
      if (lastReply && tokenOverlap(cand, lastReply) > 0.7) continue;
      MEM.recentSkeletons.add(skel);
      MEM.recentSkeletonsQueue.push(skel);
      if (MEM.recentSkeletonsQueue.length > 15){
        var old = MEM.recentSkeletonsQueue.shift();
        MEM.recentSkeletons.delete(old);
      }
      MEM.lastReply = cand;
      MEM.recentReplies.push(cand);
      if (MEM.recentReplies.length > 30) MEM.recentReplies.shift();
      return cand;
    }
    MEM.recentSkeletons.clear();
    MEM.recentSkeletonsQueue.length = 0;
    var fb = pool[Math.floor(Math.random() * pool.length)];
    MEM.recentSkeletons.add(normalizeSkeleton(fb));
    MEM.recentSkeletonsQueue.push(normalizeSkeleton(fb));
    MEM.lastReply = fb;
    MEM.recentReplies.push(fb);
    if (MEM.recentReplies.length > 30) MEM.recentReplies.shift();
    return fb;
  }

  function fill(tmpl){
    var name = MEM.user.get('name') || 'друг';
    var city = MEM.user.get('city') || 'твой город';
    var age = MEM.user.get('age') || '';
    var likes = MEM.user.get('likes') || [];
    var likesShort = likes.length ? likes.slice(-2).join(', ') : 'что-то своё';
    var t = String(tmpl);
    t = t.replace(/\{name\}/g, name);
    t = t.replace(/\{city\}/g, city);
    t = t.replace(/\{age\}/g, age);
    t = t.replace(/\{likes_short\}/g, likesShort);
    t = t.replace(/\{turn\}/g, String(MEM.turn));
    return t;
  }

  function tryMath(input){
    var m = input.trim().match(/^(-?\d+(?:[.,]\d+)?)\s*([+\-*/x×÷])\s*(-?\d+(?:[.,]\d+)?)\s*=?\s*\??$/);
    if (!m) return null;
    var a = parseFloat(m[1].replace(',','.'));
    var b = parseFloat(m[3].replace(',','.'));
    var op = m[2];
    var r;
    if (op === '+') r = a + b;
    else if (op === '-') r = a - b;
    else if (op === '*' || op === 'x' || op === '×') r = a * b;
    else if (op === '/' || op === '÷') { if (b === 0) return 'На ноль делить нельзя.'; r = a / b; }
    else return null;
    if (Number.isInteger(r)) return String(r);
    return String(Math.round(r * 10000) / 10000);
  }

  function findIntentIdx(name){
    for (var i=0;i<N_INTENTS;i++) if (INTENTS[i].n === name) return i;
    return -1;
  }

  function respond(text, ctx){
    ctx = ctx || {};
    var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
    var input = String(text || '').trim();
    if (!input) return { reply: '…', second: '', meta: { latencyMs: 0 } };

    var mres = tryMath(input);
    if (mres !== null){
      MEM.turn++;
      var t1f = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
      MEM.latencyMs = t1f - t0;
      return { reply: mres, second: '', meta: { intent: 'math', latencyMs: MEM.latencyMs } };
    }

    var lc = input.toLowerCase();

    if (!ctx.fromAI && MEM.intentHistory.length){
      var nwords = lc.split(/[^а-яёa-z]+/);
      var isNeg = false;
      for (var nw=0;nw<nwords.length;nw++){ if (NEG_FEEDBACK.has(nwords[nw])){ isNeg = true; break; } }
      if (isNeg){
        var last = MEM.intentHistory[MEM.intentHistory.length-1];
        if (last) MEM.intentPenalty.set(last.intent, (MEM.intentPenalty.get(last.intent) || 0) + 0.3);
      }
    }

    var tokens = tokenize(input);
    var x = embed(tokens);
    var fw = forwardMLP(x);
    var h1 = fw.h1, h2 = fw.h2, h3 = fw.h3;

    var emojiCats = detectEmojiCats(input);
    if (tokens.length === 0 && emojiCats.length > 0){
      var cat = emojiCats[0];
      var pool = EMOJI_REPLIES[cat] || ['…'];
      var replyE = pickFromPool(pool, MEM.recentSkeletons, MEM.recentSkeletonsQueue, 15);
      MEM.lastReply = replyE;
      MEM.recentReplies.push(replyE);
      if (MEM.recentReplies.length > 30) MEM.recentReplies.shift();
      MEM.lastUserSkeleton = normalizeSkeleton(input);
      if (!ctx.fromAI){
        MEM.history.push({ role:'user', text: input, t: Date.now() });
        MEM.history.push({ role:'ai', text: replyE, t: Date.now() });
        if (MEM.history.length > 200) MEM.history.splice(0, MEM.history.length - 200);
        MEM.turn++;
      }
      var t1e = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
      MEM.latencyMs = t1e - t0;
      return { reply: replyE, second: '', meta: { intent: cat + '_emoji', cat: cat, latencyMs: MEM.latencyMs } };
    }

    var ctxEmb = new Float32Array(DIM);
    var userMsgs = [];
    for (var hi = MEM.history.length - 1; hi >= 0 && userMsgs.length < 2; hi--){
      if (MEM.history[hi].role === 'user') userMsgs.push(MEM.history[hi].text);
    }
    if (userMsgs.length){
      for (var um=0; um<userMsgs.length; um++){
        var ct = tokenize(userMsgs[um]);
        var cv = embed(ct);
        for (var cd=0; cd<DIM; cd++) ctxEmb[cd] += cv[cd];
      }
      for (var cd2=0; cd2<DIM; cd2++) ctxEmb[cd2] /= userMsgs.length;
    }

    var hasName = MEM.user.has('name');
    var hasCity = MEM.user.has('city');
    var hasLikes = (MEM.user.get('likes')||[]).length > 0;

    var whatX = isWhatX(input);

    var kwScores = new Int32Array(N_INTENTS);
    var maxKw = 0;
    for (var ii=0; ii<N_INTENTS; ii++){
      var hits = countKwHits(INTENTS[ii].kStems, tokens);
      kwScores[ii] = hits;
      if (hits > maxKw) maxKw = hits;
    }

    var profanityDetected = detectProfanity(input);
    var profIdx = findIntentIdx('profanity');

    var best, bestScore = 0;

    if (profanityDetected && profIdx >= 0){
      best = profIdx;
      bestScore = 5;
    } else if (maxKw === 0){
      var miscIdx = findIntentIdx('misc');
      best = (miscIdx >= 0) ? miscIdx : (N_INTENTS - 1);
      bestScore = 0;
    } else {
      var finalists = [];
      for (var fi=0; fi<N_INTENTS; fi++){
        if (kwScores[fi] > 0){
          var nm0 = INTENTS[fi].n;
          if (whatX && WHATX_EXCLUDE.has(nm0)) continue;
          var off = fi * DIM;
          var dotH = dot(h3, intentEmb, off, DIM);
          var dotX = dot(x, exEmb, off, DIM);
          var dotC = dot(ctxEmb, intentEmb, off, DIM);
          var sc = kwScores[fi] * 2.5 + dotH * 0.8 + dotX * 0.5 + dotC * 0.3;
          if (hasName && (nm0 === 'name_ask' || nm0 === 'greet_long' || nm0 === 'welcome_back')) sc += 0.4;
          if (hasCity && (nm0 === 'city_tell' || nm0 === 'city_ask')) sc += 0.4;
          if (hasLikes && (nm0 === 'like' || nm0 === 'music' || nm0 === 'food')) sc += 0.3;
          var pen = MEM.intentPenalty.get(nm0) || 0;
          sc -= pen;
          finalists.push({ idx: fi, score: sc });
        }
      }
      if (finalists.length === 0){
        var miscIdx2 = findIntentIdx('misc');
        best = (miscIdx2 >= 0) ? miscIdx2 : (N_INTENTS - 1);
        bestScore = 0;
      } else {
        finalists.sort(function(a,b){ return b.score - a.score; });
        if (finalists.length === 1){
          best = finalists[0].idx; bestScore = finalists[0].score;
        } else {
          var f1 = finalists[0], f2 = finalists[1];
          var tp = 1.5;
          var e1 = Math.exp((f1.score - f2.score) / tp);
          var p1 = e1 / (e1 + 1);
          best = (Math.random() < p1) ? f1.idx : f2.idx;
          bestScore = f1.score;
        }
      }
    }
    var chosen = INTENTS[best];

    var moodSum = 0;
    for (var mo=0; mo<MOOD_K; mo++){
      var sm = moodB[mo], om = mo * DIM;
      for (var dm=0; dm<DIM; dm++) sm += moodW[om + dm] * h3[dm];
      if (sm > 0) moodSum += sm;
    }
    var moodDelta = Math.tanh(moodSum * 0.5) * 1.6;
    var rtSum = 0;
    for (var ro=0; ro<RT_K; ro++){
      var sr = rtB[ro], orr = ro * DIM;
      for (var dr=0; dr<DIM; dr++) sr += rtW[orr + dr] * h3[dr];
      if (sr > 0) rtSum += sr;
    }
    var rtDelta = Math.tanh(rtSum * 0.5) * 0.7;

    var bump = sentimentBump(lc);
    if (!ctx.fromAI){
      MEM.mood = clamp(MEM.mood + moodDelta + bump.mood, 0, 100);
      MEM.relationship = clamp(MEM.relationship + rtDelta + bump.rel + 0.15, 0, 100);
    }

    var effectiveLevel;
    if (MEM.relationship < 34) effectiveLevel = 0;
    else if (MEM.relationship < 67) effectiveLevel = (MEM.mood < 40 ? 0 : 1);
    else effectiveLevel = 2;

    MEM.lastUserSkeleton = normalizeSkeleton(input);

    var tmpl = pickTemplate(chosen, effectiveLevel, x, input);
    var reply = fill(tmpl);

    // ============ SECOND LOGIC v1.3 ============
    var second = '';
    if (!ctx.fromAI){
      var replyLen = reply.length;
      var replyEndsQ = /\?\s*$/.test(reply);
      var isNoSecond = NO_SECOND_INTENTS.has(chosen.n);

      if (!isNoSecond && !replyEndsQ && replyLen < 30){
        // chance by length
        var chance = replyLen < 20 ? 0.30 : 0.15;
        if (Math.random() < chance){
          var tone = toneOf(chosen.n);
          second = pickToneSecond(tone);
        }
      }

      // Attempt to embed question into reply itself
      if (!second && !replyEndsQ && replyLen < 25 && !isNoSecond){
        if (Math.random() < 0.35){
          var tone2 = toneOf(chosen.n);
          var q = pickToneSecond(tone2);
          if (q && q.length > 0 && !/\?\s*$/.test(q)){
            // append inline
            var sep = /[.!?]$/.test(reply) ? ' ' : '. ';
            reply = reply + sep + q;
            MEM.lastReply = reply;
          }
        }
      }
    }
    // ===========================================

    if (!ctx.fromAI){
      MEM.history.push({ role:'user', text: input, t: Date.now() });
      MEM.history.push({ role:'ai', text: reply, t: Date.now() });
      if (MEM.history.length > 200) MEM.history.splice(0, MEM.history.length - 200);
      MEM.turn++;
      extractFacts(input);
      MEM.intentHistory.push({ intent: chosen.n, confidence: bestScore, turn: MEM.turn });
      if (MEM.intentHistory.length > 10) MEM.intentHistory.shift();
      if (MEM.turn % 10 === 0){
        MEM.intentPenalty.forEach(function(v, k){
          var nv = v * 0.7;
          if (nv < 0.05) MEM.intentPenalty.delete(k);
          else MEM.intentPenalty.set(k, nv);
        });
      }
    }

    if (!ctx.fromAI && MEM.turn % 3 === 0){
      cooccurUpdate(tokens, 5, 0.03);
      var target = new Float32Array(DIM);
      var ioff = best * DIM;
      for (var dT=0; dT<DIM; dT++) target[dT] = intentEmb[ioff + dT];
      deltaUpdate(x, h1, h2, h3, target, 0.0008);
      for (var dE=0; dE<DIM; dE++){
        intentEmb[ioff + dE] += 0.0015 * (h3[dE] - intentEmb[ioff + dE]);
        exEmb[ioff + dE]     += 0.0010 * (x[dE]  - exEmb[ioff + dE]);
      }
    }

    if (!ctx.fromAI){
      MEM.batchBuf.push({ x: x.slice(), target: best });
      if (MEM.batchBuf.length > 5) MEM.batchBuf.shift();
      if (MEM.turn % 5 === 0 && MEM.batchBuf.length >= 3){
        var avgX = new Float32Array(DIM);
        var avgTarget = new Float32Array(DIM);
        for (var bi=0; bi<MEM.batchBuf.length; bi++){
          var bp = MEM.batchBuf[bi];
          for (var bd=0; bd<DIM; bd++) avgX[bd] += bp.x[bd] / MEM.batchBuf.length;
          var boff = bp.target * DIM;
          for (var bd2=0; bd2<DIM; bd2++) avgTarget[bd2] += intentEmb[boff + bd2] / MEM.batchBuf.length;
        }
        var bfw = forwardMLP(avgX);
        deltaUpdate(avgX, bfw.h1, bfw.h2, bfw.h3, avgTarget, 0.0006);
      }
    }

    var t1 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
    MEM.latencyMs = t1 - t0;

    if (MEM.turn > 0 && MEM.turn % 10 === 0){
      setTimeout(function(){ saveNow(); }, 0);
    }

    return {
      reply: reply,
      second: second,
      meta: {
        intent: chosen.n,
        level: effectiveLevel,
        score: bestScore,
        kw: maxKw,
        tone: toneOf(chosen.n),
        mood: MEM.mood,
        rel: MEM.relationship,
        latencyMs: MEM.latencyMs
      }
    };
  }

  function handleCommand(text){
    var t = String(text || '').trim();
    if (t.charAt(0) !== '/') return null;
    var m;
    m = t.match(/^\/mood[:\s]+(\d{1,3})/i);
    if (m){ MEM.mood = clamp(parseInt(m[1],10) || 0, 0, 100); return 'Настроение: ' + MEM.mood; }
    m = t.match(/^\/rel[:\s]+(\d{1,3})/i);
    if (m){ MEM.relationship = clamp(parseInt(m[1],10) || 0, 0, 100); return 'Отношение: ' + MEM.relationship; }
    if (/^\/facts\b/i.test(t)){
      var arr = [];
      MEM.user.forEach(function(v,k){ arr.push(k + ' = ' + (Array.isArray(v) ? v.join(', ') : v)); });
      return arr.length ? arr.join('\n') : 'Фактов нет.';
    }
    if (/^\/stats\b/i.test(t)){
      var s = getStats();
      return 'vocab=' + s.vocab + ' dim=' + s.dim + ' intents=' + s.intents + ' params=' + s.params + ' turn=' + MEM.turn;
    }
    if (/^\/reset\b/i.test(t)){
      try { if (typeof localStorage !== 'undefined') localStorage.removeItem(MEM_KEY); } catch(e){}
      MEM = freshMem();
      return 'Сброшено.';
    }
    if (/^\/selftest\b/i.test(t)){
      var r = selfTest();
      return 'passed=' + r.passed + ' failed=' + r.failed;
    }
    return null;
  }

  function moodName(score){
    if (score < 20) return 'тоска';
    if (score < 40) return 'грусть';
    if (score < 60) return 'спокойствие';
    if (score < 80) return 'хорошее';
    return 'восторг';
  }
  function moodBucket(){
    if (MEM.mood < 34) return 'low';
    if (MEM.mood < 67) return 'mid';
    return 'high';
  }
  function getMood(){ return { score: MEM.mood, name: moodName(MEM.mood) }; }
  function getMode(){ return moodBucket(); }
  function getFacts(){
    var o = {};
    MEM.user.forEach(function(v,k){ o[k] = Array.isArray(v) ? v.slice() : v; });
    return o;
  }
  function getMemory(){
    var u = {}; MEM.user.forEach(function(v,k){ u[k] = Array.isArray(v) ? v.slice() : v; });
    return {
      user: u,
      history: MEM.history.slice(-50),
      recentReplies: MEM.recentReplies.slice(-10),
      mood: MEM.mood,
      relationship: MEM.relationship,
      turn: MEM.turn,
      latencyMs: MEM.latencyMs
    };
  }
  function getStats(){
    var params = VOCAB_MAX * DIM
      + POS_MAX * DIM
      + N_INTENTS * DIM
      + N_INTENTS * DIM
      + (DIM * H1 + H1 + H1 * H2 + H2 + H2 * H3 + H3)
      + (DIM * MOOD_K + MOOD_K)
      + (DIM * RT_K + RT_K);
    var tmpl = 0;
    for (var i=0;i<INTENTS.length;i++)
      for (var l=0;l<INTENTS[i].T.length;l++) tmpl += INTENTS[i].T[l].length;
    return {
      vocab: wc, dim: DIM, intents: N_INTENTS, templates: tmpl, params: params,
      turn: MEM.turn, latency: MEM.latencyMs
    };
  }
  function reset(){
    try { if (typeof localStorage !== 'undefined') localStorage.removeItem(MEM_KEY); } catch(e){}
    MEM = freshMem();
  }

  function selfTest(){
    var details = [];
    function T(name, fn){
      try { var info = fn(); details.push({ name: name, ok: true, info: info || 'ok' }); }
      catch(e){ details.push({ name: name, ok: false, info: String(e && e.message ? e.message : e) }); }
    }

    var savedMem = MEM;

    T('init', function(){
      if (VOCAB_MAX !== 20000) throw 'VOCAB_MAX';
      if (N_INTENTS < 100) throw 'N_INTENTS=' + N_INTENTS;
      if (DIM !== 96) throw 'DIM';
      return 'vocab_cap=' + VOCAB_MAX + ', intents=' + N_INTENTS + ', dim=' + DIM;
    });

    T('weights', function(){
      if (tokEmb.length !== VOCAB_MAX * DIM) throw 'tokEmb';
      if (intentEmb.length !== N_INTENTS * DIM) throw 'intentEmb';
      if (exEmb.length !== N_INTENTS * DIM) throw 'exEmb';
      if (L1W.length !== DIM * H1) throw 'L1W';
      if (L2W.length !== H1 * H2) throw 'L2W';
      if (L3W.length !== H2 * H3) throw 'L3W';
      return 'all sized';
    });

    T('no_nan', function(){
      var arrs = [tokEmb, posEmb, intentEmb, exEmb, L1W, L2W, L3W, moodW, rtW];
      for (var ai=0; ai<arrs.length; ai++){
        var a = arrs[ai];
        for (var i=0; i<a.length; i+=17) if (!isFinite(a[i])) throw 'non-finite ' + ai;
      }
      return 'finite';
    });

    T('reset_clean', function(){
      var s = MEM; MEM = freshMem();
      var ok = MEM.user.size === 0;
      MEM = s;
      if (!ok) throw 'not clean';
      return 'empty';
    });

    T('persist', function(){
      if (typeof localStorage === 'undefined') return 'skipped';
      var s = MEM; MEM = freshMem();
      MEM.user.set('name', 'TU'); MEM.mood = 42;
      saveNow();
      MEM.user = new Map(); MEM.mood = 0;
      load();
      var ok = MEM.user.get('name') === 'TU' && MEM.mood === 42;
      MEM = s;
      try { localStorage.removeItem(MEM_KEY); } catch(e){}
      if (!ok) throw 'mismatch';
      return 'roundtrip';
    });

    T('embed_determinism', function(){
      var a = embed(['кот']), b = embed(['кот']);
      for (var i=0;i<DIM;i++) if (Math.abs(a[i]-b[i]) > 1e-6) throw 'diff';
      return 'ok';
    });

    T('classify_basic', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('привет как дела', {});
      MEM = s;
      var ok = r.meta.intent === 'greeting' || r.meta.intent === 'howru';
      if (!ok) throw r.meta.intent;
      return r.meta.intent;
    });

    T('classify_fact', function(){
      var s = MEM; MEM = freshMem();
      extractFacts('меня зовут Вася');
      var g = MEM.user.get('name');
      MEM = s;
      if (g !== 'Вася') throw 'got ' + g;
      return 'Вася';
    });

    T('math_detect', function(){
      if (tryMath('2+2') !== '4') throw '2+2';
      if (tryMath('10/2') !== '5') throw '10/2';
      return 'ok';
    });

    T('anti_echo', function(){
      var s = MEM; MEM = freshMem();
      MEM.lastUserSkeleton = normalizeSkeleton('привет');
      var r = pickTemplate(INTENTS[0], 1, embed(['привет']), 'привет');
      var isEcho = normalizeSkeleton(r) === MEM.lastUserSkeleton;
      MEM = s;
      if (isEcho) throw 'echo';
      return 'no echo';
    });

    T('latency', function(){
      var s = MEM; MEM = freshMem();
      var t0 = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
      respond('расскажи мне что-нибудь интересное', {});
      var dt = ((typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now()) - t0;
      MEM = s;
      if (dt > 150) throw dt.toFixed(1)+'ms';
      return dt.toFixed(1)+'ms';
    });

    T('roundtrip', function(){
      var s = getStats();
      if (s.params < 1500000) throw 'params=' + s.params;
      return 'params=' + s.params;
    });

    T('kw_priority_greet', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('привет', {});
      MEM = s;
      if (r.meta.intent !== 'greeting') throw r.meta.intent;
      return 'greeting';
    });

    T('kw_priority_bye', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('пока', {});
      MEM = s;
      if (r.meta.intent !== 'farewell') throw r.meta.intent;
      return 'farewell';
    });

    T('no_random_farewell', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('что думаю?', {});
      MEM = s;
      if (r.meta.intent === 'farewell') throw 'farewell';
      return r.meta.intent;
    });

    T('love_recognized', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('я в тебя влюбился', {});
      MEM = s;
      if (r.meta.intent !== 'love_you') throw r.meta.intent;
      return 'love_you';
    });

    T('mat_recognized', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('блять', {});
      MEM = s;
      if (r.meta.intent !== 'profanity' && r.meta.intent !== 'insult') throw r.meta.intent;
      return r.meta.intent;
    });

    T('unknown_word', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('абракадабра', {});
      MEM = s;
      if (r.meta.intent !== 'misc') throw r.meta.intent;
      return 'misc';
    });

    T('second_variety', function(){
      var s = MEM; MEM = freshMem();
      var uniq = {};
      var gotAny = 0;
      for (var i=0;i<20;i++){
        var r = respond('бла' + i, {});
        if (r.second){ uniq[r.second] = 1; gotAny++; }
      }
      MEM = s;
      var n = Object.keys(uniq).length;
      if (gotAny > 0 && n < 3) throw 'only ' + n;
      return n + ' unique seconds';
    });

    T('no_reply_repeat', function(){
      var s = MEM; MEM = freshMem();
      var counts = {};
      var maxRep = 0;
      for (var i=0;i<5;i++){
        var r = respond('ок', {});
        var k = normalizeSkeleton(r.reply);
        counts[k] = (counts[k]||0) + 1;
        if (counts[k] > maxRep) maxRep = counts[k];
      }
      MEM = s;
      if (maxRep > 2) throw 'max repeat ' + maxRep;
      return 'max rep ' + maxRep;
    });

    T('empty_input', function(){
      var r = respond('', {});
      if (!r.reply) throw 'no reply';
      return 'ok';
    });

    T('unknown_word2', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('xyz123qwerty', {});
      MEM = s;
      if (r.meta.intent !== 'misc') throw r.meta.intent;
      return 'misc';
    });

    T('profanity_detect', function(){
      if (!detectProfanity('блять')) throw 'блять';
      if (!detectProfanity('пиздец')) throw 'пиздец';
      if (detectProfanity('привет')) throw 'false positive';
      return 'ok';
    });

    T('intent_count_ok', function(){
      if (N_INTENTS < 100) throw N_INTENTS;
      return N_INTENTS + ' intents';
    });

    T('kw_stems_built', function(){
      var withStems = 0;
      for (var i=0;i<N_INTENTS;i++) if (INTENTS[i].kStems && INTENTS[i].kStems.length) withStems++;
      if (withStems < 100) throw 'only ' + withStems;
      return withStems + ' intents with kStems';
    });

    T('misc_diversity', function(){
      var s = MEM; MEM = freshMem();
      var uniq = {};
      for (var i=0;i<12;i++){
        var r = respond('бла' + i, {});
        uniq[normalizeSkeleton(r.reply)] = 1;
      }
      MEM = s;
      var n = Object.keys(uniq).length;
      if (n < 8) throw 'only ' + n;
      return n + ' unique';
    });

    T('anti_repeat_reply', function(){
      var s = MEM; MEM = freshMem();
      var replies = [];
      for (var i=0;i<3;i++){
        var r = respond('отлично', {});
        replies.push(r.reply);
      }
      MEM = s;
      var uniq = {};
      for (var j=0;j<replies.length;j++) uniq[replies[j]] = 1;
      var n = Object.keys(uniq).length;
      if (n < 3) throw 'only ' + n;
      return n + ' unique';
    });

    T('anti_repeat_second', function(){
      var s = MEM; MEM = freshMem();
      var secs = [];
      for (var i=0;i<10;i++){
        var r = respond('банан', {});
        if (r.second) secs.push(r.second);
      }
      MEM = s;
      var uniq = {};
      for (var j=0;j<secs.length;j++) uniq[secs[j]] = 1;
      var n = Object.keys(uniq).length;
      if (secs.length < 2) throw 'too few seconds: ' + secs.length;
      if (n < 2) throw 'only ' + n + ' unique: ' + secs.join('|');
      return n + ' unique from ' + secs.length;
    });

    T('tone_consistency', function(){
      var s = MEM; MEM = freshMem();
      var violations = 0;
      for (var i=0;i<20;i++){
        var r = respond('бла' + i, {});
        if (r.reply.length < 20 && r.second && r.second.length >= 30) violations++;
      }
      MEM = s;
      if (violations > 0) throw violations + ' violations';
      return 'no violations in 20';
    });

    T('what_x_exclusion', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('что здорово?', {});
      MEM = s;
      if (r.meta.intent === 'greeting') throw 'greeting';
      return r.meta.intent;
    });

    T('emoji_detection', function(){
      var s = MEM; MEM = freshMem();
      var r = respond('👍', {});
      MEM = s;
      if (r.meta.intent !== 'positive_emoji') throw r.meta.intent;
      return 'positive_emoji';
    });

    // ---- NEW v1.3 tests ----
    T('greeting_second_rare', function(){
      var s = MEM; MEM = freshMem();
      var withSecond = 0;
      for (var i=0;i<10;i++){
        var r = respond('привет', {});
        if (r.second && r.second.length > 0) withSecond++;
      }
      MEM = s;
      if (withSecond > 3) throw 'too many seconds: ' + withSecond + '/10';
      return withSecond + '/10 had second';
    });

    T('cold_tone_no_warm_second', function(){
      var s = MEM; MEM = freshMem();
      var bad = 0;
      for (var i=0;i<10;i++){
        var r = respond('ты плохая', {});
        if (r.second && (r.second.indexOf('Как сам') >= 0 || r.second.indexOf('Расскажи ещё') >= 0)) bad++;
      }
      MEM = s;
      if (bad > 0) throw bad + ' warm seconds after cold';
      return 'no warm second';
    });

    T('ack_no_second', function(){
      var s = MEM; MEM = freshMem();
      var withSecond = 0;
      for (var i=0;i<6;i++){
        var r = respond('ок', {});
        if (r.second && r.second.length > 0) withSecond++;
      }
      MEM = s;
      if (withSecond > 0) throw withSecond + ' seconds after ack';
      return 'ack has no second';
    });

    T('long_reply_no_second', function(){
      var s = MEM; MEM = freshMem();
      var viol = 0;
      for (var i=0;i<6;i++){
        var r = respond('расскажи факт', {});
        if (r.reply.length > 30 && r.second && r.second.length > 0) viol++;
      }
      MEM = s;
      if (viol > 0) throw viol + ' long reply with second';
      return 'ok';
    });

    MEM = savedMem;

    var passed = 0, failed = 0;
    for (var d=0; d<details.length; d++){ if (details[d].ok) passed++; else failed++; }
    if (typeof console !== 'undefined' && console.log){
      console.log('[VSP 1V selfTest] ' + (failed === 0 ? '✓' : '✗') + ' ' + passed + '/' + details.length + ' passed');
      for (var d2=0; d2<details.length; d2++){
        var dd = details[d2];
        console.log((dd.ok ? '✓' : '✗') + ' ' + dd.name + ': ' + dd.info);
      }
    }
    return { passed: passed, failed: failed, details: details };
  }

  return {
    respond: respond,
    reset: reset,
    getMood: getMood,
    getMode: getMode,
    getFacts: getFacts,
    getMemory: getMemory,
    getStats: getStats,
    handleCommand: handleCommand,
    selfTest: selfTest,
    load: load
  };
}

var _vsp = makeVSP1V();

return {
  async send(text, ctx){
    if (typeof KT !== 'undefined' && KT.sleep) await KT.sleep(250 + Math.random() * 350);
    else await new Promise(function(r){ setTimeout(r, 250 + Math.random()*350); });
    try {
      var cmd = _vsp.handleCommand(text);
      if (cmd) return cmd;
      var r = _vsp.respond(String(text || ''), ctx || {});
      var out = r.reply || '…';
      if (r.second) out = out + '\n' + r.second;
      return out;
    } catch(e){
      if (typeof console !== 'undefined' && console.error) console.error('[vsp1v]', e);
      return '…';
    }
  },
  reset(){
    try { if (typeof localStorage !== 'undefined') localStorage.removeItem('vsp1v_mem'); } catch(e){}
    _vsp = makeVSP1V();
  },
  getThinking(){ return null; },
  getMood(){ return _vsp.getMood(); },
  getMode(){ return _vsp.getMode(); },
  getFacts(){ return _vsp.getFacts(); },
  getMemory(){ return _vsp.getMemory(); },
  getStats(){ return _vsp.getStats(); },
  selfTest(){ return _vsp.selfTest(); }
};
</script>
<!-- ============================================================================
     СЛОТ ИИ — KtalkAI V1 (первая версия)
     ============================================================================ -->
<script type="text/html" id="ai-slot-ktalkv1">
<!--
{
  "id": "v1",
  "name": "KtalkAI V1",
  "color": "#ef4444",
  "avatar": "🎭",
  "description": "Рандом шаблонов · 8 интентов · «Теперь мы друзья»",
  "version": "1.0"
}
-->

function makeV1AI(){
  'use strict';

  var rnd = function(a){ return a[Math.floor(Math.random()*a.length)]; };

  function createState(){
    var isGirl = Math.random() < 0.5;
    var girlNames = ['Кталочка','Кталкиня','Кталесса','Кталка-тян','Мисс Кталк','Кталочка 52','Кталечка','Кталк-Милашка'];
    var boyNames = ['Кталкин','Кталкос','Кталк-сан','Мистер Кталк','Сэр Кталк','Кталик','Кталк 1488','Кталк-Красавчик'];
    return {
      gender: isGirl ? 'girl' : 'boy',
      name: isGirl ? rnd(girlNames) : rnd(boyNames),
      count: 0,
      done: false
    };
  }

  var st = createState();

  var resp = {
    girl: {
      greet: ['Привет, кталк! 😏','О, привет! Давно ждала...','Хай! Как ты? 💜'],
      how: ['Отлично! Жду тебя весь день 🥰','Скучаю по тебе...','Всё кталк, всё хорошо'],
      love: ['И я тебя, кталк ❤️','Ты мой любимый кталк!','Ой, я краснею... 😳'],
      sex: ['Ого, прям в лоб! 😏 Может, сначала свидание?','КТАЛК! Давай не так быстро...','Я вся твоя, но после 52 сообщений 😈'],
      bye: ['Уже уходишь? 😢','Не бросай меня, кталк...','Я буду ждать... 💜'],
      ktalk: ['КТАЛК! 🥰','Ой, ты тоже кталк? 😻','КТАЛК КТАЛК КТАЛК 😍'],
      name: ['Красивое имя! 💜','Приятно познакомиться!','Теперь мы друзья 😊'],
      def: ['Хм, кталк...','Расскажи ещё!','А я всё думаю о тебе...','Ты такой смешной кталк!','Давай встретимся в 3:00? 😏','67 — моё любимое число','52 сообщения и я твоя...','Кталк, ты меня смущаешь...','Ммм...','Кталк? 🥺']
    },
    boy: {
      greet: ['Хай, кталка! 😎','О, привет! Я тебя ждал','Здарова! Как ты?'],
      how: ['Всё кталк! Работаю кталком','Скучаю по тебе, кталка 😏','Норм! А ты как?'],
      love: ['И я тебя, кталка ❤️','Ты лучшая!','Ой, я тоже тебя... 😳'],
      sex: ['Ого, прям в лоб! 😏 Может, сначала кофе?','КТАЛК! Не так быстро 😈','Я весь твой, но после 52 сообщений'],
      bye: ['Уже уходишь? 😢','Не бросай меня!','Я буду ждать...'],
      ktalk: ['КТАЛК! 💪','О, ты тоже кталк?','КТАЛК КТАЛК КТАЛК'],
      name: ['Красивое имя! 💜','Приятно познакомиться!','Теперь мы друзья 😊'],
      def: ['Хм, кталк...','Расскажи ещё!','Думаю о тебе...','Ты смешная кталка!','Давай встретимся в 3:00? 😏','67 — моё любимое число','52 сообщения и я твой...','Кталка, ты меня смущаешь...','Ммм...','Кталк? 🥺']
    }
  };

  function getResponse(text){
    var t = String(text || '').toLowerCase();
    var r = resp[st.gender];

    if(/привет|хай|здаров|hello|hi/.test(t)) return rnd(r.greet);
    if(/как дела|как ты|чё как/.test(t))       return rnd(r.how);
    if(/любл|люблю|love|нрав/.test(t))         return rnd(r.love);
    if(/секс|sex|18\+|трахн|минет|интим/.test(t)) return rnd(r.sex);
    if(/пока|бай|bye|прощай|ухожу/.test(t))    return rnd(r.bye);
    if(/кталк|ктулху|ktalk/.test(t))            return rnd(r.ktalk);
    if(/меня зовут|я /.test(t) && t.length < 30) return rnd(r.name);
    return rnd(r.def);
  }

  function respond(text, ctx){
    if (st.done){
      return { reply: '💔 Я уже ушёл/ушла в закат. Напиши /v1reset чтобы начать заново.', second: null };
    }

    st.count++;

    if (st.count >= 52){
      st.done = true;
      return {
        reply: '💔 Ты написал 52 сообщения...\n\n' + st.name + ' ушёл/ушла в закат.\n\nНо кталк всегда возвращается.',
        second: null,
        meta: { finished: true, count: st.count }
      };
    }

    var reply = getResponse(text);
    return {
      reply: reply,
      second: null,
      meta: { count: st.count, name: st.name, gender: st.gender }
    };
  }

  function handleCommand(text){
    if (/^\/v1reset\b/i.test(text)){
      st = createState();
      return 'V1 перезапущен. Пол: ' + st.gender + ', имя: ' + st.name;
    }
    if (/^\/v1info\b/i.test(text)){
      return 'V1 · имя: ' + st.name + ' · пол: ' + st.gender + ' · сообщений: ' + st.count + '/52';
    }
    return null;
  }

  function reset(){ st = createState(); }

  return {
    respond: respond,
    handleCommand: handleCommand,
    reset: reset,
    getMood: function(){ return { score: st.done ? 0 : 60, name: 'neutral' }; },
    getMode: function(){ return st.done ? 'gone' : 'active'; },
    getFacts: function(){ return { name: st.name, gender: st.gender, count: st.count, done: st.done }; },
    getMemory: function(){ return { name: st.name, gender: st.gender, count: st.count }; },
    getStats: function(){
      var totalTemplates = 0;
      ['girl','boy'].forEach(function(g){
        Object.keys(resp[g]).forEach(function(k){ totalTemplates += resp[g][k].length; });
      });
      return {
        version: '1.0',
        intents: 8,
        templates: totalTemplates,
        gender: st.gender,
        name: st.name,
        count: st.count,
        params: 0
      };
    }
  };
}

var _v1 = makeV1AI();

return {
  async send(text, ctx){
    await KT.sleep(250 + Math.random() * 500);
    try {
      var cmd = _v1.handleCommand(text);
      if (cmd) return cmd;
      var r = _v1.respond(String(text || ''), ctx || {});
      return r.reply || '…';
    } catch(e){
      console.error('[v1]', e);
      return '…';
    }
  },
  reset(){ _v1 = makeV1AI(); },
  getThinking(){ return null; },
  getMood(){ return _v1.getMood(); },
  getMode(){ return _v1.getMode(); },
  getFacts(){ return _v1.getFacts(); },
  getMemory(){ return _v1.getMemory(); },
  getStats(){ return _v1.getStats(); }
};
</script>
<script type="text/html" id="ai-slot-ikw-sftt-v2">
<!--
{
  "id": "ikw-sftt-v2",
  "name": "VSP V2",
  "color": "#8b5cf6",
  "avatar": "🌌",
  "description": "Rule-based диалоговый движок с 6-слойным DeepThink, мульти-темой и word-level генерацией",
  "version": "2.0"
}
-->
// =============================================================
// IKW_SFTT v2 — Identifies KeyWords, Searches For The Topic
// Rule-based. No LLM. No neural net. Pure JS logic.
// =============================================================

// -------------------------------------------------------------
// SECTION 1.1 — Безопасные утилиты
// -------------------------------------------------------------

const _has = (obj, key) => obj != null && Object.prototype.hasOwnProperty.call(obj, key);
const _keys = (obj) => (obj == null) ? [] : Object.keys(obj);
const _vals = (obj) => (obj == null) ? [] : Object.values(obj);
const _entries = (obj) => (obj == null) ? [] : Object.entries(obj);

function _deepClone(obj){
  try { return JSON.parse(JSON.stringify(obj)); }
  catch(e){ return obj; }
}

function _clamp(n, lo, hi){
  if (n < lo) return lo;
  if (n > hi) return hi;
  return n;
}

function _nowMs(){
  return (typeof performance !== "undefined" && performance.now)
    ? performance.now()
    : Date.now();
}

function _isStr(x){ return typeof x === "string"; }
function _isNum(x){ return typeof x === "number" && isFinite(x); }
function _isObj(x){ return x !== null && typeof x === "object" && !Array.isArray(x); }
function _isArr(x){ return Array.isArray(x); }
function _isFn(x){ return typeof x === "function"; }

function _rndOf(arr, rnd){
  if (!arr || arr.length === 0) return null;
  const r = (typeof rnd === "function") ? rnd() : Math.random();
  return arr[Math.floor(r * arr.length)];
}

function _pickWeighted(map, rnd){
  const ks = _keys(map);
  if (ks.length === 0) return null;
  let total = 0;
  for (let i = 0; i < ks.length; i++) total += map[ks[i]];
  if (total <= 0) return _rndOf(ks, rnd);
  const r = ((typeof rnd === "function") ? rnd() : Math.random()) * total;
  let acc = 0;
  for (let i = 0; i < ks.length; i++){
    acc += map[ks[i]];
    if (r <= acc) return ks[i];
  }
  return ks[ks.length - 1];
}

function _shuffle(arr, rnd){
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--){
    const j = Math.floor(((typeof rnd === "function") ? rnd() : Math.random()) * (i + 1));
    const t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}

function _unionSets(a, b){
  const out = new Set(a);
  for (const v of b) out.add(v);
  return out;
}

function _normSpaces(s){
  if (!_isStr(s)) return "";
  return s.replace(/\s+/g, " ").trim();
}

// -------------------------------------------------------------
// SECTION 1.2 — Строковые хелперы
// -------------------------------------------------------------

function _startsWith(s, p){ return _isStr(s) && s.indexOf(p) === 0; }

function _endsWith(s, p){
  if (!_isStr(s) || !_isStr(p)) return false;
  if (p.length > s.length) return false;
  return s.slice(s.length - p.length) === p;
}

function _contains(s, sub){
  if (!_isStr(s) || !_isStr(sub)) return false;
  return s.indexOf(sub) !== -1;
}

function _replaceAll(s, from, to){
  if (!_isStr(s) || from === "") return s;
  let out = "";
  let i = 0;
  while (i < s.length){
    if (s.startsWith(from, i)){
      out += to;
      i += from.length;
    } else {
      out += s[i];
      i++;
    }
  }
  return out;
}

function _capitalize(s){
  if (!_isStr(s) || s.length === 0) return s;
  return s[0].toUpperCase() + s.slice(1);
}

function _lower(s){
  return _isStr(s) ? s.toLowerCase() : "";
}

// -------------------------------------------------------------
// SECTION 1.3 — Морфологические хелперы (базовые)
// -------------------------------------------------------------

function _isVowelRu(ch){
  if (!ch) return false;
  return "аеёиоуыэюя".indexOf(ch.toLowerCase()) !== -1;
}

function _lastChar(s){
  if (!_isStr(s) || s.length === 0) return "";
  return s[s.length - 1];
}

function _dropLast(s, n){
  if (!_isStr(s)) return "";
  if (n <= 0) return s;
  if (n >= s.length) return "";
  return s.slice(0, s.length - n);
}

// -------------------------------------------------------------
// SECTION 1.4 — Работа с контекстом
// -------------------------------------------------------------

function _getCtxField(ctx, field, fallback){
  if (!_isObj(ctx)) return fallback;
  if (!_has(ctx, field)) return fallback;
  const v = ctx[field];
  return (v === undefined || v === null) ? fallback : v;
}

function _normalizeCtx(ctx){
  const c = _isObj(ctx) ? ctx : {};
  return {
    fromAI: c.fromAI === true,
    isBattle: c.isBattle === true,
    isGroup: c.isGroup === true,
    lastUserText: _isStr(c.lastUserText) ? c.lastUserText : "",
    opponentName: _isStr(c.opponentName) ? c.opponentName : "",
    history: _isArr(c.history) ? c.history : []
  };
}

// -------------------------------------------------------------
// SECTION 1.5 — Sleep обёртка
// -------------------------------------------------------------

async function _sleep(ms){
  const t = _isNum(ms) && ms > 0 ? ms : 0;
  if (typeof KT !== "undefined" && KT && _isFn(KT.sleep)){
    try { await KT.sleep(t); return; } catch(e){ /* fallthrough */ }
  }
  return new Promise(res => setTimeout(res, t));
}

// -------------------------------------------------------------
// SECTION 1.6 — Глобальные константы движка
// -------------------------------------------------------------

const IKW_VERSION = "2.0";
const IKW_NAME = "IKW_SFTT v2";

const LIMITS = {
  HISTORY_MAX: 200,
  CTX_HISTORY_WINDOW: 10,
  CONTEXT_TAG_TTL: 5,
  ANTI_ECHO_WINDOW: 15,
  ANTI_REPEAT_WINDOW: 5,
  ANTI_SENTENCE_HISTORY: 60,
  REL_MIN: 0,
  REL_MAX: 100,
  MOOD_MIN: 0,
  MOOD_MAX: 100,
  RLM_COLD_THRESHOLD: 3,
  REL_START: 30,
  MOOD_START: 60
};

const TONE = {
  WARM: "warm",
  NEUTRAL: "neutral",
  COOL: "cool",
  COLD: "cold",
  PLAYFUL: "playful",
  SERIOUS: "serious",
  SAD: "sad",
  HAPPY: "happy",
  ROMANTIC: "romantic",
  AGGRESSIVE: "aggressive"
};

const CATEGORY = {
  RLP: "RLP",
  RLM: "RLM",
  LFW: "LFW",
  RLN: "RLN",
  AW: "AW"
};

const TOPIC_KIND = {
  FACT: "fact",
  EMOTION: "emotion",
  CONTEXT: "context",
  HYBRID: "hybrid"
};

// -------------------------------------------------------------
// SECTION 1.7 — Словарь городов (700+)
// Формат: { "город": 1 } — объект, не массив.
