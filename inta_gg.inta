  // Тело и внешность
  "тело": 3, "телеса": 2, "фигура": 2, "фигурка": 3,
  "губы": 3, "губки": 3, "глаза": 2, "глазки": 3,
  "волосы": 2, "волосики": 3, "шевелюра": 2,
  "кожа": 2, "кожица": 2,
  "руки": 2, "ручки": 3, "ладони": 2, "ладошки": 3,
  "ножки": 3, "ноги": 2,
  "плечи": 2, "плечики": 2,
  "шея": 2, "грудь": 3, "грудка": 3,
  "попка": 3, "попа": 3, "попочка": 3,
  "талия": 2, "талийка": 2,
  "красотка": 3, "красавчик": 3, "красавец": 3, "красавица": 3,
  // Секс-намёки (мягкие)
  "сексуальный": 3, "сексуальная": 3, "сексуальное": 3,
  "секси": 3, "шикарно": 2,
  "страстный": 3, "страстная": 3, "страстное": 3,
  "желанный": 3, "желанная": 3, "желанное": 3,
  "привлекательный": 2, "привлекательная": 2,
  "привлекать": 2,
  "голый": 2, "голая": 2, "голое": 2,
  "раздетый": 2, "раздевать": 2,
  "интимный": 3, "интимная": 3, "интимное": 3,
  "ласкать": 3, "ласка": 2, "ласки": 3,
  "нежность": 2, "нежничать": 2,
  "смущать": 2, "смущение": 2, "смущаться": 2,
  "краснеть": 2, "покраснеть": 2,
  // Внешние признаки
  "улыбка": 2, "улыбочка": 2, "улыбаться": 2,
  "взгляд": 2, "взгляды": 2,
  "обаяние": 2, "обаяшка": 3,
  "шарм": 2, "шармик": 2
};

// -------------------------------------------------------------
// SECTION 2.7 — Категория RLN (relationship neutral)
// Быт, факты, вопросы, повседневность.
// -------------------------------------------------------------

const RLN_WORDS = {
  // Быт
  "дом": 1, "квартира": 1, "комната": 1, "кухня": 1,
  "стол": 1, "стул": 1, "диван": 1, "кровать": 1,
  "шкаф": 1, "полка": 1, "дверь": 1, "окно": 1,
  "лампа": 1, "свет": 1, "вода": 1, "газ": 1,
  "еда": 1, "обед": 1, "ужин": 1, "завтрак": 1, "перекус": 1,
  "чай": 1, "кофе": 1, "суп": 1, "каша": 1, "хлеб": 1,
  "молоко": 1, "сыр": 1, "мясо": 1, "рыба": 1, "овощ": 1,
  "фрукт": 1, "яблоко": 1, "банан": 1, "апельсин": 1,
  "картошка": 1, "картофель": 1, "макароны": 1, "рис": 1,
  // Работа
  "работа": 1, "офис": 1, "начальник": 1, "коллега": 1,
  "зарплата": 1, "проект": 1, "задача": 1, "встреча": 1,
  "планёрка": 1, "планерка": 1, "отчёт": 1, "отчет": 1,
  "документ": 1, "бумага": 1, "клиент": 1, "партнёр": 1,
  "партнер": 1, "контракт": 1, "сделка": 1, "успех": 1,
  "провал": 1, "карьера": 1, "должность": 1, "отпуск": 1,
  "увольнение": 1, "собеседование": 1, "резюме": 1,
  // Учеба
  "школа": 1, "универ": 1, "институт": 1, "колледж": 1,
  "урок": 1, "лекция": 1, "семинар": 1, "экзамен": 1,
  "зачёт": 1, "зачет": 1, "сессия": 1, "диплом": 1,
  "предмет": 1, "математика": 1, "физика": 1, "химия": 1,
  "история": 1, "литература": 1, "язык": 1, "английский": 1,
  // Транспорт
  "машина": 1, "авто": 1, "автомобиль": 1, "автобус": 1,
  "троллейбус": 1, "трамвай": 1, "метро": 1, "поезд": 1,
  "электричка": 1, "самолёт": 1, "самолет": 1, "вертолёт": 1,
  "самокат": 1, "велосипед": 1, "мотоцикл": 1,
  "дорога": 1, "трасса": 1, "пробка": 1, "билет": 1,
  // Природа
  "погода": 1, "солнце": 1, "дождь": 1, "снег": 1, "ветер": 1,
  "гроза": 1, "туман": 1, "жара": 1, "холод": 1, "мороз": 1,
  "весна": 1, "лето": 1, "осень": 1, "зима": 1,
  "лес": 1, "поле": 1, "река": 1, "море": 1, "озеро": 1,
  "гора": 1, "холм": 1, "пляж": 1, "парк": 1, "сад": 1,
  "цветок": 1, "дерево": 1, "трава": 1, "лист": 1,
  // Время
  "время": 1, "час": 1, "минута": 1, "секунда": 1, "день": 1,
  "неделя": 1, "месяц": 1, "год": 1, "век": 1,
  "утро": 1, "день": 1, "вечер": 1, "ночь": 1,
  "сегодня": 1, "завтра": 1, "вчера": 1, "послезавтра": 1,
  "понедельник": 1, "вторник": 1, "среда": 1, "четверг": 1,
  "пятница": 1, "суббота": 1, "воскресенье": 1,
  // Деньги
  "деньги": 1, "рубль": 1, "доллар": 1, "евро": 1, "копейка": 1,
  "цена": 1, "стоимость": 1, "счёт": 1, "счет": 1,
  "банк": 1, "карта": 1, "кредит": 1, "долг": 1,
  "зарплата": 1, "премия": 1, "бонус": 1,
  // Общие факты
  "факт": 1, "правда": 1, "ложь": 1, "обман": 1,
  "информация": 1, "новость": 1, "событие": 1, "случай": 1,
  "вопрос": 1, "ответ": 1, "тема": 1, "разговор": 1,
  "беседа": 1, "диалог": 1, "монолог": 1, "речь": 1,
  "слово": 1, "буква": 1, "текст": 1, "книга": 1,
  "стих": 1, "стихотворение": 1, "роман": 1, "рассказ": 1,
  "песня": 1, "музыка": 1, "фильм": 1, "сериал": 1,
  "игра": 1, "игрушка": 1, "компьютер": 1, "телефон": 1
};

// -------------------------------------------------------------
// SECTION 2.8 — Классификатор токенов
// -------------------------------------------------------------

function classifyToken(token){
  if (!token || !token.isWord){
    return {
      token: token,
      category: CATEGORY.AW,
      weight: 0,
      isAIObject: false,
      isSelfObject: false,
      isWeObject: false,
      isQuestion: false,
      isYes: false,
      isNo: false
    };
  }
  const w = token.lower;
  const wNoE = w.replace(/ё/g, "е");
  const s = token.stem;

  const isQ = QUESTION_WORDS[w] === 1;
  const isY = YES_WORDS[w] === 1;
  const isN = NO_WORDS[w] === 1;
  const isAI = isAIPronoun(w);
  const isSelf = isSelfPronoun(w);
  const isWe = isWePronoun(w);

  let category = CATEGORY.AW;
  let weight = 1;

  // Приоритет: RLM > RLP > LFW > RLN > AW
  // Но AI-объект может менять классификацию LFW на compliment_ai
  if (RLM_WORDS[w] !== undefined){
    category = CATEGORY.RLM;
    weight = RLM_WORDS[w];
  } else if (RLM_WORDS[wNoE] !== undefined){
    category = CATEGORY.RLM;
    weight = RLM_WORDS[wNoE];
  } else if (RLP_WORDS[w] !== undefined){
    category = CATEGORY.RLP;
    weight = RLP_WORDS[w];
  } else if (RLP_WORDS[wNoE] !== undefined){
    category = CATEGORY.RLP;
    weight = RLP_WORDS[wNoE];
  } else if (LFW_WORDS[w] !== undefined){
    category = CATEGORY.LFW;
    weight = LFW_WORDS[w];
  } else if (LFW_WORDS[wNoE] !== undefined){
    category = CATEGORY.LFW;
    weight = LFW_WORDS[wNoE];
  } else if (RLN_WORDS[w] !== undefined){
    category = CATEGORY.RLN;
    weight = RLN_WORDS[w];
  } else if (RLN_WORDS[wNoE] !== undefined){
    category = CATEGORY.RLN;
    weight = RLN_WORDS[wNoE];
  }

  // Проверка: "люблю" — базовый RLP, но если рядом AI_PRONOUN,
  // то intent = compliment_ai и вес усиливается
  let aiIntent = null;
  if ((w === "люблю" || w === "любить" || w === "обожаю" ||
       w === "нравишься" || w === "ненавижу" || w === "презираю")
      && isAI){
    aiIntent = "compliment_ai";
  }

  return {
    token: token,
    category: category,
    weight: weight,
    isAIObject: isAI,
    isSelfObject: isSelf,
    isWeObject: isWe,
    isQuestion: isQ,
    isYes: isY,
    isNo: isN,
    aiIntent: aiIntent,
    stem: s
  };
}

// -------------------------------------------------------------
// SECTION 2.9 — Анализ всего текста
// Собирает токены, категории, вопросы, объекты AI/self/we
// -------------------------------------------------------------

function analyzeTokens(tokens){
  const byCategory = {
    RLP: [],
    RLM: [],
    LFW: [],
    RLN: [],
    AW: []
  };
  const aiObjects = [];
  const selfObjects = [];
  const weObjects = [];
  const questions = [];
  const yesTokens = [];
  const noTokens = [];
  const aiIntents = [];

  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const c = classifyToken(t);
    byCategory[c.category].push(c);
    if (c.isAIObject) aiObjects.push(c);
    if (c.isSelfObject) selfObjects.push(c);
    if (c.isWeObject) weObjects.push(c);
    if (c.isQuestion) questions.push(c);
    if (c.isYes) yesTokens.push(c);
    if (c.isNo) noTokens.push(c);
    if (c.aiIntent) aiIntents.push({ token: c, intent: c.aiIntent });
  }

  // Спец-логика: "люблю тебя" → LFW-слово + AI_PRONOUN рядом
  // Проверяем окно ±2 слова
  const emotionVerbs = {
    "люблю": 1, "любить": 1, "обожаю": 1, "обожать": 1,
    "ненавижу": 1, "ненавидеть": 1, "презираю": 1, "презирать": 1,
    "нравишься": 1, "нравится": 1
  };

  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    if (emotionVerbs[t.lower] !== 1) continue;
    let hasAI = false;
    let hasSelf = false;
    for (let j = Math.max(0, i - 2); j <= Math.min(tokens.length - 1, i + 2); j++){
      const u = tokens[j];
      if (!u.isWord) continue;
      if (isAIPronoun(u.lower)) hasAI = true;
      if (isSelfPronoun(u.lower)) hasSelf = true;
    }
    if (hasAI){
      // emotion aimed at AI
      const existing = aiIntents.find(x => x.token.token === t);
      if (!existing){
        aiIntents.push({
          token: { token: t, category: CATEGORY.RLP, weight: 4, isAIObject: true },
          intent: "compliment_ai"
        });
      }
    }
  }

  return {
    tokens: tokens,
    byCategory: byCategory,
    aiObjects: aiObjects,
    selfObjects: selfObjects,
    weObjects: weObjects,
    questions: questions,
    yesTokens: yesTokens,
    noTokens: noTokens,
    aiIntents: aiIntents,
    counts: {
      RLP: byCategory.RLP.length,
      RLM: byCategory.RLM.length,
      LFW: byCategory.LFW.length,
      RLN: byCategory.RLN.length,
      AW: byCategory.AW.length
    }
  };
}

function analyzeText(text){
  const tokens = tokenizeRu(text);
  return analyzeTokens(tokens);
}

// -------------------------------------------------------------
// SECTION 2.10 — Определение доминирующей категории
// -------------------------------------------------------------

function dominantCategory(analysis){
  if (!analysis) return CATEGORY.AW;
  const counts = analysis.counts;
  // Приоритет: RLM > RLP > LFW > RLN > AW
  let best = CATEGORY.AW;
  let bestScore = 0;

  const score = (cat) => {
    const arr = analysis.byCategory[cat];
    let s = 0;
    for (let i = 0; i < arr.length; i++) s += arr[i].weight;
    return s;
  };

  const sRLM = score(CATEGORY.RLM);
  const sRLP = score(CATEGORY.RLP);
  const sLFW = score(CATEGORY.LFW);
  const sRLN = score(CATEGORY.RLN);

  if (sRLM > 0 && sRLM >= sRLP && sRLM >= sLFW){
    best = CATEGORY.RLM; bestScore = sRLM;
  } else if (sRLP > 0 && sRLP >= sLFW && sRLP >= sRLN){
    best = CATEGORY.RLP; bestScore = sRLP;
  } else if (sLFW > 0 && sLFW >= sRLN){
    best = CATEGORY.LFW; bestScore = sLFW;
  } else if (sRLN > 0){
    best = CATEGORY.RLN; bestScore = sRLN;
  } else {
    best = CATEGORY.AW; bestScore = 0;
  }

  return best;
}

function rlmScore(analysis){
  if (!analysis) return 0;
  const arr = analysis.byCategory.RLM;
  let s = 0;
  for (let i = 0; i < arr.length; i++) s += arr[i].weight;
  return s;
}

function rlpScore(analysis){
  if (!analysis) return 0;
  const arr = analysis.byCategory.RLP;
  let s = 0;
  for (let i = 0; i < arr.length; i++) s += arr[i].weight;
  return s;
}

function lfwScore(analysis){
  if (!analysis) return 0;
  const arr = analysis.byCategory.LFW;
  let s = 0;
  for (let i = 0; i < arr.length; i++) s += arr[i].weight;
  return s;
}

// -------------------------------------------------------------
// SECTION 2.11 — Спец-детекторы: insult_ai, compliment_ai, love_ai
// -------------------------------------------------------------

function detectInsultToAI(analysis){
  if (!analysis) return false;
  const rlm = analysis.byCategory.RLM;
  for (let i = 0; i < rlm.length; i++){
    const t = rlm[i];
    // Ищем AI-местоимение рядом
    const idx = t.token.idx;
    for (let j = 0; j < analysis.tokens.length; j++){
      const u = analysis.tokens[j];
      if (!u.isWord) continue;
      if (Math.abs(u.idx - idx) <= 2 && isAIPronoun(u.lower)){
        return true;
      }
    }
  }
  return false;
}

function detectComplimentToAI(analysis){
  if (!analysis) return false;
  if (analysis.aiIntents && analysis.aiIntents.length > 0){
    for (let i = 0; i < analysis.aiIntents.length; i++){
      if (analysis.aiIntents[i].intent === "compliment_ai") return true;
    }
  }
  const rlp = analysis.byCategory.RLP;
  for (let i = 0; i < rlp.length; i++){
    const t = rlp[i];
    const idx = t.token.idx;
    for (let j = 0; j < analysis.tokens.length; j++){
      const u = analysis.tokens[j];
      if (!u.isWord) continue;
      if (Math.abs(u.idx - idx) <= 2 && isAIPronoun(u.lower)){
        return true;
      }
    }
  }
  return false;
}

function detectLoveToAI(analysis){
  if (!analysis) return false;
  const loveVerbs = {
    "люблю": 1, "любить": 1, "обожаю": 1, "обожать": 1,
    "влюблен": 1, "влюблён": 1, "влюблена": 1
  };
  for (let i = 0; i < analysis.tokens.length; i++){
    const t = analysis.tokens[i];
    if (!t.isWord) continue;
    if (loveVerbs[t.lower] !== 1) continue;
    for (let j = 0; j < analysis.tokens.length; j++){
      const u = analysis.tokens[j];
      if (!u.isWord) continue;
      if (Math.abs(u.idx - t.idx) <= 2 && isAIPronoun(u.lower)){
        return true;
      }
    }
  }
  return false;
}

function detectHateToAI(analysis){
  if (!analysis) return false;
  const hateVerbs = {
    "ненавижу": 1, "ненавидеть": 1, "презираю": 1, "презирать": 1
  };
  for (let i = 0; i < analysis.tokens.length; i++){
    const t = analysis.tokens[i];
    if (!t.isWord) continue;
    if (hateVerbs[t.lower] !== 1) continue;
    for (let j = 0; j < analysis.tokens.length; j++){
      const u = analysis.tokens[j];
      if (!u.isWord) continue;
      if (Math.abs(u.idx - t.idx) <= 2 && isAIPronoun(u.lower)){
        return true;
      }
    }
  }
  return false;
}

// -------------------------------------------------------------
// SECTION 2.12 — Детектор вопроса
// -------------------------------------------------------------

function isQuestionText(text, tokens, analysis){
  if (_isStr(text) && text.indexOf("?") !== -1) return true;
  if (!tokens) tokens = tokenizeRu(text);
  if (!analysis) analysis = analyzeTokens(tokens);
  if (analysis.questions.length > 0) return true;
  // Вопросительное слово в начале
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    if (QUESTION_WORDS[t.lower] === 1) return true;
    break;
  }
  return false;
}

// -------------------------------------------------------------
// SECTION 2.13 — Детектор да/нет
// -------------------------------------------------------------

function detectYesNo(analysis){
  if (!analysis) return "none";
  const yes = analysis.yesTokens.length;
  const no = analysis.noTokens.length;
  if (yes > 0 && yes >= no) return "yes";
  if (no > 0 && no > yes) return "no";
  return "none";
}

// -------------------------------------------------------------
// SECTION 2.14 — Извлечение знаков препинания
// -------------------------------------------------------------

function extractPunct(tokens){
  const out = [];
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (t.isPunct) out.push(t.form);
  }
  return out;
}

function countExclamations(text){
  if (!_isStr(text)) return 0;
  let n = 0;
  for (let i = 0; i < text.length; i++){
    if (text[i] === "!") n++;
  }
  return n;
}

function countQuestions(text){
  if (!_isStr(text)) return 0;
  let n = 0;
  for (let i = 0; i < text.length; i++){
    if (text[i] === "?") n++;
  }
  return n;
}

function isAllCaps(text){
  if (!_isStr(text)) return false;
  let letters = 0;
  let upper = 0;
  for (let i = 0; i < text.length; i++){
    const ch = text[i];
    if (ch >= "А" && ch <= "Я" || ch >= "A" && ch <= "Z"){
      letters++;
      upper++;
    } else if (ch >= "а" && ch <= "я" || ch >= "a" && ch <= "z"){
      letters++;
    }
  }
  return letters >= 3 && upper / letters > 0.7;
}

// -------------------------------------------------------------
// SECTION 2.15 — Проверки эмоциональной интенсивности
// -------------------------------------------------------------

function emotionalIntensity(analysis){
  if (!analysis) return 0;
  let s = 0;
  s += rlpScore(analysis) * 1.2;
  s += rlmScore(analysis) * 1.5;
  s += lfwScore(analysis) * 1.3;
  s += analysis.questions.length * 0.5;
  s += analysis.yesTokens.length * 0.3;
  s += analysis.noTokens.length * 0.7;
  return s;
}

// -------------------------------------------------------------
// SECTION 2.16 — Заготовки для последующих частей
// -------------------------------------------------------------

function lowerOrEmpty(x){
  return _isStr(x) ? x.toLowerCase() : "";
}

function hasAnyWord(tokens, dict){
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    if (dict[t.lower] === 1) return true;
  }
  return false;
}

function findTokenByStem(tokens, stem){
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    if (t.stem === stem) return t;
  }
  return null;
}

// -------------------------------------------------------------
// SECTION 2.17 — Финальная метка части 2
// -------------------------------------------------------------

const __IKW_PART2_LOADED = true;
// =============================================================
// PART 3 — Морфология (склонение, спряжение), словарь имён
// =============================================================

// -------------------------------------------------------------
// SECTION 3.1 — Род существительных (эвристика по окончанию)
// -------------------------------------------------------------

const GENDER = {
  M: "m",
  F: "f",
  N: "n",
  PL: "pl",
  UNKNOWN: "?"
};

function guessGender(word){
  if (!_isStr(word) || word.length === 0) return GENDER.UNKNOWN;
  const w = word.toLowerCase();
  const last = w[w.length - 1];
  const last2 = w.length >= 2 ? w.slice(-2) : "";

  // Plural-маркеры
  if (last2 === "ые" || last2 === "ие" || last2 === "ыми" ||
      last2 === "ими" || last2 === "ых" || last2 === "их") {
    return GENDER.PL;
  }

  // Явно средний род
  if (last2 === "ие" || last2 === "ье" || last2 === "ое" ||
      last2 === "ее" || last2 === "мя" || last2 === "мо") {
    return GENDER.N;
  }
  if (last === "о" || last === "е" || last === "ё") return GENDER.N;

  // Явно женский род
  if (last === "а" || last === "я") return GENDER.F;
  if (last === "ь" && w.length > 2){
    // Мягкий знак: либо мужской (конь), либо женский (ночь).
    // Эвристика по частотным суффиксам женского рода.
    if (last2 === "ть" || last2 === "чь" || last2 === "шь" ||
        last2 === "жь" || last2 === "сь" || last2 === "зь"){
      return GENDER.F;
    }
    return GENDER.M;
  }

  // Явно мужской род
  if (last === "й" || last === "ъ") return GENDER.M;
  if (RU_CONSONANTS[last] === 1) return GENDER.M;

  return GENDER.UNKNOWN;
}

// -------------------------------------------------------------
// SECTION 3.2 — Склонение существительных
// Возвращает объект падежей: { nom, gen, dat, acc, ins, pre }
// -------------------------------------------------------------

function declineNoun(word){
  if (!_isStr(word) || word.length === 0) {
    return { nom: word, gen: word, dat: word, acc: word, ins: word, pre: word };
  }
  const gender = guessGender(word);
  const w = word;

  // --- Мужской род ---
  if (gender === GENDER.M){
    const last = w[w.length - 1];
    if (last === "й"){
      const base = w.slice(0, -1);
      return {
        nom: w,
        gen: base + "я",
        dat: base + "ю",
        acc: base + "я",
        ins: base + "ем",
        pre: base + "е"
      };
    }
    if (last === "ь"){
      const base = w.slice(0, -1);
      return {
        nom: w,
        gen: base + "я",
        dat: base + "ю",
        acc: base + "я",
        ins: base + "ем",
        pre: base + "е"
      };
    }
    // Твёрдая основа
    const hardConsonants = "бвгджзклмнпрстфхцчшщ";
    if (hardConsonants.indexOf(last) !== -1){
      // проверка на шипящие: ж, ш, ч, щ, ц
      if (last === "ж" || last === "ш" || last === "ч" || last === "щ" || last === "ц"){
        return {
          nom: w,
          gen: w + "а",
          dat: w + "у",
          acc: w + "а",
          ins: w + "ем",
          pre: w + "е"
        };
      }
      return {
        nom: w,
        gen: w + "а",
        dat: w + "у",
        acc: w + "а",
        ins: w + "ом",
        pre: w + "е"
      };
    }
    // Fallback
    return { nom: w, gen: w + "а", dat: w + "у", acc: w + "а", ins: w + "ом", pre: w + "е" };
  }

  // --- Женский род ---
  if (gender === GENDER.F){
    const last = w[w.length - 1];
    if (last === "а"){
      const base = w.slice(0, -1);
      // Ж, Ш, Ч, Щ, Ц + а → особые формы
      const prev = base[base.length - 1];
      if (prev === "ж" || prev === "ш" || prev === "ч" || prev === "щ" ||
          prev === "к" || prev === "г" || prev === "х"){
        return {
          nom: w,
          gen: base + "и",
          dat: base + "е",
          acc: base + "у",
          ins: base + "ей",
          pre: base + "е"
        };
      }
      return {
        nom: w,
        gen: base + "ы",
        dat: base + "е",
        acc: base + "у",
        ins: base + "ой",
        pre: base + "е"
      };
    }
    if (last === "я"){
      const base = w.slice(0, -1);
      const prev = base[base.length - 1];
      if (prev === "и"){
        // -ия → -ии, -ию, -ией
        return {
          nom: w,
          gen: base + "и",
          dat: base + "и",
          acc: base + "ю",
          ins: base + "ей",
          pre: base + "и"
        };
      }
      return {
        nom: w,
        gen: base + "и",
        dat: base + "е",
        acc: base + "ю",
        ins: base + "ей",
        pre: base + "е"
      };
    }
    if (last === "ь"){
      const base = w.slice(0, -1);
      return {
        nom: w,
        gen: base + "и",
        dat: base + "и",
        acc: w,
        ins: base + "ью",
        pre: base + "и"
      };
    }
    return { nom: w, gen: w, dat: w, acc: w, ins: w, pre: w };
  }

  // --- Средний род ---
  if (gender === GENDER.N){
    const last = w[w.length - 1];
    if (last === "о"){
      const base = w.slice(0, -1);
      return {
        nom: w,
        gen: base + "а",
        dat: base + "у",
        acc: w,
        ins: base + "ом",
        pre: base + "е"
      };
    }
    if (last === "е" || last === "ё"){
      const base = w.slice(0, -1);
      return {
        nom: w,
        gen: base + "я",
        dat: base + "ю",
        acc: w,
        ins: base + "ем",
        pre: base + "е"
      };
    }
    if (w.slice(-2) === "ие"){
      const base = w.slice(0, -1);
      return {
        nom: w,
        gen: base + "я",
        dat: base + "ю",
        acc: w,
        ins: base + "ем",
        pre: base + "и"
      };
    }
    return { nom: w, gen: w, dat: w, acc: w, ins: w, pre: w };
  }

  // Plural / unknown
  return { nom: w, gen: w, dat: w, acc: w, ins: w, pre: w };
}

// -------------------------------------------------------------
// SECTION 3.3 — Согласование прилагательных по роду
// -------------------------------------------------------------

function agreeAdjective(adj, gender){
  if (!_isStr(adj) || adj.length === 0) return adj;
  const base = adj.replace(/(ый|ий|ой|ая|яя|ое|ее|ые|ие|ого|ому|ым|им|ых|их|ую|юю|ом|ем|ей|ой)$/i, "");
  const stem = base.length > 0 ? base : adj;

  if (gender === GENDER.M){
    const last = stem[stem.length - 1];
    const hard = "бвгджзклмнпрстфхцчшщ";
    if (last === "н" || last === "к" || last === "г" || last === "х" ||
        last === "ж" || last === "ш" || last === "ч" || last === "щ"){
      return stem + "ий";
    }
    return stem + "ый";
  }
  if (gender === GENDER.F){
    const last = stem[stem.length - 1];
    if (last === "н" || last === "к" || last === "г" || last === "х"){
      return stem + "яя";
    }
    return stem + "ая";
  }
  if (gender === GENDER.N){
    const last = stem[stem.length - 1];
    if (last === "н" || last === "к" || last === "г" || last === "х"){
      return stem + "ее";
    }
    return stem + "ое";
  }
  if (gender === GENDER.PL){
    const last = stem[stem.length - 1];
    if (last === "н" || last === "к" || last === "г" || last === "х"){
      return stem + "ие";
    }
    return stem + "ые";
  }
  return adj;
}

// -------------------------------------------------------------
// SECTION 3.4 — Спряжение глаголов
// Возвращает { inf, pres, past, fut }
// -------------------------------------------------------------

function conjugateVerb(verb){
  const base = _isStr(verb) ? verb.toLowerCase() : "";
  if (base.length === 0){
    return { inf: base, pres: base, past: base, fut: base };
  }

  // Уже инфинитив?
  const isInf = _endsWith(base, "ть") || _endsWith(base, "ться") ||
                _endsWith(base, "ти") || _endsWith(base, "чь");

  if (!isInf){
    // Попробуем восстановить инфинитив
    const stem = stemRu(base);
    const inf = stem + "ть";
    return {
      inf: inf,
      pres: base,
      past: base + "л",
      fut: "буд" + " " + inf
    };
  }

  // Извлечение корня
  let root = base;
  let reflexive = false;
  if (_endsWith(root, "ся") || _endsWith(root, "сь")){
    reflexive = true;
    root = root.slice(0, -2);
  }
  if (_endsWith(root, "ть")) root = root.slice(0, -2);
  else if (_endsWith(root, "ти")) root = root.slice(0, -2);
  else if (_endsWith(root, "чь")) root = root.slice(0, -2) + "г";

  // Простая модель: 1-е лицо наст. — root + "ю" / "у"
  const last = root[root.length - 1];
  let pres, fut;
  if (last === "а" || last === "я" || last === "и" || last === "е"){
    pres = root + "ю";
    fut = "буд" + " " + base;
  } else {
    pres = root + "у";
    fut = "буд" + " " + base;
  }
  // Прошедшее — root + "л"
  let past = root + "л";
  if (reflexive){
    past = past + "ся";
    pres = pres + "сь";
  }
  return {
    inf: base,
    pres: pres,
    past: past,
    fut: fut
  };
}

// -------------------------------------------------------------
// SECTION 3.5 — Согласование прилагательного с одушевлённостью
// (простая версия — совпадает с родом для одушевлённых)
// -------------------------------------------------------------

function agreeAdjForObject(adj, gender, animate){
  const agreed = agreeAdjective(adj, gender);
  if (!animate) return agreed;
  // Для одушевлённых вин. падеж совпадает с родительным:
  // "умный друг" → "умного друга"
  if (gender === GENDER.M){
    return agreed.replace(/(ый|ий|ой)$/, "ого");
  }
  if (gender === GENDER.F){
    return agreed.replace(/ая$/, "ую").replace(/яя$/, "юю");
  }
  return agreed;
}

// -------------------------------------------------------------
// SECTION 3.6 — Формирование фразы "существительное в падеже"
// -------------------------------------------------------------

function nounInCase(word, caseName){
  const forms = declineNoun(word);
  if (caseName === "nom") return forms.nom;
  if (caseName === "gen") return forms.gen;
  if (caseName === "dat") return forms.dat;
  if (caseName === "acc") return forms.acc;
  if (caseName === "ins") return forms.ins;
  if (caseName === "pre") return forms.pre;
  return forms.nom;
}

// -------------------------------------------------------------
// SECTION 3.7 — Числовые формы (1 / 2-4 / 5+)
// -------------------------------------------------------------

function pluralizeRu(n, forms){
  // forms = { one, few, many }
  const abs = Math.abs(n);
  const mod10 = abs % 10;
  const mod100 = abs % 100;
  if (mod10 === 1 && mod100 !== 11) return forms.one;
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return forms.few;
  return forms.many;
}

// -------------------------------------------------------------
// SECTION 3.8 — Согласование глагола по времени и лицу
// -------------------------------------------------------------

function verbPresent(verb, person){
  const c = conjugateVerb(verb);
  if (person === 1) return c.pres;
  if (person === 2) {
    const b = c.pres;
    if (_endsWith(b, "ю")) return b.slice(0, -1) + "ешь";
    if (_endsWith(b, "у")) return b + "ешь";
    return b + "ешь";
  }
  if (person === 3){
    const b = c.pres;
    if (_endsWith(b, "ю")) return b.slice(0, -1) + "ет";
    if (_endsWith(b, "у")) return b + "ет";
    return b + "ет";
  }
  return c.pres;
}

