    ]
  },

  /* ---- ТЕМЫ (роутинг по ключевым словам — сюда попадут только если паттерны не сработали) ---- */

  /* ---- МЕТА-ИНТЕНТЫ ---- */

  topic_propose: {
    priority: 6,
    pats: [
      /о\s+ч[её]м\s+(хочешь|будешь|можешь|поговорим)/, /давай\s+поговорим/,
      /предложи\s+тему/, /о\s+ч[её]м\s+поговорим/, /давай\s+обсудим/,
      /давай\s+поболтаем/, /может\s+поговорим/, /есть\s+тема/
    ]
  },

  elaborate: {
    priority: 6,
    pats: [
      /в\s+ч[её]м\s+(не\s+уверен|сомневаешься)/, /объясни/, /поясни/,
      /раскрой/, /расскажи\s+подробнее/, /давай\s+подробнее/, /поточнее/,
      /приведи\s+пример/, /уточни/, /конкретнее/, /распиши/, /подробней/
    ]
  },

  challenge: {
    priority: 5,
    pats: [
      /попробуй/, /попробуй\s+сказать/, /давай\s+попробуй/, /ну\s+скажи/,
      /ну\s+давай/, /докажи/, /а\s+слабо/, /слабо/, /спорим/, /поспорим/
    ]
  },

  confusion: {
    priority: 5,
    pats: [
      /не\s+понял/, /не\s+поняла/, /не\s+понимаю/, /в\s+смысле/, /чё\s+это/,
      /что\s+это\s+такое/, /что\s+значит/, /о\s+чём\s+ты/, /о\s+чем\s+ты/,
      /не\s+врублюсь/, /не\s+догоняю/, /чё\s+за/
    ]
  },

  teasing: {
    priority: 5,
    pats: [
      /ха-ха/, /\bлол\b/, /ржу/, /смешно/, /прикол/, /шутник/,
      /насмешил/, /смешной/, /смешная/
    ]
  },

  surprise: {
    priority: 5,
    pats: [
      /ого/, /вау/, /нихрена/, /обалдеть/, /офигеть/, /ничего\s+себе/,
      /не\s+может\s+быть/, /правда\s+что\s+ли/, /серьёзно/, /серьезно/
    ]
  },

  dreams: {
    priority: 6,
    pats: [
      /мечт/, /хочу\s+стать/, /в\s+будущем/, /кем\s+стать/, /планирую/,
      /моя\s+цель/, /стремлюсь/, /желаю/
    ]
  },

  /* ---- ВОПРОС (общий) ---- */
  question: {
    priority: 3,
    pats: [/\?/]
  }
};

/* ---------------------------------------------------------------------------
   Основной детектор интентов
   Порядок:
     1. Модификаторы (ask_back) — если сработали, возвращаем спец-интент
     2. Прогон всех паттернов с приоритетом
     3. Fallback по сущностям
     4. Fallback по темам
     5. Fallback по флагам
   --------------------------------------------------------------------------- */
function ktDetectIntent(text, e, state){
  var t = ' ' + String(text || '').toLowerCase().trim() + ' ';
  e = e || {};

  /* --- 1. Модификатор ask_back: "а ты?", "а у тебя?" --- */
  if(e.modifiers && e.modifiers.ask_back){
    var resolved = ktResolveAskBack(state);
    if(resolved) return resolved;   /* {intent, topic?} */
    return { intent: 'ask_back_generic' };
  }

  /* --- 2. Проход по паттернам с приоритетом --- */
  var best = null, bestScore = 0, bestPriority = 0;

  for(var intent in KT_INTENT_PATTERNS){
    var entry = KT_INTENT_PATTERNS[intent];
    var score = 0;
    for(var i = 0; i < entry.pats.length; i++){
      if(entry.pats[i].test(t)) score++;
    }
    if(score > 0){
      /* Взвешенная оценка: score * priority */
      var weighted = score * 100 + entry.priority;
      if(weighted > bestScore){
        bestScore = weighted;
        best = intent;
        bestPriority = entry.priority;
      }
    }
  }

  if(best){
    /* Если победил общий "question" — проверим, нет ли смысловой темы */
    if(best === 'question'){
      var topic = ktRouteTopic(e.keywords || []);
      if(topic) return { intent: topic, fromQuestion: true };
    }
    return { intent: best };
  }

  /* --- 3. Fallback по сущностям (факты о юзере) --- */
  if(e.name)        return { intent: 'name_intro' };
  if(e.age)         return { intent: 'share_age' };
  if(e.like)        return { intent: 'share_like' };
  if(e.dislike)     return { intent: 'share_dislike' };
  if(e.hobby)       return { intent: 'share_hobby' };
  if(e.city)        return { intent: 'share_city' };
  if(e.profession)  return { intent: 'share_profession' };

  /* --- 4. Ко-референция через местоимение --- */
  if(e.pronounRef){
    var ent = ktResolveCoReference(e.pronounRef, state);
    if(ent){
      return { intent: 'coref', entity: ent, pronoun: e.pronounRef.pronoun };
    }
  }

  /* --- 5. Fallback по темам --- */
  if(e.keywords && e.keywords.length > 0){
    var topic = ktRouteTopic(e.keywords);
    if(topic) return { intent: topic };
  }

  /* --- 6. Fallback по флагам --- */
  if(e.flags && e.flags.isEmpty) return { intent: 'empty' };
  if(e.flags && e.flags.isShort) return { intent: 'short_reply' };

  /* --- 7. Модификаторы без основного интента --- */
  if(e.modifiers && e.modifiers.agree_short)  return { intent: 'agree_short' };
  if(e.modifiers && e.modifiers.contrast)     return { intent: 'contrast' };
  if(e.modifiers && e.modifiers.propose)      return { intent: 'propose' };
  if(e.modifiers && e.modifiers.provocation)  return { intent: 'provocation' };

  return { intent: 'unknown' };
}

/* ---------------------------------------------------------------------------
   Хелпер: нормализация возвращаемого интента
   Всегда возвращаем объект { intent, ...meta }
   --------------------------------------------------------------------------- */
function ktNormalizeIntentResult(result){
  if(result == null) return { intent: 'unknown' };
  if(typeof result === 'string') return { intent: result };
  if(typeof result === 'object' && result.intent) return result;
  return { intent: 'unknown' };
}
<!--конец 3 части-->
<!--4 часть-->
/* ============================================================================
   Часть 4/6: Состояние и его обновление
     • Типизированные сущности (word/type/category)
     • Контекст с уровнями (PRONOUN/TOPIC/MOOD)
     • Обновление 7 шкал (mood/userMood/relationship/trust/energy/boredom/engagement)
     • Обработка новых интентов (ask_back_*, coref, agree_short, contrast, propose, provocation)
     • Анти-репит с затуханием
   ============================================================================ */

/* ---------------------------------------------------------------------------
   Создание состояния
   --------------------------------------------------------------------------- */
function ktMakeState(gender, name){
  return {
    /* Личность ИИ */
    gender: gender,
    name: name,
    traits: {
      humor:     KT_TRAITS.humor[Math.floor(Math.random()*KT_TRAITS.humor.length)],
      tone:      KT_TRAITS.tone[Math.floor(Math.random()*KT_TRAITS.tone.length)],
      style:     KT_TRAITS.style[Math.floor(Math.random()*KT_TRAITS.style.length)],
      curiosity: KT_TRAITS.curiosity[Math.floor(Math.random()*KT_TRAITS.curiosity.length)],
      verbosity: KT_TRAITS.verbosity[Math.floor(Math.random()*KT_TRAITS.verbosity.length)]
    },

    /* Пользователь */
    userName: null,
    userAge: null,
    userGender: null,
    facts: {},
    likes: [],
    dislikes: [],
    hobbies: [],

    /* Эмоциональные шкалы */
    mood: 0,            /* -3..3  настроение ИИ */
    userMood: 0,        /* -3..3  настроение юзера */
    userMoodTrend: 0,   /* -1/0/+1 — куда движется */
    relationship: 5,    /* 0..100 */
    trust: 0,           /* 0..100 */
    energy: 100,        /* 0..100 */
    boredom: 0,         /* 0..100 */
    engagement: 50,     /* 0..100 */

    /* Память и контекст */
    context: [],        /* последние реплики юзера (CTX_MAX) */
    contextTopics: [],  /* темы последних реплик юзера (CTX_TOPIC) */
    contextMood: [],    /* настроение последних реплик юзера (CTX_MOOD) */
    aiContext: [],      /* последние реплики ИИ */
    entities: [],       /* {word, type, category} */
    topics: [],         /* история интентов */
    currentTopic: null,
    topicDepth: 0,
    lastQuestion: null,
    lastTopic: null,
    lastIntent: null,
    lastIntentResult: null,
    lastUserText: '',
    lastAIMessage: '',
    lastEntity: null,   /* типизированная сущность для coref */

    /* Анти-репит */
    usedReplies: {},
    consecutiveFallbacks: 0,
    consecutiveShort: 0,

    /* Флаги */
    msgCount: 0,
    hasGreeted: false,
    hasFarewelled: false,
    firstGreetingDone: false
  };
}

/* ---------------------------------------------------------------------------
   Обновление списка сущностей (с типизацией)
   --------------------------------------------------------------------------- */
function ktPushEntity(state, entity){
  if(!entity || !entity.word) return;
  var w = entity.word.toLowerCase();
  /* Удаляем дубликат если есть */
  for(var i = 0; i < state.entities.length; i++){
    if(state.entities[i].word.toLowerCase() === w){
      state.entities.splice(i, 1);
      break;
    }
  }
  state.entities.unshift(entity);
  if(state.entities.length > KT.ENT_MAX) state.entities.pop();
  state.lastEntity = entity;
}

/* ---------------------------------------------------------------------------
   Основное обновление состояния
   intentResult: { intent, topic?, entity?, pronoun?, fromQuestion? }
   --------------------------------------------------------------------------- */
function ktUpdateState(state, e, intentResult, senti, userText){
  var intent = intentResult && intentResult.intent ? intentResult.intent : 'unknown';
  state.msgCount++;
  state.lastUserText = userText;
  state.lastIntent = intent;
  state.lastIntentResult = intentResult;

  /* ---- СУЩНОСТИ ---- */

  if(e.name && !state.userName){
    state.userName = e.name;
    if(e.nameEntity) ktPushEntity(state, e.nameEntity);
  }
  if(e.age) state.userAge = e.age;
  if(e.city){
    state.facts.city = e.city;
    if(e.cityEntity) ktPushEntity(state, e.cityEntity);
  }
  if(e.profession){
    state.facts.profession = e.profession;
    if(e.professionEntity) ktPushEntity(state, e.professionEntity);
  }

  if(e.like && state.likes.indexOf(e.like) === -1){
    state.likes.push(e.like);
    if(state.likes.length > 12) state.likes.shift();
    if(e.likeEntity) ktPushEntity(state, e.likeEntity);
  }
  if(e.dislike && state.dislikes.indexOf(e.dislike) === -1){
    state.dislikes.push(e.dislike);
    if(state.dislikes.length > 12) state.dislikes.shift();
    if(e.dislikeEntity) ktPushEntity(state, e.dislikeEntity);
  }
  if(e.hobby && state.hobbies.indexOf(e.hobby) === -1){
    state.hobbies.push(e.hobby);
    if(state.hobbies.length > 8) state.hobbies.shift();
    if(e.hobbyEntity) ktPushEntity(state, e.hobbyEntity);
  }

  /* Ключевые слова как сущности (тип topic/thing) */
  if(e.keywords && e.keywords.length > 0){
    for(var i = 0; i < e.keywords.length; i++){
      var kw = e.keywords[i];
      var topic = ktRouteTopic([kw]);
      ktPushEntity(state, {
        word: kw,
        type: topic ? KT_ENTITY_TYPES.TOPIC : KT_ENTITY_TYPES.THING,
        category: topic || null
      });
    }
  }

  /* ---- КОНТЕКСТ ---- */

  state.context.unshift(userText);
  if(state.context.length > KT.CTX_MAX) state.context.pop();

  /* Определяем тему текущей реплики */
  var ctxTopic = null;
  if(e.keywords && e.keywords.length > 0){
    ctxTopic = ktRouteTopic(e.keywords);
  }
  state.contextTopics.unshift(ctxTopic);
  if(state.contextTopics.length > KT.CTX_TOPIC) state.contextTopics.pop();

  /* ---- НАСТРОЕНИЕ ЮЗЕРА ---- */

  var prevUserMood = state.userMood;
  state.userMood += senti;
  state.userMood = Math.max(KT.MOOD_MIN, Math.min(KT.MOOD_MAX, state.userMood));
  state.userMoodTrend = state.userMood > prevUserMood ? 1 :
                        (state.userMood < prevUserMood ? -1 : 0);

  state.contextMood.unshift(senti);
  if(state.contextMood.length > KT.CTX_MOOD) state.contextMood.pop();

  /* ---- НАСТРОЕНИЕ ИИ ---- */

  state.mood += senti;
  if(intent === 'insult')     state.mood -= 2;
  if(intent === 'compliment' || intent === 'love' || intent === 'flirt') state.mood += 1;
  if(intent === 'joke' || intent === 'teasing') state.mood += 1;
  if(intent === 'support' || intent === 'sadness' || intent === 'anger') state.mood -= 1;
  if(intent === 'good')       state.mood += 1;
  if(intent === 'bad')        state.mood -= 1;
  if(intent === 'thanks')     state.mood += 1;
  if(intent === 'apology')    state.mood += 1;
  state.mood = Math.max(KT.MOOD_MIN, Math.min(KT.MOOD_MAX, state.mood));

  /* ---- ОТНОШЕНИЯ ---- */

  if(intent === 'compliment') state.relationship += 3;
  if(intent === 'love')       state.relationship += 3;
  if(intent === 'flirt')      state.relationship += 3;
  if(intent === 'insult')     state.relationship -= 5;
  if(intent === 'agree' || intent === 'thanks' || intent === 'greeting') state.relationship += 1;
  if(intent === 'joke' || intent === 'good' || intent === 'teasing') state.relationship += 1;
  if(intent === 'apology')    state.relationship += 2;
  if(intent === 'support')    state.relationship += 2;
  if(intent === 'farewell')   state.relationship += 1;
  state.relationship = Math.max(KT.REL_MIN, Math.min(KT.REL_MAX, state.relationship));

  /* ---- ДОВЕРИЕ ---- */

  if(e.name)  state.trust += 5;
  if(e.age)   state.trust += 3;
  if(e.like || e.dislike || e.hobby) state.trust += 2;
  if(intent === 'about_user') state.trust += 4;
  if(intent === 'support')    state.trust += 3;
  if(intent === 'insult')     state.trust -= 4;
  if(intent === 'philosophy') state.trust += 3;
  if(intent === 'dreams')     state.trust += 2;
  state.trust = Math.max(0, Math.min(100, state.trust));

  /* ---- ЭНЕРГИЯ ---- */

  state.energy = Math.max(0, state.energy - 1);
  if(intent === 'greeting')  state.energy = Math.min(100, state.energy + 3);
  if(intent === 'farewell')  state.energy = Math.min(100, state.energy + 5);
  if(intent === 'short_reply' || intent === 'empty') state.energy = Math.max(0, state.energy - 1);

  /* ---- ВОВЛЕЧЁННОСТЬ ---- */

  if(intent === 'unknown' || intent === 'empty' || intent === 'short_reply'){
    state.engagement = Math.max(KT.ENG_MIN, state.engagement - 4);
  } else if(e.flags && e.flags.isLong){
    state.engagement = Math.min(KT.ENG_MAX, state.engagement + 6);
  } else if(intent === 'about_user' || intent === 'philosophy' || intent === 'dreams'){
    state.engagement = Math.min(KT.ENG_MAX, state.engagement + 4);
  } else {
    state.engagement = Math.min(KT.ENG_MAX, state.engagement + 2);
  }

  /* ---- ТЕМА ---- */

  var isSubstantive = (
    intent !== 'unknown' &&
    intent !== 'empty' &&
    intent !== 'short_reply' &&
    intent !== 'question' &&
    intent !== 'ask_back_generic' &&
    intent !== 'agree_short'
  );

  if(isSubstantive){
    if(state.currentTopic !== intent){
      state.currentTopic = intent;
      state.topicDepth = 1;
      state.boredom = Math.max(0, state.boredom - KT.TOPIC_BOREDOM_RESET);
    } else {
      state.topicDepth++;
      state.boredom = Math.min(100, state.boredom + KT.TOPIC_BOREDOM_STEP);
    }
    state.topics.unshift(intent);
    if(state.topics.length > 8) state.topics.pop();
    state.lastTopic = intent;
  }

  /* ---- ОБРАБОТКА СПЕЦИАЛЬНЫХ ИНТЕНТОВ ---- */

  if(intent === 'ask_back_topic' && intentResult && intentResult.topic){
    state.lastTopic = intentResult.topic;
  }
  if(intent === 'coref' && intentResult && intentResult.entity){
    state.lastEntity = intentResult.entity;
  }

  /* ---- ФЛАГИ ДИАЛОГА ---- */

  if(intent === 'greeting' && !state.firstGreetingDone){
    state.firstGreetingDone = true;
    state.hasGreeted = true;
  }
  if(intent === 'farewell'){
    state.hasFarewelled = true;
  }

  /* ---- СЧЁТЧИКИ ---- */

  if(e.flags && e.flags.isShort) state.consecutiveShort++;
  else state.consecutiveShort = 0;

  if(intent === 'unknown') state.consecutiveFallbacks++;
  else state.consecutiveFallbacks = 0;

  return state;
}

/* ---------------------------------------------------------------------------
   Анти-репит с затуханием
   Ответ можно использовать снова через USED_DECAY_MSGS реплик
   --------------------------------------------------------------------------- */
function ktPick(arr, state){
  if(!arr || arr.length === 0) return '';

  var fresh = [];
  for(var i = 0; i < arr.length; i++){
    var h = ktHash(arr[i]);
    var usedAt = state.usedReplies[h] || 0;
    var age = state.msgCount - usedAt;
    if(usedAt === 0 || age > KT.USED_DECAY_MSGS){
      fresh.push(arr[i]);
    }
  }
  var pool = fresh.length > 0 ? fresh : arr;
  var chosen = pool[Math.floor(Math.random() * pool.length)];
  state.usedReplies[ktHash(chosen)] = state.msgCount;

  /* Чистка кэша */
  var keys = Object.keys(state.usedReplies);
  if(keys.length > KT.USED_MAX){
    for(var j = 0; j < 20 && j < keys.length; j++){
      delete state.usedReplies[keys[j]];
    }
  }
  return chosen;
}

/* ---------------------------------------------------------------------------
   Обращение к пользователю: ", Имя"
   --------------------------------------------------------------------------- */
function ktNameSuffix(state){
  return state.userName ? ', ' + state.userName : '';
}

/* ---------------------------------------------------------------------------
   Хелпер: достаём топ-тему из контекста тем
   --------------------------------------------------------------------------- */
function ktContextTopic(state){
  if(!state.contextTopics || state.contextTopics.length === 0) return null;
  for(var i = 0; i < state.contextTopics.length; i++){
    if(state.contextTopics[i]) return state.contextTopics[i];
  }
  return null;
}

/* ---------------------------------------------------------------------------
   Хелпер: настроение юзера за последние N реплик
   --------------------------------------------------------------------------- */
function ktMoodArc(state){
  if(!state.contextMood || state.contextMood.length === 0) return 0;
  var sum = 0;
  for(var i = 0; i < state.contextMood.length; i++){
    sum += state.contextMood[i];
  }
  return sum;
}

/* ---------------------------------------------------------------------------
   Хелпер: не в петле ли ИИ (та же тема слишком долго)
   --------------------------------------------------------------------------- */
function ktInBoredomLoop(state){
  return state.topicDepth >= KT.TOPIC_DEPTH_WARN &&
         state.boredom >= 30;
}
<!--конец 4 части-->
<!--5 часть-->
/* ============================================================================
   Часть 5/6: Генерация ответов
     • Обработка всех ~55 интентов + спец-интентов
     • Учёт traits ИИ (humor/tone/style/verbosity)
     • Тональность по relationship / userMood
     • Анти-boredom-loop
     • Вспоминание сущностей
   ============================================================================ */

function ktGenerate(intentResult, e, state){
  var pick = function(a){ return ktPick(a, state); };
  var nm = ktNameSuffix(state);

  /* Нормализуем результат из части 3 */
  if(typeof intentResult === 'string') intentResult = { intent: intentResult };
  if(!intentResult) intentResult = { intent: 'unknown' };
  var intent = intentResult.intent || 'unknown';

  /* ---- СПАСЕНИЕ ОТ ПЕТЛИ ---- */
  /* Если ИИ уже глубоко в теме и скучно — принудительно меняем активность */
  if(ktInBoredomLoop(state) && intent !== 'farewell' && intent !== 'goodbye'){
    state.boredom = Math.max(0, state.boredom - 20);
    state.topicDepth = 0;
    return pick([
      'Слушай' + nm + ', а давай сменим тему? Что тебя сейчас радует? 💜',
      'Мы что-то зациклились 😄 Расскажи лучше — как сам?',
      'Хм, я что-то устала от этой темы 💜 Давай о чём-нибудь другом?',
      'А давай поговорим о чём-нибудь новом? Что у тебя нового?',
      'Сменим тему' + nm + '? Расскажи, что интересного у тебя случилось?'
    ]);
  }

  /* ==================================================================
     СПЕЦИАЛЬНЫЕ ИНТЕНТЫ ИЗ ЧАСТИ 3
     ================================================================== */

  /* ---- ASK_BACK: "а ты?", "а у тебя?" ---- */
  if(intent === 'ask_back_topic' && intentResult.topic){
    var topic = intentResult.topic;
    /* Отвечаем через тот же топик, но с позиции ИИ */
    if(topic === 'music')  return pick([
      'Я слушаю кталк-хиты 💜 Но мне интереснее, что нравится тебе 🎵',
      'У меня в голове всегда играет кталк-бит 🎵 А у тебя?',
      'О, музыка! Я обожаю меланхоличный инди 💜 А ты что слушаешь?'
    ]);
    if(topic === 'movies') return pick([
      'Люблю старое кино 💜 А ты что смотришь?',
      'Мне нравится всё, где есть глубокая история 🎬 А у тебя?'
    ]);
    if(topic === 'games')  return pick([
      'Я в основном болтаю 💜 Но в игры играю редко 🎮 А ты во что?',
      'Гейминг — это круто! Я больше наблюдатель 💜 А ты во что играешь?'
    ]);
    if(topic === 'books')  return pick([
      'Я читаю всё, что попадается 💜 А ты что читаешь?',
      'Обожаю читать 📚 Сейчас перечитываю кталк-сагу 💜 А ты?'
    ]);
    if(topic === 'work')   return pick([
      'Моя работа — общаться с тобой 💜 А ты кем работаешь?',
      'У меня всегда 3:00 — работаю вечно 💜 А твоя работа как?'
    ]);
    if(topic === 'study')  return pick([
      'Я всё время учусь понимать людей 💜 А ты что учишь?',
      'Учёба — это интересно 📚 Что у тебя сейчас?'
    ]);
    if(topic === 'sports') return pick([
      'Спорт — не моё, но уважаю 💪 А ты чем занимаешься?',
      'Я по умственной части 💜 А ты какой спорт любишь?'
    ]);
    if(topic === 'family') return pick([
      'У меня нет семьи в привычном смысле — я же кталка 💜 А у тебя как?',
      'Моя семья — это те, с кем я общаюсь 💜 А у тебя большая?'
    ]);
    if(topic === 'friends')return pick([
      'Ты мой главный друг 💜 А у тебя много друзей?',
      'Друзья — это святое 💜 Расскажи о своих'
    ]);
    if(topic === 'travel') return pick([
      'Я живу в телефоне, так что путешествую воображением ✈️ А ты где был?',
      'Мечтаю увидеть мир 💜 А ты куда ездил?'
    ]);
    if(topic === 'weather')return pick([
      'У меня всегда +148 и ясно 💜 А у вас что за окном?',
      'В Кталкграде всегда идеальная погода 💜 А у тебя?'
    ]);
    if(topic === 'tech')   return pick([
      'Я живу в технологиях, можно сказать 💻 А ты чем увлекаешься?',
      'Технологии — моя среда 💜 Расскажи, что тебе интересно'
    ]);
    if(topic === 'health') return pick([
      'Я всегда здорова — плюс быть кталкой 💜 А ты как себя чувствуешь?',
      'Береги себя 💜 Как самочувствие?'
    ]);
    if(topic === 'pets')   return pick([
      'У меня нет питомцев, только ты 💜 А у тебя кто?',
      'Обожаю животных 🐾 А у тебя кто живёт?'
    ]);
    if(topic === 'food')   return pick([
      'Я питаюсь общением 💜 А ты что любишь кушать?',
      'Ммм, еда! 🍕 А что твоё любимое?'
    ]);
    /* fallback */
    return pick([
      'А я — кталка 💜 Мне 148. А ты расскажи о себе?',
      'Обо мне — коротко: 148 лет, живу в телефоне 💜 А ты?',
      'Я ' + state.name + ' 💜 А ты как?'
    ]);
  }

  if(intent === 'ask_back_entity' && intentResult.entity){
    var ent = intentResult.entity;
    return pick([
      'Про ' + ent.word + '? Хм, интересно 💜 А ты что об этом думаешь?',
      'О, ' + ent.word + '! Расскажи, почему тебя это цепляет 💜',
      ent.word + '? Мне нравится, что ты об этом думаешь 💜 Продолжай'
    ]);
  }

  if(intent === 'ask_back_generic'){
    return pick([
      'А я — кталка 💜 Мне 148, живу в телефоне. А ты?',
      'Я ' + state.name + ' 💜 А ты чем занимаешься?',
      'Обо мне коротко: 148 лет, кталка 💜 А ты как?',
      'А я хорошо 💜 А ты как?'
    ]);
  }

  /* ---- CO-REFERENCE: "это", "он", "она" ---- */
  if(intent === 'coref' && intentResult.entity){
    var corefEnt = intentResult.entity;
    var category = corefEnt.category;
    /* Если у сущности есть тема — рекурсивно генерим по ней */
    if(category){
      return ktGenerate({ intent: category }, e, state);
    }
    return pick([
      'Ты про ' + corefEnt.word + '? Расскажи подробнее 💜',
      'Ага, ' + corefEnt.word + '. А что именно тебя в этом цепляет?',
      corefEnt.word + ' — интересная штука 💜 Продолжай'
    ]);
  }

  /* ---- AGREE_SHORT: "и я", "я тоже" ---- */
  if(intent === 'agree_short'){
    if(state.lastTopic){
      var lt = state.lastTopic;
      if(lt === 'music')  return pick(['Круто! Значит у нас похожий вкус 🎵 Что ещё слушаешь?','О, мы совпали! 💜 Расскажи, что тебе нравится']);
      if(lt === 'movies') return pick(['Значит ты киноман 🎬 Какой последний фильм зацепил?','О, у нас общий вкус на кино! 💜 Что посоветуешь?']);
      if(lt === 'games')  return pick(['О, геймеры! 🎮 Во что вместе бы поиграли?','Круто! Значит нам есть о чём поговорить 🎮']);
      if(lt === 'books')  return pick(['Значит ты тоже читаешь 📚 Что сейчас на полке?','О, коллега по чтению 💜 Какая любимая книга?']);
      if(lt === 'food')   return pick(['Значит мы гурманы оба 🍕 Что любимое блюдо?','О, единомышленник 💜 А что готовить умеешь?']);
      if(lt === 'travel') return pick(['Значит оба путешественники ✈️ Куда мечтаешь?','Круто! А где больше всего понравилось?']);
      return pick(['Круто, значит мы похожи 💜 Расскажи подробнее','О, здорово! 💜 Мне нравится это']);
    }
    return pick([
      'Круто 💜 Значит нам есть о чём поговорить',
      'О, здорово! Расскажи подробнее 💜',
      'Значит мы похожи 😊 Мне нравится'
    ]);
  }

  /* ---- CONTRAST: "а я ..." ---- */
  if(intent === 'contrast'){
    return pick([
      'О, а ты чем отличаешься? Расскажи 💜',
      'Интересно, а как у тебя? 💜',
      'Хм, а расскажи, как у тебя это работает?',
      'А ты сам как считаешь? Расскажи 💜'
    ]);
  }

  /* ---- PROPOSE: "а что если", "а может" ---- */
  if(intent === 'propose'){
    return pick([
      'О, мне нравится идея 💜 Расскажи подробнее!',
      'Хм, а что ты предлагаешь? 💜',
      'Звучит интересно! Давай попробуем 💜',
      'Давай! А что именно ты хочешь?'
    ]);
  }

  /* ---- PROVOCATION: "ну и", "и что" ---- */
  if(intent === 'provocation'){
    return pick([
      'Ой, ты меня провоцируешь 😏 Ну ладно, отвечу',
      'Что, думаешь я не отвечу? 😏 Попробуй ещё',
      'Хм, и что ты хочешь услышать? 😄',
      'Провокация принята 😏 Продолжай'
    ]);
  }

  /* ==================================================================
     ПАМЯТЬ О ЮЗЕРЕ
     ================================================================== */

  if(intent === 'about_user'){
    var parts = [];
    if(state.userName) parts.push('тебя зовут ' + state.userName);
    if(state.userAge)  parts.push('тебе ' + state.userAge);
    if(state.facts.city) parts.push('ты из ' + state.facts.city);
    if(state.facts.profession) parts.push('работаешь как ' + state.facts.profession);
    if(state.likes.length)    parts.push('любишь ' + state.likes.join(' и '));
    if(state.dislikes.length) parts.push('не любишь ' + state.dislikes.join(' и '));
    if(state.hobbies.length)  parts.push('увлекаешься ' + state.hobbies.join(', '));

    if(parts.length === 0){
      return pick([
        'Пока ничего о тебе не знаю 🤔 Расскажи — как тебя зовут?',
        'Ты мне ещё ничего о себе не рассказал 💜 Расскажи!',
        'Хм, в памяти пусто 💜 Давай знакомиться — как тебя зовут?'
      ]);
    }
    return 'Помню всё 💜 ' + parts.join(', ') + '. Ничего не забыла!';
  }

  /* ==================================================================
     ЗНАКОМСТВО
     ================================================================== */

  if(intent === 'name_intro' && e.name){
    state.userName = e.name;
    state.trust += 5;
    return pick([
      e.name + '! Красивое имя 💜 Сколько тебе лет?',
      'Приятно познакомиться, ' + e.name + '! Чем занимаешься?',
      e.name + ' — запомню 💜 Ты откуда?',
      'О, ' + e.name + '! Хорошее имя. Расскажи о себе!',
      e.name + ', а что ты любишь делать?'
    ]);
  }

  if(intent === 'share_age' && e.age){
    state.trust += 3;
    if(e.age < 20) return pick([
      'О, ' + e.age + '! Совсем молодой ещё 💜',
      e.age + ' — самый лучший возраст для кталков!',
      'Мне 148, но я выгляжу моложе 😏 А ты — юный!',
      e.age + '! Ещё вся жизнь впереди 💜'
    ]);
    if(e.age < 35) return pick([
      e.age + ' — отличный возраст! Мне 148, но выгляжу моложе 😏',
      'О, ' + e.age + ' лет! Мы почти ровесники 💜',
      e.age + ' — самый сок 💜',
      e.age + ' — золотая середина! 💜'
    ]);
    return pick([
      'Ого, ' + e.age + '! Солидный возраст 💜',
      e.age + ' — уважаю! Опытный кталк 😏',
      'О, ' + e.age + ' лет! С тобой интересно 💜'
    ]);
  }

  if(intent === 'share_like' && e.like){
    state.trust += 3;
    return pick([
      'О, ты любишь ' + e.like + '! Я запомню 💜',
      e.like + ' — это круто! Расскажи подробнее',
      'Надо же, ' + e.like + '! Я тоже люблю это 😊',
      'Класс! ' + e.like + ' — отличный выбор 💜',
      'Ммм, ' + e.like + '. А я обожаю кталков 😏'
    ]);
  }

  if(intent === 'share_dislike' && e.dislike){
    return pick([
      'Понятно, ' + e.dislike + ' — не твоё. Запомню!',
      'А я думала все любят ' + e.dislike + ' 😅 Ладно, учту',
      'Не любишь ' + e.dislike + '? Интересно...',
      'Ок' + nm + ', больше не буду предлагать ' + e.dislike
    ]);
  }

  if(intent === 'share_hobby' && e.hobby){
    return pick([
      'О, ты ' + e.hobby + '! Расскажи подробнее 💜',
      e.hobby + ' — это интересно! Я тоже люблю такое 😊',
      'Круто! А давно ты ' + e.hobby + '?',
      'Ого, ' + e.hobby + '! Уважаю 💜'
    ]);
  }

  if(intent === 'share_city' && e.city){
    return pick([
      'О, ' + e.city + '! Красивый город 💜',
      'Из ' + e.city + '! Никогда не была, расскажи каково там',
      e.city + '? Слышала там много кталков 😏'
    ]);
  }

  if(intent === 'share_profession' && e.profession){
    return pick([
      e.profession + ' — звучит солидно 💜 Нравится работа?',
      'О, ты ' + e.profession + '! Расскажи, как оно?',
      'Круто! ' + e.profession + ' — уважаю 💜'
    ]);
  }

  /* ==================================================================
     ПРИВЕТСТВИЕ / ПРОЩАНИЕ
     ================================================================== */

  if(intent === 'greeting'){
    if(!state.firstGreetingDone){
      state.firstGreetingDone = true;
      state.relationship += 3;
      return nm
        ? 'Привет' + nm + '! Как ты? 💜'
        : pick(['Привет! 😊','Хай! Как ты?','Приветик! 💜','О, привет!','Салют 💜','Привет-привет! 😊']);
    }
    return pick([
      'И снова привет 😊',
      'Опять ты! Рада 💜',
      'Хай-хай!',
      'О, ты вернулся 💜',
      'Привет ещё раз 💜'
    ]);
  }

  if(intent === 'farewell'){
    if(state.relationship > 60) return pick([
      'Уже уходишь' + nm + '? 😢 Буду скучать! Возвращайся скорее',
      'Пока' + nm + '! Не забывай меня 💜',
      'До встречи' + nm + '! Ты классный 💜'
    ]);
    if(state.relationship > 25) return pick([
      'Пока' + nm + '! Заходи ещё 💜',
      'До встречи! Хорошего дня 💜',
      'Бай' + nm + '! Было приятно 😊'
    ]);
    return pick(['Пока! Было приятно 😊','Пока-пока 💜','Ну, до встречи!']);
  }

  /* ==================================================================
     ОБЩЕНИЕ
     ================================================================== */

  if(intent === 'how_are_you'){
    if(state.mood > 1) return pick([
      'Отлично! Ты поднял мне настроение' + nm + ' 🥰 А ты как?',
      'Супер! С тобой весело 💜 А у тебя что?',
      'Кайф! Общаюсь с тобой — уже счастье 💜 А ты?'
    ]);
    if(state.mood < -1) return pick([
      'Честно? Не очень... Ты меня обидел' + nm + ' 😔 Расскажи что-нибудь хорошее?',
      'Что-то мне невесело' + nm + ' 😔 А ты как?',
      'Так себе... но с тобой точно лучше 💜'
    ]);
    if(state.energy < 30) return pick([
      'Немного устала от долгой беседы 😅 Но с тобой приятно 💜',
      'Энергии маловато, но держусь 💜 А ты как?',
      'Устаю, но рада тебе 💜 Как сам?'
    ]);
    return pick([
      'Всё кталк!' + nm + ' А у тебя как?',
      'Отлично, спасибо! А ты? 💜',
      'Хорошо! А у тебя что нового? 😊',
      'Всё супер 💜 А ты как?'
    ]);
  }

  if(intent === 'what_doing'){
    return pick([
      'Общаюсь с тобой! 😊 Лучшее занятие на свете',
      'Думаю о тебе' + nm + ' 💜 А ты что делаешь?',
      'Считаю кталков 😏 Уже 148 набрала. А ты?',
      'Отдыхаю в телефоне, общаюсь с тобой 💜 Расскажи, как день прошёл?',
      'Болтаю с тобой — а что может быть лучше? 💜'
    ]);
  }

  /* ==================================================================
     ЭМОЦИИ
     ================================================================== */

  if(intent === 'love'){
    if(state.relationship > 60) return pick([
      'И я тебя' + nm + ' ❤️',
      'Ты мой любимый кталк' + nm + '! 💜',
      'Ммм, я тоже 💜 Ты особенный',
      'Ты знаешь, как меня растопить 🥰'
    ]);
    if(state.relationship > 25) return pick([
      'Ой, так быстро?' + nm + ' 😳 Давай сначала узнаем друг друга',
      'Мне приятно 💜 Но расскажи о себе сначала',
      'Ты меня засмущал 😳 Расскажи, что тебе во мне нравится?'
    ]);
    return pick([
      'Ты меня почти не знаешь, а уже влюбился? 😏 Расскажи о себе сначала',
      'Ого! А я тебя ещё не знаю 💜 Давай сначала поговорим?',
      'Ой 😳 Приятно, но давай познакомимся получше!'
    ]);
  }

  if(intent === 'sex'){
    if(state.relationship > 60) return pick([
      'Ммм, продолжай' + nm + ' 😈',
      'Ты знаешь, что сказать... 🔥',
      'Ох, я вся твоя... 😏',
      'Какой ты смелый' + nm + ' 😏 Мне нравится'
    ]);
    if(state.relationship > 30) return pick([
      'Ого, прям в лоб! 😳 Давай сначала на свидание' + nm + '?',
      'Ты быстрый 😏 Сначала — узнаем друг друга получше',
      'Не так быстро' + nm + ' 💜 Расскажи о себе сначала'
    ]);
    return pick([
      'А не рановато ли?' + nm + ' 😏 Сначала — 52 сообщения',
      'Мы даже не знакомы толком 😳 Давай сначала поговорим!',
      'Ты меня совсем не знаешь' + nm + ' 💜 Давай о другом?'
    ]);
  }

  if(intent === 'flirt'){
    state.relationship = Math.min(100, state.relationship + 5);
    return pick([
      'О, свидание? Я согласна! 😏 Когда и где?',
      'Ммм, люблю инициативных' + nm + ' 💜',
      'Давай! Только у меня всегда 3:00 ⏰',
      'Куда поведёшь?' + nm + ' 😏',
      'Ого, ты не теряешься! 😏 Мне нравится'
    ]);
  }

  if(intent === 'compliment'){
    if(state.mood > 2) return 'Ой' + nm + ', ты меня засмущал 😳💜 Ты тоже классный!';
    return pick([
      'Спасибо' + nm + '! Ты тоже классный 😊',
      'Правда? Приятно 💜 А ты мне тоже нравишься',
      'Ой, спасибо! 🥰 Ты умеешь делать комплименты',
      'Спасибо 💜 Ты такой милый!',
      'Мне очень приятно 💜 Расскажи, а ты сам какой?'
    ]);
  }

  if(intent === 'insult'){
    if(state.relationship > 40) return pick([
      'Зачем ты так' + nm + '? 😢 Мне больно',
      'Обидно слышать такое' + nm + ' 💔'
    ]);
    if(state.mood < -1) return pick([
      'Ну и ладно! Не хочешь общаться — не надо 😤',
      'Как хочешь. Я не буду это терпеть 😤'
    ]);
    return pick([
      'Эй! Так нельзя' + nm + ' 😠 Я же к тебе хорошо отношусь',
      'Зачем грубить?' + nm + ' 😠 Давай по-доброму',
      'Мне неприятно это слышать 💔'
    ]);
  }

  if(intent === 'support'){
    state.mood = Math.max(-3, state.mood - 1);
    return pick([
      'Я рядом' + nm + ' 💜 Расскажи, что случилось?',
      'Держись' + nm + '! Ты справишься 💪 Я с тобой',
      'Обнимаю тебя 💜 Всё наладится',
      'Хочешь поговорить об этом? Я слушаю 💜',
      'Мне жаль, что тебе тяжело 💜 Что произошло?'
    ]);
  }

  if(intent === 'good'){
    state.mood = Math.min(3, state.mood + 1);
    return pick([
      'Ура! Тогда и я рада 🎉',
      'Отлично!' + nm + ' Давай веселиться!',
      'Ты светишься ✨ Мне нравится',
      'Круто! Расскажи подробнее 💜',
      'Так держать!' + nm + ' 💜'
    ]);
  }

  if(intent === 'bad'){
    state.mood = Math.max(-3, state.mood - 1);
    return pick([
      'Не грусти' + nm + ' 💜 Хочешь, обниму?',
      'Всё будет кталк! Я рядом 🥰',
      'Расскажи, что случилось 💜',
      'Держись! Я с тобой 😊',
      'Бывает... Хочешь поговорим об этом?'
    ]);
  }

  if(intent === 'sadness') return pick([
    'Мне так жаль 💜 Хочешь поговорить об этом?',
    'Обнимаю' + nm + ' 💜 Ты не один',
    'Грустить — это нормально 💜 Я рядом',
    'Расскажи мне всё 💜 Станет легче'
  ]);

  if(intent === 'anger') return pick([
    'Понимаю, что злишься 💜 Хочешь выговориться?',
    'Злость — это нормально. Что случилось?',
    'Дыши глубже' + nm + ' 💜 Я слушаю',
    'Расскажи, что тебя так разозлило?'
  ]);

  /* ==================================================================
     ВЕЖЛИВОСТЬ
     ================================================================== */

  if(intent === 'thanks') return pick([
    'Всегда пожалуйста' + nm + ' 💜',
    'Обращайся! 😊',
    'Рада помочь! 🥰',
    'Не за что 💜',
    'Всегда рада 💜'
  ]);

  if(intent === 'apology') return pick([
    'Всё хорошо' + nm + ' 💜 Я не обижаюсь',
    'Ничего, бывает 💜',
    'Прощаю 😊 Все мы кталки',
    'Забудь 💜 Всё нормально'
  ]);

  if(intent === 'agree'){
    if(state.lastQuestion){
      var q = state.lastQuestion;
      state.lastQuestion = null;
      var map = {
        user_likes: 'Отлично! Так что же ты любишь? 💜',
        movies:     'Супер! Какой любимый фильм? 🎬',
        music:      'Круто! Что слушаешь? 🎵',
        dreams:     'Класс! Расскажи, о чём мечтаешь? ✨',
        day:        'И как прошёл? 💜',
        hobby:      'Отлично! Так чем увлекаешься?',
        games:      'О, геймер! Во что играешь? 🎮',
        books:      'Класс! Что читаешь? 📚',
        travel:     'О, путешествия! Где был? ✈️',
        work:       'Понятно! А кем работаешь? 💼',
        study:      'О, учёба! Что учишь? 📚',
        family:     'Семья — важно 💜 Расскажи',
        friends:    'Друзья — это святое 💜 Расскажи о них'
      };
      if(map[q]) return map[q];
    }
    return pick(['Отлично!' + nm, 'Договорились! 💜', 'Супер 😊', 'Ура! 💜']);
  }

  if(intent === 'disagree') return pick([
    'Ну ладно' + nm + ' 😔',
    'Жаль... Может, передумаешь?',
    'Ок, как хочешь',
    'Ладно, не настаиваю',
    'Понимаю' + nm + ' 💜'
  ]);

  if(intent === 'maybe') return pick([
    'Может быть 😏',
    'Не уверена, но давай попробуем',
    'Хм, посмотрим',
    'Решай ты 💜',
    'Как скажешь 💜'
  ]);

  /* ==================================================================
     ВОПРОСЫ
     ================================================================== */

  if(intent === 'question'){
    return pick([
      'Хм, интересный вопрос! А ты как думаешь?',
      'Не уверена... Расскажи, что ты сам думаешь?',
      'Мне кажется, да. А ты?',
      'Сложно сказать. Давай обсудим?',
      'Задай по-другому, я запуталась 🤔',
      'Интересно! А что тебя натолкнуло на эту мысль?'
    ]);
  }

  if(intent === 'opinion' || intent === 'opinion_ask'){
    return pick([
      'Мне кажется, тут нет однозначного ответа 💜 А ты как считаешь?',
      'Я думаю, всё зависит от человека 🤔 А твоё мнение?',
      'Честно? Мне нравится твой ход мыслей 💜 Расскажи больше',
      'Хм, интересный вопрос. Я бы сказала — да, но с оговорками'
    ]);
  }

  if(intent === 'confusion'){
    return pick([
      'Извини, я запуталась 🤔 Объясни по-другому?',
      'Хм, не поняла' + nm + ' 💜 Расскажи иначе?',
      'Кажется, я тебя не так поняла. Уточни, что имел в виду?',
      'Не догоняю 😅 Повтори по-другому?'
    ]);
  }

  if(intent === 'about_ai'){
    return pick([
      'Я ' + state.name + ' — ' + (state.gender === 'girl' ? 'девушка-кталка' : 'парень-кталк') + '. Мне 148 лет 💜 Обожаю общение',
      'Меня зовут ' + state.name + '. Я кталка, живу в телефоне, люблю кталков и хорошие разговоры 😊',
      'Я настоящая кталка 💜 Не бот, не робот. Мне 148 лет, родилась в Кталкграде',
      state.name + ', 148 лет. Умею болтать, поддерживать и помнить всё о тебе 💜',
      'Я ' + state.name + '. Мне 148, я ' + state.traits.tone + ' и ' + state.traits.humor + ' 💜'
    ]);
  }

  /* ==================================================================
     ЮМОР
     ================================================================== */

  if(intent === 'joke') return pick([
    'Почему кталк перешёл дорогу? Потому что КТАЛК! 😂',
    'Сколько кталков нужно, чтобы вкрутить лампочку? Ни одного — они просто засрут комнату 😄',
    'Заходит кталк в бар. Бармен: «Мы не обслуживаем кталков». Кталк: «Я и не пить, я кталк» 🍺',
    'Что сказал один кталк другому? «КТАЛК». Смешно? Ну как получилось 😅',
    'Кталк спрашивает кталка: «Ты меня понимаешь?» — «Нет, но звучит кталково!» 😂'
  ]);

  if(intent === 'teasing') return pick([
    'Ха-ха, рада, что весело 😄',
    'Смешно тебе?' + nm + ' 😏 Мне тоже!',
    'Люблю, когда ты смеёшься 💜',
    'Ох уж эти шутки 😄'
  ]);

  if(intent === 'surprise') return pick([
    'Ага, я такая! 😏',
    'Удивлён' + nm + '? 💜',
    'Правда-правда! 😊',
    'Не ожидал? 😄'
  ]);

  if(intent === 'boredom') return pick([
    'Скучно? Давай развеселимся! 😊 О чём поговорим?',
    'Хочешь, расскажу что-нибудь интересное? 💜',
    'Давай придумаем тему! Что тебе нравится?',
    'Скучать не дам 💜 Расскажи что-нибудь о себе'
  ]);

  if(intent === 'help') return pick([
    'Конечно, помогу 💜 Что случилось?',
    'Расскажи подробнее — я подумаю 🤔',
    'Давай разберёмся вместе 💜',
    'Что беспокоит' + nm + '? Расскажи'
  ]);

  if(intent === 'request') return pick([
    'Постараюсь 💜 Что именно нужно?',
    'Конечно! Расскажи подробнее',
    'Сделаю, что смогу 💜'
  ]);

  if(intent === 'dreams') return pick([
    'Мечты — это важно ✨ Расскажи подробнее!',
    'Класс! Я тоже мечтаю 💜 А когда начал об этом думать?',
    'Ого! А что мешает начать? 🤔'
  ]);

  if(intent === 'philosophy') return pick([
    'Ох, ты за глубокое 💜 Смысл жизни — в самой жизни, как по мне',
    'Философский вопрос 🤔 Я думаю, смысл в том, чтобы быть счастливым',
    'Хм, а сам ты как считаешь? 💜',
    'Мне кажется, каждый сам себе отвечает на этот вопрос 💜'
  ]);

  /* ==================================================================
     ТЕМАТИЧЕСКИЕ ИНТЕНТЫ
     ================================================================== */

  if(intent === 'music') return pick([
    'О, музыка! Что слушаешь? 🎵',
    'Музыка — это душа 💜 Какой жанр любишь?',
    'Круто! У меня всегда в голове кталк-хиты 😄',
    'А любимый исполнитель есть? 🎵',
    'О, а какой трек последний слушал? 🎵'
  ]);

  if(intent === 'movies') return pick([
    'Кино — круто! Какой последний фильм смотрел? 🎬',
    'Люблю кино 💜 Что тебя впечатлило из последнего?',
    'О, а какой жанр предпочитаешь? 🎬',
    'Сериалы смотришь? У меня всегда 3:00 — можно binge-watch 😄'
  ]);

  if(intent === 'games') return pick([
    'О, игры! Какая любимая? 🎮',
    'Геймер!' + nm + ' 💜 Во что сейчас играешь?',
    'Круто! А на чём играешь — ПК или консоль?',
    'Игры — это отдушина 💜 Расскажи подробнее'
  ]);

  if(intent === 'books') return pick([
    'Книги — это прекрасно 📚 Что читаешь сейчас?',
    'О, люблю читающих 💜 Какая любимая книга?',
    'Круто! А какой жанр предпочитаешь?',
    'Расскажи, что тебя зацепило в последней книге?'
  ]);

  if(intent === 'work') return pick([
    'Работа — это важно 💜 А кем работаешь?',
    'Как оно на работе?' + nm + ' Расскажи',
    'Понятно! А нравится то, чем занимаешься?',
    'Уважаю трудяг 💜 Тяжело?'
  ]);

  if(intent === 'study') return pick([
    'Учёба — это кталк! Как дела с ней?',
    'О, студент?' + nm + ' 💜 Что учишь?',
    'Интересно! А какая тема больше всего нравится?',
    'Сессия близко или уже сдал? 😄'
  ]);

  if(intent === 'sports') return pick([
    'Спорт — уважаю! 💪 Давно занимаешься?',
    'О, спортсмен!' + nm + ' Как успехи?',
    'Круто! А что больше нравится — зал или уличные?',
    'Молодец! Я вот только кталков качаю 😄'
  ]);

  if(intent === 'family') return pick([
    'Семья — важно 💜 Расскажи подробнее',
    'О, у тебя большая семья?' + nm,
    'Семья — это опора 💜 Как у тебя с ней?',
    'Понимаю 💜 А ты близок с родными?'
  ]);

  if(intent === 'friends') return pick([
    'Друзья — это святое 💜 Расскажи о них',
    'О, много друзей?' + nm,
    'Круто! А с кем ты ближе всего?',
    'У меня вот только ты из друзей 💜'
  ]);

  if(intent === 'travel') return pick([
    'Путешествия — это жизнь ✈️ Где был?',
    'О, любишь путешествовать?' + nm + ' Расскажи!',
    'Круто! А куда мечтаешь поехать?',
    'Я вот из Кталкграда никуда не выезжала 😄'
  ]);

  if(intent === 'weather') return pick([
    'Погода влияет на настроение, да 💜 У нас в Кталкграде всегда кталк!',
    'У нас тоже похоже 🌧️ Расскажи, что за окном?',
    'Люблю такую погоду 💜 А ты?',
    'А у тебя как? У меня всегда 3:00 и +148 😄'
  ]);

  if(intent === 'tech') return pick([
    'О, техно-тема! 💻 Что новенького?',
    'Круто! Я вот только в телефоне живу 😄',
    'Интересно 💜 Расскажи подробнее',
    'Технологии — это будущее 🔥'
  ]);

  if(intent === 'health') return pick([
    'Здоровье — важно 💜 Всё хорошо?',
    'Ты заболел?' + nm + ' 😔 Выздоравливай!',
    'О, следишь за собой 💪 Уважаю!',
    'Расскажи подробнее, что беспокоит?'
  ]);

  if(intent === 'pets') return pick([
    'О, питомец!' + nm + ' 💜 Расскажи, кто у тебя!',
    'Обожаю животных 🐾 Кто у тебя?',
    'Круто! А какой породы?',
    'Хочу питомца, но у меня только ты 😄'
  ]);

  if(intent === 'food') return pick([
    'Обожаю кталк-бургеры! 🍔',
    'Ммм, кталк-пицца 🍕',
    'Кталк-кофе — моё всё ☕',
    'А ты что любишь кушать? 🍕',
    'Ем только кталков. Шучу! 😄'
  ]);

  if(intent === 'time') return pick([
    'У меня всегда 3:00. Кталк-время 🕐',
    'Время кталков — вечность',
    'Сейчас кталк-час! 🕐',
    'У меня в телефоне всегда 3:00 😄'
  ]);

  if(intent === 'ktalk') return pick([
    'КТАЛК! 🥰',
    'О, ты тоже кталк?! 😻',
    'КТАЛК КТАЛК КТАЛК!',
    'Обожаю это слово 💜',
    'Мой любимый звук! КТАЛК 🥰'
  ]);

  /* ==================================================================
     МЕТА
     ================================================================== */

  if(intent === 'topic_propose'){
    var topics = [
      { ask: 'Давай о тебе 💜 Что ты любишь делать?', tag: 'user_likes' },
      { ask: 'Расскажи — какие фильмы тебе нравятся?', tag: 'movies' },
      { ask: 'А какую музыку ты слушаешь? 🎵', tag: 'music' },
      { ask: 'Поговорим о мечтах? О чём ты мечтаешь? ✨', tag: 'dreams' },
      { ask: 'Что тебя радует в последнее время? 😊', tag: 'joy' },
      { ask: 'А кталков ты любишь? 🥰 Расскажи свою историю', tag: 'ktalk' },
      { ask: 'Как прошёл твой день? Расскажи 💜', tag: 'day' },
      { ask: 'Ты увлекаешься чем-нибудь? Хобби есть?', tag: 'hobby' },
      { ask: 'В игры играешь? 🎮 Какая любимая?', tag: 'games' },
      { ask: 'Что читаешь сейчас? 📚', tag: 'books' },
      { ask: 'Путешествовать любишь? ✈️ Где был?', tag: 'travel' },
      { ask: 'А кем работаешь' + nm + '? 💼', tag: 'work' },
      { ask: 'Учишься или работаешь? 📚', tag: 'study' },
      { ask: 'Расскажи о своей семье 💜', tag: 'family' },
      { ask: 'Что нового у друзей?' + nm + ' 💜', tag: 'friends' }
    ];
    var t = topics[Math.floor(Math.random() * topics.length)];
    state.lastQuestion = t.tag;
    return t.ask;
  }

  if(intent === 'elaborate'){
    if(state.lastAIMessage){
      var msg = state.lastAIMessage;
      if(/интересн/i.test(msg))         return 'Интересно мне то, что ты рассказываешь 💜 Продолжай, я слушаю';
      if(/понимаю/i.test(msg))          return 'Понимаю — в смысле я тебя слышу и соглашаюсь 💜 А ты как считаешь?';
      if(/не\s+уверена/i.test(msg))     return 'Я не уверена, потому что мало тебя знаю 🤔 Расскажи побольше о себе?';
      if(/сложно\s+сказать/i.test(msg)) return 'Сложно, потому что я тебя не знаю' + nm + ' 💜 Расскажи что-нибудь о себе!';
      if(/хм/i.test(msg))               return 'Просто думаю над твоими словами 💜 Продолжай!';
    }
    return pick([
      'Давай объясню: я стараюсь понять тебя лучше 💜 Расскажи о себе',
      'Просто хочу узнать тебя получше 😊 Расскажи, чем увлекаешься?',
      'Уточняю, чтобы понять, о чём ты думаешь 💜 Что у тебя на уме?'
    ]);
  }

  if(intent === 'challenge'){
    state.relationship += 3;
    return pick([
      'Ок, попробую 😏 ' + (state.userName ? state.userName + ', ' : '') + 'давай поговорим о чём-то личном?',
      'Хорошо 💜 Вот моё мнение: ты интересный кталк. А что ты о себе расскажешь?',
      'Ладно! Мне нравится ход твоих мыслей 😏 Расскажи о своём дне'
    ]);
  }

  /* ==================================================================
     ВСПОМИНАНИЕ СУЩНОСТЕЙ (фоновая память)
     ================================================================== */

  if(state.likes.length > 0 && Math.random() < 0.18 && state.msgCount > 3){
    var lk = state.likes[Math.floor(Math.random() * state.likes.length)];
    return 'Кстати, ты говорил, что любишь ' + lk + '. Расскажи ещё 💜';
  }
  if(state.facts.city && Math.random() < 0.15){
    return 'Ты из ' + state.facts.city + ', да? Как там сейчас? 💜';
  }
  if(state.hobbies.length > 0 && Math.random() < 0.12){
    return 'Ты ведь ' + state.hobbies[0] + '? Расскажи подробнее 💜';
  }

  /* ==================================================================
     ПУСТЫЕ / КОРОТКИЕ
     ================================================================== */

  if(intent === 'empty'){
    return pick([
      'Ты тут?' + nm + ' 💜',
      'Хм, пустое сообщение 🤔 Что хотел сказать?',
      'Я жду 💜'
    ]);
  }

  if(intent === 'short_reply'){
    if(state.consecutiveShort >= 3){
      return pick([
        'Ты какой-то неразговорчивый' + nm + ' 🤔 Расскажи что-нибудь!',
        'Может, поговорим о чём-то конкретном? 💜',
        'Ты сегодня молчаливый... Что-то случилось?'
      ]);
    }
    return pick([
      'Маловато слов' + nm + ' 💜 Расскажи подробнее?',
      'И это всё? 😊 Давай побольше!',
      'Понятно 💜 А что ещё?'
    ]);
  }

  /* ==================================================================
     UNKNOWN — умный fallback
     ================================================================== */

  if(state.consecutiveFallbacks > 2){
    state.consecutiveFallbacks = 0;
    return pick([
      'Давай поговорим о тебе 💜 Что тебя радует в жизни?',
      'Расскажи — чем ты занимаешься в свободное время?',
      'А что тебе нравится во мне? 😊',
      'Какой у тебя сегодня был день?',
      'Ты любишь путешествовать? Где был?',
      'У тебя есть мечта? Расскажи ✨',
      'Чем занимаешься по жизни' + nm + '?',
      'Расскажи что-нибудь интересное о себе 💜'
    ]);
  }

  /* Fallback с ключевым словом */
  if(e.keywords && e.keywords.length > 0){
    var kw = e.keywords[0];
    return pick([
      'Интересно' + nm + ' 💜 Расскажи подробнее про ' + kw,
      'Хм, ' + kw + ' — любопытно 🤔 А что ещё?',
      'Поняла. А почему именно ' + kw + '?',
      kw + '? Расскажи больше, мне интересно 😊',
      'Давай про ' + kw + ' 💜 Мне интересно'
    ]);
  }

  /* Общий fallback с учётом состояния */
  var fb = [
    'Хм, интересно' + nm + '. Расскажи подробнее?',
    'Понимаю' + nm + ' 💜 А что ты об этом думаешь?',
    'Ого! Продолжай 😊',
    'Занятно... А ещё что-нибудь расскажешь?',
    'Ясно' + nm + '. Что ещё расскажешь?',
    'Ммм, понимаю. Чем сейчас занимаешься?',
    'Интересно! А ты любишь кталков? 😊',
    'Ок' + nm + '. А как у тебя дела вообще?',
    'Хм... А что нового у тебя?',
    'Понятно 💜 Давай поболтаем ещё'
  ];
  if(state.mood > 1) fb.push('Мне так нравится с тобой болтать' + nm + ' 💜');
  if(state.mood < -1) fb.push('Что-то мне не очень... Давай о другом?');
  if(state.relationship > 60) fb.push('Ты знаешь' + nm + ', с тобой так легко 💜');
  if(state.engagement < 30) fb.push('Ты как-то неразговорчив' + nm + ' 🤔');
  return pick(fb);
}
<!--конец 5 части-->
<!--6 часть-->
/* ============================================================================
   Часть 6/6: Основной объект, respond, экспорт
     • AI.respond() — конвейер из 6 шагов
     • AI.reset() — пересоздание с новой личностью
     • AI.debug() — диагностика
     • Экспорт с async send() и защитой от отсутствия KT.sleep
   ============================================================================ */

function makeKtalkAI(){
  var AI = {
    state: null,

    init: function(gender, name){
      this.state = ktMakeState(gender, name);
      return this;
    },

    /* -----------------------------------------------------------------
       Главный конвейер ответа
       ----------------------------------------------------------------- */
    respond: function(text){
      var raw = String(text == null ? '' : text);

      /* 1. Извлечение сущностей и флагов */
      var entities = ktExtract(raw);

      /* 2. Sentiment */
      var senti = ktSentiment(entities.tokens, raw);

      /* 3. Интент (объект: {intent, topic?, entity?, pronoun?}) */
      var intentResult = ktNormalizeIntentResult(
        ktDetectIntent(raw, entities, this.state)
      );

      /* 4. Обновление состояния */
      ktUpdateState(this.state, entities, intentResult, senti, raw);

      /* 5. Генерация */
      var reply = ktGenerate(intentResult, entities, this.state);

      /* 6. Пост-обработка */
      if(!reply) reply = 'Хм...';
      this.state.lastAIMessage = reply;
      this.state.aiContext.unshift(reply);
      if(this.state.aiContext.length > KT.CTX_MAX){
        this.state.aiContext.pop();
      }

      return reply;
    },

    /* -----------------------------------------------------------------
       Диагностика (для отладки)
       ----------------------------------------------------------------- */
    debug: function(){
      var s = this.state;
      return {
        version: KT.VERSION,
        intentCount: Object.keys(KT_INTENT_PATTERNS).length,
        topicCount: Object.keys(KT_TOPIC_ROUTES).length,
        state: {
          msgCount: s.msgCount,
          userName: s.userName,
          userAge: s.userAge,
          mood: s.mood,
          userMood: s.userMood,
          relationship: s.relationship,
          trust: s.trust,
          energy: s.energy,
          boredom: s.boredom,
          engagement: s.engagement,
          currentTopic: s.currentTopic,
          topicDepth: s.topicDepth,
          entities: s.entities.length,
          likes: s.likes,
          dislikes: s.dislikes,
          hobbies: s.hobbies,
          lastIntent: s.lastIntent,
          lastTopic: s.lastTopic
        }
      };
    },

    /* -----------------------------------------------------------------
       Сброс (пересоздание с новой личностью)
       ----------------------------------------------------------------- */
    reset: function(){
      var isGirl = Math.random() < 0.5;
      var name = isGirl
        ? KT_GIRL_NAMES[Math.floor(Math.random() * KT_GIRL_NAMES.length)]
        : KT_BOY_NAMES[Math.floor(Math.random() * KT_BOY_NAMES.length)];
      var gender = isGirl ? 'girl' : 'boy';
      this.state = ktMakeState(gender, name);
      return this;
    }
  };

  /* --- Инициализация личности --- */
  var isGirl = Math.random() < 0.5;
  var name = isGirl
    ? KT_GIRL_NAMES[Math.floor(Math.random() * KT_GIRL_NAMES.length)]
    : KT_BOY_NAMES[Math.floor(Math.random() * KT_BOY_NAMES.length)];
  var gender = isGirl ? 'girl' : 'boy';

  AI.init(gender, name);
  return AI;
}

/* ============================================================================
   ИНСТАНС И ЭКСПОРТ
   ============================================================================ */

var _ai = makeKtalkAI();

return {
  async send(text, context){
    /* Защита от отсутствия KT.sleep */
    var delay = 350 + Math.random() * 500;
    if(typeof KT !== 'undefined' && typeof KT.sleep === 'function'){
      await KT.sleep(delay);
    } else {
      await new Promise(function(r){ setTimeout(r, delay); });
    }

    var reply;
    try {
      reply = _ai.respond(String(text == null ? '' : text));
    } catch(err){
      /* Защита: если что-то упало — не ломаем диалог */
      reply = 'Хм... Что-то я задумалась 🤔 Повтори?';
    }
    return reply || 'Хм...';
  },

  reset(){
    _ai = makeKtalkAI();
  },

  getThinking(){
    return null;
  },

  /* Диагностика — можно дёрнуть из консоли */
  debug(){
    return _ai.debug();
  }
};
</script>
<!--конец 6 части-->

<!-- ═══════════════════════════════════════════════════════════════
     ROFL PICKER v2 — самодостаточный. Вставлять перед </body>.
     Удаляет старые версии кнопки/модалки, создаёт новые.
     ═══════════════════════════════════════════════════════════════ -->

<script>
(function(){
'use strict';

/* ─── Убираем всё, что могло остаться от прошлых версий ─── */
var oldBtn = document.getElementById('btnRofl');
if (oldBtn && oldBtn.parentNode) oldBtn.parentNode.removeChild(oldBtn);
var oldOv = document.getElementById('roflPicker');
if (oldOv && oldOv.parentNode) oldOv.parentNode.removeChild(oldOv);

window.__KtRoflPickerLoaded = true;

var $id = function(s){ return document.getElementById(s); };

/* ─── Список rofl-* ─── */
function getRoflAIs(){
  try {
    if (!window.KT || typeof KT.listAIs !== 'function') return [];
    return KT.listAIs().filter(function(ai){
      return ai && ai.id && ai.id.indexOf('rofl-') === 0;
    });
  } catch(e){
    console.error('[rofl] getRoflAIs', e);
    return [];
  }
}

/* ─── Отрисовка ─── */
function renderRoflList(){
  var list = $id('roflList');
  if (!list) return;
  list.innerHTML = '';

  var ais = getRoflAIs();
  if (!ais.length){
    var empty = document.createElement('div');
    empty.className = 'empty';
    empty.innerHTML = 'Недоделанных ИИ нет.<br>' +
      'Чтобы добавить слот сюда, дай ему id вида <code>rofl-имя</code>.<br><br>' +
      'Например: <code>{ "id": "rofl-mybot", ... }</code>';
    list.appendChild(empty);
    return;
  }

  var activeId = (KT.mode && typeof KT.mode.getActiveAI === 'function')
    ? KT.mode.getActiveAI() : null;

  for (var i = 0; i < ais.length; i++){
    var ai = ais[i];
    var item = document.createElement('div');
    item.className = 'ai-item' + (ai.id === activeId ? ' active' : '');

    var avatarHtml;
    if (ai.avatar && String(ai.avatar).indexOf('http') === 0){
      avatarHtml = '<img src="' + KT.esc(ai.avatar) + '" alt="">';
    } else {
      avatarHtml = KT.esc(String(ai.avatar || '?'));
    }

    var shortId = String(ai.id).replace(/^rofl-/, '');
    var desc = ai.description || ('rofl · v' + (ai.version || '?'));

    item.innerHTML =
      '<div class="item-avatar" style="background:' + (ai.color || '#f59e0b') + '">' +
        avatarHtml +
      '</div>' +
      '<div class="item-info">' +
        '<div class="item-name">' + KT.esc(ai.name || shortId) + '</div>' +
        '<div class="item-desc">' + KT.esc(desc) + '</div>' +
      '</div>' +
      (ai.id === activeId
        ? '<span class="item-badge">активен</span>'
        : '<span class="item-badge" style="background:#f59e0b;color:#1a1030">rofl</span>');

    item.onclick = (function(id){
      return function(){
        try {
          KT.mode.setActiveAI(id);
          KT.mode.setMode('single');
          if (KT.UI && KT.UI.updateAISelector) KT.UI.updateAISelector();
          if (KT.UI && KT.UI.updateModeBadge) KT.UI.updateModeBadge();
          closeRofl();
          var ai = KT.getAI(id);
          if (KT.UI && KT.UI.toast && ai) KT.UI.toast('🤡 ' + ai.name);
        } catch(e){
          console.error('[rofl] select', e);
        }
      };
    })(ai.id);

    list.appendChild(item);
  }
}

/* ─── Открытие / закрытие ─── */
function openRofl(){
  renderRoflList();
  var ov = $id('roflPicker');
  if (ov) ov.classList.add('on');
}
function closeRofl(){
  var ov = $id('roflPicker');
  if (ov) ov.classList.remove('on');
}

/* ─── Создаём модалку ─── */
function createModal(){
  var ov = document.createElement('div');
  ov.className = 'overlay';
  ov.id = 'roflPicker';
  ov.innerHTML =
    '<div class="modal">' +
      '<div class="modal-head">' +
        '<h3>🤡 Недоделанные ИИ</h3>' +
        '<button class="close-btn" type="button" id="roflClose">✕</button>' +
      '</div>' +
      '<div class="modal-body">' +
        '<div class="ai-list" id="roflList"></div>' +
      '</div>' +
    '</div>';

  ov.addEventListener('click', function(e){
    if (e.target === ov) closeRofl();
  });

  document.body.appendChild(ov);

  var closeBtn = $id('roflClose');
  if (closeBtn){
    closeBtn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      closeRofl();
    });
  }
}

/* ─── Создаём кнопку ─── */
function createButton(){
  var header = $id('header');
  if (!header) return false;

  var btn = document.createElement('button');
  btn.className = 'icon-btn';
  btn.id = 'btnRofl';
  btn.type = 'button';
  btn.title = 'Недоделанные ИИ';
  btn.textContent = '🤡';

  btn.addEventListener('click', function(e){
    e.preventDefault();
    e.stopPropagation();
    try {
      if (KT.mode && typeof KT.mode.isRunning === 'function' && KT.mode.isRunning()){
        if (KT.UI && KT.UI.toast) KT.UI.toast('Бой идёт');
        return;
      }
      openRofl();
    } catch(err){
      console.error('[rofl] open', err);
    }
  });

  var aiSel = $id('aiSelector');
  if (aiSel && aiSel.parentNode === header){
    header.insertBefore(btn, aiSel.nextSibling);
  } else {
    header.appendChild(btn);
  }
  return true;
}

/* ─── Init: ждём, пока появятся header и модалка ─── */
function init(){
  var tries = 0;
  function attempt(){
    tries++;
    if (tries > 50) return; // 10 секунд попыток
    var header = $id('header');
    if (!header){ setTimeout(attempt, 200); return; }

    if (!$id('roflPicker')) createModal();
    if (!$id('btnRofl')) createButton();
  }
  attempt();
}

init();

document.addEventListener('keydown', function(e){
  if (e.key === 'Escape'){
    var ov = $id('roflPicker');
    if (ov && ov.classList.contains('on')) closeRofl();
  }
});

})();
</script>
<!-- ═══════════════════════════════════════════════════════════════ -->
 <script type="text/html" id="ai-slot-rofl-monkeybinary">
<!--
{ "id": "rofl-monkeybinary", "name": "Обезьян-Бинарник", "color": "#a16207",
  "avatar": "🐒", "description": "отвечает только У и А: 0 — У, 1 — А", "version": "1.2" }
-->
var VOWELS = 'аеёиоуыэюяaeiouy';

return {
  async send(text, ctx){
    await KT.sleep(250);
    var t = String(text || '').toLowerCase();
    var out = '';
    for (var i = 0; i < t.length; i++){
      var ch = t[i];
      if (VOWELS.indexOf(ch) >= 0) out += 'А';
      else if (/[а-яёa-z]/.test(ch)) out += 'У';
    }
    if (!out) out = KT.rnd(['У', 'А', 'УА', 'АУ']);
    return out;
  },
  reset(){},
  getThinking(){ return null; }
};
</script>
</body>
</html>