function pickPool(intent, level){
  var pool = POOLS[intent] || POOLS.fallback;
  var nStr = MEM.user.name || 'друг';
  var likesStr = MEM.user.likes.length ? MEM.user.likes.join(' и ') : 'это';
  var arr = (level === 'high') ? pool.high : (level === 'low') ? pool.low : pool.mid;
  var arrSafe = (arr && arr.length) ? arr : pool.mid;
  return rnd(arrSafe)
    .replace(/\{n\}/g, nStr)
    .replace(/\{a\}/g, MEM.user.age != null ? MEM.user.age : '...')
    .replace(/\{l\}/g, likesStr)
    .replace(/\{d\}/g, MEM.user.dislikes[0] || 'это')
    .replace(/\{h\}/g, MEM.user.hobby || 'это')
    .replace(/\{c\}/g, MEM.user.city || '...')
    .replace(/\{u\}/g, (MEM.user.name ? 'Тебя зовут '+MEM.user.name : 'пока мало данных') + (MEM.user.age ? ', тебе '+MEM.user.age : '') + (MEM.user.city ? ', из '+MEM.user.city : ''));
}

function v3Pick(intent, level){
  var reply = pickPool(intent, level);
  if (!MEM.usedReplies[reply]){
    MEM.usedReplies[reply] = true;
    var keys = Object.keys(MEM.usedReplies);
    if (keys.length > 60){ for (var i = 0; i < 20; i++) delete MEM.usedReplies[keys[i]]; }
    return reply;
  }
  for (var a = 0; a < 8; a++){
    var r2 = pickPool(intent, level);
    if (!MEM.usedReplies[r2]){ MEM.usedReplies[r2] = true; return r2; }
  }
  return reply;
}

/* ═══════════════════════ nTR-ЧАСТЬ ═══════════════════════ */
function parseMessage(text){
  var sentences = splitSentences(text);
  var clauses = [];
  for (var si = 0; si < sentences.length; si++){
    var s = sentences[si];
    var isQ = /\?$/.test(s) || /^(?:что|кто|где|когда|почему|зачем|как|сколько|какой|какая|какое|какие|куда|откуда)\b/i.test(s.trim());
    var parts = splitClauses(s);
    for (var pi = 0; pi < parts.length; pi++){
      var p = parts[pi];
      if (p.length < 1) continue;
      var partIsQ = isQ && (parts.length === 1 || /^(?:и\s+)?(?:как|что|кто|где|когда|почему|зачем|сколько|какой|какая|какое|какие|куда|откуда)\b/i.test(p) || /\?$/.test(s));
      clauses.push({ text:p.trim(), isQuestion:partIsQ });
    }
  }
  return clauses.length ? clauses : [{ text:text.trim(), isQuestion:false }];
}

function extractFacts(text){
  var found = [];
  for (var i = 0; i < FACT_RULES.length; i++){
    var r = FACT_RULES[i];
    var m = text.match(r.re);
    if (!m || !m[1]) continue;
    var v = r.post ? r.post(m[1]) : m[1];
    if (!v) continue;
    if (r.key === 'name'){
      if (SURNAMES_RE.test(v) || COMMON_NAMES_RE.test(v)) continue;
      MEM.user.name = v;
    } else if (r.append){
      if (MEM.user[r.key].indexOf(v) === -1) MEM.user[r.key].push(v);
    } else {
      MEM.user[r.key] = v;
    }
    found.push({ key:r.key, value:v });
  }
  return found;
}

function classifyClause(clause){
  var text = clause.text.toLowerCase();
  var stems = contentStems(text);
  var wt = tokens(text);

  if (/\b(?:как тебя зовут|твоё имя|как звать|представься|назови себя)\b/i.test(text)) return { type:'self_name', hits:3, score:10 };
  if (/\b(?:сколько тебе лет|твой возраст|сколько тебе)\b/i.test(text)) return { type:'self_age', hits:3, score:10 };
  if (/\b(?:где ты живёшь|твой город|где обитаешь|ты откуда)\b/i.test(text)) return { type:'self_city', hits:3, score:10 };
  if (/\b(?:что ты умеешь|твои возможности)\b/i.test(text)) return { type:'self_abilities', hits:3, score:10 };
  if (/\b(?:кто ты|ты человек|ты бот|ты ии)\b/i.test(text)) return { type:'self_who', hits:3, score:10 };

  var math = solveMath(text);
  if (math && /\d/.test(text) && /[+\-*/×÷^]/.test(text)) return { type:'math', hits:3, score:10, data:math };

  if (KW_FLAT.greet.some(function(w){ return wt[0] === w || text.indexOf(w) === 0; })) return { type:'greet', hits:2, score:8 };
  if (KW_FLAT.bye.some(function(w){ return wt[0] === w; })) return { type:'bye', hits:2, score:8 };
  if (KW_FLAT.thanks.some(function(w){ return text.indexOf(w) !== -1; })) return { type:'thanks', hits:2, score:8 };
  if (KW_FLAT.sorry.some(function(w){ return text.indexOf(w) !== -1; })) return { type:'sorry', hits:2, score:8 };

  var bestTopic = null, bestScore = 0, bestHits = 0;
  for (var ti = 0; ti < TOPIC_KEYS.length; ti++){
    var key = TOPIC_KEYS[ti];
    var kws = T[key][0].split(' ');
    var hits = 0;
    for (var ki = 0; ki < kws.length; ki++){
      if (wt.indexOf(kws[ki]) !== -1 || stems.indexOf(stem(kws[ki])) !== -1) hits++;
    }
    if (hits > 0 && hits > bestScore){ bestScore = hits; bestHits = hits; bestTopic = key; }
  }
  if (bestTopic) return { type:'topic:' + bestTopic, hits:bestHits, score:bestScore * 2 };

  var kwHits = 0;
  for (var wi = 0; wi < wt.length; wi++) if (KW_LOOKUP.has(wt[wi])) kwHits++;
  if (clause.isQuestion) return { type:'generic_question', hits:kwHits, score:kwHits };
  return { type:'generic_statement', hits:kwHits, score:kwHits };
}

function normalize(s){ return String(s || '').toLowerCase().replace(/[^а-яёa-z0-9]/g, ''); }
function similarity(a, b){
  if (!a || !b) return 0;
  var n = Math.min(a.length, b.length, 40), m = 0;
  for (var i = 0; i < n; i++) if (a[i] === b[i]) m++;
  return m / Math.max(a.length, b.length);
}
function isEchoOrRepeat(reply, userText){
  var r = normalize(reply), u = normalize(userText);
  if (r && u && r === u) return true;
  for (var i = 0; i < MEM.recentReplies.length; i++) if (normalize(MEM.recentReplies[i]) === r) return true;
  var sk = r.slice(0, 32);
  for (var j = 0; j < MEM.skeletons.length; j++) if (similarity(sk, MEM.skeletons[j]) > 0.75) return true;
  return false;
}
function rememberReply(r){
  MEM.recentReplies.push(r);
  if (MEM.recentReplies.length > 30) MEM.recentReplies.shift();
  MEM.skeletons.push(normalize(r).slice(0, 32));
  if (MEM.skeletons.length > 40) MEM.skeletons.shift();
}

function candidatePool(cls){
  var pool = [];
  if (cls.type.indexOf('topic:') === 0){
    var key = cls.type.slice(6);
    var e = T[key];
    if (e) for (var i = 0; i < e[1].length; i++) pool.push({ text:e[1][i], weight:3, source:key });
  } else if (cls.type === 'self_name'){
    for (var a = 0; a < SELF.ans.name.length; a++) pool.push({ text:SELF.ans.name[a], weight:10, source:'self_name' });
  } else if (cls.type === 'self_age'){
    for (var b = 0; b < SELF.ans.age.length; b++) pool.push({ text:SELF.ans.age[b], weight:10, source:'self_age' });
  } else if (cls.type === 'self_city'){
    for (var c = 0; c < SELF.ans.city.length; c++) pool.push({ text:SELF.ans.city[c], weight:10, source:'self_city' });
  } else if (cls.type === 'self_abilities'){
    for (var d = 0; d < SELF.ans.abilities.length; d++) pool.push({ text:SELF.ans.abilities[d], weight:10, source:'self_ab' });
  } else if (cls.type === 'self_who'){
    for (var f = 0; f < SELF.ans.who.length; f++) pool.push({ text:SELF.ans.who[f], weight:10, source:'self_who' });
  } else if (cls.type === 'math'){
    pool.push({ text: cls.data.expr + ' = ' + cls.data.value, weight:100, source:'math' });
  } else if (cls.type === 'greet'){
    for (var g = 0; g < T.greet[1].length; g++) pool.push({ text:T.greet[1][g], weight:5, source:'greet' });
  } else if (cls.type === 'bye'){
    for (var h = 0; h < T.bye[1].length; h++) pool.push({ text:T.bye[1][h], weight:5, source:'bye' });
  } else if (cls.type === 'thanks'){
    for (var k = 0; k < T.thanks[1].length; k++) pool.push({ text:T.thanks[1][k], weight:5, source:'thanks' });
  } else if (cls.type === 'sorry'){
    for (var l = 0; l < T.sorry[1].length; l++) pool.push({ text:T.sorry[1][l], weight:5, source:'sorry' });
  } else if (cls.type === 'generic_question'){
    pool.push({ text:'Хм, интересный вопрос. Дай подумать…', weight:1, source:'gq' });
    pool.push({ text:'Не уверена, что поняла. Переформулируешь?', weight:1, source:'gq' });
    pool.push({ text:'Спроси иначе, а? Так будет точнее.', weight:1, source:'gq' });
    pool.push({ text:'Интересно. Расскажи больше.', weight:1, source:'gq' });
    pool.push({ text:'Хм. А ты сам что думаешь?', weight:1, source:'gq' });
  } else if (cls.type === 'generic_statement'){
    pool.push({ text:'Поняла.', weight:1, source:'gs' });
    pool.push({ text:'Ага, ясно.', weight:1, source:'gs' });
    pool.push({ text:'Интересно. Продолжай.', weight:1, source:'gs' });
    pool.push({ text:'Мг. Что дальше?', weight:1, source:'gs' });
    pool.push({ text:'Расскажи ещё.', weight:1, source:'gs' });
  }
  if (!pool.length){
    pool.push({ text:'Расскажи подробнее.', weight:1, source:'fb' });
    pool.push({ text:'Не поняла до конца. Поясни?', weight:1, source:'fb' });
  }
  return pool;
}

function scoreCandidate(cand, cls, userText){
  var score = cand.weight || 1;
  if (isEchoOrRepeat(cand.text, userText)) score -= 50;
  if (/не знаю|не уверена|не поняла|переформулируй/i.test(cand.text)) score -= 5;
  if (MEM.mood < 40 && /\?|!/.test(cand.text)) score -= 1;
  if (userText.length > 60 && cand.text.length > 60) score += 1;
  if (userText.length < 20 && cand.text.length < 40) score += 1;
  if (/^(Поняла|Ясно|Ладно|Ага)\.?$/i.test(cand.text.trim())) score -= 2;
  score += Math.random() * 1.2;
  return score;
}

function reason(cls, userText){
  var pool = candidatePool(cls);
  var best = null, bestScore = -Infinity;
  var tried = {};
  for (var i = 0; i < 40; i++){
    var cand = pool[(Math.random() * pool.length) | 0];
    var key = cand.source + '::' + cand.text.slice(0, 24);
    if (tried[key] && pool.length > 3) continue;
    tried[key] = true;
    var s = scoreCandidate(cand, cls, userText);
    if (s > bestScore){ bestScore = s; best = cand; }
  }
  if (best && /не знаю|не уверена|не поняла/i.test(best.text)){
    for (var j = 0; j < pool.length; j++){
      if (!/не знаю|не уверена|не поняла/i.test(pool[j].text)) return pool[j];
    }
  }
  return best;
}

function findUnknownWords(text){
  var words = tokens(text);
  var unknown = [];
  for (var i = 0; i < words.length; i++){
    var w = words[i];
    if (w.length < 6) continue;
    if (STOP.has(w)) continue;
    if (/^\d+$/.test(w)) continue;
    if (KW_LOOKUP.has(w)) continue;
    if (SURNAMES_RE.test(w)) continue;
    if (/^[А-ЯЁ]/.test(w)) continue;
    if (/(ать|ять|еть|ить|ыть|оть|уть|ти|ем|им|ешь|ишь|ет|ит|ут|ют|ат|ят|ал|ил|ла|ло|ли|но|то|ко|во|ло|мо|шо)$/.test(w)) continue;
    var s = stem(w);
    var known = false;
    KW_LOOKUP.forEach(function(_v, k){ if (stem(k) === s) known = true; });
    if (known) continue;
    unknown.push(w);
  }
  return uniq(unknown);
}

function learnDefinition(word, text){
  var m = text.match(/(?:это|значит|означает|—|-)\s*(.+)$/i);
  var def = m ? m[1].trim() : text.trim();
  MEM.learned.set(word.toLowerCase(), def);
  return def;
}

/* ═══════════════════════ УРОВНИ ═══════════════════════ */
function relationshipLevel(){
  if (MEM.relationship < 20) return 'low';
  if (MEM.relationship < 55) return 'mid';
  return 'high';
}

/* ═══════════════════════ ГЛАВНЫЙ RESPOND ═══════════════════════ */
function respond(text, ctx){
  ctx = ctx || {};
  var fromAI = !!(ctx && ctx.fromAI);
  var t0 = nowMs();
  MEM.turn++;

  /* ждём определение */
  if (MEM.unknownAsked && !fromAI){
    var word = MEM.unknownAsked;
    MEM.unknownAsked = null;
    var def = learnDefinition(word, text);
    var reply0 = 'Поняла: «' + word + '» — это ' + def + '. Запомнила.';
    pushHistory('user', text); pushHistory('ai', reply0);
    rememberReply(reply0);
    return { reply:reply0, second:null, meta:{ learned:{word:word,definition:def}, latencyMs:+(nowMs()-t0).toFixed(2) } };
  }

  pushHistory('user', text);

  var clauses = parseMessage(text);
  var factsFound = [];

  /* ФИКС: если от ИИ — не извлекаем факты о пользователе */
  if (!fromAI){
    for (var ci = 0; ci < clauses.length; ci++){
      var v3 = v3Extract(clauses[ci].text);
      if (v3.name){ MEM.user.name = v3.name; factsFound.push({key:'name', value:v3.name}); }
      if (v3.age){ MEM.user.age = v3.age; factsFound.push({key:'age', value:v3.age}); }
      if (v3.city){ MEM.user.city = v3.city; factsFound.push({key:'city', value:v3.city}); }
      if (v3.like && MEM.user.likes.indexOf(v3.like) === -1){ MEM.user.likes.push(v3.like); factsFound.push({key:'likes', value:v3.like}); }
      if (v3.dislike && MEM.user.dislikes.indexOf(v3.dislike) === -1){ MEM.user.dislikes.push(v3.dislike); factsFound.push({key:'dislikes', value:v3.dislike}); }
      if (v3.hobby) MEM.user.hobby = v3.hobby;
      var ntrF = extractFacts(clauses[ci].text);
      for (var fi = 0; fi < ntrF.length; fi++){
        var f = ntrF[fi];
        var dup = factsFound.some(function(x){ return x.key === f.key && x.value === f.value; });
        if (!dup) factsFound.push(f);
      }
    }
  }

  var answers = [];
  var level = relationshipLevel();

  /* ФИКС: убраны 'question' и 'statement' из SPECIFIC_V3 */
  var SPECIFIC_V3 = ['greeting','farewell','love','sex','compliment','insult','thanks','apology','agree','disagree','maybe','flirt','ktalk','joke','good','bad','about_ai','about_user','name_intro','share_age','share_like','share_dislike','share_hobby','share_city','how_are_you','what_doing','confused','elaborate','challenge','topic_propose'];

  for (var ai = 0; ai < clauses.length; ai++){
    var c = clauses[ai];
    var v3e = v3Extract(c.text);
    var v3intent = v3DetectIntent(c.text, v3e);
    var v3senti = v3Sentiment(tokens(c.text));
    var ntrCls = classifyClause(c);

    /* от ИИ — не обновляем relationship от их реплик */
    if (!fromAI) v3Update(v3e, v3intent, v3senti, c.text);

    var answer = null;

    if (SPECIFIC_V3.indexOf(v3intent) !== -1 && v3intent !== 'other'){
      answer = v3Pick(v3intent, level);
    } else {
      var best = reason(ntrCls, c.text);
      if (best) answer = best.text;
    }
    if (answer) answers.push({ clause:c, v3Intent:v3intent, ntrType:ntrCls.type, answer:answer });
  }

  var reply = '';
  if (answers.length === 0){
    reply = pickPool('fallback', level);
  } else if (answers.length === 1){
    reply = answers[0].answer;
  } else {
    var qs = [], sts = [];
    for (var ai2 = 0; ai2 < answers.length; ai2++){
      if (answers[ai2].clause.isQuestion) qs.push(answers[ai2]);
      else sts.push(answers[ai2]);
    }
    var parts = [];
    if (factsFound.length && !fromAI){
      var summary = factsFound.map(function(f){
        if (f.key === 'name') return 'тебя зовут ' + f.value;
        if (f.key === 'age') return 'тебе ' + f.value;
        if (f.key === 'city') return 'ты из ' + f.value;
        if (f.key === 'likes') return 'ты любишь ' + f.value;
        if (f.key === 'dislikes') return 'ты не любишь ' + f.value;
        if (f.key === 'job') return 'работаешь ' + f.value;
        if (f.key === 'hobby') return 'увлекаешься ' + f.value;
        return f.key + ': ' + f.value;
      });
      parts.push('Запомнила: ' + summary.join(', ') + '.');
    }
    var rest = qs.length ? qs : sts;
    for (var ri = 0; ri < rest.length; ri++) parts.push(rest[ri].answer);
    reply = parts.join(' ');
  }

  /* ФИКС: удалён блок «Могу быть не точной» */

  /* обучение неизвестных слов — только от пользователя и только если совсем не понял */
/* обучение неизвестных слов — только если сообщение длинное и содержит НЕСКОЛЬКО неизвестных */
if (!fromAI){
  var lowScore = answers.length === 0 ||
    answers.every(function(a){
      return a.ntrType === 'generic_question' || a.ntrType === 'generic_statement';
    });
  var textWordCount = tokens(text).filter(function(w){ return !STOP.has(w); }).length;
  var isLongEnough = text.length >= 15 && textWordCount >= 3;
  if (lowScore && isLongEnough){
    var unknown = findUnknownWords(text);
    if (unknown.length >= 2 && !MEM.learned.has(unknown[0].toLowerCase())){
      MEM.unknownAsked = unknown[0];
      reply = 'Я не знаю, что такое «' + unknown[0] + '». Объяснишь?';
    }
  }
}

  /* настроение */
  var lower = text.toLowerCase();
  if (!fromAI){
    if (/спасибо|люблю|обожаю|привет|рад|круто|супер|нрав/.test(lower)) MEM.mood = clamp(MEM.mood + 3, 0, 100);
    if (/дурак|тупой|ненавижу|бесишь|блять|хуй|идиот/.test(lower)) MEM.mood = clamp(MEM.mood - 4, 0, 100);
    MEM.mood = clamp(MEM.mood + (60 - MEM.mood) * 0.02, 0, 100);
  }

  /* second */
  var second = null;
  if (!fromAI && MEM.mood > 55 && MEM.turn % 4 === 0 && Math.random() < 0.35){
    if (level === 'high'){
      second = rnd(['Кстати, ты как? 💜','Расскажи что-нибудь ещё, мне нравится тебя слушать 🥰','Ммм, обожаю наши разговоры 😏','Ты сегодня особенно интересный 💜']);
    } else {
      second = rnd(['Кстати, ты как?','Расскажи что-нибудь ещё.','Что нового у тебя?','А сам как думаешь?']);
    }
  }

  rememberReply(reply);
  pushHistory('ai', reply);
  if (second){ rememberReply(second); pushHistory('ai', second); }

  return {
    reply: reply,
    second: second,
    meta:{
      turn: MEM.turn,
      clauses: clauses.length,
      answers: answers.map(function(a){ return { v3:a.v3Intent, ntr:a.ntrType }; }),
      facts: factsFound.map(function(f){ return f.key; }),
      mood: MEM.mood,
      relationship: MEM.relationship,
      level: level,
      fromAI: fromAI,
      latencyMs: +(nowMs() - t0).toFixed(2)
    }
  };
}

function handleCommand(text){
  var m = text.match(/^\/mood\s*[:=]?\s*(\d+)/i);
  if (m){
    MEM.mood = clamp(parseInt(m[1], 10), 0, 100);
    return 'Настроение: ' + MEM.mood + '.';
  }
  var r = text.match(/^\/rel\s*[:=]?\s*(\d+)/i);
  if (r){
    MEM.relationship = clamp(parseInt(r[1], 10), 0, 100);
    return 'Relationship: ' + MEM.relationship + ' (' + relationshipLevel() + ').';
  }
  if (/^\/facts\b/i.test(text)){
    if (!MEM.user.name && MEM.user.age == null && !MEM.user.likes.length) return 'Пока ничего не помню о тебе.';
    var lines = [];
    if (MEM.user.name) lines.push('• имя: ' + MEM.user.name);
    if (MEM.user.age != null) lines.push('• возраст: ' + MEM.user.age);
    if (MEM.user.city) lines.push('• город: ' + MEM.user.city);
    if (MEM.user.job) lines.push('• работа: ' + MEM.user.job);
    if (MEM.user.hobby) lines.push('• хобби: ' + MEM.user.hobby);
    if (MEM.user.likes.length) lines.push('• любит: ' + MEM.user.likes.join(', '));
    if (MEM.user.dislikes.length) lines.push('• не любит: ' + MEM.user.dislikes.join(', '));
    if (MEM.user.has.length) lines.push('• имеет: ' + MEM.user.has.join(', '));
    return 'Помню:\n' + lines.join('\n');
  }
  if (/^\/learned\b/i.test(text)){
    if (!MEM.learned.size) return 'Пока ничего нового не выучила.';
    var lines2 = [];
    MEM.learned.forEach(function(v, k){ lines2.push('• ' + k + ' — ' + v); });
    return 'Выучила:\n' + lines2.join('\n');
  }
  if (/^\/stats\b/i.test(text)){
    return 'V3 Pro Max · ход: ' + MEM.turn + ' · relationship: ' + MEM.relationship + ' (' + relationshipLevel() + ') · mood: ' + MEM.mood;
  }
  if (/^\/reset\b/i.test(text)){
    MEM = createMEM();
    return 'Сброшено.';
  }
  return null;
}

function reset(){ MEM = createMEM(); }

return {
  respond: respond,
  handleCommand: handleCommand,
  reset: reset,
  getMemory: function(){ return MEM; },
  getMood: function(){ return { score: MEM.mood, name: MEM.mood >= 60 ? 'warm' : MEM.mood >= 40 ? 'neutral' : 'cold' }; },
  getFacts: function(){ return MEM.user; },
  getStats: function(){
    return {
      version: '3.0-promax',
      topics: TOPIC_KEYS.length,
      keywords: KW_TOTAL,
      templates: Object.keys(T).reduce(function(s, k){ return s + T[k][1].length; }, 0),
      intentsV3: Object.keys(POOLS).length,
      mood: MEM.mood,
      relationship: MEM.relationship,
      level: relationshipLevel(),
      turn: MEM.turn
    };
  }
};
}

/* ═══════════════════════ ОБЁРТКА ДЛЯ ПЕСОЧНИЦЫ ═══════════════════════ */
var _v3pm = makeV3ProMaxAI();

return {
  async send(text, ctx){
    await KT.sleep(280 + Math.random() * 400);
    try {
      var txt = String(text || '');
      var cmd = _v3pm.handleCommand(txt);
      if (cmd) return cmd;
      var r = _v3pm.respond(txt, ctx || {});
      var out = r.reply || '…';
      if (r.second) out = out + '\n' + r.second;
      return out;
    } catch(e){
      console.error('[v3promax]', e);
      return '…';
    }
  },
  reset(){ _v3pm = makeV3ProMaxAI(); },
  getThinking(){ return null; },
  getMood(){ return _v3pm.getMood(); },
  getMode(){
    var st = _v3pm.getStats();
    return st.level;
  },
  getFacts(){ return _v3pm.getFacts(); },
  getStats(){ return _v3pm.getStats(); }
};
</script>
<!-- ==================================================== -->

<script type="text/html" id="ai-slot-vsp1v">
<!--
{
  "id": "vsp1v",
  "name": "VSP 1V",
  "color": "#3b82f6",
  "avatar": "🌟",
  "description": "VSP 1V v1.3 — second-контроль: выдаётся только в 20-35% случаев, только для коротких reply, только для интентов, которым он уместен. Тон reply+second согласован. Иногда вопрос встраивается прямо в reply. ~1.99M честных параметров.",
  "version": "1.3"
}
-->

function makeVSP1V(){
  'use strict';

  var KT = (typeof window !== 'undefined' && window.KT) ? window.KT : {};
  var sleep = KT.sleep || function(ms){ return new Promise(function(r){ setTimeout(r, ms); }); };
  var rnd   = KT.rnd   || function(a){ return a[Math.floor(Math.random()*a.length)]; };

  var DIM = 96, VOCAB_MAX = 20000;
  var H1 = 160, H2 = 96, H3 = 96;
  var MOOD_K = 20, RT_K = 16;
  var POS_MAX = 64;
  var MEM_KEY = 'vsp1v_mem';
  var DEV = 'VSP 1V';

  var WIDX = new Map();
  var WORDS = [];
  var wc = 0;

  var SUFFIX = ['иями','ями','ами','ией','иям','ием','ов','ев','ей','ой','ый','ий','ая','ое','ые','ие',
    'ых','их','ую','юю','ать','ять','еть','ить','уть','ешь','ишь','ете','ите','ут','ют','ат','ят',
    'ла','ло','ли','ть','ся','сь','ы','и','а','я','о','е','у','ю','й','ь'];

  function stem(w){
    if (w.length <= 4) return w;
    for (var i=0;i<SUFFIX.length;i++){
      var s = SUFFIX[i];
      if (w.length - s.length >= 4 && w.slice(-s.length) === s) return w.slice(0, -s.length);
    }
    return w;
  }

  var STOP = new Set(('и в во не что он на я с со как а то все она так его но да ты к у же вы за бы по ' +
    'только ее мне было вот от меня еще нет о из ему теперь когда даже ну вдруг ли если уже или ни ' +
    'быть был него до вас нибудь опять уж вам ведь там потом себя ничего ей может они тут где есть ' +
    'надо ней для мы тебя их чем была сам чтоб без будто чего раз тоже себе под будет ж тогда кто ' +
    'этот того потому этого какой совсем ним здесь этом один почти мой тем чтобы нее сейчас были куда ' +
    'зачем всех никогда можно при наконец два об другой хоть после над больше тот через эти нас про ' +
    'всего них какая много разве три эту моя впрочем хорошо свою этой перед иногда лучше чуть том ' +
    'нельзя такой им более всегда конечно всю между').split(' '));

  var SEEDS = ('привет здравствуй приветствую пока прощай как дела что умеешь расскажи помоги ' +
    'спасибо благодарю извини прости да нет почему зачем когда где кто что это очень хорошо плохо ' +
    'люблю ненавижу нравится думаю знаю хочу могу буду есть было будет человек жизнь время день ' +
    'ночь утро вечер год месяц неделя друг подруга друзья чувство сердце мысль мечта надежда страх ' +
    'радость грусть счастье печаль работа учёба школа музыка песня фильм книга игра спорт еда вода ' +
    'небо солнце луна звёзды город дом семья мама папа брат сестра кот собака дети мир свет тьма ' +
    'смысл цель путь дорога начало конец смерть рождение новое старое тепло холодно жарко ветер дождь ' +
    'снег море река лес поле гора огонь камень воздух мечтать видеть слышать говорить молчать думать ' +
    'бояться смеяться плакать радоваться грустить хотеть уметь знать помнить забыть любить').split(' ');

  (function buildVocab(){
    var dict = (KT.DICT && KT.DICT.length) ? KT.DICT : null;
    if (dict){
      for (var i=0;i<dict.length && wc<VOCAB_MAX;i++){
        var w = String(dict[i]||'').toLowerCase().replace(/[^а-яёa-z0-9]/g,'');
        if (!w || w.length<2 || WIDX.has(w)) continue;
        WIDX.set(w, wc); WORDS.push(w); wc++;
      }
    }
    for (var j=0;j<SEEDS.length && wc<VOCAB_MAX;j++){
      var s = stem(SEEDS[j].toLowerCase());
      if (!s || s.length<2) continue;
      if (!WIDX.has(s)){ WIDX.set(s, wc); WORDS.push(s); wc++; }
    }
  })();

  var tokEmb     = new Float32Array(VOCAB_MAX * DIM);
  var posEmb     = new Float32Array(POS_MAX * DIM);
  var L1W = new Float32Array(DIM * H1);
  var L1b = new Float32Array(H1);
  var L2W = new Float32Array(H1 * H2);
  var L2b = new Float32Array(H2);
  var L3W = new Float32Array(H2 * H3);
  var L3b = new Float32Array(H3);
  var moodW = new Float32Array(DIM * MOOD_K);
  var moodB = new Float32Array(MOOD_K);
  var rtW   = new Float32Array(DIM * RT_K);
  var rtB   = new Float32Array(RT_K);

  var _rngState = 987654321;
  function rndn(){
    _rngState = (_rngState * 1103515245 + 12345) & 0x7fffffff;
    return (_rngState / 0x7fffffff) * 2 - 1;
  }
  (function initParams(){
    var k;
    for (k=0;k<tokEmb.length;k++) tokEmb[k] = rndn() * 0.05;
    for (var p=0;p<POS_MAX;p++)
      for (var d=0;d<DIM;d++) posEmb[p*DIM + d] = Math.sin((p+1) / Math.pow(10000, d/DIM));
    var sc1 = Math.sqrt(1/DIM), sc2 = Math.sqrt(1/H1), sc3 = Math.sqrt(1/H2);
    for (k=0;k<L1W.length;k++) L1W[k] = rndn() * sc1;
    for (k=0;k<L2W.length;k++) L2W[k] = rndn() * sc2;
    for (k=0;k<L3W.length;k++) L3W[k] = rndn() * sc3;
    for (k=0;k<moodW.length;k++) moodW[k] = rndn() * sc1;
    for (k=0;k<rtW.length;k++) rtW[k] = rndn() * sc1;
  })();

  function initNewWordEmb(newId){
    var newWord = WORDS[newId];
    if (!newWord) return;
    var first = newWord.charAt(0);
    var cands = [];
    for (var i = newId - 1; i >= 0 && cands.length < 5; i--){
      var w = WORDS[i];
      if (w && w.charAt(0) === first && Math.abs(w.length - newWord.length) <= 3) cands.push(i);
    }
    if (!cands.length){
      var s = (newId * 2654435761) | 0;
      for (var d0=0; d0<DIM; d0++){
        s = (s * 1103515245 + 12345) & 0x7fffffff;
        tokEmb[newId * DIM + d0] = ((s / 0x7fffffff) * 2 - 1) * 0.02;
      }
      return;
    }
    for (var d=0; d<DIM; d++){
      var sm = 0;
      for (var c=0; c<cands.length; c++) sm += tokEmb[cands[c]*DIM + d];
      tokEmb[newId*DIM + d] = sm / cands.length;
    }
  }

  function wid(w){
    var id = WIDX.get(w);
    if (id === undefined){
      if (wc >= VOCAB_MAX) return -1;
      id = wc; WIDX.set(w, id); WORDS.push(w); wc++;
      initNewWordEmb(id);
    }
    return id;
  }

  var TOK_CACHE = new Map();
  function tokenizeRaw(text){
    var m = String(text||'').toLowerCase().match(/[а-яёa-z0-9]+/g) || [];
    var out = [];
    for (var i=0;i<m.length;i++){
      var t = m[i];
      if (STOP.has(t) || t.length < 2) continue;
      out.push(stem(t));
    }
    return out;
  }
  function tokenize(text){
    var key = String(text||'');
    var cached = TOK_CACHE.get(key);
    if (cached) return cached;
    var t = tokenizeRaw(key);
    for (var i=0;i<t.length;i++) wid(t[i]);
    TOK_CACHE.set(key, t);
    if (TOK_CACHE.size > 500){
      var firstKey = TOK_CACHE.keys().next().value;
      TOK_CACHE.delete(firstKey);
    }
    return t;
  }

  function overlapTokens(text){
    var m = String(text||'').toLowerCase().match(/[а-яёa-z0-9]+/g) || [];
    var out = [];
    for (var i=0;i<m.length;i++){
      var t = m[i];
      if (t.length < 2) continue;
      out.push(stem(t));
    }
    return out;
  }

  function dot(a, b, off, n){ var s=0; for (var i=0;i<n;i++) s += a[i]*b[off+i]; return s; }

  function embed(tokens){
    var x = new Float32Array(DIM);
    if (!tokens.length) return x;
    var N = tokens.length;
    var mean = new Float32Array(DIM);
    var valid = 0;
    for (var i=0;i<N;i++){
      var id = WIDX.get(tokens[i]);
      if (id === undefined || id < 0) continue;
      var off = id * DIM;
      for (var d=0;d<DIM;d++) mean[d] += tokEmb[off+d];
      valid++;
    }
    if (valid === 0) return x;
    for (var d1=0;d1<DIM;d1++) mean[d1] /= valid;
    var mnorm = Math.sqrt(dot(mean, mean, 0, DIM)) || 1;
    for (var d2=0;d2<DIM;d2++) mean[d2] /= mnorm;
    var sq = Math.sqrt(DIM);
    var sims = new Float32Array(N);
    var maxSim = -Infinity;
    for (var j=0;j<N;j++){
      var jd = WIDX.get(tokens[j]);
      if (jd === undefined || jd < 0){ sims[j] = -1e9; continue; }
      var jo = jd * DIM;
      var s = 0;
      for (var d3=0;d3<DIM;d3++) s += tokEmb[jo+d3] * mean[d3];
      s /= sq; sims[j] = s;
      if (s > maxSim) maxSim = s;
    }
    var weights = new Float32Array(N);
    var sumW = 0;
    for (var j2=0;j2<N;j2++){
      if (sims[j2] < -1e8){ weights[j2] = 0; continue; }
      var e = Math.exp(sims[j2] - maxSim);
      weights[j2] = e; sumW += e;
    }
    if (sumW > 0) for (var j3=0;j3<N;j3++) weights[j3] /= sumW;
    for (var k=0;k<N;k++){
      var kd = WIDX.get(tokens[k]);
      if (kd === undefined || kd < 0) continue;
      var ko = kd * DIM;
      var po = Math.min(k, POS_MAX-1) * DIM;
      var wk = weights[k];
      for (var d4=0;d4<DIM;d4++) x[d4] += (tokEmb[ko+d4] + 0.3 * posEmb[po+d4]) * wk;
    }
    var xn = Math.sqrt(dot(x, x, 0, DIM)) || 1;
    for (var d5=0;d5<DIM;d5++) x[d5] /= xn;
    return x;
  }

  function cooccurUpdate(tokens, win, lr){
    for (var i=0;i<tokens.length;i++){
      var wi = WIDX.get(tokens[i]);
      if (wi === undefined || wi < 0) continue;
      var oi = wi * DIM;
      var lim = Math.min(i + win, tokens.length - 1);
      for (var j=i+1;j<=lim;j++){
        var wj = WIDX.get(tokens[j]);
        if (wj === undefined || wj < 0 || wj === wi) continue;
        var oj = wj * DIM;
        for (var d=0;d<DIM;d++){
          var a = tokEmb[oi+d], b = tokEmb[oj+d];
          tokEmb[oi+d] = a + lr * (b - a);
          tokEmb[oj+d] = b + lr * (a - b);
        }
      }
    }
  }

  function forwardMLP(x){
    var h1 = new Float32Array(H1);
    for (var o=0;o<H1;o++){
      var s = L1b[o], off = o*DIM;
      for (var d=0;d<DIM;d++) s += L1W[off+d] * x[d];
      h1[o] = s > 0 ? s : 0;
    }
    var h2 = new Float32Array(H2);
    for (var o2=0;o2<H2;o2++){
      var s2 = L2b[o2], off2 = o2*H1;
      for (var a=0;a<H1;a++) s2 += L2W[off2+a] * h1[a];
      h2[o2] = s2 > 0 ? s2 : 0;
    }
    var h3 = new Float32Array(H3);
    for (var o3=0;o3<H3;o3++){
      var s3 = L3b[o3], off3 = o3*H2;
      for (var b=0;b<H2;b++) s3 += L3W[off3+b] * h2[b];
      h3[o3] = s3;
    }
    return { h1: h1, h2: h2, h3: h3 };
  }

  function deltaUpdate(x, h1, h2, h3, target, lr){
    var e3 = new Float32Array(H3);
    for (var i=0;i<H3;i++){
      var t = (i < target.length) ? target[i] : 0;
      e3[i] = t - h3[i];
    }
    for (var o3=0;o3<H3;o3++){
      var eo3 = e3[o3]; if (Math.abs(eo3) < 1e-8) continue;
      var off3 = o3*H2;
      for (var b=0;b<H2;b++) L3W[off3+b] += lr * eo3 * h2[b];
      L3b[o3] += lr * eo3;
    }
    var e2 = new Float32Array(H2);
    for (var b2=0;b2<H2;b2++){
      var s2 = 0;
      for (var o3b=0;o3b<H3;o3b++) s2 += e3[o3b] * L3W[o3b*H2 + b2];
      e2[b2] = s2 * (h2[b2] > 0 ? 1 : 0);
    }
    for (var o2=0;o2<H2;o2++){
      var eo2 = e2[o2]; if (Math.abs(eo2) < 1e-8) continue;
      var off2 = o2*H1;
      for (var a=0;a<H1;a++) L2W[off2+a] += lr * eo2 * h1[a];
      L2b[o2] += lr * eo2;
    }
    var e1 = new Float32Array(H1);
    for (var a2=0;a2<H1;a2++){
      var s1 = 0;
      for (var o2b=0;o2b<H2;o2b++) s1 += e2[o2b] * L2W[o2b*H1 + a2];
      e1[a2] = s1 * (h1[a2] > 0 ? 1 : 0);
    }
    for (var o1=0;o1<H1;o1++){
      var eo1 = e1[o1]; if (Math.abs(eo1) < 1e-8) continue;
      var off1 = o1*DIM;
      for (var d=0;d<DIM;d++) L1W[off1+d] += lr * eo1 * x[d];
      L1b[o1] += lr * eo1;
    }
  }

  // ---------- INTENTS ----------
  var INTENTS = [];
  function I(n,k,T,f,e){ INTENTS.push({ n:n, k:k, T:T, f:f||[], e:e||[] }); }

