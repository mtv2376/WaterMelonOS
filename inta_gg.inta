<style>
#devOverlay{position:fixed;inset:0;background:rgba(0,0,0,.85);
  display:none;align-items:center;justify-content:center;padding:16px;
  backdrop-filter:blur(8px);z-index:980;overflow-y:auto;}
#devOverlay.on{display:flex;}
.dev-modal{background:var(--bg2);border:1px solid var(--border2);
  border-radius:20px;max-width:880px;width:100%;max-height:94vh;
  display:flex;flex-direction:column;overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.8);}
.dev-head{flex:none;display:flex;align-items:center;gap:10px;
  padding:14px 18px;border-bottom:1px solid var(--border);
  background:var(--bg3);}
.dev-head h3{margin:0;font-size:15px;flex:1;color:var(--text);}
.dev-close{background:transparent;border:0;color:var(--text-muted);
  font-size:18px;cursor:pointer;padding:4px 8px;border-radius:6px;
  font-family:inherit;}
.dev-close:active{background:var(--accent-soft);}
.dev-body{flex:1;overflow-y:auto;padding:20px 26px 40px;
  -webkit-overflow-scrolling:touch;color:var(--text);font-size:13.5px;
  line-height:1.7;user-select:text;-webkit-user-select:text;}

.dev-body h1{font-size:22px;margin:0 0 8px;color:var(--accent);}
.dev-body h2{font-size:17px;margin:32px 0 10px;color:var(--accent2);
  border-bottom:1px solid var(--border);padding-bottom:6px;}
.dev-body h3{font-size:14.5px;margin:20px 0 8px;color:var(--text3);}
.dev-body h4{font-size:13px;margin:14px 0 6px;color:var(--text2);
  font-weight:700;}
.dev-body p{margin:10px 0;}
.dev-body code{background:var(--bg3);border:1px solid var(--border);
  padding:1px 6px;border-radius:4px;font-family:ui-monospace,monospace;
  font-size:12px;color:#86efac;}
.dev-body pre{background:var(--bg);border:1px solid var(--border2);
  border-radius:10px;padding:14px 16px;overflow-x:auto;
  font-family:ui-monospace,monospace;font-size:12px;
  line-height:1.6;color:var(--text2);margin:12px 0;
  white-space:pre;}
.dev-body pre code{background:transparent;border:0;padding:0;
  color:inherit;font-size:inherit;white-space:pre;}
.dev-body ul,.dev-body ol{margin:10px 0;padding-left:24px;}
.dev-body li{margin:5px 0;}
.dev-body table{width:100%;border-collapse:collapse;margin:12px 0;
  font-size:12.5px;}
.dev-body th,.dev-body td{border:1px solid var(--border);
  padding:8px 10px;text-align:left;vertical-align:top;}
.dev-body th{background:var(--bg3);color:var(--text2);font-weight:800;}
.dev-body .note{background:rgba(251,191,36,.08);border-left:3px solid var(--warn);
  padding:12px 16px;border-radius:6px;margin:14px 0;color:#fde68a;}
.dev-body .warn{background:rgba(239,68,68,.08);border-left:3px solid var(--danger);
  padding:12px 16px;border-radius:6px;margin:14px 0;color:#fca5a5;}
.dev-body .ok{background:rgba(34,197,94,.08);border-left:3px solid var(--ok);
  padding:12px 16px;border-radius:6px;margin:14px 0;color:#86efac;}
.dev-toc{background:var(--bg3);border:1px solid var(--border);
  border-radius:10px;padding:14px 20px;margin-bottom:22px;}
.dev-toc a{color:var(--accent);text-decoration:none;
  display:block;padding:3px 0;font-size:12.5px;}
