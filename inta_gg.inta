var FALLBACK = { id: 'fallback', k: [], r: [
  'Ага. Понял.',
  'Ну-ну. Интересно.',
  'Хм. А что дальше?',
  'Забавно.',
  'О, вот это поворот.',
  'Я подумаю над этим. Где-то через час.',
  'Понял. Не понял. Но кивнул.',
