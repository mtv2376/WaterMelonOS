   'умница умный умно интересный интересно добрый нежный теплый уютный заботливый ' +
   'внимательный уважаю ценю дорогой вкусный вкусно'
  ).split(' ').forEach(function(w){ POS[w]=1; });

  var NEG = {};
  ('плохой плохо грустный грустно грусть ненавижу ненависть бесит бесишь злой злоба ' +
   'злюсь тупой тупо тупая идиот дебил дурак дура кретин придурок устал устала ' +
   'усталость тяжелый тяжело депрессия печаль печальный боль больно обида обидно ' +
   'обижен скучный скучно ужасный ужасно кошмар страдать страдание проблема ' +
   'страшный страшно страх раздражает раздражение паршиво отстой фигня хреново ' +
   'дерьмо гадость мерзость убитый разбит сломан уныние тоска жаль жалко слабый ' +
   'неудача провал ошибка облом огорчен расстроен беда несчастье невкусный невкусно'
  ).split(' ').forEach(function(w){ NEG[w]=1; });

  var MAT_ROOTS = ['хуй','хуя','хую','хуё','хуе','хуи','хуйн','хер','хрен',
    'пизд','пизж','бляд','блят','бля','ёб','ебал','ебан','ебуч','ебат','ебну','ебла','еби',
    'сук','суч','муда','муди','жоп','говн','пидор','пидар','педик','дроч','гандон','гондон',
    'уеб','уёб','заеб','заёб','наеб','наёб','отъеб','отъёб','подъеб','подъёб','разъеб',
    'разъёб','приеб','приёб','въеб','въёб','съеб','съёб','выёб','выеб','переёб','перееб',
    'шлюх','шлюш','долбо','срак','срал','сру','срать'];
  var MAT_MILD = ['блин','фиг','капец','пипец','чёрт','черт','херня','фигня'];
  var SEX_ROOTS = ['секс','сексуал','трах','трахн','переспать','перепихн','минет',
    'дилдо','вибратор','член','пенис','вагин','порно','порнух','оргазм','кончить',
    'возбудил','возбуд','эрекц','эрекция','голый','голая','раздева','интим','близость',
    'ласкать','ласки','поцелую','поцелуй','кисн','оргия','бдсм','стриптиз','эротик',
    'разврат','сперм','проститутк'];
  var INSULT_WORDS = {};
  ('дурак дура дурочка идиот идиотка дебил дебилка кретин кретинка придурок тупой ' +
   'тупая тупица убогий убогая мразь тварь скотина сволочь гад гадина ублюдок ' +
   'дегенерат шизофреник псих ненормальный даун олень лох лохушка чмо ничтожество ' +
   'козел козёл баран осёл осел свинья'
  ).split(' ').forEach(function(w){ INSULT_WORDS[w]=1; });

  var NAME_BLOCK = {};
  ('грязный чистый умный глупый тупой злой добрый хороший плохой красивый страшный ' +
   'весёлый веселый грустный смешной серьёзный ленивый быстрый медленный мусорный ' +
   'мусорная вонючий вонючая большой маленький новый старый молодой сильный слабый ' +
   'красный синий зелёный жёлтый чёрный белый серый розовый голубой фиолетовый ' +
   'оранжевый привет пока спасибо пожалуйста извини прости да нет ок норм крутой ' +
   'крутая тоже такой такая только очень просто мужчина женщина парень девушка ' +
   'человек бог дурак дура нормально хай сам сама кто что это всё все моё твоё ' +
   'незнаю зачем почему когда где какая какой какие сколько потому не конечно ' +
   'точно ясно понял поняла понятно ладно знаю знаешь думаю думаешь окей мисс ' +
   'миссис сэр господин товарищ'
  ).split(' ').forEach(function(w){ NAME_BLOCK[w]=1; });

  var NAMES_M = {};
  ('александр алексей андрей антон аркадий арсений артём артем артур борис вадим ' +
   'валентин валерий василий виктор виталий владимир владислав вячеслав геннадий ' +
   'георгий глеб григорий даниил данил денис дмитрий евгений егор иван игнат игорь ' +
   'илья кирилл константин лев леонид максим марк матвей михаил никита николай олег ' +
   'павел петр пётр роман руслан сергей станислав степан тимофей тимур федор фёдор ' +
   'филипп эдуард юрий ярослав ян саша ваня вова дима коля миша петя серёжа андрюха ' +
   'богдан валера витя гена гоша гриша даня егорка игорёк илюша костя лёша макс рома ' +
   'сеня сёма слава стёпа толя тоха федя эдик юра ярик захар ефим давид макар'
  ).split(' ').forEach(function(w){ NAMES_M[w]=1; });

  var NAMES_F = {};
  ('александра алёна алина алиса алла анастасия ангелина анна антонина валентина ' +
   'валерия вера вероника виктория галина дарья даша диана ева евгения екатерина ' +
   'елена елизавета жанна зинаида зоя инна ирина карина каролина ксения кристина ' +
   'лариса лидия лилия любовь людмила маргарита марина мария маша милана надежда ' +
   'наталья нина оксана олеся ольга полина раиса регина рината светлана соня софия ' +
   'софья тамара татьяна ульяна юлия яна ярослава катя катюша настя лена ира оля ' +
   'света таня юля зина люба даша машенька вика кира лиза мила нелли рита роза саша'
  ).split(' ').forEach(function(w){ NAMES_F[w]=1; });

  var CITIES = {};
  ('москва питер санкт-петербург спб новосибирск екатеринбург казань самара омск ' +
   'челябинск ростов уфа красноярск воронеж пермь волгоград краснодар саратов тюмень ' +
   'тольятти ижевск барнаул ульяновск иркутск хабаровск ярославль владивосток ' +
   'махачкала томск оренбург кемерово новокузнецк рязань астрахань пенза липецк киров ' +
   'чебоксары тула калининград курск сочи ставрополь тверь магнитогорск иваново брянск ' +
   'белгород сургут владимир архангельск череповец смоленск курган орёл орел вологда ' +
   'саранск якутск мурманск тамбов грозный петрозаводск кострома новороссийск таганрог ' +
   'сыктывкар нальчик шахты дзержинск орск братск ангарск благовещенск королёв мытищи ' +
   'химки подольск люберцы красногорск балашиха крым беларусь минск киев харьков одесса ' +
   'львов гомель брест витебск гродно могилев бобруйск алматы астана ташкент бишкек ' +
   'душанбе ереван тбилиси баку лондон париж берлин мадрид рим вена прага амстердам ' +
   'барселона лиссабон чикаго майами токио пекин шанхай сеул сингапур бангкок дубай ' +
   'стамбул каир хельсинки стокгольм осло варшава будапешт севастополь симферополь ' +
   'ялта керчь адлер геленджик анапа кталк-сити кталкград кталкбург кталово'
  ).split(' ').forEach(function(w){ CITIES[w]=1; });

  function tokenize(text){
    return lc(stripEmoji(text))
      .replace(/[^\wа-яё\s-]+/gi, ' ')
      .split(/\s+/)
      .filter(function(w){ return w.length > 0; });
  }
  function stemWord(w){
    if(!w || w.length < 4) return w;
    for(var i=0;i<SUFFIXES.length;i++){
      var s = SUFFIXES[i];
      if(w.length - s.length >= 3 && w.slice(-s.length) === s) return w.slice(0, -s.length);
    }
    return w;
  }
  function hasMat(text){
    var t = ' ' + lc(stripEmoji(text)) + ' ';
    for(var i=0;i<MAT_ROOTS.length;i++) if(t.indexOf(MAT_ROOTS[i]) !== -1) return true;
    return false;
  }
  function hasMatMild(text){
    var t = ' ' + lc(stripEmoji(text)) + ' ';
    for(var i=0;i<MAT_MILD.length;i++) if(t.indexOf(MAT_MILD[i]) !== -1) return true;
    return false;
  }
  function hasSex(text){
    var t = ' ' + lc(stripEmoji(text)) + ' ';
    for(var i=0;i<SEX_ROOTS.length;i++) if(t.indexOf(SEX_ROOTS[i]) !== -1) return true;
    return false;
  }
  function findInsultWord(tokens){
    for(var i=0;i<tokens.length;i++){
      if(INSULT_WORDS[tokens[i]]) return tokens[i];
      var st = stemWord(tokens[i]);
      if(INSULT_WORDS[st]) return st;
    }
    return null;
  }
  function anyStem(stems, prefixes){
    for(var i=0;i<stems.length;i++)
      for(var j=0;j<prefixes.length;j++)
        if(stems[i].indexOf(prefixes[j]) === 0) return true;
    return false;
  }
  function isRefusalText(str){
    var s = trimP(str);
    if(!s) return false;
    var pats = [/^не\s*знаю$/i,/^незнаю$/i,/^не\s*помню$/i,/^забыл[аи]?$/i,/^не\s*скажу$/i,
      /^секрет$/i,/^не\s*хочу$/i,/^не\s*буду$/i,/^хз$/i,/^без\s*понятия$/i,/^нет$/i,
      /^нет,?\s*спасибо$/i,/^ничего$/i,/^ничё$/i,/^ниче$/i,/^никак$/i];
    for(var i=0;i<pats.length;i++) if(pats[i].test(s)) return true;
    return false;
  }

  function analyze(text){
    var str = String(text);
    var cleaned = stripEmoji(str);
    var tokens = tokenize(str);
    var content = [];
    for(var i=0;i<tokens.length;i++){
      var t = tokens[i];
      if(!STOP[t] && !FILLER[t] && t.length >= 2) content.push(t);
    }
    var seen = {}, stems = [];
    for(var j=0;j<content.length;j++){
      var s = stemWord(content[j]);
      if(!seen[s]){ seen[s]=1; stems.push(s); }
    }
    var lowered = ' ' + lc(cleaned) + ' ';
    var senti = 0;
    for(var k=0;k<stems.length;k++){
      var ss = stems[k];
      for(var p in POS){ if(ss.indexOf(p) === 0){ senti++; break; } }
      for(var n in NEG){ if(ss.indexOf(n) === 0){ senti--; break; } }
    }
    if(/\bне\s+(нрав|любл|хорош|люблю|уважаю|ценю)/.test(lowered)) senti -= 2;
    if(/\bне\s+плох/.test(lowered)) senti += 1;

    var mat = hasMat(str);
    var matMild = !mat && hasMatMild(str);
    var sex = hasSex(str);
    var insultWord = findInsultWord(content);
    if(mat || insultWord) senti = Math.min(senti, -2);
    if(matMild) senti = Math.min(senti, -1);
    senti = senti >= 2 ? 2 : senti <= -2 ? -2 : senti > 0 ? 1 : senti < 0 ? -1 : 0;

    var isQuestion = /\?/.test(str) ||
      /^\s*(?:что|как|где|когда|почему|зачем|кто|какой|какая|какие|какую|сколько|куда|откуда|чей|чья|чьё|можно|стоит|можешь|может)\b/i.test(str);

    return {
      text: str,
      cleaned: cleaned,
      trimmed: trimP(str),
      lower: lowered,
      tokens: tokens,
      content: content,
      stems: stems,
      sentiment: senti,
      isQuestion: isQuestion,
      wordCount: tokens.length,
      isShort: tokens.length <= 3,
      isVeryShort: tokens.length <= 1,
      hasDigits: /\d/.test(str),
      isDigitsOnly: /^\s*\d+\s*[.!?]?\s*$/.test(cleaned),
      isRefusal: isRefusalText(str),
      hasMat: mat,
      hasMatMild: matMild,
      hasSex: sex,
      insultWord: insultWord
    };
  }

  function extractName(raw){
    if(!raw) return null;
    var str = trimP(raw);
    if(!str) return null;
    if(/\d/.test(str)) return null;
    var m = str.match(/(?:меня\s+зовут|мо[её]\s+имя|зови\s+меня|можно\s+просто|моё имя|мое имя)\s+(.+)/i);
    if(m && m[1]){
      var phrase = m[1].trim();
      var words = phrase.split(/\s+/).slice(0,3);
      var clean = [];
      for(var i=0;i<words.length;i++){
        var w = words[i].replace(/[^\wа-яёA-Za-z-]/gi,'');
        if(w.length >= 2 && !NAME_BLOCK[lc(w)] && !FILLER[lc(w)]) clean.push(w);
      }
      if(clean.length){
        clean[0] = ucFirst(clean[0]);
        for(var j=1;j<clean.length;j++) clean[j] = lc(clean[j]);
        return clean.join(' ');
      }
    }
    var simple = str.match(/^([А-ЯЁA-Zа-яёa-z][\wа-яё-]{1,20}(?:\s+[А-ЯЁA-Zа-яёa-z][\wа-яё-]{1,20}){0,2})$/);
    if(simple && simple[1]){
      var parts = simple[1].split(/\s+/);
      var ok = true;
      for(var k=0;k<parts.length;k++){
        if(NAME_BLOCK[lc(parts[k])] || FILLER[lc(parts[k])]){ ok = false; break; }
      }
      if(ok){
        parts[0] = ucFirst(parts[0]);
        return parts.join(' ');
      }
    }
    return null;
  }

  function extractCity(raw){
    if(!raw) return null;
    var str = String(raw).trim();
    if(/\d/.test(str)) return null;
    if(str.length > 60) return null;
    var m = str.match(/(?:^|[\s,.;:!?])(?:я\s+)?(?:вообще[-\s]?то\s+)?(?:из|живу\s+в|жив[её]т\s+в|город[ае]?|родил[ася]+сь?\s+в|приехал[аи]?\s+из)\s+([А-ЯЁA-Zа-яёa-z][\wа-яё-]{1,20}(?:\s+[А-ЯЁA-Zа-яёa-z][\wа-яё-]{1,20}){0,2})/i);
    if(!m || !m[1]) return null;
    var c = m[1].trim();
    var words = c.split(/\s+/);
    var clean = [];
    for(var i=0;i<words.length;i++){
      var w = words[i].replace(/[^\wа-яёA-Za-z-]/gi,'');
      if(w.length >= 2 && !FILLER[lc(w)] && !STOP[lc(w)]) clean.push(w);
    }
    if(!clean.length) return null;
    clean[0] = ucFirst(clean[0]).toLowerCase();
    clean[0] = ucFirst(clean[0]);
    return clean.join(' ');
  }

  function extractAge(raw, an, pending){
    if(!raw) return null;
    var str = String(raw).trim();
    var m = str.match(/(?:^|[\s,.;:!?])(?:мне\s+)?(\d{1,4})\s*(?:лет|года|год|годик|годков|годиков)(?=[\s,.;:!?]|$)/i);
    if(m){
      var v = parseInt(m[1], 10);
      if(v >= 8 && v <= 99) return v;
      return null;
    }
    var m2 = str.match(/^мне\s+(\d{1,4})\s*[.!?]?\s*$/i);
    if(m2){
      var v2 = parseInt(m2[1], 10);
      if(v2 >= 8 && v2 <= 99) return v2;
      return null;
    }
    if(pending === 'age' && an.isDigitsOnly){
      var m3 = str.match(/(\d{1,4})/);
      if(m3){
        var v3 = parseInt(m3[1], 10);
        if(v3 >= 8 && v3 <= 99) return v3;
      }
    }
    return null;
  }

  function extractPhrase(raw, triggerRegex){
    var m = raw.match(triggerRegex);
    if(!m || !m[1]) return null;
    var rest = m[1].replace(/[\s.!?,;:]+$/,'').trim();
    if(!rest) return null;
    rest = rest.replace(/^(?:в|на|и|и\s+в|и\s+на|про|о|об|для)\s+/i, '').trim();
    var words = rest.split(/\s+/);
    if(words.length > 1 && /(?:ать|ять|еть|ить|ыть|оть|уть|ти)$/i.test(words[0])){
      words.shift();
    }
    var clean = [];
    for(var i=0;i<words.length && clean.length<4;i++){
      var w = words[i].replace(/[^\wа-яёA-Za-z0-9-]/gi,'');
      if(w.length >= 2 && !FILLER[lc(w)] && !STOP[lc(w)]) clean.push(w);
    }
    if(!clean.length) return null;
    return lc(clean.join(' '));
  }
  function extractLike(raw){
    return extractPhrase(raw, /(?:люблю|обожаю|нравится|нравятся|кайфую\s+от|фанат|тащусь\s+от|балдею\s+от)\s+(.+?)(?:[.!?,;]|$)/i);
  }
  function extractHobby(raw){
    return extractPhrase(raw, /(?:играю\s+в|увлекаюсь|занимаюсь|хожу\s+на|катаюсь\s+на|практикую|коллекционирую)\s+(.+?)(?:[.!?,;]|$)/i);
  }
  function extractDislike(raw){
    var m = raw.match(/(?:не\s+люблю|ненавижу|терпеть\s+не\s+могу|бесит|раздражает|не\s+нравится)\s+([а-яёa-z]{3,30})/i);
    if(m) return lc(m[1]);
    m = raw.match(/не\s+([а-яёa-z]{3,30})\s+не\s+люблю/i);
    if(m) return lc(m[1]);
    m = raw.match(/([а-яёa-z]{3,30})\s+не\s+люблю/i);
    if(m) return lc(m[1]);
    return null;
  }
  function extractEntities(raw, an, pending){
    var e = {};
    var n = extractName(raw); if(n) e.name = n;
    var a = extractAge(raw, an, pending); if(a) e.age = a;
    var c = extractCity(raw); if(c) e.city = c;
    var l = extractLike(raw); if(l) e.like = l;
    var d = extractDislike(raw); if(d) e.dislike = d;
    var h = extractHobby(raw); if(h) e.hobby = h;
    return e;
  }

  var KNOWN_ENTITIES = [
    'гта','gta','гта5','gta5','танки','дота','dota','кс','cs','кс2','cs2','ксго','csgo',
    'майнкрафт','minecraft','роблокс','roblox','фортнайт','fortnite','горебох','gorebox',
    'варкрафт','warcraft','ведьмак','witcher','скайрим','skyrim','валорант','valorant',
    'апекс','apex','пабг','pubg','самп','samp','крузис','crysis','фаркрай','farcry',
    'ассасин','assassins','батлфилд','battlefield','калда','cod','симс','sims',
    'террария','terraria','диабло','diablo','старкрафт','starcraft','halflife',
    'портал','portal','биошок','bioshock','дум','doom','квейк','quake','метро','metro',
    'сталкер','stalker','титан','titanfall','овервотч','overwatch','лига','league',
    'майн','лего','lego','андроид','android','айфон','iphone'
  ];
  function extractSpecifics(raw){
    var str = lc(stripEmoji(raw));
    var found = [];
    for(var i=0;i<KNOWN_ENTITIES.length;i++){
      var e = KNOWN_ENTITIES[i];
      var re = new RegExp('(?:^|[^а-яёa-z0-9])' + e.replace(/[-\/\\^$*+?.()|[\]{}]/g,'\\$&') + '(?:[^а-яёa-z0-9]|$)', 'i');
      if(re.test(str) && found.indexOf(e) === -1) found.push(e);
    }
    var tokens = stripEmoji(raw).split(/[\s,]+/);
    for(var j=0;j<tokens.length;j++){
      var t = tokens[j].replace(/[^\wа-яё-]/gi,'');
      if(t.length >= 3 && /[a-z]/i.test(t) && !STOP[lc(t)] && !FILLER[lc(t)]){
        if(found.indexOf(lc(t)) === -1) found.push(lc(t));
      }
    }
    return found.slice(0,3);
  }

