function makeNTRAI(){
'use strict';

/* ─────────── УТИЛИТЫ ─────────── */
var clamp = function(x,a,b){ return x<a?a:x>b?b:x; };
var rnd = function(a){ return a[(Math.random()*a.length)|0]; };
var cap = function(s){ return s ? s[0].toUpperCase() + s.slice(1) : s; };
var nowMs = function(){ return (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now(); };
var uniq = function(a){ return Array.from(new Set(a)); };

var WORD_RE = /[а-яёa-z0-9]+/gi;
function tokens(text){
  if (typeof text !== 'string') return [];
  return (text.toLowerCase().match(WORD_RE) || []);
}

var STOP = new Set('и в во не что он на я с со как а то все она так его но да ты к у же вы за бы по только ее мне было вот от меня еще нет о из ему теперь когда даже ну вдруг ли если уже или ни быть был него до вас нибудь опять уж вам ведь там потом себя ничего ей может они тут где есть надо ней для мы тебя их чем была сам чтоб без будто чего раз тоже себе под будет ж тогда кто этот того потому этого какой совсем ним здесь этом один почти мой тем чтобы нее сейчас были куда зачем всех никогда можно при наконец два об другой хоть после над больше тот через эти нас про всего них какая много разве три эту моя впрочем хорошо свою этой перед иногда лучше чуть том нельзя такой им более всегда конечно всю между'.split(' '));

var SUF = ['ениями','ениям','ениях','иями','ями','ами','ения','ению','ение','ений','ией','иях','ию','ия','ие','ыми','ому','ого','ему','ых','их','ый','ой','ая','ые','ое','ее','ую','юю','яя','ими','ей','ий','ам','ям','ах','ях','ов','ев','ью','ем','ом','ся','сь','ть','ы','и','а','я','о','е','у','ю','й','ь'];
function stem(w){
  if (w.length < 5) return w;
  for (var i = 0; i < SUF.length; i++){
    var s = SUF[i];
    if (w.length > s.length + 3 && w.endsWith(s)) return w.slice(0, -s.length);
  }
  return w;
}
function contentStems(txt){
  return tokens(txt).filter(function(w){ return !STOP.has(w) && w.length > 1; }).map(stem);
}

function splitSentences(text){
  if (!text) return [];
  return text.split(/(?<=[.!?…])\s*/).map(function(s){ return s.trim(); }).filter(function(s){ return s.length > 0; });
}
function splitClauses(sentence){
  return sentence.split(/,\s*/).map(function(s){
    return s.trim().replace(/^[иа]\s+/i, '').replace(/[.!?…]+$/g, '').trim();
  }).filter(function(s){ return s.length > 0; });
}

