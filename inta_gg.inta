    pats: [
      /поддержи/, /успокой/, /утешь/, /я\s+устал/, /мне\s+плохо/,
      /мне\s+тяжело/, /мне\s+грустно/, /мне\s+больно/, /я\s+одинок/,
      /я\s+одинока/, /мне\s+страшно/, /мне\s+тревожно/, /мне\s+тошно/,
      /мне\s+паршиво/, /мне\s+хреново/, /мне\s+фигово/, /мне\s+херово/
