  var SUFFIXES = ['иями','ями','ами','ией','иях','иям','ием','ого','его','ому','ему',
    'ыми','ими','ых','их','ой','ей','ый','ий','ая','яя','ое','ее','ые','ие','ую','юю',
    'тся','ться','ов','ев','ах','ях','ам','ям','ом','ем','ум','ю','я','и','ы','а','е','о','у','й','ь'];

  var POS = {};
  ('хороший хорош хорошо класс классный классно крутой круто люблю любимый любимая ' +
   'обожаю обожаемый радость рад счастлив счастливый счастье супер прекрасный милый ' +
