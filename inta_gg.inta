      "достижение": { nom: "достижение", acc: "достижение", gen: "достижения", dat: "достижению", ins: "достижением", pre: "достижении" }
    },
    verbs: {
      "развиваться": { inf: "развиваться", pres: "развиваюсь", past: "развивался", fut: "буду развиваться" },
      "достигать": { inf: "достигать", pres: "достигаю", past: "достигал", fut: "буду достигать" }
    },
    adjectives: {
      "карьерный": { m: "карьерный", f: "карьерная", n: "карьерное", pl: "карьерные" },
      "успешный": { m: "успешный", f: "успешная", n: "успешное", pl: "успешные" }
    },
    questions: {
      "как": 1, "что": 1, "куда": 1
    }
  },
  followUps: {
    "А как с карьерой?": 1,
    "А куда движешься?": 1,
    "А что хочешь достичь?": 1
  },
  contextRules: null
};

// -------------------------------------------------------------
// SECTION 5.41 — Перестроение индекса тем после добавления
// -------------------------------------------------------------

function rebuildTopicIndexes(){
  const byWord = {};
  const byId = {};
  const byKind = { fact: {}, emotion: {}, context: {}, hybrid: {} };

  for (const id of _keys(TOPICS)){
    const t = TOPICS[id];
    if (!t || !t.id) continue;
    byId[t.id] = t;
    if (t.kind && byKind[t.kind]) byKind[t.kind][t.id] = t;
    if (t.words){
      for (const w of _keys(t.words)){
        if (!byWord[w]) byWord[w] = {};
        byWord[w][t.id] = t.words[w];
      }
    }
  }

  TOPIC_INDEX.byWord = byWord;
  TOPIC_INDEX.byId = byId;
  TOPIC_INDEX.byKind = byKind;
  return TOPIC_INDEX;
}

rebuildTopicIndexes();

// -------------------------------------------------------------
// SECTION 5.42 — Утилиты поиска тем
// -------------------------------------------------------------

function findTopicsByWord(word){
  if (!_isStr(word)) return [];
  const w = word.toLowerCase();
  const stem = stemRu(w);
  const out = [];
  const seen = {};
  const hit = TOPIC_INDEX.byWord[w];
  if (hit){
    for (const tid of _keys(hit)){
      if (!seen[tid]){
        seen[tid] = 1;
        out.push({ topicId: tid, weight: hit[tid], source: "exact" });
      }
    }
  }
  // Стем-совпадения (для склонённых форм)
  for (const key of _keys(TOPIC_INDEX.byWord)){
    if (key === w) continue;
    const keyStem = stemRu(key);
    if (keyStem === stem){
      const sub = TOPIC_INDEX.byWord[key];
      for (const tid of _keys(sub)){
        if (!seen[tid]){
          seen[tid] = 1;
          out.push({ topicId: tid, weight: sub[tid] * 0.7, source: "stem" });
        }
      }
    }
  }
  return out;
}

function collectActiveTopics(analysis){
  if (!analysis) return [];
  const hits = {};
  const tokens = analysis.tokens;
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (!t.isWord) continue;
    const found = findTopicsByWord(t.lower);
    for (let j = 0; j < found.length; j++){
      const f = found[j];
      if (!hits[f.topicId]) hits[f.topicId] = { topicId: f.topicId, weight: 0, count: 0 };
      hits[f.topicId].weight += f.weight;
      hits[f.topicId].count += 1;
    }
  }
  const out = [];
  for (const tid of _keys(hits)){
    const h = hits[tid];
    const topic = TOPIC_INDEX.byId[tid];
    if (!topic) continue;
    out.push({
      topicId: tid,
      topic: topic,
      weight: h.weight,
      count: h.count,
      kind: topic.kind,
      priority: topic.priority || 5
    });
  }
  out.sort((a, b) => (b.weight * b.priority) - (a.weight * a.priority));
  return out;
}

// -------------------------------------------------------------
// SECTION 5.43 — Финальная метка части 5
// -------------------------------------------------------------

const __IKW_PART5_LOADED = true;
// =============================================================
// PART 6 — Расширяемый каталог тем (compact factory + 350+ тем)
// Формат тем: T(id, kind, tone, priority, words, objects, verbs,
//               adjectives, questions, followUps, [contextTemplates],
//               [contextRules])
// Хелперы _O, _V, _A создают объекты форм для word-level сборки.
// =============================================================

// -------------------------------------------------------------
// SECTION 6.1 — Фабрика тем и хелперы форм
// -------------------------------------------------------------

function _O(nom, gen, dat, acc, ins, pre){
  return {
    nom: nom,
    gen: gen || nom,
    dat: dat || nom,
    acc: acc || nom,
    ins: ins || nom,
    pre: pre || nom
  };
}

function _V(inf, pres, past, fut){
  return {
    inf: inf,
    pres: pres || inf,
    past: past || inf,
    fut: fut || inf
  };
}

function _A(m, f, n, pl){
  return {
    m: m,
    f: f || m,
    n: n || m,
    pl: pl || m
  };
}

function T(id, kind, tone, priority, words, objects, verbs, adjectives, questions, followUps, contextTemplates, contextRules){
  const t = {
    id: id,
    kind: kind,
    tone: tone,
    priority: priority,
    words: words || {},
    responseWords: {
      objects: objects || {},
      verbs: verbs || {},
      adjectives: adjectives || {},
      questions: questions || {}
    },
    followUps: followUps || {},
    contextTemplates: contextTemplates || null,
    contextRules: contextRules || null
  };
  TOPICS[id] = t;
  return t;
}

