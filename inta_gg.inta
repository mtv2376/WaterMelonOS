      /твой\s+возраст/, /расскажи\s+о\s+себе/, /ты\s+человек/, /ты\s+бот/,
      /ты\s+робот/, /ты\s+живой/, /ты\s+настоящ/, /что\s+ты\s+умеешь/,
      /ты\s+ии\b/, /ты\s+искусствен/, /ты\s+кто/, /представься/,
      /ты\s+девушка/, /ты\s+парень/, /ты\s+мальчик/, /ты\s+девочка/
