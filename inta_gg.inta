const NAMES_ALL = {};
(function buildNamesAll(){
  const mk = _keys(NAMES_MALE);
  for (let i = 0; i < mk.length; i++) NAMES_ALL[mk[i]] = "m";
  const fk = _keys(NAMES_FEMALE);
  for (let i = 0; i < fk.length; i++) NAMES_ALL[fk[i]] = "f";
})();

const NAMES_MALE_SET = new Set(_keys(NAMES_MALE));
const NAMES_FEMALE_SET = new Set(_keys(NAMES_FEMALE));

function nameExists(word){
  if (!_isStr(word)) return false;
  const w = word.toLowerCase().replace(/ё/g, "е");
  if (NAMES_ALL[word] !== undefined) return true;
  if (NAMES_ALL[w] !== undefined) return true;
  for (const k of _keys(NAMES_ALL)){
    if (k.replace(/ё/g, "е") === w) return true;
  }
  return false;
}

function nameCanonical(word){
  if (!_isStr(word)) return null;
  if (NAMES_ALL[word] !== undefined) return word;
  const w = word.toLowerCase().replace(/ё/g, "е");
  for (const k of _keys(NAMES_ALL)){
    if (k.replace(/ё/g, "е") === w) return k;
  }
  return null;
}

function nameGender(word){
  if (!_isStr(word)) return null;
  if (NAMES_MALE[word] !== undefined) return "m";
  if (NAMES_FEMALE[word] !== undefined) return "f";
  const w = word.toLowerCase().replace(/ё/g, "е");
  for (const k of _keys(NAMES_MALE)){
    if (k.replace(/ё/g, "е") === w) return "m";
  }
  for (const k of _keys(NAMES_FEMALE)){
    if (k.replace(/ё/g, "е") === w) return "f";
  }
  return null;
}

// -------------------------------------------------------------
// SECTION 3.12 — Уменьшительно-ласкательные формы имени
// -------------------------------------------------------------

function diminutiveOf(name){
  if (!_isStr(name)) return name;
  const w = name.toLowerCase();
  const gender = nameGender(w) || "m";
  // Специальные случаи
  if (gender === "f"){
    if (_endsWith(w, "а")) return w.slice(0, -1) + "очка";
    if (_endsWith(w, "я")) return w.slice(0, -1) + "ечка";
    return w + "очка";
  }
  if (_endsWith(w, "й")) return w.slice(0, -1) + "йка";
  if (_endsWith(w, "ь")) return w.slice(0, -1) + "юша";
  return w + "ка";
}

// -------------------------------------------------------------
// SECTION 3.13 — Склонение имён (упрощённо)
// -------------------------------------------------------------

function declineName(name, gender){
  if (!_isStr(name)) return { nom: name, gen: name, dat: name, acc: name, ins: name, pre: name };
  const g = gender || nameGender(name) || "m";
  const w = name;
  if (g === "f"){
    if (_endsWith(w, "а")){
      const base = w.slice(0, -1);
      return { nom: w, gen: base + "ы", dat: base + "е", acc: base + "у", ins: base + "ой", pre: base + "е" };
    }
    if (_endsWith(w, "я")){
      const base = w.slice(0, -1);
      return { nom: w, gen: base + "и", dat: base + "е", acc: base + "ю", ins: base + "ей", pre: base + "е" };
    }
    return { nom: w, gen: w, dat: w, acc: w, ins: w, pre: w };
  }
  // Мужской
  if (_endsWith(w, "й")){
    const base = w.slice(0, -1);
    return { nom: w, gen: base + "я", dat: base + "ю", acc: base + "я", ins: base + "ем", pre: base + "е" };
  }
  if (_endsWith(w, "ь")){
    const base = w.slice(0, -1);
    return { nom: w, gen: base + "я", dat: base + "ю", acc: base + "я", ins: base + "ем", pre: base + "е" };
  }
  if (_endsWith(w, "а")){
    // Мужские на -а: "Никита", "Илья" и подобные
    const base = w.slice(0, -1);
    return { nom: w, gen: base + "ы", dat: base + "е", acc: base + "у", ins: base + "ой", pre: base + "е" };
  }
  // Обычное мужское
  return { nom: w, gen: w + "а", dat: w + "у", acc: w + "а", ins: w + "ом", pre: w + "е" };
}

