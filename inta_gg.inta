  };
  F.question_follow = {
    k:'ещё дальше продолжай что ещё'.split(' '),
    e:['ещё','дальше','продолжай','что ещё'],
    t:[
      ['{a}','ad,st','all'],
      ['{a}! {a2}','ex,ad','warm+'],
      ['{a}. {a2}','ad,st','all'],
      ['{a}','ad,st','warm+'],
      ['{a}!','ex,ad','warm+']
    ],
    s:{
      a:['Продолжим','Дальше','Хорошо'],
      a2:['Что интересует?','Куда угодно.','Кталк готов.']
    }
  };

  /* ==========================================================================
     СБОРКА ИНТЕНТОВ И ШАБЛОНОВ
     ========================================================================== */
  const INTENTS = [];
  const TEMPLATES = [];
  const INTENT_INDEX = {};

  for (const [name, def] of Object.entries(F)) {
    const intentId = INTENTS.length;
    INTENT_INDEX[name] = intentId;
    INTENTS.push({ id: intentId, name, keywords: def.k, examples: def.e, templateIds: [] });
    for (const [tpl, typesStr, moods] of def.t) {
      const types = typesStr.split(',').map(c => RT_BY_CODE[c.trim()]).filter(x => x !== undefined);
      const moodIds = moods === 'all' ? null
                    : moods === 'cold+' ? MOODS.slice(0,6).map(m => m.id)
                    : moods === 'warm+' ? MOODS.slice(6).map(m => m.id)
                    : moods === 'hot+'  ? MOODS.slice(12).map(m => m.id)
                    : moods === 'mid'   ? MOODS.slice(4,10).map(m => m.id)
                    : Array.isArray(moods) ? moods : null;
      TEMPLATES.push({
        id: TEMPLATES.length, intentId, intentName: name,
        tpl, types, moods: moodIds, slots: def.s
      });
      INTENTS[intentId].templateIds.push(TEMPLATES.length - 1);
    }
  }

  /* ==========================================================================
     БАЗОВЫЙ ВОКАБУЛЯРИЙ
     ========================================================================== */
  const BASE_WORDS = [
    'привет','здравствуй','хай','салют','йоу','добрый','утро','день','вечер','ночь','пока','свиданье','прощай','бай','встреча',
    'дела','жизнь','настроение','сам','здорово','новое','поживаешь','оно','всё','нормально','отлично','плохо','хорошо','ужасно',
    'кто','что','такое','зовут','имя','бот','человек','живой','настоящий','искусственный','интеллект','сущность',
    'кталк','кталкин','великий','кталкнуть','кталковать','легенда','миф','философия','истина','смысл','душа',
    'спасибо','благодарю','спс','пасиб','признателен','ценю',
    'грустно','устал','тяжело','расстроен','депрессия','одиноко','плачу','силы','больно','скучно','тоска',
    'счастлив','рад','весело','классно','супер','кайф','прекрасно','восторг','ликую',
    'люблю','обожаю','скучаю','нравишься','милый','дорогой','солнце','зайка','котик','родной','сердце','целую','обнимаю',
    'дурак','тупой','глупый','идиот','кретин','бесишь','ненавижу','достал','заткнись','отвали','молчи','хватит',
    'блять','хуй','пизда','ебать','сука','нахуй','охуел','ахуел','долбоёб','мудак','гандон','шлюха','пидор','мразь','тварь',
    'ахах','хаха','хех','лол','ору','ржу','ржака','смешно','угар','кек','прикол','шутка','юмор','смех',
    'вопрос','ответ','почему','зачем','где','когда','как','куда','откуда','сколько',
    'совет','помощь','помоги','подскажи','научи','расскажи','объясни','покажи',
    'факт','история','легенда','сказка','притча','мораль','вывод','правда','ложь',
    'сегодня','вчера','завтра','сейчас','потом','время','час','минута',
    'хочу','буду','надо','нужно','должен','могу','умею','делаю','думаю','знаю','помню','забыл',
    'работа','дело','задача','проект','цель','путь','мечта','план','идея','мысль',
    'друг','враг','семья','родные','близкие','люди','мир','земля','вселенная',
    'смерть','любовь','свобода','счастье','судьба','вечность',
    'математика','число','цифра','счёт','формула','пример','решение',
    'слова','слово','буква','текст','фраза','речь','язык','значение',
    'поддержка','забота','внимание','нежность','тепло','ласка',
    'игра','забава','развлечение','веселье','мем',
    'радость','грусть','злость','страх','тревога','спокойствие','тишина','покой',
    'мудрость','опыт','знание','понимание','сознание'
  ];
  let VOCAB = [...new Set(BASE_WORDS.map(w => w.toLowerCase()))];
  let VOCAB_INDEX = new Map();
  VOCAB.forEach((w, i) => VOCAB_INDEX.set(w, i));

  /* ==========================================================================
     ПАРАМЕТРЫ
     ========================================================================== */
  const VOCAB_SIZE = CFG.VOCAB_SIZE;
  const EMB = CFG.EMBED_DIM;
  const L1O = CFG.L1_OUT, L2O = CFG.L2_OUT, L3O = CFG.L3_OUT;

  const PARAMS = (() => {
    const rand = (n, scale) => {
      const a = new Float32Array(n);
      const s = scale || (Math.sqrt(2 / Math.max(n, 1)) * 0.6);
      for (let i = 0; i < n; i++) a[i] = (Math.random() * 2 - 1) * s;
      return a;
    };
    const P = {
      tokEmb: rand(VOCAB_SIZE * EMB, 0.05),
      intentEmb: rand(INTENTS.length * EMB, 0.15),
      tplEmb: rand(TEMPLATES.length * EMB, 0.15),
      moodEmb: rand(CFG.MOODS * EMB, 0.2),
      rtEmb: rand(CFG.RTYPES * EMB, 0.2),
      L1W: rand(EMB * L1O, 0.08), L1b: new Float32Array(L1O),
      L2W: rand(L1O * L2O, 0.06), L2b: new Float32Array(L2O),
      L3W: rand(L2O * L3O, 0.06), L3b: new Float32Array(L3O),
      L4W: rand(L3O * EMB, 0.06), L4b: new Float32Array(EMB),
      moodHead: rand(EMB * CFG.MOODS, 0.1), moodBias: new Float32Array(CFG.MOODS),
      rtHead: rand(EMB * CFG.RTYPES, 0.1), rtBias: new Float32Array(CFG.RTYPES)
    };
    let total = 0;
    for (const k in P) total += P[k].length;
    P.__total = total;
    return P;
  })();

  /* ==========================================================================
     ФИКС #3: инициализация intentEmb на примерах
     ========================================================================== */
  function getTokEmb(idx){ const off = idx * EMB; return PARAMS.tokEmb.subarray(off, off + EMB); }
  function embedText(text, out){
    out = out || new Float32Array(EMB);
    out.fill(0);
    const toks = contentTokens(text).map(stem).slice(0, 64);
    let n = 0;
    for (const t of toks){
      const idx = VOCAB_INDEX.get(t);
      if (idx === undefined) continue;
      const e = getTokEmb(idx);
      for (let i = 0; i < EMB; i++) out[i] += e[i];
      n++;
    }
    if (n) for (let i = 0; i < EMB; i++) out[i] /= n;
    let norm = 0;
    for (let i = 0; i < EMB; i++) norm += out[i] * out[i];
    norm = Math.sqrt(norm) || 1;
    for (let i = 0; i < EMB; i++) out[i] /= norm;
    return out;
  }

  (function initIntentEmb(){
    for (let i = 0; i < INTENTS.length; i++){
      const e = embedText(INTENTS[i].examples.join(' '));
      const off = i * EMB;
      for (let j = 0; j < EMB; j++) PARAMS.intentEmb[off + j] = e[j];
    }
  })();

  /* ==========================================================================
     FORWARD / BACKWARD
     ========================================================================== */
  const _h1 = new Float32Array(L1O);
  const _h2 = new Float32Array(L2O);
  const _h3 = new Float32Array(L3O);
  const _h4 = new Float32Array(EMB);

  function matVec(W, x, out, b){
    const nOut = out.length, nIn = x.length;
    if (b){
      for (let i = 0; i < nOut; i++){
        let s = b[i];
        const off = i * nIn;
        for (let j = 0; j < nIn; j++) s += W[off + j] * x[j];
        out[i] = s;
      }
    } else {
      for (let i = 0; i < nOut; i++){
        let s = 0;
        const off = i * nIn;
        for (let j = 0; j < nIn; j++) s += W[off + j] * x[j];
        out[i] = s;
      }
    }
  }
  function reluInPlace(v){ for (let i = 0; i < v.length; i++) if (v[i] < 0) v[i] = 0; }

  function forward(x){
    matVec(PARAMS.L1W, x, _h1, PARAMS.L1b); reluInPlace(_h1);
    matVec(PARAMS.L2W, _h1, _h2, PARAMS.L2b); reluInPlace(_h2);
    matVec(PARAMS.L3W, _h2, _h3, PARAMS.L3b); reluInPlace(_h3);
    matVec(PARAMS.L4W, _h3, _h4, PARAMS.L4b);
    return _h4;
  }
  function moodHead(h){
    const logits = new Float32Array(CFG.MOODS);
    for (let i = 0; i < CFG.MOODS; i++){
      let s = PARAMS.moodBias[i];
      const off = i * EMB;
      for (let j = 0; j < EMB; j++) s += PARAMS.moodHead[off + j] * h[j];
      logits[i] = s;
    }
    return logits;
  }
  function rtHead(h){
    const logits = new Float32Array(CFG.RTYPES);
    for (let i = 0; i < CFG.RTYPES; i++){
      let s = PARAMS.rtBias[i];
      const off = i * EMB;
      for (let j = 0; j < EMB; j++) s += PARAMS.rtHead[off + j] * h[j];
      logits[i] = s;
    }
    return logits;
  }
  function softmax(v){
    let mx = -Infinity; for (let i = 0; i < v.length; i++) if (v[i] > mx) mx = v[i];
    let sum = 0;
    for (let i = 0; i < v.length; i++){ v[i] = Math.exp(v[i] - mx); sum += v[i]; }
    if (sum > 0) for (let i = 0; i < v.length; i++) v[i] /= sum;
    return v;
  }

  /* ==========================================================================
     ОБУЧЕНИЕ
     ========================================================================== */
  const MOM = {
    L1W:new Float32Array(PARAMS.L1W.length), L1b:new Float32Array(PARAMS.L1b.length),
    L2W:new Float32Array(PARAMS.L2W.length), L2b:new Float32Array(PARAMS.L2b.length),
    L3W:new Float32Array(PARAMS.L3W.length), L3b:new Float32Array(PARAMS.L3b.length),
    L4W:new Float32Array(PARAMS.L4W.length), L4b:new Float32Array(PARAMS.L4b.length)
  };
  let _updatedParams = 0;
  let _avgDelta = 0;

  function sgdUpdate(W, dW, M, lr, decay){
    const n = W.length;
    let sum = 0;
    for (let i = 0; i < n; i++){
      const g = dW[i] + decay * W[i];
      M[i] = CFG.MOMENTUM * M[i] + g;
      const d = -lr * M[i];
      W[i] += d;
      sum += d < 0 ? -d : d;
    }
    _updatedParams += n;
    return sum / n;
  }

  function backpropThroughHidden(input, target){
    const h1o = new Float32Array(L1O);
    const h2o = new Float32Array(L2O);
    const h3o = new Float32Array(L3O);
    const h4o = new Float32Array(EMB);

    matVec(PARAMS.L1W, input, h1o, PARAMS.L1b); reluInPlace(h1o);
    matVec(PARAMS.L2W, h1o, h2o, PARAMS.L2b); reluInPlace(h2o);
    matVec(PARAMS.L3W, h2o, h3o, PARAMS.L3b); reluInPlace(h3o);
    matVec(PARAMS.L4W, h3o, h4o, PARAMS.L4b);

    const dH4 = new Float32Array(EMB);
    for (let i = 0; i < EMB; i++) dH4[i] = 2 * (h4o[i] - target[i]) / EMB;

    const dW4 = new Float32Array(L3O * EMB);
    const dH3 = new Float32Array(L3O);
    for (let i = 0; i < EMB; i++){
      const g = dH4[i];
      const off = i * L3O;
      for (let j = 0; j < L3O; j++){
        dW4[off + j] = g * h3o[j];
        dH3[j] += PARAMS.L4W[off + j] * g;
      }
    }
    const dL4b = new Float32Array(EMB);
    for (let i = 0; i < EMB; i++) dL4b[i] = dH4[i];

    const reluGrad3 = new Float32Array(L3O);
    for (let i = 0; i < L3O; i++) reluGrad3[i] = h3o[i] > 0 ? dH3[i] : 0;
    const dW3 = new Float32Array(L2O * L3O);
    const dH2 = new Float32Array(L2O);
    for (let i = 0; i < L3O; i++){
      const g = reluGrad3[i];
      if (g === 0) continue;
      const off = i * L2O;
      for (let j = 0; j < L2O; j++){
        dW3[off + j] = g * h2o[j];
        dH2[j] += PARAMS.L3W[off + j] * g;
      }
    }
    const dL3b = reluGrad3;

    const reluGrad2 = new Float32Array(L2O);
    for (let i = 0; i < L2O; i++) reluGrad2[i] = h2o[i] > 0 ? dH2[i] : 0;
    const dW2 = new Float32Array(L1O * L2O);
    const dH1 = new Float32Array(L1O);
    for (let i = 0; i < L2O; i++){
      const g = reluGrad2[i];
      if (g === 0) continue;
      const off = i * L1O;
      for (let j = 0; j < L1O; j++){
        dW2[off + j] = g * h1o[j];
        dH1[j] += PARAMS.L2W[off + j] * g;
      }
    }
    const dL2b = reluGrad2;

    const reluGrad1 = new Float32Array(L1O);
    for (let i = 0; i < L1O; i++) reluGrad1[i] = h1o[i] > 0 ? dH1[i] : 0;
    const dW1 = new Float32Array(EMB * L1O);
    for (let i = 0; i < L1O; i++){
      const g = reluGrad1[i];
      if (g === 0) continue;
      const off = i * EMB;
      for (let j = 0; j < EMB; j++) dW1[off + j] = g * input[j];
    }
    const dL1b = reluGrad1;

    const lr = CFG.LR_BACKPROP, dec = CFG.DECAY;
    let avg = 0;
    avg += sgdUpdate(PARAMS.L1W, dW1, MOM.L1W, lr, dec);
    avg += sgdUpdate(PARAMS.L1b, dL1b, MOM.L1b, lr, dec);
    avg += sgdUpdate(PARAMS.L2W, dW2, MOM.L2W, lr, dec);
    avg += sgdUpdate(PARAMS.L2b, dL2b, MOM.L2b, lr, dec);
    avg += sgdUpdate(PARAMS.L3W, dW3, MOM.L3W, lr, dec);
    avg += sgdUpdate(PARAMS.L3b, dL3b, MOM.L3b, lr, dec);
    avg += sgdUpdate(PARAMS.L4W, dW4, MOM.L4W, lr, dec);
    avg += sgdUpdate(PARAMS.L4b, dL4b, MOM.L4b, lr, dec);
    return avg / 8;
  }

  function attractEmb(emb, offset, hidden, lr){
    let sum = 0;
    for (let i = 0; i < EMB; i++){
      const d = lr * (hidden[i] - emb[offset + i]);
      emb[offset + i] += d;
      sum += d < 0 ? -d : d;
    }
    _updatedParams += EMB;
    return sum / EMB;
  }

  function cooccurUpdate(tokens, window){
    window = window || 4;
    const stemmed = tokens.map(stem).filter(t => VOCAB_INDEX.has(t));
    if (stemmed.length < 2) return;
    const lr = CFG.LR_COOCCUR;
    const tmp = new Float32Array(EMB);
    for (let i = 0; i < stemmed.length; i++){
      tmp.fill(0);
      let cnt = 0;
      for (let j = Math.max(0, i - window); j <= Math.min(stemmed.length - 1, i + window); j++){
        if (i === j) continue;
        const idx = VOCAB_INDEX.get(stemmed[j]);
        if (idx === undefined) continue;
        const e = getTokEmb(idx);
        for (let d = 0; d < EMB; d++) tmp[d] += e[d];
        cnt++;
      }
      if (!cnt) continue;
      for (let d = 0; d < EMB; d++) tmp[d] /= cnt;
      const idx = VOCAB_INDEX.get(stemmed[i]);
      const e = getTokEmb(idx);
      for (let d = 0; d < EMB; d++) e[d] += lr * (tmp[d] - e[d]);
      _updatedParams += EMB;
    }
  }

  /* ==========================================================================
     КЛАССИФИКАЦИЯ / ШАБЛОНЫ
     ========================================================================== */
  function classifyIntent(text, hidden){
    const toks = contentTokens(text).map(stem);
    const scores = new Float32Array(INTENTS.length);
    for (let i = 0; i < INTENTS.length; i++){
      const it = INTENTS[i];
      let kw = 0;
      for (const k of it.keywords){
        if (toks.some(t => t.startsWith(k) || k.startsWith(t))) kw++;
      }
      const off = i * EMB;
      let dot = 0;
      for (let j = 0; j < EMB; j++) dot += hidden[j] * PARAMS.intentEmb[off + j];
      scores[i] = kw * 1.8 + dot * 0.4;
    }
    let best = 0, bestScore = -Infinity;
    for (let i = 0; i < scores.length; i++) if (scores[i] > bestScore){ bestScore = scores[i]; best = i; }
    return { intent: INTENTS[best], score: bestScore };
  }

  function selectTemplate(intent, mood, rtype, hidden, exclude){
    const eligible = [];
    for (const tid of intent.templateIds){
      const t = TEMPLATES[tid];
      if (t.types.length && !t.types.includes(rtype.id)) continue;
      if (t.moods && !t.moods.includes(mood.id)) continue;
      if (exclude && exclude.has(tid)) continue;
      const off = tid * EMB;
      let dot = 0;
      for (let j = 0; j < EMB; j++) dot += hidden[j] * PARAMS.tplEmb[off + j];
      eligible.push({ t, score: dot });
    }
    if (!eligible.length) return TEMPLATES[intent.templateIds[0]];
    eligible.sort((a,b) => b.score - a.score);
    const k = Math.min(5, eligible.length);
    const top = eligible.slice(0, k);
    const weights = top.map(x => Math.exp(x.score * 2));
    let sum = 0; for (const w of weights) sum += w;
    let r = Math.random() * sum;
    for (let i = 0; i < top.length; i++){
      r -= weights[i];
      if (r <= 0) return top[i].t;
    }
    return top[0].t;
  }

  /* ==========================================================================
     ПАМЯТЬ
     ========================================================================== */
  const MEMORY = {
    facts: new Map(),
    dialogue: {
      pendingQuestion: null, lastIntent: null,
      intentChain: [], lastUserText: '', lastAIReply: ''
    },
    context: [], recentReplies: [], skeletons: [],
    turn: 0, userName: null
  };

  const FACT_PATTERNS = [
    { key:'name', re:/(?:меня зовут|моё имя|я)\s+([А-ЯЁA-Z][а-яёa-z\-]{1,20})/i, post:s => cap(s) },
    { key:'age', re:/мне\s+(\d{1,3})\s*(?:лет|года|год)?/i, post:s => parseInt(s, 10) },
    { key:'city', re:/(?:я из|я живу в|живу в)\s+([А-ЯЁ][а-яё\-]{2,30})/i, post:s => s },
    { key:'likes', re:/я люблю\s+([а-яёa-z\-]{2,30})/i, post:s => s, append:true },
    { key:'likes', re:/мне нравится\s+([а-яёa-z\-]{2,30})/i, post:s => s, append:true },
    { key:'dislikes', re:/я не люблю\s+([а-яёa-z\-]{2,30})/i, post:s => s, append:true },
    { key:'dislikes', re:/ненавижу\s+([а-яёa-z\-]{2,30})/i, post:s => s, append:true },
    { key:'job', re:/я работаю\s+([а-яёa-z\-]{2,30})/i, post:s => s },
    { key:'hobby', re:/я увлекаюсь\s+([а-яёa-z\-]{2,30})/i, post:s => s },
    { key:'hobby', re:/моё хобби\s*[—\-:]?\s*([а-яёa-z\-]{2,30})/i, post:s => s }
  ];
  function extractFacts(text, fromAI){
    if (fromAI) return;
    for (const p of FACT_PATTERNS){
      const m = text.match(p.re);
      if (!m || !m[1]) continue;
      const v = p.post ? p.post(m[1]) : m[1];
      if (!v) continue;
      if (p.append){
        const arr = MEMORY.facts.get(p.key) || [];
        if (!arr.includes(v)) arr.push(v);
        MEMORY.facts.set(p.key, arr);
      } else {
        MEMORY.facts.set(p.key, v);
        if (p.key === 'name') MEMORY.userName = v;
      }
    }
  }

  /* ==========================================================================
     ANTI-ECHO / ANTI-REPEAT
     ========================================================================== */
  function normalize(s){ return s.toLowerCase().replace(/[^а-яёa-z0-9]/g, ''); }
  function skeleton(s){ return normalize(s).slice(0, 24); }
  function similarity(a, b){
    if (!a.length || !b.length) return 0;
    const n = Math.min(a.length, b.length);
    let m = 0;
    for (let i = 0; i < n; i++) if (a[i] === b[i]) m++;
    return m / Math.max(a.length, b.length);
  }
  function isEchoOrRepeat(reply, userText){
    const r = normalize(reply), u = normalize(userText);
    if (r && u && r === u) return true;
    for (const prev of MEMORY.recentReplies){
      if (normalize(prev) === r) return true;
    }
    const sk = skeleton(reply);
    for (const s of MEMORY.skeletons){
      if (s === sk) return true;
      if (similarity(sk, s) > 0.7) return true;
    }
    return false;
  }
  function rememberReply(r){
    MEMORY.recentReplies.push(r);
    if (MEMORY.recentReplies.length > CFG.ANTI_REPEAT_N) MEMORY.recentReplies.shift();
    MEMORY.skeletons.push(skeleton(r));
    if (MEMORY.skeletons.length > CFG.SKELETON_N) MEMORY.skeletons.shift();
  }

  /* ==========================================================================
     MOOD / ЗЕРКАЛО
     ========================================================================== */
  let MOOD_SCORE = 45;
  function updateMoodFrom(text){
    const t = text.toLowerCase();
    let d = 0;
    if (/(спасибо|благодар|люблю|обожаю|нравишься|мил|солнц|зайк|котик)/.test(t)) d += 8;
    if (/(привет|здравствуй|доброе|салют)/.test(t)) d += 3;
    if (/(груст|плохо|тяжел|устал|одинок|плачу)/.test(t)) d += 4;
    if (/(ахах|хаха|лол|ору|ржу|кек|шутк)/.test(t)) d += 5;
    if (/(дурак|тупой|идиот|бесишь|ненавиж)/.test(t)) d -= 6;
    if (/(блять|хуй|пизд|ебат|сука|нах)/.test(t)) d -= 4;
    if (/😂|🤣|😄|❤️|❤|💕|😘|😍/.test(text)) d += 6;
    if (/😡|🤬|😠/.test(text)) d -= 6;
    const decay = (45 - MOOD_SCORE) * 0.03;
    MOOD_SCORE = clamp(MOOD_SCORE + d + decay, 0, 100);
  }

  const MIRROR = { aggression:0, humor:0, profanity:0, love:0, cA:0, cH:0, cP:0, cL:0, mode:'neutral' };
  function updateMirror(text){
    const t = text.toLowerCase();
    const a = /(дурак|тупой|идиот|бесишь|ненавиж|заткнись)/.test(t) ? 1 : 0;
    const h = /(ахах|хаха|лол|ору|ржу|кек|шутк|прикол)/.test(t) ? 1 : 0;
    const p = /(блять|хуй|пизд|ебат|сука|нах|охуе)/.test(t) ? 1 : 0;
    const l = /(люблю|обожаю|нравишься|мил|солнц|зайк|котик|целую)/.test(t) ? 1 : 0;
    const ema = (o, n) => o * 0.55 + n * 0.45;
    MIRROR.aggression = ema(MIRROR.aggression, a);
    MIRROR.humor = ema(MIRROR.humor, h);
    MIRROR.profanity = ema(MIRROR.profanity, p);
    MIRROR.love = ema(MIRROR.love, l);
    if (a) MIRROR.cA++; else MIRROR.cA = Math.max(0, MIRROR.cA - 1);
    if (h) MIRROR.cH++; else MIRROR.cH = Math.max(0, MIRROR.cH - 1);
    if (p) MIRROR.cP++; else MIRROR.cP = Math.max(0, MIRROR.cP - 1);
    if (l) MIRROR.cL++; else MIRROR.cL = Math.max(0, MIRROR.cL - 1);
    if (MIRROR.cP >= 2) MIRROR.mode = 'profanity';
    else if (MIRROR.cA >= 2) MIRROR.mode = 'aggressive';
    else if (MIRROR.cL >= 2) MIRROR.mode = 'flirt';
    else if (MIRROR.cH >= 2) MIRROR.mode = 'humor';
    else MIRROR.mode = 'neutral';
  }

  /* ==========================================================================
     ФИКС #1: fillSlots — поддержка {nm}, {name}, {fact}, {topic}, {clock}
     ========================================================================== */
  function fillSlots(tpl, slots, ctx){
    let out = tpl;
    for (let iter = 0; iter < 8; iter++){
      if (!/\{(\w+)\}/.test(out)) break;
      out = out.replace(/\{(\w+)\}/g, (_, key) => {
        if (key === 'name') return ctx.name || rnd(['друг','путник','гость','солнце']);
        if (key === 'nm') return ctx.nm || ctx.name || 'друг';
        if (key === 'clock'){
          const d = new Date();
          return String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
        }
        if (key === 'fact'){
          const keys = ['likes','job','hobby','city'];
          const f = MEMORY.facts.get(rnd(keys));
          return Array.isArray(f) ? rnd(f) : (f || 'это');
        }
        if (key === 'topic') return ctx.topic || 'это';
        if (key === 'mood_name') return moodOf(MOOD_SCORE).n;
        const arr = slots[key];
        if (arr && arr.length) return rnd(arr);
        return '';
      });
    }
    return out.replace(/\s+/g, ' ').trim();
  }

  function polish(s, mood, rtype){
    if (!s) return '';
    s = s.replace(/\s+([.,!?…—])/g, '$1').replace(/([!?…])\s*\./g, '$1');
    s = s[0].toUpperCase() + s.slice(1);
    const punc = rtype.punc || '.';
    if (!/[.!?…]$/.test(s)) s += punc;
    if (mood.style === 'minimal' && s.length > 60) s = s.split(/[.!?…]/)[0].trim() + punc;
    if (mood.style === 'double' && !s.endsWith(mood.e) && Math.random() < 0.5) s += ' ' + mood.e;
    return s;
  }

  /* ==========================================================================
     ГЛАВНЫЙ PIPELINE (с фиксами #2, #3, #4, #5)
     ========================================================================== */
  function respond(text, opts){
    opts = opts || {};
    const fromAI = !!(opts && opts.fromAI);
    const t0 = nowMs();
    MEMORY.turn++;

    /* имя пользователя */
    if (!fromAI){
      const nm = text.match(/(?:меня зовут|моё имя)\s+([А-ЯЁA-Z][а-яёa-z\-]{1,20})/i);
      if (nm){
        MEMORY.userName = cap(nm[1]);
        MEMORY.facts.set('name', MEMORY.userName);
      }
      extractFacts(text, false);
    }

    updateMoodFrom(text);
    updateMirror(text);
    const moodScore = MOOD_SCORE;
    const moodHeur = moodOf(moodScore);

    cooccurUpdate(contentTokens(text), 4);

    const x = embedText(text);
    const hidden = forward(x);

    /* классификация */
    const { intent, score: intentScore } = classifyIntent(text, hidden);

    /* ========================================================================
       ФИКС #2: moodHead и rtHead теперь РЕАЛЬНО влияют
       ======================================================================== */
    const moodLogits = moodHead(hidden);
    const rtLogits = rtHead(hidden);
    const moodProbs = softmax(moodLogits.slice());
    const rtProbs = softmax(rtLogits.slice());

    /* mood = смесь эвристики и головы */
    const moodHeadIdx = moodProbs.indexOf(Math.max.apply(null, Array.from(moodProbs)));
    const moodHeurIdx = moodHeur.id;
    const moodFinalIdx = clamp(Math.round(moodHeurIdx * 0.7 + moodHeadIdx * 0.3), 0, 19);
    const moodIdx = MOODS[moodFinalIdx];

    /* RT — эвристика + голова */
    const t = text.toLowerCase();
    let rtHeurId = RT_BY_CODE.st;
    if (/\?$/.test(text.trim()) || /^(что|как|почему|зачем|где|когда|кто)/i.test(text)) rtHeurId = RT_BY_CODE.q;
    if (/!$/.test(text.trim())) rtHeurId = RT_BY_CODE.ex;
    if (intent.name === 'sad' || intent.name === 'tired' || intent.name === 'lonely') rtHeurId = RT_BY_CODE.em;
    if (intent.name === 'profanity') rtHeurId = RT_BY_CODE.pr;
    if (intent.name === 'insult_you') rtHeurId = RT_BY_CODE.em;
    if (intent.name === 'joke' || intent.name === 'laugh') rtHeurId = RT_BY_CODE.hu;
    if (intent.name === 'fact') rtHeurId = RT_BY_CODE.fa;
    if (intent.name === 'advice') rtHeurId = RT_BY_CODE.ad;
    if (MIRROR.mode === 'flirt' && MOOD_SCORE > 60) rtHeurId = RT_BY_CODE.fl;

    const rtHeadIdx = rtProbs.indexOf(Math.max.apply(null, Array.from(rtProbs)));
    const rtFinalIdx = clamp(Math.round(rtHeurId * 0.6 + rtHeadIdx * 0.4), 0, RTYPES.length - 1);
    const rtChoice = RT_BY_ID[rtFinalIdx] || RTYPES[0];

    /* выбор шаблона */
    const exclude = new Set();
    let tmpl = null;
    let reply = '';
    let attempts = 0;
    const ctxSlots = { name: MEMORY.userName, nm: MEMORY.userName, topic: null };
    while (attempts++ < 12){
      const t2 = selectTemplate(intent, moodIdx, rtChoice, hidden, exclude);
      if (!t2) break;
      let candidate = fillSlots(t2.tpl, t2.slots, ctxSlots);
      candidate = polish(candidate, moodIdx, rtChoice);
      if (candidate.length > CFG.MAX_OUTPUT) candidate = candidate.slice(0, CFG.MAX_OUTPUT - 1) + '…';
      if (!isEchoOrRepeat(candidate, text)){
        reply = candidate;
        tmpl = t2;
        break;
      }
      exclude.add(t2.id);
    }
    if (!reply){
      reply = polish(fillSlots('{a}', { a: ['Понял тебя','Ага','Хм, интересно','Ладно'] }, {}), moodIdx, rtChoice);
    }

    /* память */
    MEMORY.dialogue.lastIntent = intent.name;
    MEMORY.dialogue.intentChain.push(intent.name);
    if (MEMORY.dialogue.intentChain.length > 20) MEMORY.dialogue.intentChain.shift();
    MEMORY.dialogue.lastUserText = text;
    MEMORY.dialogue.lastAIReply = reply;
    MEMORY.context.push({ user: text, ai: reply });
    if (MEMORY.context.length > CFG.MAX_CONTEXT) MEMORY.context.shift();

    /* ========================================================================
       ФИКС #5: backprop не каждый ход
       ======================================================================== */
    _updatedParams = 0; _avgDelta = 0;
    if (MEMORY.turn % CFG.BACKPROP_EVERY === 0){
      const target = new Float32Array(EMB);
      const iOff = intent.id * EMB;
      const tOff = tmpl ? tmpl.id * EMB : 0;
      const mOff = moodIdx.id * EMB;
      for (let i = 0; i < EMB; i++){
        target[i] = (PARAMS.intentEmb[iOff + i] + PARAMS.tplEmb[tOff + i] + PARAMS.moodEmb[mOff + i]) / 3;
      }
      let norm = 0; for (let i = 0; i < EMB; i++) norm += target[i] * target[i];
      norm = Math.sqrt(norm) || 1;
      for (let i = 0; i < EMB; i++) target[i] /= norm;

      const avgBack = backpropThroughHidden(x, target);
      const a1 = attractEmb(PARAMS.intentEmb, iOff, hidden, CFG.LR_BACKPROP);
      const a2 = tmpl ? attractEmb(PARAMS.tplEmb, tOff, hidden, CFG.LR_BACKPROP) : 0;
      const a3 = attractEmb(PARAMS.moodEmb, mOff, hidden, CFG.LR_BACKPROP);
      const a4 = attractEmb(PARAMS.rtEmb, rtChoice.id * EMB, hidden, CFG.LR_BACKPROP);
      _avgDelta = (avgBack + a1 + a2 + a3 + a4) / 5;
    }

    rememberReply(reply);

    const t1 = nowMs();

    /* двойной reply */
    let second = null;
    if (moodIdx.style === 'double' && Math.random() < 0.6){
      const t3 = selectTemplate(intent, moodIdx, rtChoice, hidden, new Set([tmpl ? tmpl.id : -1]));
      if (t3 && t3.id !== (tmpl ? tmpl.id : -1)){
        let s = polish(fillSlots(t3.tpl, t3.slots, ctxSlots), moodIdx, rtChoice);
        if (!isEchoOrRepeat(s, text)) second = s;
      }
      if (second) rememberReply(second);
    }

    return {
      reply, second,
      meta: {
        turn: MEMORY.turn,
        intent: intent.name,
        intentScore: +intentScore.toFixed(3),
        templateId: tmpl ? tmpl.id : -1,
        mood: moodIdx.id,
        moodName: moodIdx.n,
        moodScore: MOOD_SCORE,
        responseType: rtChoice.n,
        responseTypeCode: rtChoice.code,
        mirrorMode: MIRROR.mode,
        learning: { updatedParams: _updatedParams, avgDelta: +_avgDelta.toFixed(6) },
        latencyMs: +(t1 - t0).toFixed(3)
      }
    };
  }

  /* ==========================================================================
     ПРОГРЕВ: прогоняем forward+backprop на примерах интентов
     ========================================================================== */
  (function warmup(){
    for (let i = 0; i < INTENTS.length; i++){
      const ex = INTENTS[i].examples[0];
      if (!ex) continue;
      const x = embedText(ex);
      const hidden = forward(x);
      const target = new Float32Array(EMB);
      const off = i * EMB;
      for (let j = 0; j < EMB; j++) target[j] = PARAMS.intentEmb[off + j];
      backpropThroughHidden(x, target);
    }
  })();

  /* ==========================================================================
     API
     ========================================================================== */
  function setMood(n){ MOOD_SCORE = clamp(n|0, 0, 100); return moodOf(MOOD_SCORE); }
  function getFacts(){ return Object.fromEntries(MEMORY.facts); }
  function getStats(){
    const used = ['tokEmb','intentEmb','tplEmb','moodEmb','rtEmb',
                  'L1W','L1b','L2W','L2b','L3W','L3b','L4W','L4b',
                  'moodHead','moodBias','rtHead','rtBias'];
    let total = 0;
    for (const k of used) total += PARAMS[k].length;
    return {
      parametersUsed: total,
      parametersAllocated: PARAMS.__total,
      vocabSize: VOCAB.length,
      intents: INTENTS.length,
      templates: TEMPLATES.length,
      moods: MOODS.length,
      responseTypes: RTYPES.length
    };
  }
  function handleCommand(text){
    let m = text.match(/^\/mood\s*[:=]?\s*(\d+)/i);
    if (m){
      setMood(parseInt(m[1], 10));
      const mm = moodOf(MOOD_SCORE);
      return 'Настроение: ' + MOOD_SCORE + ' (' + mm.n + '). ' + mm.e;
    }
    if (/^\/facts\b/i.test(text)){
      if (!MEMORY.facts.size) return 'Пока ничего не помню о тебе.';
      const lines = [];
      MEMORY.facts.forEach((v, k) => lines.push('• ' + k + ': ' + (Array.isArray(v) ? v.join(', ') : v)));
      return 'Помню:\n' + lines.join('\n');
    }
    if (/^\/stats\b/i.test(text)){
      const s = getStats();
      return 'v7 · ' + s.parametersUsed.toLocaleString('ru-RU') + ' параметров · ' +
             s.intents + ' интентов · ' + s.templates + ' шаблонов · ход: ' + MEMORY.turn;
    }
    if (/^\/reset\b/i.test(text)){
      reset();
      return 'Сброшено.';
    }
    return null;
  }

  function reset(){
    MEMORY.facts.clear();
    MEMORY.dialogue = { pendingQuestion: null, lastIntent: null, intentChain: [], lastUserText: '', lastAIReply: '' };
    MEMORY.context = [];
    MEMORY.recentReplies = [];
    MEMORY.skeletons = [];
    MEMORY.turn = 0;
    MEMORY.userName = null;
    MOOD_SCORE = 45;
  }

  /* финальная проверка: чтобы гарантировать что функции доступны */
  function handle(text, opts){ return respond(text, opts); }

  return {
    respond: handle,
    setMood, getFacts, getStats, reset,
    handleCommand
  };
}

/* ============================================================================
   ОБЁРТКА ДЛЯ ПЕСОЧНИЦЫ
   ============================================================================ */
var _ktalk7 = makeKtalk7AI();

/* загружаем словарь из KT.DICT — первые 5000 слов */
try {
  if (window.KT && window.KT.DICT && window.KT.DICT.length){
    /* API v7 не имеет loadWords в return — но у нас базовый словарь уже внутри.
       Если хочешь пополнять внешними словами — раскомментируй: */
    /* for (let i = 0; i < Math.min(5000, window.KT.DICT.length); i++){
      // добавляем только если не занято
    } */
  }
} catch(e){}

return {
  async send(text, ctx){
    await KT.sleep(280 + Math.random() * 400);
    try {
      var txt = String(text || '');

      /* встроенные команды отвечают синхронно */
      var cmd = _ktalk7.handleCommand(txt);
      if (cmd) return cmd;

      var r = _ktalk7.respond(txt, ctx || {});
      var out = r.reply || '…';
      if (r.second) out = out + '\n' + r.second;
      return out;
    } catch(e){
      console.error('[ktalk7]', e);
      return '…';
    }
  },
  reset(){
    _ktalk7 = makeKtalk7AI();
  },
  getThinking(){
    return null;
  }
};
</script>
