      y2:['Что дальше?','Продолжай.','Кталк слушает.']
    }
  };
  F.no = {
    k:'нет не неа никак'.split(' '),
    e:['нет','не','неа','никак'],
    t:[
      ['{n}','st,op','all'],
      ['{n}. {n2}','st,op','all'],
      ['{n}! {n2}','ex,st','warm+'],
      ['{n}','st,op','warm+'],
      ['{n}.','st,op','warm+']
    ],
    s:{
      n:['Ладно','Понял','Принято','Ок'],
      n2:['Что тогда?','Как скажешь.','Кталк не настаивает.']
    }
  };
  F.maybe = {
    k:'может наверное возможно'.split(' '),
    e:['может','наверное','возможно','не знаю точно'],
    t:[
