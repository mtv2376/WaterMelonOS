function stem(w){ if(w.length<5)return w; for(var i=0;i<SUF.length;i++){var s=SUF[i]; if(w.length>s.length+3&&w.endsWith(s)) return w.slice(0,-s.length);} return w; }
var contentStems = function(t){ return tokens(t).filter(function(w){return !STOP.has(w)&&w.length>1;}).map(stem); };

