// -------------------------------------------------------------
// SECTION 1.10 — Финальный маркер Part 1
// -------------------------------------------------------------

const __IKW_PART1_LOADED = true;
// =============================================================
// PART 2 — Токенизатор, стеммер, классификатор, AI_PRONOUNS
// =============================================================

// -------------------------------------------------------------
// SECTION 2.1 — Токенизация русского текста
// Разбивает текст на токены с сохранением исходной формы.
// Токен = { form, lower, stem, isPunct, isDigit, isWord, idx }
// -------------------------------------------------------------

function _isWordChar(ch){
  if (!ch) return false;
  const c = ch.toLowerCase();
  if ("абвгдеёжзийклмнопрстуфхцчшщъыьэюя".indexOf(c) !== -1) return true;
  if (c >= "a" && c <= "z") return true;
  if (c >= "0" && c <= "9") return true;
  return false;
}

function _isDigitChar(ch){
  if (!ch) return false;
  return ch >= "0" && ch <= "9";
}

function _isPunctChar(ch){
  if (!ch) return false;
  return PUNCT_CHARS[ch] === 1;
}

function _isSpaceChar(ch){
  if (!ch) return false;
  return ch === " " || ch === "\n" || ch === "\t" || ch === "\r";
}

function tokenizeRu(text){
  const out = [];
  if (!_isStr(text)) return out;
  let buf = "";
  let idx = 0;
  for (let i = 0; i < text.length; i++){
    const ch = text[i];
    if (_isWordChar(ch)){
      buf += ch;
    } else {
      if (buf.length > 0){
        out.push(_makeToken(buf, idx));
        idx++;
        buf = "";
      }
      if (!_isSpaceChar(ch)){
        out.push({
          form: ch,
          lower: ch.toLowerCase(),
          stem: ch,
          isPunct: _isPunctChar(ch),
          isDigit: false,
          isWord: false,
          idx: idx
        });
        idx++;
      }
    }
  }
  if (buf.length > 0){
    out.push(_makeToken(buf, idx));
  }
  return out;
}

function _makeToken(word, idx){
  const lower = word.toLowerCase();
  const isDigit = _isDigitChar(word[0]) && /^\d+$/.test(word);
  const isWord = !isDigit;
  return {
    form: word,
    lower: lower,
    stem: isWord ? stemRu(lower) : lower,
    isPunct: false,
    isDigit: isDigit,
    isWord: isWord,
    idx: idx
  };
}

function tokensToText(tokens){
  let out = "";
  for (let i = 0; i < tokens.length; i++){
    const t = tokens[i];
    if (i > 0 && t.isWord){
      const prev = tokens[i-1];
      if (prev && (prev.isWord || prev.isDigit)){
        out += " ";
      }
    }
    out += t.form;
  }
  return out;
}

// -------------------------------------------------------------
// SECTION 2.2 — Лёгкий русский стеммер
// Убирает наиболее частые окончания, сохраняя смысловой корень.
// НЕ идеальный, но достаточный для rule-based движка.
// -------------------------------------------------------------

const RU_ENDINGS_NOUN = {
  "ами": 1, "ями": 1, "иями": 1, "ов": 1, "ев": 1, "ёв": 1,
  "ах": 1, "ях": 1, "иях": 1, "ам": 1, "ям": 1, "иям": 1,
  "ой": 1, "ей": 1, "ий": 1, "ый": 1, "ая": 1, "яя": 1,
  "ое": 1, "ее": 1, "ые": 1, "ие": 1, "ом": 1, "ем": 1,
  "ём": 1, "у": 1, "ю": 1, "а": 1, "я": 1, "о": 1, "е": 1,
  "ы": 1, "и": 1, "й": 1, "ь": 1
};

const RU_ENDINGS_VERB = {
  "ать": 1, "ять": 1, "еть": 1, "ить": 1, "ыть": 1, "уть": 1,
  "аю": 1, "яю": 1, "ею": 1, "ию": 1, "ую": 1, "юю": 1,
  "аешь": 1, "яешь": 1, "ешь": 1, "ишь": 1, "уешь": 1,
  "ает": 1, "яет": 1, "ет": 1, "ит": 1, "ует": 1,
  "аем": 1, "яем": 1, "ем": 1, "им": 1, "уем": 1,
  "аете": 1, "яете": 1, "ете": 1, "ите": 1, "уете": 1,
  "ают": 1, "яют": 1, "ют": 1, "ут": 1, "ат": 1, "ят": 1,
  "ал": 1, "ял": 1, "ел": 1, "ил": 1, "ыл": 1, "ул": 1,
  "ала": 1, "яла": 1, "ела": 1, "ила": 1, "ыла": 1, "ула": 1,
  "ало": 1, "яло": 1, "ело": 1, "ило": 1, "ыло": 1, "уло": 1,
  "али": 1, "яли": 1, "ели": 1, "или": 1, "ыли": 1, "ули": 1,
  "ться": 1, "тся": 1, "шься": 1, "шь": 1, "л": 1, "ла": 1,
  "ло": 1, "ли": 1, "ть": 1
};

const RU_ENDINGS_ADJ = {
  "ейший": 1, "айший": 1, "ейшая": 1, "ейшее": 1, "ейшие": 1,
  "ейшего": 1, "ейшему": 1, "ейшим": 1, "ейших": 1, "ейшей": 1,
  "ейшую": 1, "ейшем": 1, "ее": 1, "ей": 1, "его": 1, "ему": 1,
  "им": 1, "их": 1, "ую": 1, "юю": 1, "ом": 1, "ем": 1
};

const MIN_STEM_LEN = 3;

function stemRu(word){
  if (!_isStr(word) || word.length < MIN_STEM_LEN) return word;
  const w = word.replace(/ё/g, "е");
  let best = w;
  let bestLen = w.length;

  const tryCut = (endings) => {
    const ks = _keys(endings);
    for (let i = 0; i < ks.length; i++){
      const e = ks[i];
      if (e.length >= w.length) continue;
      if (_endsWith(w, e)){
        const candidate = w.slice(0, w.length - e.length);
        if (candidate.length >= MIN_STEM_LEN && candidate.length < bestLen){
          best = candidate;
          bestLen = candidate.length;
        }
      }
    }
  };

  tryCut(RU_ENDINGS_ADJ);
  tryCut(RU_ENDINGS_VERB);
  tryCut(RU_ENDINGS_NOUN);

  return best;
}

// -------------------------------------------------------------
// SECTION 2.3 — AI_PRONOUNS (критичный компонент)
// Местоимения, направленные на собеседника-ИИ.
// Если объект эмоции — AI_PRONOUN → intent = compliment_ai,
// НЕ тема love/hate.
// -------------------------------------------------------------

const AI_PRONOUNS = {
  "ты": 1, "тебя": 1, "тебе": 1, "тобой": 1, "тобою": 1,
  "твой": 1, "твоя": 1, "твоё": 1, "твое": 1, "твои": 1,
  "твоего": 1, "твоему": 1, "твоим": 1, "твоих": 1,
  "твоей": 1, "твою": 1, "твоём": 1, "твоем": 1,
  "те": 1
};

const AI_PRONOUN_STEMS = new Set([
  "т", "теб", "тоб", "тво", "тв"
]);

const SELF_PRONOUNS = {
  "я": 1, "меня": 1, "мне": 1, "мной": 1, "мною": 1,
  "мой": 1, "моя": 1, "моё": 1, "мое": 1, "мои": 1,
  "моего": 1, "моему": 1, "моим": 1, "моих": 1,
  "моей": 1, "мою": 1, "моём": 1, "моем": 1,
  "себя": 1, "себе": 1, "собой": 1, "собою": 1,
  "свой": 1, "своя": 1, "своё": 1, "свое": 1, "свои": 1
};

const WE_PRONOUNS = {
  "мы": 1, "нас": 1, "нам": 1, "нами": 1,
  "наш": 1, "наша": 1, "наше": 1, "наши": 1,
  "нашего": 1, "нашему": 1, "нашим": 1, "наших": 1,
  "нашей": 1, "нашу": 1, "нашем": 1,
  "вы": 1, "вас": 1, "вам": 1, "вами": 1,
  "ваш": 1, "ваша": 1, "ваше": 1, "ваши": 1,
  "вашего": 1, "вашему": 1, "вашим": 1, "ваших": 1,
  "вашей": 1, "вашу": 1, "вашем": 1
};

const YOU_FORMAL = {
  "вы": 1, "вас": 1, "вам": 1, "вами": 1,
  "ваш": 1, "ваша": 1, "ваше": 1, "ваши": 1
};

function isAIPronoun(word){
  if (!_isStr(word)) return false;
  const w = word.toLowerCase();
  if (AI_PRONOUNS[w] === 1) return true;
  const s = stemRu(w);
  return AI_PRONOUN_STEMS.has(s);
}

function isSelfPronoun(word){
  if (!_isStr(word)) return false;
  return SELF_PRONOUNS[word.toLowerCase()] === 1;
}

function isWePronoun(word){
  if (!_isStr(word)) return false;
  return WE_PRONOUNS[word.toLowerCase()] === 1;
}

function isYouFormal(word){
  if (!_isStr(word)) return false;
  return YOU_FORMAL[word.toLowerCase()] === 1;
}

