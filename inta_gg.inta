};
var TOPIC_KEYS = Object.keys(T);

/* ═══════════════════════ ФАКТЫ ═══════════════════════ */
var FACT_RULES = [
  { key:'name', re:/(?:меня зовут|моё имя|моя имя|зови меня|можно просто)\s+([А-ЯЁA-Z][а-яёa-z\-]{1,25})/i, post:function(s){ return cap(s); } },
  { key:'name', re:/^я\s+([А-ЯЁA-Z][а-яёa-z\-]{2,25})$/i, post:function(s){ return cap(s); } },
  { key:'age', re:/мне\s+(\d{1,3})\s*(?:лет|года|год)?/i, post:function(s){ return parseInt(s,10); } },
  { key:'age', re:/мой возраст\s*[—\-:]?\s*(\d{1,3})/i, post:function(s){ return parseInt(s,10); } },
  { key:'city', re:/(?:я из|я живу в|живу в|я в)\s+([А-ЯЁ][а-яё\-]{2,30})/i, post:function(s){ return cap(s); } },
  { key:'job', re:/(?:я работаю|работаю)\s+([а-яёa-z\-]{3,30})/i, post:function(s){ return s; } },
  { key:'hobby', re:/(?:я увлекаюсь|увлекаюсь|моё хобби|хобби)\s*[—\-:]?\s*([а-яёa-z\-]{3,30})/i, post:function(s){ return s; } },
  { key:'likes', re:/я люблю\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'likes', re:/мне нравится\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'dislikes', re:/я не люблю\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'dislikes', re:/ненавижу\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true },
  { key:'has', re:/у меня есть\s+([а-яёa-z\- ]{2,40})/i, post:function(s){ return s.trim(); }, append:true }
];
var SURNAMES_RE = /(пупкин|иванов|петров|сидоров|кузнецов|смирнов|попов|васильев|михайлов|новиков|фёдоров|морозов|волков|алексеев|лебедев|семёнов|егоров|павлов|козлов|степанов)/i;
var COMMON_NAMES_RE = /^(думаю|знаю|хочу|могу|буду|люблю|вижу|слышу|говорю|делаю|живу|работаю|учусь|играю|читаю|пишу|ем|сплю)/i;

/* ═══════════════════════ МАТЕМАТИКА ═══════════════════════ */
function solveMath(text){
  var s = String(text).replace(/[×х]/gi,'*').replace(/÷/g,'/').replace(/,/g,'.').replace(/\s+/g,'');
  var m = s.match(/[-+]?[\d.+\-*/^()%]{3,}/);
  if (!m) return null;
  var expr = m[0].replace(/[+\-*/^.]*$/,'');
  if (!/[+\-*/^%]/.test(expr) || !/\d/.test(expr)) return null;
  expr = expr.replace(/\^/g,'**');
  try {
    var v = Function('"use strict";return('+expr+')')();
    if (typeof v!=='number' || !isFinite(v)) return null;
    var r = Math.abs(v-Math.round(v))<1e-9 ? Math.round(v) : +v.toFixed(6);
    return { expr:m[0].trim(), value:r };
  } catch(e){ return null; }
}

/* ═══════════════════════ ПАМЯТЬ ═══════════════════════ */
function createMEM(){
  return {
    user:{ name:null, age:null, city:null, job:null, hobby:null, likes:[], dislikes:[], has:[] },
    history:[], learned:new Map(), unknownAsked:null,
    recentReplies:[], skeletons:[],
    turn:0, mood:60,
    relationship:20, trust:0, energy:100,
    lastIntent:null, lastTopic:null,
    lastUserText:'', lastAIMessage:'',
    usedReplies:{}, topicChain:[],
    consecutiveFallbacks:0, pendingQuestion:null
  };
}
var MEM = createMEM();
function pushHistory(role, text){
  MEM.history.push({ role:role, text:text, ts:Date.now() });
  if (MEM.history.length > 500) MEM.history.shift();
}

/* ═══════════════════════ V3 — EXTRACT / DETECT / SENTIMENT ═══════════════════════ */
function v3Extract(text){
  var e = {};
  var nm = text.match(/(?:меня\s+зовут|мо[её]\s+имя|зови\s+меня|можно\s+просто|я\s*[-—]\s*|я\s+)([А-ЯЁA-Z][а-яёa-z]{2,15})/);
  if (nm){
    var skip = ['Не','Да','Нет','Ок','Норм','Крутой','Крутая','Кталк','Тоже','Такой','Такая','Тупой','Только','Очень','Просто','Мужчин','Женщин','Мужчина','Женщина','Парень','Девушка','Человек','Дурак'];
    if (skip.indexOf(nm[1]) === -1 && nm[1].length >= 3 && !SURNAMES_RE.test(nm[1]) && !COMMON_NAMES_RE.test(nm[1])) e.name = cap(nm[1]);
  }
  var ag = text.match(/(\d{1,2})\s*(?:лет|года|год)/);
  if (ag){ var n = parseInt(ag[1],10); if (n >= 10 && n <= 99) e.age = n; }
  var ct = text.match(/(?:из|живу\s+в|город[е]?|родился\s+в|родилась\s+в)\s+([А-ЯЁA-Z][а-яёa-z]{3,15})/);
  if (ct && ct[1].length >= 3) e.city = cap(ct[1]);
  var lk = text.match(/(?:люблю|обожаю|нравится|увлекаюсь|кайфую\s+от|фанат)\s+([а-яё]{3,20})/);
  if (lk && ['тебя','тебе','себя','когда','очень','всё','всех','это'].indexOf(lk[1]) === -1) e.like = lk[1];
  var dl = text.match(/(?:не\s+люблю|ненавижу|терпеть\s+не\s+могу|бесит)\s+([а-яё]{3,20})/);
  if (dl) e.dislike = dl[1];
  var hb = text.match(/(?:играю\s+в|смотрю|читаю|слушаю)\s+([а-яё]{3,20})/);
  if (hb) e.hobby = hb[1];
  if (/\?/.test(text)) e.question = true;
  e.keywords = tokens(text).filter(function(t){ return t.length>3 && ['этого','этому','такой','такая','очень','просто','вообще','когда','почему','зачем','будет','буду','хочешь','можно'].indexOf(t)===-1; });
  return e;
}

function v3DetectIntent(text, e){
  var t = ' ' + text.toLowerCase().trim() + ' ';
  var P = {
    greeting:[/\bпривет\b|здравств|^хай\b|здаров|^ку\b|добр(ое|ый)|hello|\bhi\b|приветик|^йо\b|^здорово/],
    farewell:[/\bпока\b|прощай|бай\b|\bbye\b|до\s+свид|ухожу|спать\s+пойду|отключаюсь|мне\s+пора/],
    how_are_you:[/как\s+(дела|ты|жизнь|настроение|сам|сама)|чё\s+как|что\s+нового|как\s+оно|как\s+поживаешь/],
    what_doing:[/что\s+(делаешь|делал|делала|поделываешь|нового)|чем\s+занимаешься/],
    love:[/\bлюблю\s+тебя|влюбился|влюбилась|влюблен|ты\s+мне\s+нравишься|я\s+в\s+тебя|обожаю\s+тебя/],
    sex:[/\bсекс\b|\bsex\b|18\+|трахн|минет|интим|разврат|хочу\s+тебя|целова|голый|голая|возбуд|потрах|переспать|заняться\s+любовью/],
    compliment:[/молодец|классн|крут(ая|ой|о)?\b|хорош(ая|ий|о)\b|мил(ая|ый)|прекрасн|красив|умн(ая|ый)|обалден|шикарн|лучш(ая|ий)|нравишься|прелестн/],
    insult:[/\bдурак\b|\bдура\b|тупой|тупая|\bидиот|дебил|придурок|кретин|ненавиж|бесишь|отстань|заткн|отвали|иди\s+на/],
    thanks:[/спасибо|благодар|\bспс\b|пасиб/],
    apology:[/извини|прости|сори\b|sorry|виноват/],
    agree:[/^\s*да\b|конечно|согласен|согласна|^\s*ок\b|окей|хорошо|давай|ага\b|угу\b|верно|точно|разумеется/],
    disagree:[/^\s*нет\b|не\s+согласен|не\s+согласна|неа\b|не\s+хочу|не\s+буду|вряд\s+ли|неправда/],
    maybe:[/может\s+быть|возможно|наверное|не\s+знаю/],
    flirt:[/флирт|свидан|встреч|погуля|сходим|приглашаю|пойдём|пошли|давай\s+увидимся|познакомимся|давай\s+дружить/],
    ktalk:[/\bкталк|ктулху|ktalk|кталка|кталки|кталков|кталками|кталкам/],
    food:[/\bеда\b|кушать|есть\s+хочу|голод|обед|ужин|завтрак|пицц|бургер|суши|кофе|\bчай\b|морожен|шоколад|печень/],
    time:[/\bвремя\b|который\s+час|сколько\s+времени/],
    joke:[/шутк|анекдот|расскажи\s+что|пошути|смешн|развесели|развлеки/],
    about_ai:[/как\s+тебя\s+зовут|кто\s+ты|откуда\s+ты|сколько\s+тебе\s+лет|твой\s+возраст|расскажи\s+о\s+себе|ты\s+человек|ты\s+бот|ты\s+робот|ты\s+живой|что\s+ты\s+умеешь/],
    about_user:[/как\s+меня\s+зовут|сколько\s+мне\s+лет|что\s+я\s+люблю|помнишь\s+меня|что\s+ты\s+обо\s+мне|расскажи\s+обо\s+мне/],
    good:[/отличн|хорошо\s+мне|класс|супер|прекрасн|\bрад\b|\bрада\b|счастлив|счастлива|весело|кайф/],
    bad:[/плохо|груст|печаль|устал|тяжело|депресс|плачу|беда|больно|страда|одиноко|тяжко/],
    confusion:[/не\s+понял|не\s+поняла|не\s+понимаю|в\s+смысле|что\s+это\s+такое|что\s+значит/],
    topic_propose:[/о\s+ч[её]м\s+(хочешь|будешь|можешь|поговорим)|давай\s+поговорим|предложи\s+тему|о\s+ч[её]м\s+поговорим/],
    elaborate:[/в\s+ч[её]м\s+(не\s+уверен|сомневаешься)|объясни|поясни|раскрой|расскажи\s+подробнее|давай\s+подробнее|пример/],
    challenge:[/попробуй|давай\s+попробуй|ну\s+скажи|ну\s+давай/]
  };
  var best = 'other', bestScore = 0;
  for (var intent in P){
    var score = 0;
    for (var i = 0; i < P[intent].length; i++) if (P[intent][i].test(t)) score++;
    if (score > bestScore){ bestScore = score; best = intent; }
  }
  if (bestScore === 0){
    if (e.name) best = 'name_intro';
    else if (e.age) best = 'share_age';
    else if (e.like) best = 'share_like';
    else if (e.dislike) best = 'share_dislike';
    else if (e.hobby) best = 'share_hobby';
    else if (e.city) best = 'share_city';
    else if (e.question) best = 'question';
    else if (e.keywords && e.keywords.length > 0) best = 'statement';
  }
  return best;
}

function v3Sentiment(toks){
  var pos = ['хорош','класс','крут','люблю','обожаю','рад','счаст','супер','прекрасн','мил','нрав','спасибо','отличн','приятн','кайф','обалден'];
  var neg = ['плохо','груст','ненавиж','бесит','злой','тупо','устал','тяжело','депресс','печаль','бол','обид','скучн'];
  var s = 0;
  for (var i = 0; i < toks.length; i++){
    if (pos.indexOf(toks[i]) >= 0) s++;
    if (neg.indexOf(toks[i]) >= 0) s--;
  }
  return s > 0 ? 1 : (s < 0 ? -1 : 0);
}

function v3Update(e, intent, senti, userText){
  /* ФИКС: убран MEM.turn++ — turn инкрементируется только в respond */
  MEM.lastUserText = userText;
  if (e.name && !MEM.user.name){ MEM.user.name = e.name; MEM.trust += 5; }
  if (e.age) MEM.user.age = e.age;
  if (e.city) MEM.user.city = e.city;
  if (e.like && MEM.user.likes.indexOf(e.like) === -1) MEM.user.likes.push(e.like);
  if (e.dislike && MEM.user.dislikes.indexOf(e.dislike) === -1) MEM.user.dislikes.push(e.dislike);
  if (e.hobby) MEM.user.hobby = e.hobby;

  MEM.mood = clamp(MEM.mood + senti*2 + (intent==='insult'?-3:intent==='compliment'?3:intent==='love'?3:intent==='flirt'?2:0), 0, 100);
  MEM.energy = Math.max(0, MEM.energy - 1);

  if (intent === 'compliment' || intent === 'love' || intent === 'flirt') MEM.relationship += 4;
  else if (intent === 'insult') MEM.relationship -= 6;
  else if (intent === 'agree' || intent === 'thanks' || intent === 'greeting' || intent === 'joke' || intent === 'good') MEM.relationship += 1;
  else MEM.relationship += 0.3; /* медленный рост за любой диалог */
  MEM.relationship = clamp(MEM.relationship, 0, 100);

  if (intent !== 'other' && intent !== 'statement'){
    if (MEM.lastIntent !== intent) MEM.topicChain = [intent];
    else MEM.topicChain.push(intent);
    if (MEM.topicChain.length > 8) MEM.topicChain.shift();
  }
  MEM.lastIntent = intent;
}

