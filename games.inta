inta.stg:{namer,icon,background
namer:app.name:["Restaurant Tycoon"],what.name=namer
icon:app.ico:["🍽️"],what.ico=icon
background:app.bg:[#0a1710],what.ico.bg=background
}
IL.cfg={scripts:all}
Inta.cfg={pc,tablet,phone}
load.stop_parse.inta

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Restaurant Tycoon</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:#0a0a12;color:#fff;user-select:none;-webkit-user-select:none}
#c{display:block;position:fixed;inset:0;touch-action:none}
#hud{position:fixed;top:0;left:0;right:0;padding:8px 10px;display:flex;gap:8px;align-items:center;background:linear-gradient(180deg,rgba(0,0,0,.7),transparent);z-index:10;pointer-events:none}
.pill{background:rgba(15,20,30,.85);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:6px 14px;font-size:13px;font-weight:600;display:flex;gap:6px;align-items:center;backdrop-filter:blur(6px)}
.pill .ic{font-size:15px}
.pill.gold{color:#ffd166;border-color:rgba(255,209,102,.3)}
.pill.blue{color:#90e0ef;border-color:rgba(144,224,239,.3)}
.pill.pink{color:#ff8fa3;border-color:rgba(255,143,163,.3)}
#hud .spacer{flex:1}
#bottombar{position:fixed;bottom:0;left:0;right:0;padding:10px;display:flex;gap:8px;justify-content:center;background:linear-gradient(0deg,rgba(0,0,0,.8),transparent);z-index:10;flex-wrap:wrap}
.btn{background:rgba(15,20,30,.9);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:11px 18px;color:#fff;font-size:13px;font-weight:600;cursor:pointer;backdrop-filter:blur(8px);transition:.15s;display:flex;gap:6px;align-items:center}
.btn:hover{background:rgba(35,45,65,.95);border-color:rgba(255,255,255,.25)}
.btn:active{transform:scale(.95)}
.btn.primary{background:linear-gradient(135deg,#ff4d6d,#c9184a);border-color:transparent}
.btn.green{background:linear-gradient(135deg,#52b788,#2d6a4f);border-color:transparent}
#panel{position:fixed;top:56px;bottom:64px;left:10px;right:10px;max-width:640px;margin:0 auto;background:rgba(15,20,30,.97);border:1px solid rgba(255,255,255,.15);border-radius:16px;display:none;flex-direction:column;z-index:20;overflow:hidden;backdrop-filter:blur(10px)}
#panel.on{display:flex}
.ph{padding:14px 18px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.ph h2{font-size:17px}
.ph .close{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.08);border:0;color:#fff;font-size:15px;cursor:pointer}
.pb{flex:1;overflow-y:auto;padding:14px}
.pb::-webkit-scrollbar{width:6px}
.pb::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:3px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}
.card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:12px;cursor:pointer;transition:.15s;display:flex;flex-direction:column;gap:6px}
.card:hover{background:rgba(255,255,255,.08);border-color:rgba(255,209,102,.4)}
.card:active{transform:scale(.97)}
.card.disabled{opacity:.4;cursor:not-allowed}
.card .emoji{font-size:28px;line-height:1}
.card .name{font-size:13px;font-weight:600}
.card .cost{font-size:11.5px;color:#ffd166;font-weight:700}
.card .sub{font-size:10.5px;opacity:.5}
#toast{position:fixed;top:80px;left:50%;transform:translateX(-50%);background:rgba(20,20,30,.95);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:11px 18px;font-size:13px;font-weight:600;z-index:100;opacity:0;transition:.3s;pointer-events:none;max-width:90%;text-align:center}
#toast.on{opacity:1}
#placehint{position:fixed;top:56px;left:50%;transform:translateX(-50%);background:rgba(255,77,109,.95);padding:8px 16px;border-radius:20px;font-size:12px;font-weight:600;z-index:15;display:none}
#placehint.on{display:block}
#loading{position:fixed;inset:0;background:#0a0a12;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:1000;font-size:14px}
.spinner{width:44px;height:44px;border:3px solid rgba(255,255,255,.15);border-top-color:#ff4d6d;border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.dishRow{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:rgba(255,255,255,.04);border-radius:10px;margin-bottom:6px;font-size:13px}
.dishRow.locked{opacity:.5}
.dishRow .info{display:flex;flex-direction:column;gap:2px}
.dishRow .p{color:#95d5b2;font-weight:700;font-size:12px}
.dishRow .c{color:#ffd166;font-size:11.5px}
.dishRow button{padding:7px 14px;border-radius:8px;border:0;cursor:pointer;font-size:12px;font-weight:600;font-family:inherit}
.dishRow .unlock{background:linear-gradient(135deg,#ff4d6d,#c9184a);color:#fff}
.dishRow .unlocked{background:rgba(82,183,136,.25);color:#95d5b2;cursor:default}
@media(max-width:520px){.grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}.btn{padding:10px 13px;font-size:12px}.pill{padding:5px 10px;font-size:12px}}
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="hud">
  <div class="pill gold"><span class="ic">💰</span><span id="money">0</span></div>
  <div class="pill blue"><span class="ic">👥</span><span id="cust">0</span></div>
  <div class="pill pink"><span class="ic">⭐</span><span id="rep">100</span></div>
</div>

<div id="placehint">Выбери место на полу · тап по пустой клетке</div>

<div id="bottombar">
  <button class="btn primary" id="bShop">🛒 Магазин</button>
  <button class="btn green" id="bMenu">📖 Меню</button>
  <button class="btn" id="bSpeed">⏩ 1×</button>
  <button class="btn" id="bHelp">❓</button>
</div>

<div id="panel">
  <div class="ph"><h2 id="ptitle">Магазин</h2><button class="close" id="pclose">✕</button></div>
  <div class="pb" id="pbody"></div>
</div>

<div id="toast"></div>

<div id="loading"><div class="spinner"></div><div>Загрузка 3D‑движка…</div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(()=>{"use strict";
if(!window.THREE){document.getElementById('loading').innerHTML='<div style="color:#ffb3c1">Не удалось загрузить Three.js. Проверь интернет.</div>';return}

/* ==========================================================
   ХРАНИЛИЩЕ
   ========================================================== */
const MEM={};
const Store={
  get(k){try{return localStorage.getItem(k)}catch{return MEM[k]||null}},
  set(k,v){try{localStorage.setItem(k,v)}catch{MEM[k]=String(v)}},
  del(k){try{localStorage.removeItem(k)}catch{delete MEM[k]}}
};
const SAVE_KEY='wmos:rt:save';

/* ==========================================================
   КОНСТАНТЫ МИРА
   ========================================================== */
const GW=16,GH=12,TILE=1.1;         // сетка
const TW=GW*TILE,TH=GH*TILE;        // размеры пола

/* ==========================================================
   МОДЕЛИ БЛЮД — 1 строка на блюдо
   id, назв, цена продажи, цена ингр., сек. готовки, цвет, форма
   ========================================================== */
const DISHES=[
['burger','Бургер',340,120,4,0xc98b55,'stack'],
['pizza','Пицца',520,180,6,0xd9a441,'flat'],
['salad','Салат',260,80,3,0x4a8b3f,'bowl'],
['soup','Суп',220,70,5,0xc44a1a,'bowl'],
['steak','Стейк',680,240,7,0x8b3a1f,'steak'],
['sushi','Суши',560,200,6,0xf4a261,'roll'],
['pasta','Паста',420,140,5,0xd9a441,'noodle'],
['fish','Рыба',580,220,6,0x88bbcc,'fish'],
['sandwich','Сэндвич',240,70,3,0xc98b55,'stack'],
['icecream','Мороженое',200,50,2,0xffeedd,'cone'],
['cake','Торт',360,110,4,0xffaabb,'cake'],
['coffee','Кофе',140,30,2,0x4a2a1a,'cup'],
['tea','Чай',120,25,2,0xbb8844,'cup'],
['juice','Сок',160,40,2,0xffaa33,'cup'],
['water','Вода',90,15,1,0x88bbdd,'cup'],
['fries','Картофель фри',220,60,3,0xf0c040,'fries'],
['hotdog','Хот-дог',260,80,3,0xc98b55,'stack'],
['taco','Тако',300,90,3,0xd9a441,'taco'],
['wings','Крылышки',380,120,5,0xa8422a,'wings'],
['ramen','Рамен',460,160,6,0xd9a441,'bowl'],
];
const DISH={};DISHES.forEach(d=>DISH[d[0]]={id:d[0],name:d[1],price:d[2],cost:d[3],time:d[4],color:d[5],shape:d[6]});

/* ==========================================================
   МАГАЗИН — предметы для расстановки
   ========================================================== */
const ITEMS={
  table2:{name:'Стол на 2',emoji:'🪑',cost:800,seats:2,build:buildTable2},
  table4:{name:'Стол на 4',emoji:'🪑',cost:1500,seats:4,build:buildTable4},
  chair:{name:'Стул',emoji:'💺',cost:250,build:buildChair},
  stove:{name:'Плита',emoji:'🔥',cost:3000,build:buildStove,cook:1},
  counter:{name:'Стол-раздача',emoji:'🧑‍🍳',cost:1200,build:buildCounter,serve:1},
  register:{name:'Касса',emoji:'💵',cost:2000,build:buildRegister},
  plant:{name:'Растение',emoji:'🌿',cost:350,build:buildPlant},
  painting:{name:'Картина',emoji:'🖼️',cost:900,build:buildPainting},
  lamp:{name:'Лампа',emoji:'💡',cost:600,build:buildLamp},
  rug:{name:'Ковёр',emoji:'🟥',cost:700,build:buildRug,flat:1},
};

/* ==========================================================
   СЦЕНА
   ========================================================== */
const canvas=document.getElementById('c');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,powerPreference:'high-performance'});
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
renderer.setSize(innerWidth,innerHeight,false);
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.outputEncoding=THREE.sRGBEncoding;

const scene=new THREE.Scene();
scene.background=new THREE.Color(0x0d1420);
scene.fog=new THREE.Fog(0x0d1420,26,45);

const camera=new THREE.PerspectiveCamera(42,innerWidth/innerHeight,.1,200);
const cam={theta:Math.PI/4,phi:0.9,dist:18,target:new THREE.Vector3(0,0.5,0)};
updateCamera();

/* Свет */
scene.add(new THREE.AmbientLight(0xffffff,.55));
const sun=new THREE.DirectionalLight(0xffe4b5,1.15);
sun.position.set(8,18,6);sun.castShadow=true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left=-14;sun.shadow.camera.right=14;
sun.shadow.camera.top=14;sun.shadow.camera.bottom=-14;
sun.shadow.camera.near=1;sun.shadow.camera.far=40;
sun.shadow.bias=-0.0004;
scene.add(sun);

/* Тёплый свет от люстр */
const warm1=new THREE.PointLight(0xffaa55,.85,16,2);warm1.position.set(-3,4,0);scene.add(warm1);
const warm2=new THREE.PointLight(0xffaa55,.85,16,2);warm2.position.set(3,4,0);scene.add(warm2);

/* ==========================================================
   ПОЛ И СТЕНЫ
   ========================================================== */
buildRoom();

function buildRoom(){
  const floorGeo=new THREE.BoxGeometry(TW,.1,TH);
  const floorMat=new THREE.MeshStandardMaterial({color:0x3a2418,roughness:.85});
  const floor=new THREE.Mesh(floorGeo,floorMat);
  floor.position.y=-.05;floor.receiveShadow=true;scene.add(floor);

  // шахматные плитки для стиля
  for(let gx=0;gx<GW;gx++)for(let gy=0;gy<GH;gy++){
    if((gx+gy)%2===0)continue;
    const t=new THREE.Mesh(new THREE.BoxGeometry(TILE-.05,.02,TILE-.05),
      new THREE.MeshStandardMaterial({color:0x4a2e1f,roughness:.8}));
    t.position.set(gxToX(gx),.005,gyToZ(gy));
    t.receiveShadow=true;scene.add(t);
  }

  // стены
  const wallMat=new THREE.MeshStandardMaterial({color:0x1c1c2a,roughness:.9});
  const wallH=3.2,t=.2;
  const w1=new THREE.Mesh(new THREE.BoxGeometry(TW+t*2,wallH,t),wallMat);
  w1.position.set(0,wallH/2,-TH/2-t/2);w1.receiveShadow=true;w1.castShadow=true;scene.add(w1);
  const w2=w1.clone();w2.position.z=TH/2+t/2;scene.add(w2);
  const w3=new THREE.Mesh(new THREE.BoxGeometry(t,wallH,TH+t*2),wallMat);
  w3.position.set(-TW/2-t/2,wallH/2,0);w3.receiveShadow=true;w3.castShadow=true;scene.add(w3);
  const w4=w3.clone();w4.position.x=TW/2+t/2;scene.add(w4);

  // молдинг
  const trimMat=new THREE.MeshStandardMaterial({color:0x6b3a2a,roughness:.7});
  const trims=[
    [TW+t*2,.15,t,0,.02,-TH/2-t/2],
    [TW+t*2,.15,t,0,.02, TH/2+t/2],
    [t,.15,TH+t*2,-TW/2-t/2,.02,0],
    [t,.15,TH+t*2, TW/2+t/2,.02,0],
  ];
  trims.forEach(([a,b,c,px,py,pz])=>{
    const m=new THREE.Mesh(new THREE.BoxGeometry(a,b,c),trimMat);
    m.position.set(px,py,pz);scene.add(m);
  });
}

function gxToX(gx){return (gx-(GW-1)/2)*TILE}
function gyToZ(gy){return (gy-(GH-1)/2)*TILE}
function xToGx(x){return Math.round(x/TILE+(GW-1)/2)}
function zToGy(z){return Math.round(z/TILE+(GH-1)/2)}

/* ==========================================================
   БИЛДЕРЫ МЕБЕЛИ
   ========================================================== */
function mat(c,r=.7,m=0){return new THREE.MeshStandardMaterial({color:c,roughness:r,metalness:m})}

function buildTable2(){
  const g=new THREE.Group();
  const top=new THREE.Mesh(new THREE.BoxGeometry(.85,.08,.85),mat(0x8b5a3a,.6));
  top.position.y=.75;top.castShadow=true;top.receiveShadow=true;g.add(top);
  const leg=new THREE.Mesh(new THREE.BoxGeometry(.12,.75,.12),mat(0x4a2a1a,.6));
  leg.position.y=.375;leg.castShadow=true;g.add(leg);
  // стулья
  const c1=buildChair();c1.position.set(0,0,.6);g.add(c1);
  const c2=buildChair();c2.position.set(0,0,-.6);g.add(c2);
  return g;
}
function buildTable4(){
  const g=new THREE.Group();
  const top=new THREE.Mesh(new THREE.BoxGeometry(1.2,.08,1.2),mat(0x8b5a3a,.6));
  top.position.y=.75;top.castShadow=true;top.receiveShadow=true;g.add(top);
  const leg=new THREE.Mesh(new THREE.BoxGeometry(.16,.75,.16),mat(0x4a2a1a,.6));
  leg.position.y=.375;leg.castShadow=true;g.add(leg);
  const c1=buildChair();c1.position.set(0,0,.85);g.add(c1);
  const c2=buildChair();c2.position.set(0,0,-.85);c2.rotation.y=Math.PI;g.add(c2);
  const c3=buildChair();c3.position.set(.85,0,0);c3.rotation.y=-Math.PI/2;g.add(c3);
  const c4=buildChair();c4.position.set(-.85,0,0);c4.rotation.y=Math.PI/2;g.add(c4);
  return g;
}
function buildChair(){
  const g=new THREE.Group();
  const seat=new THREE.Mesh(new THREE.BoxGeometry(.42,.06,.42),mat(0x6b3a2a,.7));
  seat.position.y=.45;seat.castShadow=true;g.add(seat);
  const back=new THREE.Mesh(new THREE.BoxGeometry(.42,.42,.06),mat(0x6b3a2a,.7));
  back.position.set(0,.66,-.18);back.castShadow=true;g.add(back);
  const leg=new THREE.Mesh(new THREE.BoxGeometry(.08,.42,.08),mat(0x3a1f12,.7));
  leg.position.y=.21;g.add(leg);
  return g;
}
function buildStove(){
  const g=new THREE.Group();
  const base=new THREE.Mesh(new THREE.BoxGeometry(1,.85,.9),mat(0x4a4a55,.5,.6));
  base.position.y=.425;base.castShadow=true;base.receiveShadow=true;g.add(base);
  const top=new THREE.Mesh(new THREE.BoxGeometry(1,.05,.9),mat(0x2a2a35,.4,.7));
  top.position.y=.875;g.add(top);
  // 4 круга
  for(let i=0;i<4;i++){
    const c=new THREE.Mesh(new THREE.CylinderGeometry(.11,.11,.02,16),mat(0x111,.6,.8));
    c.position.set(i%2?-.22:.22,.9,i<2?-.22:.22);g.add(c);
  }
  // светящаяся панель
  const panel=new THREE.Mesh(new THREE.PlaneGeometry(.25,.1),new THREE.MeshBasicMaterial({color:0xff3300}));
  panel.position.set(0,.55,.451);g.add(panel);
  return g;
}
function buildCounter(){
  const g=new THREE.Group();
  const b=new THREE.Mesh(new THREE.BoxGeometry(1.6,.9,.7),mat(0x9aa0a8,.5,.3));
  b.position.y=.45;b.castShadow=true;b.receiveShadow=true;g.add(b);
  const top=new THREE.Mesh(new THREE.BoxGeometry(1.7,.06,.8),mat(0xdddddd,.3,.5));
  top.position.y=.93;top.castShadow=true;g.add(top);
  return g;
}
function buildRegister(){
  const g=new THREE.Group();
  const b=new THREE.Mesh(new THREE.BoxGeometry(.7,.9,.7),mat(0x9aa0a8,.5,.3));
  b.position.y=.45;b.castShadow=true;b.receiveShadow=true;g.add(b);
  const screen=new THREE.Mesh(new THREE.BoxGeometry(.5,.35,.04),mat(0x0a0a14,.3,.5));
  screen.position.set(0,1.07,.35);g.add(screen);
  const glow=new THREE.Mesh(new THREE.PlaneGeometry(.44,.29),new THREE.MeshBasicMaterial({color:0x52b788}));
  glow.position.set(0,1.07,.37);g.add(glow);
  return g;
}
function buildPlant(){
  const g=new THREE.Group();
  const pot=new THREE.Mesh(new THREE.CylinderGeometry(.18,.14,.32,16),mat(0x8b3a1f,.7));
  pot.position.y=.16;pot.castShadow=true;g.add(pot);
  const soil=new THREE.Mesh(new THREE.CylinderGeometry(.16,.16,.04,16),mat(0x2a1a0a,.9));
  soil.position.y=.32;g.add(soil);
  for(let i=0;i<7;i++){
    const l=new THREE.Mesh(new THREE.SphereGeometry(.14,8,6),mat(0x2d6a4f,.7));
    l.position.set((Math.random()-.5)*.3,.42+Math.random()*.3,(Math.random()-.5)*.3);
    l.scale.set(1,.6,1);g.add(l);
  }
  return g;
}
function buildPainting(){
  const g=new THREE.Group();
  const f=new THREE.Mesh(new THREE.BoxGeometry(.9,.7,.06),mat(0x6b3a2a,.5));
  f.position.y=1.7;g.add(f);
  const c=new THREE.Mesh(new THREE.PlaneGeometry(.78,.58),
    new THREE.MeshStandardMaterial({color:0x3a86ff,roughness:.9,side:THREE.DoubleSide}));
  c.position.set(0,1.7,.035);g.add(c);
  return g;
}
function buildLamp(){
  const g=new THREE.Group();
  const pole=new THREE.Mesh(new THREE.CylinderGeometry(.03,.03,1.6,8),mat(0x222,.5,.6));
  pole.position.y=.8;g.add(pole);
  const base=new THREE.Mesh(new THREE.CylinderGeometry(.15,.2,.06,12),mat(0x222,.5,.6));
  g.add(base);
  const shade=new THREE.Mesh(new THREE.CylinderGeometry(.22,.3,.3,16,1,true),
    new THREE.MeshStandardMaterial({color:0xffd166,emissive:0xffaa33,emissiveIntensity:.8,side:THREE.DoubleSide}));
  shade.position.y=1.6;g.add(shade);
  const pl=new THREE.PointLight(0xffbb55,.6,5,2);pl.position.y=1.5;g.add(pl);
  return g;
}
function buildRug(){
  const g=new THREE.Group();
  const r=new THREE.Mesh(new THREE.BoxGeometry(2.4,.02,1.6),mat(0x8b1538,.9));
  r.position.y=.01;r.receiveShadow=true;g.add(r);
  const inner=new THREE.Mesh(new THREE.BoxGeometry(2.1,.025,1.3),mat(0xa01843,.9));
  inner.position.y=.012;g.add(inner);
  return g;
}

/* ==========================================================
   МОДЕЛИ БЛЮД
   ========================================================== */
function buildDishMesh(dish){
  const g=new THREE.Group();
  const plate=new THREE.Mesh(new THREE.CylinderGeometry(.34,.32,.045,20),mat(0xf0f0f0,.3));
  plate.castShadow=true;g.add(plate);
  const m=mat(dish.color,.55);
  const shape=dish.shape;
  if(shape==='stack'){
    for(let i=0;i<3;i++){
      const s=new THREE.Mesh(new THREE.BoxGeometry(.42,.06,.42),m);
      s.position.y=.08+i*.07;s.position.x=(Math.random()-.5)*.06;
      s.position.z=(Math.random()-.5)*.06;s.castShadow=true;g.add(s);
    }
  } else if(shape==='flat'){
    const f=new THREE.Mesh(new THREE.CylinderGeometry(.3,.3,.08,20),m);
    f.position.y=.1;f.castShadow=true;g.add(f);
  } else if(shape==='bowl'){
    const b=new THREE.Mesh(new THREE.SphereGeometry(.24,16,12,0,Math.PI*2,0,Math.PI/2),m);
    b.position.y=.15;b.rotation.x=Math.PI;b.castShadow=true;g.add(b);
  } else if(shape==='cup'){
    const c=new THREE.Mesh(new THREE.CylinderGeometry(.13,.11,.26,16),m);
    c.position.y=.17;c.castShadow=true;g.add(c);
    const h=new THREE.Mesh(new THREE.TorusGeometry(.08,.02,6,12),m);
    h.position.set(.13,.17,0);h.rotation.y=Math.PI/2;g.add(h);
  } else if(shape==='steak'){
    const s=new THREE.Mesh(new THREE.BoxGeometry(.42,.1,.3),m);
    s.position.y=.1;s.castShadow=true;g.add(s);
  } else if(shape==='roll'){
    for(let i=0;i<3;i++){
      const r=new THREE.Mesh(new THREE.CylinderGeometry(.09,.09,.18,12),m);
      r.position.set(-.15+i*.15,.15,0);r.rotation.z=Math.PI/2;r.castShadow=true;g.add(r);
    }
  } else if(shape==='noodle'){
    for(let i=0;i<6;i++){
      const n=new THREE.Mesh(new THREE.TorusGeometry(.13,.025,6,14),m);
      n.position.y=.11+i*.018;n.rotation.x=Math.PI/2;n.castShadow=true;g.add(n);
    }
  } else if(shape==='fish'){
    const f=new THREE.Mesh(new THREE.BoxGeometry(.5,.09,.22),m);
    f.position.y=.1;f.castShadow=true;g.add(f);
    const t=new THREE.Mesh(new THREE.ConeGeometry(.11,.15,4),m);
    t.position.set(-.3,.1,0);t.rotation.z=Math.PI/2;g.add(t);
  } else if(shape==='cone'){
    const c=new THREE.Mesh(new THREE.ConeGeometry(.14,.4,10),mat(0xd4a04a,.7));
    c.position.y=.22;c.rotation.x=Math.PI;c.castShadow=true;g.add(c);
    const s=new THREE.Mesh(new THREE.SphereGeometry(.14,12,10),m);
    s.position.y=.42;g.add(s);
  } else if(shape==='cake'){
    const b=new THREE.Mesh(new THREE.CylinderGeometry(.22,.22,.24,20),m);
    b.position.y=.17;b.castShadow=true;g.add(b);
    const top=new THREE.Mesh(new THREE.CylinderGeometry(.22,.22,.04,20),mat(0xff5577,.6));
    top.position.y=.31;g.add(top);
  } else if(shape==='fries'){
    for(let i=0;i<10;i++){
      const f=new THREE.Mesh(new THREE.BoxGeometry(.05,.28,.05),m);
      f.position.set((Math.random()-.5)*.3,.15+Math.random()*.06,(Math.random()-.5)*.3);
      f.rotation.z=(Math.random()-.5)*.4;f.castShadow=true;g.add(f);
    }
  } else if(shape==='taco'){
    const s=new THREE.Mesh(new THREE.SphereGeometry(.24,16,12,0,Math.PI,0,Math.PI/2),mat(0xd4a04a,.7));
    s.position.y=.1;s.rotation.y=Math.PI/2;s.castShadow=true;g.add(s);
    const f=new THREE.Mesh(new THREE.BoxGeometry(.3,.08,.15),m);
    f.position.y=.15;g.add(f);
  } else if(shape==='wings'){
    for(let i=0;i<4;i++){
      const w=new THREE.Mesh(new THREE.CapsuleGeometry?new THREE.CapsuleGeometry(.06,.15,4,8):new THREE.CylinderGeometry(.06,.06,.2,8),m);
      w.position.set((Math.random()-.5)*.3,.14,(Math.random()-.5)*.3);
      w.rotation.set(Math.random()*2,Math.random()*2,Math.random()*2);
      w.castShadow=true;g.add(w);
    }
  } else {
    const b=new THREE.Mesh(new THREE.BoxGeometry(.3,.14,.3),m);
    b.position.y=.11;b.castShadow=true;g.add(b);
  }
  return g;
}

/* ==========================================================
   СОСТОЯНИЕ ИГРЫ
   ========================================================== */
const state={
  money:5000,
  reputation:100,
  unlocked:['burger','salad','coffee','water','fries'],
  placed:[],       // {type, gx, gy, mesh, id, extra}
  occupied:{},     // "gx,gy" → placedItem
  customers:[],
  ready:0,         // глобальный счётчик готовых блюд на раздачах (для прогресса)
  nextId:1,
  placingType:null,
  placingGhost:null,
  spawnTimer:0,
  speed:1,
  stats:{served:0,earned:0},
};

/* ==========================================================
   ЗАГРУЗКА/СОХРАНЕНИЕ
   ========================================================== */
function save(){
  try{
    Store.set(SAVE_KEY,JSON.stringify({
      money:state.money,rep:state.reputation,
      unlocked:state.unlocked,
      placed:state.placed.map(p=>({t:p.type,gx:p.gx,gy:p.gy,extra:p.extra||null})),
      stats:state.stats,nextId:state.nextId,
    }));
  }catch{}
}
function load(){
  try{
    const raw=Store.get(SAVE_KEY);
    if(!raw)return;
    const d=JSON.parse(raw);
    if(!d)return;
    state.money=d.money??state.money;
    state.reputation=d.rep??100;
    state.unlocked=d.unlocked||state.unlocked;
    state.stats=d.stats||state.stats;
    state.nextId=d.nextId||1;
    (d.placed||[]).forEach(p=>placeItem(p.t,p.gx,p.gy,true,p.extra));
  }catch{}
}

/* ==========================================================
   РАССТАНОВКА
   ========================================================== */
function placeItem(type,gx,gy,silent,extra){
  const def=ITEMS[type];if(!def)return null;
  const key=gx+','+gy;
  if(state.occupied[key])return null;
  const mesh=def.build();mesh.position.set(gxToX(gx),0,gyToZ(gy));
  scene.add(mesh);
  const item={id:state.nextId++,type,gx,gy,mesh,extra:extra||null};
  if(def.cook)item.cook=[];   // очередь блюд
  if(def.serve)item.ready=[]; // готовые блюда
  state.placed.push(item);
  state.occupied[key]=item;
  if(!silent){snd(700,.05,'square',.05);}
  return item;
}
function removeItem(item){
  if(!item)return;
  scene.remove(item.mesh);
  if(item.mesh.traverse)item.mesh.traverse(o=>{if(o.geometry)o.geometry.dispose?.();});
  state.placed=state.placed.filter(p=>p!==item);
  delete state.occupied[item.gx+','+item.gy];
}
function findCell(x,z){
  const gx=xToGx(x),gy=zToGy(z);
  if(gx<0||gx>=GW||gy<0||gy>=GH)return null;
  // запрет на стены-клетки-1 у границы, чтобы не спавнить в стену
  if(gx===0||gx===GW-1||gy===0||gy===GH-1)return null;
  return {gx,gy};
}

/* призрак при размещении */
function makeGhost(type){
  clearGhost();
  const def=ITEMS[type];if(!def)return;
  const mesh=def.build();
  mesh.traverse(o=>{
    if(o.material){
      o.material=o.material.clone();
      o.material.transparent=true;
      o.material.opacity=.5;
    }
  });
  mesh.position.y=.02;
  state.placingGhost=mesh;
  scene.add(mesh);
}
function clearGhost(){
  if(state.placingGhost){scene.remove(state.placingGhost);state.placingGhost=null}
}
function moveGhost(x,z){
  if(!state.placingGhost)return;
  const c=findCell(x,z);
  if(!c){state.placingGhost.visible=false;return}
  state.placingGhost.visible=true;
  state.placingGhost.position.set(gxToX(c.gx),.02,gyToZ(c.gy));
}

/* ==========================================================
   ЗВУКИ
   ========================================================== */
let AC=null;
function snd(f,d,t,v){
  try{
    if(!AC)AC=new (window.AudioContext||window.webkitAudioContext)();
    if(AC.state==='suspended')AC.resume();
    const o=AC.createOscillator(),g=AC.createGain();
    o.type=t||'sine';o.frequency.value=f;
    g.gain.value=v||.03;g.gain.exponentialRampToValueAtTime(.0001,AC.currentTime+d);
    o.connect(g);g.connect(AC.destination);
    o.start();o.stop(AC.currentTime+d+.01);
  }catch{}
}

/* ==========================================================
   КАМЕРА — управление
   ========================================================== */
function updateCamera(){
  const y=cam.target.y+Math.sin(cam.phi)*cam.dist;
  const r=Math.cos(cam.phi)*cam.dist;
  camera.position.set(cam.target.x+Math.cos(cam.theta)*r,y,cam.target.z+Math.sin(cam.theta)*r);
  camera.lookAt(cam.target);
}

/* ==========================================================
   ВВОД
   ========================================================== */
const ray=new THREE.Raycaster();
const ndc=new THREE.Vector2();
let isDragging=false,dragStartX=0,dragStartY=0,lastX=0,lastY=0;
let activePtr=null,secondPtr=null,pinchStart=0,distStart=0;
const touchMap={};

canvas.addEventListener('pointerdown',e=>{
  if(e.pointerType==='touch'){
    touchMap[e.pointerId]={x:e.clientX,y:e.clientY};
    const ids=Object.keys(touchMap);
    if(ids.length===1){isDragging=true;activePtr=e.pointerId;lastX=e.clientX;lastY=e.clientY;distStart=0}
    else if(ids.length===2){
      const a=touchMap[ids[0]],b=touchMap[ids[1]];
      distStart=Math.hypot(a.x-b.x,a.y-b.y);
      pinchStart=cam.dist;
      isDragging=false;
    }
    canvas.setPointerCapture(e.pointerId);
  } else {
    if(e.button===2||e.button===1||e.button===0&&e.shiftKey){isDragging=true;lastX=e.clientX;lastY=e.clientY}
    else {isDragging=false;lastX=e.clientX;lastY=e.clientY}
    canvas.setPointerCapture(e.pointerId);
  }
});

canvas.addEventListener('pointermove',e=>{
  if(e.pointerType==='touch'){
    if(touchMap[e.pointerId]){touchMap[e.pointerId].x=e.clientX;touchMap[e.pointerId].y=e.clientY}
    const ids=Object.keys(touchMap);
    if(ids.length===2&&distStart>0){
      const a=touchMap[ids[0]],b=touchMap[ids[1]];
      const d=Math.hypot(a.x-b.x,a.y-b.y);
      cam.dist=Math.max(6,Math.min(35,pinchStart*(distStart/d)));
      updateCamera();
      return;
    }
  }
  if(state.placingGhost){
    const c=screenToFloor(e.clientX,e.clientY);
    if(c)moveGhost(c.x,c.z);
  }
  if(!isDragging)return;
  const dx=e.clientX-lastX,dy=e.clientY-lastY;
  lastX=e.clientX;lastY=e.clientY;
  if(e.pointerType==='touch'||e.buttons&1){
    cam.theta-=dx*.008;
    cam.phi=Math.max(.35,Math.min(1.4,cam.phi+dy*.006));
  } else {
    cam.target.x-=dx*.02;cam.target.z-=dy*.02;
  }
  updateCamera();
});

canvas.addEventListener('pointerup',e=>{
  if(e.pointerType==='touch'){
    delete touchMap[e.pointerId];
    if(!Object.keys(touchMap).length){isDragging=false;activePtr=null;distStart=0}
  } else {isDragging=false}
  try{canvas.releasePointerCapture(e.pointerId)}catch{}
  // клик — если не было движения
  const dx=e.clientX-lastX,dy=e.clientY-lastY;
  if(Math.hypot(dx,dy)<6&&e.pointerType!=='touch'){
    handleClick(e.clientX,e.clientY);
  } else if(e.pointerType==='touch'){
    const moved=Math.hypot(e.clientX-(lastX||e.clientX),e.clientY-(lastY||e.clientY));
    if(moved<8)handleClick(e.clientX,e.clientY);
  }
});

canvas.addEventListener('contextmenu',e=>e.preventDefault());
canvas.addEventListener('wheel',e=>{
  e.preventDefault();
  cam.dist=Math.max(6,Math.min(35,cam.dist+e.deltaY*.02));
  updateCamera();
},{passive:false});

function screenToFloor(clientX,clientY){
  const r=canvas.getBoundingClientRect();
  ndc.x=((clientX-r.left)/r.width)*2-1;
  ndc.y=-((clientY-r.top)/r.height)*2+1;
  ray.setFromCamera(ndc,camera);
  const plane=new THREE.Plane(new THREE.Vector3(0,1,0),0);
  const point=new THREE.Vector3();
  if(ray.ray.intersectPlane(plane,point))return {x:point.x,z:point.z};
  return null;
}

function handleClick(cx,cy){
  const r=canvas.getBoundingClientRect();
  ndc.x=((cx-r.left)/r.width)*2-1;
  ndc.y=-((cy-r.top)/r.height)*2+1;
  ray.setFromCamera(ndc,camera);

  // если ставим предмет
  if(state.placingType){
    const c=screenToFloor(cx,cy);
    if(!c)return;
    const cell=findCell(c.x,c.z);
    if(!cell)return;
    const def=ITEMS[state.placingType];
    if(state.money<def.cost){toast('Не хватает денег');cancelPlacing();return}
    const placed=placeItem(state.placingType,cell.gx,cell.gy,true);
    if(placed){
      state.money-=def.cost;
      toast('-'+def.cost+' ₽ · '+def.name);
      updateHUD();save();
    }
    cancelPlacing();
    return;
  }

  // raycast по объектам
  const hits=ray.intersectObjects(scene.children,true);
  for(const h of hits){
    let o=h.object;
    while(o&&!o.userData.rtItem)o=o.parent;
    if(o&&o.userData.rtItem){
      const item=o.userData.rtItem;
      // плита → меню готовки
      if(item.cook){openCookMenu(item);return}
      // касса
      if(item.type==='register'){toast('💵 Касса: '+state.stats.served+' гостей · '+state.stats.earned+' ₽');return}
    }
    // клиент
    let c=o;
    while(c&&!c.userData.rtCustomer)c=c.parent;
    if(c&&c.userData.rtCustomer){clickCustomer(c.userData.rtCustomer);return}
  }
}

/* ==========================================================
   КЛИЕНТЫ
   ========================================================== */
const SKIN=[0xf0c8a0,0xd4a373,0x8b5a3a,0x4a2a1a];
const SHIRT=[0xff4d6d,0x52b788,0x3a86ff,0xf4a261,0x7c5cff,0x00b4d8,0xffd166];

function buildCustomerMesh(){
  const g=new THREE.Group();
  const skin=SKIN[~~(Math.random()*SKIN.length)];
  const shirt=SHIRT[~~(Math.random()*SHIRT.length)];
  // тело
  const body=new THREE.Mesh(new THREE.CapsuleGeometry?new THREE.CapsuleGeometry(.22,.4,4,10):new THREE.CylinderGeometry(.22,.22,.7,10),mat(shirt,.8));
  body.position.y=.55;body.castShadow=true;g.add(body);
  // голова
  const head=new THREE.Mesh(new THREE.SphereGeometry(.2,14,10),mat(skin,.8));
  head.position.y=1.1;head.castShadow=true;g.add(head);
  // волосы
  const hair=new THREE.Mesh(new THREE.SphereGeometry(.21,14,10,0,Math.PI*2,0,Math.PI*.55),mat(0x2a1a0a,.9));
  hair.position.y=1.13;g.add(hair);
  return g;
}

function spawnCustomer(){
  if(state.customers.length>=8)return;
  // нужен хотя бы один стол-с местом
  const tables=state.placed.filter(p=>(p.type==='table2'||p.type==='table4'));
  if(!tables.length)return;
  const mesh=buildCustomerMesh();
  const doorX=TW/2+.5,doorZ=0;
  mesh.position.set(doorX,0,doorZ);
  scene.add(mesh);

  const c={
    id:state.nextId++,mesh,state:'entering',
    target:{x:doorX-.8,z:doorZ},
    table:null,seat:null,
    dish:null,patience:22,timer:0,bubble:null,
    homeX:doorX,homeZ:doorZ,skinTone:0,
  };
  mesh.userData.rtCustomer=c;
  state.customers.push(c);
}

function findFreeSeat(customer){
  const tables=state.placed.filter(p=>(p.type==='table2'||p.type==='table4'));
  for(const t of tables){
    const capacity=ITEMS[t.type].seats;
    const taken=(t.extra&&t.extra.seats)||0;
    if(taken<capacity){
      t.extra=t.extra||{seats:0};
      t.extra.seats=taken+1;
      return t;
    }
  }
  return null;
}

function releaseSeat(t){
  if(!t||!t.extra)return;
  t.extra.seats=Math.max(0,(t.extra.seats||0)-1);
}

function showBubble(c,dish){
  if(c.bubble){scene.remove(c.bubble);c.bubble=null}
  if(!dish)return;
  const cv=document.createElement('canvas');cv.width=128;cv.height=128;
  const ctx=cv.getContext('2d');
  ctx.fillStyle='rgba(0,0,0,.85)';ctx.beginPath();ctx.arc(64,50,46,0,7);ctx.fill();
  ctx.beginPath();ctx.moveTo(50,90);ctx.lineTo(64,110);ctx.lineTo(78,90);ctx.fill();
  ctx.font='46px serif';ctx.textAlign='center';ctx.textBaseline='middle';
  const emo={burger:'🍔',pizza:'🍕',salad:'🥗',soup:'🍜',steak:'🥩',sushi:'🍣',pasta:'🍝',fish:'🐟',sandwich:'🥪',icecream:'🍦',cake:'🍰',coffee:'☕',tea:'🍵',juice:'🧃',water:'💧',fries:'🍟',hotdog:'🌭',taco:'🌮',wings:'🍗',ramen:'🍜'}[dish];
  ctx.fillText(emo||'🍽️',64,52);
  const tex=new THREE.CanvasTexture(cv);
  const spr=new THREE.Sprite(new THREE.SpriteMaterial({map:tex,transparent:true,depthTest:false}));
  spr.scale.set(.9,.9,1);
  spr.position.set(0,2,c.mesh.position.z-c.mesh.position.z);
  c.mesh.add(spr);
  spr.position.set(0,1.9,0);
  c.bubble=spr;
}

function moveTowards(obj,tx,tz,dt,spd){
  const dx=tx-obj.position.x,dz=tz-obj.position.z;
  const d=Math.hypot(dx,dz);
  if(d<.05)return true;
  const step=Math.min(d,spd*dt);
  obj.position.x+=dx/d*step;
  obj.position.z+=dz/d*step;
  obj.rotation.y=Math.atan2(dx,dz);
  return false;
}

function updateCustomers(dt){
  // спавн
  state.spawnTimer-=dt;
  if(state.spawnTimer<=0){
    state.spawnTimer=3+Math.random()*3;
    const openChairs=state.placed.filter(p=>(p.type==='table2'||p.type==='table4')).reduce((a,t)=>a+(ITEMS[t.type].seats-((t.extra&&t.extra.seats)||0)),0);
    if(openChairs>0&&Math.random()<.85)spawnCustomer();
  }
  for(const c of state.customers.slice()){
    c.timer+=dt;
    if(c.state==='entering'){
      if(moveTowards(c.mesh,c.target.x,c.target.z,dt,1.4)){
        // ищем стол
        const t=findFreeSeat(c);
        if(!t){c.state='leaving';c.target={x:c.homeX,z:c.homeZ};continue}
        c.table=t;
        c.state='toward_table';
        c.target={x:gxToX(t.gx),z:gyToZ(t.gy)};
        c.seatAngle=Math.atan2(c.mesh.position.x-gxToX(t.gx),c.mesh.position.z-gyToZ(t.gy));
        // ставим чуть рядом со столом
        c.target.x=gxToX(t.gx)+Math.cos(c.seatAngle)*.55;
        c.target.z=gyToZ(t.gy)+Math.sin(c.seatAngle)*.55;
      }
    }
    else if(c.state==='toward_table'){
      if(moveTowards(c.mesh,c.target.x,c.target.z,dt,1.3)){
        c.state='ordering';
        c.timer=0;
      }
    }
    else if(c.state==='ordering'){
      if(c.timer>.6){
        // выбираем случайное блюдо из открытых
        const menu=state.unlocked.length?state.unlocked:['burger'];
        c.dish=menu[~~(Math.random()*menu.length)];
        showBubble(c,c.dish);
        c.state='waiting_food';
        c.timer=0;
      }
    }
    else if(c.state==='waiting_food'){
      if(c.timer>c.patience){
        c.state='angry';
        c.timer=0;
        state.reputation=Math.max(0,state.reputation-3);
        updateHUD();
      }
    }
    else if(c.state==='angry'){
      if(c.timer>.8){
        releaseSeat(c.table);
        if(c.bubble){scene.remove(c.bubble);c.bubble=null}
        c.state='leaving';
        c.target={x:c.homeX,z:c.homeZ};
      }
    }
    else if(c.state==='eating'){
      if(c.timer>4){
        // оплата
        const dish=DISH[c.dish];
        const tip=Math.round(dish.price*.15);
        state.money+=dish.price+tip;
        state.stats.served++;state.stats.earned+=dish.price+tip;
        state.reputation=Math.min(100,state.reputation+1);
        updateHUD();save();
        toast('💵 +'+(dish.price+tip)+' ₽');
        if(c.bubble){scene.remove(c.bubble);c.bubble=null}
        releaseSeat(c.table);
        c.state='leaving';
        c.target={x:c.homeX,z:c.homeZ};
      }
    }
    else if(c.state==='leaving'){
      if(moveTowards(c.mesh,c.target.x,c.target.z,dt,1.4)){
        scene.remove(c.mesh);
        state.customers=state.customers.filter(x=>x!==c);
      }
    }
  }
}

function clickCustomer(c){
  // если ждёт еду — ищем готовое блюдо
  if(c.state!=='waiting_food'){toast('Гость не ждёт заказ');return}
  // ищем готовое блюдо на любом counter
  const counters=state.placed.filter(p=>ITEMS[p.type].serve);
  for(const cnt of counters){
    cnt.ready=cnt.ready||[];
    const idx=cnt.ready.findIndex(d=>d===c.dish);
    if(idx>=0){
      cnt.ready.splice(idx,1);
      // убираем меш
      const found=(cnt.readyMeshes||[]).findIndex(m=>m.dishId===c.dish);
      if(found>=0){
        const m=cnt.readyMeshes[found];
        scene.remove(m.mesh);
        cnt.readyMeshes.splice(found,1);
      }
      c.state='eating';c.timer=0;
      if(c.bubble){scene.remove(c.bubble);c.bubble=null}
      snd(880,.08,'sine',.06);
      return;
    }
  }
  toast('Нужно приготовить: '+DISH[c.dish].name);
}

/* ==========================================================
   ГОТОВКА
   ========================================================== */
function startCooking(item,dishId){
  item.cook=item.cook||[];
  if(item.cook.length>=3){toast('Плита занята');return}
  const dish=DISH[dishId];
  if(!dish)return;
  if(state.money<dish.cost){toast('Не хватает на ингредиенты');return}
  state.money-=dish.cost;
  updateHUD();
  const job={dish:dishId,timer:dish.time};
  item.cook.push(job);
  // визуальная индикация
  const dot=new THREE.Mesh(new THREE.SphereGeometry(.08,8,8),new THREE.MeshBasicMaterial({color:0xff3300}));
  dot.position.set((Math.random()-.5)*.6,.95,(Math.random()-.5)*.6);
  item.mesh.add(dot);
  job.dot=dot;
  snd(440,.05,'square',.04);
}

function tickCooking(dt){
  for(const item of state.placed){
    if(!item.cook||!item.cook.length)continue;
    for(const job of item.cook.slice()){
      job.timer-=dt;
      if(job.timer<=0){
        item.cook.splice(item.cook.indexOf(job),1);
        if(job.dot){item.mesh.remove(job.dot);job.dot.geometry.dispose();job.dot.material.dispose()}
        // ищем свободный counter
        const counters=state.placed.filter(p=>ITEMS[p.type].serve);
        let target=null;
        for(const c of counters){
          c.ready=c.ready||[];
          if(c.ready.length<4){target=c;break}
        }
        if(target){
          target.ready.push(job.dish);
          target.readyMeshes=target.readyMeshes||[];
          const m=buildDishMesh(DISH[job.dish]);
          const idx=target.ready.length-1;
          m.position.set(target.mesh.position.x+(idx-1.5)*.35,1,target.mesh.position.z);
          m.rotation.y=Math.random()*7;
          scene.add(m);
          target.readyMeshes.push({dishId:job.dish,mesh:m});
          snd(1000,.1,'sine',.05);
        } else {
          toast('Стол-раздача забит!');
        }
      }
    }
  }
}

/* ==========================================================
   ИГРОВОЙ ЦИКЛ
   ========================================================== */
let lastT=performance.now();
function loop(T){
  const dt=Math.min(.05,(T-lastT)/1000)*state.speed;
  lastT=T;
  updateCustomers(dt);
  tickCooking(dt);
  // лёгкая анимация светильников
  warm1.intensity=.75+Math.sin(T*.002)*.1;
  warm2.intensity=.75+Math.cos(T*.0025)*.1;
  renderer.render(scene,camera);
  requestAnimationFrame(loop);
}

/* ==========================================================
   HUD и панели
   ========================================================== */
function updateHUD(){
  document.getElementById('money').textContent=Math.floor(state.money).toLocaleString('ru-RU');
  document.getElementById('cust').textContent=state.customers.length;
  document.getElementById('rep').textContent=Math.round(state.reputation);
}
let toastTimer=0;
function toast(s){
  const t=document.getElementById('toast');
  t.textContent=s;t.classList.add('on');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('on'),1800);
}

const panel=document.getElementById('panel');
const pbody=document.getElementById('pbody');
const ptitle=document.getElementById('ptitle');
document.getElementById('pclose').onclick=()=>panel.classList.remove('on');

document.getElementById('bShop').onclick=openShop;
document.getElementById('bMenu').onclick=openMenu;
document.getElementById('bSpeed').onclick=()=>{
  state.speed=state.speed===1?2:state.speed===2?3:1;
  document.getElementById('bSpeed').textContent='⏩ '+state.speed+'×';
};
document.getElementById('bHelp').onclick=()=>{
  ptitle.textContent='Как играть';
  pbody.innerHTML=`
    <div style="font-size:13.5px;line-height:1.7;opacity:.9">
      <p><b>🎯 Цель:</b> построить прибыльный ресторан.</p>
      <p style="margin-top:10px"><b>🛒 Магазин</b> — покупай столы, плиты, кассы и декор. После выбора тапни на пустую клетку пола.</p>
      <p style="margin-top:10px"><b>📖 Меню</b> — открывай новые блюда за деньги. Чем дороже блюдо — тем больше прибыль.</p>
      <p style="margin-top:10px"><b>🔥 Плита</b> — тапни по плите, выбери блюдо. Оно приготовится за N секунд и появится на «Столе-раздаче».</p>
      <p style="margin-top:10px"><b>🧑‍🍳 Раздача</b> — купи стол-раздачу. Там копятся готовые блюда (до 4).</p>
      <p style="margin-top:10px"><b>👥 Гости</b> — приходят, садятся за стол, показывают в пузыре желаемое блюдо. Тапни по гостю — если нужное блюдо есть на раздаче, он его получит и заплатит + чаевые.</p>
      <p style="margin-top:10px"><b>⭐ Репутация</b> падает, если гости уходят без еды. Держи её высокой.</p>
      <p style="margin-top:10px;opacity:.6"><b>Управление камерой:</b> ЛКМ/тап — выбрать. ПКМ/перетаскивание — вращение. Колесо/пинч — зум.</p>
    </div>`;
  panel.classList.add('on');
};

function openShop(){
  ptitle.textContent='Магазин';
  pbody.innerHTML='<div class="grid"></div>';
  const g=pbody.querySelector('.grid');
  Object.entries(ITEMS).forEach(([k,def])=>{
    const c=document.createElement('div');
    c.className='card'+(state.money<def.cost?' disabled':'');
    c.innerHTML=`
      <div class="emoji">${def.emoji}</div>
      <div class="name">${def.name}</div>
      <div class="cost">${def.cost.toLocaleString('ru-RU')} ₽</div>
      ${def.seats?'<div class="sub">Мест: '+def.seats+'</div>':''}
      ${def.cook?'<div class="sub">Готовит блюда</div>':''}
      ${def.serve?'<div class="sub">Склад готового</div>':''}
    `;
    c.onclick=()=>{
      if(state.money<def.cost){toast('Не хватает');return}
      panel.classList.remove('on');
      startPlacing(k);
    };
    g.appendChild(c);
  });
  panel.classList.add('on');
}

function startPlacing(type){
  cancelPlacing();
  state.placingType=type;
  makeGhost(type);
  document.getElementById('placehint').classList.add('on');
}
function cancelPlacing(){
  state.placingType=null;
  clearGhost();
  document.getElementById('placehint').classList.remove('on');
}

function openMenu(){
  ptitle.textContent='Меню ресторана';
  pbody.innerHTML='';
  pbody.innerHTML='<div style="font-size:12.5px;opacity:.6;margin-bottom:12px">Открытие нового блюда: <b style="color:#ffd166">10 000 ₽</b></div>';
  DISHES.forEach(d=>{
    const [id,name,price,cost,time]=d;
    const unlocked=state.unlocked.includes(id);
    const row=document.createElement('div');
    row.className='dishRow'+(unlocked?'':' locked');
    row.innerHTML=`
      <div class="info">
        <div>${unlocked?'✓':'🔒'} <b>${name}</b></div>
        <div class="c">Ингредиенты ${cost} ₽ · ${time} сек</div>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <div class="p">${price} ₽</div>
        ${unlocked?'<button class="unlocked">открыто</button>':'<button class="unlock" data-id="'+id+'">10 000 ₽</button>'}
      </div>`;
    pbody.appendChild(row);
  });
  pbody.querySelectorAll('.unlock').forEach(b=>{
    b.onclick=()=>{
      if(state.money<10000){toast('Не хватает 10 000 ₽');return}
      state.money-=10000;
      state.unlocked.push(b.dataset.id);
      updateHUD();save();
      toast('🎉 Блюдо открыто!');
      openMenu();
    };
  });
  panel.classList.add('on');
}

function openCookMenu(item){
  ptitle.textContent='🔥 Плита';
  pbody.innerHTML='<div style="font-size:12.5px;opacity:.6;margin-bottom:12px">Выбери блюдо (оплачиваешь ингредиенты).</div>';
  state.unlocked.forEach(id=>{
    const d=DISH[id];if(!d)return;
    const row=document.createElement('div');
    row.className='dishRow';
    row.innerHTML=`
      <div class="info"><b>${d.name}</b><div class="c">Ингредиенты ${d.cost} ₽ · ${d.time} сек</div></div>
      <div style="display:flex;gap:8px;align-items:center"><div class="p">${d.price} ₽</div><button class="unlock">Готовить</button></div>`;
    row.querySelector('button').onclick=()=>{
      startCooking(item,id);
      panel.classList.remove('on');
    };
    pbody.appendChild(row);
  });
  panel.classList.add('on');
}

/* ==========================================================
   СТАРТ
   ========================================================== */
window.addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight,false);
});

load();
if(!state.placed.length){
  // стартовый набор
  placeItem('stove',4,3,true);
  placeItem('counter',6,3,true);
  placeItem('register',3,8,true);
  placeItem('table4',8,7,true);
  placeItem('table2',10,4,true);
  placeItem('plant',2,2,true);
  placeItem('plant',13,9,true);
  save();
}

// спавним первого гостя для демонстрации
setTimeout(spawnCustomer,1200);
setTimeout(spawnCustomer,2500);

document.getElementById('loading').style.display='none';
updateHUD();
requestAnimationFrame(loop);

// автосохранение раз в 10 секунд
setInterval(save,10000);

})();
</script>
</body>
</html>
