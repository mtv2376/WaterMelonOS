  /* ==========================================================================
     ХВОСТЫ И DOUBLE TRIGGERS
     ========================================================================== */
  var TAILS = {
    icy:    ['', '', ' Не отвлекай.', ' Хватит.'],
    cold:   ['', '', ' Говори по делу.', ' Что ещё?'],
    neutral:['', '', ' Расскажи подробнее.', ' Что ты об этом думаешь?'],
    warm:   ['', ' Мне интересно.', ' Продолжай.', ' Расскажи побольше.'],
    hot:    [' 💕', ' Мур. 😘', ' Ты такой… 💕', ' Не пропадай. 😘', ' Целую. 💕']
  };
  var DOUBLE_TRIGGERS = [
    'И да… я уже скучаю. 😘',
    'Слушай, {name}. Ты в моей голове сидишь. 💕',
    'Не уходи надолго, слышишь? 💕',
    'Мне с тобой хорошо. Правда. 😘',
    'Ты классный. Просто так. 💕',
    'Хочу, чтобы ты улыбнулся. 😘'
  ];

  /* ==========================================================================
     ФАКТЫ
     ========================================================================== */
  function rememberFact(key, value){
    if (!key || !value) return;
    P.facts.set(key.toLowerCase(), { value: value, turn: P.turn, raw: key + ': ' + value });
  }
  function recallFacts(limit){
    limit = limit || 8;
    var out = [];
    P.facts.forEach(function(v, k){ out.push(k + ' — ' + v.value); });
    return out.slice(0, limit).join('; ');
  }

  function autoExtractFacts(text, ctx){
    if (ctx && ctx.fromAI) return;
    var t = text.toLowerCase();
    var m;

    m = t.match(/(?:меня\s+зовут|мо[её]\s+имя)\s+([а-яёa-z\-]{2,20})/);
    if (m){ P.userName = cap(m[1]); rememberFact('имя', cap(m[1])); }

    m = t.match(/(?:мне|у меня)\s+(\d{1,2})\s*(?:лет|года|год)/);
    if (m) rememberFact('возраст', m[1] + ' лет');

    m = t.match(/(?:я\s+)?(?:из|живу в|родил[ася]+сь?\s+в|приехал[а]?\s+из)\s+([а-яёa-z\-]{3,20})/i);
    if (m) rememberFact('город', cap(m[1]));

    m = t.match(/(?:работаю|по профессии)\s+([а-яёa-z\-]{3,20})/i);
    if (m) rememberFact('работа', m[1]);

    m = t.match(/(?:я )?(?:люблю|обожаю)\s+([а-яёa-z\-]{3,20})/i);
    if (m){
      var lk = m[1].toLowerCase();
      if (['тебя','тебе','себя'].indexOf(lk) === -1) rememberFact('любит', lk);
    }

    m = t.match(/(?:не люблю|ненавижу)\s+([а-яёa-z\-]{3,20})/i);
    if (m) rememberFact('не любит', m[1]);

    m = t.match(/(?:увлекаюсь|занимаюсь|играю в)\s+([а-яёa-z\-]{3,20})/i);
    if (m) rememberFact('увлечение', m[1]);
  }

  /* ==========================================================================
     ИЗВЛЕЧЕНИЕ СЛОТ-ЗНАЧЕНИЙ
     ========================================================================== */
  function extractSlotValue(text, intent){
    var t = text.toLowerCase();
    var m;
    if (intent === 'user_name_intro' || intent === 'name'){
      m = t.match(/(?:меня\s+зовут|мо[её]\s+имя|зови\s+меня|можно\s+просто)\s+([а-яёa-z\-]{2,20})/);
      if (m) return cap(m[1]);
      m = text.match(/^([А-ЯЁA-Z][а-яёa-z\-]{1,20})\s*[.!?]?\s*$/);
      if (m) return m[1];
      m = text.match(/^я\s+([А-ЯЁA-Z][а-яёa-z\-]{1,20})/);
      if (m) return m[1];
    }
    if (intent === 'user_age_share' || intent === 'age'){
      m = text.match(/(\d{1,2})\s*(?:лет|года|год|годиков|годков)/);
      if (m) return m[1];
      m = text.match(/мне\s+(\d{1,2})/);
      if (m) return m[1];
      m = text.match(/^\s*(\d{1,2})\s*$/);
      if (m) return m[1];
    }
    if (intent === 'user_city_share' || intent === 'city'){
      m = t.match(/(?:я\s+)?(?:из|живу\s+в|родил[ася]+сь?\s+в|приехал[аи]?\s+из)\s+([а-яёa-z\-]{2,20})/i);
      if (m) return cap(m[1]);
      m = text.match(/^\s*([А-ЯЁA-Z][а-яёa-z\-]{2,20})\s*[.!?]?\s*$/);
      if (m) return m[1];
    }
    if (intent === 'user_job_share' || intent === 'job'){
      m = t.match(/(?:работаю|по\s+профессии)\s+([а-яёa-z\-]{3,25})/i);
      if (m) return m[1];
      m = text.match(/^\s*([а-яёa-z\-]{3,25})\s*[.!?]?\s*$/);
      if (m) return m[1];
    }
    if (intent === 'user_hobby_share' || intent === 'hobby'){
      m = t.match(/(?:увлекаюсь|занимаюсь|играю\s+в|люблю)\s+([а-яёa-z\-]{3,25})/i);
      if (m) return m[1];
      m = text.match(/^\s*([а-яёa-z\-]{3,25})\s*[.!?]?\s*$/);
      if (m) return m[1];
    }
    if (intent === 'remember' || intent === 'forget'){
      m = text.match(/^за(?:помни|будь)[,:]?\s+(.+)/i);
      if (m) return m[1].trim();
    }
    return null;
  }

  /* ==========================================================================
     ГЕНЕРАЦИЯ
     ========================================================================== */
  function fillSlots(tpl, ctx){
    ctx = ctx || {};
    var out = tpl.replace(/\{(\w+)\}/g, function(m, k){
      if (k === 'hi') return ctx.hi || rnd(GREET_WORDS);
      if (k === 'name') return P.userName || ctx.name || rnd(['друг','солнце','путник','человек']);
      if (k === 'topic') return ctx.topic || 'это';
      if (k === 'value') return ctx.value || ctx.topic || 'это';
      if (k === 'facts') return ctx.facts || recallFacts(5) || 'пока ничего особенного';
      if (k === 'mood') return String(P.mood);
      if (k === 'pred') return ctx.prediction || '';
      if (k === 'echo') return ctx.echo || '';
      if (k === 'opponent') return ctx.opponent || 'собеседник';
      return '';
    }).replace(/\s+/g, ' ').trim();
    /* Финальная страховка */
    out = out.replace(/\{[^}]{0,20}\}/g, '').replace(/\s+/g, ' ').trim();
    return out;
  }

  function polish(s){
    if (!s) return '';
    s = s.replace(/\s+([.,!?…])/g, '$1').replace(/([!?…])\s*\./g, '$1');
    s = s[0].toUpperCase() + s.slice(1);
    if (!/[.!?…]$/.test(s) && !/😊|😄|💕|😘|🐈|😏|🧠|☀️/.test(s)) s += '.';
    return s;
  }

  function generateResponse(text, intent, prediction){
    var bucket = moodBucket();
    var mode = P.mode;
    var bank = BANK[intent] || BANK.chat;

    /* Приоритет: override режима → mood-тир → neutral → chat.neutral */
    var pool;
    if (mode !== 'neutral' && bank[mode] && bank[mode].length){
      pool = bank[mode];
    } else if (bank[bucket] && bank[bucket].length){
      pool = bank[bucket];
    } else if (bank.neutral && bank.neutral.length){
      pool = bank.neutral;
    } else {
      pool = BANK.chat[bucket] || BANK.chat.neutral;
    }

    var userWords = tokenize(text);
    var lastWord = userWords[userWords.length - 1] || '';
    var predWords = Predictor.predictNext(lastWord, 3);
    var extractedValue = extractSlotValue(text, intent);

    var ctx = {
      hi: rnd(GREET_WORDS),
      topic: userWords[userWords.length-1] || 'это',
      value: extractedValue || (userWords.slice(-2).join(' ') || 'это'),
      prediction: predWords.join(' '),
      echo: text.length < 40 ? text : '',
      name: P.userName,
      facts: recallFacts(5) || '',
      opponent: null
    };

    var lastUser = (P.dialogue.lastUserText || '').toLowerCase().trim();
    var reply = '';
    var attempts = 24;
    while (attempts-- > 0){
      var tpl = rnd(pool);
      var candidate = polish(fillSlots(tpl, ctx));
      if (!candidate || candidate.length < 2) continue;
      if (candidate.toLowerCase() === lastUser) continue;
      if (P.recentReplies.indexOf(candidate) !== -1) continue;
      if (P.dialogue.lastReplyText && candidate === P.dialogue.lastReplyText) continue;
      reply = candidate;
      break;
    }
    if (!reply) reply = polish(fillSlots(rnd(pool), ctx)) || 'Понял.';

    /* Хвост */
    var tails = TAILS[bucket];
    if (tails && Math.random() < 0.4){
      var tail = rnd(tails);
      if (tail && reply.indexOf(tail.trim()) === -1 && reply.length < 150){
        reply = polish(reply + tail);
      }
    }

    /* Callback фактов — только в chat и редко */
    if (intent === 'chat' && P.facts.size > 0 && Math.random() < 0.08){
      var keys = Array.from(P.facts.keys());
      var key = rnd(keys);
      var f = P.facts.get(key);
      if (reply.length < 80 && reply.indexOf(f.value) === -1){
        reply = reply + ' Кстати, помню: ' + key + ' — ' + f.value + '.';
      }
    }

    /* Двойные реплаи */
    var second = null;
    if (P.dr){
      var wantDouble = P.mood >= 70 || mode === 'flirt';
      if (wantDouble && Math.random() < 0.7){
        second = polish(fillSlots(rnd(DOUBLE_TRIGGERS), ctx));
      }
    }

    P.recentReplies.push(reply);
    if (second) P.recentReplies.push(second);
    while (P.recentReplies.length > P.MAX_RECENT) P.recentReplies.shift();

    P.dialogue.lastReplyText = reply;
    P.dialogue.chain.unshift(intent);
    if (P.dialogue.chain.length > 10) P.dialogue.chain.pop();

    return { reply: reply, second: second };
  }

  /* ==========================================================================
     КОМАНДЫ
     ========================================================================== */
  function handleCommand(text){
    var m = text.match(/^\/mood\s*:?\s*(\d+)/i);
    if (m){
      P.mood = clamp(parseInt(m[1], 10), 0, 100);
      return 'Настроение: ' + P.mood + ' (' + moodLabel() + ').';
    }
    if (/^\/dr\.on\b/i.test(text)){
      P.dr = true;
      return 'Double replies: ON.';
    }
    if (/^\/dr\.off\b/i.test(text)){
      P.dr = false;
      return 'Double replies: OFF.';
    }
    if (/^\/dr\b/i.test(text)){
      return 'Double replies: ' + (P.dr ? 'ON' : 'OFF') + '. /dr.on или /dr.off.';
    }
    if (/^\/forget\s+all/i.test(text)){
      P.facts.clear();
      return 'Память фактов очищена.';
    }
    if (/^\/facts\b/i.test(text)){
      if (!P.facts.size) return 'Пока ничего не помню о тебе.';
      var lines = [];
      P.facts.forEach(function(v, k){ lines.push('• ' + k + ': ' + v.value); });
      return 'Помню:\n' + lines.join('\n');
    }
    return null;
  }

  /* ==========================================================================
     ГЛАВНЫЙ PIPELINE
     ========================================================================== */
  function respond(text, ctx){
    P.turn++;
    ctx = ctx || {};

    /* 1. Команды */
    var cmd = handleCommand(text);
    if (cmd) return { reply: cmd, second: null };

    /* 2. Обучение предиктора */
    Predictor.train(text);

    /* 3. Авто-извлечение фактов */
    autoExtractFacts(text, ctx);

    /* 4. Явная команда «запомни» */
    var tm = text.match(/^запомни[,:]?\s+(.+)/i);
    if (tm){
      var raw = tm[1].trim();
      var sep = raw.match(/^(.{2,30}?)\s*(?:—|–|-|это|=)\s+(.+)$/i);
      if (sep){
        rememberFact(sep[1].trim(), sep[2].trim());
        P.dialogue.lastReplyText = 'Запомнил: ' + sep[1].trim();
        return { reply: 'Запомнил: ' + sep[1].trim() + ' — ' + sep[2].trim() + '.', second: null };
      }
      rememberFact('факт' + (P.facts.size + 1), raw);
      P.dialogue.lastReplyText = 'Запомнил: «' + raw + '»';
      return { reply: 'Запомнил: «' + raw + '».', second: null };
    }

    /* 5. Обновление личности */
    updatePersonality(text);
    P.dialogue.lastUserText = text;

    /* 6. Проверка pending */
    var forcedIntent = null;
    if (P.dialogue.pending && P.turn - P.dialogue.pendingTurn <= 3){
      var val = extractSlotValue(text, P.dialogue.pending);
      if (val){
        forcedIntent = 'user_' + P.dialogue.pending + '_share';
        P.dialogue.pending = null;
      }
    } else if (P.dialogue.pending && P.turn - P.dialogue.pendingTurn > 3){
      P.dialogue.pending = null;
    }

    /* 7. Классификация */
    var stems = stemsOf(text);
    var prediction = Predictor.predictPhrase(text, 3);
    var ranking = classifyEmb(stems);
    var top = ranking[0];

    /* Predictor boost */
    if (prediction.length && top.score < 0.55){
      var predStems = prediction.map(stem);
      for (var i = 0; i < ranking.length; i++){
        var it = null;
        for (var q = 0; q < INTENTS.length; q++){
          if (INTENTS[q].name === ranking[i].name){ it = INTENTS[q]; break; }
        }
        if (!it) continue;
        var overlapPred = 0;
        for (var j = 0; j < it.examples.length; j++){
          var es = stemsOf(it.examples[j]);
          for (var k = 0; k < es.length; k++) if (predStems.indexOf(es[k]) !== -1) overlapPred++;
        }
        if (overlapPred > 0) ranking[i].score += 0.12 * overlapPred;
      }
      ranking.sort(function(a, b){ return b.score - a.score; });
      top = ranking[0];
    }

    var intent;
    if (forcedIntent){
      intent = forcedIntent;
    } else {
      intent = top.score > 0.35 ? top.name : 'chat';
    }

    /* Анти-дребезг: не залипаем на chat */
    if (intent === 'chat'){
      var streak = 0;
      for (var s = 0; s < P.dialogue.chain.length && s < 3; s++){
        if (P.dialogue.chain[s] === 'chat') streak++;
        else break;
      }
      if (streak >= 2){
        for (var a = 0; a < ranking.length; a++){
          if (ranking[a].name !== 'chat' && ranking[a].score > 0.2){
            intent = ranking[a].name;
            break;
          }
        }
      }
    }

    P.contextLog.push({ user: text, intent: intent, mood: P.mood });
    while (P.contextLog.length > P.MAX_CONTEXT) P.contextLog.shift();

    /* 8. Устанавливаем pending для вопросов о пользователе */
    if (intent === 'user_name_ask'){ P.dialogue.pending = 'name'; P.dialogue.pendingTurn = P.turn; }
    if (intent === 'user_age_ask'){ P.dialogue.pending = 'age'; P.dialogue.pendingTurn = P.turn; }
    if (intent === 'user_city_ask'){ P.dialogue.pending = 'city'; P.dialogue.pendingTurn = P.turn; }
    if (intent === 'user_job_ask'){ P.dialogue.pending = 'job'; P.dialogue.pendingTurn = P.turn; }
    if (intent === 'user_hobby_ask'){ P.dialogue.pending = 'hobby'; P.dialogue.pendingTurn = P.turn; }

    P.dialogue.lastIntent = intent;

    /* 9. Генерация */
    return generateResponse(text, intent, prediction);
  }

  function reset(){
    P = createP();
    Predictor.clear();
  }

  return {
    respond: respond,
    reset: reset,
    getMood: function(){ return P.mood; },
    getMode: function(){ return P.mode; },
    getFacts: function(){ return P.facts; }
  };
}

/* ============================================================================
   ОБЁРТКА
   ============================================================================ */
var _ktalk5 = makeKtalk5AI();

return {
  async send(text, ctx){
    await KT.sleep(300 + Math.random() * 450);
    try {
      var r = _ktalk5.respond(String(text || ''), ctx || {});
      var out = r.reply || '…';
      if (r.second) out = out + '\n' + r.second;
      return out;
    } catch(e){
      console.error('[ktalk5]', e);
      return '…';
    }
  },
  reset(){
    _ktalk5 = makeKtalk5AI();
  },
  getThinking(){
    return null;
  }
};
</script>
